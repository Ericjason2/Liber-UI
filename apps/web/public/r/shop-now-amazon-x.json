%3D%3D\" alt=\"Product Image\" className=\"w-full h-60 object-cover group-hover105 transition-transform\" />\n            <span className=\"absolute top-3 right-3 bg-black text-white text-xs px-2 py-1 rounded\">NEW</span>\n          </div>\n          <div className=\"p-5\">\n            <h3 className=\"text-lg font-bold text-gray-900 mb-1\">Noise Cancelling Headphones</h3>\n            <p className=\"text-sm text-gray-500 mb-2\">30hr Battery · Bluetooth 5.3</p>\n            <div className=\"flex justify-between items-center mt-4\">\n              <span className=\"text-lg font-semibold text-green-600\">$129.00</span>\n              <button className=\"bg-black text-white px-4 py-2 rounded-lg hover800\">Buy</button>\n            </div>\n          </div>\n        </div>\n    \n        \n        <div className=\"bg-white rounded-2xl shadow-lg hover2xl transition overflow-hidden group\">\n          <div className=\"relative\">\n            <img src=\"https://images.unsplash.com/photo-1709258228137-19a8c193be39?q=80&w=2011&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D\" alt=\"Product Image\" className=\"w-full h-60 object-cover group-hover105 transition-transform\" />\n            <span className=\"absolute top-3 right-3 bg-red-600 text-white text-xs px-2 py-1 rounded\">SALE</span>\n          </div>\n          <div className=\"p-5\">\n            <h3 className=\"text-lg font-bold text-gray-900 mb-1\">Running Shoes Pro</h3>\n            <p className=\"text-sm text-gray-500 mb-2\">Lightweight · Breathable</p>\n            <div className=\"flex justify-between items-center mt-4\">\n              <span className=\"text-lg font-semibold text-green-600\">$89.99</span>\n              <button className=\"bg-black text-white px-4 py-2 rounded-lg hover800\">Buy</button>\n            </div>\n          </div>\n        </div>\n    \n        <div className=\"bg-white rounded-2xl shadow-lg hover2xl transition overflow-hidden group\">\n          <div className=\"relative\">\n            <img src=\"https://images.unsplash.com/photo-1718309602791-8f3cc83840b7?q=80&w=1974&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D\" alt=\"Product Image\" className=\"w-full h-60 object-cover group-hover105 transition-transform\" />\n          </div>\n          <div className=\"p-5\">\n            <h3 className=\"text-lg font-bold text-gray-900 mb-1\">Smart Fitness Watch</h3>\n            <p className=\"text-sm text-gray-500 mb-2\">Heart Rate · Sleep Tracking</p>\n            <div className=\"flex justify-between items-center mt-4\">\n              <span className=\"text-lg font-semibold text-green-600\">$149.00</span>\n              <button className=\"bg-black text-white px-4 py-2 rounded-lg hover800\">Buy</button>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n    </div>\n  );\n}\n",
