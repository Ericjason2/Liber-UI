      "content": "/**\n * Component: Sign In form\n * Author: @amit (https://tailwindflex.com/@amit)\n * Source: https://tailwindflex.com/@amit/sign-in-form\n * Attribution: Créé par @amit sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function SignInForm() {\n  return (\n    <div>\n    <form className=\"max-w-md \">\r\n        <div>\r\n            <label htmlFor=\"email\" className=\"block font-semibold\">Email</label>\r\n            <div className=\"mt-1\"><input type=\"text\" name=\"email\" id=\"email\" value=\"\" autoFocus=\"autofocus\" className=\"bg-white shadow-sm ring-0 block w-full text-lg focus focus500 border-tan-300 p-2 border-2\" />\r\n            </div>\r\n        </div>\r\n        <div className=\"mt-6\">\r\n            <div className=\"flex justify-between\">\r\n                <label htmlFor=\"password\" className=\"block font-semibold\">Password</label> <a href=\"\" tabIndex=\"-1\"\r\n                    className=\"branded-link text-sm font-semibold\">Forgot your password?</a>\r\n            </div>\r\n            <div className=\"mt-1\">\r\n                <input type=\"password\" name=\"password\" id=\"password\" className=\"bg-white shadow-sm ring-0 block w-full text-lg focus focus500 border-tan-300 p-2 border-2\" />\r\n            </div>\r\n        </div>\r\n    \r\n        <label className=\"mt-8 flex content-start\"><input type=\"checkbox\" name=\"remember\" className=\"mr-2 form-checkbox rounded-none ring-0 focus500 border-tan-300 border-2 w-5 h-5 text-highlight\" /> \r\n          <span className=\"text-sm font-semibold\">Remember me</span>\r\n        </label>\r\n        <div>\r\n            <button className=\"flex flex-no-wrap mt-6 border-2 border-black bg-yellow-500 py-2 px-4\">\r\n                <span>Sign In</span> \r\n                <span>\r\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"ml-2 w-6 h-6\"><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line><polyline points=\"12 5 19 12 12 19\"></polyline></svg>\r\n                </span>\r\n            </button>\r\n        </div>\r\n    </form>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
