      "content": "/**\n * Component: Blog Author Card\n * Author: @eliteai-tools (https://tailwindflex.com/@eliteai-tools)\n * Source: https://tailwindflex.com/@eliteai-tools/blog-author-card\n * Attribution: Créé par @eliteai-tools sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function BlogAuthorCard() {\n  return (\n    <div>\n    <div className=\"w-full rounded max-w-2xl mx-auto overflow-hidden bg-white dark800/50 backdrop-blur-lg\">\r\n        <div className=\"relative p-6 \">\r\n            \r\n            <div className=\"absolute inset-0 opacity-5 dark10\">\r\n                <div\r\n                    className=\"absolute inset-0 bg-gradient-to-r from-pink-100 via-purple-100 to-indigo-100 dark900 dark900 dark900\">\r\n                </div>\r\n                <div className=\"absolute inset-0\"\r\n                    style=\"background-image: radial-gradient(circle at 2px 2px, rgba(0,0,0,0.1) 1px, transparent 0); background-size: 20px 20px;\">\r\n                </div>\r\n            </div>\r\n    \r\n            \r\n            <div className=\"relative flex flex-col md md gap-6\">\r\n                \r\n                <div className=\"flex-shrink-0\">\r\n                    <div className=\"relative group\">\r\n                        <div\r\n                            className=\"absolute w-28 h-28 -inset-0.5 bg-gradient-to-r from-pink-600 to-purple-600 rounded-full blur opacity-40 group-hover75 transition duration-200\">\r\n                        </div>\r\n                        <img\r\n                src=\"https://randomuser.me/api/portraits/men/99.jpg\"\r\n                className=\"relative w-24 h-24 rounded-full object-cover border-2 border-white dark700\"\r\n                alt=\"Christian Nguyen\"\r\n              />\r\n                    </div>\r\n                </div>\r\n    \r\n                \r\n                <div className=\"flex-1 space-y-4\">\r\n                    <div>\r\n                        <h2 className=\"text-2xl font-bold text-gray-900 dark\">Christian Nguyen</h2>\r\n                        <p className=\"mt-1 text-gray-600 dark300\">\r\n                            Christian is a versatile content writer with a strong background in web development.\r\n                        </p>\r\n                    </div>\r\n    \r\n                    \r\n                    <div className=\"flex gap-4\">\r\n                        <a href=\"https://www.youtube.com/@mcqmate\" target=\"_blank\" rel=\"noopener noreferrer\"\r\n                            className=\"inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-700 dark200 bg-gray-100 dark700/50 rounded-full hover200 dark600/50 transition-colors duration-200\">\r\n                            <svg className=\"w-6 h-6\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\">\r\n                                <path fillRule=\"evenodd\" clipRule=\"evenodd\"\r\n                                    d=\"M20.5949 4.45999C21.5421 4.71353 22.2865 5.45785 22.54 6.40501C22.9982 8.12001 23 11.7004 23 11.7004C23 11.7004 23 15.2807 22.54 16.9957C22.2865 17.9429 21.5421 18.6872 20.5949 18.9407C18.88 19.4007 12 19.4007 12 19.4007C12 19.4007 5.12001 19.4007 3.405 18.9407C2.45785 18.6872 1.71353 17.9429 1.45999 16.9957C1 15.2807 1 11.7004 1 11.7004C1 11.7004 1 8.12001 1.45999 6.40501C1.71353 5.45785 2.45785 4.71353 3.405 4.45999C5.12001 4 12 4 12 4C12 4 18.88 4 20.5949 4.45999ZM15.5134 11.7007L9.79788 15.0003V8.40101L15.5134 11.7007Z\"\r\n                                    stroke=\"currentColor\" strokeLinejoin=\"round\"></path>\r\n                            </svg>\r\n                            <span>YouTube</span>\r\n                        </a>\r\n    \r\n                        <a href=\"https://mcqmate.com/\" target=\"_blank\" rel=\"noopener noreferrer\"\r\n                            className=\"inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-700 dark200 bg-gray-100 dark700/50 rounded-full hover200 dark600/50 transition-colors duration-200\">\r\n                            <svg className=\"w-6 h-6\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\"\r\n                                viewBox=\"0 0 24 24\" strokeWidth=\"1\" stroke=\"currentColor\">\r\n                                <path strokeLinecap=\"round\" strokeLinejoin=\"round\"\r\n                                    d=\"M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418\">\r\n                                </path>\r\n                            </svg>\r\n                            <span>Website</span>\r\n                        </a>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\n    </div>\n  );\n}\n",
