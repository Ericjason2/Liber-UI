ass=\"w-full px-3 py-2 text-sm leading-tight text-gray-700 dark:text-white border rounded shadow appearance-none focus:outline-none focus:shadow-outline\"\n                                    id=\"lastName\"\n                                    type=\"text\"\n                                    placeholder=\"Last Name\"\n                                />\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"mb-4\">\n\t\t\t\t\t\t\t<label class=\"block mb-2 text-sm font-bold text-gray-700 dark:text-white\" for=\"email\">\n                                Email\n                            </label>\n\t\t\t\t\t\t\t<input\n                                class=\"w-full px-3 py-2 mb-3 text-sm leading-tight text-gray-700 dark:text-white border rounded shadow appearance-none focus:outline-none focus:shadow-outline\"\n                                id=\"email\"\n                                type=\"email\"\n                                placeholder=\"Email\"\n                            />\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"mb-4 md:flex md:justify-between\">\n\t\t\t\t\t\t\t<div class=\"mb-4 md:mr-2 md:mb-0\">\n\t\t\t\t\t\t\t\t<label class=\"block mb-2 text-sm font-bold text-gray-700 dark:text-white\" for=\"password\">\n                                    Password\n                                </label>\n\t\t\t\t\t\t\t\t<input\n                                    class=\"w-full px-3 py-2 mb-3 text-sm leading-tight text-gray-700 dark:text-white border border-red-500 rounded shadow appearance-none focus:outline-none focus:shadow-outline\"\n                                    id=\"password\"\n                                    type=\"password\"\n                                    placeholder=\"******************\"\n                                />\n\t\t\t\t\t\t\t\t<p class=\"text-xs italic text-red-500\">Please choose a password.</p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"md:ml-2\">\n\t\t\t\t\t\t\t\t<label class=\"block mb-2 text-sm