block mb-2 text-sm font-bold text-gray-700 dark\" htmlFor=\"lastName\">\n                                        Last Name\n                                    </label>\n    \t\t\t\t\t\t\t\t<input\n                                        className=\"w-full px-3 py-2 text-sm leading-tight text-gray-700 dark border rounded shadow appearance-none focus focus\"\n                                        id=\"lastName\"\n                                        type=\"text\"\n                                        placeholder=\"Last Name\"\n                                    />\n    \t\t\t\t\t\t\t</div>\n    \t\t\t\t\t\t</div>\n    \t\t\t\t\t\t<div className=\"mb-4\">\n    \t\t\t\t\t\t\t<label className=\"block mb-2 text-sm font-bold text-gray-700 dark\" htmlFor=\"email\">\n                                    Email\n                                </label>\n    \t\t\t\t\t\t\t<input\n                                    className=\"w-full px-3 py-2 mb-3 text-sm leading-tight text-gray-700 dark border rounded shadow appearance-none focus focus\"\n                                    id=\"email\"\n                                    type=\"email\"\n                                    placeholder=\"Email\"\n                                />\n    \t\t\t\t\t\t</div>\n    \t\t\t\t\t\t<div className=\"mb-4 md md\">\n    \t\t\t\t\t\t\t<div className=\"mb-4 md2 md0\">\n    \t\t\t\t\t\t\t\t<label className=\"block mb-2 text-sm font-bold text-gray-700 dark\" htmlFor=\"password\">\n                                        Password\n                                    </label>\n    \t\t\t\t\t\t\t\t<input\n                                        className=\"w-full px-3 py-2 mb-3 text-sm leading-tight text-gray-700 dark border border-red-500 rounded shadow appearance-none focus focus\"\n                                        id=\"password\"\n                                        type=\"password\"\n                                        placeholder=\"******************\"\n                                    />\n    \t\t\t\t\t\t\t\t<p className=\"text-xs italic text-red-500\">Please choose a password.</p>\n    \t\t\t\t\t\t\t</div>\n    \t\t\t\t\t\t\t<div className=\"md2\">\n    \t\t\t\t\t\t\t\t<label className=\"block mb-2 text-sm font-bold text-gray-700 dark\" htmlFor=\"c_password\">\n                                        Confirm Password\n                                    </label>\n    \t\t\t\t\t\t\t\t<input\n                                        className=\"w-full px-3 py-2 mb-3 text-sm leading-tight text-gray-700 dark border rounded shadow appearance-none focus focus\"\n                                        id=\"c_password\"\n                                        type=\"password\"\n                                        placeholder=\"******************\"\n                                    />\n    \t\t\t\t\t\t\t</div>\n    \t\t\t\t\t\t</div>\n    \t\t\t\t\t\t<div className=\"mb-6 text-center\">\n    \t\t\t\t\t\t\t<button\n                                    className=\"w-full px-4 py-2 font-bold text-white bg-blue-500 rounded-full hover700 dark700 dark dark900 focus focus\"\n                                    type=\"button\"\n                                >\n                                    Register Account\n                                </button>\n    \t\t\t\t\t\t</div>\n    \t\t\t\t\t\t<hr className=\"mb-6 border-t\" />\n    \t\t\t\t\t\t<div className=\"text-center\">\n    \t\t\t\t\t\t\t<a className=\"inline-block text-sm text-blue-500 dark500 align-baseline hover800\"\n    \t\t\t\t\t\t\t\thref=\"#\">\n    \t\t\t\t\t\t\t\tForgot Password?\n    \t\t\t\t\t\t\t</a>\n    \t\t\t\t\t\t</div>\n    \t\t\t\t\t\t<div className=\"text-center\">\n    \t\t\t\t\t\t\t<a className=\"inline-block text-sm text-blue-500 dark500 align-baseline hover800\"\n    \t\t\t\t\t\t\t\thref=\"./index.html\">\n    \t\t\t\t\t\t\t\tAlready have an account? Login!\n    \t\t\t\t\t\t\t</a>\n    \t\t\t\t\t\t</div>\n    \t\t\t\t\t</form>\n    \t\t\t\t</div>\n  