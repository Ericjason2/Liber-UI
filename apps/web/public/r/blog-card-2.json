      "content": "/**\n * Component: Blog Card\n * Author: @robert-chunga (https://tailwindflex.com/@robert-chunga)\n * Source: https://tailwindflex.com/@robert-chunga/blog-card-2\n * Attribution: Créé par @robert-chunga sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function BlogCard2() {\n  return (\n    <div>\n    <div className=\"bg-gray-200 dark800 flex items-center p-8\">\n        <div className=\"py-8 px-4 mx-auto max-w-screen-xl h-screen lg16 lg6\">\n            \n            <div className=\"bg-white w-96 p-4 border-2 border-gray-300 dark500 shadow-lg rounded-xl dark700\">\n                \n                <div>\n                    <a href=\"#\">\n                        <img className=\"rounded-lg\" src=\"https://images.unsplash.com/photo-1519389950473-47ba0277781c?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w0NzEyNjZ8MHwxfHNlYXJjaHw1fHx0ZWNobm9sb2d5fGVufDB8MHx8fDE3MTk1OTg4Njd8MA&ixlib=rb-4.0.3&q=80&w=1080\" alt=\"image\" />\n                    </a>\n                </div>\n                \n                \n                <div className=\"capitalize text-purple-900 font-semibold my-4 bg-purple-200 w-fit px-3 rounded-lg\">\n                    <p>article</p>\n                </div>\n                \n                \n                <div className=\"text-2xl font-bold my-2 dark\">\n                    <a href=\"#\">\n                        <h2>Getting started with tailwind</h2>\n                    </a>\n                </div>\n                \n                \n                <div className=\"dark400\">\n                    <p>Getting started with Tailwind CSS is easy: install it via npm, configure your settings, and start building responsive, utility-first designs with minimal custom CSS.</p>\n                </div>\n                \n                \n                <div className=\"flex items-cente\">\n                    \n                    <div className=\"mt-4\">\n                        <img className=\"w-12 h-12 object-cover rounded-full\" src=\"https://images.unsplash.com/photo-1624188327913-e0c59aaaa3ae?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w0NzEyNjZ8MHwxfHNlYXJjaHw2fHxibGFjayUyMG1hbnxlbnwwfDB8fHwxNzE5NjAxMzQ2fDA&ixlib=rb-4.0.3&q=80&w=1080\" alt=\"image\" />\n                    </div>\n                    \n                    \n                    <div className=\"block mt-3.5\">\n                        \n                        <div className=\"capitalize text-lg font-semibold pl-4 dark\">\n                            <h3>robert chunga</h3>\n                        </div>\n                        \n                        \n                        <div className=\"capitalize text-sm text-gray-400 pl-4\">\n                            <p>Aug 15, 2021 · 16 min read</p>\n                        </div>\n                        \n                    </div>\n                    \n                </div>\n                \n            </div>\n            \n        </div>\n    </div>\n    </div>\n  );\n}\n",
