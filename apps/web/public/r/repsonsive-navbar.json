    "rawHtml": "<script src=\"//unpkg.com/alpinejs\" defer></script>\n<header class=\"bg-green-600 text-gray-200 text-sm\">\n    <div class=\"max-w-7xl mx-auto px-4\">\n        <div class=\"flex flex-col lg:flex-row justify-between items-center py-3 gap-2\">\n\n            <!-- Left Info -->\n            <div class=\"flex flex-col sm:flex-row sm:items-center gap-3\">\n\n                <!-- Address -->\n                <div class=\"flex items-center gap-2\">\n                    <i class=\"bi bi-geo-alt text-blue-400\"></i>\n                    <span>Pune, India</span>\n                </div>\n\n                <!-- Email -->\n                <div class=\"flex items-center gap-2\">\n                    <i class=\"bi bi-envelope text-blue-400\"></i>\n                    <a href=\"mailto:info@company.com\" \n                       class=\"hover:text-blue-400 transition\">\n                        info@company.com\n                    </a>\n                </div>\n\n            </div>\n\n            <!-- Social Icons (Desktop Only) -->\n            <div class=\"hidden lg:flex items-center gap-4\">\n\n                <a href=\"#\" \n                   class=\"hover:text-blue-400 transition\">\n                    <i class=\"bi bi-twitter\"></i>\n                </a>\n\n                <a href=\"#\" \n                   class=\"hover:text-blue-600 transition\">\n                    <i class=\"bi bi-facebook\"></i>\n                </a>\n\n                <a href=\"#\" \n                   class=\"hover:text-pink-400 transition\">\n                    <i class=\"bi bi-instagram\"></i>\n                </a>\n\n                <a href=\"#\" \n                   class=\"hover:text-red-500 transition\">\n                    <i class=\"bi bi-youtube\"></i>\n                </a>\n\n                <a href=\"#\" \n                   class=\"hover:text-green-400 transition\">\n                    <i class=\"bi bi-whatsapp\"></i>\n                </a>\n\n            </div>\n\n        </div>\n    </div>\n</header>\n<nav x-data=\"{ open: false, dropdown: false }\" \n     class=\"bg-white shadow-lg sticky top-0 z-50\">\n\n    <div class=\"max-w-7xl mx-auto px-4\">\n        <div class=\"flex justify-between items-center h-20\">\n\n            <!-- Logo -->\n            <a href=\"/\" class=\"flex items-center space-x-3\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\"\n                                    fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"\n                                    stroke-linejoin=\"round\" class=\"h-6 w-6\">\n                                    <path d=\"M9 11a3 3 0 1 0 6 0a3 3 0 0 0 -6 0\"></path>\n                                    <path\n                                        d=\"M17.657 16.657l-4.243 4.243a2 2 0 0 1 -2.827 0l-4.244 -4.243a8 8 0 1 1 11.314 0z\">\n                                    </path>\n                                </svg>\n                <div class=\"leading-tight\">\n                    <div class=\"font-bold text-lg\">Charity</div>\n                    <div class=\"text-sm text-gray-500\">Non-profit Organization</div>\n                </div>\n            </a>\n\n            <!-- Desktop Menu -->\n            <div class=\"hidden lg:flex items-center space-x-8\">\n\n                <a href=\"#top\" class=\"text-gray-700 hover:text-blue-600 font-medium\">Home</a>\n                <a href=\"#section_2\" class=\"text-gray-700 hover:text-blue-600\">About</a>\n                <a href=\"#section_3\" class=\"text-gray-700 hover:text-blue-600\">Causes</a>\n                <a href=\"#section_4\" class=\"text-gray-700 hover:text-blue-600\">Volunteer</a>\n\n                <!-- Dropdown -->\n                <div class=\"relative\" @mouseenter=\"dropdown = true\" @mouseleave=\"dropdown = false\">\n                    <button class=\"text-gray-700 hover:text-blue-600 flex items-center\">\n                        News\n                        <svg class=\"w-4 h-4 ml-1\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"\n                             viewBox=\"0 0 24 24\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M19 9l-7 7-7-7\" />\n                        </svg>\n                    </button>\n\n                    <div x-show=\"dropdown\"\n                         x-transition\n                         class=\"absolute left-0 mt-2 w-44 bg-white rounded-xl shadow-lg py-2\">\n                        <a href=\"/news/\" class=\"block px-4 py-2 hover:bg-gray-100\">News Listing</a>\n                        <a href=\"/news-detail/\" class=\"block px-4 py-2 hover:bg-gray-100\">News Detail</a>\n                    </div>\n                </div>\n\n                <a href=\"#section_6\" class=\"text-gray-700 hover:text-blue-600\">Contact</a>\n\n                <!-- Donate Button -->\n                <a href=\"/donate/\" \n                   class=\"ml-4 px-5 py-2 rounded-full border border-blue-600 text-blue-600 hover:bg-blue-600 hover:text-white transition font-medium\">\n                    Donate\n                </a>\n            </div>\n\n            <!-- Mobile Hamburger -->\n            <button @click=\"open = !open\" \n                    class=\"lg:hidden focus:outline-none\">\n                <svg class=\"w-7 h-7 text-gray-700\" fill=\"none\" stroke=\"currentColor\"\n                     viewBox=\"0 0 24 24\">\n                    <path x-show=\"!open\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"\n                          d=\"M4 6h16M4 12h16M4 18h16\"/>\n                    <path x-show=\"open\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"\n                          d=\"M6 18L18 6M6 6l12 12\"/>\n                </svg>\n            </button>\n\n        </div>\n    </div>\n\n    <!-- Mobile Menu -->\n    <div x-show=\"open\" x-transition class=\"lg:hidden bg-white shadow-md\">\n        <div class=\"px-4 py-4 space-y-4\">\n\n            <a href=\"#top\" class=\"block text-gray-700\">Home</a>\n            <a href=\"#section_2\" class=\"block text-gray-700\">About</a>\n            <a href=\"#section_3\" class=\"block text-gray-700\">Causes</a>\n            <a href=\"#section_4\" class=\"block text-gray-700\">Volunteer</a>\n\n            <div>\n                <button @click=\"dropdown = !dropdown\" \n                        class=\"w-full text-left text-gray-700 flex justify-between items-center\">\n                    News\n                    <span>+</span>\n                </button>\n                <div x-show=\"dropdown\" class=\"pl-4 mt-2 space-y-2\">\n                    <a href=\"/news/\" class=\"block text-gray-600\">News Listing</a>\n                    <a href=\"/news-detail/\" class=\"block text-gray-600\">News Detail</a>\n                </div>\n            </div>\n\n            <a href=\"#section_6\" class=\"block text-gray-700\">Contact</a>\n\n            <a href=\"/donate/\" \n               class=\"block text-center bg-blue-600 text-white py-2 rounded-full mt-4\">\n                Donate\n            </a>\n\n        </div>\n    </div>\n\n</nav>"
