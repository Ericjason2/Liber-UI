      "content": "import * as React from \"react\"\n\nfunction RepsonsiveNavbar({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"repsonsive-navbar\"\n      className={className}\n      {...props}\n    >\n      <header className=\"bg-green-600 text-gray-200 text-sm\">\n          <div className=\"max-w-7xl mx-auto px-4\">\n              <div className=\"flex flex-col lg:flex-row justify-between items-center py-3 gap-2\">\n      \n                  \n                  <div className=\"flex flex-col sm:flex-row sm:items-center gap-3\">\n      \n                      \n                      <div className=\"flex items-center gap-2\">\n                          <i className=\"bi bi-geo-alt text-blue-400\"></i>\n                          <span>Pune, India</span>\n                      </div>\n      \n                      \n                      <div className=\"flex items-center gap-2\">\n                          <i className=\"bi bi-envelope text-blue-400\"></i>\n                          <a href=\"mailto:info@company.com\" \n                             className=\"hover:text-blue-400 transition\">\n                              info@company.com\n                          </a>\n                      </div>\n      \n                  </div>\n      \n                  \n                  <div className=\"hidden lg:flex items-center gap-4\">\n      \n                      <a href=\"#\" \n                         className=\"hover:text-blue-400 transition\">\n                          <i className=\"bi bi-twitter\"></i>\n                      </a>\n      \n                      <a href=\"#\" \n                         className=\"hover:text-blue-600 transition\">\n                          <i className=\"bi bi-facebook\"></i>\n                      </a>\n      \n                      <a href=\"#\" \n                         className=\"hover:text-pink-400 transition\">\n                          <i className=\"bi bi-instagram\"></i>\n                      </a>\n      \n                      <a href=\"#\" \n                         className=\"hover:text-red-500 transition\">\n                          <i className=\"bi bi-youtube\"></i>\n                      </a>\n      \n                      <a href=\"#\" \n                         className=\"hover:text-green-400 transition\">\n                          <i className=\"bi bi-whatsapp\"></i>\n                      </a>\n      \n                  </div>\n      \n              </div>\n          </div>\n      </header>\n      <nav \n           className=\"bg-white shadow-lg sticky top-0 z-50\">\n      \n          <div className=\"max-w-7xl mx-auto px-4\">\n              <div className=\"flex justify-between items-center h-20\">\n      \n                  \n                  <a href=\"/\" className=\"flex items-center space-x-3\">\n                      <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\"\n                                          fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\"\n                                          strokeLinejoin=\"round\" className=\"h-6 w-6\">\n                                          <path d=\"M9 11a3 3 0 1 0 6 0a3 3 0 0 0 -6 0\"></path>\n                                          <path\n                                              d=\"M17.657 16.657l-4.243 4.243a2 2 0 0 1 -2.827 0l-4.244 -4.243a8 8 0 1 1 11.314 0z\">\n                                          </path>\n                                      </svg>\n                      <div className=\"leading-tight\">\n                          <div className=\"font-bold text-lg\">Charity</div>\n                          <div className=\"text-sm text-gray-500\">Non-profit Organization</div>\n                      </div>\n                  </a>\n      \n                  \n                  <div className=\"hidden lg:flex items-center space-x-8\">\n      \n                      <a href=\"#top\" className=\"text-gray-700 hover:text-blue-600 font-medium\">Home</a>\n                      <a href=\"#section_2\" className=\"text-gray-700 hover:text-blue-600\">About</a>\n                      <a href=\"#section_3\" className=\"text-gray-700 hover:text-blue-600\">Causes</a>\n                      <a href=\"#section_4\" className=\"text-gray-700 hover:text-blue-600\">Volunteer</a>\n      \n                      \n                      <div className=\"relative\">\n                          <button className=\"text-gray-700 hover:text-blue-600 flex items-center\">\n                              News\n                              <svg className=\"w-4 h-4 ml-1\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"\n                                   viewBox=\"0 0 24 24\">\n                                  <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M19 9l-7 7-7-7\" />\n                              </svg>\n                          </button>\n      \n                          <div\n                              \n                               className=\"absolute left-0 mt-2 w-44 bg-white rounded-xl shadow-lg py-2\">\n                              <a href=\"/news/\" className=\"block px-4 py-2 hover:bg-gray-100\">News Listing</a>\n                              <a href=\"/news-detail/\" className=\"block px-4 py-2 hover:bg-gray-100\">News Detail</a>\n                          </div>\n                      </div>\n      \n                      <a href=\"#section_6\" className=\"text-gray-700 hover:text-blue-600\">Contact</a>\n      \n                      \n                      <a href=\"/donate/\" \n                         className=\"ml-4 px-5 py-2 rounded-full border border-blue-600 text-blue-600 hover:bg-blue-600 hover:text-white transition font-medium\">\n                          Donate\n                      </a>\n                  </div>\n      \n                  \n                  <button \n                          className=\"lg:hidden focus:outline-none\">\n                      <svg className=\"w-7 h-7 text-gray-700\" fill=\"none\" stroke=\"currentColor\"\n                           viewBox=\"0 0 24 24\">\n                          <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\"\n                                d=\"M4 6h16M4 12h16M4 18h16\"/>\n                          <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\"\n                                d=\"M6 18L18 6M6 6l12 12\"/>\n                      </svg>\n                  </button>\n      \n              </div>\n          </div>\n      \n          \n          <div className=\"lg:hidden bg-white shadow-md\">\n              <div className=\"px-4 py-4 space-y-4\">\n      \n                  <a href=\"#top\" className=\"block text-gray-700\">Home</a>\n                  <a href=\"#section_2\" className=\"block text-gray-700\">About</a>\n                  <a href=\"#section_3\" className=\"block text-gray-700\">Causes</a>\n                  <a href=\"#section_4\" className=\"block text-gray-700\">Volunteer</a>\n      \n                  <div>\n                      <button \n                              className=\"w-full text-left text-gray-700 flex justify-between items-center\">\n                          News\n                          <span>+</span>\n                      </button>\n                      <div className=\"pl-4 mt-2 space-y-2\">\n                          <a href=\"/news/\" className=\"block text-gray-600\">News Listing</a>\n                          <a href=\"/news-detail/\" className=\"block text-gray-600\">News Detail</a>\n                      </div>\n                  </div>\n      \n                  <a href=\"#section_6\" className=\"block text-gray-700\">Contact</a>\n      \n                  <a href=\"/donate/\" \n                     className=\"block text-center bg-blue-600 text-white py-2 rounded-full mt-4\">\n                      Donate\n                  </a>\n      \n              </div>\n          </div>\n      \n      </nav>\n    </div>\n  )\n}\n\nexport { RepsonsiveNavbar }\n",
      "type": "registry:ui"
    }
