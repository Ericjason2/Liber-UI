      "content": "/**\n * Component: Tailwind Sidebar Layout\n * Author: @agauzejr (https://tailwindflex.com/@agauzejr)\n * Source: https://tailwindflex.com/@agauzejr/tailwind-sidebar-layout-5\n * Attribution: Créé par @agauzejr sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function TailwindSidebarLayout5() {\n  return (\n    <div>\n    <div className=\"absolute bg-gray-800 text-white w-72 min-h-screen overflow-y-auto transition-transform transform -translate- ease-in-out duration-200\"\r\n                id=\"sidebar\">\r\n                \r\n                <div className=\"p-4\">\r\n                    <h1 className=\"text-2xl font-semibold\">Sidebar</h1>\r\n                    <ul className=\"mt-4\">\r\n                        <li className=\"mb-2\"><a href=\"#\" className=\"block hover400\">Home</a></li>\r\n                        <li className=\"mb-2\"><a href=\"#\" className=\"block hover400\">Item 1</a></li>\r\n                        <li className=\"mb-2\"><a href=\"#\" className=\"block hover400\">Item 2</a></li>\r\n                        <li className=\"mb-2\"><a href=\"#\" className=\"block hover400\">Item 3</a></li>\r\n                    </ul>\r\n                </div>\r\n            </div>\r\n    \r\n            \r\n            <div className=\"flex-1 flex flex-col overflow-hidden absolute w-full\">\r\n                \r\n                <div className=\"bg-white shadow\">\r\n                    <div className=\"container mx-auto\">\r\n                        <div className=\"flex py-4 px-2\">\r\n    \r\n                            <button className=\"text-gray-500 hover600\" id=\"open-sidebar\">\r\n                                <svg className=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                                    <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"M4 6h16M4 12h16M4 18h16\"></path>\r\n                                </svg>\r\n                            </button>\r\n    \r\n                            <h1 className=\"text-xl font-semibold\">Menu Collapsed</h1>\r\n    \r\n                        </div>\r\n                    </div>\r\n                </div>\r\n        \r\n                \r\n        \r\n            </div>\r\n    \r\n    \n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
