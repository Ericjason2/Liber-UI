      "path": "components/ui/tailwind-css-contact-form.tsx",
      "content": "import * as React from \"react\"\n\nfunction TailwindCssContactForm({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"tailwind-css-contact-form\"\n      className={className}\n      {...props}\n    >\n      <div className=\"bg-gray-50 max-w-screen-xl mx-auto\">\n            <div className=\"grid lg3 justify-center items-center gap-y-12\">\n              <div className=\"lg2 p-8 w-full max-w-2xl mx-auto\">\n                <div>\n                  <h2 className=\"text-3xl text-slate-900 font-bold\">Contact us</h2>\n                  <p className=\"text-[15px] text-slate-600 leading-relaxed mt-4\">Have questions or need assistance? We're here to help! Reach out to our team for support, inquiries, or collaboration opportunities.</p>\n                </div>\n                <form className=\"mt-8\">\n                  <div className=\"grid sm2 gap-4\">\n                    <div>\n                      <label className='text-sm text-slate-900 font-medium mb-2 block'>Name</label>\n                      <input type='text' placeholder='Enter Name'\n                        className=\"w-full py-3 px-4 text-slate-800 bg-white border border-gray-300 focus900 text-sm outline-0 rounded-md\" />\n                    </div>\n                    <div>\n                      <label className='text-sm text-slate-900 font-medium mb-2 block'>Email</label>\n                      <input type='email' placeholder='Enter Email'\n                        className=\"w-full py-3 px-4 text-slate-800 bg-white border border-gray-300 focus900 text-sm outline-0 rounded-md\" />\n                    </div>\n                    <div>\n                      <label className='text-sm text-slate-900 font-medium mb-2 block'>Phone No.</label>\n                      <input type='number' placeholder='Enter Phone No.'\n                        className=\"w-full py-3 px-4 text-slate-800 bg-white border border-gray-300 focus900 text-sm outline-0 rounded-md\" />\n                    </div>\n                    <div>\n                      <label className='text-sm text-slate-900 font-medium mb-2 block'>Subject</label>\n                      <input type='text' placeholder='Enter Subject'\n                        className=\"w-full py-3 px-4 text-slate-800 bg-white border border-gray-300 focus900 text-sm outline-0 rounded-md\" />\n                    </div>\n                    <div className=\"col-span-full\">\n                      <label className='text-sm text-slate-900 font-medium mb-2 block'>Message</label>\n                      <textarea placeholder='Enter Message' rows=\"6\"\n                        className=\"w-full px-4 text-slate-800 bg-white border border-gray-300 focus900 text-sm pt-3 outline-0 rounded-md\"></textarea>\n                    </div>\n                  </div>\n                  <button type='button'\n                    className=\"text-white bg-slate-900 font-medium hover800 tracking-wide text-sm px-4 py-3 w-full border-0 outline-0 rounded-md cursor-pointer mt-6\">Send message</button>\n                </form>\n              </div>\n      \n              <div className=\"relative lg\">\n                <img src=\"https://readymadeui.com/team-image.webp\" alt=\"app-img\"\n                  className=\"w-full h-full object-cover object-top lg lg0 lg0 lg0\" />\n              </div>\n            </div>\n          </div>\n    </div>\n  )\n}\n\nexport { TailwindCssContactForm }\n",
      "type": "registry:ui"
    }
  ],
