    "rawHtml": "<!DOCTYPE html>\n<html lang=\"tr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Modern Kart Galerisi</title>\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.js\"></script>\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css\">\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');\n        \n        body {\n            font-family: 'Poppins', sans-serif;\n            background-color: #f8f9ff;\n        }\n        \n        .card {\n            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);\n            overflow: hidden;\n            border-radius: 15px;\n        }\n        \n        .card:hover {\n            transform: translateY(-12px);\n            box-shadow: 0 20px 30px rgba(0, 0, 0, 0.1);\n        }\n        \n        .card-image {\n            transition: transform 0.8s;\n        }\n        \n        .card:hover .card-image {\n            transform: scale(1.05);\n        }\n        \n        .card-overlay {\n            background: linear-gradient(to bottom, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.65) 100%);\n        }\n        \n        .slider-container {\n            scroll-behavior: smooth;\n        }\n        \n        .nav-button {\n            transition: all 0.3s;\n            opacity: 0.9;\n        }\n        \n        .nav-button:hover {\n            transform: scale(1.1);\n            opacity: 1;\n        }\n        \n        .badge {\n            position: absolute;\n            top: 1rem;\n            right: 1rem;\n            padding: 0.25rem 0.75rem;\n            border-radius: 50px;\n            font-size: 0.75rem;\n            font-weight: 600;\n            letter-spacing: 0.5px;\n            text-transform: uppercase;\n        }\n        \n        .feature-card {\n            transition: all 0.3s ease;\n            border-radius: 16px;\n            overflow: hidden;\n        }\n        \n        .feature-card:hover {\n            transform: translateY(-8px);\n        }\n        \n        .feature-icon {\n            transition: all 0.3s ease;\n        }\n        \n        .feature-card:hover .feature-icon {\n            transform: scale(1.15);\n        }\n        \n        .hide-scrollbar::-webkit-scrollbar {\n            display: none;\n        }\n        \n        .hide-scrollbar {\n            -ms-overflow-style: none;\n            scrollbar-width: none;\n        }\n        \n        .gradient-text {\n            background: linear-gradient(90deg, #3b82f6, #8b5cf6);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n        }\n        \n        .blur-backdrop {\n            backdrop-filter: blur(8px);\n            background-color: rgba(255, 255, 255, 0.8);\n        }\n    </style>\n</head>\n<body class=\"min-h-screen py-12 px-4 sm:px-6 lg:px-8\">\n    <div class=\"max-w-6xl mx-auto\">\n        <!-- Header -->\n        <div class=\"text-center mb-16 animate__animated animate__fadeIn\">\n            <h1 class=\"text-4xl font-bold sm:text-5xl lg:text-6xl mb-4\">\n                <span class=\"gradient-text\">Modern Galeri</span>\n            </h1>\n            <p class=\"mt-5 max-w-xl mx-auto text-xl text-gray-600\">\n                Tailwind CSS ile oluşturulmuş zarif ve etkileşimli içerik sliderı\n            </p>\n            <div class=\"w-24 h-1 bg-gradient-to-r from-blue-500 to-purple-600 mx-auto mt-6 rounded-full\"></div>\n        </div>\n\n        <!-- Card Slider -->\n        <div class=\"relative mb-24\">\n            <!-- Slider Controls -->\n            <div class=\"flex justify-between absolute inset-0 items-center z-10 px-4 pointer-events-none\">\n                <button id=\"prev-btn\" class=\"nav-button bg-white p-3 rounded-full shadow-lg text-gray-800 pointer-events-auto focus:outline-none hover:bg-gray-50 transform transition\">\n                    <i class=\"fas fa-chevron-left\"></i>\n                </button>\n                <button id=\"next-btn\" class=\"nav-button bg-white p-3 rounded-full shadow-lg text-gray-800 pointer-events-auto focus:outline-none hover:bg-gray-50 transform transition\">\n                    <i class=\"fas fa-chevron-right\"></i>\n                </button>\n            </div>\n\n            <!-- Slider Container -->\n            <div id=\"slider\" class=\"slider-container flex overflow-x-auto hide-scrollbar py-8 snap-x snap-mandatory\">\n                <div class=\"flex space-x-6 px-4\">\n                    <!-- Card 1 -->\n                    <div class=\"card flex-none w-80 bg-white shadow-lg snap-center\">\n                        <div class=\"relative h-56 overflow-hidden\">\n                            <div class=\"absolute inset-0 bg-gradient-to-r from-blue-500 to-indigo-600 flex items-center justify-center\">\n                                <i class=\"fas fa-laptop-code text-white text-5xl card-image\"></i>\n                            </div>\n                            <div class=\"absolute inset-0 card-overlay flex flex-col justify-end p-6 text-white\">\n                                <h3 class=\"font-bold text-xl\">Teknoloji</h3>\n                                <p class=\"text-sm text-gray-200 mt-1\">Yenilikçi teknolojilerle geleceği şekillendirin</p>\n                            </div>\n                            <span class=\"badge bg-green-500 text-white\">Yeni</span>\n                        </div>\n                        <div class=\"p-6\">\n                            <p class=\"text-gray-600 mb-4\">Modern web teknolojileri ve yazılım geliştirme araçları ile projelerinizi hayata geçirin.</p>\n                            <button class=\"w-full bg-gradient-to-r from-blue-500 to-indigo-600 text-white px-4 py-2.5 rounded-lg hover:opacity-90 transition flex items-center justify-center\">\n                                <span>Keşfet</span>\n                                <i class=\"fas fa-arrow-right ml-2\"></i>\n                            </button>\n                        </div>\n                    </div>\n\n                    <!-- Card 2 -->\n                    <div class=\"card flex-none w-80 bg-white shadow-lg snap-center\">\n                        <div class=\"relative h-56 overflow-hidden\">\n                            <div class=\"absolute inset-0 bg-gradient-to-r from-purple-500 to-pink-500 flex items-center justify-center\">\n                                <i class=\"fas fa-comments text-white text-5xl card-image\"></i>\n                            </div>\n                            <div class=\"absolute inset-0 card-overlay flex flex-col justify-end p-6 text-white\">\n                                <h3 class=\"font-bold text-xl\">İletişim</h3>\n                                <p class=\"text-sm text-gray-200 mt-1\">Etkili iletişim stratejileri</p>\n                            </div>\n                        </div>\n                        <div class=\"p-6\">\n                            <p class=\"text-gray-600 mb-4\">Ekip içi iletişim ve müşteri ilişkilerinde başarılı olmak için gerekli tüm bilgiler.</p>\n                            <button class=\"w-full bg-gradient-to-r from-purple-500 to-pink-500 text-white px-4 py-2.5 rounded-lg hover:opacity-90 transition flex items-center justify-center\">\n                                <span>Keşfet</span>\n                                <i class=\"fas fa-arrow-right ml-2\"></i>\n                            </button>\n                        </div>\n                    </div>\n\n                    <!-- Card 3 -->\n                    <div class=\"card flex-none w-80 bg-white shadow-lg snap-center\">\n                        <div class=\"relative h-56 overflow-hidden\">\n                            <div class=\"absolute inset-0 bg-gradient-to-r from-pink-500 to-red-500 flex items-center justify-center\">\n                                <i class=\"fas fa-book-open text-white text-5xl card-image\"></i>\n                            </div>\n                            <div class=\"absolute inset-0 card-overlay flex flex-col justify-end p-6 text-white\">\n                                <h3 class=\"font-bold text-xl\">Eğitim</h3>\n                                <p class=\"text-sm text-gray-200 mt-1\">Sürekli öğrenme ve gelişme</p>\n                            </div>\n                            <span class=\"badge bg-yellow-500 text-white\">Popüler</span>\n                        </div>\n                        <div class=\"p-6\">\n                            <p class=\"text-gray-600 mb-4\">Kariyer gelişiminiz için önemli becerileri öğrenin ve kendinizi sürekli geliştirin.</p>\n                            <button class=\"w-full bg-gradient-to-r from-pink-500 to-red-500 text-white px-4 py-2.5 rounded-lg hover:opacity-90 transition flex items-center justify-center\">\n                                <span>Keşfet</span>\n                                <i class=\"fas fa-arrow-right ml-2\"></i>\n                            </button>\n                        </div>\n                    </div>\n\n                    <!-- Card 4 -->\n                    <div class=\"card flex-none w-80 bg-white shadow-lg snap-center\">\n                        <div class=\"relative h-56 overflow-hidden\">\n                            <div class=\"absolute inset-0 bg-gradient-to-r from-green-500 to-teal-500 flex items-center justify-center\">\n                                <i class=\"fas fa-chart-pie text-white text-5xl card-image\"></i>\n                            </div>\n                            <div class=\"absolute inset-0 card-overlay flex flex-col justify-end p-6 text-white\">\n                                <h3 class=\"font-bold text-xl\">Analitik</h3>\n                                <p class=\"text-sm text-gray-200 mt-1\">Veri analizi ve iç görüler</p>\n                            </div>\n                        </div>\n                        <div class=\"p-6\">\n                            <p class=\"text-gray-600 mb-4\">Verileri analiz edin ve işletmeniz için akıllı kararlar alın. Geleceği öngörün.</p>\n                            <button class=\"w-full bg-gradient-to-r from-green-500 to-teal-500 text-white px-4 py-2.5 rounded-lg hover:opacity-90 transition flex items-center justify-center\">\n                                <span>Keşfet</span>\n                                <i class=\"fas fa-arrow-right ml-2\"></i>\n                            </button>\n                        </div>\n                    </div>\n\n                    <!-- Card 5 -->\n                    <div class=\"card flex-none w-80 bg-white shadow-lg snap-center\">\n                        <div class=\"relative h-56 overflow-hidden\">\n                            <div class=\"absolute inset-0 bg-gradient-to-r from-yellow-400 to-orange-500 flex items-center justify-center\">\n                                <i class=\"fas fa-lightbulb text-white text-5xl card-image\"></i>\n                            </div>\n                            <div class=\"absolute inset-0 card-overlay flex flex-col justify-end p-6 text-white\">\n                                <h3 class=\"font-bold text-xl\">İnovasyon</h3>\n                                <p class=\"text-sm text-gray-200 mt-1\">Yaratıcı çözümler</p>\n                            </div>\n                        </div>\n                        <div class=\"p-6\">\n                            <p class=\"text-gray-600 mb-4\">Sorunlara yenilikçi yaklaşımlar geliştirin ve rekabet avantajı sağlayın.</p>\n                            <button class=\"w-full bg-gradient-to-r from-yellow-400 to-orange-500 text-white px-4 py-2.5 rounded-lg hover:opacity-90 transition flex items-center justify-center\">\n                                <span>Keşfet</span>\n                                <i class=\"fas fa-arrow-right ml-2\"></i>\n                            </button>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Pagination Dots -->\n        <div class=\"flex justify-center mb-16 space-x-2\">\n            <button class=\"w-2.5 h-2.5 rounded-full bg-blue-500 focus:outline-none\"></button>\n            <button class=\"w-2.5 h-2.5 rounded-full bg-gray-300 focus:outline-none hover:bg-blue-300\"></button>\n            <button class=\"w-2.5 h-2.5 rounded-full bg-gray-300 focus:outline-none hover:bg-blue-300\"></button>\n            <button class=\"w-2.5 h-2.5 rounded-full bg-gray-300 focus:outline-none hover:bg-blue-300\"></button>\n        </div>\n\n        <!-- Features Section with Modern Design -->\n        <div class=\"relative\">\n            <div class=\"absolute inset-0 bg-gradient-to-r from-blue-50 to-indigo-50 transform -skew-y-3 z-0\"></div>\n            <div class=\"relative z-10 py-16\">\n                <div class=\"text-center mb-12\">\n                    <h2 class=\"text-3xl font-bold mb-4\">Özellikler</h2>\n                    <p class=\"text-gray-600 max-w-xl mx-auto\">Projelerinizi bir sonraki seviyeye taşıyacak modern ve işlevsel özellikler</p>\n                </div>\n                \n                <div class=\"grid grid-cols-1 md:grid-cols-3 gap-8 px-4\">\n                    <div class=\"feature-card bg-white p-6 shadow-md flex flex-col items-center text-center\">\n                        <div class=\"w-16 h-16 rounded-full bg-blue-100 flex items-center justify-center mb-4\">\n                            <i class=\"fas fa-bolt text-blue-500 text-2xl feature-icon\"></i>\n                        </div>\n                        <h3 class=\"font-semibold text-lg mb-2\">Hızlı Yükleme</h3>\n                        <p class=\"text-gray-600\">Optimize edilmiş kod yapısı sayesinde yüksek performans ve hızlı sayfa yükleme süreleri.</p>\n                    </div>\n                    \n                    <div class=\"feature-card bg-white p-6 shadow-md flex flex-col items-center text-center\">\n                        <div class=\"w-16 h-16 rounded-full bg-purple-100 flex items-center justify-center mb-4\">\n                            <i class=\"fas fa-mobile-alt text-purple-500 text-2xl feature-icon\"></i>\n                        </div>\n                        <h3 class=\"font-semibold text-lg mb-2\">Duyarlı Tasarım</h3>\n                        <p class=\"text-gray-600\">Tüm cihazlarda mükemmel görüntüleme için tamamen mobil uyumlu arayüz tasarımı.</p>\n                    </div>\n                    \n                    <div class=\"feature-card bg-white p-6 shadow-md flex flex-col items-center text-center\">\n                        <div class=\"w-16 h-16 rounded-full bg-pink-100 flex items-center justify-center mb-4\">\n                            <i class=\"fas fa-sliders-h text-pink-500 text-2xl feature-icon\"></i>\n                        </div>\n                        <h3 class=\"font-semibold text-lg mb-2\">Özelleştirilebilir</h3>\n                        <p class=\"text-gray-600\">Projenizin ihtiyaçlarına göre kolayca özelleştirilebilen modüler bileşenler.</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Call to Action -->\n        <div class=\"mt-20 text-center\">\n            <div class=\"blur-backdrop py-12 px-6 rounded-3xl max-w-2xl mx-auto\">\n                <h2 class=\"text-2xl font-bold mb-4\">Hemen Başlayın</h2>\n                <p class=\"text-gray-700 mb-8\">Projenizde bu modern ve şık tasarımları kullanmak için hemen bizimle iletişime geçin.</p>\n                <button class=\"bg-gradient-to-r from-blue-500 to-indigo-600 text-white px-8 py-3 rounded-lg hover:shadow-lg transition\">\n                    İletişime Geç\n                </button>\n            </div>\n        </div>\n\n        <!-- Footer -->\n        <footer class=\"mt-20 text-center text-gray-500 text-sm\">\n            <p>© 2025 Modern Galeri. Tüm hakları saklıdır.</p>\n        </footer>\n    </div>\n\n    <script>\n        // Slider functionality with improved smooth scrolling\n        const slider = document.getElementById('slider');\n        const prevBtn = document.getElementById('prev-btn');\n        const nextBtn = document.getElementById('next-btn');\n        const cardWidth = 320 + 24; // Card width + margin\n        \n        prevBtn.addEventListener('click', () => {\n            slider.scrollBy({ left: -cardWidth, behavior: 'smooth' });\n        });\n        \n        nextBtn.addEventListener('click', () => {\n            slider.scrollBy({ left: cardWidth, behavior: 'smooth' });\n        });\n\n        // Improved hover effect\n        const cards = document.querySelectorAll('.card');\n        cards.forEach(card => {\n            card.addEventListener('mouseenter', () => {\n                cards.forEach(c => {\n                    if (c !== card) {\n                        c.style.opacity = '0.7';\n                        c.style.transform = 'scale(0.98)';\n                    }\n                });\n            });\n            \n            card.addEventListener('mouseleave', () => {\n                cards.forEach(c => {\n                    c.style.opacity = '1';\n                    c.style.transform = '';\n                });\n            });\n        });\n\n        // Pagination dots functionality\n        const dots = document.querySelectorAll('.rounded-full');\n        dots.forEach((dot, index) => {\n            dot.addEventListener('click', () => {\n                // Reset all dots\n                dots.forEach(d => {\n                    d.classList.remove('bg-blue-500');\n                    d.classList.add('bg-gray-300');\n                });\n                \n                // Activate current dot\n                dot.classList.remove('bg-gray-300');\n                dot.classList.add('bg-blue-500');\n                \n                // Scroll to position\n                slider.scrollTo({\n                    left: index * cardWidth,\n                    behavior: 'smooth'\n                });\n            });\n        });\n    </script>\n</body>\n</html>"
  }
}
