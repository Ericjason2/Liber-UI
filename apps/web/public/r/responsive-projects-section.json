      "content": "/**\n * Component: Responsive Projects Section\n * Author: @ariaw (https://tailwindflex.com/@ariaw)\n * Source: https://tailwindflex.com/@ariaw/responsive-projects-section\n * Attribution: Créé par @ariaw sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function ResponsiveProjectsSection() {\n  return (\n    <div>\n    <section className=\"px-4 py-12 sm6 lg8\">\r\n        <div className=\"mx-auto max-w-7xl\">\r\n          \r\n          <div className=\"mb-12 text-center\">\r\n            <h2 className=\"text-3xl font-extrabold text-gray-900 sm4xl\">Our Projects</h2>\r\n            <p className=\"mx-auto mt-3 max-w-2xl text-xl text-gray-500 sm4\">Check out some of our recent work and case studies.</p>\r\n          </div>\r\n    \r\n          \r\n          <div className=\"grid grid-cols-1 gap-8 sm2 lg3\">\r\n            \r\n            <div className=\"overflow-hidden rounded-lg bg-white shadow-md transition-transform duration-300 hover105\">\r\n              <div className=\"h-48 overflow-hidden bg-blue-500\">\r\n                <img src=\"https://placehold.co/600x400/transparent/FFF\" alt=\"Project 1\" className=\"h-full w-full object-cover\" />\r\n              </div>\r\n              <div className=\"p-6\">\r\n                <h3 className=\"text-xl font-semibold text-gray-900\">Website Redesign</h3>\r\n                <p className=\"mt-2 text-gray-600\">Complete redesign of corporate website with improved UX and modern aesthetics.</p>\r\n                <div className=\"mt-4 flex flex-wrap gap-2\">\r\n                  <span className=\"rounded-full bg-blue-100 px-3 py-1 text-xs font-medium text-blue-800\">Web Design</span>\r\n                  <span className=\"rounded-full bg-green-100 px-3 py-1 text-xs font-medium text-green-800\">UX</span>\r\n                </div>\r\n                <a href=\"#\" className=\"mt-4 inline-flex items-center text-blue-600 hover800\">\r\n                  View case study\r\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"ml-1 h-5 w-5\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\r\n                    <path fillRule=\"evenodd\" d=\"M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z\" clipRule=\"evenodd\" />\r\n                  </svg>\r\n                </a>\r\n              </div>\r\n            </div>\r\n    \r\n            \r\n            <div className=\"overflow-hidden rounded-lg bg-white shadow-md transition-transform duration-300 hover105\">\r\n              <div className=\"h-48 overflow-hidden bg-green-500\">\r\n                <img src=\"https://placehold.co/600x400/transparent/FFF\" alt=\"Project 2\" className=\"h-full w-full object-cover\" />\r\n              </div>\r\n              <div className=\"p-6\">\r\n                <h3 className=\"text-xl font-semibold text-gray-900\">Mobile Application</h3>\r\n                <p className=\"mt-2 text-gray-600\">Cross-platform mobile app for health tracking with real-time analytics.</p>\r\n                <div className=\"mt-4 flex flex-wrap gap-2\">\r\n                  <span className=\"rounded-full bg-purple-100 px-3 py-1 text-xs font-medium text-purple-800\">React Native</span>\r\n                  <span className=\"rounded-full bg-yellow-100 px-3 py-1 text-xs font-medium text-yellow-800\">Health Tech</span>\r\n                </div>\r\n                <a href=\"#\" className=\"mt-4 inline-flex items-center text-blue-600 hover800\">\r\n                  View case study\r\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"ml-1 h-5 w-5\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\r\n                    <path fillRule=\"evenodd\" d=\"M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z\" clipRule=\"evenodd\" />\r\n                  </svg>\r\n                </a>\r\n              </div>\r\n            </div>\r\n    \r\n            \r\n            <div className=\"overflow-hidden rounded-lg bg-white shadow-md transition-transform duration-300 hover105\">\r\n              <div className=\"h-48 overflow-hidden bg-purple-500\">\r\n                <img src=\"https://placehold.co/600x400/transparent/FFF\" alt=\"Project 3\" className=\"h-full w-full object-cover\" />\r\n              </div>\r\n              <div className=\"p-6\">\r\n                <h3 className=\"text-xl font-semibold text-gray-900\">E-commerce Platform</h3>\r\n                <p className=\"mt-2 text-gray-600\">Custom e-commerce solution with integrated payment processing and inventory management.</p>\r\n                <div className=\"mt-4 flex flex-wrap gap-2\">\r\n                  <span className=\"rounded-full bg-red-100 px-3 py-1 text-xs font-medium text-red-800\">E-commerce</span>\r\n                  <span className=\"rounded-full bg-indigo-100 px-3 py-1 text-xs font-medium text-indigo-800\">Payment Gateway</span>\r\n                </div>\r\n                <a href=\"#\" className=\"mt-4 inline-flex items-center text-blue-600 hover800\">\r\n                  View case study\r\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"ml-1 h-5 w-5\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\r\n                    <path fillRule=\"evenodd\" d=\"M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z\" clipRule=\"evenodd\" />\r\n                  </svg>\r\n                </a>\r\n              </div>\r\n            </div>\r\n          </div>\r\n    \r\n          \r\n          <div className=\"mt-12 text-center\">\r\n            <a href=\"#\" className=\"inline-flex items-center rounded-md border border-transparent bg-blue-600 px-6 py-3 text-base font-medium text-white shadow-sm hover700\"> View all projects </a>\r\n          </div>\r\n        </div>\r\n      </section>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
