      "content": "/**\n * Component: Feedback Form\n * Author: @andreas-wagner (https://tailwindflex.com/@andreas-wagner)\n * Source: https://tailwindflex.com/@andreas-wagner/feedback-form-3\n * Attribution: Créé par @andreas-wagner sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function FeedbackForm3() {\n  return (\n    <div>\n    <section className=\"text-gray-700 body-font relative\">\n      <div className=\"absolute inset-0 bg-gray-300\">\n        \n      </div>\n      <div className=\"container px-5 py-24 mx-auto flex\">\n        <div className=\"lg1/3 md1/2 bg-white rounded-lg p-8 flex flex-col md w-full mt-10 md0 relative z-10\">\n          <h2 className=\"text-gray-900 text-lg mb-1 font-medium title-font\">Feedback</h2>\n          <p className=\"leading-relaxed mb-5 text-gray-600\">Post-ironic portland shabby chic echo park, banjo fashion axe</p>\n          <input className=\"bg-white rounded border border-gray-400 focus focus500 text-base px-4 py-2 mb-4\" placeholder=\"Email\" type=\"email\" />\n          <textarea className=\"bg-white rounded border border-gray-400 focus h-32 focus500 text-base px-4 py-2 mb-4 resize-none\" placeholder=\"Message\"></textarea>\n          <button className=\"text-white bg-indigo-500 border-0 py-2 px-6 focus hover600 rounded text-lg\">Button</button>\n          <p className=\"text-xs text-gray-500 mt-3\">Chicharrones blog helvetica normcore iceland tousled brook viral artisan.</p>\n        </div>\n      </div>\n    </section>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
