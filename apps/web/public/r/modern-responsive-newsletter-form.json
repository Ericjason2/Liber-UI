      "content": "/**\n * Component: Modern responsive Newsletter form\n * Author: @mdadul (https://tailwindflex.com/@mdadul)\n * Source: https://tailwindflex.com/@mdadul/modern-responsive-newsletter-form\n * Attribution: Créé par @mdadul sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function ModernResponsiveNewsletterForm() {\n  return (\n    <div>\n    <section>\n      \n      <div className=\"mx-auto w-full max-w-7xl px-5 py-16 md10 md24 lg32\">\n        \n        <div className=\"bg-blue-50 p-8 text-center sm10 md16\">\n          \n          <h2 className=\"mb-4 text-3xl font-bold md5xl\">Join the TailwindFlex Community</h2>\n          <p className=\"mx-auto mb-6 max-w-2xl text-[#647084] md10\">Lorem ipsum dolor sit amet, consectetur adipiscing elit ut aliquam, purus sit amet luctus venenatis, lectus magna fringilla urna</p>\n          \n          <form name=\"email-form\" method=\"get\" className=\"relative mx-auto mb-4 flex w-full max-w-2xl flex-col items-start justify-center sm\">\n            <input type=\"email\" className=\"mb-3 mr-6 block h-9 w-full bg-white px-6 py-7 text-sm text-[#333333] focus[#3898ec]\" placeholder=\"Enter your email\" required=\"\" />\n            <input type=\"submit\" value=\"Subscribe\" className=\"inline-block w-full cursor-pointer bg-[#276ef1] px-6 py-3 text-center font-semibold text-white transition [box-shadow(171,_196,_245)_-8px_8px] hover:[box-shadow(171,_196,_245)_0px_0px] sm28\" />\n          </form>\n        </div>\n      </div>\n    </section>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
  ],
