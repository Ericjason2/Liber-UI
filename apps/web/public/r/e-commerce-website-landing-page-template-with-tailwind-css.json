      "content": "/**\n * Component: e-commerce website landing page template with Tailwind CSS.\n * Author: @homayunmmdy (https://tailwindflex.com/@homayunmmdy)\n * Source: https://tailwindflex.com/@homayunmmdy/e-commerce-website-landing-page-template-with-tailwind-css\n * Attribution: Créé par @homayunmmdy sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function ECommerceWebsiteLandingPageTemplateWithTailwindCss() {\n  return (\n    <div dangerouslySetInnerHTML={{ __html: \"<!DOCTYPE html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"UTF-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\" />\\n  <title>Minimal E-Commerce Landing Page Template with Tailwind CSS</title>\\n  <meta name=\\\"description\\\" content=\\\"A clean, responsive e-commerce & blog landing page template built with Tailwind CSS. Features light/dark mode, dynamic featured posts, hero, CTA, and modular sections.\\\">\\n  \\n  \\n  <style>html { scroll-behavior: smooth; }</style>\\n</head>\\n<body class=\\\"font-sans antialiased bg-white dark:bg-gray-900 text-black dark:text-white\\\">\\n\\n<!-- =========== HEADER =========== -->\\n<header class=\\\"sticky top-0 z-50 bg-white/90 dark:bg-gray-900/90 backdrop-blur-[2px] border-b border-gray-200 dark:border-gray-800\\\">\\n  <div class=\\\"max-w-7xl mx-auto px-4 sm:px-6\\\">\\n    <div class=\\\"flex items-center justify-between h-16\\\">\\n      <!-- Logo -->\\n      <div class=\\\"text-xl font-light tracking-wide text-black dark:text-white\\\">\\n        Mindful Living\\n      </div>\\n\\n      <!-- Desktop Navigation (static) -->\\n      <nav class=\\\"hidden md:flex items-center space-x-8\\\">\\n        <div class=\\\"text-sm font-medium text-gray-600 dark:text-gray-400\\\">Blog</div>\\n        <div class=\\\"text-sm font-medium text-gray-600 dark:text-gray-400\\\">Shop</div>\\n        <div class=\\\"text-sm font-medium text-gray-600 dark:text-gray-400\\\">About</div>\\n        <div class=\\\"text-sm font-medium text-gray-600 dark:text-gray-400\\\">Contact</div>\\n      </nav>\\n\\n      <!-- Mobile Menu Button (still functional) -->\\n      <button id=\\\"menu-toggle\\\" class=\\\"md:hidden text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white\\\">\\n        <svg xmlns=\\\"http://www.w3.org/2000/svg\\\" class=\\\"h-6 w-6\\\" fill=\\\"none\\\" viewBox=\\\"0 0 24 24\\\" stroke=\\\"currentColor\\\">\\n          <path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" stroke-width=\\\"2\\\" d=\\\"M4 6h16M4 12h16m-7 6h7\\\" />\\n        </svg>\\n      </button>\\n    </div>\\n  </div>\\n\\n  <!-- Mobile Menu (static items) -->\\n  <div id=\\\"mobile-menu\\\" class=\\\"hidden md:hidden px-4 pb-4 space-y-3 border-t border-gray-200 dark:border-gray-800\\\">\\n    <div class=\\\"block py-2 text-sm text-gray-600 dark:text-gray-400\\\">Blog</div>\\n    <div class=\\\"block py-2 text-sm text-gray-600 dark:text-gray-400\\\">Shop</div>\\n    <div class=\\\"block py-2 text-sm text-gray-600 dark:text-gray-400\\\">About</div>\\n    <div class=\\\"block py-2 text-sm text-gray-600 dark:text-gray-400\\\">Contact</div>\\n    <div class=\\\"block py-2 text-sm font-medium text-black dark:text-white\\\">Subscribe</div>\\n  </div>\\n</header>\\n\\n<!-- =========== HERO =========== -->\\n<section id=\\\"hero\\\" class=\\\"relative min-h-[520px] bg-gray-50 dark:bg-gray-900\\\">\\n  <div class=\\\"absolute inset-0 bg-[url('https://picsum.photos/1200/600?blur=2')] bg-cover bg-center\\\"></div>\\n  <div class=\\\"relative max-w-4xl mx-auto px-4 sm:px-6 py-32 flex flex-col items-center text-center\\\">\\n    <h1 class=\\\"text-3xl sm:text-4xl md:text-5xl font-light tracking-tight text-black dark:text-white drop-shadow-sm dark:drop-shadow-md\\\">\\n      Self Love & Relationships\\n    </h1>\\n    <p class=\\\"mt-4 text-base sm:text-lg md:text-xl text-gray-700 dark:text-gray-300 max-w-2xl\\\">\\n      Fitness enthusiast sharing 5 years of transformation insights\\n    </p>\\n  </div>\\n</section>\\n\\n<!-- =========== BLOG CARDS =========== -->\\n<section id=\\\"blog\\\" class=\\\"py-16 bg-white dark:bg-gray-900\\\">\\n  <div class=\\\"max-w-7xl mx-auto px-4 sm:px-6\\\">\\n    <div class=\\\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8\\\">\\n      <!-- Card 1 -->\\n      <div class=\\\"group\\\">\\n        <div class=\\\"overflow-hidden rounded-lg mb-4\\\">\\n          <img src=\\\"https://picsum.photos/600/400?random=1\\\" alt=\\\"Blog post\\\" class=\\\"w-full h-auto transition-transform duration-500 group-hover:scale-105\\\" loading=\\\"lazy\\\" />\\n        </div>\\n        <p class=\\\"text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide\\\">in <span class=\\\"font-medium text-black dark:text-white\\\">Wellness</span> on 12 Jan 2025</p>\\n        <h3 class=\\\"mt-2 text-xl font-light text-black dark:text-white\\\">\\n          The Art of Mindful Breathing\\n        </h3>\\n        <p class=\\\"mt-2 text-gray-600 dark:text-gray-400 text-sm\\\">Discover how conscious breathing can transform your daily stress into calm presence.</p>\\n        <div class=\\\"mt-3 inline-block text-sm font-medium text-black dark:text-white border-b border-black dark:border-white\\\">\\n          Read More\\n        </div>\\n      </div>\\n      <!-- Card 2 -->\\n      <div class=\\\"group\\\">\\n        <div class=\\\"overflow-hidden rounded-lg mb-4\\\">\\n          <img src=\\\"https://picsum.photos/600/400?random=2\\\" alt=\\\"Blog post\\\" class=\\\"w-full h-auto transition-transform duration-500 group-hover:scale-105\\\" loading=\\\"lazy\\\" />\\n        </div>\\n        <p class=\\\"text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide\\\">in <span class=\\\"font-medium text-black dark:text-white\\\">Relationships</span> on 10 Jan 2025</p>\\n        <h3 class=\\\"mt-2 text-xl font-light text-black dark:text-white\\\">\\n          Boundaries as an Act of Love\\n        </h3>\\n        <p class=\\\"mt-2 text-gray-600 dark:text-gray-400 text-sm\\\">How saying \\\"no\\\" can deepen your connections and honor your energy.</p>\\n        <div class=\\\"mt-3 inline-block text-sm font-medium text-black dark:text-white border-b border-black dark:border-white\\\">\\n          Read More\\n        </div>\\n      </div>\\n      <!-- Card 3 -->\\n      <div class=\\\"group\\\">\\n        <div class=\\\"overflow-hidden rounded-lg mb-4\\\">\\n          <img src=\\\"https://picsum.photos/600/400?random=3\\\" alt=\\\"Blog post\\\" class=\\\"w-full h-auto transition-transform duration-500 group-hover:scale-105\\\" loading=\\\"lazy\\\" />\\n        </div>\\n        <p class=\\\"text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wide\\\">in <span class=\\\"font-medium text-black dark:text-white\\\">Nutrition</span> on 8 Jan 2025</p>\\n        <h3 class=\\\"mt-2 text-xl font-light text-black dark:text-white\\\">\\n          Eating with Intention\\n        </h3>\\n        <p class=\\\"mt-2 text-gray-600 dark:text-gray-400 text-sm\\\">Move beyond diets—cultivate a joyful, intuitive relationship with food.</p>\\n        <div class=\\\"mt-3 inline-block text-sm font-medium text-black dark:text-white border-b border-black dark:border-white\\\">\\n          Read More\\n        </div>\\n      </div>\\n    </div>\\n  </div>\\n</section>\\n\\n<!-- =========== FEATURED POSTS (WITH DYNAMIC IMAGE) =========== -->\\n<section id=\\\"featured\\\" class=\\\"py-16 bg-white dark:bg-gray-900\\\">\\n  <div class=\\\"max-w-7xl mx-auto px-4 sm:px-6\\\">\\n    <h2 class=\\\"text-3xl font-light text-black dark:text-white mb-10\\\">Featured Posts</h2>\\n\\n    <div class=\\\"grid grid-cols-1 lg:grid-cols-2 gap-10 items-start\\\">\\n      <!-- Post List (clickable for image change) -->\\n      <div class=\\\"space-y-6\\\">\\n        <div class=\\\"post-item cursor-pointer\\\" data-image=\\\"https://picsum.photos/600/500?random=1\\\">\\n          <span class=\\\"text-xs uppercase text-gray-500 dark:text-gray-400\\\">Dating & Relationships</span>\\n          <h3 class=\\\"mt-1 text-xl font-light text-black dark:text-white\\\">\\n            How Weak Ties Strengthen Our Relationships\\n          </h3>\\n          <hr class=\\\"my-4 border-gray-200 dark:border-gray-800\\\" />\\n        </div>\\n        <div class=\\\"post-item cursor-pointer\\\" data-image=\\\"https://picsum.photos/600/500?random=2\\\">\\n          <span class=\\\"text-xs uppercase text-gray-500 dark:text-gray-400\\\">Mind & Body</span>\\n          <h3 class=\\\"mt-1 text-xl font-light text-black dark:text-white\\\">\\n            What It’s Like to Date While Anxious\\n          </h3>\\n          <hr class=\\\"my-4 border-gray-200 dark:border-gray-800\\\" />\\n        </div>\\n        <div class=\\\"post-item cursor-pointer\\\" data-image=\\\"https://picsum.photos/600/500?random=3\\\">\\n          <span class=\\\"text-xs uppercase text-gray-500 dark:text-gray-400\\\">Wellness Kitchen</span>\\n          <h3 class=\\\"mt-1 text-xl font-light text-black dark:text-white\\\">\\n            Golden Milk for Better Sleep\\n          </h3>\\n          <hr class=\\\"my-4 border-gray-200 dark:border-gray-800\\\" />\\n        </div>\\n        <div class=\\\"post-item cursor-pointer\\\" data-image=\\\"https://picsum.photos/600/500?random=4\\\">\\n          <span class=\\\"text-xs uppercase text-gray-500 dark:text-gray-400\\\">Natural Living</span>\\n          <h3 class=\\\"mt-1 text-xl font-light text-black dark:text-white\\\">\\n            Herbal Remedies for Seasonal Fatigue\\n          </h3>\\n          <hr class=\\\"my-4 border-gray-200 dark:border-gray-800\\\" />\\n        </div>\\n      </div>\\n\\n      <!-- Dynamic Image -->\\n      <div class=\\\"hidden lg:block flex-shrink-0\\\">\\n        <img \\n          id=\\\"featured-image\\\" \\n          src=\\\"https://picsum.photos/600/500?random=1\\\" \\n          alt=\\\"Featured post visual\\\"\\n          class=\\\"rounded-lg w-full h-auto object-cover shadow-lg\\\"\\n        />\\n      </div>\\n    </div>\\n  </div>\\n</section>\\n\\n<!-- =========== CATEGORIES =========== -->\\n<section class=\\\"py-16 bg-white dark:bg-gray-900\\\">\\n  <div class=\\\"max-w-7xl mx-auto px-4 sm:px-6\\\">\\n    <div class=\\\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4\\\">\\n      <div class=\\\"group block relative overflow-hidden rounded-lg shadow-sm\\\">\\n        <img src=\\\"https://picsum.photos/400/400?random=4\\\" alt=\\\"Wellness Tips\\\" class=\\\"w-full h-auto aspect-square object-cover\\\" loading=\\\"lazy\\\" />\\n        <div class=\\\"absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent p-4 pt-12 text-center\\\">\\n          <h3 class=\\\"text-white text-sm font-medium\\\">Wellness Tips</h3>\\n        </div>\\n      </div>\\n      <div class=\\\"group block relative overflow-hidden rounded-lg shadow-sm\\\">\\n        <img src=\\\"https://picsum.photos/400/400?random=5\\\" alt=\\\"Mindful Eating\\\" class=\\\"w-full h-auto aspect-square object-cover\\\" loading=\\\"lazy\\\" />\\n        <div class=\\\"absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent p-4 pt-12 text-center\\\">\\n          <h3 class=\\\"text-white text-sm font-medium\\\">Mindful Eating</h3>\\n        </div>\\n      </div>\\n      <div class=\\\"group block relative overflow-hidden rounded-lg shadow-sm\\\">\\n        <img src=\\\"https://picsum.photos/400/400?random=6\\\" alt=\\\"Yoga Flow\\\" class=\\\"w-full h-auto aspect-square object-cover\\\" loading=\\\"lazy\\\" />\\n        <div class=\\\"absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent p-4 pt-12 text-center\\\">\\n          <h3 class=\\\"text-white text-sm font-medium\\\">Yoga Flow</h3>\\n        </div>\\n      </div>\\n      <div class=\\\"group block relative overflow-hidden rounded-lg shadow-sm\\\">\\n        <img src=\\\"https://picsum.photos/400/400?random=7\\\" alt=\\\"Herbal Care\\\" class=\\\"w-full h-auto aspect-square object-cover\\\" loading=\\\"lazy\\\" />\\n        <div class=\\\"absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent p-4 pt-12 text-center\\\">\\n          <h3 class=\\\"text-white text-sm font-medium\\\">Herbal Care</h3>\\n        </div>\\n      </div>\\n      <div class=\\\"group block relative overflow-hidden rounded-lg shadow-sm\\\">\\n        <img src=\\\"https://picsum.photos/400/400?random=8\\\" alt=\\\"Self Love\\\" class=\\\"w-full h-auto aspect-square object-cover\\\" loading=\\\"lazy\\\" />\\n        <div class=\\\"absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent p-4 pt-12 text-center\\\">\\n          <h3 class=\\\"text-white text-sm font-medium\\\">Self Love</h3>\\n        </div>\\n      </div>\\n    </div>\\n  </div>\\n</section>\\n\\n<!-- =========== SUBSCRIBE CTA =========== -->\\n<section id=\\\"cta\\\" class=\\\"py-24 bg-gray-50 dark:bg-gray-900\\\">\\n  <div class=\\\"max-w-6xl mx-auto px-4 sm:px-6\\\">\\n    <div class=\\\"grid grid-cols-1 lg:grid-cols-2 gap-12 items-center\\\">\\n      <div>\\n        <h2 class=\\\"text-4xl md:text-5xl font-light text-black dark:text-white leading-tight\\\">\\n          Never miss a post.<br class=\\\"hidden md:block\\\" /> Subscribe now.\\n        </h2>\\n        <p class=\\\"mt-4 text-gray-700 dark:text-gray-300 max-w-lg\\\">\\n          Join thousands of mindful readers. Get weekly insights on wellness, relationships, and intentional living.\\n        </p>\\n      </div>\\n      <div class=\\\"space-y-4\\\">\\n        <div class=\\\"space-y-3\\\">\\n          <div class=\\\"w-full px-4 py-3 border border-gray-300 dark:border-gray-700 rounded-md text-black dark:text-white bg-white dark:bg-gray-800\\\">\\n            Your name\\n          </div>\\n          <div class=\\\"w-full px-4 py-3 border border-gray-300 dark:border-gray-700 rounded-md text-black dark:text-white bg-white dark:bg-gray-800\\\">\\n            Email address\\n          </div>\\n          <div class=\\\"w-full py-3 px-6 bg-black dark:bg-white text-white dark:text-black font-medium uppercase tracking-wider rounded-md text-center\\\">\\n            Subscribe\\n          </div>\\n        </div>\\n      </div>\\n    </div>\\n  </div>\\n</section>\\n\\n<!-- =========== FOOTER =========== -->\\n<footer class=\\\"bg-gray-50 dark:bg-gray-900 text-black dark:text-white border-t border-gray-200 dark:border-gray-800\\\">\\n  <div class=\\\"max-w-7xl mx-auto px-4 py-12\\\">\\n    <div class=\\\"grid grid-cols-1 md:grid-cols-3 gap-8\\\">\\n      <div>\\n        <h3 class=\\\"text-sm font-semibold uppercase tracking-wider text-black dark:text-white mb-4\\\">Services</h3>\\n        <div class=\\\"space-y-2\\\">\\n          <div class=\\\"text-gray-600 dark:text-gray-400\\\">Branding</div>\\n          <div class=\\\"text-gray-600 dark:text-gray-400\\\">Design</div>\\n          <div class=\\\"text-gray-600 dark:text-gray-400\\\">Marketing</div>\\n          <div class=\\\"text-gray-600 dark:text-gray-400\\\">Advertisement</div>\\n        </div>\\n      </div>\\n      <div>\\n        <h3 class=\\\"text-sm font-semibold uppercase tracking-wider text-black dark:text-white mb-4\\\">Company</h3>\\n        <div class=\\\"space-y-2\\\">\\n          <div class=\\\"text-gray-600 dark:text-gray-400\\\">About us</div>\\n          <div class=\\\"text-gray-600 dark:text-gray-400\\\">Contact</div>\\n          <div class=\\\"text-gray-600 dark:text-gray-400\\\">Jobs</div>\\n          <div class=\\\"text-gray-600 dark:text-gray-400\\\">Press kit</div>\\n        </div>\\n      </div>\\n      <div>\\n        <h3 class=\\\"text-sm font-semibold uppercase tracking-wider text-black dark:text-white mb-4\\\">Legal</h3>\\n        <div class=\\\"space-y-2\\\">\\n          <div class=\\\"text-gray-600 dark:text-gray-400\\\">Terms of use</div>\\n          <div class=\\\"text-gray-600 dark:text-gray-400\\\">Privacy policy</div>\\n          <div class=\\\"text-gray-600 dark:text-gray-400\\\">Cookie policy</div>\\n        </div>\\n      </div>\\n    </div>\\n  </div>\\n  <div class=\\\"border-t border-gray-200 dark:border-gray-800 py-6 px-4\\\">\\n    <div class=\\\"max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-4\\\">\\n      <div class=\\\"text-sm text-gray-600 dark:text-gray-400\\\">\\n        Copyright © 2025 Mindful Living. All rights reserved.\\n      </div>\\n      <div class=\\\"flex gap-4\\\">\\n        <div class=\\\"text-gray-500 dark:text-gray-400\\\">\\n          <svg class=\\\"w-5 h-5\\\" fill=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\"><path d=\\\"M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z\\\"/></svg>\\n        </div>\\n        <div class=\\\"text-gray-500 dark:text-gray-400\\\">\\n          <svg class=\\\"w-5 h-5\\\" fill=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\"><path d=\\\"M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.28-.073 1.688-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.28.058 1.689.072 4.949.072 3.259 0 3.668-.014 4.948-.072 4.354-.