      "content": "/**\n * Component: Navbar Section\n * Author: @noob_dev (https://tailwindflex.com/@noob_dev)\n * Source: https://tailwindflex.com/@noob_dev/navbar-section\n * Attribution: Créé par @noob_dev sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function NavbarSection() {\n  return (\n    <div>\n    <header className=\"lg16 px-4 bg-white flex flex-wrap items-center py-4 shadow-md\">\n        <div className=\"flex-1 flex justify-between items-center\">\n            <a href=\"#\" className=\"text-xl\">Company</a>\n        </div>\n    \n        <label htmlFor=\"menu-toggle\" className=\"pointer-cursor md block\">\n          <svg className=\"fill-current text-gray-900\"\n            xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 20 20\">\n            <title>menu</title>\n            <path d=\"M0 3h20v2H0V3zm0 6h20v2H0V9zm0 6h20v2H0v-2z\"></path>\n          </svg>\n        </label>\n        <input className=\"hidden\" type=\"checkbox\" id=\"menu-toggle\" />\n    \n        <div className=\"hidden md md md w-full\" id=\"menu\">\n            <nav>\n                <ul className=\"md items-center justify-between text-base text-gray-700 pt-4 md0\">\n                    <li><a className=\"md4 py-3 px-0 block\" href=\"#\">AboutUs</a></li>\n                    <li><a className=\"md4 py-3 px-0 block\" href=\"#\">Treatments</a></li>\n                    <li><a className=\"md4 py-3 px-0 block\" href=\"#\">Blog</a></li>\n                    <li><a className=\"md4 py-3 px-0 block md0 mb-2\" href=\"#\">Contact Us</a></li>\n                </ul>\n            </nav>\n        </div>\n    </header>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
