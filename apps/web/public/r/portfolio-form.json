      "content": "/**\n * Component: Portfolio form\n * Author: @joseph-melvin-kanu (https://tailwindflex.com/@joseph-melvin-kanu)\n * Source: https://tailwindflex.com/@joseph-melvin-kanu/portfolio-form\n * Attribution: Créé par @joseph-melvin-kanu sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function PortfolioForm() {\n  return (\n    <div>\n    \n    <div className=\"max-w-screen-xl mx-auto my-7 lg20\" id=\"contact\">\n      <form action=\"\" method=\"post\">\n        <div className=\"w-full p-8 my-4 mr-auto shadow-2xl md12 lg9/12 lg20 lg40 rounded-2xl\">\n          <div className=\"flex\">\n            <h1 className=\"text-5xl text-[#A85168] font-bold \">Hire Me</h1>\n          </div>\n          <div className=\"grid grid-cols-1 gap-5 mt-5 md2\">\n            <input className=\"w-full p-3 mt-2 text-gray-900 bg-gray-100 rounded-lg focus focus\" type=\"text\" placeholder=\"First Name\" name=\"firstName\" autoComplete=\"name\" />\n            <input className=\"w-full p-3 mt-2 text-gray-900 bg-gray-100 rounded-lg focus focus\" type=\"text\" placeholder=\"Last Name\" name=\"lastName\" autoComplete=\"family-name\" />\n            <input className=\"w-full p-3 mt-2 text-gray-900 bg-gray-100 rounded-lg focus focus\" type=\"email\" placeholder=\"Email\" name=\"email\" autoComplete=\"email\" />\n            <input className=\"w-full p-3 mt-2 text-gray-900 bg-gray-100 rounded-lg focus focus\" type=\"tel\" placeholder=\"Phone\" name=\"phone\" autoComplete=\"tel\" />\n          </div>\n          <div className=\"my-4\">\n            <textarea placeholder=\"Message\" className=\"w-full h-32 p-3 mt-2 text-gray-900 bg-gray-100 rounded-lg focus focus\" name=\"message\" autoComplete=\"message\"></textarea>\n          </div>\n          <div className=\"w-1/2 my-2 lg1/4\">\n            <button type=\"submit\" className=\"w-full p-3 text-sm font-bold tracking-wide text-gray-100 uppercase bg-[#A12347] rounded rounded-xl hover700-lg focus focus\">\n                            Send Message\n                        </button>\n          </div>\n        </div>\n      </form>\n      <div className=\"w-full px-8 py-12 ml-auto bg-[#1B6485] lg96 lg2/6 rounded-2xl\">\n        <div className=\"flex flex-col text-white\">\n          <div className=\"flex w-2/3 my-4 lg1/2\">\n            <img className=\"pt-2 pr-2 h-7 w-7\" src=\"https://icons8.com/icon/OBmVbH2qOGwK/location\" alt=\"location\" />\n            <div>\n              <h2 className=\"text-2xl\">Office</h2>\n              <p className=\"text-gray-200\" style=\"white-space: nowrap;\">27B Grassfield, Lumely</p>\n            </div>\n          </div>\n          <div className=\"flex w-2/3 my-4 lg1/2\">\n            <img className=\"pt-2 pr-2 h-7 w-7 \" src=\"https://icons8.com/icon/letUS1DJO1ou/call\" alt=\"call us\" />\n            <div>\n              <h2 className=\"text-2xl\">Call</h2>\n              <p className=\"text-gray-200\" style=\"white-space: nowrap;\">Tel:+232-79-15-39-15</p>\n            </div>\n          </div>\n          <div className=\"flex w-2/3 my-4 lg1/2\">\n            <img className=\"pt-2 pr-2 h-7 w-7\" src=\"https://icons8.com/icon/LPcVDft9Isqt/email\" alt=\"Email us\" />\n            <div>\n              <h2 className=\"text-2xl\">Email</h2>\n              <p className=\"text-gray-200\" style=\"white-space: nowrap;\">Email.com</p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n    \n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
