      "content": "/**\n * Component: Blog Post Showcase\n * Author: @henrik (https://tailwindflex.com/@henrik)\n * Source: https://tailwindflex.com/@henrik/blog-post-showcase\n * Attribution: Créé par @henrik sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function BlogPostShowcase() {\n  return (\n    <div>\n    <div className=\"w-full dark800\">\n    \n        <div className=\"mx-auto max-w-7xl px-6 lg8 pt-8\">\n            <div className=\"mx-auto max-w-2xl text-center\">\n                <h2 className=\"text-3xl font-bold tracking-tight text-gray-900 dark sm4xl\">From The Blog</h2>\n                <p className=\"mt-2 text-lg leading-8 text-gray-600 dark300\">\n                    Dive into the latest in technology with our insightful blog posts.\n                </p>\n            </div>\n            <div\n                className=\"mx-auto mt-8 grid max-w-2xl auto-rows-fr grid-cols-1 gap-8 sm12 lg0 lg lg3 \">\n                \n                <article\n                    className=\"relative isolate flex flex-col justify-end overflow-hidden rounded-2xl bg-gray-900 dark700 px-8 py-8 pb-8 pt-80 sm48 lg80\">\n                    <img src=\"https://images.unsplash.com/photo-1677442135703-1787eea5ce01?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w0NzEyNjZ8MHwxfHNlYXJjaHw1fHxhaXxlbnwwfDB8fHwxNzEyNzUzMTQ4fDA&ixlib=rb-4.0.3&q=80&w=1080\" alt=\"\" className=\"absolute inset-0 -z-10 h-full w-full object-cover\" />\n                    <div className=\"absolute inset-0 -z-10 bg-gradient-to-t from-gray-900 via-gray-900/40\"></div>\n                    <div className=\"absolute inset-0 -z-10 rounded-2xl ring-1 ring-inset ring-gray-900/10\"></div>\n                    <div className=\"flex flex-wrap items-center gap-y-1 overflow-hidden text-sm leading-6 text-gray-300\"><time\n                            datetime=\"2023-10-11\" className=\"mr-8\">Oct 11, 2023</time>\n                        <div className=\"-ml-4 flex items-center gap-x-4\"><svg viewBox=\"0 0 2 2\"\n                                className=\"-ml-0.5 h-0.5 w-0.5 flex-none fill-white/50\">\n                                <circle cx=\"1\" cy=\"1\" r=\"1\"></circle>\n                            </svg>\n                            <div className=\"flex gap-x-2.5\">\n                                <img src=\"https://randomuser.me/api/portraits/men/2.jpg\" alt=\"\" className=\"h-6 w-6 flex-none rounded-full bg-white/10\" />John\n                            </div>\n                        </div>\n                    </div>\n                    <h3 className=\"mt-3 text-lg font-semibold leading-6 text-white\">\n                        <a href=\"/tech-blog/post1\"><span className=\"absolute inset-0\"></span>The Future of Artificial\n                            Intelligence: Trends and Challenges</a>\n                    </h3>\n                </article>\n                \n                <article\n                    className=\"relative isolate flex flex-col justify-end overflow-hidden rounded-2xl bg-gray-900 dark700 px-8 py-8 pb-8 pt-80 sm48 lg80\">\n                    <img src=\"https://images.unsplash.com/photo-1639322537228-f710d846310a?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w0NzEyNjZ8MHwxfHNlYXJjaHw1fHxibG9jayUyMGNoYWlufGVufDB8MHx8fDE3MTI3NTMxNjd8MA&ixlib=rb-4.0.3&q=80&w=1080\" alt=\"\" className=\"absolute inset-0 -z-10 h-full w-full object-cover\" />\n                    <div className=\"absolute inset-0 -z-10 bg-gradient-to-t from-gray-900 via-gray-900/40\"></div>\n                    <div className=\"absolute inset-0 -z-10 rounded-2xl ring-1 ring-inset ring-gray-900/10\"></div>\n                    <div className=\"flex flex-wrap items-center gap-y-1 overflow-hidden text-sm leading-6 text-gray-300\"><time\n                            datetime=\"2023-09-25\" className=\"mr-8\">Sept 25, 2023</time>\n                        <div className=\"-ml-4 flex items-center gap-x-4\"><svg viewBox=\"0 0 2 2\"\n                                className=\"-ml-0.5 h-0.5 w-0.5 flex-none fill-white/50\">\n                                <circle cx=\"1\" cy=\"1\" r=\"1\"></circle>\n                            </svg>\n                            <div className=\"flex gap-x-2.5\">\n                                <img src=\"https://randomuser.me/api/portraits/women/2.jpg\" alt=\"\" className=\"h-6 w-6 flex-none rounded-full bg-white/10\" />Jane\n                            </div>\n                        </div>\n                    </div>\n                    <h3 className=\"mt-3 text-lg font-semibold leading-6 text-white\">\n                        <a href=\"/tech-blog/post2\"><span className=\"absolute inset-0\"></span>The Rise of Blockchain Technology:\n                            A Comprehensive Guide</a>\n                    </h3>\n                </article>\n                \n                <article\n                    className=\"relative isolate flex flex-col justify-end overflow-hidden rounded-2xl bg-gray-900 dark700 px-8 py-8 pb-8 pt-80 sm48 lg80\">\n                    <img src=\"https://images.unsplash.com/photo-1666112835156-c65bb806ac73?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w0NzEyNjZ8MHwxfHNlYXJjaHwxNXx8cXVhbnR1bSUyMGNvbXB1dGluZ3xlbnwwfDB8fHwxNzEyNzUzMTk2fDA&ixlib=rb-4.0.3&q=80&w=1080\" alt=\"\" className=\"absolute inset-0 -z-10 h-full w-full object-cover\" />\n                    <div className=\"absolute inset-0 -z-10 bg-gradient-to-t from-gray-900 via-gray-900/40\"></div>\n                    <div className=\"absolute inset-0 -z-10 rounded-2xl ring-1 ring-inset ring-gray-900/10\"></div>\n                    <div className=\"flex flex-wrap items-center gap-y-1 overflow-hidden text-sm leading-6 text-gray-300\"><time\n                            datetime=\"2023-09-24\" className=\"mr-8\">Sept 24, 2023</time>\n                        <div className=\"-ml-4 flex items-center gap-x-4\"><svg viewBox=\"0 0 2 2\"\n                                className=\"-ml-0.5 h-0.5 w-0.5 flex-none fill-white/50\">\n                                <circle cx=\"1\" cy=\"1\" r=\"1\"></circle>\n                            </svg>\n                            <div className=\"flex gap-x-2.5\">\n                                <img src=\"https://randomuser.me/api/portraits/men/4.jpg\" alt=\"\" className=\"h-6 w-6 flex-none rounded-full bg-white/10\" />Michael\n                            </div>\n                        </div>\n                    </div>\n                    <h3 className=\"mt-3 text-lg font-semibold leading-6 text-white\">\n                        <a href=\"/tech-blog/post3\"><span className=\"absolute inset-0\"></span>How Quantum Computing Will\n                            Revolutionize Data Security</a>\n                    </h3>\n                </article>\n                \n            </div>\n        </div>\n    \n    </div>\n    </div>\n  );\n}\n",
