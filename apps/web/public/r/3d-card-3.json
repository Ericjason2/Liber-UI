      "content": "import * as React from \"react\"\n\nfunction Comp3dCard3({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"3d-card-3\"\n      className={className}\n      {...props}\n    >\n      <style>{\"/* Smooth perspective for 3D tilt */\\n    .card {\\n      perspective: 1000px;\\n    }\\n    .card-inner {\\n      transition: transform 0.3s ease;\\n      transform-style: preserve-3d;\\n    }\"}</style>\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 w-full max-w-6xl\">\n      \n          \n          <div className=\"card\">\n            <div className=\"card-inner bg-white rounded-2xl shadow-2xl overflow-hidden cursor-pointer transform transition duration-500\">\n              <img src=\"https://picsum.photos/400/250?random=1\" alt=\"Card Image\" className=\"w-full h-52 object-cover\" />\n              <div className=\"p-6 text-center\">\n                <h2 className=\"text-xl font-bold text-gray-800 mb-2\">3D Card 1</h2>\n                <p className=\"text-gray-500 mb-4\">Hover to tilt me and see the floating 3D effect with shadows. Looks epic on all devices!</p>\n                <button className=\"px-6 py-2 rounded-full bg-gradient-to-r from-purple-600 to-pink-500 text-white font-semibold transition-transform duration-300 hover:scale-110 hover:from-purple-500 hover:to-pink-400\">\n                  Read More\n                </button>\n              </div>\n            </div>\n          </div>\n      \n          \n          <div className=\"card\">\n            <div className=\"card-inner bg-white rounded-2xl shadow-2xl overflow-hidden cursor-pointer transform transition duration-500\">\n              <img src=\"https://picsum.photos/400/250?random=2\" alt=\"Card Image\" className=\"w-full h-52 object-cover\" />\n              <div className=\"p-6 text-center\">\n                <h2 className=\"text-xl font-bold text-gray-800 mb-2\">3D Card 2</h2>\n                <p className=\"text-gray-500 mb-4\">Scale, tilt, and float on hover. Perfect for a portfolio or modern UI section.</p>\n                <button className=\"px-6 py-2 rounded-full bg-gradient-to-r from-purple-600 to-pink-500 text-white font-semibold transition-transform duration-300 hover:scale-110 hover:from-purple-500 hover:to-pink-400\">\n                  Read More\n                </button>\n              </div>\n            </div>\n          </div>\n      \n          \n          <div className=\"card\">\n            <div className=\"card-inner bg-white rounded-2xl shadow-2xl overflow-hidden cursor-pointer transform transition duration-500\">\n              <img src=\"https://picsum.photos/400/250?random=3\" alt=\"Card Image\" className=\"w-full h-52 object-cover\" />\n              <div className=\"p-6 text-center\">\n                <h2 className=\"text-xl font-bold text-gray-800 mb-2\">3D Card 3</h2>\n                <p className=\"text-gray-500 mb-4\">Responsive, animated, and interactive 3D card. Duplicate as many as you want!</p>\n                <button className=\"px-6 py-2 rounded-full bg-gradient-to-r from-purple-600 to-pink-500 text-white font-semibold transition-transform duration-300 hover:scale-110 hover:from-purple-500 hover:to-pink-400\">\n                  Read More\n                </button>\n              </div>\n            </div>\n          </div>\n      \n        </div>\n      \n        \n    </div>\n  )\n}\n\nexport { Comp3dCard3 }\n",
      "type": "registry:ui"
    }
  ],
