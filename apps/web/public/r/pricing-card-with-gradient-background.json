scale-95 sm:w-max\"\n                href=\"#contact\"><span className=\"relative text-sm font-semibold text-black\">Get Started</span></a>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  )\n}\n\nexport { PricingCardWithGradientBackground }\n",
      "type": "registry:ui"
    }
