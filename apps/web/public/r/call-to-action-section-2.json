lt=\"member photo\" className=\"h-8 w-8 rounded-full object-cover\" />\n                </div>\n    \n                <div className=\"mt-6 m-auto space-y-6 md8/12 lg7/12\">\n                    <h1 className=\"text-center text-4xl font-bold text-gray-800 dark md5xl\">Get Started now\n                    </h1>\n                    <p className=\"text-center text-xl text-gray-600 dark300\">\n                        Be part of millions people around the world using tailus in modern User Interfaces.\n                    </p>\n                    <div className=\"flex flex-wrap justify-center gap-6\">\n                        <a href=\"#\"\n                            className=\"relative flex h-12 w-full items-center justify-center px-8 before before0 before before500 before before300 hover105 active75 active95 sm\">\n                            <span className=\"relative text-base font-semibold text-white dark\">Get Started</span>\n                        </a>\n                        <a href=\"#\"\n                            className=\"relative flex h-12 w-full items-center justify-center px-8 before before0 before before before before500/10 before before before300 hover105 active75 active95 dark700 dark800 sm\">\n                            <span className=\"relative text-base font-semibold text-teal-500 dark\">More about</span>\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    \n    </div>\n    </div>\n  );\n}\n",
