    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>BerryFresh Farms | Organic Strawberries</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n    <script>\n        tailwind.config = {\n            theme: {\n                extend: {\n                    animation: {\n                        'float': 'float 6s ease-in-out infinite',\n                        'pulse-glow': 'pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite',\n                        'fade-in': 'fadeIn 1s ease-out forwards',\n                        'slide-left': 'slideLeft 0.8s ease-out forwards'\n                    },\n                    keyframes: {\n                        float: {\n                            '0%, 100%': { transform: 'translateY(0)' },\n                            '50%': { transform: 'translateY(-15px)' }\n                        },\n                        fadeIn: {\n                            '0%': { opacity: '0' },\n                            '100%': { opacity: '1' }\n                        },\n                        slideLeft: {\n                            '0%': { transform: 'translateX(30px)', opacity: '0' },\n                            '100%': { transform: 'translateX(0)', opacity: '1' }\n                        }\n                    },\n                    colors: {\n                        berry: {\n                            red: '#E63946',\n                            green: '#588157',\n                            cream: '#F1FAEE',\n                            dark: '#1D3557'\n                        }\n                    }\n                }\n            }\n        }\n    </script>\n    <style type=\"text/tailwindcss\">\n        @layer utilities {\n            .text-stroke-white {\n                -webkit-text-stroke: 1px rgba(255,255,255,0.3);\n                text-stroke: 1px rgba(255,255,255,0.3);\n            }\n            .delay-100 {\n                animation-delay: 100ms;\n            }\n            .delay-200 {\n                animation-delay: 200ms;\n            }\n            .delay-300 {\n                animation-delay: 300ms;\n            }\n        }\n    </style>\n</head>\n<body class=\"bg-berry-cream text-berry-dark\">\n    <!-- Navigation -->\n    <nav class=\"fixed top-0 left-0 w-full py-4 px-6 z-50 bg-white/90 backdrop-blur-sm border-b border-gray-100\">\n        <div class=\"max-w-7xl mx-auto flex justify-between items-center\">\n            <div class=\"flex items-center\">\n                <span class=\"text-2xl font-bold text-berry-red\">BerryFresh</span>\n            </div>\n            <div class=\"hidden md:flex space-x-8\">\n                <a href=\"#\" class=\"text-gray-700 hover:text-berry-red transition-colors\">Home</a>\n                <a href=\"#\" class=\"text-gray-700 hover:text-berry-red transition-colors\">Our Farm</a>\n                <a href=\"#\" class=\"text-gray-700 hover:text-berry-red transition-colors\">Products</a>\n                <a href=\"#\" class=\"text-gray-700 hover:text-berry-red transition-colors\">Recipes</a>\n                <a href=\"#\" class=\"text-gray-700 hover:text-berry-red transition-colors\">Contact</a>\n            </div>\n            <button class=\"px-4 py-2 bg-berry-red text-white rounded-lg hover:bg-berry-red/90 transition-colors\">\n                Order Now\n            </button>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"min-h-screen pt-24 pb-12 px-6 md:px-12 flex flex-col lg:flex-row items-center justify-center max-w-7xl mx-auto gap-12\">\n        <!-- Text Content -->\n        <div class=\"lg:w-1/2 animate-fade-in\">\n            <h1 class=\"text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6\">\n                <span class=\"block\">Sun-Ripened</span>\n                <span class=\"block text-berry-red\">Strawberries</span>\n            </h1>\n            \n            <div class=\"h-12 overflow-hidden mb-6\">\n                <h2 class=\"text-xl md:text-2xl font-semibold whitespace-nowrap border-r-4 border-r-berry-red pr-2 animate-typewriter animate-blink\">\n                    Fresh from our fields\n                </h2>\n            </div>\n            \n            <p class=\"text-lg text-gray-700 mb-8 max-w-lg\">\n                Grown with care and harvested at peak ripeness, our organic strawberries are bursting with natural sweetness and vibrant flavor.\n            </p>\n            \n            <div class=\"flex flex-col sm:flex-row gap-4\">\n                <button class=\"px-8 py-3 bg-berry-red text-white rounded-lg hover:bg-berry-red/90 transition-all transform hover:-translate-y-1 shadow-lg\">\n                    Shop Now\n                </button>\n                <button class=\"px-8 py-3 border border-berry-red text-berry-red rounded-lg hover:bg-berry-red/10 transition-all\">\n                    Visit Our Farm\n                </button>\n            </div>\n            \n            <div class=\"mt-12 flex items-center space-x-8\">\n                <div class=\"flex flex-col\">\n                    <span class=\"text-2xl font-bold text-berry-red\">100%</span>\n                    <span class=\"text-gray-600\">Organic</span>\n                </div>\n                <div class=\"flex flex-col\">\n                    <span class=\"text-2xl font-bold text-berry-red\">24h</span>\n                    <span class=\"text-gray-600\">From Farm to Table</span>\n                </div>\n                <div class=\"flex flex-col\">\n                    <span class=\"text-2xl font-bold text-berry-red\">5★</span>\n                    <span class=\"text-gray-600\">Customer Rated</span>\n                </div>\n            </div>\n        </div>\n        \n        <!-- Image Content -->\n        <div class=\"lg:w-1/2 relative animate-slide-left delay-200\">\n            <div class=\"absolute -inset-4 bg-berry-green/20 rounded-3xl -z-10\"></div>\n            <div class=\"relative rounded-3xl overflow-hidden shadow-2xl transform rotate-1 hover:rotate-0 transition-transform duration-500\">\n                <img src=\"https://images.unsplash.com/photo-1464965911861-746a04b4bca6?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80\" \n                     alt=\"Fresh strawberries\" \n                     class=\"w-full h-auto object-cover\">\n            </div>\n            \n            <!-- Floating Berry Elements -->\n            <div class=\"absolute -top-6 -left-6 bg-white p-3 rounded-xl shadow-lg w-36 animate-float delay-300\">\n                <div class=\"w-8 h-8 rounded-full bg-berry-red/20 text-berry-red flex items-center justify-center mb-2\">\n                    <i class=\"fas fa-seedling\"></i>\n                </div>\n                <h4 class=\"font-bold text-gray-800 text-sm\">No Pesticides</h4>\n                <p class=\"text-xs text-gray-600\">100% Natural</p>\n            </div>\n            \n            <div class=\"absolute -bottom-6 -right-6 bg-white p-3 rounded-xl shadow-lg w-36 animate-float delay-400\">\n                <div class=\"w-8 h-8 rounded-full bg-berry-green/20 text-berry-green flex items-center justify-center mb-2\">\n                    <i class=\"fas fa-truck\"></i>\n                </div>\n                <h4 class=\"font-bold text-gray-800 text-sm\">Fast Delivery</h4>\n                <p class=\"text-xs text-gray-600\">Next Day Available</p>\n            </div>\n        </div>\n    </section>\n\n    <script>\n        // Navbar scroll effect\n        window.addEventListener('scroll', function() {\n            const navbar = document.querySelector('nav');\n            if (window.scrollY > 50) {\n                navbar.classList.add('shadow-sm');\n                navbar.classList.remove('bg-white/90');\n                navbar.classList.add('bg-white/95');\n            } else {\n                navbar.classList.remove('shadow-sm');\n                navbar.classList.add('bg-white/90');\n                navbar.classList.remove('bg-white/95');\n            }\n        });\n\n        // Simple typewriter effect\n        document.addEventListener('DOMContentLoaded', () => {\n            const typewriter = document.querySelector('.animate-typewriter');\n            typewriter.style.animation = 'typewriter 2s steps(16) forwards, blink 1s steps(16) infinite 2s';\n        });\n    </script>\n</body>\n</html>"
  }
