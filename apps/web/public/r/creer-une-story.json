    "rawHtml": "<!-- Style Section -->\n<style>\n  body {\n    font-family: 'Roboto', sans-serif;\n    background-color: #fafafa;\n  }\n  \n  .story-gradient {\n    background: radial-gradient(circle, #ff3882 0%, #5851db 100%);\n    -webkit-mask: \n      radial-gradient(40px circle at center, black 100%, transparent 100%),\n      radial-gradient(36px circle at center, transparent 100%, black 100%);\n    mask: \n      radial-gradient(40px circle at center, black 100%, transparent 100%),\n      radial-gradient(36px circle at center, transparent 100%, black 100%);\n    -webkit-mask-composite: xor;\n    mask-composite: exclude;\n  }\n  \n  .post-hover {\n    position: relative;\n    overflow: hidden;\n  }\n  \n  .post-hover::before {\n    content: '';\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    background: rgba(0,0,0,0.2);\n    opacity: 0;\n    transition: opacity 0.3s ease;\n    z-index: 1;\n  }\n  \n  .post-hover:hover::before {\n    opacity: 1;\n  }\n  \n  .heart-animation {\n    animation: heart-beat 0.8s ease-in-out;\n  }\n  \n  @keyframes heart-beat {\n    0%, 100% { transform: scale(1); }\n    14%, 42% { transform: scale(1.3); }\n  }\n  \n  .typing::after {\n    content: '|';\n    animation: blink 1s infinite;\n  }\n  \n  @keyframes blink {\n    50% { opacity: 0; }\n  }\n  \n  .animate-gradient {\n    background-size: 200% 200%;\n    animation: gradient-animation 3s ease infinite;\n  }\n  \n  @keyframes gradient-animation {\n    0%, 100% { background-position: 0% 50%; }\n    50% { background-position: 100% 50%; }\n  }\n  \n  .hide-scrollbar {\n    -ms-overflow-style: none;\n    scrollbar-width: none;\n  }\n  \n  .hide-scrollbar::-webkit-scrollbar {\n    display: none;\n  }\n</style>\n\n<!-- Stories Section -->\n<div class=\"px-4 py-3 overflow-x-auto hide-scrollbar\" x-show=\"showStories\">\n  <div class=\"flex space-x-3 pb-2\">\n    <div @click=\"createStory\" class=\"flex flex-col items-center cursor-pointer group\">\n      <div class=\"w-16 h-16 rounded-full bg-gradient-to-r from-pink-500 to-yellow-500 p-1 story-gradient relative\">\n        <div class=\"w-full h-full rounded-full bg-gray-200 flex items-center justify-center\">\n          <i class=\"fas fa-plus text-white text-xl\"></i>\n        </div>\n      </div>\n      <span class=\"mt-1 text-xs font-medium text-gray-700\">Créer</span>\n    </div>\n    \n    <template x-for=\"(story, index) in stories\" :key=\"index\">\n      <div @click=\"viewStory(story)\" class=\"flex flex-col items-center cursor-pointer group\">\n        <div class=\"w-16 h-16 rounded-full bg-gradient-to-r from-purple-500 to-pink-500 p-1 story-gradient relative overflow-hidden\">\n          <img :src=\"story.image\" :alt=\"`Story de ${story.name}`\" class=\"w-full h-full rounded-full object-cover\">\n          <div class=\"absolute inset-0 bg-gradient-to-t from-black/70 to-transparent rounded-full\"></div>\n          <div class=\"absolute bottom-1 left-0 right-0 text-white text-xs text-center font-medium truncate px-1\" x-text=\"story.name\"></div>\n        </div>\n        <span class=\"mt-1 text-xs font-medium text-gray-700 truncate max-w-[64px]\" x-text=\"story.name\"></span>\n      </div>\n    </template>\n  </div>\n</div>\n\n<!-- Profile Section -->\n<div class=\"px-4 pt-4 pb-3 border-b border-gray-200\">\n  <div class=\"flex items-start space-x-4\">\n    <div class=\"relative\">\n      <div class=\"w-28 h-28 rounded-full bg-gradient-to-r from-purple-500 to-pink-500 p-1 story-gradient\">\n        <img :src=\"profileData.avatar\" alt=\"Photo de profil\" class=\"w-full h-full rounded-full object-cover\">\n      </div>\n      <button @click=\"editProfilePicture\" class=\"absolute bottom-1 right-1 bg-white rounded-full p-1 shadow-md border border-gray-200 hover:bg-gray-100 transition-colors\" aria-label=\"Modifier la photo de profil\">\n        <i class=\"fas fa-camera text-gray-700 text-xs\"></i>\n      </button>\n    </div>\n    \n    <div class=\"flex-1\">\n      <div class=\"flex items-center justify-between\">\n        <div>\n          <h1 class=\"font-bold text-2xl text-gray-900\" x-text=\"profileData.fullName\"></h1>\n          <p class=\"text-sm text-gray-500\" x-text=\"profileData.bio\"></p>\n          <div class=\"flex items-center space-x-3 mt-1\">\n            <button class=\"text-sm font-medium text-blue-500 hover:underline\">Modifier le profil</button>\n            <div class=\"w-1 h-1 rounded-full bg-gray-400\"></div>\n            <button class=\"text-sm font-medium text-blue-500 hover:underline\">Voir l'archivage</button>\n          </div>\n        </div>\n        <button @click=\"toggleMoreOptions\" class=\"text-gray-700 hover:text-gray-900\" aria-label=\"Options\">\n          <i class=\"fas fa-ellipsis-h text-xl\"></i>\n        </button>\n      </div>\n      \n      <div class=\"grid grid-cols-3 gap-3 mt-4\">\n        <div class=\"text-center\">\n          <span class=\"font-bold text-gray-900\" x-text=\"profileData.posts\"></span>\n          <p class=\"text-xs text-gray-500\">posts</p>\n        </div>\n        <div class=\"text-center\">\n          <span class=\"font-bold text-gray-900\" x-text=\"profileData.followers\"></span>\n          <p class=\"text-xs text-gray-500\">followers</p>\n        </div>\n        <div class=\"text-center\">\n          <span class=\"font-bold text-gray-900\" x-text=\"profileData.following\"></span>\n          <p class=\"text-xs text-gray-500\">following</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<!-- Navigation Tabs -->\n<div class=\"border-t border-gray-200\">\n  <div class=\"flex\">\n    <button @click=\"activeTab = 'posts'\" :class=\"{'text-black font-medium border-b-2 border-black': activeTab === 'posts'}\" class=\"flex-1 py-3 text-sm font-medium text-gray-500 hover:text-gray-900 transition-colors\" aria-label=\"Posts\">\n      <i class=\"fas fa-th text-xl\"></i>\n    </button>\n    <button @click=\"activeTab = 'reels'\" :class=\"{'text-black font-medium border-b-2 border-black': activeTab === 'reels'}\" class=\"flex-1 py-3 text-sm font-medium text-gray-500 hover:text-gray-900 transition-colors\" aria-label=\"Reels\">\n      <i class=\"fas fa-film text-xl\"></i>\n    </button>\n    <button @click=\"activeTab = 'tagged'\" :class=\"{'text-black font-medium border-b-2 border-black': activeTab === 'tagged'}\" class=\"flex-1 py-3 text-sm font-medium text-gray-500 hover:text-gray-900 transition-colors\" aria-label=\"Tagged\">\n      <i class=\"fas fa-tag text-xl\"></i>\n    </button>\n    <button @click=\"activeTab = 'saved'\" :class=\"{'text-black font-medium border-b-2 border-black': activeTab === 'saved'}\" class=\"flex-1 py-3 text-sm font-medium text-gray-500 hover:text-gray-900 transition-colors\" aria-label=\"Enregistrés\">\n      <i class=\"fas fa-bookmark text-xl\"></i>\n    </button>\n  </div>\n</div>\n\n<!-- Posts Grid -->\n<div class=\"grid grid-cols-3 gap-0.5\" x-show=\"activeTab === 'posts'\">\n  <template x-for=\"(post, index) in posts\" :key=\"index\">\n    <div @click=\"viewPost(post)\" class=\"aspect-square post-hover cursor-pointer group relative overflow-hidden\">\n      <img :src=\"post.image\" :alt=\"`Post ${index + 1}`\" class=\"w-full h-full object-cover transition-transform duration-300 group-hover:scale-105\">\n      <div class=\"absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity z-10\">\n        <div class=\"flex space-x-6\">\n          <div class=\"flex flex-col items-center text-white\">\n            <div class=\"bg-black/50 rounded-full p-2 mb-1\">\n              <i class=\"fas fa-heart text-xl\"></i>\n            </div>\n            <span class=\"font-medium\" x-text=\"post.likes\"></span>\n          </div>\n          <div class=\"flex flex-col items-center text-white\">\n            <div class=\"bg-black/50 rounded-full p-2 mb-1\">\n              <i class=\"fas fa-comment text-xl\"></i>\n            </div>\n            <span class=\"font-medium\" x-text=\"post.comments\"></span>\n          </div>\n        </div>\n      </div>\n    </div>\n  </template>\n</div>\n\n<!-- Reels Section -->\n<div x-show=\"activeTab === 'reels'\" class=\"p-4\">\n  <div class=\"space-y-4\">\n    <template x-for=\"(reel, index) in reels\" :key=\"index\">\n      <div class=\"flex items-start space-x-3 group cursor-pointer hover:bg-gray-50 p-2 rounded-lg transition-colors\">\n        <div class=\"relative\">\n          <div class=\"w-16 h-16 rounded-xl overflow-hidden\">\n            <img :src=\"reel.thumbnail\" :alt=\"reel.title\" class=\"w-full h-full object-cover\">\n          </div>\n          <div class=\"absolute inset-0 flex items-center justify-center\">\n            <i class=\"fas fa-play-circle text-white text-2xl opacity-0 group-hover:opacity-100 transition-opacity\"></i>\n          </div>\n        </div>\n        \n        <div class=\"flex-1 min-w-0\">\n          <p class=\"font-medium text-gray-900 truncate\" x-text=\"reel.title\"></p>\n          <p class=\"text-xs text-gray-500\" x-text=\"`${reel.views} vues`\"></p>\n        </div>\n        \n        <div class=\"flex items-center space-x-2\">\n          <button @click.stop=\"likeReel(reel)\" class=\"text-gray-500 hover:text-red-500 transition-colors\" aria-label=\"Aimer\">\n            <i :class=\"reel.liked ? 'fas fa-heart text-red-500' : 'far fa-heart'\" class=\"text-xl\"></i>\n          </button>\n          <span class=\"text-xs text-gray-500\" x-text=\"reel.likes\"></span>\n        </div>\n      </div>\n    </template>\n  </div>\n</div>\n\n<!-- More Options Modal -->\n<div x-show=\"showMoreOptions\" class=\"fixed inset-0 bg-black/50 flex items-end justify-center z-50\" @click=\"showMoreOptions = false\">\n  <div class=\"bg-white rounded-t-xl w-full max-w-md\" @click.stop>\n    <div class=\"p-4 space-y-3\">\n      <button class=\"w-full text-left py-3 text-gray-700 hover:bg-gray-100 rounded-lg px-3 font-medium\">Partager ce profil</button>\n      <button class=\"w-full text-left py-3 text-gray-700 hover:bg-gray-100 rounded-lg px-3 font-medium\">Copier le lien du profil</button>\n      <button class=\"w-full text-left py-3 text-gray-700 hover:bg-gray-100 rounded-lg px-3 font-medium\">Ajouter à vos favoris</button>\n      <button class=\"w-full text-left py-3 text-gray-700 hover:bg-gray-100 rounded-lg px-3 font-medium\">Bloquer</button>\n      <button class=\"w-full text-left py-3 text-gray-700 hover:bg-gray-100 rounded-lg px-3 font-medium\">Signaler</button>\n    </div>\n    <div class=\"p-4\">\n      <button @click=\"showMoreOptions = false\" class=\"w-full py-3 text-gray-700 font-medium rounded-lg bg-gray-100 hover:bg-gray-200\">Annuler</button>\n    </div>\n  </div>\n</div>\n\n<!-- Story Modal -->\n<div x-show=\"currentStory\" class=\"fixed inset-0 bg-black z-50 flex items-center justify-center\" @click=\"closeStory\">\n  <div class=\"relative w-full h-full max-w-md\" @click.stop>\n    <div class=\"relative w-full h-full\">\n      <img :src=\"currentStory ? currentStory.image : ''\" :alt=\"`Story de ${currentStory ? currentStory.name : ''}`\" class=\"w-full h-full object-contain\">\n      <div class=\"absolute top-4 left-4 right-4 flex items-center justify-between\">\n        <div class=\"flex items-center space-x-2\">\n          <div class=\"w-8 h-8 rounded-full overflow-hidden\">\n            <img :src=\"currentStory ? currentStory.image : ''\" alt=\"Profile\" class=\"w-full h-full object-cover\">\n          </div>\n          <div>\n            <p class=\"font-bold text-white\" x-text=\"currentStory ? currentStory.name : ''\"></p>\n            <p class=\"text-xs text-white/75\">Il y a 2 heures</p>\n          </div>\n        </div>\n        <button @click=\"closeStory\" class=\"text-white\" aria-label=\"Fermer\">\n          <i class=\"fas fa-times text-xl\"></i>\n        </button>\n      </div>\n      <div class=\"absolute bottom-4 left-4 right-4 flex items-center justify-between\">\n        <div class=\"flex space-x-4\">\n          <button class=\"text-white\" aria-label=\"Commenter\">\n            <i class=\"far fa-comment text-xl\"></i>\n          </button>\n          <button class=\"text-white\" aria-label=\"Partager\">\n            <i class=\"fas fa-paper-plane text-xl\"></i>\n          </button>\n        </div>\n        <button @click=\"closeStory\" class=\"text-white\" aria-label=\"Enregistrer\">\n          <i class=\"far fa-bookmark text-xl\"></i>\n        </button>\n      </div>\n    </div>\n  </div>\n</div>\n\n<!-- Create Story Modal -->\n<div x-show=\"creatingStory\" class=\"fixed inset-0 bg-black/80 flex items-center justify-center z-50\">\n  <div class=\"bg-white rounded-2xl w-11/12 max-w-md p-6 relative\">\n    <button @click=\"creatingStory = false\" class=\"absolute top-4 right-4 text-gray-500 hover:text-gray-700\" aria-label=\"Fermer\">\n      <i class=\"fas fa-times text-xl\"></i>\n    </button>\n    \n    <div class=\"text-center mb-6\">\n      <h2 class=\"text-2xl font-bold text-gray-900\">Créer une story</h2>\n      <p class=\"text-gray-500 mt-1\">Ajoutez une photo ou une vidéo</p>\n    </div>\n    \n    <div class=\"flex justify-center mb-6\">\n      <div class=\"w-32 h-32 rounded-full bg-gradient-to-r from-purple-500 to-pink-500 p-2 flex items-center justify-center story-gradient\">\n        <div class=\"w-full h-full rounded-full bg-gray-200 flex items-center justify-center\">\n          <i class=\"fas fa-camera text-gray-600 text-3xl\"></i>\n        </div>\n      </div>\n    </div>\n    \n    <div class=\"space-y-4\">\n      <button class=\"w-full py-3 bg-gradient-to-r from-purple-500 to-pink-500 text-white font-medium rounded-lg hover:opacity-90 transition-opacity\">\n        <i class=\"fas fa-camera mr-2\"></i> Prendre une photo\n      </button>\n      <button class=\"w-full py-3 bg-gray-100 text-gray-700 font-medium rounded-lg hover:bg-gray-200 transition-colors\">\n        <i class=\"fas fa-image mr-2\"></i> Choisir depuis la galerie\n      </button>\n      <button class=\"w-full py-3 bg-gray-100 text-gray-700 font-medium rounded-lg hover:bg-gray-200 transition-colors\">\n        <i class=\"fas fa-video mr-2\"></i> Enregistrer une vidéo\n      </button>\n    </div>\n  </div>\n</div>\n\n<!-- Floating Action Button -->\n<button @click=\"showCreateMenu = !showCreateMenu\" class=\"fixed bottom-6 right-6 w-14 h-14 rounded-full bg-gradient-to-r from-purple-500 to-pink-500 flex items-center justify-center shadow-lg z-40 animate-float\" aria-label=\"Créer\">\n  <i class=\"fas fa-plus text-white text-2xl\"></i>\n</button>\n\n<!-- Create Menu -->\n<div x-show=\"showCreateMenu\" class=\"fixed bottom-20 right-6 bg-white rounded-xl shadow-lg py-2 w-48 z-30\" @click.outside=\"showCreateMenu = false\">\n  <button class=\"flex items-center w-full px-4 py-3 hover:bg-gray-100 transition-colors\">\n    <i class=\"fas fa-image text-pink-500 mr-3\"></i>\n    <span class=\"font-medium\">Publication</span>\n  </button>\n  <button class=\"flex items-center w-full px-4 py-3 hover:bg-gray-100 transition-colors\">\n    <i class=\"fas fa-video text-blue-500 mr-3\"></i>\n    <span class=\"font-medium\">Reel</span>\n  </button>\n  <button class=\"flex items-center w-full px-4 py-3 hover:bg-gray-100 transition-colors\">\n    <i class=\"fas fa-tv text-purple-500 mr-3\"></i>\n    <span class=\"font-medium\">Story</span>\n  </button>\n  <button class=\"flex items-center w-full px-4 py-3 hover:bg-gray-100 transition-colors\">\n    <i class=\"fas fa-user-plus text-green-500 mr-3\"></i>\n    <span class=\"font-medium\">Room</span>\n  </button>\n</div>\n\n<!-- Notification -->\n<div x-show=\"notification.show\" class=\"fixed top-4 right-4 bg-black text-white px-4 py-3 rounded-lg shadow-lg z-50 transition-all duration-300\" \n     :class=\"{'opacity-0 translate-y-4': !notification.show, 'opacity-100 translate-y-0': notification.show}\">\n  <i class=\"fas fa-check-circle mr-2\"></i>\n  <span x-text=\"notification.message\"></span>\n</div>\n\n<script>\n  function instagramProfile() {\n    return {\n      profileData: {\n        username: 'omerlinks',\n        fullName: 'Omer Links',\n        bio: 'Créateur de contenu ✨ | Design & Développement 💻 | Passionné par l\\'innovation 🔥',\n        avatar: 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=100&h=100&fit=crop&crop=face',\n        posts: '142',\n        followers: '12.5k',\n        following: '285'\n      },\n      activeTab: 'posts',\n      showStories: true,\n      showMoreOptions: false,\n      showCreateMenu: false,\n      creatingStory: false,\n      currentStory: null,\n      notification: {\n        show: false,\n        message: ''\n      },\n      stories: [\n        { id: 1, name: 'Marie', image: 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&h=100&fit=crop&crop=face' },\n        { id: 2, name: 'Thomas', image: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100&h=100&fit=crop&crop=face' },\n        { id: 3, name: 'Sophie', image: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&h=100&fit=crop&crop=face' },\n        { id: 4, name: 'Pierre', image: 'https://images.unsplash.com/photo-1560250097-0b93528c311a?w=100&h=100&fit=crop&crop=face' },\n        { id: 5, name: 'Emma', image: 'https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?w=100&h=100&fit=crop&crop=face' },\n        { id: 6, name: 'Lucas', image: 'https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?w=100&h=100&fit=crop&crop=face' }\n      ],\n      posts: [\n        { id: 1, image: 'https://images.unsplash.com/photo-1611605698335-8b1569456c99?w=600&h=600&fit=crop', likes: '1.2k', comments: '42' },\n        { id: 2, image: 'https://images.unsplash.com/photo-1501386761578-eac5c94b800a?w=600&h=600&fit=crop', likes: '3.4k', comments: '128' },\n        { id: 3, image: 'https://images.unsplash.com/photo-1542744094-24638eff58bb?w=600&h=600&fit=crop', likes: '856', comments: '31' },\n        { id: 4, image: 'https://images.unsplash.com/photo-1519681393784-d120267933ba?w=600&h=600&fit=crop', likes: '2.1k', comments: '76' },\n        { id: 5, image: 'https://images.unsplash.com/photo-1526336024174-d28b65e6ce30?w=600&h=600&fit=crop', likes: '1.8k', comments: '64' },\n        { id: 6, image: 'https://images.unsplash.com/photo-1607082350899-7e105aa886ae?w=600&h=600&fit=crop', likes: '945', comments: '29' },\n        { id: 7, image: 'https://images.unsplash.com/photo-1542366691111-9521408f0201?w=600&h=600&fit=crop', likes: '4.2k', comments: '153' },\n        { id: 8, image: 'https://images.unsplash.com/photo-1593692907257-2c02217894e8?w=600&h=600&fit=crop', likes: '732', comments: '27' },\n        { id: 9, image: 'https://images.unsplash.com/photo-1507238691740-38f879d08084?w=600&h=600&fit=crop', likes: '1.5k', comments: '58' }\n      ],\n      reels: [\n        { id: 1, title: 'Tutoriel CSS Grid', thumbnail: 'https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=160&h=160&fit=crop', views: '45k', likes: '2.1k', liked: false },\n        { id: 2, title: 'Astuce JavaScript', thumbnail: 'https://images.unsplash.com/photo-1547658719-da2b51169166?w=160&h=160&fit=crop', views: '32k', likes: '1.8k', liked: true },\n        { id: 3, title: 'Design UI/UX', thumbnail: 'https://images.unsplash.com/photo-1551650975-87deedd944c3?w=160&h=160&fit=crop', views: '28k', likes: '945', liked: false }\n      ],\n\n      init() {\n        this.animateElements();\n        this.loadProfileData();\n      },\n\n      animateElements() {\n        setTimeout(() => {\n          this.showStories = true;\n        }, 300);\n      },\n\n      loadProfileData() {\n        setTimeout(() => {\n          this.showNotification('Bienvenue sur votre profil Instagram !');\n        }, 1000);\n      },\n\n      toggleMoreOptions() {\n        this.showMoreOptions = !this.showMoreOptions;\n      },\n\n      viewStory(story) {\n        this.currentStory = story;\n        document.body.style.overflow = 'hidden';\n      },\n\n      closeStory() {\n        this.currentStory = null;\n        document.body.style.overflow = 'auto';\n      },\n\n      createStory() {\n        this.creatingStory = true;\n      },\n\n      editProfilePicture() {\n        this.showNotification('Modifier la photo de profil');\n      },\n\n      likeReel(reel) {\n        reel.liked = !reel.liked;\n        \n        // Simpler likes handling\n        const likes = parseInt(reel.likes) || 0;\n        reel.likes = reel.liked ? likes + 1 : likes - 1;\n        \n        this.showNotification(reel.liked ? 'Like ajouté !' : 'Like retiré');\n      },\n\n      viewPost(post) {\n        this.showNotification(`Ouverture du post #${post.id}`);\n      },\n\n      showNotification(message) {\n        this.notification.show = true;\n        this.notification.message = message;\n        \n        setTimeout(() => {\n          this.notification.show = false;\n        }, 3000);\n      }\n    }\n  }\n\n  // Initialize animations\n  document.addEventListener('DOMContentLoaded', function() {\n    const elements = document.querySelectorAll('[class*=\"animate-\"]');\n    elements.forEach((el, index) => {\n      el.style.opacity = '0';\n      el.style.transform = 'translateY(20px)';\n      \n      setTimeout(() => {\n        el.style.transition = 'opacity 0.5s ease, transform 0.5s ease';\n        el.style.opacity = '1';\n        el.style.transform = 'translateY(0)';\n      }, 200 * index);\n    });\n  });\n</script>"
  }
}
