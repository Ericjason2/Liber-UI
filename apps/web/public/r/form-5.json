ld3</p>\n    \n                  <p className=\"text-sm font-semibold text-gray-800 mt-2\">\n                    field3\n                  </p>\n                </div>\n    \n                <div className=\"bg-gray-50 rounded-xl p-4\">\n                  <p className=\"text-xs text-gray-500\">field4</p>\n                  field4\n                </div>\n              </div>\n            </div>\n    \n            <div className=\"border-t border-gray-200\"></div>\n    \n            <div className=\"flex flex-col-reverse sm sm gap-3 pt-2\">\n              <button\n                type=\"button\"\n                className=\"w-full sm px-5 py-2.5 border bg-blue-600 text-white rounded-xl font-medium hover700 transition\"\n              >\n                Close\n              </button>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n",
