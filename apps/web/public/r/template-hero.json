    "rawHtml": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Velix Clone - Background Fix</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap\" rel=\"stylesheet\">\n    <style>\n        body { font-family: 'Inter', sans-serif; }\n    </style>\n</head>\n\n<body class=\"bg-[#F3E5C8] min-h-screen flex items-center justify-center p-4\">\n\n    <main class=\"w-full bg-white rounded-[40px] shadow-2xl overflow-hidden mx-auto relative flex flex-col\">\n        \n        <section class=\"relative h-[600px] text-white p-8 lg:p-12 flex flex-col justify-between overflow-hidden\">\n            \n            <div class=\"absolute inset-0 z-0\">\n                <img src=\"https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?q=80&w=2000&auto=format&fit=crop\" \n                     alt=\"Background\" \n                     class=\"w-full h-full object-cover object-top\">\n                <div class=\"absolute inset-0 bg-gradient-to-br from-[#b8860b]/90 via-[#4a3b18]/80 to-[#1a1a1a]/90 mix-blend-multiply\"></div>\n            </div>\n\n            <header class=\"relative z-20 flex justify-between items-start w-full\">\n                <div class=\"text-2xl font-bold tracking-tighter\">VELIX.®</div>\n                \n                <nav class=\"hidden md:flex flex-col text-right gap-2 text-sm font-light text-gray-200\">\n                    <a href=\"#\" class=\"hover:text-white transition\">About</a>\n                    <a href=\"#\" class=\"hover:text-white transition\">Projects</a>\n                    <a href=\"#\" class=\"hover:text-white transition\">Blog</a>\n                    <a href=\"#\" class=\"hover:text-white transition\">Contact</a>\n                </nav>\n            </header>\n\n            <div class=\"relative z-10 mt-auto w-full grid grid-cols-1 lg:grid-cols-2 gap-8 items-end\">\n                \n                <div class=\"flex flex-col gap-2\">\n                    <span class=\"text-lg font-medium opacity-80\">©2025</span>\n                    <h1 class=\"text-6xl lg:text-8xl font-extrabold leading-[0.9] tracking-tight\">\n                        DESIGN FOR<br>\n                        EXPERIENCES*\n                    </h1>\n                </div>\n\n                <div class=\"flex flex-col items-end w-full\">\n                    <div class=\"w-full flex justify-between items-end\">\n                        <p class=\"text-xs text-gray-300 max-w-[250px] leading-relaxed hidden md:block\">\n                            Your product should captivate hearts and minds. I shape identities that engage, inspire, and grow your brand.\n                        </p>\n                        \n                        <button class=\"flex items-center gap-2 bg-white text-black px-6 py-3 rounded-full text-sm font-bold hover:bg-gray-200 transition group\">\n                            Let's Talk\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"2\" stroke=\"currentColor\" class=\"size-4 group-hover:translate-x-1 transition\">\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3\" />\n                            </svg>\n                        </button>\n                    </div>\n                </div>\n            </div>\n            \n        </section>\n\n        <section class=\"bg-neutral-50 p-8 lg:p-16 relative z-10\">\n            \n            <div class=\"flex flex-col lg:flex-row justify-between items-start gap-12 mb-20\">\n                <div class=\"mt-4\">\n                    <button class=\"flex items-center gap-3 bg-[#2a2a2a] text-white pl-1 pr-6 py-1 rounded-full text-xs font-medium hover:bg-black transition\">\n                        <span class=\"bg-[#3a3a3a] p-2 rounded-full\">\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" class=\"size-3\">\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3\" />\n                            </svg>\n                        </span>\n                        More About Me\n                    </button>\n                </div>\n\n                <div class=\"max-w-xl text-right lg:text-right text-gray-800 relative\">\n                    <div class=\"absolute -top-6 right-1/2 text-2xl\">✦</div>\n                    <h2 class=\"text-2xl md:text-3xl font-medium leading-tight\">\n                        Hey👋, I'm a digital designer in los angeles, bringing digital experiences to life with striking visuals, expressive motion, and effortless interaction.\n                    </h2>\n                    <div class=\"absolute -bottom-8 right-10 text-xl\">✦</div>\n                </div>\n            </div>\n\n            <div class=\"grid grid-cols-2 md:grid-cols-4 gap-8 pt-8 border-t border-gray-200\">\n                <div class=\"flex flex-col gap-2\">\n                    <span class=\"text-5xl font-bold text-gray-900\">21+</span>\n                    <h3 class=\"font-bold text-gray-800 mt-2\">Website launched</h3>\n                    <p class=\"text-xs text-gray-500 leading-relaxed\">Helping brands elevate their online presence confidently.</p>\n                </div>\n                <div class=\"flex flex-col gap-2\">\n                    <span class=\"text-5xl font-bold text-gray-900\">2M+</span>\n                    <h3 class=\"font-bold text-gray-800 mt-2\">Users engaged</h3>\n                    <p class=\"text-xs text-gray-500 leading-relaxed\">Our designs connect and inspire millions worldwide.</p>\n                </div>\n                <div class=\"flex flex-col gap-2\">\n                    <span class=\"text-5xl font-bold text-gray-900\">99%</span>\n                    <h3 class=\"font-bold text-gray-800 mt-2\">Client satisfaction rate</h3>\n                    <p class=\"text-xs text-gray-500 leading-relaxed\">We build relationships that thrive on trust and creativity.</p>\n                </div>\n                <div class=\"flex flex-col gap-2\">\n                    <span class=\"text-5xl font-bold text-gray-900\">12+</span>\n                    <h3 class=\"font-bold text-gray-800 mt-2\">Years of experience</h3>\n                    <p class=\"text-xs text-gray-500 leading-relaxed\">Decades of crafting innovative solutions for leading brands.</p>\n                </div>\n            </div>\n\n        </section>\n    </main>\n\n</body>\n</html>"
