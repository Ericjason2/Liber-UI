    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Sign in - Maison Privee</title>\n<script src=\"https://cdn.tailwindcss.com/3.4.17\"></script>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;1,500&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n</head>\n<body class=\"min-h-screen antialiased bg-[#F3EEE6] text-stone-900\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n<main class=\"min-h-screen flex items-center justify-center p-4 sm:p-6\">\n\n<section class=\"w-full max-w-md bg-[#FCFAF7] border border-[#E4DDD1] rounded-3xl p-8 sm:p-12 shadow-[0_24px_60px_-30px_rgba(60,40,10,0.35)]\">\n  <p class=\"text-center text-sm tracking-wide text-stone-500\">Maison Privée</p>\n  <h1 class=\"text-center text-4xl text-stone-900 mt-2 leading-tight\" style=\"font-family:'Playfair Display',serif;font-weight:500\">Welcome back</h1>\n  <p class=\"text-center text-sm text-stone-500 mt-2\" style=\"font-family:'Playfair Display',serif;font-style:italic\">Sign in to your private catalogue</p>\n  <form data-form class=\"space-y-5\" novalidate>\n    <div>\n      <label for=\"email\" class=\"text-sm text-stone-700 font-medium block mb-1.5\">Email</label>\n      <input id=\"email\" type=\"email\" required autocomplete=\"email\" placeholder=\"client@maison.com\" class=\"w-full bg-white border border-stone-300 rounded-xl px-4 py-3 text-sm text-stone-900 placeholder-stone-400 transition focus:outline-none focus:border-stone-800 focus:ring-4 focus:ring-stone-800/10\">\n    </div>\n    <div>\n  <div class=\"flex items-center justify-between mb-1.5\">\n    <label for=\"pw\" class=\"text-sm text-stone-700 font-medium\">Password</label><a href=\"#\" class=\"text-sm text-stone-500 hover:text-stone-900 underline underline-offset-4\">Need help?</a>\n  </div>\n  <div class=\"relative\">\n    <input id=\"pw\" type=\"password\" required minlength=\"6\" autocomplete=\"current-password\" placeholder=\"Enter your password\" class=\"w-full bg-white border border-stone-300 rounded-xl px-4 py-3 text-sm text-stone-900 placeholder-stone-400 transition focus:outline-none focus:border-stone-800 focus:ring-4 focus:ring-stone-800/10 pr-16\">\n    <button type=\"button\" data-toggle=\"pw\" aria-pressed=\"false\" class=\"absolute right-3 top-1/2 -translate-y-1/2 text-xs font-semibold text-stone-500 hover:text-stone-900 focus-visible:outline-none focus-visible:underline\">Show</button>\n  </div>\n</div>\n    <button type=\"submit\" data-loading=\"Opening...\" class=\"w-full mt-2 bg-stone-900 hover:bg-stone-700 text-stone-50 font-semibold text-sm py-3.5 rounded-xl transition focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-stone-900/30\">Enter the catalogue</button>\n  </form>\n  <p class=\"text-center text-sm text-stone-500 mt-8\">Not a client yet? <a href=\"#\" class=\"text-stone-900 font-semibold underline underline-offset-4\">Request an introduction</a></p>\n</section>\n</main>\n<script>\nconst SPIN='<svg class=\"animate-spin h-4 w-4 inline-block mr-2 -mt-0.5\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><circle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\"/><path class=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z\"/></svg>';\ndocument.querySelectorAll('[data-toggle]').forEach(b=>b.addEventListener('click',()=>{\n  const i=document.getElementById(b.dataset.toggle),show=i.type==='password';\n  i.type=show?'text':'password';b.textContent=show?'Hide':'Show';b.setAttribute('aria-pressed',show);\n}));\ndocument.querySelectorAll('form[data-form]').forEach(f=>f.addEventListener('submit',e=>{\n  e.preventDefault();\n  if(!f.checkValidity()){f.reportValidity();return;}\n  const b=f.querySelector('[type=submit]'),old=b.innerHTML;\n  b.disabled=true;b.classList.add('opacity-80','cursor-wait');b.innerHTML=SPIN+(b.dataset.loading||'Please wait...');\n  setTimeout(()=>{b.disabled=false;b.classList.remove('opacity-80','cursor-wait');b.innerHTML=old;},1600);\n}));\n</script>\n</body>\n</html>"
  }
