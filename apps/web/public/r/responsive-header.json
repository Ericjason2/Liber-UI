      "content": "/**\n * Component: Responsive Header\n * Author: @rajesh-maheshwari (https://tailwindflex.com/@rajesh-maheshwari)\n * Source: https://tailwindflex.com/@rajesh-maheshwari/responsive-header\n * Attribution: Créé par @rajesh-maheshwari sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function ResponsiveHeader() {\n  return (\n    <div>\n    \n        <header className=\"bg-blue-900 text-white\">\n            <div className=\"max-w-7xl mx-auto px-4 sm6 lg8 py-5\">\n                <div className=\"flex items-center justify-between\">\n                    \n                    <div className=\"flex-shrink-0\">\n                        <a href=\"#\" className=\"text-2xl font-bold\">Tailwind </a>\n                    </div>\n    \n                    \n                    <nav className=\"hidden md space-x-10 text-lg\">\n                        <a href=\"#\" className=\"hover300 transition-all\">Home</a>\n                        <a href=\"#services\" className=\"hover300 transition-all\">Services</a>\n                        <a href=\"#about\" className=\"hover300 transition-all\">About Us</a>\n                        <a href=\"#contact\" className=\"hover300 transition-all\">Contact</a>\n                    </nav>\n    \n                    \n                    <div className=\"hidden md\">\n                        <a href=\"#contact\" className=\"bg-yellow-500 hover400 text-black py-2 px-6 rounded-full text-lg transition-all\">\n                            Get in Touch\n                        </a>\n                    </div>\n    \n                    \n                    <div className=\"md flex items-center\">\n                        <button id=\"menu-button\" className=\"text-white focus\">\n                            <svg className=\"h-6 w-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"M4 6h16M4 12h16M4 18h16\"></path>\n                            </svg>\n                        </button>\n                    </div>\n                </div>\n    \n                \n                <div id=\"mobile-menu\" className=\"md mt-5 hidden space-y-4\">\n                    <a href=\"#\" className=\"block text-lg hover300 transition-all\">Home</a>\n                    <a href=\"#services\" className=\"block text-lg hover300 transition-all\">Services</a>\n                    <a href=\"#about\" className=\"block text-lg hover300 transition-all\">About Us</a>\n                    <a href=\"#contact\" className=\"block text-lg hover300 transition-all\">Contact</a>\n                </div>\n            </div>\n        </header>\n    \n        \n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
  ],
