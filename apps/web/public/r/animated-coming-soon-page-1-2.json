      "content": "/**\n * Component: Animated Coming Soon Page 1\n * Author: @repal-co (https://tailwindflex.com/@repal-co)\n * Source: https://tailwindflex.com/@repal-co/animated-coming-soon-page-1-2\n * Attribution: Créé par @repal-co sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function AnimatedComingSoonPage12() {\n  return (\n    <div>\n    <div className=\"h-screen w-full flex items-center justify-center bg-gray-50 dark900\">\n      <div\n        className=\"absolute animate-[cbounce_4s_ease-in-out_infinite] z-10 w-full h-[50%] flex flex-col justify-end items-center bg-gray-50 dark900\">\n        <h1\n          className=\"sm9xl text-7xl font-extrabold font-mono bg-gradient-to-r from-green-500 via-indigo-400 to-indigo-600 inline-block text-transparent bg-clip-text\">\n          Coming</h1>\n      </div>\n      <div className=\"absolute w-full h-[50%] flex flex-col items-center justify-end bg-gray-50 dark900\">\n        <h1\n          className=\"sm7xl text-6xl text-center font-mono font-extrabold bg-gradient-to-r from-green-500 via-indigo-400 to-indigo-600 inline-block text-transparent bg-clip-text\">\n          Soon</h1>\n        <div id=\"countdown\" className=\"flex items-center justify-center text-gray-500 dark text-2xl font-extrabold\">\n          <span id=\"days\" className=\"px-2\"></span>\n          <span id=\"hours\" className=\"px-2\"></span>\n          <span id=\"minutes\" className=\"px-2\"></span>\n          <span id=\"seconds\" className=\"px-2\"></span>\n        </div>\n      </div>\n    \n    </div>\n    \n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
