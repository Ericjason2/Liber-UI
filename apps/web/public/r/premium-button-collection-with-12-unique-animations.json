    "rawHtml": "<body class=\"min-h-screen bg-slate-900 p-8 flex items-center justify-center\">\n\n    <div class=\"max-w-4xl mx-auto\">\n        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n\n            <!-- Button 1: Glow Gradient -->\n            <div class=\"flex items-center justify-center p-8\">\n                <button class=\"group relative px-8 py-4 bg-gradient-to-r from-purple-600 to-pink-600 rounded-xl font-bold text-white overflow-hidden transform transition-all duration-300 hover:scale-110 hover:shadow-[0_0_40px_rgba(168,85,247,0.6)]\">\n                    <span class=\"relative z-10\">Glow Effect</span>\n                    <div class=\"absolute inset-0 bg-gradient-to-r from-pink-600 to-purple-600 opacity-0 group-hover:opacity-100 transition-opacity duration-300\"></div>\n                </button>\n            </div>\n\n            <!-- Button 2: Shine Effect -->\n            <div class=\"flex items-center justify-center p-8\">\n                <button class=\"group relative px-8 py-4 bg-gradient-to-r from-cyan-500 to-blue-600 rounded-xl font-bold text-white overflow-hidden transform transition-all duration-300 hover:scale-110\">\n                    <span class=\"relative z-10\">Shine Effect</span>\n                    <div class=\"absolute inset-0 w-1/4 h-full bg-gradient-to-r from-transparent via-white to-transparent opacity-0 group-hover:opacity-30 transform -skew-x-12 group-hover:translate-x-[400%] transition-all duration-700\"></div>\n                </button>\n            </div>\n\n            <!-- Button 3: Border Animation -->\n            <div class=\"flex items-center justify-center p-8\">\n                <button class=\"group relative px-8 py-4 bg-slate-800 rounded-xl font-bold text-white overflow-hidden transform transition-all duration-300 hover:scale-110\">\n                    <span class=\"relative z-10\">Border Animate</span>\n                    <div class=\"absolute inset-0 rounded-xl border-2 border-transparent group-hover:border-emerald-500 transition-all duration-300\"></div>\n                    <div class=\"absolute inset-0 bg-gradient-to-r from-emerald-500 to-teal-500 opacity-0 group-hover:opacity-20 transition-opacity duration-300\"></div>\n                </button>\n            </div>\n\n            <!-- Button 4: 3D Push -->\n            <div class=\"flex items-center justify-center p-8\">\n                <button class=\"px-8 py-4 bg-gradient-to-br from-orange-500 to-red-600 rounded-xl font-bold text-white shadow-[0_8px_0_rgb(185,28,28)] transform transition-all duration-100 hover:shadow-[0_4px_0_rgb(185,28,28)] hover:translate-y-1 active:shadow-[0_0_0_rgb(185,28,28)] active:translate-y-2\">\n                    3D Push\n                </button>\n            </div>\n\n            <!-- Button 5: Neon Pulse -->\n            <div class=\"flex items-center justify-center p-8\">\n                <button class=\"px-8 py-4 bg-transparent border-2 border-pink-500 rounded-xl font-bold text-pink-500 shadow-[0_0_20px_rgba(236,72,153,0.3)] hover:shadow-[0_0_40px_rgba(236,72,153,0.6)] hover:bg-pink-500 hover:text-white transform transition-all duration-300 hover:scale-110 animate-pulse\">\n                    Neon Pulse\n                </button>\n            </div>\n\n            <!-- Button 6: Slide Fill -->\n            <div class=\"flex items-center justify-center p-8\">\n                <button class=\"group relative px-8 py-4 border-2 border-indigo-500 rounded-xl font-bold text-indigo-500 overflow-hidden transform transition-all duration-300 hover:text-white hover:scale-110\">\n                    <span class=\"relative z-10\">Slide Fill</span>\n                    <div class=\"absolute inset-0 bg-indigo-500 transform translate-y-full group-hover:translate-y-0 transition-transform duration-300\"></div>\n                </button>\n            </div>\n\n            <!-- Button 7: Glassmorphism -->\n            <div class=\"flex items-center justify-center p-8\">\n                <button class=\"px-8 py-4 backdrop-blur-xl bg-white/10 border border-white/20 rounded-xl font-bold text-white shadow-xl transform transition-all duration-300 hover:bg-white/20 hover:scale-110\">\n                    Glass Button\n                </button>\n            </div>\n\n            <!-- Button 8: Split Color -->\n            <div class=\"flex items-center justify-center p-8\">\n                <button class=\"group relative px-8 py-4 bg-slate-800 rounded-xl font-bold text-white overflow-hidden transform transition-all duration-300 hover:scale-110\">\n                    <span class=\"relative z-10\">Split Color</span>\n                    <div class=\"absolute inset-0 flex\">\n                        <div class=\"w-1/2 bg-purple-600 transform -translate-x-full group-hover:translate-x-0 transition-transform duration-300\"></div>\n                        <div class=\"w-1/2 bg-pink-600 transform translate-x-full group-hover:translate-x-0 transition-transform duration-300\"></div>\n                    </div>\n                </button>\n            </div>\n\n            <!-- Button 9: Ripple Effect (CSS only) -->\n            <div class=\"flex items-center justify-center p-8\">\n                <button class=\"group relative px-8 py-4 bg-gradient-to-r from-teal-500 to-emerald-600 rounded-xl font-bold text-white overflow-hidden transform transition-all duration-300 hover:scale-110\">\n                    <span class=\"relative z-10\">Ripple Effect</span>\n                    <div class=\"absolute inset-0 bg-white opacity-0 group-hover:opacity-20 rounded-full transform scale-0 group-hover:scale-150 transition-all duration-500\"></div>\n                </button>\n            </div>\n\n            <!-- Button 10: Gradient Border -->\n            <div class=\"flex items-center justify-center p-8\">\n                <div\n                    class=\"relative p-[2px] bg-gradient-to-r from-purple-500 via-pink-500 to-red-500 rounded-xl transform transition-all duration-300 hover:scale-110 hover:shadow-[0_0_30px_rgba(168,85,247,0.5)]\">\n                    <button class=\"px-8 py-4 bg-slate-900 rounded-xl font-bold text-white\">\n                        Gradient Border\n                    </button>\n                </div>\n            </div>\n\n            <!-- Button 11: Icon Slide -->\n            <div class=\"flex items-center justify-center p-8\">\n                <button class=\"group px-8 py-4 bg-gradient-to-r from-yellow-500 to-orange-600 rounded-xl font-bold text-white flex items-center gap-2 overflow-hidden transform transition-all duration-300 hover:scale-110\">\n                    <span>Icon Slide</span>\n                    <svg class=\"w-5 h-5 transform transition-transform duration-300 group-hover:translate-x-2\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 7l5 5m0 0l-5 5m5-5H6\"></path>\n                    </svg>\n                </button>\n            </div>\n\n            <!-- Button 12: Double Border -->\n            <div class=\"flex items-center justify-center p-8\">\n                <button class=\"px-8 py-4 border-4 border-double border-cyan-500 rounded-xl font-bold text-cyan-500 transform transition-all duration-300 hover:border-cyan-400 hover:text-cyan-400 hover:scale-110 hover:rotate-2\">\n                    Double Border\n                </button>\n            </div>\n\n        </div>\n    </div>\n\n</body>"
