      "content": "/**\n * Component: Premium Button Collection with 12 Unique Animations\n * Author: @lulu-berlu (https://tailwindflex.com/@lulu-berlu)\n * Source: https://tailwindflex.com/@lulu-berlu/premium-button-collection-with-12-unique-animations\n * Attribution: Créé par @lulu-berlu sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function PremiumButtonCollectionWith12UniqueAnimations() {\n  return (\n    <div>\n    <body className=\"min-h-screen bg-slate-900 p-8 flex items-center justify-center\">\n    \n        <div className=\"max-w-4xl mx-auto\">\n            <div className=\"grid grid-cols-1 md2 gap-8\">\n    \n                \n                <div className=\"flex items-center justify-center p-8\">\n                    <button className=\"group relative px-8 py-4 bg-gradient-to-r from-purple-600 to-pink-600 rounded-xl font-bold text-white overflow-hidden transform transition-all duration-300 hover110 hover[0_0_40px_rgba(168,85,247,0.6)]\">\n                        <span className=\"relative z-10\">Glow Effect</span>\n                        <div className=\"absolute inset-0 bg-gradient-to-r from-pink-600 to-purple-600 opacity-0 group-hover100 transition-opacity duration-300\"></div>\n                    </button>\n                </div>\n    \n                \n                <div className=\"flex items-center justify-center p-8\">\n                    <button className=\"group relative px-8 py-4 bg-gradient-to-r from-cyan-500 to-blue-600 rounded-xl font-bold text-white overflow-hidden transform transition-all duration-300 hover110\">\n                        <span className=\"relative z-10\">Shine Effect</span>\n                        <div className=\"absolute inset-0 w-1/4 h-full bg-gradient-to-r from-transparent via-white to-transparent opacity-0 group-hover30 transform -skew-x-12 group-hover[400%] transition-all duration-700\"></div>\n                    </button>\n                </div>\n    \n                \n                <div className=\"flex items-center justify-center p-8\">\n                    <button className=\"group relative px-8 py-4 bg-slate-800 rounded-xl font-bold text-white overflow-hidden transform transition-all duration-300 hover110\">\n                        <span className=\"relative z-10\">Border Animate</span>\n                        <div className=\"absolute inset-0 rounded-xl border-2 border-transparent group-hover500 transition-all duration-300\"></div>\n                        <div className=\"absolute inset-0 bg-gradient-to-r from-emerald-500 to-teal-500 opacity-0 group-hover20 transition-opacity duration-300\"></div>\n                    </button>\n                </div>\n    \n                \n                <div className=\"flex items-center justify-center p-8\">\n                    <button className=\"px-8 py-4 bg-gradient-to-br from-orange-500 to-red-600 rounded-xl font-bold text-white shadow-[0_8px_0_rgb(185,28,28)] transform transition-all duration-100 hover[0_4px_0_rgb(185,28,28)] hover1 active[0_0_0_rgb(185,28,28)] active2\">\n                        3D Push\n                    </button>\n                </div>\n    \n                \n                <div className=\"flex items-center justify-center p-8\">\n                    <button className=\"px-8 py-4 bg-transparent border-2 border-pink-500 rounded-xl font-bold text-pink-500 shadow-[0_0_20px_rgba(236,72,153,0.3)] hover[0_0_40px_rgba(236,72,153,0.6)] hover500 hover transform transition-all duration-300 hover110 animate-pulse\">\n                        Neon Pulse\n                    </button>\n                </div>\n    \n                \n                <div className=\"flex items-center justify-center p-8\">\n                    <button className=\"group relative px-8 py-4 border-2 border-indigo-500 rounded-xl font-bold text-indigo-500 overflow-hidden transform transition-all duration-300 hover hover110\">\n                        <span className=\"relative z-10\">Slide Fill</span>\n                        <div className=\"absolute inset-0 bg-indigo-500 transform translate-y-full group-hover0 transition-transform duration-300\"></div>\n                    </button>\n                </div>\n    \n                \n                <div className=\"flex items-center justify-center p-8\">\n                    <button className=\"px-8 py-4 backdrop-blur-xl bg-white/10 border border-white/20 rounded-xl font-bold text-white shadow-xl transform transition-all duration-300 hover/20 hover110\">\n                        Glass Button\n                    </button>\n                </div>\n    \n                \n                <div className=\"flex items-center justify-center p-8\">\n                    <button className=\"group relative px-8 py-4 bg-slate-800 rounded-xl font-bold text-white overflow-hidden transform transition-all duration-300 hover110\">\n                        <span className=\"relative z-10\">Split Color</span>\n                        <div className=\"absolute inset-0 flex\">\n                            <div className=\"w-1/2 bg-purple-600 transform -translate- group-hover0 transition-transform duration-300\"></div>\n                            <div className=\"w-1/2 bg-pink-600 transform translate- group-hover0 transition-transform duration-300\"></div>\n                        </div>\n                    </button>\n                </div>\n    \n                \n                <div className=\"flex items-center justify-center p-8\">\n                    <button className=\"group relative px-8 py-4 bg-gradient-to-r from-teal-500 to-emerald-600 rounded-xl font-bold text-white overflow-hidden transform transition-all duration-300 hover110\">\n                        <span className=\"relative z-10\">Ripple Effect</span>\n                        <div className=\"absolute inset-0 bg-white opacity-0 group-hover20 rounded-full transform scale-0 group-hover150 transition-all duration-500\"></div>\n                    </button>\n                </div>\n    \n                \n                <div className=\"flex items-center justify-center p-8\">\n                    <div\n                        className=\"relative p-[2px] bg-gradient-to-r from-purple-500 via-pink-500 to-red-500 rounded-xl transform transition-all duration-300 hover110 hover[0_0_30px_rgba(168,85,247,0.5)]\">\n                        <button className=\"px-8 py-4 bg-slate-900 rounded-xl font-bold text-white\">\n                            Gradient Border\n                        </button>\n                    </div>\n                </div>\n    \n                \n                <div className=\"flex items-center justify-center p-8\">\n                    <button className=\"group px-8 py-4 bg-gradient-to-r from-yellow-500 to-orange-600 rounded-xl font-bold text-white flex items-center gap-2 overflow-hidden transform transition-all duration-300 hover110\">\n                        <span>Icon Slide</span>\n                        <svg className=\"w-5 h-5 transform transition-transform duration-300 group-hover2\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"M13 7l5 5m0 0l-5 5m5-5H6\"></path>\n                        </svg>\n                    </button>\n                </div>\n    \n                \n                <div className=\"flex items-center justify-center p-8\">\n                    <button className=\"px-8 py-4 border-4 border-double border-cyan-500 rounded-xl font-bold text-cyan-500 transform transition-all duration-300 hover400 hover400 hover110 hover2\">\n                        Double Border\n                    </button>\n                </div>\n    \n            </div>\n        </div>\n    \n    </body>\n    </div>\n  );\n}\n",
