      "content": "/**\n * Component: Tailwind Header\n * Author: @anonymous (https://tailwindflex.com/@anonymous)\n * Source: https://tailwindflex.com/@anonymous/tailwind-header\n * Attribution: Créé par @anonymous sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function TailwindHeader() {\n  return (\n    <div>\n    <header className=\"bg-white shadow-lg py-4 sticky top-0 z-50\">\n      <div className=\"container mx-auto flex items-center justify-between px-4\">\n        \n        <a href=\"#\" className=\"flex items-center text-primary hover\">\n          <svg className=\"h-8 w-8 mr-2\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\"\n              d=\"M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707.707m12.728 0l.707.707M6.343 17.657l.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z\" />\n          </svg>\n          <span className=\"text-2xl font-bold\">MyBrand</span>\n        </a>\n    \n        \n        <div className=\"md\">\n          <button id=\"menu-toggle\"\n                        className=\"text-gray-800 hover focus transition-colors duration-300\">\n                    <svg className=\"h-6 w-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"M4 6h16M4 12h16m-7 6h7\"/>\n                    </svg>\n                </button>\n        </div>\n    \n        \n        <nav className=\"hidden md\">\n          <ul className=\"flex space-x-8\">\n            <li><a href=\"#\" className=\"hover transition-colors duration-300\">Home</a></li>\n            <li><a href=\"#\" className=\"hover transition-colors duration-300\">About</a></li>\n            <li className=\"group relative\">\n              <a href=\"#\" className=\"hover transition-colors duration-300\">Services</a>\n              \n              <ul\n                className=\"absolute left-0 hidden group-hover bg-white shadow-md py-2 mt-1 rounded-md w-48 transition-all duration-300\">\n                <li><a href=\"#\" className=\"block px-4 py-2 hover100\">Service 1</a></li>\n                <li><a href=\"#\" className=\"block px-4 py-2 hover100\">Service 2</a></li>\n                <li><a href=\"#\" className=\"block px-4 py-2 hover100\">Service 3</a></li>\n              </ul>\n            </li>\n            <li><a href=\"#\" className=\"hover transition-colors duration-300\">Contact</a></li>\n            <li><a href=\"#\"\n                className=\"bg-primary hover text-white px-4 py-2 rounded-md transition-colors duration-300\">Get\n                Started</a></li>\n          </ul>\n        </nav>\n      </div>\n    \n      \n      <nav id=\"mobile-menu\"\n        className=\"hidden md bg-gray-50 border-t border-gray-200 transition-height duration-300 ease-in-out\">\n        <ul className=\"px-4 py-2\">\n          <li><a href=\"#\" className=\"block py-2 hover\">Home</a></li>\n          <li><a href=\"#\" className=\"block py-2 hover\">About</a></li>\n          <li>\n            <a href=\"#\" id=\"services-dropdown-toggle\" className=\"block py-2 hover\">Services</a>\n            \n            <ul id=\"services-dropdown\" className=\"hidden pl-4\">\n              <li><a href=\"#\" className=\"block py-2 hover\">Service 1</a></li>\n              <li><a href=\"#\" className=\"block py-2 hover\">Service 2</a></li>\n              <li><a href=\"#\" className=\"block py-2 hover\">Service 3</a></li>\n            </ul>\n          </li>\n          <li><a href=\"#\" className=\"block py-2 hover\">Contact</a></li>\n          <li><a href=\"#\"\n              className=\"block py-2 bg-primary hover text-white rounded-md text-center transition-colors duration-300\">Get\n              Started</a></li>\n        </ul>\n      </nav>\n    </header>\n    \n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
