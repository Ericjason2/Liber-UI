      "content": "/**\n * Component: Default phone input\n * Author: @tofayel-islam (https://tailwindflex.com/@tofayel-islam)\n * Source: https://tailwindflex.com/@tofayel-islam/default-phone-input\n * Attribution: Créé par @tofayel-islam sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function DefaultPhoneInput() {\n  return (\n    <div>\n    <div className=\"h-screen w-full flex justify-center items-center dark800\">\n        <form className=\"max-w-sm mx-auto\">\n            <label htmlFor=\"phone-input\" className=\"block mb-2 text-sm font-medium text-gray-900 dark\">Phone number:</label>\n            <div className=\"relative\">\n                <div className=\"absolute inset-y-0 start-0 top-0 flex items-center ps-3.5 pointer-events-none\">\n                    <svg className=\"w-4 h-4 text-gray-500 dark400\" aria-hidden=\"true\"\n                        xmlns=\"http://www.w3.org/2000/svg\" fill=\"currentColor\" viewBox=\"0 0 19 18\">\n                        <path\n                            d=\"M18 13.446a3.02 3.02 0 0 0-.946-1.985l-1.4-1.4a3.054 3.054 0 0 0-4.218 0l-.7.7a.983.983 0 0 1-1.39 0l-2.1-2.1a.983.983 0 0 1 0-1.389l.7-.7a2.98 2.98 0 0 0 0-4.217l-1.4-1.4a2.824 2.824 0 0 0-4.218 0c-3.619 3.619-3 8.229 1.752 12.979C6.785 16.639 9.45 18 11.912 18a7.175 7.175 0 0 0 5.139-2.325A2.9 2.9 0 0 0 18 13.446Z\" />\n                    </svg>\n                </div>\n                <input type=\"text\" id=\"phone-input\" aria-describedby=\"helper-text-explanation\" className=\"bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus500 focus500 block w-full ps-10 p-2.5  dark700 dark600 dark400 dark dark500 dark500\" pattern=\"[0-9]{3}-[0-9]{3}-[0-9]{4}\" placeholder=\"123-456-7890\" required />\n            </div>\n            <p id=\"helper-text-explanation\" className=\"mt-2 text-sm text-gray-500 dark400\">Select a phone number that\n                matches the format.</p>\n        </form>\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
