      "content": "import * as React from \"react\"\n\nfunction Navbar({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"navbar\"\n      className={className}\n      {...props}\n    >\n      <div className=\"top-0 py-1 lg:py-2 w-full bg-transparent lg:relative z-50 dark:bg-gray-900\">\n          <nav className=\"z-10 sticky top-0 left-0 right-0 max-w-4xl xl:max-w-5xl mx-auto px-5 py-2.5 lg:border-none lg:py-4\">\n              <div className=\"flex items-center justify-between\">\n                  <button>\n                      <div className=\"flex items-center space-x-2\">\n                          <h2 className=\"text-black dark:text-white font-bold text-2xl\">Company</h2>\n                      </div>\n                  </button>\n                  <div className=\"hidden lg:block\">\n                      <ul className=\"flex space-x-10 text-base font-bold text-black/60 dark:text-white\">\n                          <li\n                              className=\"hover:underline hover:underline-offset-4 hover:w-fit transition-all duration-100 ease-linear\">\n                              <a href=\"#\">Home</a>\n                          </li>\n                          <li\n                              className=\"hover:underline hover:underline-offset-4 hover:w-fit transition-all duration-100 ease-linear\">\n                              <a href=\"#\">Our services</a>\n                          </li>\n                          <li\n                              className=\"hover:underline hover:underline-offset-4 hover:w-fit transition-all duration-100 ease-linear\">\n                              <a href=\"#\">About</a>\n                          </li>\n                          <li\n                              className=\"hover:underline hover:underline-offset-4 hover:w-fit transition-all duration-100 ease-linear\">\n                              <a href=\"#\">Contact</a>\n                          </li>\n                      </ul>\n                  </div>\n                  <div className=\"hidden lg:flex lg:items-center gap-x-2\">\n                      <button className=\"flex items-center text-black dark:text-white justify-center px-6 py-2.5 font-semibold\">Sign up</button>\n                      <button className=\"flex items-center justify-center rounded-md bg-[#4A3BFF] text-white px-6 py-2.5 font-semibold hover:shadow-lg hover:drop-shadow transition duration-200\">Login</button>\n                  </div>\n                  <div className=\"flex items-center justify-center lg:hidden\">\n                      <button className=\"focus:outline-none text-slate-200 dark:text-white\"><svg stroke=\"currentColor\" fill=\"currentColor\" strokeWidth=\"0\" viewBox=\"0 0 20 20\" aria-hidden=\"true\" className=\"text-2xl text-slate-800 dark:text-white focus:outline-none active:scale-110 active:text-red-500\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><path fillRule=\"evenodd\" d=\"M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM9 15a1 1 0 011-1h6a1 1 0 110 2h-6a1 1 0 01-1-1z\" clipRule=\"evenodd\"></path></svg></button>\n                  </div>\n              </div>\n          </nav>\n      </div>\n    </div>\n  )\n}\n\nexport { Navbar }\n",
