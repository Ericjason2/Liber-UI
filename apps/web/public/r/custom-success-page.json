    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Site Created Successfully</title>\n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <!-- Font Awesome Icons -->\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n    <!-- Google Fonts -->\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n    \n    <style>\n        * {\n            font-family: 'Inter', sans-serif;\n        }\n        \n        .success-green {\n            color: #10b981;\n        }\n        \n        .success-green-bg {\n            background-color: #10b981;\n        }\n    </style>\n</head>\n<body class=\"min-h-screen bg-gray-50 flex items-center justify-center p-4\">\n    <div class=\"max-w-2xl w-full\">\n        <div class=\"bg-white rounded-2xl shadow-lg p-8 md:p-12\">\n            <!-- Header with Icon -->\n            <div class=\"text-center mb-8\">\n                <div class=\"success-green-bg inline-flex items-center justify-center w-16 h-16 rounded-full mb-4\">\n                    <i class=\"fas fa-check text-white text-2xl\"></i>\n                </div>\n                <h1 class=\"text-3xl md:text-4xl font-bold text-gray-800 mb-2\">\n                    Site Created Successfully! 🎉\n                </h1>\n                <p class=\"text-gray-600 text-lg\">\n                    This is the default index.html page\n                </p>\n            </div>\n            \n            <!-- Content -->\n            <div class=\"space-y-6 mb-8\">\n                <div class=\"flex items-start\">\n                    <i class=\"fas fa-info-circle success-green mt-1 mr-3\"></i>\n                    <div>\n                        <h3 class=\"font-semibold text-gray-800 mb-1\">Automatically Generated</h3>\n                        <p class=\"text-gray-600\">This page was automatically generated by the system.</p>\n                    </div>\n                </div>\n                \n                <div class=\"flex items-start\">\n                    <i class=\"fas fa-folder success-green mt-1 mr-3\"></i>\n                    <div>\n                        <h3 class=\"font-semibold text-gray-800 mb-1\">Location</h3>\n                        <p class=\"text-gray-600\">The index.html file is located in your site's root directory.</p>\n                    </div>\n                </div>\n                \n                <div class=\"flex items-start\">\n                    <i class=\"fas fa-edit success-green mt-1 mr-3\"></i>\n                    <div>\n                        <h3 class=\"font-semibold text-gray-800 mb-1\">Customization</h3>\n                        <p class=\"text-gray-600\">You can modify, delete, or overwrite this page with your own content.</p>\n                    </div>\n                </div>\n            </div>\n            \n            <!-- Action Button -->\n            <div class=\"text-center\">\n                <a href=\"#\" \n                   class=\"inline-flex items-center success-green-bg text-white font-semibold py-3 px-6 rounded-lg hover:bg-emerald-600 transition duration-200\">\n                    <i class=\"fas fa-rocket mr-2\"></i> Start Building Your Site\n                </a>\n            </div>\n            \n            <!-- Footer -->\n            <div class=\"mt-8 pt-6 border-t border-gray-200 text-center\">\n                <p class=\"text-gray-500 text-sm\">\n                    <i class=\"fas fa-cog mr-1\"></i>\n                    Powered by Nginx •\n                    <span id=\"current-year\"></span>\n                </p>\n            </div>\n        </div>\n    </div>\n\n    <script>\n        // Set current year\n        document.getElementById('current-year').textContent = new Date().getFullYear();\n    </script>\n</body>\n</html>"
