  <article\n          class=\"flex rounded-[26px] border border-line bg-surface p-6 shadow-soft sm:p-7\"\n        >\n          <div class=\"flex w-full flex-col\">\n            <div>\n              <div\n                class=\"flex h-11 w-11 items-center justify-center rounded-xl bg-navySoft text-navy\"\n              >\n                <svg\n                  class=\"h-5 w-5\"\n                  fill=\"none\"\n                  viewBox=\"0 0 24 24\"\n                  stroke=\"currentColor\"\n                >\n                  <path\n                    stroke-linecap=\"round\"\n                    stroke-linejoin=\"round\"\n                    stroke-width=\"1.8\"\n                    d=\"M12 3v18m9-9H3\"\n                  />\n                </svg>\n              </div>\n              <h2 class=\"mt-5 text-xl font-semibold\">\n                Starter\n              </h2>\n              <p class=\"mt-2 min-h-[48px] text-sm leading-6 text-muted\">\n                Everything you need to organize personal projects and small workflows.\n              </p>\n            </div>\n            <div class=\"mt-7\">\n              <div class=\"flex items-end gap-1\">\n                <span\n                  class=\"price text-4xl font-semibold tracking-tight\"\n                  data-monthly=\"12\"\n                  data-yearly=\"10\"\n                >\n                  $12\n                </span>\n                <span class=\"mb-1 text-sm text-muted\">\n                  / month\n                </span>\n              </div>\n              <p class=\"billing-copy mt-2 text-xs text-muted\">\n                Billed monthly\n              </p>\n            </div>\n            <button\n              type=\"button\"\n              class=\"mt-7 w-full rounded-xl border border-line bg-white px-5 py-3 text-sm font-semibold transition hover:border-navy/30 hover:bg-navySoft\"\n            >\n              Start free\n            </button>\n            <div class=\"my-7 h-px bg-line\"></div>\n            <div class=\"flex-1\">\n              <p class=\"text-sm font-semibold\">\n                Includes\n              </p>\n              <ul class=\"mt-5 space-y-4\">\n                <li class=\"flex items-start gap-3\">\n                  <span class=\"mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-navySoft text-navy\">\n                    <svg class=\"h-3 w-3\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.2\" d=\"M5 13l4 4L19 7\" />\n                    </svg>\n                  </span>\n                  <span class=\"text-sm text-muted\">Up to 3 projects</span>\n                </li>\n                <li class=\"flex items-start gap-3\">\n                  <span class=\"mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-navySoft text-navy\">\n                    <svg class=\"h-3 w-3\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.2\" d=\"M5 13l4 4L19 7\" />\n                    </svg>\n                  </span>\n                  <span class=\"text-sm text-muted\">5 GB file storage</span>\n                </li>\n                <li class=\"flex items-start gap-3\">\n                  <span class=\"mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-navySoft text-navy\">\n                    <svg class=\"h-3 w-3\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.2\" d=\"M5 13l4 4L19 7\" />\n                    </svg>\n                  </span>\n                  <span class=\"text-sm text-muted\">Basic analytics</span>\n                </li>\n                <li class=\"flex items-start gap-3\">\n                  <span class=\"mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-navySoft text-navy\">\n                    <svg class=\"h-3 w-3\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.2\" d=\"M5 13l4 4L19 7\" />\n                    </svg>\n                  </span>\n                  <span class=\"text-sm text-muted\">Email support</span>\n                </li>\n              </ul>\n            </div>\n          </div>\n        </article>\n        <article\n          class=\"relative flex overflow-hidden rounded-[26px] border-2 border-navy bg-surface p-6 shadow-featured sm:p-7\"\n        >\n          <div\n            class=\"absolute right-5 top-5 rounded-full bg-clay px-3 py-1 text-[10px] font-bold uppercase tracking-[0.14em] text-white\"\n          >\n            Most popular\n          </div>\n          <div class=\"flex w-full flex-col\">\n            <div>\n              <div\n                class=\"flex h-11 w-11 items-center justify-center rounded-xl bg-navy text-white\"\n              >\n                <svg\n                  class=\"h-5 w-5\"\n                  fill=\"none\"\n                  viewBox=\"0 0 24 24\"\n                  stroke=\"currentColor\"\n                >\n                  <path\n                    stroke-linecap=\"round\"\n                    stroke-linejoin=\"round\"\n                    stroke-width=\"1.8\"\n                    d=\"M4.5 19.5l5.25-15 4.5 9 5.25-3-5.25 9h-9.75z\"\n                  />\n                </svg>\n              </div>\n              <h2 class=\"mt-5 text-xl font-semibold\">\n                Pro\n              </h2>\n              <p class=\"mt-2 min-h-[48px] text-sm leading-6 text-muted\">\n                Advanced tools for growing teams managing multiple projects.\n              </p>\n            </div>\n            <div class=\"mt-7\">\n              <div class=\"flex items-end gap-1\">\n                <span\n                  class=\"price text-4xl font-semibold tracking-tight\"\n                  data-monthly=\"29\"\n                  data-yearly=\"23\"\n                >\n                  $29\n                </span>\n                <span class=\"mb-1 text-sm text-muted\">\n                  / month\n                </span>\n              </div>\n              <p class=\"billing-copy mt-2 text-xs text-muted\">\n                Billed monthly\n              </p>\n            </div>\n            <button\n              type=\"button\"\n              class=\"mt-7 w-full rounded-xl bg-navy px-5 py-3 text-sm font-semibold text-white transition hover:bg-navyDark focus:outline-none focus:ring-4 focus:ring-navySoft\"\n            >\n              Start 14-day trial\n            </button>\n            <div class=\"my-7 h-px bg-line\"></div>\n            <div class=\"flex-1\">\n              <p class=\"text-sm font-semibold\">\n                Everything in Starter, plus\n              </p>\n              <ul class=\"mt-5 space-y-4\">\n                <li class=\"flex items-start gap-3\">\n                  <span class=\"mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-claySoft text-clay\">\n                    <svg class=\"h-3 w-3\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.2\" d=\"M5 13l4 4L19 7\" />\n                    </svg>\n                  </span>\n                  <span class=\"text-sm text-muted\">Unlimited projects</span>\n                </li>\n                <li class=\"flex items-start gap-3\">\n                  <span class=\"mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-claySoft text-clay\">\n                    <svg class=\"h-3 w-3\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.2\" d=\"M5 13l4 4L19 7\" />\n                    </svg>\n                  </span>\n                  <span class=\"text-sm text-muted\">100 GB file storage</span>\n                </li>\n                <li class=\"flex items-start gap-3\">\n                  <span class=\"mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-claySoft text-clay\">\n                    <svg class=\"h-3 w-3\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.2\" d=\"M5 13l4 4L19 7\" />\n                    </svg>\n                  </span>\n                  <span class=\"text-sm text-muted\">Advanced reporting</span>\n                </li>\n                <li class=\"flex items-start gap-3\">\n                  <span class=\"mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-claySoft text-clay\">\n                    <svg class=\"h-3 w-3\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.2\" d=\"M5 13l4 4L19 7\" />\n                    </svg>\n                  </span>\n                  <span class=\"text-sm text-muted\">Automations & integrations</span>\n                </li>\n                <li class=\"flex items-start gap-3\">\n                  <span class=\"mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-claySoft text-clay\">\n                    <svg class=\"h-3 w-3\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.2\" d=\"M5 13l4 4L19 7\" />\n                    </svg>\n                  </span>\n                  <span class=\"text-sm text-muted\">Priority support</span>\n                </li>\n              </ul>\n            </div>\n          </div>\n        </article>\n        <article\n          class=\"flex rounded-[26px] border border-line bg-surface p-6 shadow-soft sm:p-7\"\n        >\n          <div class=\"flex w-full flex-col\">\n            <div>\n              <div\n                class=\"flex h-11 w-11 items-center justify-center rounded-xl bg-claySoft text-clay\"\n              >\n                <svg\n                  class=\"h-5 w-5\"\n                  fill=\"none\"\n                  viewBox=\"0 0 24 24\"\n                  stroke=\"currentColor\"\n                >\n                  <path\n                    stroke-linecap=\"round\"\n                    stroke-linejoin=\"round\"\n                    stroke-width=\"1.8\"\n                    d=\"M3.75 21h16.5M5.25 21V5.25A2.25 2.25 0 017.5 3h9a2.25 2.25 0 012.25 2.25V21M9 7.5h1.5M13.5 7.5H15M9 11.25h1.5M13.5 11.25H15M9 15h1.5M13.5 15H15\"\n                  />\n                </svg>\n              </div>\n              <h2 class=\"mt-5 text-xl font-semibold\">\n                Business\n              </h2>\n              <p class=\"mt-2 min-h-[48px] text-sm leading-6 text-muted\">\n                Greater control, security and support for established organizations.\n              </p>\n            </div>\n            <div class=\"mt-7\">\n              <div class=\"flex items-end gap-1\">\n                <span\n                  class=\"price text-4xl font-semibold tracking-tight\"\n                  data-monthly=\"59\"\n                  data-yearly=\"47\"\n                >\n                  $59\n                </span>\n                <span class=\"mb-1 text-sm text-muted\">\n                  / month\n                </span>\n              </div>\n              <p class=\"billing-copy mt-2 text-xs text-muted\">\n                Billed monthly\n              </p>\n            </div>\n            <button\n              type=\"button\"\n              class=\"mt-7 w-full rounded-xl border border-line bg-white px-5 py-3 text-sm font-semibold transition hover:border-clay/40 hover:bg-claySoft\"\n            >\n              Choose Business\n            </button>\n            <div class=\"my-7 h-px bg-line\"></div>\n            <div class=\"flex-1\">\n              <p class=\"text-sm font-semibold\">\n                Everything in Pro, plus\n              </p>\n              <ul class=\"mt-5 space-y-4\">\n                <li class=\"flex items-start gap-3\">\n                  <span class=\"mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-claySoft text-clay\">\n                    <svg class=\"h-3 w-3\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.2\" d=\"M5 13l4 4L19 7\" />\n                    </svg>\n                  </span>\n                  <span class=\"text-sm text-muted\">Unlimited team members</span>\n                </li>\n                <li class=\"flex items-start gap-3\">\n                  <span class=\"mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-claySoft text-clay\">\n                    <svg class=\"h-3 w-3\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.2\" d=\"M5 13l4 4L19 7\" />\n                    </svg>\n                  </span>\n                  <span class=\"text-sm text-muted\">500 GB storage</span>\n                </li>\n                <li class=\"flex items-start gap-3\">\n                  <span class=\"mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-claySoft text-clay\">\n                    <svg class=\"h-3 w-3\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.2\" d=\"M5 13l4 4L19 7\" />\n                    </svg>\n                  </span>\n                  <span class=\"text-sm text-muted\">Advanced permissions</span>\n                </li>\n                <li class=\"flex items-start gap-3\">\n                  <span class=\"mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-claySoft text-clay\">\n                    <svg class=\"h-3 w-3\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.2\" d=\"M5 13l4 4L19 7\" />\n                    </svg>\n                  </span>\n                  <span class=\"text-sm text-muted\">Audit logs & security controls</span>\n                </li>\n                <li class=\"flex items-start gap-3\">\n                  <span class=\"mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-claySoft text-clay\">\n                    <svg class=\"h-3 w-3\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.2\" d=\"M5 13l4 4L19 7\" />\n                    </svg>\n                  </span>\n                  <span class=\"text-sm text-muted\">Dedicated support</span>\n                </li>\n              </ul>\n            </div>\n          </div>\n        </article>\n      </div>\n      <div class=\"mt-8 flex flex-col items-center justify-between gap-4 rounded-2xl border border-line bg-surface px-5 py-4 sm:flex-row\">\n        <div class=\"flex items-start gap-3\">\n          <div class=\"mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-navySoft text-navy\">\n            <svg\n              class=\"h-4 w-4\"\n              fill=\"none\"\n              viewBox=\"0 0 24 24\"\n              stroke=\"currentColor\"\n            >\n              <path\n                stroke-linecap=\"round\"\n                stroke-linejoin=\"round\"\n                stroke-width=\"1.8\"\n                d=\"M12 6v6l4 2m5-2a9 9 0 11-18 0 9 9 0 0118 0z\"\n              />\n            </svg>\n          </div>\n          <div>\n            <p class=\"text-sm font-semibold\">\n              Need more time to decide?\n            </p>\n\n            <p class=\"mt-0.5 text-xs leading-5 text-muted\">\n              All paid plans include a 14-day free trial. No credit card required.\n            </p>\n          </div>\n        </div>\n        <button\n          type=\"button\"\n          class=\"shrink-0 text-sm font-semibold text-clay transition hover:text-clayDark\"\n        >\n          Compare all features →\n        </button>\n      </div>\n    </section>\n\n  <script>\n    const monthlyButton = document.getElementById(\"monthlyButton\");\n    const yearlyButton = document.getElementById(\"yearlyButton\");\n\n    const priceElements = document.querySelectorAll(\".price\");\n    const billingCopies = document.querySelectorAll(\".billing-copy\");\n\n    let billingType = \"monthly\";\n\n    function updateBilling(type) {\n\n      billingType = type;\n\n      const isMonthly = type === \"monthly\";\n\n      monthlyButton.setAttribute(\n        \"aria-pressed\",\n        isMonthly ? \"true\" : \"false\"\n      );\n\n      yearlyButton.setAttribute(\n        \"aria-pressed\",\n        isMonthly ? \"false\" : \"true\"\n      );\n\n      monthlyButton.classList.toggle(\"bg-navy\", isMonthly);\n      monthlyButton.classList.toggle(\"text-white\", isMonthly);\n\n      monthlyButton.classList.toggle(\"text-muted\", !isMonthly);\n\n\n      yearlyButton.classList.toggle(\"bg-navy\", !isMonthly);\n      yearlyButton.classList.toggle(\"text-white\", !isMonthly);\n\n      yearlyButton.classList.toggle(\"text-muted\", isMonthly);\n\n\n      priceElements.forEach(price => {\n\n        const newPrice =\n          isMonthly\n            ? price.dataset.monthly\n            : price.dataset.yearly;\n\n\n        animatePrice(price, newPrice);\n      });\n\n\n      billingCopies.forEach(copy => {\n\n        copy.textContent =\n          isMonthly\n            ? \"Billed monthly\"\n            : \"Billed annually · 20% saved\";\n\n      });\n    }\n\n    monthlyButton.addEventListener(\"click\", () => {\n      updateBilling(\"monthly\");\n    });\n\n    yearlyButton.addEventListener(\"click\", () => {\n      updateBilling(\"yearly\");\n    });\n\n    function animatePrice(element, newValue) {\n      element.classList.add(\n        \"opacity-40\",\n        \"translate-y-1\"\n      );\n\n      setTimeout(() => {\n\n        element.textContent =\n          `$${newValue}`;\n\n        element.classList.remove(\n          \"opacity-40\",\n          \"translate-y-1\"\n        );\n\n      }, 140);\n    }\n\n    updateBilling(\"monthly\");\n  </script>"
  }
}
