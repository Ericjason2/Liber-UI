    "rawHtml": "<!-- Icons from https://iconoir.com/ -->\n\n<!-- Page Content (For demo purposes) -->\n<div class=\"flex flex-col items-center gap-4 my-8 lg:ml-64\">\n\n  <!-- Home Page Content -->\n  <div id=\"home-view\" class=\"absolute flex flex-col items-center text-center gap-8 md:mx-8 lg:mx-32 mx-4 my-16 transition-opacity duration-500\">\n\n    <!-- Heading -->\n    <div class=\"flex flex-col items-center gap-2\">\n      <h1 class=\"text-3xl font-bold\">Elegant<br />NavBar + Drawer</h1>\n      <h2 class=\"text-xl opacity-50\">Ready-to-use Tailwind components. Pure CSS.</h2>\n    </div>\n\n    <!-- Button Container -->\n    <div class=\"flex flex-col items-center gap-4\">\n      <a class=\"btn btn-primary\"\n        href=\"https://tailwindflex.com/@nickgirga/elegant-navbar\"\n        target=\"_blank\"\n        rel=\"noreferrer noopener\">\n        NavBar Component\n      </a>\n\n      <a class=\"btn btn-secondary\"\n        href=\"https://tailwindflex.com/@nickgirga/elegant-animated-drawer-responsive\"\n        target=\"_blank\"\n        rel=\"noreferrer noopener\">\n        Drawer Component\n      </a>\n      \n      <a class=\"btn\"\n        href=\"https://tailwindflex.com/@nickgirga/elegant-buttons\"\n        target=\"_blank\"\n        rel=\"noreferrer noopener\">\n        Buttons\n      </a>\n    </div>\n\n  </div>\n\n  <!-- About Page Content -->\n  <div id=\"about-view\" class=\"absolute flex flex-col items-center text-center gap-8 md:mx-8 lg:mx-32 mx-4 my-16 transition-opacity duration-500 hidden\">\n\n    <!-- Heading -->\n    <div class=\"flex flex-col items-center gap-2\">\n      <h1 class=\"text-3xl font-bold\">About Elegant Components</h1>\n      <h2 class=\"text-xl opacity-50\">by Nicholas Girga</h2>\n    </div>\n\n    <!-- Text Content -->\n    <div class=\"flex flex-col items-center text-center gap-4\">\n      <span>\n        As I've developed more Tailwind components, I've found myself \n        borrowing a lot of my own favorite styles and color schemes. \n        As I release these components as individual bits and bobs on \n        TailwindFlex, the library of components I've developed that are \n        intended to be used together grows. You can find many of these \n        components individually on \n        <a class=\"link link-info\"\n          target=\"_blank\"\n          rel=\"noreferrer noopener\"\n          href=\"https://tailwindflex.com/@nickgirga\">\n          my TailwindFlex page\n        </a>\n        , usually prefixed with \"Elegant\".\n      </span>\n      <span>\n        Because so many components are being created around this similar \n        paradigm, I also figured it's probably time that I create a \n        repository to consolidate all of these similar styles. \n        I've decided to refer to it as PineUI. While you will still be \n        able to find all of PineUI's components on TailwindFlex, you can \n        also find a pre-built CSS file with all of PineUI's styles \n        in the PineUI repository. Note: this repository is still under \n        work.\n      </span>\n    </div>\n\n    <a class=\"btn btn-primary mb-8\"\n      href=\"https://gitlab.com/pineui/pineui\"\n      target=\"_blank\"\n      rel=\"noreferrer noopener\">\n      🌲 PineUI Repository\n    </a>\n\n  </div>\n\n</div>\n\n<!-- NavBar Container -->\n<div class=\"navbar top-0 fixed z-1 lg:ml-64\">\n  \n  <!-- Start Container -->\n  <div class=\"navbar-start-box\">\n    <!-- Menu Button -->\n    <label for=\"my-drawer\" class=\"btn btn-navbar p-2 block lg:hidden\">\n      <svg\n        width=\"24px\"\n        height=\"24px\"\n        stroke-width=\"1.5\"\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        xmlns=\"http://www.w3.org/2000/svg\"\n        color=\"currentColor\"\n        data-darkreader-inline-color=\"currentColor\"\n        style=\"--darkreader-inline-color: currentColor;\">\n        <path\n          d=\"M3 5H21\"\n          stroke=\"currentColor\"\n          stroke-width=\"1.5\"\n          stroke-linecap=\"round\"\n          stroke-linejoin=\"round\"\n          data-darkreader-inline-stroke=\"currentColor\"\n          style=\"--darkreader-inline-stroke: currentColor;\">\n        </path>\n        <path\n          d=\"M3 12H21\"\n          stroke=\"currentColor\"\n          stroke-width=\"1.5\"\n          stroke-linecap=\"round\"\n          stroke-linejoin=\"round\"\n          data-darkreader-inline-stroke=\"currentColor\"\n          style=\"--darkreader-inline-stroke: currentColor;\">\n        </path>\n        <path\n          d=\"M3 19H21\"\n          stroke=\"currentColor\"\n          stroke-width=\"1.5\"\n          stroke-linecap=\"round\"\n          stroke-linejoin=\"round\"\n          data-darkreader-inline-stroke=\"currentColor\"\n          style=\"--darkreader-inline-stroke: currentColor;\">\n        </path>\n      </svg>\n    </label>\n  </div>\n\n  <!-- Center Container -->\n  <div class=\"navbar-center-box\">\n    <!-- Title Button -->\n    <span id=\"page-title\" class=\"font-bold text-xl\">\n      Home\n    </span>\n  </div>\n\n  <!-- End Container -->\n  <div class=\"navbar-end-box\">\n    <!-- Settings Button -->\n    <button class=\"btn btn-navbar p-2\">\n      <svg\n        width=\"24px\"\n        height=\"24px\"\n        stroke-width=\"1.5\"\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        xmlns=\"http://www.w3.org/2000/svg\"\n        color=\"currentColor\"\n        data-darkreader-inline-color=\"currentColor\"\n        style=\"--darkreader-inline-color: currentColor;\">\n        <path\n          d=\"M12 15C13.6569 15 15 13.6569 15 12C15 10.3431 13.6569 9 12 9C10.3431 9 9 10.3431 9 12C9 13.6569 10.3431 15 12 15Z\"\n          stroke=\"currentColor\"\n          stroke-width=\"1.5\"\n          stroke-linecap=\"round\"\n          stroke-linejoin=\"round\"\n          data-darkreader-inline-stroke=\"currentColor\"\n          style=\"--darkreader-inline-stroke: currentColor;\">\n        </path>\n        <path\n          d=\"M19.6224 10.3954L18.5247 7.7448L20 6L18 4L16.2647 5.48295L13.5578 4.36974L12.9353 2H10.981L10.3491 4.40113L7.70441 5.51596L6 4L4 6L5.45337 7.78885L4.3725 10.4463L2 11V13L4.40111 13.6555L5.51575 16.2997L4 18L6 20L7.79116 18.5403L10.397 19.6123L11 22H13L13.6045 19.6132L16.2551 18.5155C16.6969 18.8313 18 20 18 20L20 18L18.5159 16.2494L19.6139 13.598L21.9999 12.9772L22 11L19.6224 10.3954Z\"\n          stroke=\"currentColor\"\n          stroke-width=\"1.5\"\n          stroke-linecap=\"round\"\n          stroke-linejoin=\"round\"\n          data-darkreader-inline-stroke=\"currentColor\"\n          style=\"--darkreader-inline-stroke: currentColor;\">\n        </path>\n      </svg>\n    </button>\n  </div>\n  \n</div>\n\n<!-- Sidebar -->\n<div>\n\n  <!-- Drawer Toggle -->\n  <input id=\"my-drawer\" type=\"checkbox\" class=\"peer appearance-none\" />\n\n  <!-- Dark Overlay / Dismiss when tapped off sidebar -->\n  <label for=\"my-drawer\" class=\"drawer-overlay\"></label>\n\n  <!-- Sidebar Content -->\n  <div class=\"drawer-sidebar lg:drawer-sidebar-open\">\n\n    <!-- Home Button -->\n    <div>\n      <!-- Mobile Button -->\n      <label class=\"btn btn-drawer-sidebar block lg:hidden\"\n        for=\"my-drawer\"\n        onclick=\"window.presentPage('home');\">\n        Home\n      </label>\n      <!-- Desktop Button -->\n      <button class=\"btn btn-drawer-sidebar lg:block w-full hidden\"\n        onclick=\"window.presentPage('home');\">\n        Home\n      </button>\n    </div>\n\n    <!-- About Button -->\n    <div>\n      <!-- Mobile Button -->\n      <label class=\"btn btn-drawer-sidebar block lg:hidden\"\n        for=\"my-drawer\"\n        onclick=\"window.presentPage('about');\">\n        About\n      </label>\n      <!-- Desktop Button -->\n      <button class=\"btn btn-drawer-sidebar lg:block w-full hidden\"\n        onclick=\"window.presentPage('about');\">\n        About\n      </button>\n    </div>\n\n  </div>\n\n</div>\n\n<!-- For demo purposes. Implement with framework of choice -->\n<!-- These are not real pages. They're just doc objects being hidden -->\n<script>\n  window.hidePage = function(pageObjName) {\n    const page = document.getElementById(pageObjName);\n    if (!page.classList.contains('hidden')) {\n      page.classList.add('hidden');\n    }\n  }\n\n  window.showPage = function(pageObjName) {\n    const page = document.getElementById(pageObjName);\n    if (page.classList.contains('hidden')) {\n      page.classList.remove('hidden');\n    }\n  }\n\n  window.presentPage = function(page) {\n    switch (page) {\n      case 'home':\n        window.hidePage('about-view');\n        window.showPage('home-view');\n        document.getElementById('page-title').innerHTML = 'Home';\n        break;\n      case 'about':\n        window.hidePage('home-view');\n        window.showPage('about-view');\n        document.getElementById('page-title').innerHTML = 'About';\n        break;\n    }\n  }\n</script>"
  }
