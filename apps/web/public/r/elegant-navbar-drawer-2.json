      "content": "/**\n * Component: Elegant NavBar + Drawer\n * Author: @nickgirga (https://tailwindflex.com/@nickgirga)\n * Source: https://tailwindflex.com/@nickgirga/elegant-navbar-drawer-2\n * Attribution: Créé par @nickgirga sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function ElegantNavbarDrawer2() {\n  return (\n    <div>\n    \n    \n    \n    <div className=\"flex flex-col items-center gap-4 my-8 lg64\">\n    \n      \n      <div id=\"home-view\" className=\"absolute flex flex-col items-center text-center gap-8 md8 lg32 mx-4 my-16 transition-opacity duration-500\">\n    \n        \n        <div className=\"flex flex-col items-center gap-2\">\n          <h1 className=\"text-3xl font-bold\">Elegant<br />NavBar + Drawer</h1>\n          <h2 className=\"text-xl opacity-50\">Ready-to-use Tailwind components. Pure CSS.</h2>\n        </div>\n    \n        \n        <div className=\"flex flex-col items-center gap-4\">\n          <a className=\"btn btn-primary\"\n            href=\"https://tailwindflex.com/@nickgirga/elegant-navbar\"\n            target=\"_blank\"\n            rel=\"noreferrer noopener\">\n            NavBar Component\n          </a>\n    \n          <a className=\"btn btn-secondary\"\n            href=\"https://tailwindflex.com/@nickgirga/elegant-animated-drawer-responsive\"\n            target=\"_blank\"\n            rel=\"noreferrer noopener\">\n            Drawer Component\n          </a>\n          \n          <a className=\"btn\"\n            href=\"https://tailwindflex.com/@nickgirga/elegant-buttons\"\n            target=\"_blank\"\n            rel=\"noreferrer noopener\">\n            Buttons\n          </a>\n        </div>\n    \n      </div>\n    \n      \n      <div id=\"about-view\" className=\"absolute flex flex-col items-center text-center gap-8 md8 lg32 mx-4 my-16 transition-opacity duration-500 hidden\">\n    \n        \n        <div className=\"flex flex-col items-center gap-2\">\n          <h1 className=\"text-3xl font-bold\">About Elegant Components</h1>\n          <h2 className=\"text-xl opacity-50\">by Nicholas Girga</h2>\n        </div>\n    \n        \n        <div className=\"flex flex-col items-center text-center gap-4\">\n          <span>\n            As I've developed more Tailwind components, I've found myself \n            borrowing a lot of my own favorite styles and color schemes. \n            As I release these components as individual bits and bobs on \n            TailwindFlex, the library of components I've developed that are \n            intended to be used together grows. You can find many of these \n            components individually on \n            <a className=\"link link-info\"\n              target=\"_blank\"\n              rel=\"noreferrer noopener\"\n              href=\"https://tailwindflex.com/@nickgirga\">\n              my TailwindFlex page\n            </a>\n            , usually prefixed with \"Elegant\".\n          </span>\n          <span>\n            Because so many components are being created around this similar \n            paradigm, I also figured it's probably time that I create a \n            repository to consolidate all of these similar styles. \n            I've decided to refer to it as PineUI. While you will still be \n            able to find all of PineUI's components on TailwindFlex, you can \n            also find a pre-built CSS file with all of PineUI's styles \n            in the PineUI repository. Note: this repository is still under \n            work.\n          </span>\n        </div>\n    \n        <a className=\"btn btn-primary mb-8\"\n          href=\"https://gitlab.com/pineui/pineui\"\n          target=\"_blank\"\n          rel=\"noreferrer noopener\">\n          🌲 PineUI Repository\n        </a>\n    \n      </div>\n    \n    </div>\n    \n    \n    <div className=\"navbar top-0 fixed z-1 lg64\">\n      \n      \n      <div className=\"navbar-start-box\">\n        \n        <label htmlFor=\"my-drawer\" className=\"btn btn-navbar p-2 block lg\">\n          <svg\n            width=\"24px\"\n            height=\"24px\"\n            strokeWidth=\"1.5\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            xmlns=\"http://www.w3.org/2000/svg\"\n            color=\"currentColor\"\n            data-darkreader-inline-color=\"currentColor\"\n            style=\"--darkreader-inline-color: currentColor;\">\n            <path\n              d=\"M3 5H21\"\n              stroke=\"currentColor\"\n              strokeWidth=\"1.5\"\n              strokeLinecap=\"round\"\n              strokeLinejoin=\"round\"\n              data-darkreader-inline-stroke=\"currentColor\"\n              style=\"--darkreader-inline-stroke: currentColor;\">\n            </path>\n            <path\n              d=\"M3 12H21\"\n              stroke=\"currentColor\"\n              strokeWidth=\"1.5\"\n              strokeLinecap=\"round\"\n              strokeLinejoin=\"round\"\n              data-darkreader-inline-stroke=\"currentColor\"\n              style=\"--darkreader-inline-stroke: currentColor;\">\n            </path>\n            <path\n              d=\"M3 19H21\"\n              stroke=\"currentColor\"\n              strokeWidth=\"1.5\"\n              strokeLinecap=\"round\"\n              strokeLinejoin=\"round\"\n              data-darkreader-inline-stroke=\"currentColor\"\n              style=\"--darkreader-inline-stroke: currentColor;\">\n            </path>\n          </svg>\n        </label>\n      </div>\n    \n      \n      <div className=\"navbar-center-box\">\n        \n        <span id=\"page-title\" className=\"font-bold text-xl\">\n          Home\n        </span>\n      </div>\n    \n      \n      <div className=\"navbar-end-box\">\n        \n        <button className=\"btn btn-navbar p-2\">\n          <svg\n            width=\"24px\"\n            height=\"24px\"\n            strokeWidth=\"1.5\"\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            xmlns=\"http://www.w3.org/2000/svg\"\n            color=\"currentColor\"\n            data-darkreader-inline-color=\"currentColor\"\n            style=\"--darkreader-inline-color: currentColor;\">\n            <path\n              d=\"M12 15C13.6569 15 15 13.6569 15 12C15 10.3431 13.6569 9 12 9C10.3431 9 9 10.3431 9 12C9 13.6569 10.3431 15 12 15Z\"\n              stroke=\"currentColor\"\n              strokeWidth=\"1.5\"\n              strokeLinecap=\"round\"\n              strokeLinejoin=\"round\"\n              data-darkreader-inline-stroke=\"currentColor\"\n              style=\"--darkreader-inline-stroke: currentColor;\">\n            </path>\n            <path\n              d=\"M19.6224 10.3954L18.5247 7.7448L20 6L18 4L16.2647 5.48295L13.5578 4.36974L12.9353 2H10.981L10.3491 4.40113L7.70441 5.51596L6 4L4 6L5.45337 7.78885L4.3725 10.4463L2 11V13L4.40111 13.6555L5.51575 16.2997L4 18L6 20L7.79116 18.5403L10.397 19.6123L11 22H13L13.6045 19.6132L16.2551 18.5155C16.6969 18.8313 18 20 18 20L20 18L18.5159 16.2494L19.6139 13.598L21.9999 12.9772L22 11L19.6224 10.3954Z\"\n              stroke=\"currentColor\"\n              strokeWidth=\"1.5\"\n              strokeLinecap=\"round\"\n              strokeLinejoin=\"round\"\n              data-darkreader-inline-stroke=\"currentColor\"\n              style=\"--darkreader-inline-stroke: currentColor;\">\n            </path>\n          </svg>\n        </button>\n      </div>\n      \n    </div>\n    \n    \n    <div>\n    \n      \n      <input id=\"my-drawer\" type=\"checkbox\" className=\"peer appearance-none\" />\n    \n      \n      <label htmlFor=\"my-drawer\" className=\"drawer-overlay\"></label>\n    \n      \n      <div className=\"drawer-sidebar lg\">\n    \n        \n        <div>\n          \n          <label className=\"btn btn-drawer-sidebar block lg\"\n            htmlFor=\"my-drawer\"\n           >\n            Home\n          </label>\n          \n          <button className=\"btn btn-drawer-sidebar lg w-full hidden\"\n           >\n            Home\n          </button>\n        </div>\n    \n        \n        <div>\n          \n          <label className=\"btn btn-drawer-sidebar block lg\"\n            htmlFor=\"my-drawer\"\n           >\n            About\n          </label>\n          \n          <button className=\"btn btn-drawer-sidebar lg w-full hidden\"\n           >\n            About\n          </button>\n        </div>\n    \n      </div>\n    \n    </div>\n    \n    \n    \n    \n    </div>\n  );\n}\n",
