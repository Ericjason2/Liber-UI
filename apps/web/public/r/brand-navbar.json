      "content": "/**\n * Component: Brand Navbar\n * Author: @blvpeppa (https://tailwindflex.com/@blvpeppa)\n * Source: https://tailwindflex.com/@blvpeppa/brand-navbar\n * Attribution: Créé par @blvpeppa sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function BrandNavbar() {\n  return (\n    <div>\n    <nav className=\"bg-white shadow fixed top-0 w-full z-50\">\n      <div className=\"max-w-7xl mx-auto px-6\">\n        <div className=\"flex justify-between items-center h-16\">\n          <div className=\"text-2xl font-bold text-blue-600\">Brand</div>\n          <div className=\"hidden md space-x-8\">\n            <a href=\"#\" className=\"text-gray-700 hover600\">Home</a>\n            <a href=\"#\" className=\"text-gray-700 hover600\">Features</a>\n            <a href=\"#\" className=\"text-gray-700 hover600\">Pricing</a>\n            <div className=\"relative group\">\n              <button className=\"inline-flex items-center text-gray-700 hover600 focus\">\n                More\n                <svg className=\"ml-1 h-4 w-4\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" viewBox=\"0 0 24 24\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M19 9l-7 7-7-7\"/></svg>\n              </button>\n              <div className=\"absolute hidden group-hover bg-white shadow-md rounded mt-2 py-2 w-40\">\n                <a href=\"#\" className=\"block px-4 py-2 hover100\">About</a>\n                <a href=\"#\" className=\"block px-4 py-2 hover100\">Contact</a>\n                <a href=\"#\" className=\"block px-4 py-2 hover100\">Help</a>\n              </div>\n            </div>\n          </div>\n          <div className=\"md\">\n            <button id=\"menu-btn\" className=\"text-gray-700 focus\">\n              <svg className=\"h-6 w-6\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" viewBox=\"0 0 24 24\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M4 6h16M4 12h16M4 18h16\"/></svg>\n            </button>\n          </div>\n        </div>\n      </div>\n      <div id=\"mobile-menu\" className=\"hidden md bg-white shadow-md\">\n        <a href=\"#\" className=\"block px-6 py-3 border-b border-gray-200 hover100\">Home</a>\n        <a href=\"#\" className=\"block px-6 py-3 border-b border-gray-200 hover100\">Features</a>\n        <a href=\"#\" className=\"block px-6 py-3 border-b border-gray-200 hover100\">Pricing</a>\n        <a href=\"#\" className=\"block px-6 py-3 border-b border-gray-200 hover100\">About</a>\n        <a href=\"#\" className=\"block px-6 py-3 hover100\">Contact</a>\n      </div>\n    \n      \n    </nav>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
