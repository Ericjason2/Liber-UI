    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>AI Intelligence Feed</title>\n\n<script src=\"https://cdn.tailwindcss.com\"></script>\n\n<style>\nhtml{\n    scroll-behavior:smooth;\n}\nbody{\n    background:#050816;\n}\n</style>\n\n</head>\n<body>\n\n<section class=\"py-10 px-4\">\n\n    <div class=\"max-w-6xl mx-auto\">\n\n        <!-- Header -->\n\n        <div class=\"flex items-center justify-between mb-6\">\n\n            <div>\n                <div\n                    class=\"inline-flex items-center px-3 py-1 rounded-full border border-slate-800 text-[10px] tracking-[0.25em] uppercase text-emerald-400\"\n                >\n                    Intelligence Feed\n                </div>\n\n                <h2\n                    class=\"mt-3 text-2xl md:text-3xl font-bold text-white\"\n                >\n                    AI & Emerging Technology\n                </h2>\n            </div>\n\n            <a\n                href=\"https://tailwindflex.com/@ayyam\"\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                class=\"shrink-0 text-xs md:text-sm text-slate-400 hover:text-white transition\"\n            >\n                View More Components →\n            </a>\n\n        </div>\n\n        <!-- Component -->\n\n        <div\n            class=\"relative overflow-hidden rounded-3xl border border-slate-900 bg-gradient-to-br from-[#09111d] via-[#081019] to-[#0a1c18]\"\n        >\n\n            <div class=\"grid lg:grid-cols-12\">\n\n                <!-- Featured -->\n\n                <div class=\"lg:col-span-7 p-6 md:p-8\">\n\n                    <div\n                        id=\"category\"\n                        class=\"text-[11px] uppercase tracking-[0.25em] text-emerald-400\"\n                    ></div>\n\n                    <h3\n                        id=\"title\"\n                        class=\"mt-3 text-2xl md:text-3xl font-bold text-white leading-tight\"\n                    ></h3>\n\n                    <p\n                        id=\"description\"\n                        class=\"mt-4 text-sm md:text-base text-slate-400 leading-relaxed max-w-xl\"\n                    ></p>\n\n                    <div\n                        id=\"tags\"\n                        class=\"mt-5 flex flex-wrap gap-2\"\n                    ></div>\n\n                </div>\n\n                <!-- Side Navigation -->\n\n                <div\n                    class=\"lg:col-span-5 border-t lg:border-t-0 lg:border-l border-slate-900 p-4\"\n                >\n\n                    <div\n                        id=\"slideList\"\n                        class=\"space-y-2\"\n                    ></div>\n\n                </div>\n\n            </div>\n\n        </div>\n\n        <!-- Footer Controls -->\n\n        <div\n            class=\"mt-4 flex flex-col sm:flex-row items-center justify-between gap-4\"\n        >\n\n            <!-- Breadcrumb -->\n\n            <div\n                id=\"indicators\"\n                class=\"flex items-center gap-2\"\n            ></div>\n\n            <!-- Arrows -->\n\n            <div\n                class=\"flex items-center gap-2\"\n            >\n\n                <button\n                    id=\"prevBtn\"\n                    class=\"w-10 h-10 flex items-center justify-center rounded-xl border border-slate-700 bg-slate-900 text-white hover:border-emerald-500 transition\"\n                >\n                    ←\n                </button>\n\n                <button\n                    id=\"nextBtn\"\n                    class=\"w-10 h-10 flex items-center justify-center rounded-xl border border-slate-700 bg-slate-900 text-white hover:border-emerald-500 transition\"\n                >\n                    →\n                </button>\n\n            </div>\n\n        </div>\n\n    </div>\n\n</section>\n\n<script>\nconst slides = [\n{\n    category:\"AUTONOMOUS SYSTEMS\",\n    title:\"Multi-Agent Systems Scale Enterprise Workflows\",\n    description:\"Organizations deploy collaborative AI systems to automate planning and execution across teams.\",\n    tags:[\"Agents\",\"Automation\",\"Enterprise\"]\n},\n{\n    category:\"ENTERPRISE AI\",\n    title:\"Private Models Become Core Infrastructure\",\n    description:\"Businesses invest in secure domain-specific AI deployments for governance and control.\",\n    tags:[\"Security\",\"LLM\",\"Infrastructure\"]\n},\n{\n    category:\"DEVELOPER TOOLS\",\n    title:\"AI-Native Engineering Workflows Expand\",\n    description:\"Development teams increasingly rely on AI for coding, testing and architecture decisions.\",\n    tags:[\"DevTools\",\"Coding\",\"Productivity\"]\n},\n{\n    category:\"RESEARCH\",\n    title:\"Multimodal Systems Improve Reasoning\",\n    description:\"Text, image and voice understanding converge into unified intelligent systems.\",\n    tags:[\"Research\",\"Vision\",\"Voice\"]\n}\n];\n\nlet active = 0;\nlet autoSlide;\n\nconst categoryEl = document.getElementById(\"category\");\nconst titleEl = document.getElementById(\"title\");\nconst descriptionEl = document.getElementById(\"description\");\nconst tagsEl = document.getElementById(\"tags\");\nconst slideListEl = document.getElementById(\"slideList\");\nconst indicatorsEl = document.getElementById(\"indicators\");\n\nfunction render(){\n\n    const slide = slides[active];\n\n    categoryEl.textContent = slide.category;\n    titleEl.textContent = slide.title;\n    descriptionEl.textContent = slide.description;\n\n    tagsEl.innerHTML = slide.tags.map(tag => `\n        <span class=\"px-3 py-1 text-xs rounded-full border border-slate-800 text-slate-400\">\n            ${tag}\n        </span>\n    `).join('');\n\n    slideListEl.innerHTML = slides.map((item,index)=>`\n\n        <button\n            onclick=\"setActive(${index})\"\n            class=\"\n            w-full\n            text-left\n            p-4\n            rounded-2xl\n            transition-all\n            duration-300\n\n            ${\n                active===index\n                ? 'bg-slate-900 border border-slate-700'\n                : 'border border-transparent hover:border-slate-800'\n            }\n            \"\n        >\n\n            <div class=\"flex items-center justify-between gap-4\">\n\n                <div>\n\n                    <div class=\"text-[10px] tracking-[0.2em] uppercase text-slate-500 mb-2\">\n                        ${item.category}\n                    </div>\n\n                    <div class=\"text-sm font-medium text-white\">\n                        ${item.title}\n                    </div>\n\n                </div>\n\n                <div class=\"text-slate-600 text-xs\">\n                    0${index+1}\n                </div>\n\n            </div>\n\n        </button>\n\n    `).join('');\n\n    indicatorsEl.innerHTML = slides.map((_,index)=>`\n\n        <button\n            onclick=\"setActive(${index})\"\n            class=\"\n            transition-all\n            duration-300\n            rounded-full\n\n            ${\n                active===index\n                ? 'w-10 h-2 bg-emerald-500'\n                : 'w-2 h-2 bg-slate-700'\n            }\n            \"\n        ></button>\n\n    `).join('');\n}\n\nfunction next(){\n    active = (active + 1) % slides.length;\n    render();\n}\n\nfunction prev(){\n    active = (active - 1 + slides.length) % slides.length;\n    render();\n}\n\nfunction setActive(index){\n    active = index;\n    render();\n\n    clearInterval(autoSlide);\n    startAutoPlay();\n}\n\nfunction startAutoPlay(){\n\n    autoSlide = setInterval(()=>{\n        next();\n    },2000);\n\n}\n\ndocument.getElementById(\"nextBtn\").addEventListener(\"click\",()=>{\n    next();\n    clearInterval(autoSlide);\n    startAutoPlay();\n});\n\ndocument.getElementById(\"prevBtn\").addEventListener(\"click\",()=>{\n    prev();\n    clearInterval(autoSlide);\n    startAutoPlay();\n});\n\nrender();\nstartAutoPlay();\n</script>\n\n</body>\n</html>"
  }
