      "content": "/**\n * Component: AI Trends Showcase\n * Author: @ayyam (https://tailwindflex.com/@ayyam)\n * Source: https://tailwindflex.com/@ayyam/ai-intelligence-magazine-carousel-premium-dark-tailwind-css-component\n * Attribution: Créé par @ayyam sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function AiIntelligenceMagazineCarouselPremiumDarkTailwindCssComponent() {\n  return (\n    <div dangerouslySetInnerHTML={{ __html: \"<!DOCTYPE html>\\n<html lang=\\\"en\\\">\\n<head>\\n<meta charset=\\\"UTF-8\\\">\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\">\\n<title>AI Intelligence Feed</title>\\n\\n\\n\\n<style>\\nhtml{\\n    scroll-behavior:smooth;\\n}\\nbody{\\n    background:#050816;\\n}\\n</style>\\n\\n</head>\\n<body>\\n\\n<section class=\\\"py-10 px-4\\\">\\n\\n    <div class=\\\"max-w-6xl mx-auto\\\">\\n\\n        <!-- Header -->\\n\\n        <div class=\\\"flex items-center justify-between mb-6\\\">\\n\\n            <div>\\n                <div\\n                    class=\\\"inline-flex items-center px-3 py-1 rounded-full border border-slate-800 text-[10px] tracking-[0.25em] uppercase text-emerald-400\\\"\\n                >\\n                    Intelligence Feed\\n                </div>\\n\\n                <h2\\n                    class=\\\"mt-3 text-2xl md:text-3xl font-bold text-white\\\"\\n                >\\n                    AI & Emerging Technology\\n                </h2>\\n            </div>\\n\\n            <a\\n                href=\\\"https://tailwindflex.com/@ayyam\\\"\\n                target=\\\"_blank\\\"\\n                rel=\\\"noopener noreferrer\\\"\\n                class=\\\"shrink-0 text-xs md:text-sm text-slate-400 hover:text-white transition\\\"\\n            >\\n                View More Components →\\n            </a>\\n\\n        </div>\\n\\n        <!-- Component -->\\n\\n        <div\\n            class=\\\"relative overflow-hidden rounded-3xl border border-slate-900 bg-gradient-to-br from-[#09111d] via-[#081019] to-[#0a1c18]\\\"\\n        >\\n\\n            <div class=\\\"grid lg:grid-cols-12\\\">\\n\\n                <!-- Featured -->\\n\\n                <div class=\\\"lg:col-span-7 p-6 md:p-8\\\">\\n\\n                    <div\\n                        id=\\\"category\\\"\\n                        class=\\\"text-[11px] uppercase tracking-[0.25em] text-emerald-400\\\"\\n                    ></div>\\n\\n                    <h3\\n                        id=\\\"title\\\"\\n                        class=\\\"mt-3 text-2xl md:text-3xl font-bold text-white leading-tight\\\"\\n                    ></h3>\\n\\n                    <p\\n                        id=\\\"description\\\"\\n                        class=\\\"mt-4 text-sm md:text-base text-slate-400 leading-relaxed max-w-xl\\\"\\n                    ></p>\\n\\n                    <div\\n                        id=\\\"tags\\\"\\n                        class=\\\"mt-5 flex flex-wrap gap-2\\\"\\n                    ></div>\\n\\n                </div>\\n\\n                <!-- Side Navigation -->\\n\\n                <div\\n                    class=\\\"lg:col-span-5 border-t lg:border-t-0 lg:border-l border-slate-900 p-4\\\"\\n                >\\n\\n                    <div\\n                        id=\\\"slideList\\\"\\n                        class=\\\"space-y-2\\\"\\n                    ></div>\\n\\n                </div>\\n\\n            </div>\\n\\n        </div>\\n\\n        <!-- Footer Controls -->\\n\\n        <div\\n            class=\\\"mt-4 flex flex-col sm:flex-row items-center justify-between gap-4\\\"\\n        >\\n\\n            <!-- Breadcrumb -->\\n\\n            <div\\n                id=\\\"indicators\\\"\\n                class=\\\"flex items-center gap-2\\\"\\n            ></div>\\n\\n            <!-- Arrows -->\\n\\n            <div\\n                class=\\\"flex items-center gap-2\\\"\\n            >\\n\\n                <button\\n                    id=\\\"prevBtn\\\"\\n                    class=\\\"w-10 h-10 flex items-center justify-center rounded-xl border border-slate-700 bg-slate-900 text-white hover:border-emerald-500 transition\\\"\\n                >\\n                    ←\\n                </button>\\n\\n                <button\\n                    id=\\\"nextBtn\\\"\\n                    class=\\\"w-10 h-10 flex items-center justify-center rounded-xl border border-slate-700 bg-slate-900 text-white hover:border-emerald-500 transition\\\"\\n                >\\n                    →\\n                </button>\\n\\n            </div>\\n\\n        </div>\\n\\n    </div>\\n\\n</section>\\n\\n\\n\\n</body>\\n</html>\" }} />\n  );\n}\n",
      "type": "registry:ui"
    }
