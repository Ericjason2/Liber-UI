    "rawHtml": "<section class=\"min-h-screen bg-gradient-to-br from-pink-500 via-purple-500 to-indigo-500 flex items-center justify-center px-6\">\n  <div class=\"max-w-6xl w-full text-white text-center space-y-8\">\n    <!-- Hero Section -->\n    <div class=\"space-y-4\">\n      <h1 class=\"text-5xl md:text-6xl font-extrabold drop-shadow-lg\">Hello, I'm <span class=\"text-yellow-300\">Sophia Ray</span></h1>\n      <p class=\"text-lg md:text-2xl max-w-3xl mx-auto text-white/90\">\n        A passionate Full-Stack Developer crafting modern, stunning, and accessible websites with love and creativity.\n      </p>\n      <div class=\"flex justify-center space-x-4\">\n        <a href=\"#portfolio\" class=\"bg-white text-purple-700 font-semibold px-6 py-3 rounded-full shadow-lg hover:scale-105 transition\">View My Work</a>\n        <a href=\"#contact\" class=\"border border-white px-6 py-3 rounded-full hover:bg-white hover:text-purple-700 transition\">Contact Me</a>\n      </div>\n    </div>\n\n    <!-- Profile Image -->\n    <div class=\"flex justify-center\">\n      <img src=\"https://i.imgur.com/7vQbFfR.png\" alt=\"Profile Image\" class=\"w-52 h-52 rounded-full border-4 border-white shadow-lg object-cover\">\n    </div>\n  </div>\n</section>\n\n<!-- About Section -->\n<section class=\"py-24 bg-white dark:bg-gray-900 px-6\">\n  <div class=\"max-w-5xl mx-auto text-center space-y-6\">\n    <h2 class=\"text-3xl font-bold text-purple-600\">About Me</h2>\n    <p class=\"text-lg text-gray-700 dark:text-gray-300 leading-relaxed\">\n      I specialize in building scalable web applications using modern tech stacks. I love solving complex problems, designing beautiful UI, and delivering pixel-perfect products. With years of experience in React, Next.js, Tailwind CSS, and backend systems, I bring ideas to life with smooth performance and clean code.\n    </p>\n  </div>\n</section>\n\n<!-- Skills -->\n<section class=\"py-24 bg-gradient-to-br from-purple-500 via-pink-500 to-indigo-500 text-white px-6\">\n  <div class=\"max-w-5xl mx-auto text-center space-y-12\">\n    <h2 class=\"text-3xl font-bold mb-4\">My Skills</h2>\n    <div class=\"grid grid-cols-2 md:grid-cols-4 gap-8\">\n      <div class=\"bg-white/20 p-6 rounded-lg shadow-lg font-semibold\">React.js</div>\n      <div class=\"bg-white/20 p-6 rounded-lg shadow-lg font-semibold\">Next.js</div>\n      <div class=\"bg-white/20 p-6 rounded-lg shadow-lg font-semibold\">Tailwind CSS</div>\n      <div class=\"bg-white/20 p-6 rounded-lg shadow-lg font-semibold\">Node.js</div>\n      <div class=\"bg-white/20 p-6 rounded-lg shadow-lg font-semibold\">TypeScript</div>\n      <div class=\"bg-white/20 p-6 rounded-lg shadow-lg font-semibold\">MongoDB</div>\n      <div class=\"bg-white/20 p-6 rounded-lg shadow-lg font-semibold\">Figma</div>\n      <div class=\"bg-white/20 p-6 rounded-lg shadow-lg font-semibold\">AWS</div>\n    </div>\n  </div>\n</section>\n\n<!-- Portfolio Projects -->\n<section id=\"portfolio\" class=\"py-24 bg-white dark:bg-gray-900 px-6\">\n  <div class=\"max-w-6xl mx-auto text-center\">\n    <h2 class=\"text-3xl font-bold text-purple-600 mb-8\">Projects</h2>\n    <div class=\"grid grid-cols-1 md:grid-cols-3 gap-8\">\n      <!-- Project Card 1 -->\n      <div class=\"bg-gradient-to-br from-pink-400 to-purple-600 text-white rounded-lg shadow-lg overflow-hidden\">\n        <img src=\"https://source.unsplash.com/600x400/?technology,website\" class=\"w-full object-cover\" alt=\"Project 1\">\n        <div class=\"p-6\">\n          <h3 class=\"text-2xl font-bold mb-2\">Project Alpha</h3>\n          <p>Complete e-commerce platform with payment gateway and admin dashboard.</p>\n        </div>\n      </div>\n      <!-- Project Card 2 -->\n      <div class=\"bg-gradient-to-br from-indigo-400 to-purple-600 text-white rounded-lg shadow-lg overflow-hidden\">\n        <img src=\"https://source.unsplash.com/600x400/?software,webdesign\" class=\"w-full object-cover\" alt=\"Project 2\">\n        <div class=\"p-6\">\n          <h3 class=\"text-2xl font-bold mb-2\">Project Beta</h3>\n          <p>Custom CRM system with live chat, customer pipelines and analytics.</p>\n        </div>\n      </div>\n      <!-- Project Card 3 -->\n      <div class=\"bg-gradient-to-br from-pink-300 to-purple-500 text-white rounded-lg shadow-lg overflow-hidden\">\n        <img src=\"https://source.unsplash.com/600x400/?coding,developer\" class=\"w-full object-cover\" alt=\"Project 3\">\n        <div class=\"p-6\">\n          <h3 class=\"text-2xl font-bold mb-2\">Project Gamma</h3>\n          <p>Modern SaaS dashboard with real-time reporting and team collaboration.</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- Contact -->\n<section id=\"contact\" class=\"py-24 bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 text-white px-6\">\n  <div class=\"max-w-xl mx-auto text-center space-y-8\">\n    <h2 class=\"text-3xl font-bold\">Let's Work Together</h2>\n    <form class=\"space-y-4\">\n      <input type=\"text\" placeholder=\"Your Name\" class=\"w-full px-4 py-3 rounded-lg text-black\" required>\n      <input type=\"email\" placeholder=\"Your Email\" class=\"w-full px-4 py-3 rounded-lg text-black\" required>\n      <textarea placeholder=\"Your Message\" rows=\"4\" class=\"w-full px-4 py-3 rounded-lg text-black\" required></textarea>\n      <button type=\"submit\" class=\"bg-white text-purple-700 font-bold px-6 py-3 rounded-full hover:scale-105 transition\">Send Message</button>\n    </form>\n  </div>\n</section>\n\n<!-- Footer -->\n<footer class=\"py-6 bg-black text-white text-center\">\n  <p>© 2025 Sophia Ray — All Rights Reserved</p>\n</footer>"
