      "content": "/**\n * Component: portfolio\n * Author: @lekhraj-ghimire- (https://tailwindflex.com/@lekhraj-ghimire-)\n * Source: https://tailwindflex.com/@lekhraj-ghimire-/portfolio-5\n * Attribution: Créé par @lekhraj-ghimire- sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function Portfolio5() {\n  return (\n    <div>\n    <section className=\"min-h-screen bg-gradient-to-br from-pink-500 via-purple-500 to-indigo-500 flex items-center justify-center px-6\">\n      <div className=\"max-w-6xl w-full text-white text-center space-y-8\">\n        \n        <div className=\"space-y-4\">\n          <h1 className=\"text-5xl md6xl font-extrabold drop-shadow-lg\">Hello, I'm <span className=\"text-yellow-300\">Sophia Ray</span></h1>\n          <p className=\"text-lg md2xl max-w-3xl mx-auto text-white/90\">\n            A passionate Full-Stack Developer crafting modern, stunning, and accessible websites with love and creativity.\n          </p>\n          <div className=\"flex justify-center space-x-4\">\n            <a href=\"#portfolio\" className=\"bg-white text-purple-700 font-semibold px-6 py-3 rounded-full shadow-lg hover105 transition\">View My Work</a>\n            <a href=\"#contact\" className=\"border border-white px-6 py-3 rounded-full hover hover700 transition\">Contact Me</a>\n          </div>\n        </div>\n    \n        \n        <div className=\"flex justify-center\">\n          <img src=\"https://i.imgur.com/7vQbFfR.png\" alt=\"Profile Image\" className=\"w-52 h-52 rounded-full border-4 border-white shadow-lg object-cover\" />\n        </div>\n      </div>\n    </section>\n    \n    \n    <section className=\"py-24 bg-white dark900 px-6\">\n      <div className=\"max-w-5xl mx-auto text-center space-y-6\">\n        <h2 className=\"text-3xl font-bold text-purple-600\">About Me</h2>\n        <p className=\"text-lg text-gray-700 dark300 leading-relaxed\">\n          I specialize in building scalable web applications using modern tech stacks. I love solving complex problems, designing beautiful UI, and delivering pixel-perfect products. With years of experience in React, Next.js, Tailwind CSS, and backend systems, I bring ideas to life with smooth performance and clean code.\n        </p>\n      </div>\n    </section>\n    \n    \n    <section className=\"py-24 bg-gradient-to-br from-purple-500 via-pink-500 to-indigo-500 text-white px-6\">\n      <div className=\"max-w-5xl mx-auto text-center space-y-12\">\n        <h2 className=\"text-3xl font-bold mb-4\">My Skills</h2>\n        <div className=\"grid grid-cols-2 md4 gap-8\">\n          <div className=\"bg-white/20 p-6 rounded-lg shadow-lg font-semibold\">React.js</div>\n          <div className=\"bg-white/20 p-6 rounded-lg shadow-lg font-semibold\">Next.js</div>\n          <div className=\"bg-white/20 p-6 rounded-lg shadow-lg font-semibold\">Tailwind CSS</div>\n          <div className=\"bg-white/20 p-6 rounded-lg shadow-lg font-semibold\">Node.js</div>\n          <div className=\"bg-white/20 p-6 rounded-lg shadow-lg font-semibold\">TypeScript</div>\n          <div className=\"bg-white/20 p-6 rounded-lg shadow-lg font-semibold\">MongoDB</div>\n          <div className=\"bg-white/20 p-6 rounded-lg shadow-lg font-semibold\">Figma</div>\n          <div className=\"bg-white/20 p-6 rounded-lg shadow-lg font-semibold\">AWS</div>\n        </div>\n      </div>\n    </section>\n    \n    \n    <section id=\"portfolio\" className=\"py-24 bg-white dark900 px-6\">\n      <div className=\"max-w-6xl mx-auto text-center\">\n        <h2 className=\"text-3xl font-bold text-purple-600 mb-8\">Projects</h2>\n        <div className=\"grid grid-cols-1 md3 gap-8\">\n          \n          <div className=\"bg-gradient-to-br from-pink-400 to-purple-600 text-white rounded-lg shadow-lg overflow-hidden\">\n            <img src=\"https://source.unsplash.com/600x400/?technology,website\" className=\"w-full object-cover\" alt=\"Project 1\" />\n            <div className=\"p-6\">\n              <h3 className=\"text-2xl font-bold mb-2\">Project Alpha</h3>\n              <p>Complete e-commerce platform with payment gateway and admin dashboard.</p>\n            </div>\n          </div>\n          \n          <div className=\"bg-gradient-to-br from-indigo-400 to-purple-600 text-white rounded-lg shadow-lg overflow-hidden\">\n            <img src=\"https://source.unsplash.com/600x400/?software,webdesign\" className=\"w-full object-cover\" alt=\"Project 2\" />\n            <div className=\"p-6\">\n              <h3 className=\"text-2xl font-bold mb-2\">Project Beta</h3>\n              <p>Custom CRM system with live chat, customer pipelines and analytics.</p>\n            </div>\n          </div>\n          \n          <div className=\"bg-gradient-to-br from-pink-300 to-purple-500 text-white rounded-lg shadow-lg overflow-hidden\">\n            <img src=\"https://source.unsplash.com/600x400/?coding,developer\" className=\"w-full object-cover\" alt=\"Project 3\" />\n            <div className=\"p-6\">\n              <h3 className=\"text-2xl font-bold mb-2\">Project Gamma</h3>\n              <p>Modern SaaS dashboard with real-time reporting and team collaboration.</p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n    \n    \n    <section id=\"contact\" className=\"py-24 bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 text-white px-6\">\n      <div className=\"max-w-xl mx-auto text-center space-y-8\">\n        <h2 className=\"text-3xl font-bold\">Let's Work Together</h2>\n        <form className=\"space-y-4\">\n          <input type=\"text\" placeholder=\"Your Name\" className=\"w-full px-4 py-3 rounded-lg text-black\" required />\n          <input type=\"email\" placeholder=\"Your Email\" className=\"w-full px-4 py-3 rounded-lg text-black\" required />\n          <textarea placeholder=\"Your Message\" rows=\"4\" className=\"w-full px-4 py-3 rounded-lg text-black\" required></textarea>\n          <button type=\"submit\" className=\"bg-white text-purple-700 font-bold px-6 py-3 rounded-full hover105 transition\">Send Message</button>\n        </form>\n      </div>\n    </section>\n    \n    \n    <footer className=\"py-6 bg-black text-white text-center\">\n      <p>© 2025 Sophia Ray — All Rights Reserved</p>\n    </footer>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
