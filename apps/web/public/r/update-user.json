      "content": "/**\n * Component: update user\n * Author: @seth-dridi (https://tailwindflex.com/@seth-dridi)\n * Source: https://tailwindflex.com/@seth-dridi/update-user\n * Attribution: Créé par @seth-dridi sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function UpdateUser() {\n  return (\n    <div>\n    <div className=\"container mx-auto p-4\">\n      \n      <h1 className=\"text-3xl font-bold text-[black] mb-6\">Update User</h1>\n    \n      <form className=\"grid grid-cols-1 gap-6\">\n        \n        <div className=\"p-2\">\n          <input type=\"text\" id=\"userName\" name=\"userName\" placeholder=\"Username\" className=\"block w-full rounded-md border-gray-300 shadow-sm focus[#8c0327] focus[#8c0327] focus50 p-2\" style=\"background-color: #f6f6f6;\" />\n        </div>\n    \n        \n    \n        \n        <div className=\"p-2 grid grid-cols-1 md2 gap-6\">\n          \n          <div>\n            <textarea id=\"bio\" name=\"bio\" rows=\"3\" placeholder=\"User Biography\" className=\"block w-full h-48 rounded-md border-gray-300 shadow-sm focus[#8c0327] focus[#8c0327] focus50 p-2\" style=\"background-color: #f6f6f6;\"></textarea>\n          </div>\n    \n          \n          <div>\n            <label htmlFor=\"avatar\" className=\"block w-full h-48 border-2 border-dashed border-gray-300 rounded-md cursor-pointer flex flex-col items-center justify-center bg-[#f6f6f6] hover50\">\n              <div className=\"text-center\">\n                <div className=\"mb-2\">\n                  <button type=\"button\" className=\"bg-[#8c0327] hover[#6b0220] text-white rounded-full py-2 px-4\">Select from the computer</button>\n                </div>\n                <p className=\"text-gray-500\">or drag photo here</p>\n                <p className=\"text-gray-500 text-sm mt-1\">PNG, JPG, SVG</p>\n              </div>\n            </label>\n            <input id=\"avatar\" name=\"avatar\" type=\"file\" accept=\"image/*\" className=\"sr-only\" />\n          </div>\n        </div>\n    \n        \n        <div className=\"p-2 grid grid-cols-1 md2 gap-6\">\n          \n          <div>\n            <input type=\"text\" id=\"firstName\" name=\"firstName\" placeholder=\"First name\" className=\"block w-full rounded-md border-gray-300 shadow-sm focus[#8c0327] focus[#8c0327] focus50 p-2\" style=\"background-color: #f6f6f6;\" />\n          </div>\n    \n          \n          <div>\n            <input type=\"text\" id=\"lastName\" name=\"lastName\" placeholder=\"Last name\" className=\"block w-full rounded-md border-gray-300 shadow-sm focus[#8c0327] focus[#8c0327] focus50 p-2\" style=\"background-color: #f6f6f6;\" />\n          </div>\n        </div>\n    \n        \n        <div className=\"p-2\">\n          <input type=\"email\" id=\"email\" name=\"email\" placeholder=\"Email\" className=\"block w-full rounded-md border-gray-300 shadow-sm focus[#8c0327] focus[#8c0327] focus50 p-2\" style=\"background-color: #f6f6f6;\" />\n        </div>\n    \n        \n        <div className=\"p-2\">\n          <input type=\"password\" id=\"currentPassword\" name=\"currentPassword\" placeholder=\"Current password\" className=\"block w-full rounded-md border-gray-300 shadow-sm focus[#8c0327] focus[#8c0327] focus50 p-2\" style=\"background-color: #f6f6f6;\" />\n        </div>\n        \n        \n        <div className=\"p-2 grid grid-cols-1 md2 gap-6\">\n          \n          <div>\n            <input type=\"password\" id=\"newPassword\" name=\"newPassword\" placeholder=\"New password\" className=\"block w-full rounded-md border-gray-300 shadow-sm focus[#8c0327] focus[#8c0327] focus50 p-2\" style=\"background-color: #f6f6f6;\" />\n          </div>\n    \n          \n          <div>\n            <input type=\"password\" id=\"confirmPassword\" name=\"confirmPassword\" placeholder=\"Confirmation password\" className=\"block w-full rounded-md border-gray-300 shadow-sm focus[#8c0327] focus[#8c0327] focus50 p-2\" style=\"background-color: #f6f6f6;\" />\n          </div>\n        </div>\n        \n    \n        \n        <div className=\"col-span-full mt-6 p-2\">\n          <button type=\"submit\" className=\"block w-full bg-[#8c0327] hover[#6b0220] text-white font-bold py-3 px-4 rounded-full\">\n            Update user\n          </button>\n        </div>\n      </form>\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
