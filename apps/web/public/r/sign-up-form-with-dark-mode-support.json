      "content": "/**\n * Component: Sign Up form with dark mode support\n * Author: @anonymous (https://tailwindflex.com/@anonymous)\n * Source: https://tailwindflex.com/@anonymous/sign-up-form-with-dark-mode-support\n * Attribution: Créé par @anonymous sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function SignUpFormWithDarkModeSupport() {\n  return (\n    <div>\n    <section className=\"flex flex-col items-center pt-6\">\n      <div\n        className=\"w-full bg-white rounded-lg shadow dark md0 sm xl0 dark800 dark700\">\n        <div className=\"p-6 space-y-4 md6 sm8\">\n          <h1 className=\"text-xl font-bold leading-tight tracking-tight text-gray-900 md2xl dark\">Create an\n            account\n          </h1>\n          <form className=\"space-y-4 md6\" method=\"POST\">\n            <div>\n              <label htmlFor=\"name\" className=\"block mb-2 text-sm font-medium text-gray-900 dark\">Your full name</label>\n              <input type=\"text\" name=\"name\" id=\"name\" className=\"bg-gray-50 border border-gray-300 text-gray-900 sm rounded-lg focus600 focus600 block w-full p-2.5 dark700 dark600 dark400 dark dark500 dark500\" placeholder=\"Emelia Erickson\" required=\"\" />\n            </div>\n            <div>\n              <label htmlFor=\"username\" className=\"block mb-2 text-sm font-medium text-gray-900 dark\">Username</label>\n              <input type=\"text\" name=\"username\" id=\"username\" className=\"bg-gray-50 border border-gray-300 text-gray-900 sm rounded-lg focus600 focus600 block w-full p-2.5 dark700 dark600 dark400 dark dark500 dark500\" placeholder=\"emelia_erickson24\" required=\"\" />\n            </div>\n            <div>\n              <label htmlFor=\"password\" className=\"block mb-2 text-sm font-medium text-gray-900 dark\">Password</label>\n              <input type=\"password\" name=\"password\" id=\"password\" placeholder=\"••••••••\" className=\"bg-gray-50 border border-gray-300 text-gray-900 sm rounded-lg focus600 focus600 block w-full p-2.5 dark700 dark600 dark400 dark dark500 dark500\" required=\"\" />\n            </div>\n            <button type=\"submit\" className=\"w-full text-white bg-blue-600 hover700 focus4 focus focus300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark600 dark700 dark800\">Create an account</button>\n            <p className=\"text-sm font-light text-gray-500 dark400\">Already have an account? <a\n                className=\"font-medium text-blue-600 hover dark500\" href=\"/signin\">Sign in here</a>\n            </p>\n          </form>\n        </div>\n      </div>\n    </section>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
  ],
