trokeWidth=\"2\" d=\"M5 13l4 4L19 7\"></path>\n              </svg>\n              Advanced analytics\n            </li>\n            <li className=\"flex items-center\">\n              <svg className=\"w-5 h-5 text-green-500 mr-2\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"\n                xmlns=\"http://www.w3.org/2000/svg\">\n                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"M5 13l4 4L19 7\"></path>\n              </svg>\n              24/7 Support\n            </li>\n          </ul>\n          <button className=\"w-full py-3 font-bold text-white bg-purple-600 rounded-lg hover700 transition duration-300 transform hover105\">\n                        Choose Plan\n                    </button>\n          <div className=\"absolute -top-16 right-0 -mt-4 -mr-6 w-16 h-16 float-animation\">\n            <img src=\"https://www.svgrepo.com/show/506715/fire.svg\" alt=\"Icon\" className=\"w-full h-full object-cover rounded-full \" />\n          </div>\n        </div>\n      </div>\n    </div>\n    </div>\n  );\n}\n",
