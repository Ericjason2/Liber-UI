      "content": "/**\n * Component: Modern Contact Section with Responsive Grid and Glassmorphic Form\n * Author: @umairarshad-dev (https://tailwindflex.com/@umairarshad-dev)\n * Source: https://tailwindflex.com/@umairarshad-dev/modern-contact-section-with-responsive-grid-and-glassmorphic-form\n * Attribution: Créé par @umairarshad-dev sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function ModernContactSectionWithResponsiveGridAndGlassmorphicForm() {\n  return (\n    <div>\n    <section id=\"contact\" className=\"relative bg-gradient-to-b from-blue-50 to-white dark900 dark800 py-24\">\n      <div className=\"mx-auto max-w-7xl px-6 sm8 lg12\">\n        \n        <div className=\"text-center max-w-2xl mx-auto mb-20\">\n          <h2 className=\"text-4xl sm5xl font-extrabold text-gray-900 dark\">Let’s Connect</h2>\n          <p className=\"mt-4 text-lg text-gray-600 dark400\">\n            Have a project in mind, a question, or just want to say hi? Drop us a line.\n          </p>\n        </div>\n    \n        \n        <div className=\"grid md2 gap-12\">\n          \n          <div className=\"space-y-8\">\n            \n            <div className=\"flex items-start space-x-4\">\n              <div className=\"flex-shrink-0 w-14 h-14 bg-blue-600 text-white rounded-xl flex items-center justify-center text-xl\">\n                📍\n              </div>\n              <div>\n                <h4 className=\"text-xl font-semibold text-gray-900 dark\">Our Office</h4>\n                <p className=\"text-gray-600 dark400\">Location<br />New York, NY 10001</p>\n              </div>\n            </div>\n    \n            <div className=\"flex items-start space-x-4\">\n              <div className=\"flex-shrink-0 w-14 h-14 bg-blue-600 text-white rounded-xl flex items-center justify-center text-xl\">\n                📞\n              </div>\n              <div>\n                <h4 className=\"text-xl font-semibold text-gray-900 dark\">Say Hello</h4>\n                <p className=\"text-gray-600 dark400\">+92 334---------</p>\n                <p className=\"text-gray-600 dark400\">E-mail.com</p>\n              </div>\n            </div>\n    \n            <div className=\"flex items-start space-x-4\">\n              <div className=\"flex-shrink-0 w-14 h-14 bg-blue-600 text-white rounded-xl flex items-center justify-center text-xl\">\n                ⏰\n              </div>\n              <div>\n                <h4 className=\"text-xl font-semibold text-gray-900 dark\">Working Hours</h4>\n                <p className=\"text-gray-600 dark400\">Mon–Fri: 09:00–6:00</p>\n                <p className=\"text-gray-600 dark400\">Sat: 08:00–12:00</p>\n              </div>\n            </div>\n          </div>\n    \n          \n          <div className=\"bg-white dark900/70 backdrop-blur-lg border border-slate-200 dark700 rounded-2xl p-8 shadow-xl\">\n            <h3 className=\"text-2xl font-bold text-gray-900 dark mb-6\">Send us a message</h3>\n            <form className=\"space-y-6\" id=\"contactForm\">\n              <div>\n                <label htmlFor=\"name\" className=\"block mb-2 text-sm font-medium text-gray-700 dark300\">Your Name</label>\n                <input type=\"text\" id=\"name\" name=\"name\" placeholder=\"John Doe\"\n                  className=\"w-full rounded-lg border border-gray-300 dark600 bg-transparent px-4 py-2 text-gray-900 dark focus2 focus600 outline-none transition-all\" />\n              </div>\n              <div>\n                <label htmlFor=\"email\" className=\"block mb-2 text-sm font-medium text-gray-700 dark300\">Email Address</label>\n                <input type=\"email\" id=\"email\" name=\"email\" placeholder=\"john.com\"\n                  className=\"w-full rounded-lg border border-gray-300 dark600 bg-transparent px-4 py-2 text-gray-900 dark focus2 focus600 outline-none transition-all\" />\n              </div>\n              <div>\n                <label htmlFor=\"message\" className=\"block mb-2 text-sm font-medium text-gray-700 dark300\">Message</label>\n                <textarea id=\"message\" name=\"message\" rows=\"5\" placeholder=\"Write your message...\"\n                  className=\"w-full rounded-lg border border-gray-300 dark600 bg-transparent px-4 py-2 text-gray-900 dark focus2 focus600 outline-none transition-all resize-none\"></textarea>\n              </div>\n              <div>\n                <button type=\"submit\"\n                  className=\"w-full bg-blue-700 hover800 transition-colors text-white py-3 rounded-lg font-semibold\">\n                  Send Message\n                </button>\n              </div>\n            </form>\n          </div>\n        </div>\n      </div>\n    </section>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
  ],
