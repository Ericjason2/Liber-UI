    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Modern Hero Page</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n    <script>\n        tailwind.config = {\n            theme: {\n                extend: {\n                    animation: {\n                        float: 'float 15s infinite ease-in-out',\n                        pulse: 'pulse 2s infinite',\n                        'text-gradient': 'text-gradient 3s linear infinite',\n                        'slide-in': 'slide-in 0.5s ease-out forwards',\n                    },\n                    keyframes: {\n                        float: {\n                            '0%, 100%': { transform: 'translateY(0) rotate(0deg)' },\n                            '50%': { transform: 'translateY(-20px) rotate(5deg)' },\n                        },\n                        pulse: {\n                            '0%, 100%': { opacity: '1' },\n                            '50%': { opacity: '0.5' },\n                        },\n                        'text-gradient': {\n                            '0%': { 'background-position': '0% 50%' },\n                            '50%': { 'background-position': '100% 50%' },\n                            '100%': { 'background-position': '0% 50%' },\n                        },\n                        'slide-in': {\n                            '0%': { transform: 'translateY(20px)', opacity: '0' },\n                            '100%': { transform: 'translateY(0)', opacity: '1' },\n                        },\n                    },\n                }\n            }\n        }\n    </script>\n    <style type=\"text/tailwindcss\">\n        @layer utilities {\n            .bg-gradient-animate {\n                background-size: 200% 200%;\n                animation: text-gradient 3s linear infinite;\n            }\n            .text-stroke {\n                -webkit-text-stroke: 1px rgba(0,0,0,0.1);\n                text-stroke: 1px rgba(0,0,0,0.1);\n            }\n            .delay-100 {\n                animation-delay: 100ms;\n            }\n            .delay-200 {\n                animation-delay: 200ms;\n            }\n            .delay-300 {\n                animation-delay: 300ms;\n            }\n            .delay-400 {\n                animation-delay: 400ms;\n            }\n            .delay-500 {\n                animation-delay: 500ms;\n            }\n        }\n    </style>\n</head>\n<body class=\"bg-white text-gray-800 overflow-x-hidden relative\">\n    <!-- Animated Background Elements -->\n    <div class=\"fixed inset-0 -z-10 overflow-hidden\">\n        <div class=\"absolute w-[300px] h-[300px] rounded-full bg-gradient-to-br from-blue-400 to-pur-400 opacity-10 blur-[60px] top-[10%] left-[5%] animate-float\"></div>\n        <div class=\"absolute w-[400px] h-[400px] rounded-full bg-gradient-to-br from-pink-200 to-blue-200 opacity-10 blur-[60px] bottom-[15%] right-[10%] animate-float delay-200\"></div>\n        <div class=\"absolute w-[250px] h-[250px] rounded-full bg-gradient-to-br from-green-300 to-blue-300 opacity-10 blur-[60px] top-1/2 left-[30%] animate-float delay-400\"></div>\n        <div class=\"absolute w-[350px] h-[350px] rounded-lg bg-gradient-to-br from-red-200 to-pink-200 opacity-10 blur-[60px] top-[60%] left-[60%] animate-float delay-100\"></div>\n        <div class=\"absolute w-[200px] h-[200px] rounded-lg bg-gradient-to-br from-orange-200 to-pink-300 opacity-10 blur-[60px] top-[20%] right-[20%] animate-float delay-300\"></div>\n    </div>\n    \n    <!-- Navbar with Advanced Effects -->\n    <nav class=\"fixed top-0 left-0 w-full py-5 px-[5%] z-50 backdrop-blur-md bg-white/80 border-b border-gray-100 transition-all duration-300\">\n        <div class=\"max-w-7xl mx-auto flex justify-between items-center\">\n            <div class=\"flex items-center text-2xl font-bold text-gray-800\">\n                <span>Nexus</span>\n                <span class=\"text-blue-400 animate-pulse\">.</span>\n            </div>\n            \n            <div class=\"hidden md:flex space-x-8\">\n                <a href=\"#\" class=\"nav-link relative group text-gray-600 hover:text-gray-900 transition-colors\">\n                    <span class=\"relative\">\n                        Home\n                        <span class=\"absolute bottom-0 left-0 w-0 h-0.5 bg-blue-400 group-hover:w-full transition-all duration-300\"></span>\n                    </span>\n                </a>\n                <a href=\"#\" class=\"nav-link relative group text-gray-600 hover:text-gray-900 transition-colors\">\n                    <span class=\"relative\">\n                        Features\n                        <span class=\"absolute bottom-0 left-0 w-0 h-0.5 bg-blue-400 group-hover:w-full transition-all duration-300\"></span>\n                    </span>\n                </a>\n                <a href=\"#\" class=\"nav-link relative group text-gray-600 hover:text-gray-900 transition-colors\">\n                    <span class=\"relative\">\n                        Products\n                        <span class=\"absolute bottom-0 left-0 w-0 h-0.5 bg-blue-400 group-hover:w-full transition-all duration-300\"></span>\n                    </span>\n                </a>\n                <a href=\"#\" class=\"nav-link relative group text-gray-600 hover:text-gray-900 transition-colors\">\n                    <span class=\"relative\">\n                        Pricing\n                        <span class=\"absolute bottom-0 left-0 w-0 h-0.5 bg-blue-400 group-hover:w-full transition-all duration-300\"></span>\n                    </span>\n                </a>\n                <a href=\"#\" class=\"nav-link relative group text-gray-600 hover:text-gray-900 transition-colors\">\n                    <span class=\"relative\">\n                        Contact\n                        <span class=\"absolute bottom-0 left-0 w-0 h-0.5 bg-blue-400 group-hover:w-full transition-all duration-300\"></span>\n                    </span>\n                </a>\n            </div>\n            \n            <div class=\"flex items-center space-x-4\">\n                <button class=\"hidden md:block px-4 py-2 text-gray-600 hover:text-gray-900 transition-colors\">Login</button>\n                <button class=\"px-4 py-2 bg-gradient-to-r from-blue-400 to-purple-500 text-white rounded-lg hover:shadow-lg transition-all duration-300 transform hover:-translate-y-0.5\">\n                    Sign Up\n                </button>\n                <button class=\"md:hidden flex flex-col space-y-1.5\">\n                    <span class=\"w-6 h-0.5 bg-gray-800\"></span>\n                    <span class=\"w-6 h-0.5 bg-gray-800\"></span>\n                    <span class=\"w-6 h-0.5 bg-gray-800\"></span>\n                </button>\n            </div>\n        </div>\n    </nav>\n    \n    <!-- Hero Section -->\n    <section class=\"min-h-screen pt-32 pb-20 px-[5%] flex flex-col lg:flex-row items-center justify-between max-w-7xl mx-auto\">\n        <div class=\"lg:w-1/2 mb-16 lg:mb-0 animate-slide-in\">\n            <h1 class=\"text-5xl md:text-6xl lg:text-7xl font-bold leading-tight mb-6\">\n                <span class=\"block text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-600 bg-gradient-animate\">Innovate</span>\n                <span class=\"block text-transparent bg-clip-text bg-gradient-to-r from-pink-400 to-red-500 bg-gradient-animate delay-200\">Create</span>\n                <span class=\"block text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-teal-500 bg-gradient-animate delay-400\">Elevate</span>\n            </h1>\n            <p class=\"text-lg md:text-xl text-gray-600 mb-10 max-w-lg\">\n                The future of digital experiences starts here. Our platform empowers creators to build without limits.\n            </p>\n            <div class=\"flex flex-col sm:flex-row space-y-4 sm:space-y-0 sm:space-x-4\">\n                <button class=\"px-8 py-4 bg-gradient-to-r from-blue-400 to-purple-500 text-white rounded-lg hover:shadow-lg transition-all duration-300 transform hover:-translate-y-1 flex items-center justify-center\">\n                    Get Started\n                    <svg class=\"w-5 h-5 ml-2\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"></path>\n                    </svg>\n                </button>\n                <button class=\"px-8 py-4 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-all duration-300 flex items-center justify-center\">\n                    <i class=\"fas fa-play mr-2 text-blue-500\"></i>\n                    Watch Demo\n                </button>\n            </div>\n            \n            <div class=\"mt-16 flex items-center\">\n                <div class=\"flex -space-x-3\">\n                    <img class=\"w-12 h-12 rounded-full border-2 border-white\" src=\"https://randomuser.me/api/portraits/women/12.jpg\" alt=\"User\">\n                    <img class=\"w-12 h-12 rounded-full border-2 border-white\" src=\"https://randomuser.me/api/portraits/men/32.jpg\" alt=\"User\">\n                    <img class=\"w-12 h-12 rounded-full border-2 border-white\" src=\"https://randomuser.me/api/portraits/women/44.jpg\" alt=\"User\">\n                </div>\n                <div class=\"ml-4\">\n                    <div class=\"flex items-center\">\n                        <div class=\"flex\">\n                            <i class=\"fas fa-star text-yellow-400\"></i>\n                            <i class=\"fas fa-star text-yellow-400\"></i>\n                            <i class=\"fas fa-star text-yellow-400\"></i>\n                            <i class=\"fas fa-star text-yellow-400\"></i>\n                            <i class=\"fas fa-star text-yellow-400\"></i>\n                        </div>\n                        <span class=\"ml-2 text-gray-600\">5.0</span>\n                    </div>\n                    <p class=\"text-gray-600\">Trusted by 10,000+ users</p>\n                </div>\n            </div>\n        </div>\n        \n        <div class=\"lg:w-1/2 relative\">\n            <div class=\"relative rounded-2xl overflow-hidden shadow-2xl transform rotate-1 hover:rotate-0 transition-transform duration-500\">\n                <div class=\"absolute inset-0 bg-gradient-to-br from-blue-50 to-purple-50 opacity-70\"></div>\n                <img class=\"w-full h-auto object-cover\" src=\"https://images.unsplash.com/photo-1551288049-bebda4e38f71?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80\" alt=\"Modern Design\">\n            </div>\n            \n            <!-- Floating Cards -->\n            <div class=\"absolute -top-10 -left-10 bg-white p-4 rounded-xl shadow-lg w-40 animate-slide-in delay-300\">\n                <div class=\"w-8 h-8 rounded-full bg-blue-100 text-blue-500 flex items-center justify-center mb-2\">\n                    <i class=\"fas fa-chart-line\"></i>\n                </div>\n                <h4 class=\"font-bold text-gray-800\">Analytics</h4>\n                <p class=\"text-sm text-gray-600\">Real-time data</p>\n            </div>\n            \n            <div class=\"absolute -bottom-10 -right-10 bg-white p-4 rounded-xl shadow-lg w-40 animate-slide-in delay-500\">\n                <div class=\"w-8 h-8 rounded-full bg-purple-100 text-purple-500 flex items-center justify-center mb-2\">\n                    <i class=\"fas fa-bolt\"></i>\n                </div>\n                <h4 class=\"font-bold text-gray-800\">Speed</h4>\n                <p class=\"text-sm text-gray-600\">Lightning fast</p>\n            </div>\n        </div>\n    </section>\n    \n    <!-- Trusted By Section -->\n    <div class=\"py-16 px-[5%] max-w-7xl mx-auto\">\n        <p class=\"text-center text-gray-500 mb-8\">Trusted by innovative companies worldwide</p>\n        <div class=\"flex flex-wrap justify-center gap-8 md:gap-16 opacity-70\">\n            <div class=\"text-2xl font-bold text-gray-400 hover:text-gray-800 transition-colors cursor-pointer\">Google</div>\n            <div class=\"text-2xl font-bold text-gray-400 hover:text-gray-800 transition-colors cursor-pointer\">Microsoft</div>\n            <div class=\"text-2xl font-bold text-gray-400 hover:text-gray-800 transition-colors cursor-pointer\">Apple</div>\n            <div class=\"text-2xl font-bold text-gray-400 hover:text-gray-800 transition-colors cursor-pointer\">Amazon</div>\n            <div class=\"text-2xl font-bold text-gray-400 hover:text-gray-800 transition-colors cursor-pointer\">Tesla</div>\n        </div>\n    </div>\n\n    <script>\n        // Add scroll effect to navbar\n        window.addEventListener('scroll', function() {\n            const navbar = document.querySelector('nav');\n            if (window.scrollY > 50) {\n                navbar.classList.add('shadow-sm');\n                navbar.classList.remove('bg-white/80');\n                navbar.classList.add('bg-white/95');\n            } else {\n                navbar.classList.remove('shadow-sm');\n                navbar.classList.add('bg-white/80');\n                navbar.classList.remove('bg-white/95');\n            }\n        });\n\n        // Animate elements when they come into view\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    entry.target.classList.add('animate-slide-in');\n                }\n            });\n        }, { threshold: 0.1 });\n\n        document.querySelectorAll('.animate-on-scroll').forEach(el => {\n            observer.observe(el);\n        });\n    </script>\n</body>\n</html>"
