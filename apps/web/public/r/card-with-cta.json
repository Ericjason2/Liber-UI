      "content": "/**\n * Component: Greeting Card with CTA\n * Author: @amit (https://tailwindflex.com/@amit)\n * Source: https://tailwindflex.com/@amit/card-with-cta\n * Attribution: Créé par @amit sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function CardWithCta() {\n  return (\n    <div>\n    <div className=\"px-4 md8 py-12 bg-gray-100 rounded-lg shadow-2xl max-w-xl\">\n    \n      <h1 className=\"text-lg mb-4\">\n        Hey Amit<span className=\"mx-2\" id=\"demo\"></span><span className=\"text-xl\">😄</span>,\n        <br />\n        <span className=\"text-4xl font-semibold\">Have you booked your</span>\n        <span className=\"text-4xl font-semibold text-blue-700\">Seat?</span>\n      </h1>\n    \n      <div className=\"flex flex-col justify-center w-full text-center mt-8 gap-6 sm text-lg font-semibold\">\n        <a href=\"https://tailwindflex.com/@amit\"\n          className=\"py-4 w-full sm40 border border-blue-700 rounded-lg hover2xl hover700 shadow-lg\">\n          Yes\n        </a>\n        <a href=\"https://tailwindflex.com\"\n          className=\"bg-blue-600 w-full sm40 py-4 rounded-lg text-white hover700 shadow-lg\">\n          Book Now\n        </a>\n      </div>\n    \n    </div>\n    \n    \n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
