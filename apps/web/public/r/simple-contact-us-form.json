      "content": "import * as React from \"react\"\n\nfunction SimpleContactUsForm({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"simple-contact-us-form\"\n      className={className}\n      {...props}\n    >\n      <div className=\"flex items-center justify-center p-12\">\n          \n          \n          <div className=\"mx-auto w-full max-w-[550px] bg-white\">\n              <form action=\"https://formbold.com/s/FORM_ID\" method=\"POST\">\n                  <div className=\"mb-5\">\n                      <label htmlFor=\"name\" className=\"mb-3 block text-base font-medium text-[#07074D]\">\n                          Full Name\n                      </label>\n                      <input type=\"text\" name=\"name\" id=\"name\" placeholder=\"Full Name\"\n                          className=\"w-full rounded-md border border-[#e0e0e0] bg-white py-3 px-6 text-base font-medium text-[#6B7280] outline-none focus[#6A64F1] focus\" />\n                  </div>\n                  <div className=\"mb-5\">\n                      <label htmlFor=\"email\" className=\"mb-3 block text-base font-medium text-[#07074D]\">\n                          Email Address\n                      </label>\n                      <input type=\"email\" name=\"email\" id=\"email\" placeholder=\"example.com\"\n                          className=\"w-full rounded-md border border-[#e0e0e0] bg-white py-3 px-6 text-base font-medium text-[#6B7280] outline-none focus[#6A64F1] focus\" />\n                  </div>\n                  <div className=\"mb-5\">\n                      <label htmlFor=\"subject\" className=\"mb-3 block text-base font-medium text-[#07074D]\">\n                          Subject\n                      </label>\n                      <input type=\"text\" name=\"subject\" id=\"subject\" placeholder=\"Enter your subject\"\n                          className=\"w-full rounded-md border border-[#e0e0e0] bg-white py-3 px-6 text-base font-medium text-[#6B7280] outline-none focus[#6A64F1] focus\" />\n                  </div>\n                  <div className=\"mb-5\">\n                      <label htmlFor=\"message\" className=\"mb-3 block text-base font-medium text-[#07074D]\">\n                          Message\n                      </label>\n                      <textarea rows=\"4\" name=\"message\" id=\"message\" placeholder=\"Type your message\"\n                          className=\"w-full resize-none rounded-md border border-[#e0e0e0] bg-white py-3 px-6 text-base font-medium text-[#6B7280] outline-none focus[#6A64F1] focus\"></textarea>\n                  </div>\n                  <div>\n                      <button\n                          className=\"hover rounded-md bg-[#6A64F1] py-3 px-8 text-base font-semibold text-white outline-none\">\n                          Submit\n                      </button>\n                  </div>\n              </form>\n          </div>\n      </div>\n    </div>\n  )\n}\n\nexport { SimpleContactUsForm }\n",
      "type": "registry:ui"
    }
