\">Add to cart</button>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      \n      \n      <div className=\"relative group bg-gray-200 h-[400px] shadow-lg rounded-2xl overflow-hidden\">\n        <img className=\"w-full h-full group-hover64 object-cover rounded-2xl transition-all delay-150 duration-300 ease\" src=\"https://static.nike.com/a/images/t_PDP_1728_v1/f_auto,q_auto,u_126ab356-44d8-4a06-89b4-fcdcc8df0245,c_scale,fl_relative,w_1.0,h_1.0,fl_layer_apply/362cced6-125a-4354-a6e0-f56e747ce4d6/AIR+JORDAN+6+RETRO.png\" />\n        <div className=\"bg-gray-100 dark700 w-full h-40 absolute left-0 bottom-0 -mb-44 group-hover0 rounded-b-2xl transition-all delay-150 duration-300 ease\">\n          <div className=\"p-6\">\n            <div className=\"capitalize flex items-center justify-between gap-4\">\n              <div>\n                <h2 className=\"text-red-600 text-lg font-bold\">Air Jordan 6 Retro</h2>\n                <p className=\"dark100\">men's shoes</p>\n              </div>\n              <div>\n              <p className=\"text-3xl font-bold dark100\">$200</p>\n              </div>\n            </div>\n            <div className=\"block mt-4\">\n              <div className=\"absolute bottom-2 left-5\">\n                <button className=\"bg-red-600 text-gray-100 font-medium py-2.5 px-4 rounded-xl opacity-90 hover100\">Add to cart</button>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      \n      \n      <div className=\"relative group bg-gray-200 h-[400px] shadow-lg rounded-2xl overflow-hidden\">\n        <img className=\"w-full h-full group-hover64 object-cover rounded-2xl transition-all delay-150 duration-300 ease\" src=\"https://static.nike.com/a/images/t_PDP_1728_v1/f_auto,q_auto,u_126ab356-44d8-4a06-89b4-fcdcc8df0245,c_scale,fl_relative,w_1.0,h_1.0,fl_layer_apply/77c98012-1e1a-4d57-8a69-162af8874e58/JORDAN+MVP.png\" />\n        <div className=\"bg-gray-10