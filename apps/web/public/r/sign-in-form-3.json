      "content": "/**\n * Component: Sign in form\n * Author: @lukas-muller (https://tailwindflex.com/@lukas-muller)\n * Source: https://tailwindflex.com/@lukas-muller/sign-in-form-3\n * Attribution: Créé par @lukas-muller sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function SignInForm3() {\n  return (\n    <div>\n    <div className=\"bg-gray-100 flex h-screen items-center justify-center p-4\">\n        <div className=\"w-full max-w-md\">\n            <div className=\"bg-white shadow-md rounded-md p-8\">\n    \n                <img className=\"mx-auto h-12 w-auto\" src=\"https://www.svgrepo.com/show/499664/user-happy.svg\" alt=\"\" />\n    \n                <h2 className=\"mt-6 text-center text-3xl font-bold tracking-tight text-gray-900\">\n                    Sign in to your account\n                </h2>\n    \n    \n                <form className=\"space-y-6 mt-4\" action=\"#\" method=\"POST\">\n                    <div>\n                        <label htmlFor=\"password\" className=\"block text-sm font-medium text-gray-700\">Email</label>\n                        <div className=\"mt-1\">\n                            <input name=\"email\" type=\"email-address\" autoComplete=\"email-address\" required\n                                className=\"px-2 py-3 mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus500 focus focus500 sm\" />\n                        </div>\n                    </div>\n    \n                    <div>\n                        <label htmlFor=\"password\" className=\"block text-sm font-medium text-gray-700\">Password</label>\n                        <div className=\"mt-1\">\n                            <input id=\"password\" name=\"password\" type=\"password\" autoComplete=\"password\" required\n                                className=\"px-2 py-3 mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus500 focus focus500 sm\" />\n                        </div>\n                    </div>\n    \n                    <div>\n                        <button type=\"submit\"\n                            className=\"flex w-full justify-center rounded-md border border-transparent bg-sky-400 py-2 px-4 text-sm font-medium text-white shadow-sm hover75 focus focus2 focus400 focus2\">Sign\n                            In\n                        </button>\n                    </div>\n                </form>\n            </div>\n        </div>\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
  ],
