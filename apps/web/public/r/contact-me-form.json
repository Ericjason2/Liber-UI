      "content": "/**\n * Component: Contact me form\n * Author: @arya (https://tailwindflex.com/@arya)\n * Source: https://tailwindflex.com/@arya/contact-me-form\n * Attribution: Créé par @arya sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function ContactMeForm() {\n  return (\n    <div>\n    <div className=\"h-screen bg-gray-800\">\r\n        <div className=\"pt-10 md20\">\r\n            <div className=\"p-4 md8\">\r\n                <h1 className=\"text-white text-center pb-8 font-light text-4xl md5xl lg6xl\">Contact Me</h1>\r\n                <form className=\"flex flex-col items-center\">\r\n                    <div className=\"md3/4 lg2/3 xl1/2\">\r\n                        <div className=\"flex flex-col md\">\r\n                            <input id=\"name\" type=\"text\"\r\n                                className=\"my-2 py-2 px-4 rounded-md bg-gray-900 text-gray-300 w-full md1/2 md2 outline-none focus2 focus600\"\r\n                                placeholder=\"Name\" />\r\n                            <input id=\"email\" type=\"email\"\r\n                                className=\"my-2 py-2 px-4 rounded-md bg-gray-900 text-gray-300 w-full md1/2 md2 outline-none focus2 focus600\"\r\n                                placeholder=\"Email\" />\r\n                        </div>\r\n                        <input id=\"subject\" type=\"text\" placeholder=\"Subject\"\r\n                            className=\"my-2 py-2 px-4 rounded-md bg-gray-900 text-gray-300 w-full outline-none focus2 focus600\" />\r\n                        <textarea id=\"message\" rows=\"5\" placeholder=\"Say Something\"\r\n                            className=\"my-2 py-2 px-4 rounded-md bg-gray-900 text-gray-300 w-full outline-none focus2 focus600\"></textarea>\r\n                    </div>\r\n                    <button\r\n                        className=\"border-2 text-md mt-5 rounded-md py-2 px-4 bg-blue-600 hover700 text-gray-100 transition duration-300 ease-in-out focus focus2 focus600\">\r\n                        Send Message\r\n                    </button>\r\n                </form>\r\n            </div>\r\n        </div>\r\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
  ],
