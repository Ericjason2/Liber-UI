      "content": "import * as React from \"react\"\n\nfunction CtaResponsive({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"cta-responsive\"\n      className={className}\n      {...props}\n    >\n      \n      <section className=\"bg-gradient-to-r from-purple-500 via-pink-500 to-red-500 rounded-[40px] py-12 px-4 md8\">\n        <div className=\"max-w-7xl mx-auto text-center text-white space-y-6 md8\">\n          <h2 className=\"text-3xl md4xl font-extrabold leading-tight\">\n            Ready to Elevate Your Business?\n          </h2>\n          <p className=\"text-lg md opacity-90\">\n            Join thousands of satisfied customers. Get started today and transform your future!\n          </p>\n          <a\n            href=\"#\"\n            className=\"inline-block bg-white text-purple-600 font-semibold uppercase px-8 py-3 rounded-full shadow-lg hover100 transition duration-300\"\n          >\n            Get Started Now\n          </a>\n        </div>\n      </section>\n    </div>\n  )\n}\n\nexport { CtaResponsive }\n",
      "type": "registry:ui"
    }
  ],
