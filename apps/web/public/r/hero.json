\"round\" d=\"m9 12.75 3 3m0 0 3-3m-3 3v-7.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z\" />\n                </svg>\n              </button>\n            </div>\n          </div>\n          <div>\n            <img src=\"https://images.pexels.com/photos/415829/pexels-photo-415829.jpeg?auto=compress&cs=tinysrgb&w=600\" alt=\"\" className=\"md96 size-72 rounded-full \" />\n          </div>\n        </div>\n      </div>\n    </div>\n    </div>\n  );\n}\n",
