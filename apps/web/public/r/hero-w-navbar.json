      "content": "/**\n * Component: Hero w/ navbar\n * Author: @carla-codes (https://tailwindflex.com/@carla-codes)\n * Source: https://tailwindflex.com/@carla-codes/hero-w-navbar\n * Attribution: Créé par @carla-codes sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function HeroWNavbar() {\n  return (\n    <div>\n    <div>\n      <div className=\"mx-auto max-w-screen-xl px-6 lg8 relative\">\n        <div className=\"relative flex h-16 space-x-10 w-full\">\n          <div className=\"flex justify-start\"><a className=\"flex flex-shrink-0 items-center\" href=\"/\">\n              <img className=\"block h-8 w-auto\" height=\"32\" src=\"https://www.svgrepo.com/show/303650/neo-logo.svg\"  />\n            </a>\n          </div>\n          <div className=\"flex-shrink-0 flex px-2 py-3 items-center space-x-8 flex-1 justify-end justify-self-end \"><a\n              className=\"text-gray-700 hover700 text-sm font-medium\" href=\"/login\">Login</a>\n            <a className=\"text-white bg-gray-800 hover900 inline-flex items-center justify-center px-3 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm \"\n              href=\"/signup\">Sign up</a>\n          </div>\n        </div>\n      </div>\n      <div className=\"max-w-7xl mx-auto relative\">\n        <div className=\"relative py-16 flex justify-center px-4 sm0\">\n          <div className=\"max-w-3xl text-center\">\n            <div className=\"pb-4\">\n              <span className=\"inline-flex items-center rounded-2xl bg-lime-100 px-4 py-1.5 text-xs sm font-serif font-medium text-lime-700\">Unlock the potential of AI in education.</span>\n            </div>\n            <h1 className=\"text-4xl sm5xl font-semibold text-gray-900 xl6xl font-serif !leading-tight\">\n              Discover the future of teaching\n            </h1>\n            <p className=\"mt-4 text-lg sm leading-8 text-gray-800 sm16\" style=\"white-space: pre-line;\">Empower your classroom with cutting-edge AI technology. Whether it's lesson planning or creating interactive learning materials, our AI service has got you covered.</p>\n            <div className=\"mt-8 flex w-full space-x-8 justify-center\"><a\n                href=\"/exercises\"><button className=\"inline-flex items-center justify-center px-4 py-2.5 border border-transparent text-sm font-medium rounded-md shadow-sm focus ring-2 ring-offset-2 ring-transparent ring-offset-transparent disabled400 appearance-none text-white bg-lime-600 hover700 focus500 focus !px-12 !shadow-lg !rounded-full !text-base\"><p>Start now for free</p></button></a>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
