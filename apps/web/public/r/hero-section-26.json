      "content": "/**\n * Component: hero section\n * Author: @omer-fils-elenga (https://tailwindflex.com/@omer-fils-elenga)\n * Source: https://tailwindflex.com/@omer-fils-elenga/hero-section-26\n * Attribution: Créé par @omer-fils-elenga sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function HeroSection26() {\n  return (\n    <div dangerouslySetInnerHTML={{ __html: \"<!DOCTYPE html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"UTF-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\"/>\\n  <title>Watch.ME — 3D Time</title>\\n  \\n  \\n  <link href=\\\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap\\\" rel=\\\"stylesheet\\\">\\n  <style>\\n    body {\\n      margin: 0;\\n      font-family: 'Inter', sans-serif;\\n      background: url('https://i.pinimg.com/1200x/56/39/92/563992d6e4c38d6c100f26b30165ff85.jpg');\\n      background-size:cover;\\n      color: #fff;\\n      overflow: hidden;\\n      cursor: default;\\n    }\\n\\n    #three-canvas {\\n      position: fixed;\\n      top: 0;\\n      left: 0;\\n      width: 100%;\\n      height: 100%;\\n      z-index: -1;\\n    }\\n\\n    .content {\\n      position: relative;\\n      z-index: 10;\\n      display: flex;\\n      flex-direction: column;\\n      align-items: center;\\n      justify-content: center;\\n      min-height: 100vh;\\n      text-align: center;\\n      padding: 2rem;\\n    }\\n\\n    .header {\\n      position: absolute;\\n      top: 2rem;\\n      left: 0;\\n      width: 100%;\\n      display: flex;\\n      justify-content: center;\\n      z-index: 20;\\n    }\\n\\n    .header nav a {\\n      color: rgba(255,255,255,0.7);\\n      text-decoration: none;\\n      margin: 0 1rem;\\n      font-size: 0.9rem;\\n      font-weight: 500;\\n      transition: color 0.3s;\\n    }\\n\\n    .header nav a:hover {\\n      color: white;\\n    }\\n\\n    h1 {\\n      font-weight: 700;\\n      font-size: 3.5rem;\\n      line-height: 1.1;\\n      margin: 1.5rem 0 1rem;\\n    }\\n\\n    h1 span {\\n      background: linear-gradient(135deg, #ff2d75, #ff9ab5);\\n      -webkit-background-clip: text;\\n      background-clip: text;\\n      color: transparent;\\n    }\\n\\n    p {\\n      max-width: 500px;\\n      color: rgba(255,255,255,0.6);\\n      font-size: 1.1rem;\\n      line-height: 1.6;\\n      margin-bottom: 2rem;\\n    }\\n\\n    .buttons {\\n      display: flex;\\n      gap: 1rem;\\n      margin-top: 1.5rem;\\n    }\\n\\n    .btn {\\n      padding: 0.75rem 1.75rem;\\n      border-radius: 999px;\\n      font-weight: 600;\\n      font-size: 0.95rem;\\n      transition: all 0.3s ease;\\n    }\\n\\n    .btn-primary {\\n      background: linear-gradient(135deg, #ff2d75, #ff6ba5);\\n      color: white;\\n      box-shadow: 0 8px 20px rgba(255, 45, 117, 0.35);\\n    }\\n\\n    .btn-primary:hover {\\n      transform: translateY(-2px);\\n      box-shadow: 0 12px 28px rgba(255, 45, 117, 0.5);\\n    }\\n\\n    .btn-secondary {\\n      background: transparent;\\n      border: 1.5px solid rgba(255,255,255,0.2);\\n      color: white;\\n    }\\n\\n    .btn-secondary:hover {\\n      background: rgba(255,255,255,0.05);\\n      border-color: rgba(255,255,255,0.4);\\n    }\\n\\n    @media (max-width: 640px) {\\n      h1 { font-size: 2.5rem; }\\n      .buttons { flex-direction: column; align-items: center; }\\n    }\\n  </style>\\n  \\n</head>\\n<body>\\n  <canvas id=\\\"three-canvas\\\"></canvas>\\n\\n  <div class=\\\"bg-black absolute h-screen w-full z-10 opacity-80\\\">\\n    \\n  </div>\\n\\n  <div class=\\\"header\\\">\\n    <nav class=\\\"flex space-x-6\\\">\\n      <a href=\\\"#\\\">Home</a>\\n      <a href=\\\"#\\\">Watch</a>\\n      <a href=\\\"#\\\">Product</a>\\n      <a href=\\\"#\\\">Contact</a>\\n      <a href=\\\"#\\\">Career</a>\\n    </nav>\\n  </div>\\n\\n  <div class=\\\"content\\\">\\n    <h1>Be on<br/><span>Time.</span></h1>\\n    <p>A dimension of reality that makes change possible — precise, elegant, timeless.</p>\\n    <div class=\\\"buttons\\\">\\n      <a href=\\\"#\\\" class=\\\"btn btn-primary\\\">Get started</a>\\n      <a href=\\\"#\\\" class=\\\"btn btn-secondary\\\">Read more</a>\\n    </div>\\n  </div>\\n\\n  \\n</body>\\n</html>\" }} />\n  );\n}\n",
