    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\n  <title>Watch.ME — 3D Time</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <script src=\"https://cdnjs.cloudflare.com/ajax/libs/three.js/r158/three.min.js\"></script>\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n  <style>\n    body {\n      margin: 0;\n      font-family: 'Inter', sans-serif;\n      background: url('https://i.pinimg.com/1200x/56/39/92/563992d6e4c38d6c100f26b30165ff85.jpg');\n      background-size:cover;\n      color: #fff;\n      overflow: hidden;\n      cursor: default;\n    }\n\n    #three-canvas {\n      position: fixed;\n      top: 0;\n      left: 0;\n      width: 100%;\n      height: 100%;\n      z-index: -1;\n    }\n\n    .content {\n      position: relative;\n      z-index: 10;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      min-height: 100vh;\n      text-align: center;\n      padding: 2rem;\n    }\n\n    .header {\n      position: absolute;\n      top: 2rem;\n      left: 0;\n      width: 100%;\n      display: flex;\n      justify-content: center;\n      z-index: 20;\n    }\n\n    .header nav a {\n      color: rgba(255,255,255,0.7);\n      text-decoration: none;\n      margin: 0 1rem;\n      font-size: 0.9rem;\n      font-weight: 500;\n      transition: color 0.3s;\n    }\n\n    .header nav a:hover {\n      color: white;\n    }\n\n    h1 {\n      font-weight: 700;\n      font-size: 3.5rem;\n      line-height: 1.1;\n      margin: 1.5rem 0 1rem;\n    }\n\n    h1 span {\n      background: linear-gradient(135deg, #ff2d75, #ff9ab5);\n      -webkit-background-clip: text;\n      background-clip: text;\n      color: transparent;\n    }\n\n    p {\n      max-width: 500px;\n      color: rgba(255,255,255,0.6);\n      font-size: 1.1rem;\n      line-height: 1.6;\n      margin-bottom: 2rem;\n    }\n\n    .buttons {\n      display: flex;\n      gap: 1rem;\n      margin-top: 1.5rem;\n    }\n\n    .btn {\n      padding: 0.75rem 1.75rem;\n      border-radius: 999px;\n      font-weight: 600;\n      font-size: 0.95rem;\n      transition: all 0.3s ease;\n    }\n\n    .btn-primary {\n      background: linear-gradient(135deg, #ff2d75, #ff6ba5);\n      color: white;\n      box-shadow: 0 8px 20px rgba(255, 45, 117, 0.35);\n    }\n\n    .btn-primary:hover {\n      transform: translateY(-2px);\n      box-shadow: 0 12px 28px rgba(255, 45, 117, 0.5);\n    }\n\n    .btn-secondary {\n      background: transparent;\n      border: 1.5px solid rgba(255,255,255,0.2);\n      color: white;\n    }\n\n    .btn-secondary:hover {\n      background: rgba(255,255,255,0.05);\n      border-color: rgba(255,255,255,0.4);\n    }\n\n    @media (max-width: 640px) {\n      h1 { font-size: 2.5rem; }\n      .buttons { flex-direction: column; align-items: center; }\n    }\n  </style>\n  <script>\n    tailwind.config = { darkMode: 'class' }\n  </script>\n</head>\n<body>\n  <canvas id=\"three-canvas\"></canvas>\n\n  <div class=\"bg-black absolute h-screen w-full z-10 opacity-80\">\n    \n  </div>\n\n  <div class=\"header\">\n    <nav class=\"flex space-x-6\">\n      <a href=\"#\">Home</a>\n      <a href=\"#\">Watch</a>\n      <a href=\"#\">Product</a>\n      <a href=\"#\">Contact</a>\n      <a href=\"#\">Career</a>\n    </nav>\n  </div>\n\n  <div class=\"content\">\n    <h1>Be on<br/><span>Time.</span></h1>\n    <p>A dimension of reality that makes change possible — precise, elegant, timeless.</p>\n    <div class=\"buttons\">\n      <a href=\"#\" class=\"btn btn-primary\">Get started</a>\n      <a href=\"#\" class=\"btn btn-secondary\">Read more</a>\n    </div>\n  </div>\n\n  <script>\n    // === SCÈNE THREE.JS COMPLÈTE ===\n    const scene = new THREE.Scene();\n    scene.fog = new THREE.FogExp2(0x000000, 0.03);\n\n    const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);\n    camera.position.z = 15;\n\n    const renderer = new THREE.WebGLRenderer({ canvas: document.getElementById('three-canvas'), antialias: true, alpha: true });\n    renderer.setPixelRatio(window.devicePixelRatio);\n    renderer.setSize(window.innerWidth, window.innerHeight);\n    renderer.setClearColor(0x000000, 0);\n\n    // === ARRIÈRE-PLAN : NÉBULEUSE + PARTICULES ===\n    const bgGeometry = new THREE.SphereGeometry(200, 64, 64);\n    const bgMaterial = new THREE.MeshBasicMaterial({\n      color: 0x0a0a1a,\n      side: THREE.BackSide,\n      transparent: true,\n      opacity: 0.2\n    });\n    const bgSphere = new THREE.Mesh(bgGeometry, bgMaterial);\n    scene.add(bgSphere);\n\n    // Particules douces\n    const particleCount = 1200;\n    const particles = new THREE.BufferGeometry();\n    const pos = new Float32Array(particleCount * 3);\n    const colors = new Float32Array(particleCount * 3);\n    const color = new THREE.Color();\n\n    for (let i = 0; i < particleCount; i++) {\n      const i3 = i * 3;\n      pos[i3] = (Math.random() - 0.5) * 400;\n      pos[i3 + 1] = (Math.random() - 0.5) * 400;\n      pos[i3 + 2] = (Math.random() - 0.5) * 400;\n\n      const hue = Math.random() * 0.15 + 0.9; // rose/violet\n      color.setHSL(hue, 0.4, Math.random() * 0.3 + 0.3);\n      colors[i3] = color.r;\n      colors[i3 + 1] = color.g;\n      colors[i3 + 2] = color.b;\n    }\n\n    particles.setAttribute('position', new THREE.BufferAttribute(pos, 3));\n    particles.setAttribute('color', new THREE.BufferAttribute(colors, 3));\n\n    const particleMaterial = new THREE.PointsMaterial({\n      size: 0.8,\n      vertexColors: true,\n      transparent: true,\n      opacity: 0.7,\n      sizeAttenuation: true\n    });\n\n    const particleSystem = new THREE.Points(particles, particleMaterial);\n    scene.add(particleSystem);\n\n    // === MONTRE 3D ===\n    const watchGroup = new THREE.Group();\n\n    // Boîtier (cercle extérieur)\n    const caseGeom = new THREE.TorusGeometry(2.5, 0.12, 16, 64);\n    const caseMat = new THREE.MeshBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0.15 });\n    const watchCase = new THREE.Mesh(caseGeom, caseMat);\n    watchGroup.add(watchCase);\n\n    // Cadran\n    const dialGeom = new THREE.CircleGeometry(2.2, 64);\n    const dialMat = new THREE.MeshBasicMaterial({ color: 0x0f0f1a, side: THREE.DoubleSide });\n    const dial = new THREE.Mesh(dialGeom, dialMat);\n    dial.rotation.x = -Math.PI / 2;\n    watchGroup.add(dial);\n\n    // Marqueurs (heures)\n    const markerGeom = new THREE.BoxGeometry(0.06, 0.4, 0.01);\n    const markerMat = new THREE.MeshBasicMaterial({ color: 0x8888aa });\n    for (let i = 0; i < 12; i++) {\n      const marker = new THREE.Mesh(markerGeom, markerMat);\n      marker.position.y = 1.9;\n      marker.rotation.z = (i / 12) * Math.PI * 2;\n      marker.position.applyAxisAngle(new THREE.Vector3(0, 0, 1), (i / 12) * Math.PI * 2);\n      watchGroup.add(marker);\n    }\n\n    // Aiguilles\n    const hourHand = new THREE.Mesh(new THREE.BoxGeometry(0.06, 0.9, 0.01), new THREE.MeshBasicMaterial({ color: 0xffffff }));\n    const minHand = new THREE.Mesh(new THREE.BoxGeometry(0.04, 1.4, 0.01), new THREE.MeshBasicMaterial({ color: 0xddddff }));\n    const secHand = new THREE.Mesh(new THREE.BoxGeometry(0.02, 1.6, 0.01), new THREE.MeshBasicMaterial({ color: 0xff4488 }));\n\n    hourHand.position.y = 0.45;\n    minHand.position.y = 0.7;\n    secHand.position.y = 0.8;\n\n    watchGroup.add(hourHand, minHand, secHand);\n\n    scene.add(watchGroup);\n    watchGroup.position.y = -2;\n\n    // Lumières douces\n    const ambient = new THREE.AmbientLight(0xffffff, 0.1);\n    scene.add(ambient);\n\n    const spot = new THREE.SpotLight(0xff44aa, 0.8);\n    spot.position.set(5, 5, 10);\n    spot.castShadow = false;\n    scene.add(spot);\n\n    // === INTERACTION SOURIS ===\n    let mouseX = 0, mouseY = 0;\n    const targetX = 0, targetY = 0;\n    const windowHalfX = window.innerWidth / 2;\n    const windowHalfY = window.innerHeight / 2;\n\n    document.addEventListener('mousemove', (e) => {\n      mouseX = (e.clientX - windowHalfX) * 0.002;\n      mouseY = (e.clientY - windowHalfY) * 0.002;\n    });\n\n    // === ANIMATION ===\n    const clock = new THREE.Clock();\n\n    const animate = () => {\n      requestAnimationFrame(animate);\n\n      const time = clock.getElapsedTime();\n\n      // Rotation douce du groupe montre\n      watchGroup.rotation.y = Math.sin(time * 0.1) * 0.1;\n\n      // Aiguilles synchronisées à l’heure réelle\n      const date = new Date();\n      const sec = date.getSeconds();\n      const min = date.getMinutes() + sec / 60;\n      const hour = (date.getHours() % 12) + min / 60;\n\n      secHand.rotation.z = - (sec / 60) * Math.PI * 2;\n      minHand.rotation.z = - (min / 60) * Math.PI * 2;\n      hourHand.rotation.z = - (hour / 12) * Math.PI * 2;\n\n      // Parallaxe caméra\n      camera.position.x += (mouseX * 3 - camera.position.x) * 0.05;\n      camera.position.y += (-mouseY * 3 - camera.position.y) * 0.05;\n      camera.lookAt(scene.position);\n\n      // Rotation lente des particules\n      particleSystem.rotation.y += 0.0002;\n\n      renderer.render(scene, camera);\n    };\n\n    animate();\n\n    // === RESIZE ===\n    window.addEventListener('resize', () => {\n      camera.aspect = window.innerWidth / window.innerHeight;\n      camera.updateProjectionMatrix();\n      renderer.setSize(window.innerWidth, window.innerHeight);\n    });\n  </script>\n</body>\n</html>"
  }
}
