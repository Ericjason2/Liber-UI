    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\" class=\"scroll-smooth\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Badr Nejaa - Web Developer</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <script>\n        tailwind.config = {\n            darkMode: 'class',\n            theme: {\n                extend: {\n                    colors: {\n                        primary: {\n                            light: '#4338ca', // indigo-800\n                            dark: '#f97316', // blue-900\n                        }\n                    }\n                }\n            }\n        }\n    </script>\n    <style>\n        @keyframes fadeInUp {\n            from { opacity: 0; transform: translateY(20px); }\n            to { opacity: 1; transform: translateY(0); }\n        }\n        .animate-fade-in-up {\n            animation: fadeInUp 0.6s ease-out forwards;\n        }\n        .transition-transform {\n            transition-property: transform;\n            transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n            transition-duration: 150ms;\n        }\n    </style>\n</head>\n<body class=\"bg-gray-100 dark:bg-gray-900 text-gray-900 dark:text-gray-100 transition-colors duration-300\">\n    <header class=\"bg-white dark:bg-gray-800 shadow-md fixed w-full z-10 transition-colors duration-300\">\n        <nav class=\"container mx-auto px-6 py-3\">\n            <div class=\"flex justify-between items-center\">\n                <a href=\"#\" class=\"text-2xl font-bold text-primary-light dark:text-primary-dark\">Badr Nejaa</a>\n                <div class=\"hidden md:flex space-x-6\">\n                    <a href=\"#about\" class=\"hover:text-primary-light dark:hover:text-primary-dark transition-colors duration-300\">About</a>\n                    <a href=\"#projects\" class=\"hover:text-primary-light dark:hover:text-primary-dark transition-colors duration-300\">Projects</a>\n                    <a href=\"#contact\" class=\"hover:text-primary-light dark:hover:text-primary-dark transition-colors duration-300\">Contact</a>\n                </div>\n                <div class=\"flex items-center\">\n                    <button id=\"darkModeToggle\" class=\"p-2 rounded-full hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors duration-300 mr-4\" aria-label=\"Toggle dark mode\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-6 w-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z\" />\n                        </svg>\n                    </button>\n                    <button id=\"mobileMenuToggle\" class=\"md:hidden focus:outline-none\" aria-label=\"Toggle mobile menu\">\n                        <svg class=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 6h16M4 12h16M4 18h16\"></path>\n                        </svg>\n                    </button>\n                </div>\n            </div>\n        </nav>\n        <div id=\"mobileMenu\" class=\"md:hidden hidden bg-white dark:bg-gray-800 transition-colors duration-300\">\n            <a href=\"#about\" class=\"block py-2 px-4 text-sm hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors duration-300\">About</a>\n            <a href=\"#projects\" class=\"block py-2 px-4 text-sm hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors duration-300\">Projects</a>\n            <a href=\"#contact\" class=\"block py-2 px-4 text-sm hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors duration-300\">Contact</a>\n        </div>\n    </header>\n\n    <main class=\"container mx-auto px-6 py-20\">\n        <section id=\"about\" class=\"mb-20 pt-16 animate-fade-in-up\">\n            <h1 class=\"text-4xl md:text-6xl font-bold mb-4 text-primary-light dark:text-primary-dark\">Hi, I'm Badr Nejaa</h1>\n            <p class=\"text-xl mb-8\">A passionate web developer creating responsive and accessible websites.</p>\n            <a href=\"#contact\" class=\"bg-primary-light dark:bg-primary-dark text-white px-6 py-3 rounded-full font-semibold hover:bg-opacity-90 transition-colors duration-300\">Get in touch</a>\n        </section>\n\n        <section id=\"projects\" class=\"mb-20 animate-fade-in-up\" style=\"animation-delay: 0.2s;\">\n            <h2 class=\"text-3xl font-bold mb-8 text-primary-light dark:text-primary-dark\">Projects</h2>\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n                <div class=\"bg-white dark:bg-gray-800 p-6 rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300 transform hover:scale-105 transition-transform\">\n                    <h3 class=\"text-xl font-semibold mb-2\">Responsive Blog Platform</h3>\n                    <p class=\"mb-4\">A fully responsive blog platform built with Next.js and Tailwind CSS.</p>\n                    <a href=\"#\" class=\"text-primary-light dark:text-primary-dark hover:underline transition-colors duration-300\">View Project →</a>\n                </div>\n                <div class=\"bg-white dark:bg-gray-800 p-6 rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300 transform hover:scale-105 transition-transform\">\n                    <h3 class=\"text-xl font-semibold mb-2\">Task Management App</h3>\n                    <p class=\"mb-4\">A React-based task management application with drag-and-drop functionality.</p>\n                    <a href=\"#\" class=\"text-primary-light dark:text-primary-dark hover:underline transition-colors duration-300\">View Project →</a>\n                </div>\n                <div class=\"bg-white dark:bg-gray-800 p-6 rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300 transform hover:scale-105 transition-transform\">\n                    <h3 class=\"text-xl font-semibold mb-2\">E-commerce Website</h3>\n                    <p class=\"mb-4\">A full-stack e-commerce platform built with Node.js, Express, and MongoDB.</p>\n                    <a href=\"#\" class=\"text-primary-light dark:text-primary-dark hover:underline transition-colors duration-300\">View Project →</a>\n                </div>\n                <div class=\"bg-white dark:bg-gray-800 p-6 rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300 transform hover:scale-105 transition-transform\">\n                    <h3 class=\"text-xl font-semibold mb-2\">Weather Dashboard</h3>\n                    <p class=\"mb-4\">A weather dashboard using OpenWeatherMap API and Chart.js for data visualization.</p>\n                    <a href=\"#\" class=\"text-primary-light dark:text-primary-dark hover:underline transition-colors duration-300\">View Project →</a>\n                </div>\n            </div>\n        </section>\n\n        <section id=\"contact\" class=\"animate-fade-in-up\" style=\"animation-delay: 0.4s;\">\n            <h2 class=\"text-3xl font-bold mb-8 text-primary-light dark:text-primary-dark\">Get in Touch</h2>\n            <form class=\"max-w-lg mx-auto\">\n                <div class=\"mb-4\">\n                    <label for=\"name\" class=\"block mb-2\">Name</label>\n                    <input type=\"text\" id=\"name\" name=\"name\" class=\"w-full px-4 py-2 rounded-lg bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 focus:outline-none focus:ring-2 focus:ring-primary-light dark:focus:ring-primary-dark transition-all duration-300\" required>\n                </div>\n                <div class=\"mb-4\">\n                    <label for=\"email\" class=\"block mb-2\">Email</label>\n                    <input type=\"email\" id=\"email\" name=\"email\" class=\"w-full px-4 py-2 rounded-lg bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 focus:outline-none focus:ring-2 focus:ring-primary-light dark:focus:ring-primary-dark transition-all duration-300\" required>\n                </div>\n                <div class=\"mb-4\">\n                    <label for=\"message\" class=\"block mb-2\">Message</label>\n                    <textarea id=\"message\" name=\"message\" rows=\"4\" class=\"w-full px-4 py-2 rounded-lg bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 focus:outline-none focus:ring-2 focus:ring-primary-light dark:focus:ring-primary-dark transition-all duration-300\" required></textarea>\n                </div>\n                <button type=\"submit\" class=\"bg-primary-light dark:bg-primary-dark text-white px-6 py-3 rounded-full font-semibold hover:bg-opacity-90 transition-colors duration-300\">Send Message</button>\n            </form>\n        </section>\n    </main>\n\n    <footer class=\"bg-white dark:bg-gray-800 mt-12 transition-colors duration-300\">\n        <div class=\"container mx-auto px-6 py-4 flex flex-col md:flex-row justify-between items-center\">\n            <p>&copy; 2024 Badr NEJAA. All rights reserved.</p>\n            <div class=\"flex space-x-4 mt-4 md:mt-0\">\n                <a href=\"https://github.com/Badrnej?tab=repositories\" class=\"text-gray-600 dark:text-gray-400 hover:text-primary-light dark:hover:text-primary-dark transition-colors duration-300\" aria-label=\"GitHub\">\n                    <svg class=\"w-6 h-6\" fill=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                        <path d=\"M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.3