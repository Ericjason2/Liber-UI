    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Hero Section</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n  <style>\n    body {\n      font-family: 'Inter', sans-serif;\n    }\n  </style>\n</head>\n\n<body class=\"bg-[#f9f9f9]\">\n  <!-- Hero Section -->\n  <section class=\"min-h-screen flex items-center justify-center py-12 md:py-20 px-4 sm:px-6 lg:px-8\">\n    <div class=\"max-w-7xl mx-auto w-full\">\n      <div class=\"flex flex-col lg:grid lg:grid-cols-2 gap-8 md:gap-12 lg:gap-16 items-center\">\n        <!-- Text Content -->\n        <div class=\"text-center lg:text-left order-2 lg:order-1 w-full\">\n          <!-- Badge -->\n          <div class=\"inline-flex items-center px-4 py-2 bg-white rounded-none shadow-sm mb-6\">\n            <span class=\"text-sm font-medium text-gray-500\">Welcome to Our Studio</span>\n          </div>\n\n          <!-- Main Heading -->\n          <h1 class=\"text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-black mb-4 sm:mb-6 leading-tight\">\n            Creating Digital Experiences That\n            <span class=\"text-gray-600 block mt-2\">Drive Results</span>\n          </h1>\n\n          <!-- Description -->\n          <p\n            class=\"text-base sm:text-lg md:text-xl text-gray-600 mb-6 sm:mb-8 leading-relaxed max-w-2xl mx-auto lg:mx-0\">\n            We are a full-service digital agency specializing in web development,\n            UI/UX design, and digital marketing solutions that help businesses\n            grow and succeed in the digital world.\n          </p>\n\n          <!-- CTA Buttons -->\n          <div class=\"flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center lg:justify-start\">\n            <button class=\"px-6 sm:px-8 py-3 sm:py-4 bg-black text-white text-base sm:text-lg font-medium hover:bg-gray-800 transition-colors whitespace-nowrap\">\n                            Get Started Today\n                        </button>\n            <button class=\"px-6 sm:px-8 py-3 sm:py-4 bg-white text-black border border-gray-300 text-base sm:text-lg font-medium hover:bg-gray-50 transition-colors whitespace-nowrap\">\n                            View Our Work\n                        </button>\n          </div>\n\n          <!-- Stats -->\n          <div class=\"grid grid-cols-3 gap-4 sm:gap-6 mt-8 sm:mt-12 pt-6 sm:pt-8 border-t border-gray-200\">\n            <div class=\"text-center lg:text-left\">\n              <div class=\"text-xl sm:text-2xl md:text-3xl font-bold text-black mb-1\">150+</div>\n              <div class=\"text-gray-500 text-xs sm:text-sm\">Projects Done</div>\n            </div>\n            <div class=\"text-center lg:text-left\">\n              <div class=\"text-xl sm:text-2xl md:text-3xl font-bold text-black mb-1\">50+</div>\n              <div class=\"text-gray-500 text-xs sm:text-sm\">Happy Clients</div>\n            </div>\n            <div class=\"text-center lg:text-left\">\n              <div class=\"text-xl sm:text-2xl md:text-3xl font-bold text-black mb-1\">8+</div>\n              <div class=\"text-gray-500 text-xs sm:text-sm\">Years Experience</div>\n            </div>\n          </div>\n        </div>\n\n        <!-- Hero Image/Placeholder - Hidden on mobile and tablet -->\n        <div class=\"relative order-1 lg:order-2 hidden lg:block w-full\">\n          <div class=\"bg-white rounded-none shadow-sm p-6 lg:p-8\">\n            <!-- Main Illustration -->\n            <div class=\"bg-gray-100 h-64 lg:h-80 xl:h-96 rounded-none mb-4 lg:mb-6 flex items-center justify-center\">\n              <div class=\"text-center\">\n                <svg class=\"w-16 lg:w-20 h-16 lg:h-20 text-gray-400 mx-auto mb-3 lg:mb-4\" fill=\"none\"\n                  stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                  <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\"\n                    d=\"M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4\"></path>\n                </svg>\n                <span class=\"text-gray-500 text-base lg:text-lg\">Digital Solution</span>\n              </div>\n            </div>\n\n            <!-- Feature Cards -->\n            <div class=\"grid grid-cols-3 gap-3 lg:gap-4\">\n              <div class=\"bg-gray-50 p-3 lg:p-4 rounded-none text-center\">\n                <svg class=\"w-6 lg:w-8 h-6 lg:h-8 text-gray-400 mx-auto mb-1 lg:mb-2\" fill=\"none\" stroke=\"currentColor\"\n                  viewBox=\"0 0 24 24\">\n                  <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\"\n                    d=\"M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z\">\n                  </path>\n                </svg>\n                <span class=\"text-gray-600 text-xs lg:text-sm\">Web Dev</span>\n              </div>\n              <div class=\"bg-gray-50 p-3 lg:p-4 rounded-none text-center\">\n                <svg class=\"w-6 lg:w-8 h-6 lg:h-8 text-gray-400 mx-auto mb-1 lg:mb-2\" fill=\"none\" stroke=\"currentColor\"\n                  viewBox=\"0 0 24 24\">\n                  <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\"\n                    d=\"M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm8-16a4 4 0 00-4 4v12a4 4 0 004 4h4a2 2 0 002-2V5a2 2 0 00-2-2h-4z\">\n                  </path>\n                </svg>\n                <span class=\"text-gray-600 text-xs lg:text-sm\">UI/UX Design</span>\n              </div>\n              <div class=\"bg-gray-50 p-3 lg:p-4 rounded-none text-center\">\n                <svg class=\"w-6 lg:w-8 h-6 lg:h-8 text-gray-400 mx-auto mb-1 lg:mb-2\" fill=\"none\" stroke=\"currentColor\"\n                  viewBox=\"0 0 24 24\">\n                  <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\"\n                    d=\"M13 7h8m0 0v8m0-8l-8 8-4-4-6 6\"></path>\n                </svg>\n                <span class=\"text-gray-600 text-xs lg:text-sm\">Marketing</span>\n              </div>\n            </div>\n          </div>\n\n          <!-- Floating Elements -->\n          <div class=\"absolute -top-3 -left-3 bg-black text-white px-3 lg:px-4 py-1 lg:py-2 rounded-none shadow-sm\">\n            <span class=\"text-xs lg:text-sm font-medium\">Since 2015</span>\n          </div>\n          <div\n            class=\"absolute -bottom-3 -right-3 bg-white border border-gray-200 px-3 lg:px-4 py-1 lg:py-2 rounded-none shadow-sm\">\n            <span class=\"text-xs lg:text-sm font-medium text-gray-600\">Trusted by 50+ Companies</span>\n          </div>\n        </div>\n      </div>\n\n      <!-- Scroll Indicator -->\n      <div class=\"text-center mt-12 lg:mt-16\">\n        <div class=\"inline-flex flex-col items-center text-gray-400\">\n          <span class=\"text-xs sm:text-sm mb-2\">Scroll to explore</span>\n          <svg class=\"w-4 h-4 sm:w-5 sm:h-5 animate-bounce\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 14l-7 7m0 0l-7-7m7 7V3\"></path>\n          </svg>\n        </div>\n      </div>\n    </div>\n  </section>\n</body>\n\n</html>"
