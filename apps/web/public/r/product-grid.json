ass=\"text-lg font-semibold mt-1\">Wild Journey</h3>\n                        \n                        <div class=\"mt-2\">\n                            <span class=\"text-gray-700 font-bold text-xl\">$35.00</span>\n                        </div>\n\n                        <div class=\"mt-2 flex items-center gap-1\">\n                            <i data-lucide=\"star\" class=\"w-4 h-4 fill-yellow-400 text-yellow-400\"></i>\n                            <i data-lucide=\"star\" class=\"w-4 h-4 fill-yellow-400 text-yellow-400\"></i>\n                            <i data-lucide=\"star\" class=\"w-4 h-4 fill-yellow-400 text-yellow-400\"></i>\n                            <i data-lucide=\"star\" class=\"w-4 h-4 fill-yellow-400 text-yellow-400\"></i>\n                            <i data-lucide=\"star\" class=\"w-4 h-4 text-gray-300\"></i>\n                            <span class=\"text-sm text-gray-500 ml-1\">(4.5)</span>\n                        </div>\n                    </div>\n\n                    <button class=\"w-full bg-black py-4 text-white hover:bg-gray-800 transition-colors flex items-center justify-center gap-2 font-medium\">\n                        <i data-lucide=\"shopping-cart\" class=\"w-5 h-5\"></i>\n                        Add to Cart\n                    </button>\n                </article>\n\n                <!-- Product 2 -->\n                <article class=\"overflow-hidden rounded-2xl bg-white flex flex-col shadow-sm hover:shadow-md transition-shadow\">\n                    <figure class=\"flex-1\">\n                        <img \n                            src=\"https://placehold.co/300?text=Summer+Vibes\" \n                            alt=\"Summer Vibes T-shirt - Comfort fit\" \n                            class=\"w-full object-cover aspect-square\"\n                            loading=\"lazy\"\n                        />\n                    </figure>\n\n                    <div class=\"p-4 flex-1\">\n                        <span class=\"text-s