    "mention": "Créé par @antifaq sur TailwindFlex",
    "rawHtml": "<!DOCTYPE html>\n<html lang=\"ru\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Server Admin Panel</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        @keyframes pulse-slow {\n            0%, 100% { opacity: 1; }\n            50% { opacity: 0.5; }\n        }\n        .pulse-slow {\n            animation: pulse-slow 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;\n        }\n        @keyframes slideIn {\n            from { transform: translateY(-10px); opacity: 0; }\n            to { transform: translateY(0); opacity: 1; }\n        }\n        .slide-in {\n            animation: slideIn 0.3s ease-out;\n        }\n        .gradient-bg {\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n        }\n        .glass {\n            background: rgba(255, 255, 255, 0.05);\n            backdrop-filter: blur(10px);\n            border: 1px solid rgba(255, 255, 255, 0.1);\n        }\n        .chart-line {\n            stroke-dasharray: 1000;\n            stroke-dashoffset: 1000;\n            animation: draw 2s ease-out forwards;\n        }\n        @keyframes draw {\n            to { stroke-dashoffset: 0; }\n        }\n    </style>\n</head>\n<body class=\"bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900 min-h-screen text-white\">\n    <!-- Sidebar -->\n    <aside class=\"fixed left-0 top-0 h-screen w-64 glass border-r border-white/10 z-50\">\n        <div class=\"p-6\">\n            <div class=\"flex items-center gap-3 mb-8\">\n                <div class=\"w-10 h-10 rounded-xl bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center\">\n                    <svg class=\"w-6 h-6\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n                        <path d=\"M3 4a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1V4zM3 10a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H4a1 1 0 01-1-1v-6zM14 9a1 1 0 00-1 1v6a1 1 0 001 1h2a1 1 0 001-1v-6a1 1 0 00-1-1h-2z\"/>\n                    </svg>\n                </div>\n                <div>\n                    <h1 class=\"text-xl font-bold\">ServerHub</h1>\n                    <p class=\"text-xs text-gray-400\">Admin Panel</p>\n                </div>\n            </div>\n\n            <nav class=\"space-y-2\">\n                <a href=\"#\" class=\"flex items-center gap-3 px-4 py-3 rounded-xl bg-white/10 text-white\">\n                    <svg class=\"w-5 h-5\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n                        <path d=\"M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z\"/>\n                    </svg>\n                    <span>Дашборд</span>\n                </a>\n                <a href=\"#\" class=\"flex items-center gap-3 px-4 py-3 rounded-xl text-gray-400 hover:bg-white/5 hover:text-white transition\">\n                    <svg class=\"w-5 h-5\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n                        <path fill-rule=\"evenodd\" d=\"M2 5a2 2 0 012-2h12a2 2 0 012 2v10a2 2 0 01-2 2H4a2 2 0 01-2-2V5zm3.293 1.293a1 1 0 011.414 0l3 3a1 1 0 010 1.414l-3 3a1 1 0 01-1.414-1.414L7.586 10 5.293 7.707a1 1 0 010-1.414zM11 12a1 1 0 100 2h3a1 1 0 100-2h-3z\"/>\n                    </svg>\n                    <span>Серверы</span>\n                    <span class=\"ml-auto bg-purple-500 text-xs px-2 py-1 rounded-full\">12</span>\n                </a>\n                <a href=\"#\" class=\"flex items-center gap-3 px-4 py-3 rounded-xl text-gray-400 hover:bg-white/5 hover:text-white transition\">\n                    <svg class=\"w-5 h-5\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n                        <path d=\"M9 2a1 1 0 000 2h2a1 1 0 100-2H9z\"/>\n                        <path fill-rule=\"evenodd\" d=\"M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 100-2H7zm3 0a1 1 0 100 2h3a1 1 0 100-2h-3z\"/>\n                    </svg>\n                    <span>Мониторинг</span>\n                </a>\n                <a href=\"#\" class=\"flex items-center gap-3 px-4 py-3 rounded-xl text-gray-400 hover:bg-white/5 hover:text-white transition\">\n                    <svg class=\"w-5 h-5\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n                        <path d=\"M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z\"/>\n                    </svg>\n                    <span>Пользователи</span>\n                </a>\n                <a href=\"#\" class=\"flex items-center gap-3 px-4 py-3 rounded-xl text-gray-400 hover:bg-white/5 hover:text-white transition\">\n                    <svg class=\"w-5 h-5\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n                        <path fill-rule=\"evenodd\" d=\"M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z\"/>\n                    </svg>\n                    <span>Логи</span>\n                </a>\n                <a href=\"#\" class=\"flex items-center gap-3 px-4 py-3 rounded-xl text-gray-400 hover:bg-white/5 hover:text-white transition\">\n                    <svg class=\"w-5 h-5\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n                        <path fill-rule=\"evenodd\" d=\"M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z\"/>\n                    </svg>\n                    <span>Настройки</span>\n                </a>\n            </nav>\n        </div>\n\n        <div class=\"absolute bottom-6 left-6 right-6\">\n            <div class=\"glass rounded-xl p-4\">\n                <div class=\"flex items-center gap-3\">\n                    <div class=\"w-10 h-10 rounded-full bg-gradient-to-br from-green-400 to-blue-500\"></div>\n                    <div class=\"flex-1\">\n                        <p class=\"font-medium text-sm\">Admin User</p>\n                        <p class=\"text-xs text-gray-400\">admin@server.com</p>\n                    </div>\n                    <button class=\"p-1 hover:bg-white/5 rounded\">\n                        <svg class=\"w-5 h-5\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n                            <path fill-rule=\"evenodd\" d=\"M3 3a1 1 0 00-1 1v12a1 1 0 102 0V4a1 1 0 00-1-1zm10.293 9.293a1 1 0 001.414 1.414l3-3a1 1 0 000-1.414l-3-3a1 1 0 10-1.414 1.414L14.586 9H7a1 1 0 100 2h7.586l-1.293 1.293z\"/>\n                        </svg>\n                    </button>\n                </div>\n            </div>\n        </div>\n    </aside>\n\n    <!-- Main Content -->\n    <main class=\"ml-64 p-8\">\n        <!-- Header -->\n        <header class=\"flex items-center justify-between mb-8\">\n            <div>\n                <h2 class=\"text-3xl font-bold mb-1\">Добро пожаловать назад! 👋</h2>\n                <p class=\"text-gray-400\">Вот что происходит с вашими серверами сегодня</p>\n            </div>\n            <div class=\"flex items-center gap-4\">\n                <div class=\"relative\">\n                    <input type=\"text\" placeholder=\"Поиск...\" class=\"bg-white/10 border border-white/10 rounded-xl px-4 py-2 pl-10 focus:outline-none focus:border-purple-500 w-64\">\n                    <svg class=\"w-5 h-5 absolute left-3 top-2.5 text-gray-400\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n                        <path fill-rule=\"evenodd\" d=\"M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z\"/>\n                    </svg>\n                </div>\n                <button class=\"relative p-2 hover:bg-white/5 rounded-xl\">\n                    <svg class=\"w-6 h-6\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n                        <path d=\"M10 2a6 6 0 00-6 6v3.586l-.707.707A1 1 0 004 14h12a1 1 0 00.707-1.707L16 11.586V8a6 6 0 00-6-6zM10 18a3 3 0 01-3-3h6a3 3 0 01-3 3z\"/>\n                    </svg>\n                    <span class=\"absolute top-1 right-1 w-2 h-2 bg-red-500 rounded-full pulse-slow\"></span>\n                </button>\n            </div>\n        </header>\n\n        <!-- Stats Cards -->\n        <div class=\"grid grid-cols-4 gap-6 mb-8\">\n            <div class=\"glass rounded-2xl p-6 slide-in hover:scale-105 transition transform cursor-pointer\">\n                <div class=\"flex items-center justify-between mb-4\">\n                    <div class=\"p-3 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl\">\n                        <svg class=\"w-6 h-6\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n                            <path fill-rule=\"evenodd\" d=\"M2 5a2 2 0 012-2h12a2 2 0 012 2v10a2 2 0 01-2 2H4a2 2 0 01-2-2V5zm3.293 1.293a1 1 0 011.414 0l3 3a1 1 0 010 1.414l-3 3a1 1 0 01-1.414-1.414L7.586 10 5.293 7.707a1 1 0 010-1.414zM11 12a1 1 0 100 2h3a1 1 0 100-2h-3z\"/>\n                        </svg>\n                    </div>\n                    <span class=\"text-xs px-2 py-1 bg-green-500/20 text-green-400 rounded-full\">+12%</span>\n                </div>\n                <h3 class=\"text-gray-400 text-sm mb-1\">Активных серверов</h3>\n                <p class=\"text-3xl font-bold\">12</p>\n            </div>\n\n            <div class=\"glass rounded-2xl p-6 slide-in hover:scale-105 transition transform cursor-pointer\" style=\"animation-delay: 0.1s\">\n                <div class=\"flex items-center justify-between mb-4\">\n                    <div class=\"p-3 bg-gradient-to-br from-purple-500 to-purple-600 rounded-xl\">\n                        <svg class=\"w-6 h-6\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n                            <path d=\"M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z\"/>\n                        </svg>\n                    </div>\n                    <span class=\"text-xs px-2 py-1 bg-green-500/20 text-green-400 rounded-full\">+8%</span>\n                </div>\n                <h3 class=\"text-gray-400 text-sm mb-1\">Онлайн пользователей</h3>\n                <p class=\"text-3xl font-bold\">1,248</p>\n            </div>\n\n            <div class=\"glass rounded-2xl p-6 slide-in hover:scale-105 transition transform cursor-pointer\" style=\"animation-delay: 0.2s\">\n                <div class=\"flex items-center justify-between mb-4\">\n                    <div class=\"p-3 bg-gradient-to-br from-pink-500 to-pink-600 rounded-xl\">\n                        <svg class=\"w-6 h-6\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n                            <path fill-rule=\"evenodd\" d=\"M12 7a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0V8.414l-4.293 4.293a1 1 0 01-1.414 0L8 10.414l-4.293 4.293a1 1 0 01-1.414-1.414l5-5a1 1 0 011.414 0L11 10.586 14.586 7H12z\"/>\n                        </svg>\n                    </div>\n                    <span class=\"text-xs px-2 py-1 bg-red-500/20 text-red-400 rounded-full\">-3%</span>\n                </div>\n                <h3 class=\"text-gray-400 text-sm mb-1\">CPU нагрузка</h3>\n                <p class=\"text-3xl font-bold\">34%</p>\n            </div>\n\n            <div class=\"glass rounded-2xl p-6 slide-in hover:scale-105 transition transform cursor-pointer\" style=\"animation-delay: 0.3s\">\n                <div class=\"flex items-center justify-between mb-4\">\n                    <div class=\"p-3 bg-gradient-to-br from-green-500 to-green-600 rounded-xl\">\n                        <svg class=\"w-6 h-6\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n                            <path d=\"M3 12v3c0 1.657 3.134 3 7 3s7-1.343 7-3v-3c0 1.657-3.134 3-7 3s-7-1.343-7-3z\"/>\n                            <path d=\"M3 7v3c0 1.657 3.134 3 7 3s7-1.343 7-3V7c0 1.657-3.134 3-7 3S3 8.657 3 7z\"/>\n                            <path d=\"M17 5c0 1.657-3.134 3-7 3S3 6.657 3 5s3.134-3 7-3 7 1.343 7 3z\"/>\n                        </svg>\n                    </div>\n                    <span class=\"text-xs px-2 py-1 bg-green-500/20 text-green-400 rounded-full\">Норма</span>\n                </div>\n                <h3 class=\"text-gray-400 text-sm mb-1\">Свободно RAM</h3>\n                <p class=\"text-3xl font-bold\">24 GB</p>\n            </div>\n        </div>\n\n        <!-- Charts Section -->\n        <div class=\"grid grid-cols-3 gap-6 mb-8\">\n            <!-- Server Performance -->\n            <div class=\"col-span-2 glass rounded-2xl p-6\">\n                <div class=\"flex items-center justify-between mb-6\">\n                    <h3 class=\"text-xl font-bold\">Производительность серверов</h3>\n                    <div class=\"flex gap-2\">\n                        <button class=\"px-3 py-1 text-xs bg-white/10 rounded-lg hover:bg-white/20\">1Ч</button>\n                        <button class=\"px-3 py-1 text-xs bg-purple-500 rounded-lg\">24Ч</button>\n                        <button class=\"px-3 py-1 text-xs bg-white/10 rounded-lg hover:bg-white/20\">7Д</button>\n                        <button class=\"px-3 py-1 text-xs bg-white/10 rounded-lg hover:bg-white/20\">30Д</button>\n                    </div>\n                </div>\n                <svg viewBox=\"0 0 600 200\" class=\"w-full\">\n                    <defs>\n                        <linearGradient id=\"gradient\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n                            <stop offset=\"0%\" style=\"stop-color:rgb(139,92,246);stop-opacity:0.3\" />\n                            <stop offset=\"100%\" style=\"stop-color:rgb(139,92,246);stop-opacity:0\" />\n                        </linearGradient>\n                    </defs>\n                    <path d=\"M0,150 L50,120 L100,140 L150,80 L200,100 L250,60 L300,90 L350,70 L400,110 L450,85 L500,95 L550,65 L600,75 L600,200 L0,200 Z\" fill=\"url(#gradient)\"/>\n                    <path class=\"chart-line\" d=\"M0,150 L50,120 L100,140 L150,80 L200,100 L250,60 L300,90 L350,70 L400,110 L450,85 L500,95 L550,65 L600,75\" fill=\"none\" stroke=\"rgb(139,92,246)\" stroke-width=\"3\"/>\n                </svg>\n                <div class=\"flex items-center justify-between mt-4 text-xs text-gray-400\">\n                    <span>00:00</span>\n                    <span>06:00</span>\n                    <span>12:00</span>\n                    <span>18:00</span>\n                    <span>24:00</span>\n                </div>\n            </div>\n\n            <!-- Server Status -->\n            <div class=\"glass rounded-2xl p-6\">\n                <h3 class=\"text-xl font-bold mb-6\">Статус серверов</h3>\n                <div class=\"space-y-4\">\n                    <div class=\"flex items-center justify-between p-3 bg-white/5 rounded-xl\">\n                        <div class=\"flex items-center gap-3\">\n                            <div class=\"w-2 h-2 bg-green-500 rounded-full pulse-slow\"></div>\n                            <span class=\"text-sm\">Web Server</span>\n                        </div>\n                        <span class=\"text-xs text-green-400\">Онлайн</span>\n                    </div>\n         