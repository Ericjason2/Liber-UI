llow-500 rounded-full pulse-slow\\\"></div>\\n                            <span class=\\\"text-sm\\\">API Server</span>\\n                        </div>\\n                        <span class=\\\"text-xs text-yellow-400\\\">Предупр.</span>\\n                    </div>\\n                    <div class=\\\"flex items-center justify-between p-3 bg-white/5 rounded-xl\\\">\\n                        <div class=\\\"flex items-center gap-3\\\">\\n                            <div class=\\\"w-2 h-2 bg-green-500 rounded-full pulse-slow\\\"></div>\\n                            <span class=\\\"text-sm\\\">CDN Server</span>\\n                        </div>\\n                        <span class=\\\"text-xs text-green-400\\\">Онлайн</span>\\n                    </div>\\n                    <div class=\\\"flex items-center justify-between p-3 bg-white/5 rounded-xl\\\">\\n                        <div class=\\\"flex items-center gap-3\\\">\\n                            <div class=\\\"w-2 h-2 bg-red-500 rounded-full pulse-slow\\\"></div>\\n                            <span class=\\\"text-sm\\\">Mail Server</span>\\n                        </div>\\n                        <span class=\\\"text-xs text-red-400\\\">Офлайн</span>\\n                    </div>\\n                </div>\\n            </div>\\n        </div>\\n\\n        <!-- Recent Activity -->\\n        <div class=\\\"glass rounded-2xl p-6\\\">\\n            <h3 class=\\\"text-xl font-bold mb-6\\\">Последняя активность</h3>\\n            <div class=\\\"space-y-4\\\">\\n                <div class=\\\"flex items-center gap-4 p-4 bg-white/5 rounded-xl hover:bg-white/10 transition cursor-pointer\\\">\\n                    <div class=\\\"p-2 bg-blue-500/20 rounded-lg\\\">\\n                        <svg class=\\\"w-5 h-5 text-blue-400\\\" fill=\\\"currentColor\\\" viewBox=\\\"0 0 20 20\\\">\\n                            <path fill-rule=\\\"evenodd\\\" d=\\\"M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2