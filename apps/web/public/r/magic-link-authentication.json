      "content": "/**\n * Component: Magic Link Authentication\n * Author: @jugendra-gangwar (https://tailwindflex.com/@jugendra-gangwar)\n * Source: https://tailwindflex.com/@jugendra-gangwar/magic-link-authentication\n * Attribution: Créé par @jugendra-gangwar sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function MagicLinkAuthentication() {\n  return (\n    <div>\n    <div className=\"min-h-screen bg-gradient-to-br from-slate-100 via-white to-sky-100 flex items-center justify-center p-6\">\n      <div className=\"w-full max-w-md\">\n        <div className=\"rounded-[28px] border border-white/70 bg-white/80 p-8 shadow-2xl backdrop-blur-xl\">\n          <div className=\"mt-6 text-center\">\n            <h1 className=\"text-3xl text-slate-900\">Sign in with Magic Link</h1>\n            <p className=\"mt-3 text-sm leading-6 text-slate-500\">\n              Enter your email and we'll send you a secure link to sign in instantly — no password required.\n            </p>\n          </div>\n          <form className=\"mt-8 space-y-5\">\n            <div>\n              <label className=\"mb-2 block text-sm font-medium text-slate-700\">\n                Email Address\n              </label>\n              <div className=\"relative\">\n                <span className=\"pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4\">\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"h-5 w-5 text-slate-400\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" strokeWidth=\"1.8\">\n                    <rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/>\n                    <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M3 7l9 6 9-6\"/>\n                  </svg>\n                </span>\n                <input\n                  type=\"email\"\n                  placeholder=\"john.com\"\n                  className=\"w-full rounded-xl border border-slate-200 bg-white py-3 pl-11 pr-4 text-sm outline-none transition focus500 focus4 focus100\"\n                 />\n              </div>\n            </div>\n            <button className=\"w-full rounded-xl bg-slate-900 py-3.5 text-sm font-semibold text-white shadow-lg shadow-slate-900/20 transition hover800\">\n              Send Magic Link\n            </button>\n          </form>\n          <div className=\"my-7 flex items-center\">\n            <div className=\"h-px flex-1 bg-slate-200\"></div>\n            <span className=\"px-3 text-xs uppercase tracking-wider text-slate-400\">Secure Access</span>\n            <div className=\"h-px flex-1 bg-slate-200\"></div>\n          </div>\n          <div className=\"space-y-4\">\n            <div className=\"flex items-start gap-3\">\n              <div className=\"flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"h-5 w-5 text-emerald-600\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" strokeWidth=\"1.8\">\n                  <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M5 13l4 4L19 7\"/>\n                </svg>\n              </div>\n              <div>\n                <p className=\"text-sm font-semibold text-slate-800\">Passwordless Login</p>\n                <p className=\"text-xs text-slate-500\">A unique encrypted link is generated for every sign in.</p>\n              </div>\n            </div>\n            <div className=\"flex items-start gap-3\">\n              <div className=\"flex h-10 w-10 items-center justify-center rounded-xl bg-violet-50\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"h-5 w-5 text-violet-600\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" strokeWidth=\"1.8\">\n                  <circle cx=\"12\" cy=\"12\" r=\"9\"/>\n                  <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M12 7v5l3 2\"/>\n                </svg>\n              </div>\n              <div>\n                <p className=\"text-sm font-semibold text-slate-800\">Expires in 10 Minutes</p>\n                <p className=\"text-xs text-slate-500\">The magic link automatically becomes invalid after expiry.</p>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
