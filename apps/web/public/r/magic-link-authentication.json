    "rawHtml": "<div class=\"min-h-screen bg-gradient-to-br from-slate-100 via-white to-sky-100 flex items-center justify-center p-6\">\n  <div class=\"w-full max-w-md\">\n    <div class=\"rounded-[28px] border border-white/70 bg-white/80 p-8 shadow-2xl backdrop-blur-xl\">\n      <div class=\"mt-6 text-center\">\n        <h1 class=\"text-3xl text-slate-900\">Sign in with Magic Link</h1>\n        <p class=\"mt-3 text-sm leading-6 text-slate-500\">\n          Enter your email and we'll send you a secure link to sign in instantly — no password required.\n        </p>\n      </div>\n      <form class=\"mt-8 space-y-5\">\n        <div>\n          <label class=\"mb-2 block text-sm font-medium text-slate-700\">\n            Email Address\n          </label>\n          <div class=\"relative\">\n            <span class=\"pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-slate-400\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"1.8\">\n                <rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/>\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M3 7l9 6 9-6\"/>\n              </svg>\n            </span>\n            <input\n              type=\"email\"\n              placeholder=\"john@example.com\"\n              class=\"w-full rounded-xl border border-slate-200 bg-white py-3 pl-11 pr-4 text-sm outline-none transition focus:border-sky-500 focus:ring-4 focus:ring-sky-100\"\n            >\n          </div>\n        </div>\n        <button class=\"w-full rounded-xl bg-slate-900 py-3.5 text-sm font-semibold text-white shadow-lg shadow-slate-900/20 transition hover:bg-slate-800\">\n          Send Magic Link\n        </button>\n      </form>\n      <div class=\"my-7 flex items-center\">\n        <div class=\"h-px flex-1 bg-slate-200\"></div>\n        <span class=\"px-3 text-xs uppercase tracking-wider text-slate-400\">Secure Access</span>\n        <div class=\"h-px flex-1 bg-slate-200\"></div>\n      </div>\n      <div class=\"space-y-4\">\n        <div class=\"flex items-start gap-3\">\n          <div class=\"flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-emerald-600\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"1.8\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M5 13l4 4L19 7\"/>\n            </svg>\n          </div>\n          <div>\n            <p class=\"text-sm font-semibold text-slate-800\">Passwordless Login</p>\n            <p class=\"text-xs text-slate-500\">A unique encrypted link is generated for every sign in.</p>\n          </div>\n        </div>\n        <div class=\"flex items-start gap-3\">\n          <div class=\"flex h-10 w-10 items-center justify-center rounded-xl bg-violet-50\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-violet-600\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"1.8\">\n              <circle cx=\"12\" cy=\"12\" r=\"9\"/>\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 7v5l3 2\"/>\n            </svg>\n          </div>\n          <div>\n            <p class=\"text-sm font-semibold text-slate-800\">Expires in 10 Minutes</p>\n            <p class=\"text-xs text-slate-500\">The magic link automatically becomes invalid after expiry.</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>"
