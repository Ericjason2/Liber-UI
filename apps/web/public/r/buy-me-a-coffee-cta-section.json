      "content": "/**\n * Component: Buy Me a Coffee CTA section\n * Author: @sienna (https://tailwindflex.com/@sienna)\n * Source: https://tailwindflex.com/@sienna/buy-me-a-coffee-cta-section\n * Attribution: Créé par @sienna sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function BuyMeACoffeeCtaSection() {\n  return (\n    <div>\n    <div className=\"bg-gray-100 dark800 py-8 px-4 sm6 lg8\">\n        <div className=\"max-w-7xl mx-auto\">\n            <div className=\"max-w-3xl mx-auto text-center\">\n                <h2 className=\"text-3xl font-extrabold text-gray-900 dark sm4xl\">\n                    Enjoying my content?\n                </h2>\n                <p className=\"mt-3 text-xl text-gray-500 dark400 sm4\">\n                    Consider buying me a coffee to support my work!\n                </p>\n                <div className=\"mt-8\">\n                    <img className=\"mx-auto h-14\" src=\"https://cdn.buymeacoffee.com/buttons/v2/default-yellow.png\" alt=\"Buy Me a Coffee\" />\n                </div>\n            </div>\n        </div>\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
