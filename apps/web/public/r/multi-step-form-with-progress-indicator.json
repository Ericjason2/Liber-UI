      "content": "import * as React from \"react\"\n\nfunction MultiStepFormWithProgressIndicator({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"multi-step-form-with-progress-indicator\"\n      className={className}\n      {...props}\n    >\n      <div className=\"min-h-screen flex items-center justify-center\">\n          <div className=\"w-full max-w-lg bg-white shadow-lg rounded-lg p-8\">\n            \n            <div className=\"flex items-center justify-between mb-8\">\n              <div className=\"flex items-center gap-4 w-full\">\n                \n                <div className=\"relative flex-1 flex items-center\">\n                  <div id=\"indicator-1\" className=\"w-10 h-10 flex items-center justify-center bg-purple-600 text-white rounded-full transition-colors duration-300\">1</div>\n                  <div id=\"line-1\" className=\"absolute w-full h-1 bg-gray-300 left-0 top-1/2 transform translate-y-[-50%] z-[-1] transition-colors duration-300\"></div>\n                </div>\n                \n                <div className=\"relative flex-1 flex items-center\">\n                  <div id=\"indicator-2\" className=\"w-10 h-10 flex items-center justify-center bg-gray-300 text-gray-600 rounded-full transition-colors duration-300\">2</div>\n                  <div id=\"line-2\" className=\"absolute w-full h-1 bg-gray-300 left-0 top-1/2 transform translate-y-[-50%] z-[-1] transition-colors duration-300\"></div>\n                </div>\n                \n                <div>\n                  <div id=\"indicator-3\" className=\"w-10 h-10 flex items-center justify-center bg-gray-300 text-gray-600 rounded-full transition-colors duration-300\">3</div>\n                </div>\n              </div>\n            </div>\n      \n            \n            <div className=\"w-full bg-gray-200 rounded-full h-2 mb-8\">\n              <div id=\"progress-bar\" className=\"bg-purple-600 h-2 rounded-full transition-all duration-300\" style={{ width: \"0%\" }}></div>\n            </div>\n      \n            \n            <form id=\"multi-step-form\">\n              \n              <div id=\"step-1\" className=\"step\">\n                <h2 className=\"text-xl font-semibold mb-4\">Step 1: Personal Info</h2>\n                <div className=\"space-y-4\">\n                  <input type=\"text\" placeholder=\"Name\" className=\"w-full border border-gray-300 rounded-lg p-3 focus:outline-purple-500\" />\n                  <input type=\"email\" placeholder=\"Email\" className=\"w-full border border-gray-300 rounded-lg p-3 focus:outline-purple-500\" />\n                </div>\n              </div>\n      \n              \n              <div id=\"step-2\" className=\"step hidden\">\n                <h2 className=\"text-xl font-semibold mb-4\">Step 2: Address</h2>\n                <div className=\"space-y-4\">\n                  <input type=\"text\" placeholder=\"Street Address\" className=\"w-full border border-gray-300 rounded-lg p-3 focus:outline-purple-500\" />\n                  <input type=\"text\" placeholder=\"City\" className=\"w-full border border-gray-300 rounded-lg p-3 focus:outline-purple-500\" />\n                  <input type=\"text\" placeholder=\"Postal Code\" className=\"w-full border border-gray-300 rounded-lg p-3 focus:outline-purple-500\" />\n                </div>\n              </div>\n      \n              \n              <div id=\"step-3\" className=\"step hidden\">\n                <h2 className=\"text-xl font-semibold mb-4\">Step 3: Review & Submit</h2>\n                <p className=\"mb-4\">Please review your information before submitting.</p>\n                <ul className=\"list-disc pl-5 space-y-2\">\n                  <li><strong>Name:</strong> <span id=\"review-name\">John Doe</span></li>\n                  <li><strong>Email:</strong> <span id=\"review-email\">john.doe@example.com</span></li>\n                  <li><strong>Address:</strong> <span id=\"review-address\">123 Main St, City, 12345</span></li>\n                </ul>\n              </div>\n      \n              \n              <div className=\"flex justify-between mt-8\">\n                <button id=\"prev-btn\" type=\"button\" className=\"bg-gray-300 text-gray-700 px-6 py-2 rounded-lg hidden\">Previous</button>\n                <button id=\"next-btn\" type=\"button\" className=\"bg-purple-600 text-white px-6 py-2 rounded-lg\">Next</button>\n              </div>\n            </form>\n          </div>\n        </div>\n    </div>\n  )\n}\n\nexport { MultiStepFormWithProgressIndicator }\n",
      "type": "registry:ui"
    }
  ],
