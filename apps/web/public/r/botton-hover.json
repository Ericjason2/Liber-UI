      "content": "/**\n * Component: Botton hover\n * Author: @andresandaar (https://tailwindflex.com/@andresandaar)\n * Source: https://tailwindflex.com/@andresandaar/botton-hover\n * Attribution: Créé par @andresandaar sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function BottonHover() {\n  return (\n    <div>\n    <button className=\"\n            group\n            p-5\n            cursor-pointer \n            relative  \n            text-xl \n            font-normal \n            border-0 \n            flex \n            items-center \n            justify-center\n            bg-transparent\n             text-red-500 \n             h-auto  \n             w-[170px]  \n             overflow-hidden   \n             transition-all\n             duration-100\">\n            <span className=\"\n            group-hover\n            absolute \n            left-0 \n            h-full \n            w-5 \n            border-y\n            border-l\n             border-red-500\n               transition-all\n             duration-500\">\n            </span>\n    \n            <p className=\"group-hover0 group-hover[-100%] absolute translate-x-0 transition-all\n             duration-200\">Hover me</p>\n    \n            <span className=\"group-hover0  group-hover100 absolute  translate- opacity-0  transition-all duration-200\">Thank\n                you!\n            </span>\n    \n            <span\n                className=\"group-hover absolute right-0 h-full w-5  border-y border-r  border-red-500 transition-all duration-500\">\n            </span>\n        </button>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
