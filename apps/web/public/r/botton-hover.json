      "content": "import * as React from \"react\"\n\nfunction BottonHover({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"botton-hover\"\n      className={className}\n      {...props}\n    >\n      <button className=\"\n              group\n              p-5\n              cursor-pointer \n              relative  \n              text-xl \n              font-normal \n              border-0 \n              flex \n              items-center \n              justify-center\n              bg-transparent\n               text-red-500 \n               h-auto  \n               w-[170px]  \n               overflow-hidden   \n               transition-all\n               duration-100\">\n              <span className=\"\n              group-hover:w-full\n              absolute \n              left-0 \n              h-full \n              w-5 \n              border-y\n              border-l\n               border-red-500\n                 transition-all\n               duration-500\">\n              </span>\n      \n              <p className=\"group-hover:opacity-0 group-hover:translate-x-[-100%] absolute translate-x-0 transition-all\n               duration-200\">Hover me</p>\n      \n              <span className=\"group-hover:translate-x-0  group-hover:opacity-100 absolute  translate-x-full opacity-0  transition-all duration-200\">Thank\n                  you!\n              </span>\n      \n              <span\n                  className=\"group-hover:w-full absolute right-0 h-full w-5  border-y border-r  border-red-500 transition-all duration-500\">\n              </span>\n          </button>\n    </div>\n  )\n}\n\nexport { BottonHover }\n",
      "type": "registry:ui"
    }
  ],
