      "content": "/**\n * Component: Fixed navbar\n * Author: @oliver-hansen (https://tailwindflex.com/@oliver-hansen)\n * Source: https://tailwindflex.com/@oliver-hansen/fixed-navbar\n * Attribution: Créé par @oliver-hansen sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function FixedNavbar() {\n  return (\n    <div>\n    <header\r\n        className=\"fixed inset-x-0 top-0 z-30 mx-auto w-full max-w-screen-md border border-gray-100 bg-white/80 py-3 shadow backdrop-blur-lg md6 md3xl lg\">\r\n        <div className=\"px-4\">\r\n            <div className=\"flex items-center justify-between\">\r\n                <div className=\"flex shrink-0\">\r\n                    <a aria-current=\"page\" className=\"flex items-center\" href=\"/\">\r\n                        <img className=\"h-7 w-auto\" src=\"https://upload.wikimedia.org/wikipedia/commons/f/fa/Apple_logo_black.svg\" alt=\"\" />\r\n                        <p className=\"sr-only\">Website Title</p>\r\n                    </a>\r\n                </div>\r\n                <div className=\"hidden md md md md5\">\r\n                    <a aria-current=\"page\"\r\n                        className=\"inline-block rounded-lg px-2 py-1 text-sm font-medium text-gray-900 transition-all duration-200 hover100 hover900\"\r\n                        href=\"#\">How it works</a>\r\n                    <a className=\"inline-block rounded-lg px-2 py-1 text-sm font-medium text-gray-900 transition-all duration-200 hover100 hover900\"\r\n                        href=\"#\">Pricing</a>\r\n                </div>\r\n                <div className=\"flex items-center justify-end gap-3\">\r\n                    <a className=\"hidden items-center justify-center rounded-xl bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 transition-all duration-150 hover50 sm\"\r\n                        href=\"/login\">Sign in</a>\r\n                    <a className=\"inline-flex items-center justify-center rounded-xl bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm transition-all duration-150 hover500 focus-visible focus-visible2 focus-visible2 focus-visible600\"\r\n                        href=\"/login\">Login</a>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </header>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
  ],
