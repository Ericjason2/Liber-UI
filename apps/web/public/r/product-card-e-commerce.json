           disabled\n              >-</button>\n              <input\n                type=\"number\"\n                min=\"1\"\n                value=\"1\"\n                className=\"w-14 text-center border rounded focus\"\n                readonly\n              />\n              <button\n                className=\"bg-gray-200 px-2 py-1 rounded hover300 focus\"\n                disabled\n              >+</button>\n            </div>\n            <button\n              className=\"bg-[#0CAA91] text-white p-3 rounded-full flex items-center justify-center shadow-lg transform transition-transform duration-300 hover105 hover[#078c6d] focus\"\n              style=\"width: 50px; height: 50px;\"\n            >\n              <img src=\"https://www.freeiconspng.com/uploads/cart-icon-16.png\" alt=\"Carrito\" className=\"w-6 h-6\" />\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n    </div>\n  );\n}\n",
