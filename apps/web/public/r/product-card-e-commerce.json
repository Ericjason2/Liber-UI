      "content": "import * as React from \"react\"\n\nfunction ProductCardECommerce({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"product-card-e-commerce\"\n      className={className}\n      {...props}\n    >\n      <div className=\"relative flex flex-col overflow-hidden rounded-lg border border-gray-100 bg-white shadow-md max-w-xs m-4\">\n        <a href=\"#\" className=\"relative mx-3 mt-3 flex h-40 overflow-hidden rounded-xl\">\n          <img \n            src=\"https://administracion.dlds.cl/1762/1762.jpg\"\n            alt=\"Bong de vidrio 25cm\"\n            loading=\"lazy\"\n            className=\"object-contain w-full h-full\"\n          />\n        </a>\n        <div className=\"flex flex-col flex-grow mt-2 px-3 pb-3\">\n          <a href=\"/p/1/bong-vidrio-25cm\" className=\"block relative group\">\n            <h5 className=\"text-xs tracking-tight text-slate-900 font-bold flex items-center\">\n              Bubbler Kush - Bonglab\n              <span className=\"ml-1\"></span>\n            </h5>\n          </a>\n          <div className=\"mt-auto\">\n      \n            <div className=\"flex flex-col items-start\">\n              <span className=\"text-xl font-bold text-red-600\">\n                $24.900 Neto\n              </span>\n              <div className=\"flex items-center\">\n                <span className=\"text-lg text-gray-500 line-through\">\n                  $29.900 Neto\n                </span>\n                <span className=\"bg-[#0CAA91] text-white text-xs font-bold px-2 py-0.5 rounded ml-1\">-17%</span>\n              </div>\n            </div>\n            <div className=\"flex justify-between items-center mt-3\">\n              <div className=\"flex items-center space-x-2\">\n                <button\n                  className=\"bg-gray-200 px-2 py-1 rounded hover300 focus\"\n                  disabled\n                >-</button>\n                <input\n                  type=\"number\"\n                  min=\"1\"\n                  value=\"1\"\n                  className=\"w-14 text-center border rounded focus\"\n                  readonly\n                />\n                <button\n                  className=\"bg-gray-200 px-2 py-1 rounded hover300 focus\"\n                  disabled\n                >+</button>\n              </div>\n              <button\n                className=\"bg-[#0CAA91] text-white p-3 rounded-full flex items-center justify-center shadow-lg transform transition-transform duration-300 hover105 hover[#078c6d] focus\"\n                style=\"width: 50px; height: 50px;\"\n              >\n                <img src=\"https://www.freeiconspng.com/uploads/cart-icon-16.png\" alt=\"Carrito\" className=\"w-6 h-6\" />\n              </button>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  )\n}\n\nexport { ProductCardECommerce }\n",
      "type": "registry:ui"
    }
