      "content": "/**\n * Component: Blog Card\n * Author: @tofayel-islam (https://tailwindflex.com/@tofayel-islam)\n * Source: https://tailwindflex.com/@tofayel-islam/blog-card\n * Attribution: Créé par @tofayel-islam sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function BlogCard() {\n  return (\n    <div>\n    <div className=\"p-4 max-w-md\">\n        <div className=\"h-full border-2 border-gray-200 border-opacity-60 rounded-lg overflow-hidden\">\n            <img className=\"h-48 w-full object-cover object-center\" src=\"https://dummyimage.com/720x400\" alt=\"blog\" />\n            <div className=\"p-6\">\n                <h2 className=\"tracking-widest text-xs title-font font-medium text-gray-400 mb-1\">CATEGORY</h2>\n                <h1 className=\"title-font text-lg font-medium text-gray-900 mb-3\">The Catalyzer</h1>\n                <p className=\"leading-relaxed mb-3\">\n                    Photo booth fam kinfolk cold-pressed sriracha leggings jianbing microdosing\n                    tousled waistcoat.\n                </p>\n                <div className=\"flex items-center flex-wrap\">\n                    <a className=\"text-indigo-500 inline-flex items-center md2 lg0\">\n                        Learn More\n                        <svg className=\"w-4 h-4 ml-2\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" strokeWidth=\"2\" fill=\"none\"\n                            strokeLinecap=\"round\" strokeLinejoin=\"round\">\n                            <path d=\"M5 12h14\"></path>\n                            <path d=\"M12 5l7 7-7 7\"></path>\n                        </svg>\n                    </a>\n                    <span className=\"text-gray-400 mr-3 inline-flex items-center lg md0 ml-auto leading-none text-sm pr-3 py-1 border-r-2 border-gray-200\">\n                        <svg className=\"w-4 h-4 mr-1\" stroke=\"currentColor\" strokeWidth=\"2\" fill=\"none\" strokeLinecap=\"round\" strokeLinejoin=\"round\" viewBox=\"0 0 24 24\">\n                            <path d=\"M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z\"></path>\n                            <circle cx=\"12\" cy=\"12\" r=\"3\"></circle>\n                        </svg>\n                        1.2K\n                    </span>\n                    <span className=\"text-gray-400 inline-flex items-center leading-none text-sm\">\n                        <svg className=\"w-4 h-4 mr-1\" stroke=\"currentColor\" strokeWidth=\"2\" fill=\"none\" strokeLinecap=\"round\" strokeLinejoin=\"round\" viewBox=\"0 0 24 24\">\n                            <path d=\"M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z\"></path>\n                        </svg>6\n                    </span>\n                </div>\n            </div>\n        </div>\n    </div>\n    </div>\n  );\n}\n",
