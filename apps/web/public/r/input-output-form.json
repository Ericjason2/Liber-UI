      "content": "/**\n * Component: Input output form\n * Author: @prajwal (https://tailwindflex.com/@prajwal)\n * Source: https://tailwindflex.com/@prajwal/input-output-form\n * Attribution: Créé par @prajwal sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function InputOutputForm() {\n  return (\n    <div>\n    <div className=\"flex flex-col md p-8\">\r\n    \r\n        <div className=\"flex flex-col gap-2 w-full\">\r\n            <label className=\"font-semibold text-lg\">Input</label>\r\n            <textarea rows=\"14\" className=\" border-2 rounded-lg bg-slate-50\">                </textarea>\r\n        </div>\r\n    \r\n        <div className=\"flex justify-center items-center md gap-4 flex-wrap mx-auto md p-4 shrink-0\">\r\n    \r\n            <div className=\"relative\">\r\n                <label title=\"Click to upload\" htmlFor=\"button2\" className=\"cursor-pointer flex items-center gap-4 px-6 py-4 before400/60 hover300 group before100 before before0 before3xl before before before before300 hover105 active75 active95\">\r\n                    <div className=\"relative\">\r\n                        <span className=\"block text-base font-semibold relative text-blue-900 group-hover500\">\r\n                            Upload a file\r\n                        </span>\r\n                        <span className=\"mt-0.5 block text-sm text-gray-500\">Max 2 MB</span>\r\n                    </div>\r\n                </label>\r\n                <input hidden=\"\" type=\"file\" id=\"button2\" />\r\n            </div>\r\n    \r\n            <button className=\"h-12 text-white bg-violet-600 rounded-md px-4 py-2 hover800 font-semibold text-xl\">Submit</button>\r\n        </div>\r\n    \r\n        <div className=\"flex flex-col gap-2 w-full\">\r\n            <label className=\"font-semibold text-lg\">Output</label>\r\n            <textarea rows=\"14\" className=\" border-2 rounded-lg bg-slate-50\"></textarea>\r\n        </div>\r\n    \r\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
