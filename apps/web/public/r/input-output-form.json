    "rawHtml": "<div class=\"flex flex-col md:flex-row p-8\">\r\n\r\n    <div class=\"flex flex-col gap-2 w-full\">\r\n        <label class=\"font-semibold text-lg\">Input</label>\r\n        <textarea rows=\"14\" class=\" border-2 rounded-lg bg-slate-50\">                </textarea>\r\n    </div>\r\n\r\n    <div class=\"flex justify-center items-center md:flex-col gap-4 flex-wrap mx-auto md:my-auto p-4 shrink-0\">\r\n\r\n        <div class=\"relative\">\r\n            <label title=\"Click to upload\" for=\"button2\" class=\"cursor-pointer flex items-center gap-4 px-6 py-4 before:border-gray-400/60 hover:before:border-gray-300 group before:bg-gray-100 before:absolute before:inset-0 before:rounded-3xl before:border before:border-dashed before:transition-transform before:duration-300 hover:before:scale-105 active:duration-75 active:before:scale-95\">\r\n                <div class=\"relative\">\r\n                    <span class=\"block text-base font-semibold relative text-blue-900 group-hover:text-blue-500\">\r\n                        Upload a file\r\n                    </span>\r\n                    <span class=\"mt-0.5 block text-sm text-gray-500\">Max 2 MB</span>\r\n                </div>\r\n            </label>\r\n            <input hidden=\"\" type=\"file\" id=\"button2\">\r\n        </div>\r\n\r\n        <button class=\"h-12 text-white bg-violet-600 rounded-md px-4 py-2 hover:bg-violet-800 font-semibold text-xl\">Submit</button>\r\n    </div>\r\n\r\n    <div class=\"flex flex-col gap-2 w-full\">\r\n        <label class=\"font-semibold text-lg\">Output</label>\r\n        <textarea rows=\"14\" class=\" border-2 rounded-lg bg-slate-50\"></textarea>\r\n    </div>\r\n\r\n</div>"
