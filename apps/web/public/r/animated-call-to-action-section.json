    "rawHtml": "<section class=\"relative px-2 py-12 lg:py-16 bg-white dark:bg-gray-950 transition-colors duration-300\">\n  <div class=\"text-center space-y-4\">\n    <!-- Avatar stack -->\n    <div class=\"inline-flex items-end justify-center w-full text-center mx-auto relative\">\n      <img\n        src=\"https://avatar.iran.liara.run/public/9\"\n        alt=\"\"\n        class=\"absolute transform translate-x-24 ml-6 rounded-full w-12 h-12 md:w-16 md:h-16 border-4 border-indigo-600 dark:border-indigo-400\"\n      />\n      <img\n        src=\"https://avatar.iran.liara.run/public/64\"\n        alt=\"\"\n        class=\"absolute transform -translate-x-24 -ml-6 rounded-full w-12 h-12 md:w-16 md:h-16 border-4 border-indigo-600 dark:border-indigo-400\"\n      />\n      <img\n        src=\"https://avatar.iran.liara.run/public/13\"\n        alt=\"\"\n        class=\"absolute transform -translate-x-16 rounded-full w-16 h-16 md:w-20 md:h-20 border-4 border-indigo-600 dark:border-indigo-400\"\n      />\n      <img\n        src=\"https://avatar.iran.liara.run/public/60\"\n        alt=\"\"\n        class=\"absolute transform translate-x-16 rounded-full w-16 h-16 md:w-20 md:h-20 border-4 border-indigo-600 dark:border-indigo-400\"\n      />\n      <img\n        src=\"https://avatar.iran.liara.run/public/15\"\n        alt=\"\"\n        class=\"rounded-full w-20 h-20 md:w-24 md:h-24 border-4 border-indigo-600 dark:border-indigo-400 relative\"\n      />\n    </div>\n\n    <!-- Heading -->\n    <div class=\"animate-fade-in-up animation-delay-400\">\n      <h1 class=\"text-5xl sm:text-6xl lg:text-7xl xl:text-8xl font-black tracking-tight\">\n        <span\n          class=\"block bg-gradient-to-r from-gray-900 via-purple-500 to-blue-500 bg-clip-text text-transparent dark:from-gray-100 dark:via-purple-400 dark:to-blue-300 animate-gradient-x\"\n        >\n          Lorem ipsum dolor\n        </span>\n        <span class=\"block relative mt-2\">\n          <span\n            class=\"bg-gradient-to-r from-purple-400 via-pink-400 to-blue-400 bg-clip-text text-transparent animate-gradient-x dark:from-purple-300 dark:via-pink-300 dark:to-blue-300\"\n          >\n            sit amet\n          </span>\n        <span class=\"relative inline-block ml-4\">\n            <svg\n              class=\"absolute bottom-2 left-0 w-full h-4 text-purple-400 dark:text-purple-300 animate-draw-line\"\n              viewBox=\"0 0 410 18\"\n              xmlns=\"http://www.w3.org/2000/svg\"\n            >\n              <path\n                d=\"M6 6.4c16.8 16.8 380.8-11.2 397.6 5.602\"\n                stroke=\"currentColor\"\n                strokeWidth=\"3\"\n                fill=\"none\"\n                strokeLinecap=\"round\"\n                class=\"animate-dash\"\n              />\n            </svg>\n            <span\n              class=\"relative bg-gradient-to-r from-purple-400 to-blue-400 dark:from-purple-300 dark:to-blue-300 bg-clip-text text-transparent\"\n            >\n              consectetur\n            </span>\n        </span>\n        </span>\n      </h1>\n    </div>\n\n    <!-- Paragraph -->\n    <div class=\"animate-fade-in-up animation-delay-600\">\n      <p class=\"max-w-4xl mx-auto text-xl sm:text-2xl leading-relaxed text-gray-700 dark:text-gray-300\">\n        <span class=\"inline-block animate-typewriter\">\n          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.\n        </span>\n      </p>\n    </div>\n\n    <!-- Badges -->\n    <div class=\"pt-6 animate-fade-in-up animation-delay-1000\">\n      <div\n        class=\"flex flex-wrap sm:flex-nowrap flex-row items-center justify-center gap-8 text-sm text-gray-700 dark:text-gray-300\">\n        <div class=\"flex items-center gap-2\">\n          <div class=\"w-2 h-2 bg-green-400 rounded-full animate-pulse\"></div>\n          <span>Lorem ipsum dolor</span>\n        </div>\n        <div class=\"flex items-center gap-2\">\n          <div class=\"w-2 h-2 bg-blue-400 rounded-full animate-pulse animation-delay-300\"></div>\n          <span>Consectetur adipiscing</span>\n        </div>\n        <div class=\"flex items-center gap-2\">\n          <div class=\"w-2 h-2 bg-purple-400 rounded-full animate-pulse animation-delay-600\"></div>\n          <span>Sed do eiusmod</span>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>"
