      "content": "/**\n * Component: Animated Call-to-Action Section\n * Author: @homayunmmdy (https://tailwindflex.com/@homayunmmdy)\n * Source: https://tailwindflex.com/@homayunmmdy/animated-call-to-action-section\n * Attribution: Créé par @homayunmmdy sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function AnimatedCallToActionSection() {\n  return (\n    <div>\n    <section className=\"relative px-2 py-12 lg16 bg-white dark950 transition-colors duration-300\">\n      <div className=\"text-center space-y-4\">\n        \n        <div className=\"inline-flex items-end justify-center w-full text-center mx-auto relative\">\n          <img\n            src=\"https://avatar.iran.liara.run/public/9\"\n            alt=\"\"\n            className=\"absolute transform translate-x-24 ml-6 rounded-full w-12 h-12 md16 md16 border-4 border-indigo-600 dark400\"\n          />\n          <img\n            src=\"https://avatar.iran.liara.run/public/64\"\n            alt=\"\"\n            className=\"absolute transform -translate-x-24 -ml-6 rounded-full w-12 h-12 md16 md16 border-4 border-indigo-600 dark400\"\n          />\n          <img\n            src=\"https://avatar.iran.liara.run/public/13\"\n            alt=\"\"\n            className=\"absolute transform -translate-x-16 rounded-full w-16 h-16 md20 md20 border-4 border-indigo-600 dark400\"\n          />\n          <img\n            src=\"https://avatar.iran.liara.run/public/60\"\n            alt=\"\"\n            className=\"absolute transform translate-x-16 rounded-full w-16 h-16 md20 md20 border-4 border-indigo-600 dark400\"\n          />\n          <img\n            src=\"https://avatar.iran.liara.run/public/15\"\n            alt=\"\"\n            className=\"rounded-full w-20 h-20 md24 md24 border-4 border-indigo-600 dark400 relative\"\n          />\n        </div>\n    \n        \n        <div className=\"animate-fade-in-up animation-delay-400\">\n          <h1 className=\"text-5xl sm6xl lg7xl xl8xl font-black tracking-tight\">\n            <span\n              className=\"block bg-gradient-to-r from-gray-900 via-purple-500 to-blue-500 bg-clip-text text-transparent dark100 dark400 dark300 animate-gradient-x\"\n            >\n              Lorem ipsum dolor\n            </span>\n            <span className=\"block relative mt-2\">\n              <span\n                className=\"bg-gradient-to-r from-purple-400 via-pink-400 to-blue-400 bg-clip-text text-transparent animate-gradient-x dark300 dark300 dark300\"\n              >\n                sit amet\n              </span>\n            <span className=\"relative inline-block ml-4\">\n                <svg\n                  className=\"absolute bottom-2 left-0 w-full h-4 text-purple-400 dark300 animate-draw-line\"\n                  viewBox=\"0 0 410 18\"\n                  xmlns=\"http://www.w3.org/2000/svg\"\n                >\n                  <path\n                    d=\"M6 6.4c16.8 16.8 380.8-11.2 397.6 5.602\"\n                    stroke=\"currentColor\"\n                    strokeWidth=\"3\"\n                    fill=\"none\"\n                    strokeLinecap=\"round\"\n                    className=\"animate-dash\"\n                  />\n                </svg>\n                <span\n                  className=\"relative bg-gradient-to-r from-purple-400 to-blue-400 dark300 dark300 bg-clip-text text-transparent\"\n                >\n                  consectetur\n                </span>\n            </span>\n            </span>\n          </h1>\n        </div>\n    \n        \n        <div className=\"animate-fade-in-up animation-delay-600\">\n          <p className=\"max-w-4xl mx-auto text-xl sm2xl leading-relaxed text-gray-700 dark300\">\n            <span className=\"inline-block animate-typewriter\">\n              Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.\n            </span>\n          </p>\n        </div>\n    \n        \n        <div className=\"pt-6 animate-fade-in-up animation-delay-1000\">\n          <div\n            className=\"flex flex-wrap sm flex-row items-center justify-center gap-8 text-sm text-gray-700 dark300\">\n            <div className=\"flex items-center gap-2\">\n              <div className=\"w-2 h-2 bg-green-400 rounded-full animate-pulse\"></div>\n              <span>Lorem ipsum dolor</span>\n            </div>\n            <div className=\"flex items-center gap-2\">\n              <div className=\"w-2 h-2 bg-blue-400 rounded-full animate-pulse animation-delay-300\"></div>\n              <span>Consectetur adipiscing</span>\n            </div>\n            <div className=\"flex items-center gap-2\">\n              <div className=\"w-2 h-2 bg-purple-400 rounded-full animate-pulse animation-delay-600\"></div>\n              <span>Sed do eiusmod</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n    </div>\n  );\n}\n",
