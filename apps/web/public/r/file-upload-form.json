      "content": "/**\n * Component: File upload form\n * Author: @lukas-muller (https://tailwindflex.com/@lukas-muller)\n * Source: https://tailwindflex.com/@lukas-muller/file-upload-form\n * Attribution: Créé par @lukas-muller sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function FileUploadForm() {\n  return (\n    <div>\n    <div className=\"flex items-center justify-center\">\n        \n        <div className=\"mx-auto w-full max-w-[550px] bg-white\">\n            <form className=\"py-4 px-9\">\n                <div className=\"mb-5\">\n                    <label htmlFor=\"email\" className=\"mb-3 block text-base font-medium text-[#07074D]\">\n                        Send files to this email:\n                    </label>\n                    <input type=\"email\" name=\"email\" id=\"email\" placeholder=\"example.com\"\n                        className=\"w-full rounded-md border border-[#e0e0e0] bg-white py-3 px-6 text-base font-medium text-[#6B7280] outline-none focus[#6A64F1] focus\" />\n                </div>\n    \n                <div className=\"mb-6 pt-4\">\n                    <label className=\"mb-5 block text-xl font-semibold text-[#07074D]\">\n                        Upload File\n                    </label>\n    \n                    <div className=\"mb-8\">\n                        <input type=\"file\" name=\"file\" id=\"file\" className=\"sr-only\" />\n                        <label htmlFor=\"file\"\n                            className=\"relative flex min-h-[200px] items-center justify-center rounded-md border border-dashed border-[#e0e0e0] p-12 text-center\">\n                            <div>\n                                <span className=\"mb-2 block text-xl font-semibold text-[#07074D]\">\n                                    Drop files here\n                                </span>\n                                <span className=\"mb-2 block text-base font-medium text-[#6B7280]\">\n                                    Or\n                                </span>\n                                <span\n                                    className=\"inline-flex rounded border border-[#e0e0e0] py-2 px-7 text-base font-medium text-[#07074D]\">\n                                    Browse\n                                </span>\n                            </div>\n                        </label>\n                    </div>\n    \n                    <div className=\"mb-5 rounded-md bg-[#F5F7FB] py-4 px-8\">\n                        <div className=\"flex items-center justify-between\">\n                            <span className=\"truncate pr-3 text-base font-medium text-[#07074D]\">\n                                banner-design.png\n                            </span>\n                            <button className=\"text-[#07074D]\">\n                                <svg width=\"10\" height=\"10\" viewBox=\"0 0 10 10\" fill=\"none\"\n                                    xmlns=\"http://www.w3.org/2000/svg\">\n                                    <path fillRule=\"evenodd\" clipRule=\"evenodd\"\n                                        d=\"M0.279337 0.279338C0.651787 -0.0931121 1.25565 -0.0931121 1.6281 0.279338L9.72066 8.3719C10.0931 8.74435 10.0931 9.34821 9.72066 9.72066C9.34821 10.0931 8.74435 10.0931 8.3719 9.72066L0.279337 1.6281C-0.0931125 1.25565 -0.0931125 0.651788 0.279337 0.279338Z\"\n                                        fill=\"currentColor\" />\n                                    <path fillRule=\"evenodd\" clipRule=\"evenodd\"\n                                        d=\"M0.279337 9.72066C-0.0931125 9.34821 -0.0931125 8.74435 0.279337 8.3719L8.3719 0.279338C8.74435 -0.0931127 9.34821 -0.0931123 9.72066 0.279338C10.0931 0.651787 10.0931 1.25565 9.72066 1.6281L1.6281 9.72066C1.25565 10.0931 0.651787 10.0931 0.279337 9.72066Z\"\n                                        fill=\"currentColor\" />\n                                </svg>\n                            </button>\n                        </div>\n                    </div>\n    \n                    <div className=\"rounded-md bg-[#F5F7FB] py-4 px-8\">\n                        <div className=\"flex items-center justify-between\">\n                            <span className=\"truncate pr-3 text-base font-medium text-[#07074D]\">\n                                banner-design.png\n                            </span>\n                            <button className=\"text-[#07074D]\">\n                                <svg width=\"10\" height=\"10\" viewBox=\"0 0 10 10\" fill=\"none\"\n                                    xmlns=\"http://www.w3.org/2000/svg\">\n                                    <path fillRule=\"evenodd\" clipRule=\"evenodd\"\n                                        d=\"M0.279337 0.279338C0.651787 -0.0931121 1.25565 -0.0931121 1.6281 0.279338L9.72066 8.3719C10.0931 8.74435 10.0931 9.34821 9.72066 9.72066C9.34821 10.0931 8.74435 10.0931 8.3719 9.72066L0.279337 1.6281C-0.0931125 1.25565 -0.0931125 0.651788 0.279337 0.279338Z\"\n                                        fill=\"currentColor\" />\n                                    <path fillRule=\"evenodd\" clipRule=\"evenodd\"\n                                        d=\"M0.279337 9.72066C-0.0931125 9.34821 -0.0931125 8.74435 0.279337 8.3719L8.3719 0.279338C8.74435 -0.0931127 9.34821 -0.0931123 9.72066 0.279338C10.0931 0.651787 10.0931 1.25565 9.72066 1.6281L1.6281 9.72066C1.25565 10.0931 0.651787 10.0931 0.279337 9.72066Z\"\n                                        fill=\"currentColor\" />\n                                </svg>\n                            </button>\n                        </div>\n                        <div className=\"relative mt-5 h-[6px] w-full rounded-lg bg-[#E2E5EF]\">\n                            <div className=\"absolute left-0 right-0 h-full w-[75%] rounded-lg bg-[#6A64F1]\"></div>\n                        </div>\n                    </div>\n                </div>\n    \n                <div>\n                    <button\n                        className=\"hover w-full rounded-md bg-[#6A64F1] py-3 px-8 text-center text-base font-semibold text-white outline-none\">\n                        Send File\n                    </button>\n                </div>\n            </form>\n        </div>\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
