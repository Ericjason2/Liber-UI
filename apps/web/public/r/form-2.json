      "content": "/**\n * Component: Form\n * Author: @Aman300 (https://tailwindflex.com/@Aman300)\n * Source: https://tailwindflex.com/@Aman300/form-2\n * Attribution: Créé par @Aman300 sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function Form2() {\n  return (\n    <div>\n    <form>\n          <div className=\"flex flex-col items-center justify-center px-6 py-8 mx-auto lg0\">\n            <div className=\"w-full bg-white rounded-lg shadow border md0 sm xl0\">\n              <div className=\"p-6 space-y-4 md6 sm8\">\n                <p className=\"text-xl font-bold leading-tight tracking-tight text-gray-900 md2xl\">\n                  Create an account\n                \n                \n                  </p><div>\n                    <label className=\"block mb-2 text-sm font-medium text-gray-900\">\n                      Your username\n                    </label>\n                    <input placeholder=\"JohnDoe\" className=\"bg-gray-50 border border-gray-300 text-gray-900 sm rounded-lg block w-full p-2.5\" id=\"username\" type=\"text\" />\n                  </div>\n                  <div>\n                    <label className=\"block mb-2 text-sm font-medium text-gray-900\">\n                      Password\n                    </label>\n                    <input className=\"bg-gray-50 border border-gray-300 text-gray-900 sm rounded-lg block w-full p-2.5\" placeholder=\"••••••••\" id=\"password\" type=\"password\" />\n                  </div>\n                  <div>\n                    <label className=\"block mb-2 text-sm font-medium text-gray-900\">\n                      Confirm password\n                    </label>\n                    <input className=\"bg-gray-50 border border-gray-300 text-gray-900 sm rounded-lg block w-full p-2.5\" placeholder=\"••••••••\" id=\"confirmPassword\" type=\"password\" />\n                  </div>\n                  <div className=\"flex items-start\">\n                    <div className=\"flex items-center h-5\">\n                      <input className=\"w-4 h-4 border border-gray-300 rounded bg-gray-50 focus3 focus300 bg-gray-700 border-gray-600 focus600 ring-offset-gray-800\" type=\"checkbox\" aria-describedby=\"terms\" id=\"terms\" />\n                    </div>\n                    <div className=\"ml-3 text-sm\">\n                      <label className=\"font-light text-gray-500 text-gray-300\">\n                        I accept the\n                        <a href=\"#\" className=\"font-medium text-primary-600 hover text-primary-500\">\n                          Terms and Conditions\n                        </a>\n                      </label>\n                    </div>\n                  </div>\n    \n                  <button className=\"w-full bg-blue-500 hover700 focus4 focus focus300 font-medium rounded-lg text-sm px-5 py-2.5 text-center  focus800 text-white\" type=\"submit\">\n                    Create an account\n                  </button>\n                \n              </div>\n            </div>\n          </div></form>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
