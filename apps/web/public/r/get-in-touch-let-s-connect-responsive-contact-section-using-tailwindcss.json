      "content": "/**\n * Component: Get in Touch – Let&#039;s Connect! Responsive Contact Section Using TailwindCSS\n * Author: @abdul-baset-bappy (https://tailwindflex.com/@abdul-baset-bappy)\n * Source: https://tailwindflex.com/@abdul-baset-bappy/get-in-touch-let-s-connect-responsive-contact-section-using-tailwindcss\n * Attribution: Créé par @abdul-baset-bappy sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function GetInTouchLetSConnectResponsiveContactSectionUsingTailwindcss() {\n  return (\n    <div>\n    <section className=\"bg-primary min-h-screen py-10 h-full flex items-center text-white px-4 md10 lg20\">\n      <div className=\"max-w-6xl mx-auto grid grid-cols-1 md2 gap-12 items-center\">\n        \n        <div>\n          <h2 className=\"text-3xl md4xl font-bold leading-tight\">\n            Have You Any Project? <br />\n            <span className=\"text-gray-300\">Please Drop a Message</span>\n          </h2>\n          <p className=\"mt-4 text-gray-400\">\n            Get in touch and let me know how I can help. Fill out the form and\n            I'll be in touch as soon as possible.\n          </p>\n    \n          <div className=\"mt-6 space-y-4\">\n            <div className=\"flex items-start space-x-4\">\n              <span className=\"text-xl text-gray-400\">📍</span>\n              <div>\n                <p className=\"font-semibold\">Address:</p>\n                <p className=\"text-gray-400\">89/9 Mothijheel, Dhaka, Bangladesh.</p>\n              </div>\n            </div>\n    \n            <div className=\"flex items-start space-x-4\">\n              <span className=\"text-xl text-gray-400\">📞</span>\n              <div>\n                <p className=\"font-semibold\">Phone:</p>\n                <p className=\"text-gray-400\">+8801799568976</p>\n                <p className=\"text-gray-400\">+8801904015294</p>\n              </div>\n            </div>\n    \n            <div className=\"flex items-start space-x-4\">\n              <span className=\"text-xl text-gray-400\">✉️</span>\n              <div>\n                <p className=\"font-semibold\">Email:</p>\n                <p className=\"text-gray-400\">support.com</p>\n                <p className=\"text-gray-400\">abdulbasetbappy.com</p>\n              </div>\n            </div>\n          </div>\n    \n          \n          <div className=\"mt-6 flex justify-center lg gap-4\">\n            <a href=\"#\"\n              className=\"group relative inline-flex h-10 w-10 items-center justify-center rounded-full bg-neutral-950 text-neutral-200 hover32 transition-all overflow-hidden\">\n              <span className=\"hidden group-hover whitespace-nowrap mr-2\">GitHub</span>🐙\n            </a>\n            <a href=\"#\"\n              className=\"group relative inline-flex h-10 w-10 items-center justify-center rounded-full bg-blue-900 text-neutral-200 hover36 transition-all overflow-hidden\">\n              <span className=\"hidden group-hover whitespace-nowrap mr-2\">LinkedIn</span>💼\n            </a>\n            <a href=\"#\"\n              className=\"group relative inline-flex h-10 w-10 items-center justify-center rounded-full bg-blue-700 text-neutral-200 hover36 transition-all overflow-hidden\">\n              <span className=\"hidden group-hover whitespace-nowrap mr-2\">Facebook</span>📘\n            </a>\n            <a href=\"#\"\n              className=\"group relative inline-flex h-10 w-10 items-center justify-center rounded-full bg-red-800 text-neutral-200 hover36 transition-all overflow-hidden\">\n              <span className=\"hidden group-hover whitespace-nowrap mr-2\">YouTube</span>▶️\n            </a>\n          </div>\n        </div>\n    \n        \n        <div className=\"bg-gray-800 p-8 rounded-xl shadow-lg\">\n          <form>\n            <div className=\"mb-4\">\n              <label className=\"block text-gray-400 mb-2\">Name</label>\n              <input type=\"text\" placeholder=\"e.g John Doe\" className=\"w-full px-4 py-3 bg-gray-700 text-white rounded-lg border border-gray-600 outline-none\" />\n            </div>\n    \n            <div className=\"mb-4\">\n              <label className=\"block text-gray-400 mb-2\">Email<span className=\"text-xs\">(Required)</span></label>\n              <input type=\"email\" placeholder=\"e.g johndoe.com\" className=\"w-full px-4 py-3 bg-gray-700 text-white rounded-lg border border-gray-600 outline-none\" />\n            </div>\n    \n            <div className=\"mb-4\">\n              <label className=\"block text-gray-400 mb-2\">Phone</label>\n              <input type=\"tel\" placeholder=\"Phone Number\" className=\"w-full px-4 py-3 bg-gray-700 text-white rounded-lg border border-gray-600 outline-none\" />\n            </div>\n    \n            <div className=\"mb-4\">\n              <label className=\"block text-gray-400 mb-2\">Message<span className=\"text-xs\">(Required)</span></label>\n              <textarea placeholder=\"Write message...\" className=\"w-full px-4 py-3 bg-gray-700 text-white rounded-lg border border-gray-600 outline-none h-24\"></textarea>\n            </div>\n    \n            <button type=\"submit\" className=\"w-full bg-white text-gray-900 font-semibold py-3 rounded-lg hover300 transition\">\n              SEND\n            </button>\n          </form>\n        </div>\n      </div>\n    </section>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
