    "rawHtml": "<section class=\"bg-primary min-h-screen py-10 h-full flex items-center text-white px-4 md:px-10 lg:px-20\">\n  <div class=\"max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-center\">\n    <!-- Left Side: Contact Details -->\n    <div>\n      <h2 class=\"text-3xl md:text-4xl font-bold leading-tight\">\n        Have You Any Project? <br />\n        <span class=\"text-gray-300\">Please Drop a Message</span>\n      </h2>\n      <p class=\"mt-4 text-gray-400\">\n        Get in touch and let me know how I can help. Fill out the form and\n        I'll be in touch as soon as possible.\n      </p>\n\n      <div class=\"mt-6 space-y-4\">\n        <div class=\"flex items-start space-x-4\">\n          <span class=\"text-xl text-gray-400\">📍</span>\n          <div>\n            <p class=\"font-semibold\">Address:</p>\n            <p class=\"text-gray-400\">89/9 Mothijheel, Dhaka, Bangladesh.</p>\n          </div>\n        </div>\n\n        <div class=\"flex items-start space-x-4\">\n          <span class=\"text-xl text-gray-400\">📞</span>\n          <div>\n            <p class=\"font-semibold\">Phone:</p>\n            <p class=\"text-gray-400\">+8801799568976</p>\n            <p class=\"text-gray-400\">+8801904015294</p>\n          </div>\n        </div>\n\n        <div class=\"flex items-start space-x-4\">\n          <span class=\"text-xl text-gray-400\">✉️</span>\n          <div>\n            <p class=\"font-semibold\">Email:</p>\n            <p class=\"text-gray-400\">support@abdul.com</p>\n            <p class=\"text-gray-400\">abdulbasetbappy@hotmail.com</p>\n          </div>\n        </div>\n      </div>\n\n      <!-- Social Icons -->\n      <div class=\"mt-6 flex justify-center lg:justify-start gap-4\">\n        <a href=\"#\"\n          class=\"group relative inline-flex h-10 w-10 items-center justify-center rounded-full bg-neutral-950 text-neutral-200 hover:w-32 transition-all overflow-hidden\">\n          <span class=\"hidden group-hover:inline whitespace-nowrap mr-2\">GitHub</span>🐙\n        </a>\n        <a href=\"#\"\n          class=\"group relative inline-flex h-10 w-10 items-center justify-center rounded-full bg-blue-900 text-neutral-200 hover:w-36 transition-all overflow-hidden\">\n          <span class=\"hidden group-hover:inline whitespace-nowrap mr-2\">LinkedIn</span>💼\n        </a>\n        <a href=\"#\"\n          class=\"group relative inline-flex h-10 w-10 items-center justify-center rounded-full bg-blue-700 text-neutral-200 hover:w-36 transition-all overflow-hidden\">\n          <span class=\"hidden group-hover:inline whitespace-nowrap mr-2\">Facebook</span>📘\n        </a>\n        <a href=\"#\"\n          class=\"group relative inline-flex h-10 w-10 items-center justify-center rounded-full bg-red-800 text-neutral-200 hover:w-36 transition-all overflow-hidden\">\n          <span class=\"hidden group-hover:inline whitespace-nowrap mr-2\">YouTube</span>▶️\n        </a>\n      </div>\n    </div>\n\n    <!-- Right Side: Contact Form -->\n    <div class=\"bg-gray-800 p-8 rounded-xl shadow-lg\">\n      <form>\n        <div class=\"mb-4\">\n          <label class=\"block text-gray-400 mb-2\">Name</label>\n          <input type=\"text\" placeholder=\"e.g John Doe\" class=\"w-full px-4 py-3 bg-gray-700 text-white rounded-lg border border-gray-600 outline-none\" />\n        </div>\n\n        <div class=\"mb-4\">\n          <label class=\"block text-gray-400 mb-2\">Email<span class=\"text-xs\">(Required)</span></label>\n          <input type=\"email\" placeholder=\"e.g johndoe@mail.com\" class=\"w-full px-4 py-3 bg-gray-700 text-white rounded-lg border border-gray-600 outline-none\" />\n        </div>\n\n        <div class=\"mb-4\">\n          <label class=\"block text-gray-400 mb-2\">Phone</label>\n          <input type=\"tel\" placeholder=\"Phone Number\" class=\"w-full px-4 py-3 bg-gray-700 text-white rounded-lg border border-gray-600 outline-none\" />\n        </div>\n\n        <div class=\"mb-4\">\n          <label class=\"block text-gray-400 mb-2\">Message<span class=\"text-xs\">(Required)</span></label>\n          <textarea placeholder=\"Write message...\" class=\"w-full px-4 py-3 bg-gray-700 text-white rounded-lg border border-gray-600 outline-none h-24\"></textarea>\n        </div>\n\n        <button type=\"submit\" class=\"w-full bg-white text-gray-900 font-semibold py-3 rounded-lg hover:bg-gray-300 transition\">\n          SEND\n        </button>\n      </form>\n    </div>\n  </div>\n</section>"
