      "content": "/**\n * Component: Book appointment form\n * Author: @lukas-muller (https://tailwindflex.com/@lukas-muller)\n * Source: https://tailwindflex.com/@lukas-muller/book-appointment-form-2\n * Attribution: Créé par @lukas-muller sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function BookAppointmentForm2() {\n  return (\n    <div>\n    <div className=\"flex items-center justify-center p-12\">\n        \n        <div className=\"mx-auto w-full max-w-[550px] bg-white\">\n            <form>\n                <div className=\"mb-5\">\n                    <label htmlFor=\"name\" className=\"mb-3 block text-base font-medium text-[#07074D]\">\n                        Full Name\n                    </label>\n                    <input type=\"text\" name=\"name\" id=\"name\" placeholder=\"Full Name\"\n                        className=\"w-full rounded-md border border-[#e0e0e0] bg-white py-3 px-6 text-base font-medium text-[#6B7280] outline-none focus[#6A64F1] focus\" />\n                </div>\n                <div className=\"mb-5\">\n                    <label htmlFor=\"phone\" className=\"mb-3 block text-base font-medium text-[#07074D]\">\n                        Phone Number\n                    </label>\n                    <input type=\"text\" name=\"phone\" id=\"phone\" placeholder=\"Enter your phone number\"\n                        className=\"w-full rounded-md border border-[#e0e0e0] bg-white py-3 px-6 text-base font-medium text-[#6B7280] outline-none focus[#6A64F1] focus\" />\n                </div>\n                <div className=\"mb-5\">\n                    <label htmlFor=\"email\" className=\"mb-3 block text-base font-medium text-[#07074D]\">\n                        Email Address\n                    </label>\n                    <input type=\"email\" name=\"email\" id=\"email\" placeholder=\"Enter your email\"\n                        className=\"w-full rounded-md border border-[#e0e0e0] bg-white py-3 px-6 text-base font-medium text-[#6B7280] outline-none focus[#6A64F1] focus\" />\n                </div>\n                <div className=\"-mx-3 flex flex-wrap\">\n                    <div className=\"w-full px-3 sm1/2\">\n                        <div className=\"mb-5\">\n                            <label htmlFor=\"date\" className=\"mb-3 block text-base font-medium text-[#07074D]\">\n                                Date\n                            </label>\n                            <input type=\"date\" name=\"date\" id=\"date\"\n                                className=\"w-full rounded-md border border-[#e0e0e0] bg-white py-3 px-6 text-base font-medium text-[#6B7280] outline-none focus[#6A64F1] focus\" />\n                        </div>\n                    </div>\n                    <div className=\"w-full px-3 sm1/2\">\n                        <div className=\"mb-5\">\n                            <label htmlFor=\"time\" className=\"mb-3 block text-base font-medium text-[#07074D]\">\n                                Time\n                            </label>\n                            <input type=\"time\" name=\"time\" id=\"time\"\n                                className=\"w-full rounded-md border border-[#e0e0e0] bg-white py-3 px-6 text-base font-medium text-[#6B7280] outline-none focus[#6A64F1] focus\" />\n                        </div>\n                    </div>\n                </div>\n    \n                <div className=\"mb-5 pt-3\">\n                    <label className=\"mb-5 block text-base font-semibold text-[#07074D] sm\">\n                        Address Details\n                    </label>\n                    <div className=\"-mx-3 flex flex-wrap\">\n                        <div className=\"w-full px-3 sm1/2\">\n                            <div className=\"mb-5\">\n                                <input type=\"text\" name=\"area\" id=\"area\" placeholder=\"Enter area\"\n                                    className=\"w-full rounded-md border border-[#e0e0e0] bg-white py-3 px-6 text-base font-medium text-[#6B7280] outline-none focus[#6A64F1] focus\" />\n                            </div>\n                        </div>\n                        <div className=\"w-full px-3 sm1/2\">\n                            <div className=\"mb-5\">\n                                <input type=\"text\" name=\"city\" id=\"city\" placeholder=\"Enter city\"\n                                    className=\"w-full rounded-md border border-[#e0e0e0] bg-white py-3 px-6 text-base font-medium text-[#6B7280] outline-none focus[#6A64F1] focus\" />\n                            </div>\n                        </div>\n                        <div className=\"w-full px-3 sm1/2\">\n                            <div className=\"mb-5\">\n                                <input type=\"text\" name=\"state\" id=\"state\" placeholder=\"Enter state\"\n                                    className=\"w-full rounded-md border border-[#e0e0e0] bg-white py-3 px-6 text-base font-medium text-[#6B7280] outline-none focus[#6A64F1] focus\" />\n                            </div>\n                        </div>\n                        <div className=\"w-full px-3 sm1/2\">\n                            <div className=\"mb-5\">\n                                <input type=\"text\" name=\"post-code\" id=\"post-code\" placeholder=\"Post Code\"\n                                    className=\"w-full rounded-md border border-[#e0e0e0] bg-white py-3 px-6 text-base font-medium text-[#6B7280] outline-none focus[#6A64F1] focus\" />\n                            </div>\n                        </div>\n                    </div>\n                </div>\n    \n                <div>\n                    <button\n                        className=\"hover w-full rounded-md bg-[#6A64F1] py-3 px-8 text-center text-base font-semibold text-white outline-none\">\n                        Book Appointment\n                    </button>\n                </div>\n            </form>\n        </div>\n    </div>\n    </div>\n  );\n}\n",
