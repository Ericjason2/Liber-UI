      "content": "/**\n * Component: Sign up for newsletter form\n * Author: @amit (https://tailwindflex.com/@amit)\n * Source: https://tailwindflex.com/@amit/sign-up-for-newsletter-form\n * Attribution: Créé par @amit sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function SignUpForNewsletterForm() {\n  return (\n    <div>\n    <div className=\"max-w-screen-xl mx-auto lg lg p-10 mt-10 ml-10\">\r\n        <div className=\"lg0 lg1\">\r\n            <h2 id=\"newsletter-headline\"\r\n                className=\"text-2xl leading-9 tracking-tight text-gray-700 font-semilbold sm4xl sm10\">\r\n                Sign up for our newsletter\r\n            </h2>\r\n            <p className=\"max-w-3xl mt-3 text-gray-500\">\r\n                Stay up-to-date on news and updates about this project by email.\r\n            </p>\r\n        </div>\r\n        <div className=\"max-w-md mt-8 lg0 lg8\">\r\n            <form aria-labelledby=\"newsletter-headline\">\r\n                <div className=\"\">\r\n                    <div className=\"sm items-center\">\r\n                        <input name=\"EMAIL\" type=\"email\" required=\"required\" placeholder=\"Enter your email\" aria-label=\"Email address\" className=\"w-full px-5 py-3 text-base leading-6 transition duration-150 ease-in-out border-2 rounded-md appearance-none focus sm border-gray-200 text-gray-900 placeholder-gray-500 focus400 bg-white\" />\r\n                        <div className=\"mt-3 sm0 sm3 sm0\">\r\n                            <button type=\"submit\" className=\"block px-5 py-3 text-white transition duration-100 ease-in-out bg-blue-500 border border-transparent rounded shadow-sm hover600 focus500 focus2 focus500 focus focus50 disabled50 disabled\">\r\n                      Notify me\r\n                    </button>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </form>\r\n            <p className=\"mt-3 text-sm leading-5 text-gray-500\">\r\n                I will never spam or share your email under any circustance.\r\n            </p>\r\n        </div>\r\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
  ],
