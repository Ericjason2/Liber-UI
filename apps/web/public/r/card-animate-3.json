      "path": "ui/card-animate-3.tsx",
      "content": "/**\n * Component: Card animate\n * Author: @raulanto (https://tailwindflex.com/@raulanto)\n * Source: https://tailwindflex.com/@raulanto/card-animate-3\n * Attribution: Créé par @raulanto sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function CardAnimate3() {\n  return (\n    <div>\n    <div\n      className=\"relative p-8 overflow-hidden rounded-xl min-h-28 max-w-96 shadow h-fit w-full bg-cool-950 dark100 transition-all duration-200 border border-cool-300 dark700 group hover\">\n      \n      <div className=\"absolute inset-0 opacity-0 group-hover100 transition-opacity duration-300 -z-10 blur-2xl\">\n        <div\n          className=\"absolute w-20 h-20 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-amber-700 via-fuchsia-800 to-teal-300 rounded-full transform -translate-x-1/2 -translate-y-1/2 pointer-events-none mix-blend-soft-light  \"\n          style=\"top: var(--mouse-y); left: var(--mouse-x);\"></div>\n      </div>\n    \n      \n      <h2 className=\"text-xl font-bold mb-2 relative \">Título de la tarjeta</h2>\n      \n      <p className=\"text-gray-700 relative\">Este es el contenido de la tarjeta.</p>\n    </div>\n    \n    \n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
  ],
