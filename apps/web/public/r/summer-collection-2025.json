">\n                        <i class=\"fas fa-user\"></i>\n                    </button>\n                </div>\n            </div>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 text-white py-20\">\n        <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center\">\n            <h1 class=\"text-4xl md:text-6xl font-bold mb-6\">Summer Collection 2025</h1>\n            <p class=\"text-xl mb-8\">Discover our latest trends and styles</p>\n            <button class=\"bg-white text-indigo-600 px-8 py-3 rounded-full font-bold hover:bg-gray-100 transition duration-300\">Shop Now</button>\n        </div>\n    </section>\n\n    <!-- Categories -->\n    <section class=\"py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <h2 class=\"text-3xl font-bold mb-8 text-center\">Shop by Category</h2>\n        <div class=\"grid grid-cols-2 md:grid-cols-4 gap-6\">\n            <div class=\"bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition duration-300\">\n                <img src=\"https://images.unsplash.com/photo-1551232864-3f0890e580d9?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=687&q=80\" alt=\"Men's Clothing\" class=\"w-full h-48 object-cover\">\n                <div class=\"p-4\">\n                    <h3 class=\"font-bold text-lg mb-2\">Men's Wear</h3>\n                    <button class=\"text-indigo-600 hover:text-indigo-800 font-medium\">Shop Now</button>\n                </div>\n            </div>\n            <div class=\"bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition duration-300\">\n                <img src=\"https://images.unsplash.com/photo-1581044777550-4cfa60707c03?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=686&q=80\" alt=\"Women's Clothing\" class=\"w-full h-48 object-cover\">\n                <div class=\"p-4\">\n                    <h3 class=\"font-bold text-lg mb-2\">Women's Wear</h3>\n                    <button class=\"text-indigo-600 hover:text-indigo-800 font-medium\">Shop Now</button>\n                </div>\n            </div>\n            <div class=\"bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition duration-300\">\n                <img src=\"https://images.unsplash.com/photo-1600189261867-30e5ffe7b8da?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=687&q=80\" alt=\"Kids' Clothing\" class=\"w-full h-48 object-cover\">\n                <div class=\"p-4\">\n                    <h3 class=\"font-bold text-lg mb-2\">Kids' Wear</h3>\n                    <button class=\"text-indigo-600 hover:text-indigo-800 font-medium\">Shop Now</button>\n                </div>\n            </div>\n            <div class=\"bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition duration-300\">\n                <img src=\"https://images.unsplash.com/photo-1523381210434-271e8be1f52b?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1470&q=80\" alt=\"Accessories\" class=\"w-full h-48 object-cover\">\n                <div class=\"p-4\">\n                    <h3 class=\"font-bold text-lg mb-2\">Accessories</h3>\n                    <button class=\"text-indigo-600 hover:text-indigo-800 font-medium\">Shop Now</button>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Featured Products -->\n    <section class=\"py-12 bg-gray-100\">\n        <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n            <h2 class=\"text-3xl font-bold mb-8 text-center\">Featured Products</h2>\n            <div class=\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8\" id=\"products-container\">\n                <!-- Products will be loaded here via JavaScript -->\n            </div>\n        </div>\n    </section>\n\n    <!-- Shopping Cart Sidebar -->\n    <div class=\"fixed inset-y-0 right-0 w-full md:w-96 bg-white shadow-xl transform translate-x-full transition-transform duration-300 z-50 overflow-y-auto\" id=\"cart-sidebar\">\n        <div class=\"p-6\">\n            <div class=\"flex justify-between items-center mb-6\">\n                <h3 class=\"text-xl font-bold\">Your Cart</h3>\n                <button id=\"close-cart\" class=\"text-gray-500 hover:text-gray-700\">\n                    <i class=\"fas fa-times\"></i>\n                </button>\n            </div>\n            <div class=\"divide-y divide-gray-200\" id=\"cart-items\">\n                <!-- Cart items will be loaded here -->\n                <p class=\"py-4 text-gray-500\" id=\"empty-cart-message\">Your cart is empty</p>\n            </div>\n            <div class=\"mt-6 border-t border-gray-200 pt-6\">\n                <div class=\"flex justify-between mb-2\">\n                    <span class=\"text-gray-600\">Subtotal</span>\n                    <span class=\"font-bold\" id=\"cart-subtotal\">$0.00</span>\n                </div>\n                <div class=\"flex justify-between mb-2\">\n                    <span class=\"text-gray-600\">Shipping</span>\n                    <span class=\"font-bold\">Free</span>\n                </div>\n                <div class=\"flex justify-between text-lg font-bold mt-4\">\n                    <span>Total</span>\n                    <span id=\"cart-total\">$0.00</span>\n                </div>\n                <button class=\"w-full bg-indigo-600 text-white py-3 rounded-lg mt-6 hover:bg-indigo-700 transition duration-300\" id=\"checkout-btn\">Checkout</button>\n            </div>\n        </div>\n    </div>\n    <div class=\"fixed inset-0 bg-black bg-opacity-50 z-40 hidden\" id=\"cart-overlay\"></div>\n\n    <!-- Footer -->\n    <footer class=\"bg-gray-800 text-white py-12\">\n        <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n            <div class=\"grid grid-cols-1 md:grid-cols-4 gap-8\">\n                <div>\n                    <h3 class=\"text-xl font-bold mb-4\">FashionFusion</h3>\n                    <p class=\"text-gray-400\">Premium clothing for everyone. Quality meets style.</p>\n                </div>\n                <div>\n                    <h4 class=\"font-bold mb-4\">Shop</h4>\n                    <ul class=\"space-y-2\">\n                        <li><a href=\"#\" class=\"text-gray-400 hover:text-white\">Men</a></li>\n                        <li><a href=\"#\" class=\"text-gray-400 hover:text-white\">Women</a></li>\n                        <li><a href=\"#\" class=\"text-gray-400 hover:text-white\">Kids</a></li>\n                        <li><a href=\"#\" class=\"text-gray-400 hover:text-white\">Accessories</a></li>\n                    </ul>\n                </div>\n                <div>\n                    <h4 class=\"font-bold mb-4\">Help</h4>\n                    <ul class=\"space-y-2\">\n                        <li><a href=\"#\" class=\"text-gray-400 hover:text-white\">Customer Service</a></li>\n                        <li><a href=\"#\" class=\"text-gray-400 hover:text-white\">Track Order</a></li>\n                        <li><a href=\"#\" class=\"text-gray-400 hover:text-white\">Returns & Exchanges</a></li>\n                        <li><a href=\"#\" class=\"text-gray-400 hover:text-white\">Shipping Info</a></li>\n                    </ul>\n                </div>\n                <div>\n                    <h4 class=\"font-bold mb-4\">Contact</h4>\n                    <ul class=\"space-y-2\">\n                        <li class=\"text-gray-400\">123 Fashion Street</li>\n                        <li class=\"text-gray-400\">New York, NY 10001</li>\n                        <li class=\"text-gray-400\">info@fashionfusion.com</li>\n                        <li class=\"text-gray-400\">+1 (555) 123-4567</li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"border-t border-gray-700 mt-8 pt-8 text-center text-gray-400\">\n                <p>&copy; 2023 FashionFusion. All rights reserved.</p>\n            </div>\n        </div>\n    </footer>\n\n    <script src=\"script.js\"></script>\n</body>\n</html>"
