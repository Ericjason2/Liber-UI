lFor=\"last-name\" className=\"block text-sm font-medium leading-6 text-gray-900\">Last name</label>\n              <div className=\"mt-2\">\n                <input type=\"text\" name=\"last-name\" id=\"last-name\" autoComplete=\"family-name\" className=\"block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder400 focus2 focus focus600 sm sm6\" />\n              </div>\n            </div>\n    \n            <div className=\"sm4\">\n              <label htmlFor=\"email\" className=\"block text-sm font-medium leading-6 text-gray-900\">Email address</label>\n              <div className=\"mt-2\">\n                <input id=\"email\" name=\"email\" type=\"email\" autoComplete=\"email\" className=\"block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder400 focus2 focus focus600 sm sm6\" />\n              </div>\n            </div>\n    \n            <div className=\"sm3\">\n              <label htmlFor=\"country\" className=\"block text-sm font-medium leading-6 text-gray-900\">Country</label>\n              <div className=\"mt-2\">\n                <select id=\"country\" name=\"country\" autoComplete=\"country-name\" className=\"block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus2 focus focus600 sm sm sm6\">\n                  <option>United States</option>\n                  <option>Canada</option>\n                  <option>Mexico</option>\n                </select>\n              </div>\n            </div>\n    \n            <div className=\"col-span-full\">\n              <label htmlFor=\"street-address\" className=\"block text-sm font-medium leading-6 text-gray-900\">Street address</label>\n              <div className=\"mt-2\">\n                <input type=\"text\" name=\"street-address\" id=\"street-address\" autoComplete=\"street-address\" className=\"block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder400 focus2 focus focus600 sm sm6\" />\n              </div>\n            </div>\n    \n            <div className=\"sm2 sm1\">\n              <label htmlFor=\"city\" className=\"block text-sm font-medium leading-6 text-gray-900\">City</label>\n              <div className=\"mt-2\">\n                <input type=\"text\" name=\"city\" id=\"city\" autoComplete=\"address-level2\" className=\"block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder400 focus2 focus focus600 sm sm6\" />\n              </div>\n            </div>\n    \n            <div className=\"sm2\">\n              <label htmlFor=\"region\" className=\"block text-sm font-medium leading-6 text-gray-900\">State / Province</label>\n              <div className=\"mt-2\">\n                <input type=\"text\" name=\"region\" id=\"region\" autoComplete=\"address-level1\" className=\"block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder400 focus2 focus focus600 sm sm6\" />\n              </div>\n            </div>\n    \n            <div className=\"sm2\">\n              <label htmlFor=\"postal-code\" className=\"block text-sm font-medium leading-6 text-gray-900\">ZIP / Postal code</label>\n              <div className=\"mt-2\">\n                <input type=\"text\" name=\"postal-code\" id=\"postal-code\" autoComplete=\"postal-code\" className=\"block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder400 focus2 focus focus600 sm sm6\" />\n              </div>\n            </div>\n          </div>\n        </div>\n    \n        <div className=\"border-b border-gray-900/10 pb-12\">\n          <h2 className=\"text-base font-semibold leading-7 text-gray-900\">Notifications</h2>\n          <p className=\"mt-1 text-sm leading-6 text-gray-600\">We'll always let you know about important changes, but you pick\n           