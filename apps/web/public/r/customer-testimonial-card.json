      "content": "/**\n * Component: Customer testimonial card\n * Author: @arya (https://tailwindflex.com/@arya)\n * Source: https://tailwindflex.com/@arya/customer-testimonial-card\n * Attribution: Créé par @arya sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function CustomerTestimonialCard() {\n  return (\n    <div>\n    <div className=\"p-4\">\n      <figure className=\"md max-w-5xl bg-slate-100 rounded-xl p-8 md0 dark800\">\n        <img className=\"w-24 h-24 md48 md md rounded-full mx-auto object-cover\" src=\"https://images.unsplash.com/photo-1495716868937-273203d5bb0c?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w0NzEyNjZ8MHwxfHNlYXJjaHw4fHxsYWR5fGVufDB8MHx8fDE2OTQxNzI4MTV8MA&ixlib=rb-4.0.3&q=80&w=1080\" alt=\"\" width=\"384\" height=\"512\" />\n        <div className=\"pt-6 md8 text-center md space-y-4\">\n          <blockquote>\n            <p className=\"text-lg font-medium dark100\">\n              “Tailwind CSS is the only framework that I've seen scale\n              on large teams. It’s easy to customize, adapts to any design,\n              and the build size is tiny.”\n            </p>\n          </blockquote>\n          <figcaption className=\"font-medium\">\n            <div className=\"text-sky-500 dark400\">\n              Sarah Dayan\n            </div>\n            <div className=\"text-slate-700 dark400\">\n              Staff Engineer, Algolia\n            </div>\n          </figcaption>\n        </div>\n      </figure>\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
  ],
