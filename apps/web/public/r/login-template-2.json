      "content": "import * as React from \"react\"\n\nfunction LoginTemplate2({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"login-template-2\"\n      className={className}\n      {...props}\n    >\n      <div className=\"min-h-screen bg-cover bg-center flex items-center justify-center p-4\" \n           style=\"background-image: url('https://images.unsplash.com/photo-1524985069026-dd778a71c7b4?auto=format&fit=crop&w=1470&q=80');\">\n      \n        <div className=\"max-w-md w-full bg-white/10 backdrop-blur-lg rounded-xl shadow-xl p-8 border border-white/20\">\n          <h2 className=\"text-3xl font-extrabold text-white mb-6 text-center tracking-wide\">Bienvenido a PeliMania</h2>\n      \n          <form className=\"space-y-5\" >\n            \n            <div>\n              <input type=\"email\"\n                className=\"w-full px-4 py-3 bg-white/20 text-white border border-white/30 rounded-lg focus2 focus500 focus placeholder-white/70\"\n                placeholder=\"Correo electrónico\" required />\n            </div>\n      \n            <div>\n              <input type=\"password\"\n                className=\"w-full px-4 py-3 bg-white/20 text-white border border-white/30 rounded-lg focus2 focus500 focus placeholder-white/70\"\n                placeholder=\"Contraseña\" required />\n            </div>\n      \n            <button\n              className=\"w-full bg-red-600 hover700 text-white font-semibold py-3 rounded-lg transition-all\"\n              type=\"submit\">\n              Entrar\n            </button>\n          </form>\n      \n          <div className=\"mt-6 text-center text-sm text-white\">\n            ¿No tienes cuenta?\n            <a  className=\"text-red-400 hover font-medium\">Regístrate</a>\n          </div>\n        </div>\n      </div>\n    </div>\n  )\n}\n\nexport { LoginTemplate2 }\n",
      "type": "registry:ui"
    }
  ],
