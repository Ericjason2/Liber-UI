      "content": "/**\n * Component: WYSIWYG Editor Form\n * Author: @ip-leroy (https://tailwindflex.com/@ip-leroy)\n * Source: https://tailwindflex.com/@ip-leroy/wysiwyg-editor-form\n * Attribution: Créé par @ip-leroy sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function WysiwygEditorForm() {\n  return (\n    <div>\n    <div className=\"max-w-2xl mx-auto p-4\">\n        <form action=\"/submit-post\" method=\"POST\">\n            <div className=\"mb-6\">\n                <label htmlFor=\"title\" className=\"block text-lg font-medium text-gray-800 mb-1\">Title</label>\n                <input type=\"text\" id=\"title\" name=\"title\" className=\"w-full px-4 py-2 border border-gray-300 rounded-md focus focus500\" required />\n            </div>\n    \n            <div className=\"mb-6\">\n                <label htmlFor=\"content\" className=\"block text-lg font-medium text-gray-800 mb-1\">Content</label>\n                <textarea id=\"content\" name=\"content\" className=\"w-full px-4 py-2 border border-gray-300 rounded-md focus focus500\" rows=\"6\" required></textarea>\n            </div>\n    \n            <div className=\"mb-6\">\n                <label htmlFor=\"image\" className=\"block text-lg font-medium text-gray-800 mb-1\">Image</label>\n                <input type=\"file\" id=\"image\" name=\"image\" accept=\"image/*\" className=\"w-full\" />\n            </div>\n    \n            <div className=\"flex justify-end\">\n                <button type=\"submit\" className=\"px-6 py-2 bg-indigo-500 text-white font-semibold rounded-md hover600 focus\">Submit</button>\n            </div>\n        </form>\n    </div>\n    \n    \n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
  ],
