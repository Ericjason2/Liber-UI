      "content": "/**\n * Component: Profile Card\n * Author: @ajay-thakur (https://tailwindflex.com/@ajay-thakur)\n * Source: https://tailwindflex.com/@ajay-thakur/profile-card-15\n * Attribution: Créé par @ajay-thakur sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function ProfileCard15() {\n  return (\n    <div>\n    <div className=\"max-w-sm mx-auto bg-white rounded-2xl shadow-md \n    overflow-hidden hover transition-shadow duration-300\">\n      <div className=\"flex flex-col items-center p-6\">\n        <img\n          className=\"w-24 h-24 rounded-full border-4 border-rose-500 shadow-sm\"\n          src=\"https://via.placeholder.com/150\"\n          alt=\"User Avatar\"\n        />\n        <h2 className=\"mt-4 text-xl font-semibold text-gray-900\">Jane Doe</h2>\n        <p className=\"text-gray-500 text-sm\">UI/UX Designer</p>\n    \n        <p className=\"mt-3 text-center text-gray-600 text-sm\">\n          Passionate about creating user-friendly digital experiences and modern designs.\n        </p>\n    \n        <div className=\"flex mt-4 space-x-3\">\n          <button\n            className=\"px-4 py-2 bg-rose-600 text-white text-sm \n            rounded-lg hover700 focus2 focus400\"\n          >\n            Follow\n          </button>\n          <button\n            className=\"px-4 py-2 bg-gray-100 text-gray-700 text-sm rounded-lg hover200 focus2 focus300\"\n          >\n            Message\n          </button>\n        </div>\n      </div>\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
