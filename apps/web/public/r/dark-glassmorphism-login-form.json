      "content": "/**\n * Component: Dark Glassmorphism Login Form\n * Author: @jugendra-gangwar (https://tailwindflex.com/@jugendra-gangwar)\n * Source: https://tailwindflex.com/@jugendra-gangwar/dark-glassmorphism-login-form\n * Attribution: Créé par @jugendra-gangwar sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function DarkGlassmorphismLoginForm() {\n  return (\n    <div dangerouslySetInnerHTML={{ __html: \"<!DOCTYPE html>\\n<html lang=\\\"en\\\">\\n<head>\\n<meta charset=\\\"UTF-8\\\">\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\">\\n<title>Sign in - Portal</title>\\n\\n<link rel=\\\"preconnect\\\" href=\\\"https://fonts.googleapis.com\\\">\\n<link rel=\\\"preconnect\\\" href=\\\"https://fonts.gstatic.com\\\" crossorigin>\\n<link href=\\\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap\\\" rel=\\\"stylesheet\\\">\\n</head>\\n<body class=\\\"min-h-screen antialiased bg-[#070B16] text-white\\\" style=\\\"font-family:'Plus Jakarta Sans',sans-serif\\\">\\n<main class=\\\"min-h-screen flex items-center justify-center p-4 sm:p-6\\\">\\n\\n<div class=\\\"pointer-events-none fixed -top-24 -right-24 w-96 h-96 bg-indigo-500/25 rounded-full blur-3xl\\\"></div>\\n<div class=\\\"pointer-events-none fixed -bottom-24 -left-24 w-96 h-96 bg-cyan-500/20 rounded-full blur-3xl\\\"></div>\\n<section class=\\\"relative w-full max-w-md bg-white/[0.04] backdrop-blur-xl rounded-3xl p-8 sm:p-10 border border-white/10 shadow-2xl\\\">\\n  <div class=\\\"text-center mb-8\\\">\\n    <div class=\\\"inline-grid h-12 w-12 place-items-center rounded-2xl bg-white/10 border border-white/15 text-cyan-300 mb-4 shadow-[0_0_24px_rgba(34,211,238,0.25)]\\\">\\n      <svg class=\\\"w-6 h-6\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" viewBox=\\\"0 0 24 24\\\" aria-hidden=\\\"true\\\"><path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" d=\\\"M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z\\\"/></svg>\\n    </div>\\n    <h1 class=\\\"text-2xl font-bold tracking-tight\\\">Sign in to your portal</h1>\\n    <p class=\\\"text-sm text-slate-400 mt-1\\\">Your session is encrypted end to end.</p>\\n  </div>\\n  <form data-form class=\\\"space-y-4\\\" novalidate>\\n    <div>\\n      <label for=\\\"email\\\" class=\\\"text-sm font-medium text-slate-300 block mb-1.5\\\">Email</label>\\n      <input id=\\\"email\\\" type=\\\"email\\\" required autocomplete=\\\"email\\\" placeholder=\\\"you@network.io\\\" class=\\\"w-full bg-white/5 border border-white/15 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 transition focus:outline-none focus:border-cyan-400 focus:bg-white/10 focus:ring-4 focus:ring-cyan-400/15\\\">\\n    </div>\\n    <div>\\n  <div class=\\\"flex items-center justify-between mb-1.5\\\">\\n    <label for=\\\"pw\\\" class=\\\"text-sm font-medium text-slate-300\\\">Password</label><a href=\\\"#\\\" class=\\\"text-sm text-cyan-300 hover:underline\\\">Reset password</a>\\n  </div>\\n  <div class=\\\"relative\\\">\\n    <input id=\\\"pw\\\" type=\\\"password\\\" required minlength=\\\"6\\\" autocomplete=\\\"current-password\\\" placeholder=\\\"Enter your password\\\" class=\\\"w-full bg-white/5 border border-white/15 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 transition focus:outline-none focus:border-cyan-400 focus:bg-white/10 focus:ring-4 focus:ring-cyan-400/15 pr-16\\\">\\n    <button type=\\\"button\\\" data-toggle=\\\"pw\\\" aria-pressed=\\\"false\\\" class=\\\"absolute right-3 top-1/2 -translate-y-1/2 text-xs font-semibold text-cyan-300 hover:text-cyan-200 focus-visible:outline-none focus-visible:underline\\\">Show</button>\\n  </div>\\n</div>\\n    <label class=\\\"flex items-center gap-2.5 text-sm text-slate-400 cursor-pointer pt-1\\\">\\n      <input type=\\\"checkbox\\\" class=\\\"h-4 w-4 rounded bg-white/10 border-white/25 text-cyan-400 focus:ring-cyan-400/40 focus:ring-offset-0\\\"> Keep me signed in on this device\\n    </label>\\n    <button type=\\\"submit\\\" data-loading=\\\"Signing in...\\\" class=\\\"w-full bg-gradient-to-r from-cyan-400 to-indigo-400 hover:from-cyan-300 hover:to-indigo-300 text-slate-950 font-bold text-sm py-3.5 rounded-xl shadow-[0_0_28px_rgba(34,211,238,0.3)] transition active:scale-[0.99] focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-cyan-300/40\\\">Sign in</button>\\n  </form>\\n  <p class=\\\"mt-7 pt-5 border-t border-white/10 text-center text-sm text-slate-400\\\">No access yet? <a href=\\\"#\\\" class=\\\"text-cyan-300 font-semibold hover:underline\\\">Request an invite</a></p>\\n</section>\\n</main>\\n\\n</body>\\n</html>\" }} />\n  );\n}\n",
