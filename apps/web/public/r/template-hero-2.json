    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Momentum - Street Style Project</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap');\n        body {\n            font-family: 'Inter', sans-serif;\n            /* Color de fondo base */\n            background-color: #ffffff; \n            color: #111111;\n        }\n    </style>\n</head>\n<body class=\"min-h-screen flex flex-col\">\n\n    <header class=\"flex flex-col md:flex-row justify-between items-center px-8 py-6 lg:px-12 lg:py-8\">\n        <div class=\"text-lg font-semibold tracking-tight mb-4 md:mb-0\">\n            Momentum®\n        </div>\n\n        <nav class=\"flex gap-8 text-sm font-medium text-gray-800 mb-4 md:mb-0\">\n            <a href=\"#\" class=\"hover:text-black transition\">Projects</a>\n            <a href=\"#\" class=\"hover:text-black transition\">About Us</a>\n            <a href=\"#\" class=\"hover:text-black transition\">Process</a>\n            <a href=\"#\" class=\"hover:text-black transition\">Archive</a>\n            <a href=\"#\" class=\"hover:text-black transition\">Gallery</a>\n        </nav>\n\n        <div class=\"flex items-center gap-8 text-sm font-medium\">\n            <span class=\"hidden lg:block text-gray-600\">NY, 12:36:53</span>\n            <a href=\"#\" class=\"flex items-center gap-2 group hover:text-gray-600 transition\">\n                Get in Touch\n                <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"2\" stroke=\"currentColor\" class=\"w-4 h-4 group-hover:translate-x-1 transition-transform\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3\" />\n                  </svg>\n            </a>\n        </div>\n    </header>\n\n\n    <main class=\"flex-grow px-8 lg:px-12 mt-16 lg:mt-24 mb-12\">\n        \n        <section class=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-start max-w-[1600px] mx-auto\">\n            \n            <div class=\"lg:col-span-7 flex gap-6 lg:gap-12\">\n                <span class=\"text-4xl lg:text-5xl text-gray-400 font-light\">/01</span>\n                \n                <div>\n                    <h1 class=\"text-6xl lg:text-8xl font-semibold tracking-tighter leading-none\">\n                        Street Style\n                    </h1>\n                    <h2 class=\"text-3xl lg:text-5xl text-gray-400 mt-2 lg:mt-4 tracking-tight\">\n                        Fashion in Urban Motion\n                    </h2>\n\n                    <p class=\"mt-12 lg:mt-24 text-lg leading-relaxed max-w-xl text-gray-800\">\n                        This project is a kinetic study of digital velocity - where motion becomes metaphor. Through a deliberate distortion of interface and momentum, it explores how digital systems stretch and accelerate under pressure —revealing new rhythms in disruption and flow.\n                    </p>\n                </div>\n            </div>\n\n            <div class=\"lg:col-span-5 lg:pl-12 pt-4 lg:pt-8\">\n                <h3 class=\"text-lg font-medium mb-6\">Project Info</h3>\n                \n                <ul class=\"flex flex-col\">\n                    <li class=\"flex justify-between py-4 border-b border-gray-300\">\n                        <span class=\"text-gray-500 w-1/3\">Services</span>\n                        <div class=\"text-right font-medium w-2/3\">\n                            Art Direction<br>\n                            Digital Design\n                        </div>\n                    </li>\n                     <li class=\"flex justify-between py-4 border-b border-gray-300 items-center\">\n                        <span class=\"text-gray-500 w-1/3\">Client</span>\n                        <span class=\"text-right font-medium w-2/3\">Aster Studio</span>\n                    </li>\n                     <li class=\"flex justify-between py-4 border-b border-gray-300 items-center\">\n                        <span class=\"text-gray-500 w-1/3\">Category</span>\n                        <span class=\"text-right font-medium w-2/3\">Fashion Editorial</span>\n                    </li>\n                     <li class=\"flex justify-between py-4 border-b border-gray-300 items-center\">\n                        <span class=\"text-gray-500 w-1/3\">Duration</span>\n                        <span class=\"text-right font-medium w-2/3\">May-August, 2025</span>\n                    </li>\n                </ul>\n            </div>\n        </section>\n\n        <section class=\"mt-16 lg:mt-24 w-full max-w-[1600px] mx-auto\">\n            <img \n                src=\"https://images.unsplash.com/photo-1504593811423-6dd665756598?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3\" \n                alt=\"Street Style Motion Blur\" \n                class=\"w-full h-[50vh] lg:h-[75vh] object-cover grayscale-[20%] contrast-125\"\n            >\n        </section>\n\n    </main>\n</body>\n</html>"
