      "content": "/**\n * Component: Responsive Bottom Nav\n * Author: @akash-gandhar (https://tailwindflex.com/@akash-gandhar)\n * Source: https://tailwindflex.com/@akash-gandhar/responsive-bottom-nav\n * Attribution: Créé par @akash-gandhar sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function ResponsiveBottomNav() {\n  return (\n    <div>\n    <div className=\"fixed bottom-0 z-50 w-full -translate-x-1/2 bg-white border-t border-gray-200 left-1/2 dark700 dark600\">\r\n        <div className=\"w-full\">\r\n            <div className=\"grid max-w-xs grid-cols-3 gap-1 p-1 mx-auto my-2 bg-gray-100 rounded-lg dark600\" role=\"group\">\r\n                <button type=\"button\" className=\"px-5 py-1.5 text-xs font-medium text-gray-900 hover200 dark dark700 rounded-lg\">\r\n                    New\r\n                </button>\r\n                <button type=\"button\" className=\"px-5 py-1.5 text-xs font-medium text-white bg-gray-900 dark300 dark900 rounded-lg\">\r\n                    Popular\r\n                </button>\r\n                <button type=\"button\" className=\"px-5 py-1.5 text-xs font-medium text-gray-900 hover200 dark dark700 rounded-lg\">\r\n                    Following\r\n                </button>\r\n            </div>\r\n        </div>\r\n        <div className=\"grid h-full max-w-lg grid-cols-5 mx-auto\">\r\n            <button data-tooltip-target=\"tooltip-home\" type=\"button\" className=\"inline-flex flex-col items-center justify-center p-4 hover50 dark800 group\">\r\n                <svg className=\"w-5 h-5 mb-1 text-gray-500 dark400 group-hover600 dark500\" aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\r\n                    <path d=\"m19.707 9.293-2-2-7-7a1 1 0 0 0-1.414 0l-7 7-2 2a1 1 0 0 0 1.414 1.414L2 10.414V18a2 2 0 0 0 2 2h3a1 1 0 0 0 1-1v-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v4a1 1 0 0 0 1 1h3a2 2 0 0 0 2-2v-7.586l.293.293a1 1 0 0 0 1.414-1.414Z\"/>\r\n                </svg>\r\n                <span className=\"sr-only\">Home</span>\r\n            </button>\r\n            <div id=\"tooltip-home\" role=\"tooltip\" className=\"absolute z-10 invisible inline-block px-3 py-2 text-sm font-medium text-white transition-opacity duration-300 bg-gray-900 rounded-lg shadow-sm opacity-0 tooltip dark700\">\r\n                Home\r\n                <div className=\"tooltip-arrow\" data-popper-arrow></div>\r\n            </div>\r\n            <button data-tooltip-target=\"tooltip-bookmark\" type=\"button\" className=\"inline-flex flex-col items-center justify-center p-4 hover50 dark800 group\">\r\n                <svg className=\"w-5 h-5 mb-1 text-gray-500 dark400 group-hover600 dark500\" aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"currentColor\" viewBox=\"0 0 14 20\">\r\n                    <path d=\"M13 20a1 1 0 0 1-.64-.231L7 15.3l-5.36 4.469A1 1 0 0 1 0 19V2a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v17a1 1 0 0 1-1 1Z\"/>\r\n                </svg>\r\n                <span className=\"sr-only\">Bookmark</span>\r\n            </button>\r\n            <div id=\"tooltip-bookmark\" role=\"tooltip\" className=\"absolute z-10 invisible inline-block px-3 py-2 text-sm font-medium text-white transition-opacity duration-300 bg-gray-900 rounded-lg shadow-sm opacity-0 tooltip dark700\">\r\n                Bookmark\r\n                <div className=\"tooltip-arrow\" data-popper-arrow></div>\r\n            </div>\r\n            <button data-tooltip-target=\"tooltip-post\" type=\"button\" className=\"inline-flex flex-col items-center justify-center p-4 hover50 dark800 group\">\r\n                <svg className=\"w-5 h-5 mb-1 text-gray-500 dark400 group-hover600 dark500\" aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 18 18\">\r\n                    <path stroke=\"currentColor\" strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"M9 1v16M1 9h16\"/>\r\n                </svg>\r\n                <span className=\"sr-only\">New post</span>\r\n            </button>\r\n            <div id=\"tooltip-post\" role=\"tooltip\" className=\"absolute z-10 invisible inline-block px-3 py-2 text-sm font-medium text-white transition-opacity duration-300 bg-gray-900 rounded-lg shadow-sm opacity-0 tooltip dark700\">\r\n                New post\r\n                <div className=\"tooltip-arrow\" data-popper-arrow></div>\r\n            </div>\r\n            <button data-tooltip-target=\"tooltip-search\" type=\"button\" className=\"inline-flex flex-col items-center justify-center p-4 hover50 dark800 group\">\r\n                <svg className=\"w-5 h-5 mb-1 text-gray-500 dark400 group-hover600 dark500\" aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 20 20\">\r\n                    <path stroke=\"currentColor\" strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"m19 19-4-4m0-7A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z\"/>\r\n                </svg>\r\n                <span className=\"sr-only\">Search</span>\r\n            </button>\r\n            <div id=\"tooltip-search\" role=\"tooltip\" className=\"absolute z-10 invisible inline-block px-3 py-2 text-sm font-medium text-white transition-opacity duration-300 bg-gray-900 rounded-lg shadow-sm opacity-0 tooltip dark700\">\r\n                Search\r\n                <div className=\"tooltip-arrow\" data-popper-arrow></div>\r\n            </div>\r\n            <button data-tooltip-target=\"tooltip-settings\" type=\"button\" className=\"inline-flex flex-col items-center justify-center p-4 hover50 dark800 group\">\r\n                <svg className=\"w-5 h-5 mb-1 text-gray-500 dark400 group-hover600 dark500\" aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 20 20\">\r\n                    <path stroke=\"currentColor\" strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"M4 12.25V1m0 11.25a2.25 2.25 0 0 0 0 4.5m0-4.5a2.25 2.25 0 0 1 0 4.5M4 19v-2.25m6-13.5V1m0 2.25a2.25 2.25 0 0 0 0 4.5m0-4.5a2.25 2.25 0 0 1 0 4.5M10 19V7.75m6 4.5V1m0 11.25a2.25 2.25 0 1 0 0 4.5 2.25 2.25 0 0 0 0-4.5ZM16 19v-2\"/>\r\n                </svg>\r\n                <span className=\"sr-only\">Settings</span>\r\n            </button>\r\n            <div id=\"tooltip-settings\" role=\"tooltip\" className=\"absolute z-10 invisible inline-block px-3 py-2 text-sm font-medium text-white transition-opacity duration-300 bg-gray-900 rounded-lg shadow-sm opacity-0 tooltip dark700\">\r\n                Settings\r\n                <div className=\"tooltip-arrow\" data-popper-arrow></div>\r\n            </div>\r\n        </div>\r\n    </div>\n    </div>\n  );\n}\n",
