      "content": "import * as React from \"react\"\n\nfunction LoginForm6({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"login-form-6\"\n      className={className}\n      {...props}\n    >\n      <div className=\"max-w-md mx-auto mt-24\">\n          <form className=\"p-4\">\n              <div className=\"mb-4\">\n                  <label htmlFor=\"email\" className=\"block text-gray-700 font-bold mb-2\">Email</label>\n                  <input type=\"email\" id=\"email\" name=\"email\" className=\"w-full py-2 px-3 border border-gray-400 rounded-md shadow-sm focus focus500\" placeholder=\"Enter your email address\" />\n              </div>\n              <div className=\"mb-4\">\n                  <label htmlFor=\"password\" className=\"block text-gray-700 font-bold mb-2\">Password</label>\n                  <input type=\"password\" id=\"password\" name=\"password\" className=\"w-full py-2 px-3 border border-gray-400 rounded-md shadow-sm focus focus500\" placeholder=\"Enter your password\" />\n              </div>\n              <div className=\"flex items-center justify-between\">\n                  <a href=\"#\"\n                      className=\"text-gray-500 hover500 focus focus transition duration-150 ease-in-out\">Forgot\n                      Password?</a>\n                  <button type=\"submit\" className=\"bg-blue-500 text-white py-2 px-4 rounded-md shadow-sm hover700 focus focus active800 transition duration-150 ease-in-out\">Submit</button>\n              </div>\n          </form>\n      </div>\n    </div>\n  )\n}\n\nexport { LoginForm6 }\n",
      "type": "registry:ui"
    }
