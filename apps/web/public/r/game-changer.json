      "content": "/**\n * Component: Game changer\n * Author: @baraka-salvator (https://tailwindflex.com/@baraka-salvator)\n * Source: https://tailwindflex.com/@baraka-salvator/game-changer\n * Attribution: Créé par @baraka-salvator sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function GameChanger() {\n  return (\n    <div dangerouslySetInnerHTML={{ __html: \"<!DOCTYPE html>\\n<html lang=\\\"en\\\" class=\\\"scroll-smooth\\\">\\n<head>\\n    <meta charset=\\\"UTF-8\\\">\\n    <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\">\\n    <title>Flesh & Bone | Survival Horror Game</title>\\n    \\n    \\n    <link rel=\\\"preconnect\\\" href=\\\"https://fonts.googleapis.com\\\">\\n    <link rel=\\\"preconnect\\\" href=\\\"https://fonts.gstatic.com\\\" crossorigin>\\n    <link href=\\\"https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Grotesk:wght@300;400;500;600;700&display=swap\\\" rel=\\\"stylesheet\\\">\\n    <style type=\\\"text/tailwindcss\\\">\\n        @layer utilities {\\n            .text-stroke-blood {\\n                -webkit-text-stroke: 1px theme('colors.blood');\\n                text-stroke: 1px theme('colors.blood');\\n            }\\n            .text-stroke-flesh {\\n                -webkit-text-stroke: 1px theme('colors.flesh');\\n                text-stroke: 1px theme('colors.flesh');\\n            }\\n            .perspective-1000 {\\n                perspective: 1000px;\\n            }\\n            .transform-style-preserve-3d {\\n                transform-style: preserve-3d;\\n            }\\n            .backface-hidden {\\n                backface-visibility: hidden;\\n            }\\n            .blood-drip {\\n                position: absolute;\\n                top: 0;\\n                left: 0;\\n                width: 2px;\\n                height: 100px;\\n                background: linear-gradient(to bottom, theme('colors.blood'), transparent);\\n                opacity: 0;\\n            }\\n        }\\n    </style>\\n</head>\\n<body class=\\\"bg-decay text-bone font-grotesk overflow-x-hidden\\\">\\n    <!-- Blood Drip Background Elements -->\\n    <div class=\\\"fixed inset-0 overflow-hidden z-0 pointer-events-none\\\">\\n        <div class=\\\"absolute inset-0 bg-[length:30px_30px] bg-blood-pattern opacity-10\\\"></div>\\n        <div class=\\\"absolute inset-0 bg-meat-texture opacity-5\\\"></div>\\n        <div id=\\\"bloodContainer\\\" class=\\\"absolute inset-0 overflow-hidden\\\"></div>\\n        <div class=\\\"absolute inset-0 bg-gradient-to-b from-black/70 to-black/30\\\"></div>\\n    </div>\\n\\n    <!-- Navigation -->\\n    <nav class=\\\"relative z-50 py-6 px-8 flex justify-between items-center border-b border-blood/20\\\">\\n        <div class=\\\"text-3xl font-condensed tracking-wider\\\">\\n            <span class=\\\"text-blood\\\">FLESH</span> & <span class=\\\"text-bone\\\">BONE</span>\\n        </div>\\n        <ul class=\\\"hidden md:flex space-x-8\\\">\\n            <li><a href=\\\"#\\\" class=\\\"hover:text-flesh transition-colors duration-300 font-medium\\\">About</a></li>\\n            <li><a href=\\\"#\\\" class=\\\"hover:text-flesh transition-colors duration-300 font-medium\\\">Gallery</a></li>\\n            <li><a href=\\\"#\\\" class=\\\"hover:text-flesh transition-colors duration-300 font-medium\\\">Gameplay</a></li>\\n            <li><a href=\\\"#\\\" class=\\\"hover:text-flesh transition-colors duration-300 font-medium\\\">Pre-order</a></li>\\n        </ul>\\n        <button class=\\\"hidden md:block bg-blood text-bone px-6 py-3 rounded-sm hover:bg-blood/90 transition-colors duration-300 font-medium tracking-wider\\\">\\n            PRE-ORDER NOW\\n        </button>\\n        <button class=\\\"md:hidden text-flesh\\\">\\n            <svg xmlns=\\\"http://www.w3.org/2000/svg\\\" class=\\\"h-8 w-8\\\" fill=\\\"none\\\" viewBox=\\\"0 0 24 24\\\" stroke=\\\"currentColor\\\">\\n                <path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" stroke-width=\\\"1.5\\\" d=\\\"M4 6h16M4 12h16M4 18h16\\\" />\\n            </svg>\\n        </button>\\n    </nav>\\n\\n    <!-- Hero Section -->\\n    <section class=\\\"min-h-screen relative overflow-hidden\\\">\\n        <div class=\\\"container mx-auto px-6 pt-24 md:pt-32 relative z-10\\\">\\n            <div class=\\\"flex flex-col lg:flex-row items-center\\\">\\n                <!-- Text Content -->\\n                <div class=\\\"lg:w-1/2 mb-16 lg:mb-0\\\">\\n                    <div class=\\\"max-w-2xl\\\">\\n                        <span class=\\\"inline-block px-4 py-1 bg-blood/20 text-blood rounded-sm text-sm font-medium mb-6 tracking-widest\\\">SURVIVAL HORROR</span>\\n                        <h1 class=\\\"text-5xl md:text-6xl lg:text-7xl xl:text-8xl font-condensed leading-none mb-8 animate-flicker\\\">\\n                            <span class=\\\"text-blood\\\">CONSUME</span><br>\\n                            OR BE <span class=\\\"text-stroke-blood\\\">CONSUMED</span>\\n                        </h1>\\n                        <p class=\\\"text-lg opacity-90 mb-10 max-w-lg\\\">\\n                            Stranded in the heart of a cannibal-infested jungle, you must make unthinkable choices to survive. \\n                            How far will you go to see another sunrise?\\n                        </p>\\n                        <div class=\\\"flex flex-col sm:flex-row gap-6\\\">\\n                            <button class=\\\"bg-blood text-bone px-8 py-4 rounded-sm font-condensed text-xl tracking-wider hover:bg-blood/90 transition-colors duration-300 flex items-center justify-center gap-2\\\">\\n                                WATCH TRAILER\\n                                <svg xmlns=\\\"http://www.w3.org/2000/svg\\\" class=\\\"h-5 w-5\\\" fill=\\\"none\\\" viewBox=\\\"0 0 24 24\\\" stroke=\\\"currentColor\\\">\\n                                    <path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" stroke-width=\\\"2\\\" d=\\\"M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z\\\" />\\n                                    <path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" stroke-width=\\\"2\\\" d=\\\"M21 12a9 9 0 11-18 0 9 9 0 0118 0z\\\" />\\n                                </svg>\\n                            </button>\\n                            <button class=\\\"border border-flesh/50 text-flesh px-8 py-4 rounded-sm font-condensed text-xl tracking-wider hover:bg-flesh/10 transition-colors duration-300\\\">\\n                                LEARN MORE\\n                            </button>\\n                        </div>\\n\\n                        <div class=\\\"mt-16 grid grid-cols-3 gap-8 max-w-md\\\">\\n                            <div>\\n                                <div class=\\\"text-blood text-3xl font-condensed mb-2\\\">18+</div>\\n                                <div class=\\\"text-sm opacity-70\\\">Mature Rating</div>\\n                            </div>\\n                            <div>\\n                                <div class=\\\"text-blood text-3xl font-condensed mb-2\\\">2024</div>\\n                                <div class=\\\"text-sm opacity-70\\\">Release Date</div>\\n                            </div>\\n                            <div>\\n                                <div class=\\\"text-blood text-3xl font-condensed mb-2\\\">4K</div>\\n                                <div class=\\\"text-sm opacity-70\\\">Ultra HD</div>\\n                            </div>\\n                        </div>\\n                    </div>\\n                </div>\\n\\n                <!-- Game Visual -->\\n                <div class=\\\"lg:w-1/2 relative perspective-1000 mt-16 lg:mt-0\\\">\\n                    <div class=\\\"relative w-full max-w-2xl mx-auto transform-style-preserve-3d\\\">\\n                        <!-- Main Game Image with Distortion Effect -->\\n                        <div class=\\\"relative overflow-hidden border-2 border-blood/30 shadow-2xl\\\">\\n                            <img src=\\\"https://cdn.midjourney.com/8c472e23-1ad4-41ec-bf5b-9f32458c947c/0_3.png\\\" \\n                                 alt=\\\"Flesh & Bone Game Scene\\\" \\n                                 class=\\\"w-full h-auto object-cover transform transition-transform duration-700 ease-out hover:scale-105\\\">\\n                            <div class=\\\"absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-black/0\\\"></div>\\n                            <div class=\\\"absolute bottom-0 left-0 p-6\\\">\\n                                <div class=\\\"text-blood font-condensed text-xl tracking-widest\\\">COMING 2024</div>\\n                                <div class=\\\"text-3xl font-condensed\\\">FLESH & BONE</div>\\n                            </div>\\n                        </div>\\n\\n                        <!-- Blood Splatter Decals -->\\n                        <div class=\\\"absolute top-10 -left-10 w-32 h-32 bg-blood/10 rounded-full blur-lg\\\"></div>\\n                        <div class=\\\"absolute bottom-20 -right-10 w-40 h-40 bg-blood/10 rounded-full blur-lg\\\"></div>\\n                        \\n                        <!-- Distressed Border Effect -->\\n                        <div class=\\\"absolute inset-0 border-2 border-blood/10 pointer-events-none\\\"></div>\\n                        <div class=\\\"absolute inset-2 border border-blood/5 pointer-events-none\\\"></div>\\n                    </div>\\n                </div>\\n            </div>\\n        </div>\\n\\n        <!-- Scrolling Indicator -->\\n        <div class=\\\"absolute bottom-8 left-1/2 transform -translate-x-1/2 z-10 animate-bounce\\\">\\n            <div class=\\\"text-blood\\\">\\n                <svg xmlns=\\\"http://www.w3.org/2000/svg\\\" class=\\\"h-8 w-8\\\" fill=\\\"none\\\" viewBox=\\\"0 0 24 24\\\" stroke=\\\"currentColor\\\">\\n                    <path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" stroke-width=\\\"1.5\\\" d=\\\"M19 14l-7 7m0 0l-7-7m7 7V3\\\" />\\n                </svg>\\n            </div>\\n        </div>\\n    </section>\\n\\n    <!-- Features Section -->\\n    <section class=\\\"py-32 bg-jungle/50 relative overflow-hidden\\\">\\n        <!-- Skewed Background -->\\n        <div class=\\\"absolute inset-0 overflow-hidden -skew-y-5 origin-top-left\\\">\\n            <div class=\\\"absolute inset-0 bg-meat-texture opacity-5 skew-y-5\\\"></div>\\n            <div class=\\\"absolute inset-0 bg-gradient-to-r from-black/90 via-black/50 to-black/90 skew-y-5\\\"></div>\\n        </div>\\n\\n        <div class=\\\"container mx-auto px-6 relative z-10 skew-y-5\\\">\\n            <h2 class=\\\"text-4xl font-condensed text-center mb-6\\\">\\n                <span class=\\\"text-blood\\\">FEATURES</span> THAT WILL HAUNT YOU\\n            </h2>\\n            <p class=\\\"text-center max-w-2xl mx-auto opacity-80 mb-16\\\">\\n                Experience survival horror like never before with our groundbreaking systems and mechanics.\\n            </p>\\n            \\n            <div class=\\\"grid grid-cols-1 md:grid-cols-3 gap-8\\\">\\n                <!-- Feature 1 -->\\n                <div class=\\\"bg-decay/80 p-8 border border-blood/10 hover:border-blood/30 transition-all duration-500 group\\\">\\n                    <div class=\\\"text-blood text-5xl font-condensed mb-4\\\">01</div>\\n                    <h3 class=\\\"text-2xl font-condensed mb-4\\\">MORAL DECAY SYSTEM</h3>\\n                    <p class=\\\"opacity-80 mb-6\\\">\\n                        Your choices affect your character's sanity and appearance. Will you maintain your humanity or embrace the darkness?\\n                    </p>\\n                    <div class=\\\"h-px w-full bg-blood/20 group-hover:bg-blood/50 transition-colors duration-500 mb-4\\\"></div>\\n                    <div class=\\\"text-blood/70 text-sm\\\">Every bite changes you...</div>\\n                </div>\\n                \\n                <!-- Feature 2 -->\\n                <div class=\\\"bg-decay/80 p-8 border border-blood/10 hover:border-blood/30 transition-all duration-500 group\\\">\\n                    <div class=\\\"text-blood text-5xl font-condensed mb-4\\\">02</div>\\n                    <h3 class=\\\"text-2xl font-condensed mb-4\\\">DYNAMIC HUNGER</h3>\\n                    <p class=\\\"opacity-80 mb-6\\\">\\n                        Starvation has never felt so real. As hunger grows, your vision distorts and your choices become more desperate.\\n                    </p>\\n                    <div class=\\\"h-px w-full bg-blood/20 group-hover:bg-blood/50 transition-colors duration-500 mb-4\\\"></div>\\n                    <div class=\\\"text-blood/70 text-sm\\\">Would you eat a friend?</div>\\n                </div>\\n                \\n                <!-- Feature 3 -->\\n                <div class=\\\"bg-decay/80 p-8 border border-blood/10 hover:border-blood/30 transition-all duration-500 group\\\">\\n                    <div class=\\\"text-blood text-5xl font-condensed mb-4\\\">03</div>\\n                    <h3 class=\\\"text-2xl font-condensed mb-4\\\">TRIBAL WARFARE</h3>\\n                    <p class=\\\"opacity-80 mb-6\\\">\\n                        Navigate complex relationships between warring cannibal tribes. Play them against each other or become their god.\\n                    </p>\\n                    <div class=\\\"h-px w-full bg-blood/20 group-hover:bg-blood/50 transition-colors duration-500 mb-4\\\"></div>\\n                    <div class=\\\"text-blood/70 text-sm\\\">All tribes must eat...</div>\\n                </div>\\n            </div>\\n        </div>\\n    </section>\\n\\n    <!-- Blood Drip Animation Script -->\\n    \\n</body>\\n</html>\" }} />\n  );\n}\n",
