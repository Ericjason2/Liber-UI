      "content": "/**\n * Component: Login Form\n * Author: @khalid (https://tailwindflex.com/@khalid)\n * Source: https://tailwindflex.com/@khalid/login-form-10\n * Attribution: Créé par @khalid sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function LoginForm10() {\n  return (\n    <div>\n    <div className=\"dark from-gray-900 to-gray-600 flex justify-center items-center w-screen h-screen p-5\">\n        <div className=\"bg-white shadow-md dark600 rounded px-8 pt-6 pb-8 mb-4 flex flex-col w-full md1/3 dark800\">\n            <h1 className=\"text-2xl font-semibold mb-4 text-center text-gray-900 dark200\">Admin Login</h1>\n            <form>\n                <div className=\"mb-4\">\n                    <label className=\"block text-gray-700 dark400 text-sm font-bold mb-2\" htmlFor=\"email\">\n                        Email <span className=\"text-red-500\">*</span>\n                    </label>\n                    <input className=\"shadow appearance-none border rounded-md w-full py-2 px-3 text-gray-700 leading-tight focus focus dark700 dark600 dark200\" id=\"email\" type=\"email\" placeholder=\"Email\" />\n                </div>\n                <div className=\"mb-6\">\n                    <label className=\"block text-gray-700 dark400 text-sm font-bold mb-2\" htmlFor=\"password\">\n                        Password <span className=\"text-red-500\">*</span>\n                    </label>\n                    <input className=\"shadow appearance-none border border-red-500 rounded-md w-full py-2 px-3 text-gray-700 mb-3 leading-tight focus focus dark700 dark600 dark200\" id=\"password\" type=\"password\" placeholder=\"******************\" />\n                </div>\n                <div className=\"flex items-center justify-between\">\n                    <button className=\"bg-green-500 hover700 text-white w-full font-bold py-2 px-4 rounded focus focus dark600\" type=\"button\">\n                        Login\n                    </button>\n                </div>\n            </form>\n        </div>\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
