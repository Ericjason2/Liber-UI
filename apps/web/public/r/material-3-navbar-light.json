      "content": "import * as React from \"react\"\n\nfunction Material3NavbarLight({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"material-3-navbar-light\"\n      className={className}\n      {...props}\n    >\n      <div className=\"flex flex-col gap-8 my-8\">\n      \n          \n      \n          \n          <div className=\"appbar drop-shadow-xl\">\n            <div className=\"appbar-start-box px-2\">\n              <button className=\"btn btn-appbar p-3\">\n                <span className=\"material-symbols-outlined\">menu</span>\n              </button>\n            </div>\n            <div className=\"appbar-center-box\">\n              <span className=\"appbar-heading px-16\">My App</span>\n            </div>\n            <div className=\"appbar-end-box px-2\">\n              <button className=\"btn btn-appbar p-3\">\n                <span className=\"material-symbols-outlined\">more_vert</span>\n              </button>\n            </div>\n          </div>\n      \n          \n          <div className=\"appbar drop-shadow-xl\">\n            <div className=\"appbar-start-box px-2\">\n              <button className=\"btn btn-appbar p-3\">\n                <span className=\"material-symbols-outlined\">arrow_back</span>\n              </button>\n              <span className=\"appbar-heading\">Details</span>\n            </div>\n            <div className=\"appbar-end-box px-2\">\n              <button className=\"btn btn-appbar p-3\">\n                <span className=\"material-symbols-outlined\">share</span>\n              </button>\n              <button className=\"btn btn-appbar p-3\">\n                <span className=\"material-symbols-outlined\">account_circle</span>\n              </button>\n            </div>\n          </div>\n      \n          \n          <div className=\"appbar drop-shadow-xl\">\n            <div className=\"appbar-start-box px-2\">\n              <button className=\"btn btn-appbar p-3 sm:hidden\">\n                <span className=\"material-symbols-outlined\">menu</span>\n              </button>\n              <span className=\"appbar-heading sm:ml-4\">Inbox</span>\n            </div>\n            <div className=\"appbar-end-box px-2\">\n              <button className=\"btn btn-appbar p-3\">\n                <span className=\"material-symbols-outlined\">attach_file</span>\n              </button>\n              <button className=\"btn btn-appbar p-3\">\n                <span className=\"material-symbols-outlined\">calendar_month</span>\n              </button>\n              <button className=\"btn btn-appbar p-3\">\n                <span className=\"material-symbols-outlined\">more_vert</span>\n              </button>\n            </div>\n          </div>\n      \n          \n          <div className=\"appbar drop-shadow-xl\">\n            <div className=\"appbar-start-box px-2\">\n              <button className=\"btn btn-appbar p-3\">\n                <span className=\"material-symbols-outlined\">arrow_back</span>\n              </button>\n              <span className=\"appbar-heading pr-16\">Crop Photo</span>\n            </div>\n            <div className=\"appbar-end-box px-2\">\n              <button className=\"btn px-5 py-3\">\n                <span className=\"material-symbols-outlined\">check</span>\n              </button>\n            </div>\n          </div>\n      \n          \n          <div className=\"appbar drop-shadow-xl\">\n            <div className=\"appbar-start-box px-2\">\n              <button className=\"btn btn-appbar p-3\">\n                <span className=\"material-symbols-outlined\">arrow_back</span>\n              </button>\n              <span className=\"appbar-heading\">Meals</span>\n            </div>\n            <div className=\"appbar-end-box px-2\">\n              <button className=\"btn p-3\">\n                <span className=\"material-symbols-outlined\">add</span>\n              </button>\n            </div>\n          </div>\n      \n          \n          <div className=\"appbar drop-shadow-xl\">\n            <div className=\"appbar-start-box px-2\">\n              <button className=\"btn btn-appbar p-3\">\n                <span className=\"material-symbols-outlined\">arrow_back</span>\n              </button>\n              <span className=\"appbar-heading\">Places</span>\n            </div>\n            <div className=\"appbar-end-box px-2\">\n              <button className=\"btn btn-tonal p-3\">\n                <span className=\"material-symbols-outlined\" style={{ fontVariationSettings: \"'FILL' 1\" }}>bookmark</span>\n              </button>\n            </div>\n          </div>\n      \n        </div>\n    </div>\n  )\n}\n\nexport { Material3NavbarLight }\n",
