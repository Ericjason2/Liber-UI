      "content": "/**\n * Component: Material 3 AppBar [Light]\n * Author: @nickgirga (https://tailwindflex.com/@nickgirga)\n * Source: https://tailwindflex.com/@nickgirga/material-3-navbar-light\n * Attribution: Créé par @nickgirga sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function Material3NavbarLight() {\n  return (\n    <div>\n    <head>\n        \n        <link href=\"https://fonts.googleapis.com/css2?family=Roboto@300;400;600;700&amp;display=swap\" rel=\"stylesheet\" />\n        \n        \n        <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" />\n    </head>\n    \n    <body data-theme=\"light\">\n      <div className=\"flex flex-col gap-8 my-8\">\n    \n        \n    \n        \n        <div className=\"appbar drop-shadow-xl\">\n          <div className=\"appbar-start-box px-2\">\n            <button className=\"btn btn-appbar p-3\">\n              <span className=\"material-symbols-outlined\">menu</span>\n            </button>\n          </div>\n          <div className=\"appbar-center-box\">\n            <span className=\"appbar-heading px-16\">My App</span>\n          </div>\n          <div className=\"appbar-end-box px-2\">\n            <button className=\"btn btn-appbar p-3\">\n              <span className=\"material-symbols-outlined\">more_vert</span>\n            </button>\n          </div>\n        </div>\n    \n        \n        <div className=\"appbar drop-shadow-xl\">\n          <div className=\"appbar-start-box px-2\">\n            <button className=\"btn btn-appbar p-3\">\n              <span className=\"material-symbols-outlined\">arrow_back</span>\n            </button>\n            <span className=\"appbar-heading\">Details</span>\n          </div>\n          <div className=\"appbar-end-box px-2\">\n            <button className=\"btn btn-appbar p-3\">\n              <span className=\"material-symbols-outlined\">share</span>\n            </button>\n            <button className=\"btn btn-appbar p-3\">\n              <span className=\"material-symbols-outlined\">account_circle</span>\n            </button>\n          </div>\n        </div>\n    \n        \n        <div className=\"appbar drop-shadow-xl\">\n          <div className=\"appbar-start-box px-2\">\n            <button className=\"btn btn-appbar p-3 sm\">\n              <span className=\"material-symbols-outlined\">menu</span>\n            </button>\n            <span className=\"appbar-heading sm4\">Inbox</span>\n          </div>\n          <div className=\"appbar-end-box px-2\">\n            <button className=\"btn btn-appbar p-3\">\n              <span className=\"material-symbols-outlined\">attach_file</span>\n            </button>\n            <button className=\"btn btn-appbar p-3\">\n              <span className=\"material-symbols-outlined\">calendar_month</span>\n            </button>\n            <button className=\"btn btn-appbar p-3\">\n              <span className=\"material-symbols-outlined\">more_vert</span>\n            </button>\n          </div>\n        </div>\n    \n        \n        <div className=\"appbar drop-shadow-xl\">\n          <div className=\"appbar-start-box px-2\">\n            <button className=\"btn btn-appbar p-3\">\n              <span className=\"material-symbols-outlined\">arrow_back</span>\n            </button>\n            <span className=\"appbar-heading pr-16\">Crop Photo</span>\n          </div>\n          <div className=\"appbar-end-box px-2\">\n            <button className=\"btn px-5 py-3\">\n              <span className=\"material-symbols-outlined\">check</span>\n            </button>\n          </div>\n        </div>\n    \n        \n        <div className=\"appbar drop-shadow-xl\">\n          <div className=\"appbar-start-box px-2\">\n            <button className=\"btn btn-appbar p-3\">\n              <span className=\"material-symbols-outlined\">arrow_back</span>\n            </button>\n            <span className=\"appbar-heading\">Meals</span>\n          </div>\n          <div className=\"appbar-end-box px-2\">\n            <button className=\"btn p-3\">\n              <span className=\"material-symbols-outlined\">add</span>\n            </button>\n          </div>\n        </div>\n    \n        \n        <div className=\"appbar drop-shadow-xl\">\n          <div className=\"appbar-start-box px-2\">\n            <button className=\"btn btn-appbar p-3\">\n              <span className=\"material-symbols-outlined\">arrow_back</span>\n            </button>\n            <span className=\"appbar-heading\">Places</span>\n          </div>\n          <div className=\"appbar-end-box px-2\">\n            <button className=\"btn btn-tonal p-3\">\n              <span className=\"material-symbols-outlined\" style=\"font-variation-settings: 'FILL' 1;\">bookmark</span>\n            </button>\n          </div>\n        </div>\n    \n      </div>\n    </body>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
