ype=\\\"submit\\\"\\n          class=\\\"mt-1 bg-[#1C1C1E] text-white py-2.5 rounded-lg font-semibold text-sm tracking-wide hover:bg-[#FF6B35] hover:text-[#1C1C1E] active:scale-[0.98] transition disabled:opacity-50 disabled:cursor-not-allowed\\\"\\n        >\\n          Log In\\n        </button>\\n      </form>\\n      <div class=\\\"my-6 flex items-center gap-3\\\">\\n        <div class=\\\"tread-divider flex-1\\\"></div>\\n        <span class=\\\"text-[10px] font-bold tracking-widest text-[#A6A29A]\\\">OR</span>\\n        <div class=\\\"tread-divider flex-1\\\"></div>\\n      </div>\\n      <a href=\\\"/Forgot\\\" class=\\\"block text-sm text-[#1f5070] hover:text-[#FF6B35] underline underline-offset-2 mb-6\\\">\\n        Forgot password?\\n      </a>\\n      <div class=\\\"flex items-center justify-between border-t border-[#E4E0D6] pt-4\\\">\\n        <p class=\\\"text-sm text-[#5b5b5f]\\\">New around here?</p>\\n        <a href=\\\"/RegistrationForm\\\">\\n          <button class=\\\"text-white bg-[#1C1C1E] rounded-lg py-2 px-4 text-sm font-semibold hover:bg-[#FF6B35] hover:text-[#1C1C1E] transition\\\">\\n            Create account\\n          </button>\\n        </a>\\n      </div>\\n    </div>\\n    <div class=\\\"hidden md:flex w-1/2 relative bg-[#101012] items-center justify-center overflow-hidden\\\">\\n      <div class=\\\"absolute inset-0 opacity-30 bg-noise\\\"></div>\\n      <svg class=\\\"spin-slow\\\" width=\\\"260\\\" height=\\\"260\\\" viewBox=\\\"0 0 200 200\\\" fill=\\\"none\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n        <circle cx=\\\"100\\\" cy=\\\"100\\\" r=\\\"92\\\" stroke=\\\"#2A2A2E\\\" stroke-width=\\\"16\\\"/>\\n        <circle cx=\\\"100\\\" cy=\\\"100\\\" r=\\\"92\\\" stroke=\\\"#FF6B35\\\" stroke-width=\\\"2\\\" stroke-dasharray=\\\"4 10\\\"/>\\n        <circle cx=\\\"100\\\" cy=\\\"100\\\" r=\\\"55\\\" fill=\\\"#1C1C1E\\\" stroke=\\\"#3a3a3d\\\" stroke-width=\\\"2\\\"/>\\n        <circle cx=\\\"100\\\" cy=\\\"100\\\" r=\\\"1