eholder:text-[#B0ADA4] focus:outline-none focus:ring-2 focus:ring-[#FF6B35] focus:border-transparent transition\"\n            />\n          </div>\n        </div>\n        <div>\n          <div class=\"relative\">\n            <span class=\"absolute left-3 top-1/2 -translate-y-1/2 text-[#9a9a9e]\">\n              <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                <rect x=\"5\" y=\"10.5\" width=\"14\" height=\"9\" rx=\"1.6\" stroke=\"currentColor\" stroke-width=\"1.6\"/>\n                <path d=\"M8 10.5V7.8a4 4 0 1 1 8 0v2.7\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/>\n              </svg>\n            </span>\n            <input\n              id=\"password\"\n              type=\"password\"\n              name=\"password\"\n              placeholder=\"••••••••\"\n              required\n              class=\"w-full rounded-lg border border-[#D9D5CC] bg-white py-2.5 pl-10 pr-10 text-sm text-[#1C1C1E] placeholder:text-[#B0ADA4] focus:outline-none focus:ring-2 focus:ring-[#FF6B35] focus:border-transparent transition\"\n            />\n            <button\n              type=\"button\"\n              id=\"togglePassword\"\n              aria-label=\"Show password\"\n              class=\"absolute right-3 top-1/2 -translate-y-1/2 text-[#9a9a9e] hover:text-[#1C1C1E] transition\"\n            >\n              <svg id=\"eyeOpen\" width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                <path d=\"M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\"/>\n                <circle cx=\"12\" cy=\"12\" r=\"3\" stroke=\"currentColor\" stroke-width=\"1.6\"/>\n              </svg>\n              <svg id=\"eyeClosed\" width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" class=\"hidden\">\n                <path d=\"M3 3l18 18\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/>\n                <path d=\"M10.6 5.2C11 5.1 11.5 5 12 5c6.4 0 10 7 10 7a17.6 17.6 0 0 1-3.4 4.3M6.6 6.6C4 8.3 2 12 2 12s3.6 7 10 7c1.4 0 2.6-.3 3.7-.8\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n                <path d=\"M9.9 9.9a3 3 0 0 0 4.2 4.2\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/>\n              </svg>\n            </button>\n          </div>\n        </div>\n        <p id=\"errorMsg\" class=\"hidden text-xs font-medium text-red-600 -mt-2\"></p>\n        <button\n          id=\"submitBtn\"\n          type=\"submit\"\n          class=\"mt-1 bg-[#1C1C1E] text-white py-2.5 rounded-lg font-semibold text-sm tracking-wide hover:bg-[#FF6B35] hover:text-[#1C1C1E] active:scale-[0.98] transition disabled:opacity-50 disabled:cursor-not-allowed\"\n        >\n          Log In\n        </button>\n      </form>\n      <div class=\"my-6 flex items-center gap-3\">\n        <div class=\"tread-divider flex-1\"></div>\n        <span class=\"text-[10px] font-bold tracking-widest text-[#A6A29A]\">OR</span>\n        <div class=\"tread-divider flex-1\"></div>\n      </div>\n      <a href=\"/Forgot\" class=\"block text-sm text-[#1f5070] hover:text-[#FF6B35] underline underline-offset-2 mb-6\">\n        Forgot password?\n      </a>\n      <div class=\"flex items-center justify-between border-t border-[#E4E0D6] pt-4\">\n        <p class=\"text-sm text-[#5b5b5f]\">New around here?</p>\n        <a href=\"/RegistrationForm\">\n          <button class=\"text-white bg-[#1C1C1E] rounded-lg py-2 px-4 text-sm font-semibold hover:bg-[#FF6B35] hover:text-[#1C1C1E] transition\">\n            Create account\n          </button>\n        </a>\n      </div>\n    </div>\n    <div class=\"hidden md:flex w-1/2 relative bg-[#101012] items-center justify-center overflow-hidden\">\n      <div class=\"absolute inset-0 opacity-30 bg-noise\"></div>\n      <svg class=\"spin-slow\" width=\"260\" height=\"260\" viewBox=\"0 0 200 200\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n        <circle cx=\"100\" cy=\"100\" r=\"92\" stroke=\"#2A2A2E\" stroke-width=\"16\"/>\n        <circle cx=\"100\" cy=\"100\" r=\"92\" stroke=\"#FF6B35\" stroke-width=\"2\" stroke-dasharray=\"4 10\"/>\n        <circle cx=\"100\" cy=\"100\" r=\"55\" fill=\"#1C1C1E\" stroke=\"#3a3a3d\" stroke-width=\"2\"/>\n        <circle cx=\"100\" cy=\"100\" r=\"14\" fill=\"#2A2A2E\" stroke=\"#FF6B35\" stroke-width=\"2\"/>\n        <g stroke=\"#3a3a3d\" stroke-width=\"6\" stroke-linecap=\"round\">\n          <line x1=\"100\" y1=\"60\" x2=\"100\" y2=\"80\"/>\n          <line x1=\"100\" y1=\"120\" x2=\"100\" y2=\"140\"/>\n          <line x1=\"60\" y1=\"100\" x2=\"80\" y2=\"100\"/>\n          <line x1=\"120\" y1=\"100\" x2=\"140\" y2=\"100\"/>\n          <line x1=\"71.7\" y1=\"71.7\" x2=\"84.9\" y2=\"84.9\"/>\n          <line x1=\"115.1\" y1=\"115.1\" x2=\"128.3\" y2=\"128.3\"/>\n          <line x1=\"71.7\" y1=\"128.3\" x2=\"84.9\" y2=\"115.1\"/>\n          <line x1=\"115.1\" y1=\"84.9\" x2=\"128.3\" y2=\"71.7\"/>\n        </g>\n      </svg>\n      <div class=\"absolute bottom-8 left-8 right-8 text-center\">\n        <p class=\"font-display font-600 text-white text-lg tracking-wide\">Every mile starts with the right grip.</p>\n        <p class=\"text-xs text-zinc-400 mt-1\">Book a fitting in under 3 minutes.</p>\n      </div>\n    </div>\n\n  </div>\n</main>\n<footer class=\"bg-[#101012] border-t border-white/10\">\n  <div class=\"max-w-7xl mx-auto px-6 py-6 flex flex-col sm:flex-row items-center justify-between gap-3\">\n    <p class=\"text-xs text-zinc-500\">© 2026 TreadWorks. All rights reserved.</p>\n    <div class=\"flex items-center gap-5 text-xs text-zinc-500\">\n      <a href=\"#\" class=\"hover:text-zinc-300 transition\">Privacy</a>\n      <a href=\"#\" class=\"hover:text-zinc-300 transition\">Terms</a>\n      <a href=\"#\" class=\"hover:text-zinc-300 transition\">Contact</a>\n    </div>\n  </div>\n</footer>\n<script>\n  const pwInput = document.getElementById('password');\n  const toggleBtn = document.getElementById('togglePassword');\n  const eyeOpen = document.getElementById('eyeOpen');\n  const eyeClosed = document.getElementById('eyeClosed');\n  toggleBtn.addEventListener('click', () => {\n    const isPassword = pwInput.type === 'password';\n    pwInput.type = isPassword ? 'text' : 'password';\n    eyeOpen.classList.toggle('hidden', isPassword);\n    eyeClosed.classList.toggle('hidden', !isPassword);\n    toggleBtn.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');\n  });\n\n</script>\n</body>"
