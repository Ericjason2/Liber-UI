      "content": "/**\n * Component: Tailwind Hero Section\n * Author: @akash-gandhar (https://tailwindflex.com/@akash-gandhar)\n * Source: https://tailwindflex.com/@akash-gandhar/tailwind-hero-section\n * Attribution: Créé par @akash-gandhar sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function TailwindHeroSection() {\n  return (\n    <div>\n    \r\n    <section className=\"w-full px-8 text-gray-700 bg-white\">\r\n        <div className=\"container flex flex-col flex-wrap items-center justify-between py-5 mx-auto md max-w-7xl\">\r\n            <div className=\"relative flex flex-col md\">\r\n                <a href=\"#_\" className=\"flex items-center mb-5 font-medium text-gray-900 lg lg lg md0\">\r\n                    <span className=\"mx-auto text-xl font-black leading-none text-gray-900 select-none\">AI<span className=\"text-indigo-600\">.</span></span>\r\n                </a>\r\n                <nav className=\"flex flex-wrap items-center mb-5 text-base md0 md8 md8 md md200\">\r\n                    <a href=\"#_\" className=\"mr-5 font-medium leading-6 text-gray-600 hover900\">Home</a>\r\n                    <a href=\"#_\" className=\"mr-5 font-medium leading-6 text-gray-600 hover900\">Features</a>\r\n                    <a href=\"#_\" className=\"mr-5 font-medium leading-6 text-gray-600 hover900\">Pricing</a>\r\n                    <a href=\"#_\" className=\"mr-5 font-medium leading-6 text-gray-600 hover900\">Blog</a>\r\n                </nav>\r\n            </div>\r\n    \r\n            <div className=\"inline-flex items-center ml-5 space-x-6 lg\">\r\n                <a href=\"#\" className=\"text-base font-medium leading-6 text-gray-600 whitespace-no-wrap transition duration-150 ease-in-out hover900\">\r\n                    Sign in\r\n                </a>\r\n                <a href=\"#\" className=\"inline-flex items-center justify-center px-4 py-2 text-base font-medium leading-6 text-white whitespace-no-wrap bg-indigo-600 border border-transparent rounded-md shadow-sm hover500 focus focus2 focus2 focus600\">\r\n                    Sign up\r\n                </a>\r\n            </div>\r\n        </div>\r\n    </section>\r\n    \r\n    \r\n    <section className=\"px-2 py-32 bg-white md0\">\r\n      <div className=\"container items-center max-w-6xl px-8 mx-auto xl5\">\r\n        <div className=\"flex flex-wrap items-center sm3\">\r\n          <div className=\"w-full md1/2 md3\">\r\n            <div className=\"w-full pb-6 space-y-6 sm lg md4 lg8 xl9 sm5 lg0 md0\">\r\n              <h1 className=\"text-4xl font-extrabold tracking-tight text-gray-900 sm5xl md4xl lg5xl xl6xl\">\r\n                <span className=\"block xl\">Useful Tools to</span>\r\n                <span className=\"block text-indigo-600 xl\">Help You Build Faster.</span>\r\n              </h1>\r\n              <p className=\"mx-auto text-base text-gray-500 sm lg md3xl\">It's never been easier to build beautiful websites that convey your message and tell your story.</p>\r\n              <div className=\"relative flex flex-col sm sm4\">\r\n                <a href=\"#_\" className=\"flex items-center w-full px-6 py-3 mb-3 text-lg text-white bg-indigo-600 rounded-md sm0 hover700 sm\">\r\n                  Try It Free\r\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"w-5 h-5 ml-1\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\"><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line><polyline points=\"12 5 19 12 12 19\"></polyline></svg>\r\n                </a>\r\n                <a href=\"#_\" className=\"flex items-center px-6 py-3 text-gray-500 bg-gray-100 rounded-md hover200 hover600\">\r\n                  Learn More\r\n                </a>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div className=\"w-full md1/2\">\r\n            <div className=\"w-full h-auto overflow-hidden rounded-md shadow-xl sm\">\r\n                <img src=\"https://images.unsplash.com/photo-1498049860654-af1a5c566876?ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&ixlib=rb-1.2.1&auto=format&fit=crop&w=1050&q=80\" />\r\n              </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
