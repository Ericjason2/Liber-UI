      "content": "/**\n * Component: Fancy blog post card\n * Author: @mr-robot (https://tailwindflex.com/@mr-robot)\n * Source: https://tailwindflex.com/@mr-robot/fancy-blog-post-card\n * Attribution: Créé par @mr-robot sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function FancyBlogPostCard() {\n  return (\n    <div>\n    <div className=\"max-w-screen-xl mx-auto p-5 sm10 md16\">\r\n    \r\n        <div className=\"rounded overflow-hidden flex flex-col max-w-xl mx-auto\">\r\n    \r\n            <a href=\"#\">\r\n                <img className=\"w-full\" src=\"https://images.pexels.com/photos/5120892/pexels-photo-5120892.jpeg?auto=compress&amp;cs=tinysrgb&amp;fit=crop&amp;h=625.0&amp;sharp=10&amp;w=1000\" alt=\"Sunset in the mountains\" />\r\n            </a>\r\n            <div className=\"relative -mt-16 px-10 pt-5 pb-16 bg-white m-10\">\r\n                <a href=\"#\"\r\n                    className=\"font-semibold text-lg inline-block hover600 transition duration-500 ease-in-out inline-block mb-2\">The\r\n                    Best Activewear from the Nordstrom Anniversary Sale</a>\r\n                <p className=\"text-gray-500 text-sm\">\r\n                    Today, I’m covering one of my favorite parts of the Nordstrom Anniversary Sale: the activewear!\r\n                </p>\r\n                <p className=\"mt-5 text-gray-600 text-xs\">\r\n                    By\r\n                    <a href=\"#\" className=\"text-xs text-indigo-600 transition duration-500 ease-in-out\">\r\n                        Mehdi Ahmadi\r\n                    </a> | in <a href=\"#\" className=\"text-xs text-indigo-600 transition duration-500 ease-in-out\">\r\n                        Cooking\r\n                    </a>, <a href=\"#\" className=\"text-xs text-indigo-600 transition duration-500 ease-in-out\">\r\n                        Recipe\r\n                    </a>\r\n                </p>\r\n            </div>\r\n    \r\n        </div>\r\n    \r\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
