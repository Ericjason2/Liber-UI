sition-all duration-200 bg-transparent border border-transparent sm0 font-pj justif-center rounded-xl focus focus2 focus2 focus300 hover200 focus200\"\n                                role=\"button\"\n                            >\n                                <svg className=\"w-5 h-5 mr-2\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                                    <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2.5\" d=\"M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4\"></path>\n                                </svg>\n                                Download iOS App\n                            </a>\n                        </div>\n                    </div>\n    \n                    <div className=\"xl3\">\n                        <img className=\"w-full mx-auto scale-110\" src=\"https://d33wubrfki0l68.cloudfront.net/29c501c64b21014b3f2e225abe02fe31fd8f3a5c/f866d/images/hero/3/illustration.png\" alt=\"\" />\n                    </div>\n                </div>\n            </div>\n        </section>\n    </div>\n    </div>\n  );\n}\n",
