    {
      "path": "components/ui/navber.tsx",
      "content": "import * as React from \"react\"\n\nfunction Navber({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"navber\"\n      className={className}\n      {...props}\n    >\n      <style>{\"[x-cloak] { display: none; }\"}</style>\n      \n      <header className=\"sticky top-0 z-50 w-full transition-all duration-300\"\n       >\n      \n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n          <div className=\"flex h-16 items-center justify-between\">\n      \n            \n            <a href=\"/\" className=\"text-xl sm:text-2xl font-bold text-purple-600 hover:text-purple-500 transition-colors\">\n              MobileMaven\n            </a>\n      \n            \n            <nav className=\"hidden lg:flex space-x-4 xl:space-x-6\">\n              <a href=\"/\" className=\"text-gray-700 dark:text-gray-200 hover:text-purple-600 transition text-sm xl:text-base\">Home</a>\n              <a href=\"/\" className=\"text-gray-700 dark:text-gray-200 hover:text-purple-600 transition text-sm xl:text-base\">Phones</a>\n              <a href=\"/\" className=\"text-gray-700 dark:text-gray-200 hover:text-purple-600 transition text-sm xl:text-base\">Accessories</a>\n              <a href=\"/\" className=\"text-gray-700 dark:text-gray-200 hover:text-purple-600 transition text-sm xl:text-base\">Wearables</a>\n              <a href=\"/\" className=\"text-orange-500 hover:text-orange-400 transition text-sm xl:text-base\">Deals</a>\n            </nav>\n      \n            \n            <div className=\"flex items-center space-x-2\">\n      \n              \n              <button className=\"p-2 rounded hover:bg-gray-100 dark:hover:bg-gray-800\">\n                <i data-lucide=\"search\" className=\"w-5 h-5 sm:w-6 sm:h-6\"></i>\n              </button>\n      \n              \n              <button className=\"relative p-2 rounded hover:bg-gray-100 dark:hover:bg-gray-800\">\n                <i data-lucide=\"shopping-cart\" className=\"w-5 h-5 sm:w-6 sm:h-6\"></i>\n                <span className=\"absolute -top-1 -right-1 bg-purple-600 text-white text-[10px] sm:text-xs rounded-full h-5 w-5 flex items-center justify-center\">3</span>\n              </button>\n      \n              \n              <a href=\"/profile\" className=\"p-2 rounded hover:bg-gray-100 dark:hover:bg-gray-800\">\n                <i data-lucide=\"user\" className=\"w-5 h-5 sm:w-6 sm:h-6\"></i>\n              </a>\n      \n              \n              <button\n                className=\"lg:hidden p-2 rounded hover:bg-gray-100 dark:hover:bg-gray-800\"\n               \n               \n              >\n                <i className=\"w-5 h-5 sm:w-6 sm:h-6\"></i>\n              </button>\n            </div>\n          </div>\n      \n          \n          <div className=\"mt-2 border-t pt-3\">\n            <div className=\"relative\">\n              <i data-lucide=\"search\" className=\"absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400 h-4 w-4\"></i>\n              <input\n                type=\"search\"\n                placeholder=\"Search products...\"\n                className=\"w-full py-2 pl-10 pr-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500\"\n                autoFocus\n              />\n            </div>\n          </div>\n      \n          \n          <div className=\"lg:hidden mt-3 border-t pt-3 space-y-2 pb-4\">\n            <a href=\"/\" className=\"block py-2 px-3 rounded hover:bg-gray-100 dark:hover:bg-gray-800\">Home</a>\n            <a href=\"/s\" className=\"block py-2 px-3 rounded hover:bg-gray-100 dark:hover:bg-gray-800\">Phones</a>\n            <a href=\"/\" className=\"block py-2 px-3 rounded hover:bg-gray-100 dark:hover:bg-gray-800\">Accessories</a>\n            <a href=\"/\" className=\"block py-2 px-3 rounded hover:bg-gray-100 dark:hover:bg-gray-800\">Wearables</a>\n            <a href=\"/\" className=\"block py-2 px-3 rounded text-orange-500 hover:bg-gray-100 dark:hover:bg-gray-800\">Deals</a>\n            <hr className=\"border-gray-200 dark:border-gray-700\" />\n            <a href=\"/\" className=\"block py-2 px-3 rounded hover:bg-gray-100 dark:hover:bg-gray-800\">Sign In</a>\n            <a href=\"/\" className=\"block py-2 px-3 rounded hover:bg-gray-100 dark:hover:bg-gray-800\">Register</a>\n          </div>\n        </div>\n      </header>\n      \n      \n    </div>\n  )\n}\n\nexport { Navber }\n",
      "type": "registry:ui"
    }
  ],
  "meta": {
    "kind": "component",
    "tags": [
      "navbar"
    ],
    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\" x-data=\"{ mobileMenuOpen: false, searchOpen: false, isScrolled: false }\"\n  x-init=\"window.addEventListener('scroll', () => isScrolled = window.scrollY > 50)\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>MobileMaven Header</title>\n\n  <!-- Tailwind CSS CDN -->\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n\n  <!-- Alpine.js CDN -->\n  <script defer src=\"https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js\"></script>\n\n  <!-- Lucide Icons CDN -->\n  <script src=\"https://unpkg.com/lucide@latest\"></script>\n\n  <style>[x-cloak] { display: none; }</style>\n</head>\n<body class=\"bg-white dark:bg-gray-900 text-gray-900 dark:text-white\">\n\n<!-- HEADER -->\n<header class=\"sticky top-0 z-50 w-full transition-all duration-300\"\n  :class=\"isScrolled ? 'bg-white/90 dark:bg-gray-900/90 backdrop-blur shadow-sm' : 'bg-white dark:bg-gray-900'\">\n\n  <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n    <div class=\"flex h-16 items-center justify-between\">\n\n      <!-- Logo -->\n      <a href=\"/\" class=\"text-xl sm:text-2xl font-bold text-purple-600 hover:text-purple-500 transition-colors\">\n        MobileMaven\n      </a>\n\n      <!-- Desktop Navigation -->\n      <nav class=\"hidden lg:flex space-x-4 xl:space-x-6\">\n        <a href=\"/\" class=\"text-gray-700 dark:text-gray-200 hover:text-purple-600 transition text-sm xl:text-base\">Home</a>\n        <a href=\"/\" class=\"text-gray-700 dark:text-gray-200 hover:text-purple-600 transition text-sm xl:text-base\">Phones</a>\n        <a href=\"/\" class=\"text-gray-700 dark:text-gray-200 hover:text-purple-600 transition text-sm xl:text-base\">Accessories</a>\n        <a href=\"/\" class=\"text-gray-700 dark:text-gray-200 hover:text-purple-600 transition text-sm xl:text-base\">Wearables</a>\n        <a href=\"/\" class=\"text-orange-500 hover:text-orange-400 transition text-sm xl:text-base\">Deals</a>\n      </nav>\n\n      <!-- Action Buttons -->\n      <div class=\"flex items-center space-x-2\">\n\n        <!-- Search Toggle -->\n        <button @click=\"searchOpen = !searchOpen\" class=\"p-2 rounded hover:bg-gray-100 dark:hover:bg-gray-800\">\n          <i data-lucide=\"search\" class=\"w-5 h-5 sm:w-6 sm:h-6\"></i>\n        </button>\n\n        <!-- Cart Button -->\n        <button class=\"relative p-2 rounded hover:bg-gray-100 dark:hover:bg-gray-800\">\n          <i data-lucide=\"shopping-cart\" class=\"w-5 h-5 sm:w-6 sm:h-6\"></i>\n          <span class=\"absolute -top-1 -right-1 bg-purple-600 text-white text-[10px] sm:text-xs rounded-full h-5 w-5 flex items-center justify-center\">3</span>\n        </button>\n\n        <!-- User Icon -->\n        <a href=\"/profile\" class=\"p-2 rounded hover:bg-gray-100 dark:hover:bg-gray-800\">\n          <i data-lucide=\"user\" class=\"w-5 h-5 sm:w-6 sm:h-6\"></i>\n        </a>\n\n        <!-- Mobile Menu Toggle -->\n        <button\n          class=\"lg:hidden p-2 rounded hover:bg-gray-100 dark:hover:bg-gray-800\"\n          @click=\"mobileMenuOpen = !mobileMenuOpen\"\n          x-init=\"$watch('mobileMenuOpen', () => lucide.createIcons())\"\n        >\n          <i :data-lucide=\"mobileMenuOpen ? 'x' : 'menu'\" class=\"w-5 h-5 sm:w-6 sm:h-6\"></i>\n        </button>\n      </div>\n    </div>\n\n    <!-- Search Bar -->\n    <div x-show=\"searchOpen\" x-cloak x-transition class=\"mt-2 border-t pt-3\">\n      <div class=\"relative\">\n        <i data-lucide=\"search\" class=\"absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400 h-4 w-4\"></i>\n        <input\n          type=\"search\"\n          placeholder=\"Search products...\"\n          class=\"w-full py-2 pl-10 pr-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500\"\n          autofocus\n        />\n      </div>\n    </div>\n\n    <!-- Mobile Menu -->\n    <div x-show=\"mobileMenuOpen\" x-cloak x-transition class=\"lg:hidden mt-3 border-t pt-3 space-y-2 pb-4\">\n      <a href=\"/\" class=\"block py-2 px-3 rounded hover:bg-gray-100 dark:hover:bg-gray-800\">Home</a>\n      <a href=\"/s\" class=\"block py-2 px-3 rounded hover:bg-gray-100 dark:hover:bg-gray-800\">Phones</a>\n      <a href=\"/\" class=\"block py-2 px-3 rounded hover:bg-gray-100 dark:hover:bg-gray-800\">Accessories</a>\n      <a href=\"/\" class=\"block py-2 px-3 rounded hover:bg-gray-100 dark:hover:bg-gray-800\">Wearables</a>\n      <a href=\"/\" class=\"block py-2 px-3 rounded text-orange-500 hover:bg-gray-100 dark:hover:bg-gray-800\">Deals</a>\n      <hr class=\"border-gray-200 dark:border-gray-700\" />\n      <a href=\"/\" class=\"block py-2 px-3 rounded hover:bg-gray-100 dark:hover:bg-gray-800\">Sign In</a>\n      <a href=\"/\" class=\"block py-2 px-3 rounded hover:bg-gray-100 dark:hover:bg-gray-800\">Register</a>\n    </div>\n  </div>\n</header>\n\n<!-- Initialize Lucide Icons -->\n<script>\n  lucide.createIcons();\n</script>\n\n</body>\n</html>"
  }
}
