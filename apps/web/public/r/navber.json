ark:text-gray-200 hover:text-purple-600 transition text-sm xl:text-base\\\">Accessories</a>\\n        <a href=\\\"/\\\" class=\\\"text-gray-700 dark:text-gray-200 hover:text-purple-600 transition text-sm xl:text-base\\\">Wearables</a>\\n        <a href=\\\"/\\\" class=\\\"text-orange-500 hover:text-orange-400 transition text-sm xl:text-base\\\">Deals</a>\\n      </nav>\\n\\n      <!-- Action Buttons -->\\n      <div class=\\\"flex items-center space-x-2\\\">\\n\\n        <!-- Search Toggle -->\\n        <button @click=\\\"searchOpen = !searchOpen\\\" class=\\\"p-2 rounded hover:bg-gray-100 dark:hover:bg-gray-800\\\">\\n          <i data-lucide=\\\"search\\\" class=\\\"w-5 h-5 sm:w-6 sm:h-6\\\"></i>\\n        </button>\\n\\n        <!-- Cart Button -->\\n        <button class=\\\"relative p-2 rounded hover:bg-gray-100 dark:hover:bg-gray-800\\\">\\n          <i data-lucide=\\\"shopping-cart\\\" class=\\\"w-5 h-5 sm:w-6 sm:h-6\\\"></i>\\n          <span class=\\\"absolute -top-1 -right-1 bg-purple-600 text-white text-[10px] sm:text-xs rounded-full h-5 w-5 flex items-center justify-center\\\">3</span>\\n        </button>\\n\\n        <!-- User Icon -->\\n        <a href=\\\"/profile\\\" class=\\\"p-2 rounded hover:bg-gray-100 dark:hover:bg-gray-800\\\">\\n          <i data-lucide=\\\"user\\\" class=\\\"w-5 h-5 sm:w-6 sm:h-6\\\"></i>\\n        </a>\\n\\n        <!-- Mobile Menu Toggle -->\\n        <button\\n          class=\\\"lg:hidden p-2 rounded hover:bg-gray-100 dark:hover:bg-gray-800\\\"\\n          @click=\\\"mobileMenuOpen = !mobileMenuOpen\\\"\\n          x-init=\\\"$watch('mobileMenuOpen', () => lucide.createIcons())\\\"\\n        >\\n          <i :data-lucide=\\\"mobileMenuOpen ? 'x' : 'menu'\\\" class=\\\"w-5 h-5 sm:w-6 sm:h-6\\\"></i>\\n        </button>\\n      </div>\\n    </div>\\n\\n    <!-- Search Bar -->\\n    <div x-show=\\\"searchOpen\\\" x-cloak x-transition class=\\\"mt-2 border-t pt-3\\\">\\n      <div class=\\\"relative\\\">\\n        <i data-lucide=\\\"search\\\" class=\\\"absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400 h-4 w-4\\\"></i>\\n        <input\\n          type=\\\"search\\\"\\n          placeholder=\\\"Search products...\\\"\\n          class=\\\"w-full py-2 pl-10 pr-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500\\\"\\n          autofocus\\n        />\\n      </div>\\n    </div>\\n\\n    <!-- Mobile Menu -->\\n    <div x-show=\\\"mobileMenuOpen\\\" x-cloak x-transition class=\\\"lg:hidden mt-3 border-t pt-3 space-y-2 pb-4\\\">\\n      <a href=\\\"/\\\" class=\\\"block py-2 px-3 rounded hover:bg-gray-100 dark:hover:bg-gray-800\\\">Home</a>\\n      <a href=\\\"/s\\\" class=\\\"block py-2 px-3 rounded hover:bg-gray-100 dark:hover:bg-gray-800\\\">Phones</a>\\n      <a href=\\\"/\\\" class=\\\"block py-2 px-3 rounded hover:bg-gray-100 dark:hover:bg-gray-800\\\">Accessories</a>\\n      <a href=\\\"/\\\" class=\\\"block py-2 px-3 rounded hover:bg-gray-100 dark:hover:bg-gray-800\\\">Wearables</a>\\n      <a href=\\\"/\\\" class=\\\"block py-2 px-3 rounded text-orange-500 hover:bg-gray-100 dark:hover:bg-gray-800\\\">Deals</a>\\n      <hr class=\\\"border-gray-200 dark:border-gray-700\\\" />\\n      <a href=\\\"/\\\" class=\\\"block py-2 px-3 rounded hover:bg-gray-100 dark:hover:bg-gray-800\\\">Sign In</a>\\n      <a href=\\\"/\\\" class=\\\"block py-2 px-3 rounded hover:bg-gray-100 dark:hover:bg-gray-800\\\">Register</a>\\n    </div>\\n  </div>\\n</header>\\n\\n<!-- Initialize Lucide Icons -->\\n\\n\\n</body>\\n</html>\" }} />\n  );\n}\n",
