     <rect x=\"14\" y=\"14\" width=\"16\" height=\"16\" fill=\"#fff\"/>\n                  <rect x=\"20\" y=\"20\" width=\"4\" height=\"4\"/>\n                  <rect x=\"84\" y=\"8\" width=\"28\" height=\"28\"/>\n                  <rect x=\"90\" y=\"14\" width=\"16\" height=\"16\" fill=\"#fff\"/>\n                  <rect x=\"96\" y=\"20\" width=\"4\" height=\"4\"/>\n                  <rect x=\"8\" y=\"84\" width=\"28\" height=\"28\"/>\n                  <rect x=\"14\" y=\"90\" width=\"16\" height=\"16\" fill=\"#fff\"/>\n                  <rect x=\"20\" y=\"96\" width=\"4\" height=\"4\"/>\n                  <rect x=\"44\" y=\"14\" width=\"8\" height=\"8\"/>\n                  <rect x=\"56\" y=\"8\" width=\"8\" height=\"20\"/>\n                  <rect x=\"44\" y=\"32\" width=\"20\" height=\"8\"/>\n                  <rect x=\"40\" y=\"52\" width=\"8\" height=\"8\"/>\n                  <rect x=\"52\" y=\"48\" width=\"12\" height=\"12\"/>\n                  <rect x=\"68\" y=\"40\" width=\"8\" height=\"20\"/>\n                  <rect x=\"84\" y=\"44\" width=\"12\" height=\"8\"/>\n                  <rect x=\"96\" y=\"56\" width=\"8\" height=\"8\"/>\n                  <rect x=\"44\" y=\"72\" width=\"8\" height=\"20\"/>\n                  <rect x=\"56\" y=\"80\" width=\"20\" height=\"8\"/>\n                  <rect x=\"80\" y=\"72\" width=\"8\" height=\"8\"/>\n                  <rect x=\"92\" y=\"84\" width=\"12\" height=\"20\"/>\n                  <rect x=\"64\" y=\"96\" width=\"16\" height=\"8\"/>\n                </g>\n              </svg>\n            </div>\n            <div className=\"mt-5\">\n              <p className=\"mb-2 text-xs font-semibold uppercase tracking-wider text-slate-500\">\n                Manual Setup Key\n              </p>\n              <div className=\"flex items-center justify-between rounded-xl border border-dashed border-slate-300 bg-white px-4 py-3\">\n                <span className=\"font-mono text-sm font-medium tracking-wide text-slate-700\">\n                  JBSW Y3DP EHPK 3PXP\n                </span>\n                <button className=\"text-slate-400 transition hover700\">\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" strokeWidth=\"1.8\">\n                    <rect x=\"9\" y=\"9\" width=\"11\" height=\"11\" rx=\"2\"/>\n                    <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M5 15V5a1 1 0 011-1h10\"/>\n                  </svg>\n                </button>\n              </div>\n            </div>\n          </div>\n          <div className=\"mt-7\">\n            <label className=\"mb-3 block text-sm font-medium text-slate-700\">\n              Verification Code\n            </label>\n            <div className=\"grid grid-cols-6 gap-2\">\n              <input type=\"text\" maxlength=\"1\" className=\"h-12 rounded-xl border border-slate-200 bg-white text-center text-lg font-bold outline-none transition focus500 focus4 focus100\" />\n              <input type=\"text\" maxlength=\"1\" className=\"h-12 rounded-xl border border-slate-200 bg-white text-center text-lg font-bold outline-none transition focus500 focus4 focus100\" />\n              <input type=\"text\" maxlength=\"1\" className=\"h-12 rounded-xl border border-slate-200 bg-white text-center text-lg font-bold outline-none transition focus500 focus4 focus100\" />\n              <input type=\"text\" maxlength=\"1\" className=\"h-12 rounded-xl border border-slate-200 bg-white text-center text-lg font-bold outline-none transition focus500 focus4 focus100\" />\n              <input type=\"text\" maxlength=\"1\" className=\"h-12 rounded-xl border border-slate-200 bg-white text-center text-lg font-bold outline-none transition focus500 focus4 focus100\" />\n              <input type=\"text\" maxlength=\"1\" className=\"h-12 rounded-xl border border-slate-200 bg-white text-center text-lg font-bold outline-none transition focus500 focus4 focus100\" />\n            </div>\n          </div>\n          <label className=\"mt-6 flex items-start gap-3 text-sm text-slate-600\">\n            <input type=\"checkbox\" className=\"mt-1 h-4 w-4 rounded border-slate-300 text-cyan-600 focus500\" />\n            <span>\n              Trust this device for 30 days and skip verification on future logins.\n            </span>\n          </label>\n          <button className=\"mt-7 w-full rounded-xl bg-slate-900 py-3.5 text-sm font-semibold text-white shadow-lg shadow-slate-900/20 transition hover800\">\n            Enable Two-Factor Authentication\n          </button>\n        </div>\n      </div>\n    </div>\n    </div>\n  );\n}\n",
