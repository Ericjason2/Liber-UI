                   <li><a href=\"#\" className=\"hover600\">Technology Consulting</a></li>\n                      <li><a href=\"#\" className=\"hover600\">Analytics</a></li>\n                      <li><a href=\"#\" className=\"hover600\">Support</a></li>\n                    </ul>\n                  </div>\n                </div>\n              </div>\n            </div>\n            \n            \n            <a href=\"#\" className=\"text-gray-700 hover600 font-semibold\">About</a>\n            \n            <a href=\"#\" className=\"text-gray-700 hover600 font-semibold\">Contact</a>\n          </div>\n          \n          \n          <div className=\"md\">\n            <button id=\"mobile-menu-btn\" className=\"focus\">\n              \n              <svg className=\"w-6 h-6 text-gray-700\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"M4 6h16M4 12h16M4 18h16\"/>\n              </svg>\n            </button>\n          </div>\n          \n        </div>\n      </div>\n    \n      \n      <div className=\"md hidden\" id=\"mobile-menu\">\n        <div className=\"px-4 pt-2 pb-4 space-y-2 bg-white border-t border-gray-200\">\n          <a href=\"#\" className=\"block text-gray-700 hover600 font-semibold\">Home</a>\n          \n          \n          <div className=\"border-t border-gray-200 pt-2\">\n            <button className=\"w-full flex items-center justify-between focus text-gray-700 hover600 font-semibold\" id=\"mobile-mega-menu-toggle\">\n              <span>Services</span>\n              \n              <svg className=\"w-4 h-4 fill-current\" viewBox=\"0 0 20 20\">\n                <path d=\"M5.25 7.5L10 12.25L14.75 7.5H5.25Z\" />\n              </svg>\n            </button>\n       \n            <div className=\"hidden mt-2\" id=\"mobile-mega-menu\">\n              <div className=\"grid grid-cols-1 gap-4\">\n                \n                <div>\n                  <h3 className=\"text-lg font-semibold mb-2 text-gray-800\">Web Development</h3>\n                  <ul className=\"space-y-2 text-gray-600 ml-4\">\n                    <li><a href=\"#\" className=\"hover600\">Frontend</a></li>\n                    <li><a href=\"#\" className=\"hover600\">Backend</a></li>\n                    <li><a href=\"#\" className=\"hover600\">Full Stack</a></li>\n                    <li><a href=\"#\" className=\"hover600\">CMS</a></li>\n                  </ul>\n                </div>\n                \n                <div>\n                  <h3 className=\"text-lg font-semibold mb-2 text-gray-800\">Design</h3>\n                  <ul className=\"space-y-2 text-gray-600 ml-4\">\n                    <li><a href=\"#\" className=\"hover600\">UI/UX</a></li>\n                    <li><a href=\"#\" className=\"hover600\">Graphic Design</a></li>\n                    <li><a href=\"#\" className=\"hover600\">Branding</a></li>\n                    <li><a href=\"#\" className=\"hover600\">Animation</a></li>\n                  </ul>\n                </div>\n                \n                <div>\n                  <h3 className=\"text-lg font-semibold mb-2 text-gray-800\">Marketing</h3>\n                  <ul className=\"space-y-2 text-gray-600 ml-4\">\n                    <li><a href=\"#\" className=\"hover600\">SEO</a></li>\n                    <li><a href=\"#\" className=\"hover600\">Content Marketing</a></li>\n                    <li><a href=\"#\" className=\"hover600\">Social Media</a></li>\n                    <li><a href=\"#\" className=\"hover600\">Email Campaigns</a></li>\n                  </ul>\n                </div>\n                \n                <div>\n                  <h3 className=\"text-lg font-semibold mb-2 text-gray-800\">Consulting</h3>\n                  <ul className=\"space-y-2 text-gray-600 ml-4\">\n                    <li><a href=\"#\" className=\"hover600\">Business Strategy</a></li>\n                    <li><a href=\"#\" className=\"hover600\">Technology Consulting</a></li>\n                    <li><a href=\"#\" className=\"hover600\">Analytics</a></li>\n                    <li><a href=\"#\" className=\"hover600\">Support</a></li>\n                  </ul>\n                </div>\n              </div>\n            </div>\n          </div>\n          \n          <a href=\"#\" className=\"block text-gray-700 hover600 font-semibold\">About</a>\n          <a href=\"#\" className=\"block text-gray-700 hover600 font-semibold\">Contact</a>\n          \n        </div>\n      </div>\n    </nav>\n    \n    </div>\n  );\n}\n",
