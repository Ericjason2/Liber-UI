    "rawHtml": "<!-- Navbar -->\n<nav class=\"bg-white shadow-lg\">\n  <div class=\"max-w-7xl mx-auto px-4\">\n    <div class=\"flex justify-between items-center py-4\">\n      \n      <!-- Logo -->\n      <div class=\"flex-shrink-0\">\n        <a href=\"#\" class=\"flex items-center space-x-2\">\n          <!-- Replace with your logo image -->\n          <img src=\"https://img.freepik.com/premium-vector/k-word-logo-logo-design_622874-26.jpg?w=740\" alt=\"Logo\" class=\"h-10 w-10 rounded-full object-cover\" />\n          <span class=\"font-bold text-xl text-gray-800\"> Brand Name </span>\n        </a>\n      </div>\n      \n      <!-- Menu -->\n      <div class=\"hidden md:flex space-x-8\">\n        <!-- Home -->\n        <a href=\"#\" class=\"text-gray-700 hover:text-blue-600 font-semibold\">Home</a>\n        \n        <!-- Mega Menu -->\n        <div class=\"relative group\">\n          <button class=\"flex items-center space-x-2 focus:outline-none text-gray-700 hover:text-blue-600 font-semibold\">\n            <span>Services</span>\n            <!-- Chevron Down Icon -->\n            <svg class=\"w-4 h-4 fill-current\" viewBox=\"0 0 20 20\">\n              <path d=\"M5.25 7.5L10 12.25L14.75 7.5H5.25Z\" />\n            </svg>\n          </button>\n          \n          <!-- Mega Menu Content -->\n          <div class=\"absolute left-0 top-full mt-2 w-screen max-w-6xl bg-white shadow-xl border border-gray-200 rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-50\">\n            <div class=\"grid grid-cols-4 gap-6 p-6\">\n              <!-- Column 1 -->\n              <div>\n                <h3 class=\"text-lg font-semibold mb-2 text-gray-800\">Web Development</h3>\n                <ul class=\"space-y-2 text-gray-600\">\n                  <li><a href=\"#\" class=\"hover:text-blue-600\">Frontend</a></li>\n                  <li><a href=\"#\" class=\"hover:text-blue-600\">Backend</a></li>\n                  <li><a href=\"#\" class=\"hover:text-blue-600\">Full Stack</a></li>\n                  <li><a href=\"#\" class=\"hover:text-blue-600\">CMS</a></li>\n                </ul>\n              </div>\n              <!-- Column 2 -->\n              <div>\n                <h3 class=\"text-lg font-semibold mb-2 text-gray-800\">Design</h3>\n                <ul class=\"space-y-2 text-gray-600\">\n                  <li><a href=\"#\" class=\"hover:text-blue-600\">UI/UX</a></li>\n                  <li><a href=\"#\" class=\"hover:text-blue-600\">Graphic Design</a></li>\n                  <li><a href=\"#\" class=\"hover:text-blue-600\">Branding</a></li>\n                  <li><a href=\"#\" class=\"hover:text-blue-600\">Animation</a></li>\n                </ul>\n              </div>\n              <!-- Column 3 -->\n              <div>\n                <h3 class=\"text-lg font-semibold mb-2 text-gray-800\">Marketing</h3>\n                <ul class=\"space-y-2 text-gray-600\">\n                  <li><a href=\"#\" class=\"hover:text-blue-600\">SEO</a></li>\n                  <li><a href=\"#\" class=\"hover:text-blue-600\">Content Marketing</a></li>\n                  <li><a href=\"#\" class=\"hover:text-blue-600\">Social Media</a></li>\n                  <li><a href=\"#\" class=\"hover:text-blue-600\">Email Campaigns</a></li>\n                </ul>\n              </div>\n              <!-- Column 4 -->\n              <div>\n                <h3 class=\"text-lg font-semibold mb-2 text-gray-800\">Consulting</h3>\n                <ul class=\"space-y-2 text-gray-600\">\n                  <li><a href=\"#\" class=\"hover:text-blue-600\">Business Strategy</a></li>\n                  <li><a href=\"#\" class=\"hover:text-blue-600\">Technology Consulting</a></li>\n                  <li><a href=\"#\" class=\"hover:text-blue-600\">Analytics</a></li>\n                  <li><a href=\"#\" class=\"hover:text-blue-600\">Support</a></li>\n                </ul>\n              </div>\n            </div>\n          </div>\n        </div>\n        \n        <!-- About -->\n        <a href=\"#\" class=\"text-gray-700 hover:text-blue-600 font-semibold\">About</a>\n        <!-- Contact -->\n        <a href=\"#\" class=\"text-gray-700 hover:text-blue-600 font-semibold\">Contact</a>\n      </div>\n      \n      <!-- Mobile menu button -->\n      <div class=\"md:hidden\">\n        <button id=\"mobile-menu-btn\" class=\"focus:outline-none\">\n          <!-- Hamburger Icon -->\n          <svg class=\"w-6 h-6 text-gray-700\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 6h16M4 12h16M4 18h16\"/>\n          </svg>\n        </button>\n      </div>\n      \n    </div>\n  </div>\n\n  <!-- Mobile menu, hidden by default -->\n  <div class=\"md:hidden hidden\" id=\"mobile-menu\">\n    <div class=\"px-4 pt-2 pb-4 space-y-2 bg-white border-t border-gray-200\">\n      <a href=\"#\" class=\"block text-gray-700 hover:text-blue-600 font-semibold\">Home</a>\n      \n      <!-- Mega menu for mobile -->\n      <div class=\"border-t border-gray-200 pt-2\">\n        <button class=\"w-full flex items-center justify-between focus:outline-none text-gray-700 hover:text-blue-600 font-semibold\" id=\"mobile-mega-menu-toggle\">\n          <span>Services</span>\n          <!-- Chevron Down Icon -->\n          <svg class=\"w-4 h-4 fill-current\" viewBox=\"0 0 20 20\">\n            <path d=\"M5.25 7.5L10 12.25L14.75 7.5H5.25Z\" />\n          </svg>\n        </button>\n   \n        <div class=\"hidden mt-2\" id=\"mobile-mega-menu\">\n          <div class=\"grid grid-cols-1 gap-4\">\n            <!-- Column 1 -->\n            <div>\n              <h3 class=\"text-lg font-semibold mb-2 text-gray-800\">Web Development</h3>\n              <ul class=\"space-y-2 text-gray-600 ml-4\">\n                <li><a href=\"#\" class=\"hover:text-blue-600\">Frontend</a></li>\n                <li><a href=\"#\" class=\"hover:text-blue-600\">Backend</a></li>\n                <li><a href=\"#\" class=\"hover:text-blue-600\">Full Stack</a></li>\n                <li><a href=\"#\" class=\"hover:text-blue-600\">CMS</a></li>\n              </ul>\n            </div>\n            <!-- Column 2 -->\n            <div>\n              <h3 class=\"text-lg font-semibold mb-2 text-gray-800\">Design</h3>\n              <ul class=\"space-y-2 text-gray-600 ml-4\">\n                <li><a href=\"#\" class=\"hover:text-blue-600\">UI/UX</a></li>\n                <li><a href=\"#\" class=\"hover:text-blue-600\">Graphic Design</a></li>\n                <li><a href=\"#\" class=\"hover:text-blue-600\">Branding</a></li>\n                <li><a href=\"#\" class=\"hover:text-blue-600\">Animation</a></li>\n              </ul>\n            </div>\n            <!-- Column 3 -->\n            <div>\n              <h3 class=\"text-lg font-semibold mb-2 text-gray-800\">Marketing</h3>\n              <ul class=\"space-y-2 text-gray-600 ml-4\">\n                <li><a href=\"#\" class=\"hover:text-blue-600\">SEO</a></li>\n                <li><a href=\"#\" class=\"hover:text-blue-600\">Content Marketing</a></li>\n                <li><a href=\"#\" class=\"hover:text-blue-600\">Social Media</a></li>\n                <li><a href=\"#\" class=\"hover:text-blue-600\">Email Campaigns</a></li>\n              </ul>\n            </div>\n            <!-- Column 4 -->\n            <div>\n              <h3 class=\"text-lg font-semibold mb-2 text-gray-800\">Consulting</h3>\n              <ul class=\"space-y-2 text-gray-600 ml-4\">\n                <li><a href=\"#\" class=\"hover:text-blue-600\">Business Strategy</a></li>\n                <li><a href=\"#\" class=\"hover:text-blue-600\">Technology Consulting</a></li>\n                <li><a href=\"#\" class=\"hover:text-blue-600\">Analytics</a></li>\n                <li><a href=\"#\" class=\"hover:text-blue-600\">Support</a></li>\n              </ul>\n            </div>\n          </div>\n        </div>\n      </div>\n      \n      <a href=\"#\" class=\"block text-gray-700 hover:text-blue-600 font-semibold\">About</a>\n      <a href=\"#\" class=\"block text-gray-700 hover:text-blue-600 font-semibold\">Contact</a>\n      \n    </div>\n  </div>\n</nav>\n<script>\n  const mobileMenuBtn = document.getElementById('mobile-menu-btn');\n  const mobileMenu = document.getElementById('mobile-menu');\n  const mobileMegaMenuToggle = document.getElementById('mobile-mega-menu-toggle');\n  const mobileMegaMenu = document.getElementById('mobile-mega-menu');\n\n  mobileMenuBtn.addEventListener('click', () => {\n    mobileMenu.classList.toggle('hidden');\n  });\n\n  if (mobileMegaMenuToggle) {\n    mobileMegaMenuToggle.addEventListener('click', () => {\n      mobileMegaMenu.classList.toggle('hidden');\n    });\n  }\n</script>"
