      "content": "/**\n * Component: LinkedIn Post UI Mockup\n * Author: @hamza-atig (https://tailwindflex.com/@hamza-atig)\n * Source: https://tailwindflex.com/@hamza-atig/linkedin-post-ui-mockup\n * Attribution: Créé par @hamza-atig sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function LinkedinPostUiMockup() {\n  return (\n    <div>\n    <body className=\"bg-gray-100 dark900 min-h-screen flex items-center justify-center p-4\">\n    \n        <div className=\"bg-white dark800 border linkedin-border rounded-lg shadow-sm max-w-xl w-full overflow-hidden\">\n          <div className=\"p-4\">\n    \n            \n            <div className=\"flex justify-between items-start mb-3\">\n              <div className=\"flex items-center space-x-3\">\n                <img className=\"w-12 h-12 rounded-full object-cover flex-shrink-0\"\n                     src=\"https://images.unsplash.com/photo-1500648767791-00dcc994a43e?ixlib=rb-1.2.1&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=crop&w=100&q=80\"\n                     alt=\"User Avatar\" />\n                <div className=\"text-sm min-w-0\">\n                  <a href=\"#\" className=\"font-semibold text-primary hover hover700 dark400\">\n                    Michael Chen\n                  </a>\n                  <p className=\"text-xs text-secondary truncate\">\n                    Lead Software Engineer | Cloud Architecture | DevOps\n                  </p>\n                  <p className=\"text-xs text-secondary flex items-center\">\n                    1d • Edited • \n                    <svg className=\"w-3 h-3 text-secondary\" fill=\"currentColor\" viewBox=\"0 0 16 16\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M0 8a8 8 0 1 0 16 0A8 8 0 0 0 0 8zm8-6.5a6.5 6.5 0 1 1 0 13 6.5 6.5 0 0 1 0-13zM6 8a1 1 0 0 1 1-1h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1a1 1 0 0 1-1-1V8zm5.472.088a1.144 1.144 0 0 0-1.944-.972 1.144 1.144 0 1 0 1.944.972zM4.5 7a1 1 0 1 0 0-2 1 1 0 0 0 0 2z\"/></svg>\n                  </p>\n                </div>\n              </div>\n              <button aria-label=\"More options\" className=\"text-gray-500 dark400 hover100 dark700 rounded-full p-1.5 -mt-1 -mr-1.5\">\n                  <svg className=\"w-5 h-5\" fill=\"currentColor\" viewBox=\"0 0 20 20\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M6 10a2 2 0 11-4 0 2 2 0 014 0zM12 10a2 2 0 11-4 0 2 2 0 014 0zM16 12a2 2 0 100-4 2 2 0 000 4z\"></path></svg>\n              </button>\n            </div>\n    \n            \n            <div className=\"text-sm text-primary mb-3 break-words\">\n                <p>Excited to share some insights from the recent Cloud Native Conference! Key takeaways revolved around improved Kubernetes security practices and the growing adoption of serverless architectures for cost optimization. Highly recommend checking out the session recordings if you missed it. <a href=\"#\" className=\"text-blue-600 dark400 hover\">#cloudnative</a> <a href=\"#\" className=\"text-blue-600 dark400 hover\">#kubernetes</a> <a href=\"#\" className=\"text-blue-600 dark400 hover\">#serverless</a> <a href=\"#\" className=\"text-blue-600 dark400 hover\">#devops</a></p>\n            </div>\n    \n            \n            <div className=\"mb-3 -mx-4 sm0 sm overflow-hidden\">\n                 <img src=\"https://images.unsplash.com/photo-1551288049-bebda4e38f71?ixlib=rb-1.2.1&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=crop&w=870&q=80\"\n                     alt=\"Post media content\" className=\"w-full object-cover\" />\n            </div>\n    \n            \n            <div className=\"flex items-center justify-between text-xs text-secondary mb-2\">\n                <div className=\"flex items-center space-x-1\">\n                    <svg className=\"w-4 h-4 text-blue-500\" fill=\"currentColor\" viewBox=\"0 0 20 20\"><path xmlns=\"http://www.w3.org/2000/svg\" d=\"M19.2412 4.48567C19.4084 4.45613 19.