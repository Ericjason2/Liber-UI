24\" strokeWidth=\"1.5\" stroke=\"currentColor\"><path xmlns=\"http://www.w3.org/2000/svg\" id=\"primary\" d=\"M6,14V9A6,6,0,0,1,16.89,5.54\" style=\"fill: none; stroke: rgb(0, 0, 0); stroke-linecap: round; stroke-linejoin: round; stroke-width: 2;\"/><path xmlns=\"http://www.w3.org/2000/svg\" id=\"primary-2\" data-name=\"primary\" d=\"M18,10v5A6,6,0,0,1,7.11,18.46\" style=\"fill: none; stroke: rgb(0, 0, 0); stroke-linecap: round; stroke-linejoin: round; stroke-width: 2;\"/><polyline xmlns=\"http://www.w3.org/2000/svg\" id=\"primary-3\" data-name=\"primary\" points=\"8 12 6 14 4 12\" style=\"fill: none; stroke: rgb(0, 0, 0); stroke-linecap: round; stroke-linejoin: round; stroke-width: 2;\"/><polyline xmlns=\"http://www.w3.org/2000/svg\" id=\"primary-4\" data-name=\"primary\" points=\"16 12 18 10 20 12\" style=\"fill: none; stroke: rgb(0, 0, 0); stroke-linecap: round; stroke-linejoin: round; stroke-width: 2;\"/></svg>\n                    <span>Repost</span>\n                </button>\n                 <button aria-label=\"Send\" className=\"flex items-center space-x-1.5 hover100 dark700 p-2 rounded w-full justify-center transition-colors duration-150\">\n                     <svg className=\"w-5 h-5\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" strokeWidth=\"1.5\" stroke=\"currentColor\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5\" /></svg>\n                    <span>Send</span>\n                </button>\n            </div>\n    \n          </div>\n        </div>\n    \n    </body>\n    </div>\n  );\n}\n",
