r\\n                    </div>\\r\\n                    <button class=\\\"bg-[#f0f0f0] dark:bg-[#2d2d2d] border-none rounded-[18px] py-2 px-5 font-medium text-black dark:text-white transition-all duration-200 text-[0.95rem] hover:bg-[#e5e5e5] dark:hover:bg-[#3d3d3d]\\\">\\r\\n                        Follow +\\r\\n                    </button>\\r\\n                </div>\\r\\n            </div>\\r\\n        </div>\\r\\n\\r\\n        <div class=\\\"w-[350px] bg-white dark:bg-[#1e1e1e] rounded-[40px] overflow-hidden shadow-[0_20px_40px_rgba(0,0,0,0.03)] dark:shadow-[0_20px_40px_rgba(0,0,0,0.4)] transition-all duration-300 border-none relative h-[440px]\\\">\\r\\n            <div class=\\\"relative h-full p-0\\\">\\r\\n                <img src=\\\"https://images.unsplash.com/photo-1524504388940-b1c1722653e1?q=80&w=1000&auto=format&fit=crop\\\" alt=\\\"Sophie Bennett\\\" class=\\\"w-full h-full object-cover rounded-[40px]\\\">\\r\\n                <div class=\\\"absolute bottom-0 left-0 right-0 bg-white/70 dark:bg-[#1e1e1e]/70 backdrop-blur-[15px] m-4 rounded-[30px] p-[25px]\\\">\\r\\n                    <h2 class=\\\"font-poppins text-[1.5rem] mb-2 flex items-center gap-2 font-semibold\\\">\\r\\n                        Sophie Bennett \\r\\n                        <i class=\\\"bi bi-patch-check-fill text-[#198754] text-[1.2rem]\\\"></i>\\r\\n                    </h2>\\r\\n                    <p class=\\\"text-[#6c757d] dark:text-[#a0a0a0] text-[1.05rem] leading-[1.4] mb-[25px]\\\">\\r\\n                        Product Designer who focuses on simplicity & usability.\\r\\n                    </p>\\r\\n                    <div class=\\\"flex justify-between items-center\\\">\\r\\n                        <div class=\\\"flex items-center gap-4 text-[#333] dark:text-[#eee] font-medium\\\">\\r\\n                            <div class=\\\"flex items-center gap-1.5\\\">\\r\\n                                <i class=\\\"bi bi-person text-[#6c757d] dark:text-[#a0a0a0] text-[1.1rem]\\\"></i>\\r\\n                                <span>312</span>\\r\\n                            </div>\\r\\n                            <div class=\\\"flex items-center gap-1.5\\\">\\r\\n                                <i class=\\\"bi bi-file-earmark-check text-[#6c757d] dark:text-[#a0a0a0] text-[1.1rem]\\\"></i>\\r\\n                                <span>48</span>\\r\\n                            </div>\\r\\n                        </div>\\r\\n                        <button class=\\\"bg-[#f0f0f0] dark:bg-[#2d2d2d] border-none rounded-[18px] py-2 px-5 font-medium text-black dark:text-white transition-all duration-200 text-[0.95rem] hover:bg-[#e5e5e5] dark:hover:bg-[#3d3d3d]\\\">\\r\\n                            Follow +\\r\\n                        </button>\\r\\n                    </div>\\r\\n                </div>\\r\\n            </div>\\r\\n        </div>\\r\\n    </div>\\r\\n\\r\\n    \\r\\n</body>\\r\\n</html>\" }} />\n  );\n}\n",
