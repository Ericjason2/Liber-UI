    "rawHtml": "<!DOCTYPE html>\r\n<html lang=\"en\" class=\"light\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Profile Cards - Sophie Bennett</title>\r\n    <script src=\"https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4\"></script>\r\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\r\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\r\n    <link href=\"https://fonts.googleapis.com/css2?family=Karla:wght@400;500&family=Poppins:wght@600&display=swap\" rel=\"stylesheet\">\r\n    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css\">\r\n    <style type=\"text/tailwindcss\">\r\n        @import \"tailwindcss\";\r\n        @custom-variant dark (&:where(.dark, .dark *));\r\n\r\n        body {\r\n            font-family: 'Karla', sans-serif;\r\n        }\r\n        .font-poppins {\r\n            font-family: 'Poppins', sans-serif;\r\n        }\r\n    </style>\r\n</head>\r\n<body class=\"bg-[#f5f5f5] dark:bg-[#121212] text-black dark:text-white min-h-screen flex justify-center items-center p-10 transition-colors duration-300\">\r\n\r\n    <button class=\"fixed top-5 right-5 z-[1000] cursor-pointer p-2.5 rounded-full bg-white dark:bg-[#2d2d2d] shadow-[0_2px_10px_rgba(0,0,0,0.1)] border-none flex items-center justify-center w-[45px] h-[45px] text-black dark:text-white\" id=\"themeToggle\" title=\"Toggle Dark/Light Mode\">\r\n        <i class=\"bi bi-moon-fill\" id=\"themeIcon\"></i>\r\n    </button>\r\n\r\n    <div class=\"flex gap-10 flex-wrap justify-center\">\r\n        <div class=\"w-[350px] bg-white dark:bg-[#1e1e1e] rounded-[40px] overflow-hidden shadow-[0_20px_40px_rgba(0,0,0,0.03)] dark:shadow-[0_20px_40px_rgba(0,0,0,0.4)] transition-all duration-300 border-none relative\">\r\n            <div class=\"p-4\">\r\n                <img src=\"https://images.unsplash.com/photo-1524504388940-b1c1722653e1?q=80&w=1000&auto=format&fit=crop\" alt=\"Sophie Bennett\" class=\"w-full h-[320px] object-cover rounded-[30px]\">\r\n            </div>\r\n            <div class=\"px-[30px] pt-[10px] pb-[35px]\">\r\n                <h2 class=\"font-poppins text-[1.5rem] mb-2 flex items-center gap-2 font-semibold\">\r\n                    Sophie Bennett \r\n                    <i class=\"bi bi-patch-check-fill text-[#198754] text-[1.2rem]\"></i>\r\n                </h2>\r\n                <p class=\"text-[#6c757d] dark:text-[#a0a0a0] text-[1.05rem] leading-[1.4] mb-[25px]\">\r\n                    Product Designer who focuses on simplicity & usability.\r\n                </p>\r\n                <div class=\"flex justify-between items-center\">\r\n                    <div class=\"flex items-center gap-4 text-[#333] dark:text-[#eee] font-medium\">\r\n                        <div class=\"flex items-center gap-1.5\">\r\n                            <i class=\"bi bi-person text-[#6c757d] dark:text-[#a0a0a0] text-[1.1rem]\"></i>\r\n                            <span>312</span>\r\n                        </div>\r\n                        <div class=\"flex items-center gap-1.5\">\r\n                            <i class=\"bi bi-file-earmark-check text-[#6c757d] dark:text-[#a0a0a0] text-[1.1rem]\"></i>\r\n                            <span>48</span>\r\n                        </div>\r\n                    </div>\r\n                    <button class=\"bg-[#f0f0f0] dark:bg-[#2d2d2d] border-none rounded-[18px] py-2 px-5 font-medium text-black dark:text-white transition-all duration-200 text-[0.95rem] hover:bg-[#e5e5e5] dark:hover:bg-[#3d3d3d]\">\r\n                        Follow +\r\n                    </button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"w-[350px] bg-white dark:bg-[#1e1e1e] rounded-[40px] overflow-hidden shadow-[0_20px_40px_rgba(0,0,0,0.03)] dark:shadow-[0_20px_40px_rgba(0,0,0,0.4)] transition-all duration-300 border-none relative h-[440px]\">\r\n            <div class=\"relative h-full p-0\">\r\n                <img src=\"https://images.unsplash.com/photo-1524504388940-b1c1722653e1?q=80&w=1000&auto=format&fit=crop\" alt=\"Sophie Bennett\" class=\"w-full h-full object-cover rounded-[40px]\">\r\n                <div class=\"absolute bottom-0 left-0 right-0 bg-white/70 dark:bg-[#1e1e1e]/70 backdrop-blur-[15px] m-4 rounded-[30px] p-[25px]\">\r\n                    <h2 class=\"font-poppins text-[1.5rem] mb-2 flex items-center gap-2 font-semibold\">\r\n                        Sophie Bennett \r\n                        <i class=\"bi bi-patch-check-fill text-[#198754] text-[1.2rem]\"></i>\r\n                    </h2>\r\n                    <p class=\"text-[#6c757d] dark:text-[#a0a0a0] text-[1.05rem] leading-[1.4] mb-[25px]\">\r\n                        Product Designer who focuses on simplicity & usability.\r\n                    </p>\r\n                    <div class=\"flex justify-between items-center\">\r\n                        <div class=\"flex items-center gap-4 text-[#333] dark:text-[#eee] font-medium\">\r\n                            <div class=\"flex items-center gap-1.5\">\r\n                                <i class=\"bi bi-person text-[#6c757d] dark:text-[#a0a0a0] text-[1.1rem]\"></i>\r\n                                <span>312</span>\r\n                            </div>\r\n                            <div class=\"flex items-center gap-1.5\">\r\n                                <i class=\"bi bi-file-earmark-check text-[#6c757d] dark:text-[#a0a0a0] text-[1.1rem]\"></i>\r\n                                <span>48</span>\r\n                            </div>\r\n                        </div>\r\n                        <button class=\"bg-[#f0f0f0] dark:bg-[#2d2d2d] border-none rounded-[18px] py-2 px-5 font-medium text-black dark:text-white transition-all duration-200 text-[0.95rem] hover:bg-[#e5e5e5] dark:hover:bg-[#3d3d3d]\">\r\n                            Follow +\r\n                        </button>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <script>\r\n        const themeToggle = document.getElementById('themeToggle');\r\n        const themeIcon = document.getElementById('themeIcon');\r\n        const htmlElement = document.documentElement;\r\n\r\n        themeToggle.addEventListener('click', () => {\r\n            const isDark = htmlElement.classList.contains('dark');\r\n            \r\n            if (isDark) {\r\n                htmlElement.classList.remove('dark');\r\n                htmlElement.classList.add('light');\r\n                themeIcon.classList.replace('bi-sun-fill', 'bi-moon-fill');\r\n                localStorage.setItem('theme', 'light');\r\n            } else {\r\n                htmlElement.classList.remove('light');\r\n                htmlElement.classList.add('dark');\r\n                themeIcon.classList.replace('bi-moon-fill', 'bi-sun-fill');\r\n                localStorage.setItem('theme', 'dark');\r\n            }\r\n        });\r\n\r\n        // Load saved theme\r\n        const savedTheme = localStorage.getItem('theme');\r\n        if (savedTheme === 'dark') {\r\n            htmlElement.classList.add('dark');\r\n            themeIcon.classList.replace('bi-moon-fill', 'bi-sun-fill');\r\n        } else {\r\n            htmlElement.classList.add('light');\r\n        }\r\n    </script>\r\n</body>\r\n</html>"
  }
