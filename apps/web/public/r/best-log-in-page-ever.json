    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\n  <title>Instagram Login Clone</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n  <style>\n    .instagram-gradient {\n      background: radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285AEB 90%);\n      -webkit-background-clip: text;\n      background-clip: text;\n      -webkit-text-fill-color: transparent;\n    }\n    @keyframes fadeInOut {\n      0%, 100% { opacity: 0; }\n      10%, 90% { opacity: 1; }\n    }\n    .animate-fadeIn {\n      animation: fadeInOut 16s infinite;\n    }\n    .animate-fadeIn:nth-child(2) { animation-delay: 4s; }\n    .animate-fadeIn:nth-child(3) { animation-delay: 8s; }\n    .animate-fadeIn:nth-child(4) { animation-delay: 12s; }\n  </style>\n</head>\n<body class=\"bg-gray-50 min-h-screen flex items-center justify-center p-4\">\n  <div class=\"flex flex-col lg:flex-row items-center justify-center w-full max-w-6xl space-y-6 lg:space-y-0 lg:space-x-10\">\n\n    <!-- Animated Image Section -->\n    <div class=\"hidden lg:flex items-center justify-center\">\n      <div class=\"relative w-[250px] h-[538px] bg-[url('https://www.instagram.com/static/images/homepage/home-phones.png/43cc71bb1b43.png')] bg-no-repeat bg-contain\">\n        <div class=\"absolute top-[26px] left-[53px] w-[160px] h-[352px] overflow-hidden rounded-md\">\n          <div class=\"w-full h-full relative\">\n            <img src=\"https://www.instagram.com/static/images/homepage/screenshot1.jpg/d6bf0c928b5a.jpg\" class=\"w-full h-full object-cover absolute animate-fadeIn\">\n            <img src=\"https://www.instagram.com/static/images/homepage/screenshot2.jpg/6f03eb85463c.jpg\" class=\"w-full h-full object-cover absolute animate-fadeIn\">\n            <img src=\"https://www.instagram.com/static/images/homepage/screenshot3.jpg/9bd2a7b00b5a.jpg\" class=\"w-full h-full object-cover absolute animate-fadeIn\">\n            <img src=\"https://www.instagram.com/static/images/homepage/screenshot4.jpg/842fe5699220.jpg\" class=\"w-full h-full object-cover absolute animate-fadeIn\">\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Login Form Section -->\n    <div class=\"max-w-md w-full space-y-4\">\n      <div class=\"bg-white p-8 rounded-lg shadow-sm border border-gray-200\">\n        <div class=\"flex justify-center mb-6\">\n          <div class=\"text-3xl font-bold instagram-gradient\">\n            <i class=\"fab fa-instagram\"></i>\n          </div>\n        </div>\n\n        <form class=\"mt-4 space-y-6\">\n          <div class=\"space-y-4\">\n            <input id=\"username\" name=\"username\" type=\"text\" autocomplete=\"username\" required\n              class=\"appearance-none w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-md focus:outline-none focus:ring-1 focus:ring-gray-400 focus:border-gray-400 sm:text-sm\"\n              placeholder=\"Phone number, username, or email\">\n            <input id=\"password\" name=\"password\" type=\"password\" autocomplete=\"current-password\" required\n              class=\"appearance-none w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-md focus:outline-none focus:ring-1 focus:ring-gray-400 focus:border-gray-400 sm:text-sm\"\n              placeholder=\"Password\">\n          </div>\n\n          <button type=\"submit\"\n            class=\"w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-blue-500 hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-400\">\n            Log In\n          </button>\n\n          <div class=\"flex items-center my-3\">\n            <div class=\"flex-grow border-t border-gray-300\"></div>\n            <span class=\"mx-4 text-gray-500 text-sm font-medium\">OR</span>\n            <div class=\"flex-grow border-t border-gray-300\"></div>\n          </div>\n\n          <div class=\"text-center\">\n            <a href=\"#\" class=\"text-blue-900 text-sm font-semibold\">\n              <i class=\"fab fa-facebook-square mr-1\"></i> Log in with Facebook\n            </a>\n          </div>\n\n          <div class=\"text-center\">\n            <a href=\"#\" class=\"text-xs text-blue-500\">Forgot password?</a>\n          </div>\n        </form>\n      </div>\n\n      <!-- Sign Up Link -->\n      <div class=\"bg-white p-4 rounded-lg shadow-sm border border-gray-200 text-center\">\n        <p class=\"text-sm text-gray-700\">Don't have an account? <a href=\"#\" class=\"text-blue-500 font-semibold\">Sign up</a></p>\n      </div>\n\n      <!-- App Links -->\n      <div class=\"text-center\">\n        <p class=\"text-sm mb-2\">Get the app.</p>\n        <div class=\"flex justify-center space-x-2\">\n          <a href=\"#\" class=\"w-32\">\n            <img src=\"https://www.instagram.com/static/images/appstore-install-badges/badge_ios_english-en.png/180ae7a0bcf7.png\"\n              alt=\"Download on the App Store\" class=\"h-10\">\n          </a>\n          <a href=\"#\" class=\"w-32\">\n            <img src=\"https://www.instagram.com/static/images/appstore-install-badges/badge_android_english-en.png/e9cd846dc748.png\"\n              alt=\"Get it on Google Play\" class=\"h-10\">\n          </a>\n        </div>\n      </div>\n    </div>\n  </div>\n</body>\n</html>"
