me=\"flex flex-col bg-gray-200/50 p-8\">\n              <dt className=\"text-sm font-semibold leading-6 text-gray-600\">Happy Customers</dt>\n              <dd className=\"order-first text-3xl font-semibold tracking-tight text-gray-900\">98%</dd>\n            </div>\n          </dl>\n        </div>\n      </div>\n    </div>\n    </div>\n  );\n}\n",
