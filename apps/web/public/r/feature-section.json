      "content": "/**\n * Component: Feature Section\n * Author: @geauxweisbeck4 (https://tailwindflex.com/@geauxweisbeck4)\n * Source: https://tailwindflex.com/@geauxweisbeck4/feature-section\n * Attribution: Créé par @geauxweisbeck4 sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function FeatureSection() {\n  return (\n    <div>\n    <section className=\"py-10 bg-gray-50 dark800 sm16 lg24\">\n        <div className=\"px-4 mx-auto max-w-7xl sm6 lg8\">\n            <div className=\"max-w-xl mx-auto text-center\">\n                <p className=\"text-sm tracking-widest text-blue-600 dark300 font-bold uppercase\">Open Source Theme and UI Components</p>\n    \n                <h2 className=\"mt-6 text-3xl font-bold leading-tight text-black dark50 sm4xl lg5xl\">Geaux Astro helps you craft beautiful websites efficiently</h2>\n            </div>\n    \n            <div className=\"grid items-center grid-cols-1 mt-12 gap-y-10 lg5 sm20 gap-x-4\">\n                <div className=\"space-y-8 lg16 xl24 lg2 lg12\">\n                    <div className=\"flex items-start\">\n                        <svg className=\"flex-shrink-0 text-green-500 w-9 h-9\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"1.5\" d=\"M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z\" />\n                        </svg>\n                        <div className=\"ml-5\">\n                            <h3 className=\"text-xl font-semibold text-black dark50\">Optimize Your Funnel</h3>\n                            <p className=\"mt-3 text-base text-gray-600 dark300\">Our Call To Action components can be customized to fit your funnel or drop them in and see how they work for you.</p>\n                        </div>\n                    </div>\n    \n                    <div className=\"flex items-start\">\n                        <svg className=\"flex-shrink-0 text-blue-600 w-9 h-9\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"1.5\" d=\"M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z\" />\n                        </svg>\n                        <div className=\"ml-5\">\n                            <h3 className=\"text-xl font-semibold text-black dark50\">Easy to Customize</h3>\n                            <p className=\"mt-3 text-base text-gray-600 dark300\">This template is easy to customize so it meets your needs - same with the components.</p>\n                        </div>\n                    </div>\n    \n                    <div className=\"flex items-start\">\n                        <svg className=\"flex-shrink-0 text-red-500 w-9 h-9\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"1.5\" d=\"M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z\" />\n                        </svg>\n                        <div className=\"ml-5\">\n                            <h3 className=\"text-xl font-semibold text-black dark50\">Made with TailwindCSS</h3>\n                            <p className=\"mt-3 text-base text-gray-600 dark300\">The best CSS framework out there allows you to easily customize the theme and components any way you like.</p>\n                        </div>\n                    </div>\n                </div>\n    \n                <div className=\"lg3\">\n                    <img className=\"w-full rounded-lg shadow-xl\" src=\"https://cdn.rareblocks.xyz/collection/celebration/images/features/7/dashboard-screenshot.png\" alt=\"Dashboard screenshot\" />\n                </div>\n            </div>\n        </div>\n    </section>\n    </div>\n  );\n}\n",
