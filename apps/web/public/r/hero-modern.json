llUp {\\n            0% { transform: translateY(-50%); }\\n            100% { transform: translateY(0); }\\n        }\\n\\n        /* Effet carte */\\n        .img-card {\\n            transition: filter 0.3s ease;\\n        }\\n        .img-card:hover {\\n            filter: brightness(1.1);\\n        }\\n    </style>\\n</head>\\n<body class=\\\"bg-gray-50 text-gray-800 antialiased overflow-hidden flex\\\">\\n\\n    <!-- AUDIO ELEMENTS -->\\n    <audio id=\\\"hover-sound\\\" src=\\\"https://assets.mixkit.co/sfx/preview/mixkit-positive-interface-beep-221.mp3\\\"></audio>\\n    <audio id=\\\"click-sound\\\" src=\\\"https://assets.mixkit.co/sfx/preview/mixkit-software-interface-start-2574.mp3\\\"></audio>\\n\\n    <!-- SIDEBAR AI & NAVIGATION -->\\n    <aside class=\\\"hidden md:flex flex-col w-64 h-screen bg-gray-900 border-r border-gray-800 text-white fixed left-0 top-0 z-50\\\">\\n        <div class=\\\"p-6 flex items-center gap-2\\\">\\n            <div class=\\\"w-8 h-8 rounded-lg bg-gradient-to-br from-pink-500 to-rose-600 flex items-center justify-center font-bold text-white\\\">S</div>\\n            <span class=\\\"text-xl font-bold tracking-tight\\\">Omelinks<span class=\\\"text-pink-500\\\">AI</span></span>\\n        </div>\\n\\n        <nav class=\\\"flex-1 px-4 space-y-2 mt-4\\\">\\n            <a href=\\\"#\\\" class=\\\"flex items-center gap-3 px-4 py-3 bg-gray-800 text-pink-400 rounded-xl transition hover:bg-gray-700 interactive-btn\\\">\\n                <svg class=\\\"w-5 h-5\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\"><path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" stroke-width=\\\"2\\\" d=\\\"M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z\\\"></path></svg>\\n                Dashboard\\n     