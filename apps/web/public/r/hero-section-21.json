-->\n    <div class=\"flex justify-center items-center mt-8\" data-aos=\"fade-up\" data-aos-delay=\"400\">\n      <a href=\"#pricing\" rel=\"noopener noreferrer\"\n        class=\"relative flex items-center justify-center px-6 py-3 bg-green-600 hover:bg-green-700 text-white text-lg font-semibold rounded-full shadow-lg transform hover:scale-105 transition-transform duration-200\">\n        <span class=\"absolute inset-0 rounded-full bg-green-600 opacity-50 animate-pulse\"></span>\n        <span class=\"relative z-10 pr-2\">Book Now</span>\n      </a>\n    </div>\n  </div>\n\n  <!-- Scroll Down Icon -->\n  <div class=\"absolute sm:bottom-14 bottom-10 left-1/2 transform -translate-x-1/2 animate-bounce\">\n    <a href=\"#about\" class=\"cursor-pointer\">\n      <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-12 w-12 text-white\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" stroke-width=\"2\">\n        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M19 9l-7 7-7-7\" />\n      </svg>\n    </a>\n  </div>\n</section>"
