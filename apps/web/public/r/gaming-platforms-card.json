erflow-hidden rounded-2xl shadow-lg transition-all duration-300 hover:shadow-2xl hover:-translate-y-2\">\r\n                <div class=\"h-48 bg-gradient-to-br from-[#0567b2] to-[#0e8ce6] flex items-center justify-center p-6\">\r\n                    <!-- Battle.net Logo -->\r\n                    <div class=\"text-white text-6xl\">\r\n                        <i class=\"fab fa-battle-net\"></i>\r\n                    </div>\r\n                    <div class=\"absolute inset-0 bg-gradient-to-t from-black/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300\"></div>\r\n                </div>\r\n                <div class=\"bg-white p-5 text-center\">\r\n                    <h3 class=\"text-xl font-bold text-gray-800\">Battle.net</h3>\r\n                    <p class=\"text-gray-600 text-sm mt-1\">Blizzard's Official Platform</p>\r\n                    <div class=\"mt-4 text-xs text-gray-500\">\r\n                        <span class=\"inline-block bg-gray-100 px-3 py-1 rounded-full\">World of Warcraft</span>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n            <!-- Epic Games Card -->\r\n            <div class=\"group relative overflow-hidden rounded-2xl shadow-lg transition-all duration-300 hover:shadow-2xl hover:-translate-y-2\">\r\n                <div class=\"h-48 bg-gradient-to-br from-[#2a2a2a] to-[#121212] flex items-center justify-center p-6\">\r\n                    <!-- Epic Games Logo -->\r\n                    <div class=\"text-white text-6xl\">\r\n                        <i class=\"fas fa-gamepad\"></i>\r\n                    </div>\r\n                    <div class=\"absolute inset-0 bg-gradient-to-t from-black/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300\"></div>\r\n                </div>\r\n                <div class=\"bg-white p-5 text-center\">\r\n                    <h3 class=\"text-xl font-bold text-gray-800\">Epic Games</h3>\r\n         