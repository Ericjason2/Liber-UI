            </div>\\r\\n\\r\\n            <!-- PlayStation Card -->\\r\\n            <div class=\\\"group relative overflow-hidden rounded-2xl shadow-lg transition-all duration-300 hover:shadow-2xl hover:-translate-y-2\\\">\\r\\n                <div class=\\\"h-48 bg-gradient-to-br from-[#003087] to-[#0057d9] flex items-center justify-center p-6\\\">\\r\\n                    <!-- PlayStation Logo -->\\r\\n                    <div class=\\\"text-white text-6xl\\\">\\r\\n                        <i class=\\\"fab fa-playstation\\\"></i>\\r\\n                    </div>\\r\\n                    <div class=\\\"absolute inset-0 bg-gradient-to-t from-black/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300\\\"></div>\\r\\n                </div>\\r\\n                <div class=\\\"bg-white p-5 text-center\\\">\\r\\n                    <h3 class=\\\"text-xl font-bold text-gray-800\\\">PlayStation</h3>\\r\\n                    <p class=\\\"text-gray-600 text-sm mt-1\\\">Sony Entertainment</p>\\r\\n                    <div class=\\\"mt-4 text-xs text-gray-500\\\">\\r\\n                        <span class=\\\"inline-block bg-gray-100 px-3 py-1 rounded-full\\\">PSN</span>\\r\\n                    </div>\\r\\n                </div>\\r\\n            </div>\\r\\n\\r\\n            <!-- Nintendo Card -->\\r\\n            <div class=\\\"group relative overflow-hidden rounded-2xl shadow-lg transition-all duration-300 hover:shadow-2xl hover:-translate-y-2\\\">\\r\\n                <div class=\\\"h-48 bg-gradient-to-br from-[#e60012] to-[#ff2e3f] flex items-center justify-center p-6\\\">\\r\\n                    <!-- Nintendo Logo - Using game controller icon instead -->\\r\\n                    <div class=\\\"text-white text-6xl\\\">\\r\\n                        <i class=\\\"fas fa-gamepad\\\"></i>\\r\\n                    </div>\\r\\n                    <div class=\\\"absolute inset-0 bg-gradient-to-t from-black/30 to-transparent opacity-0 group-hover:opa