\\r\\n\\r\\n\\r\\n    <div id=\\\"overlay\\\" class=\\\"fixed inset-0 bg-black bg-opacity-50 z-40 opacity-0 pointer-events-none transition-opacity duration-300\\\"></div>\\r\\n\\r\\n\\r\\n    <div id=\\\"sidebarContainer\\\" class=\\\"fixed inset-y-0 right-0 flex z-50 transform translate-x-full\\\">\\r\\n        <div id=\\\"sidebar\\\" class=\\\"bg-white shadow-xl w-80 relative h-full flex flex-col\\\">\\r\\n            <!-- Resizer Handle -->\\r\\n            <div id=\\\"resizer\\\" class=\\\"resizer\\\"></div>\\r\\n\\r\\n\\r\\n            <div class=\\\"p-4 flex-1 overflow-auto\\\">\\r\\n                <div class=\\\"flex justify-between items-center mb-6\\\">\\r\\n                    <h2 class=\\\"text-xl font-bold text-gray-800\\\">Menú Principal</h2>\\r\\n                    <button id=\\\"closeSidebar\\\" class=\\\"text-gray-500 hover:text-gray-700 transition-colors duration-200\\\">\\r\\n                        <svg xmlns=\\\"http://www.w3.org/2000/svg\\\" class=\\\"h-6 w-6\\\" fill=\\\"none\\\" viewBox=\\\"0 0 24 24\\\" stroke=\\\"currentColor\\\">\\r\\n                            <path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" stroke-width=\\\"2\\\" d=\\\"M6 18L18 6M6 6l12 12\\\" />\\r\\n                        </svg>\\r\\n                    </button>\\r\\n                </div>\\r\\n\\r\\n                <nav class=\\\"space-y-1\\\">\\r\\n                    <a href=\\\"#\\\" class=\\\"flex items-center px-4 py-3 text-gray-700 hover:bg-blue-50 rounded-lg transition-all duration-200\\\">\\r\\n                        <svg xmlns=\\\"http://www.w3.org/2000/svg\\\" class=\\\"h-5 w-5 mr-3\\\" fill=\\\"none\\\" viewBox=\\\"0 0 24 24\\\" stroke=\\\"currentColor\\\">\\r\\n                            <path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" stroke-width=\\\"2\\\" d=\\\"M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6\\\" />\\r\\n                        </svg>\\r\\n                        Inicio\\r\\n                    </a>\\r\\n                    <a href=\\\"#\\\" class=\\\"flex items-center px-4 py-3 text-gray-700 hover:bg-blue-50 rounded-lg transition-all duration-200\\\">\\r\\n                        <svg xmlns=\\\"http://www.w3.org/2000/svg\\\" class=\\\"h-5 w-5 mr-3\\\" fill=\\\"none\\\" viewBox=\\\"0 0 24 24\\\" stroke=\\\"currentColor\\\">\\r\\n                            <path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" stroke-width=\\\"2\\\" d=\\\"M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7\\\" />\\r\\n                        </svg>\\r\\n                        Perfil\\r\\n                    </a>\\r\\n                    <a href=\\\"#\\\" class=\\\"flex items-center px-4 py-3 text-gray-700 hover:bg-blue-50 rounded-lg transition-all duration-200\\\">\\r\\n                        <svg xmlns=\\\"http://www.w3.org/2000/svg\\\" class=\\\"h-5 w-5 mr-3\\\" fill=\\\"none\\\" viewBox=\\\"0 0 24 24\\\" stroke=\\\"currentColor\\\">\\r\\n                            <path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" stroke-width=\\\"2\\\" d=\\\"M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z\\\" />\\r\\n                            <path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" stroke-width=\\\"2\\\" d=\\\"M15 12a3 3 0 11-6 0 3 3 0 016 0\\\" />\\r\\n                        </svg>\\r\\n                        Configuración\\r\\n                    </a>\\r\\n                </nav>\\r\\n            </div>\\r\\n\\r\\n\\r\\n            <div class=\\\"p-4 border-t\\\">\\r\\n                <button id=\\\"toggleSize\\\" class=\\\"w-full flex items-center justify-center bg-gray-100 hover:bg-gray-200 text-gray-800 px-4 py-2 rounded-lg transition-all duration-200\\\">\\r\\n                    <svg xmlns=\\\"http://www.w3.org/2000/svg\\\" class=\\\"h-5 w-5 mr-2\\\" fill=\\\"none\\\" viewBox=\\\"0 0 24 24\\\" stroke=\\\"currentColor\\\">\\r\\n                        <path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" stroke-width=\\\"2\\\" d=\\\"M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4\\\" />\\r\\n                    </svg>\\r\\n                    Ajustar tamaño\\r\\n                </button>\\r\\n            </div>\\r\\n        </div>\\r\\n    </div>\\r\\n\\r\\n    \\r\\n</body>\\r\\n</html>\" }} />\n  );\n}\n",
      "type": "registry:ui"
    }
