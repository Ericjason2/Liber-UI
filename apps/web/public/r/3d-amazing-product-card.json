    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Premium 3D Product Card</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    .card-container {\n      perspective: 2000px;\n    }\n    .product-card {\n      transform-style: preserve-3d;\n      transition: all 0.5s cubic-bezier(0.03, 0.98, 0.52, 0.99);\n    }\n    .product-display {\n      transform-style: preserve-3d;\n      transition: transform 0.5s ease-out;\n    }\n    .product-image {\n      transform-style: preserve-3d;\n      filter: drop-shadow(0 20px 15px rgba(0,0,0,0.3));\n    }\n    .color-option {\n      transition: all 0.3s ease;\n      transform-style: preserve-3d;\n    }\n    .color-option:hover {\n      transform: translateY(-5px) scale(1.1);\n    }\n    .spec-highlight {\n      transform: translateZ(20px);\n    }\n  </style>\n</head>\n<body class=\"bg-gradient-to-br from-gray-900 to-gray-800 flex items-center justify-center min-h-screen p-4\">\n  <div class=\"card-container w-full max-w-md\">\n    <div class=\"product-card relative h-[600px] w-full bg-white/5 backdrop-blur-md rounded-3xl overflow-hidden border border-white/10 shadow-2xl group\">\n      <!-- Floating Product Display -->\n      <div class=\"product-display absolute -top-20 left-0 right-0 h-64 flex items-center justify-center\">\n        <img \n          src=\"https://images.unsplash.com/photo-1620799140408-edc6dcb6d633?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1072&q=80\" \n          alt=\"Wireless Headphones\"\n          class=\"product-image w-64 h-64 object-contain transition-all duration-500 group-hover:rotate-[15deg] group-hover:scale-110\"\n        >\n        <div class=\"absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-black/30 pointer-events-none\"></div>\n      </div>\n      \n      <!-- Floating Spec Bubbles -->\n      <div class=\"absolute top-40 left-6 flex flex-col gap-2\">\n        <div class=\"spec-highlight bg-white/10 backdrop-blur-sm rounded-full p-2 w-10 h-10 flex items-center justify-center border border-white/20\">\n          <span class=\"text-white text-xs font-bold\">40h</span>\n        </div>\n        <div class=\"spec-highlight bg-white/10 backdrop-blur-sm rounded-full p-2 w-10 h-10 flex items-center justify-center border border-white/20\">\n          <span class=\"text-white text-xs font-bold\">ANC</span>\n        </div>\n      </div>\n      \n      <!-- Product Content -->\n      <div class=\"absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 to-transparent p-8 pt-16 rounded-t-3xl\">\n        <div class=\"mb-4\">\n          <h2 class=\"text-2xl font-bold text-white mb-1\">Quantum X9</h2>\n          <p class=\"text-sm text-white/70\">Premium Wireless Headphones</p>\n        </div>\n        \n        <!-- Color Options -->\n        <div class=\"mb-6\">\n          <p class=\"text-sm text-white/80 mb-3\">Available colors</p>\n          <div class=\"flex gap-3\">\n            <div class=\"color-option w-8 h-8 rounded-full bg-gray-700 border-2 border-white cursor-pointer\" data-color=\"gray\"></div>\n            <div class=\"color-option w-8 h-8 rounded-full bg-blue-600 border-2 border-transparent cursor-pointer\" data-color=\"blue\"></div>\n            <div class=\"color-option w-8 h-8 rounded-full bg-red-500 border-2 border-transparent cursor-pointer\" data-color=\"red\"></div>\n            <div class=\"color-option w-8 h-8 rounded-full bg-green-500 border-2 border-transparent cursor-pointer\" data-color=\"green\"></div>\n          </div>\n        </div>\n        \n        <!-- Features List -->\n        <ul class=\"grid grid-cols-2 gap-3 mb-6\">\n          <li class=\"flex items-center text-white/80 text-sm\">\n            <svg class=\"w-4 h-4 mr-2 text-blue-400\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path>\n            </svg>\n            Noise Cancelling\n          </li>\n          <li class=\"flex items-center text-white/80 text-sm\">\n            <svg class=\"w-4 h-4 mr-2 text-blue-400\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path>\n            </svg>\n            40mm Drivers\n          </li>\n          <li class=\"flex items-center text-white/80 text-sm\">\n            <svg class=\"w-4 h-4 mr-2 text-blue-400\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path>\n            </svg>\n            40h Battery\n          </li>\n          <li class=\"flex items-center text-white/80 text-sm\">\n            <svg class=\"w-4 h-4 mr-2 text-blue-400\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path>\n            </svg>\n            Touch Controls\n          </li>\n        </ul>\n        \n        <!-- Price and CTA -->\n        <div class=\"flex items-center justify-between\">\n          <div>\n            <p class=\"text-sm text-white/70\">Total price</p>\n            <div class=\"flex items-end\">\n              <span class=\"text-3xl font-bold text-white\">$349</span>\n              <span class=\"text-sm text-white/70 line-through ml-2 mb-1\">$399</span>\n            </div>\n          </div>\n          <button class=\"bg-gradient-to-r from-blue-500 to-purple-600 hover:from-blue-600 hover:to-purple-700 text-white font-medium py-3 px-6 rounded-full shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 flex items-center\">\n            Add to Cart\n            <svg class=\"w-5 h-5 ml-2\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 6v6m0 0v6m0-6h6m-6 0H6\"></path>\n            </svg>\n          </button>\n        </div>\n      </div>\n      \n      <!-- Glow Effect -->\n      <div class=\"absolute inset-0 pointer-events-none overflow-hidden\">\n        <div class=\"absolute -top-20 -left-20 w-40 h-40 bg-blue-500/20 rounded-full filter blur-3xl opacity-70 group-hover:opacity-100 transition-opacity duration-500\"></div>\n        <div class=\"absolute -bottom-20 -right-20 w-60 h-60 bg-purple-500/20 rounded-full filter blur-3xl opacity-70 group-hover:opacity-100 transition-opacity duration-500\"></div>\n      </div>\n    </div>\n  </div>\n\n  <script>\n    document.addEventListener('DOMContentLoaded', () => {\n      const card = document.querySelector('.product-card');\n      const productDisplay = document.querySelector('.product-display');\n      const productImage = document.querySelector('.product-image');\n      const colorOptions = document.querySelectorAll('.color-option');\n      \n      // 3D tilt effect\n      if (card) {\n        card.addEventListener('mousemove', (e) => {\n          const x = e.clientX - card.getBoundingClientRect().left;\n          const y = e.clientY - card.getBoundingClientRect().top;\n          \n          const centerX = card.offsetWidth / 2;\n          const centerY = card.offsetHeight / 2;\n          \n          const angleX = (y - centerY) / 20;\n          const angleY = (centerX - x) / 20;\n          \n          card.style.transform = `rotateX(${angleX}deg) rotateY(${angleY}deg)`;\n          productDisplay.style.transform = `translateZ(50px) rotateX(${angleX * 0.5}deg) rotateY(${angleY * 0.5}deg)`;\n        });\n        \n        card.addEventListener('mouseleave', () => {\n          card.style.transform = 'rotateX(0) rotateY(0)';\n          productDisplay.style.transform = 'translateZ(0) rotateX(0) rotateY(0)';\n        });\n      }\n      \n      // Color selection\n      colorOptions.forEach(option => {\n        option.addEventListener('click', () => {\n          // Remove active border from all options\n          colorOptions.forEach(opt => {\n            opt.classList.remove('border-white');\n            opt.classList.add('border-transparent');\n          });\n          \n          // Add active border to selected option\n          option.classList.remove('border-transparent');\n          option.classList.add('border-white');\n          \n          // Change product color (in a real app you would change the image)\n          const color = option.dataset.color;\n          // This is just a visual demo - in production you'd swap images\n          card.style.setProperty('--tw-gradient-from', `var(--tw-${color}-600)`);\n          card.style.setProperty('--tw-gradient-to', `var(--tw-${color}-800)`);\n        });\n      });\n    });\n  </script>\n</body>\n</html>"
  }
}
