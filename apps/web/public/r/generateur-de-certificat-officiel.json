    "rawHtml": "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Générateur de Certificat Moderne</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <!-- Google Fonts pour un look premium -->\n    <link href=\"https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700&family=Playfair+Display:wght@700&display=swap\" rel=\"stylesheet\">\n    <style>\n        body {\n            background-color: #f8fafc;\n            font-family: 'Montserrat', sans-serif;\n        }\n        .canvas-container {\n            box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);\n        }\n        @media print {\n            .no-print { display: none; }\n            body { background: white; margin: 0; }\n            .canvas-container { box-shadow: none; }\n        }\n    </style>\n</head>\n<body class=\"min-h-screen py-10 px-4\">\n\n    <div class=\"max-w-5xl mx-auto\">\n        <!-- Header Section -->\n        <div class=\"no-print text-center mb-8\">\n            <h1 class=\"text-3xl font-bold text-slate-800 mb-2\">Générateur de Certificat Officiel</h1>\n            <p class=\"text-slate-600\">Personnalisez et téléchargez votre certificat au format haute définition.</p>\n        </div>\n\n        <div class=\"grid lg:grid-cols-3 gap-8\">\n            \n            <!-- Panneau de configuration -->\n            <div class=\"no-print bg-white p-6 rounded-2xl shadow-sm border border-slate-200 h-fit\">\n                <h2 class=\"text-xl font-semibold mb-4 text-slate-700\">Paramètres</h2>\n                \n                <div class=\"space-y-4\">\n                    <div>\n                        <label class=\"block text-sm font-medium text-slate-500 mb-1\">Nom du Récipiendaire</label>\n                        <input type=\"text\" id=\"inputName\" value=\"Jean Dupont\" class=\"w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 outline-none transition-all\">\n                    </div>\n                    <div>\n                        <label class=\"block text-sm font-medium text-slate-500 mb-1\">Nom de la Formation</label>\n                        <input type=\"text\" id=\"inputCourse\" value=\"Expert en Design Interface\" class=\"w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 outline-none transition-all\">\n                    </div>\n                    <div>\n                        <label class=\"block text-sm font-medium text-slate-500 mb-1\">Date d'émission</label>\n                        <input type=\"date\" id=\"inputDate\" class=\"w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 outline-none transition-all\">\n                    </div>\n                    <div>\n                        <label class=\"block text-sm font-medium text-slate-500 mb-1\">Nom du Signataire</label>\n                        <input type=\"text\" id=\"inputSignatory\" value=\"Directeur Académique\" class=\"w-full px-4 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 outline-none transition-all\">\n                    </div>\n                </div>\n\n                <div class=\"mt-8 space-y-3\">\n                    <button id=\"downloadBtn\" class=\"w-full bg-slate-900 hover:bg-black text-white font-bold py-3 rounded-xl transition-all flex items-center justify-center gap-2\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v4\"/><polyline points=\"7 10 12 15 17 10\"/><line x1=\"12\" x2=\"12\" y1=\"15\" y2=\"3\"/></svg>\n                        Télécharger Image\n                    </button>\n                    <button onclick=\"window.print()\" class=\"w-full bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 font-bold py-3 rounded-xl transition-all flex items-center justify-center gap-2\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 9 6 2 18 2 18 9\"/><path d=\"M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2\"/><rect width=\"12\" height=\"8\" x=\"6\" y=\"14\"/></svg>\n                        Imprimer PDF\n                    </button>\n                </div>\n            </div>\n\n            <!-- Preview du Certificat (Canvas) -->\n            <div class=\"lg:col-span-2 flex justify-center items-start\">\n                <div class=\"canvas-container bg-white p-0 rounded-sm overflow-hidden border border-slate-200\">\n                    <canvas id=\"certCanvas\"></canvas>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <script>\n        const canvas = document.getElementById('certCanvas');\n        const ctx = canvas.getContext('2d');\n\n        // Dimensions pour un format Paysage A4 (ratio ~1.41) en haute définition\n        const SCALE = 2; // Facteur pour la HD\n        const WIDTH = 1123 * SCALE;\n        const HEIGHT = 794 * SCALE;\n\n        canvas.width = WIDTH;\n        canvas.height = HEIGHT;\n        \n        // Ajustement visuel pour le responsive sur le web\n        canvas.style.width = '100%';\n        canvas.style.height = 'auto';\n\n        // Variables de données\n        const inputs = {\n            name: document.getElementById('inputName'),\n            course: document.getElementById('inputCourse'),\n            date: document.getElementById('inputDate'),\n            signatory: document.getElementById('inputSignatory')\n        };\n\n        // Initialisation de la date\n        inputs.date.valueAsDate = new Date();\n\n        function drawCertificate() {\n            // 1. Fond\n            ctx.fillStyle = '#ffffff';\n            ctx.fillRect(0, 0, WIDTH, HEIGHT);\n\n            // 2. Éléments Décoratifs (Modernes/Géométriques)\n            // Bordure latérale gauche stylisée\n            ctx.fillStyle = '#0f172a'; // Slate 900\n            ctx.fillRect(0, 0, 80 * SCALE, HEIGHT);\n\n            // Accent doré/bleu\n            ctx.fillStyle = '#6366f1'; // Indigo 500\n            ctx.fillRect(80 * SCALE, 0, 10 * SCALE, HEIGHT);\n\n            // Triangle en haut à droite pour le dynamisme\n            ctx.beginPath();\n            ctx.moveTo(WIDTH, 0);\n            ctx.lineTo(WIDTH - 250 * SCALE, 0);\n            ctx.lineTo(WIDTH, 250 * SCALE);\n            ctx.fillStyle = '#f1f5f9';\n            ctx.fill();\n\n            // 3. Textes\n            \n            // Logo / Titre Institution\n            ctx.textAlign = 'left';\n            ctx.fillStyle = '#0f172a';\n            ctx.font = `bold ${24 * SCALE}px Montserrat`;\n            ctx.fillText('ACADEMIE DESIGN PRO', 130 * SCALE, 70 * SCALE);\n\n            // Titre Principal\n            ctx.textAlign = 'center';\n            ctx.font = `700 ${70 * SCALE}px 'Playfair Display', serif`;\n            ctx.fillStyle = '#0f172a';\n            ctx.fillText('CERTIFICAT DE RÉUSSITE', WIDTH / 2 + 40 * SCALE, HEIGHT * 0.25);\n\n            // Sous-titre\n            ctx.font = `300 ${20 * SCALE}px Montserrat`;\n            ctx.fillStyle = '#64748b';\n            ctx.fillText('CE CERTIFICAT EST FIÈREMENT DÉCERNÉ À', WIDTH / 2 + 40 * SCALE, HEIGHT * 0.38);\n\n            // Nom du récipiendaire\n            ctx.font = `700 ${60 * SCALE}px Montserrat`;\n            ctx.fillStyle = '#1e293b';\n            ctx.fillText(inputs.name.value.toUpperCase(), WIDTH / 2 + 40 * SCALE, HEIGHT * 0.48);\n\n            // Ligne décorative sous le nom\n            ctx.strokeStyle = '#6366f1';\n            ctx.lineWidth = 3 * SCALE;\n            ctx.beginPath();\n            ctx.moveTo(WIDTH/2 - 150 * SCALE, HEIGHT * 0.52);\n            ctx.lineTo(WIDTH/2 + 230 * SCALE, HEIGHT * 0.52);\n            ctx.stroke();\n\n            // Description\n            ctx.font = `300 ${22 * SCALE}px Montserrat`;\n            ctx.fillStyle = '#64748b';\n            ctx.fillText('Pour avoir complété avec succès le programme de formation de :', WIDTH / 2 + 40 * SCALE, HEIGHT * 0.62);\n\n            // Nom de la formation\n            ctx.font = `600 ${32 * SCALE}px Montserrat`;\n            ctx.fillStyle = '#0f172a';\n            ctx.fillText(inputs.course.value, WIDTH / 2 + 40 * SCALE, HEIGHT * 0.70);\n\n            // 4. Pied de page (Signatures et Date)\n            \n            // Date\n            const dateObj = new Date(inputs.date.value);\n            const formattedDate = dateObj.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });\n            \n            ctx.textAlign = 'left';\n            ctx.font = `400 ${18 * SCALE}px Montserrat`;\n            ctx.fillStyle = '#64748b';\n            ctx.fillText('Délivré le :', 150 * SCALE, HEIGHT * 0.85);\n            ctx.font = `bold ${18 * SCALE}px Montserrat`;\n            ctx.fillStyle = '#0f172a';\n            ctx.fillText(formattedDate, 150 * SCALE, HEIGHT * 0.89);\n\n            // Signature\n            ctx.textAlign = 'right';\n            ctx.font = `italic ${24 * SCALE}px 'Playfair Display'`;\n            ctx.fillStyle = '#0f172a';\n            ctx.fillText(inputs.signatory.value, WIDTH - 100 * SCALE, HEIGHT * 0.85);\n            \n            ctx.strokeStyle = '#cbd5e1';\n            ctx.lineWidth = 1 * SCALE;\n            ctx.beginPath();\n            ctx.moveTo(WIDTH - 350 * SCALE, HEIGHT * 0.87);\n            ctx.lineTo(WIDTH - 100 * SCALE, HEIGHT * 0.87);\n            ctx.stroke();\n\n            ctx.font = `400 ${16 * SCALE}px Montserrat`;\n            ctx.fillStyle = '#64748b';\n            ctx.fillText('SIGNATURE AUTORISÉE', WIDTH - 100 * SCALE, HEIGHT * 0.91);\n\n            // Badge Scellé (Cercle décoratif)\n            ctx.beginPath();\n            ctx.arc(WIDTH * 0.53, HEIGHT * 0.85, 45 * SCALE, 0, Math.PI * 2);\n            ctx.fillStyle = '#e2e8f0';\n            ctx.fill();\n            ctx.strokeStyle = '#6366f1';\n            ctx.stroke();\n            \n            ctx.textAlign = 'center';\n            ctx.font = `bold ${12 * SCALE}px Montserrat`;\n            ctx.fillStyle = '#6366f1';\n            ctx.fillText('CERTIFIÉ', WIDTH * 0.53, HEIGHT * 0.85 + 5 * SCALE);\n        }\n\n        // Écouteurs d'événements pour la mise à jour en temps réel\n        Object.values(inputs).forEach(input => {\n            input.addEventListener('input', drawCertificate);\n        });\n\n        // Téléchargement de l'image\n        document.getElementById('downloadBtn').addEventListener('click', () => {\n            const link = document.createElement('a');\n            link.download = `Certificat_${inputs.name.value.replace(/\\s+/g, '_')}.png`;\n            link.href = canvas.toDataURL('image/png', 1.0);\n            link.click();\n        });\n\n        // Initial Draw\n        window.onload = drawCertificate;\n    </script>\n</body>\n</html>"
  }
}
