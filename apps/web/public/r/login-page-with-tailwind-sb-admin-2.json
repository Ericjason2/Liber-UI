 dark border rounded shadow appearance-none focus focus\"\n                                        id=\"UserName\"\n                                        type=\"text\"\n                                        placeholder=\"UserName\"\n                                    />\n    \t\t\t\t\t\t\t</div>\n    \t\t\t\t\t\t</div>\n    \t\t\t\t\t\t<div className=\"mb-4 md md\">\n    \t\t\t\t\t\t\t<div className=\"mb-4 md2 md0\">\n    \t\t\t\t\t\t\t\t<label className=\"block mb-2 text-sm font-bold text-gray-700 dark\" htmlFor=\"password\">\n                                        Password\n                                    </label>\n    \t\t\t\t\t\t\t\t<input\n                                        className=\"w-full px-3 py-2 mb-3 text-sm leading-tight text-gray-700 dark border border-red-500 rounded shadow appearance-none focus focus\"\n                                        id=\"password\"\n                                        type=\"password\"\n                                        placeholder=\"******************\"\n                                    />\n    \t\t\t\t\t\t\t\t<p className=\"text-xs italic text-red-500\">Please choose a password.</p>\n    \t\t\t\t\t\t\t</div>\n    \t\t\t\t\t\t\t<div className=\"md2\">\n    \t\t\t\t\t\t\t\t<label className=\"block mb-2 text-sm font-bold text-gray-700 dark\" htmlFor=\"c_password\">\n                                        Confirm Password\n                                    </label>\n    \t\t\t\t\t\t\t\t<input\n                                        className=\"w-full px-3 py-2 mb-3 text-sm leading-tight text-gray-700 dark border rounded shadow appearance-none focus focus\"\n                                        id=\"c_password\"\n                                        type=\"password\"\n                                        placeholder=\"******************\"\n                                    />\n    \t\t\t\t\t\t\t</div>\n    \t\t\t\t\t\t</div>\n    \t\t\t\t\t\t<div className=\"mb-4 lg5  md[90px]\">\n    \t\t\t\t\t\t\t<label className=\"block mb-2 text-sm font-bold text-gray-700 dark\" htmlFor=\"JobTitle\">\n                                    Job Title\n                                </label>\n    \t\t\t\t\t\t\t<input\n                                    className=\"w-full px-3 py-2 mb-3 text-sm leading-tight text-gray-700 dark border rounded shadow appearance-none focus focus\"\n                                    id=\"JobTitle\"\n                                    type=\"text\"\n                                    placeholder=\"Enter your expected Job title\"\n                                />\n    \t\t\t\t\t\t</div>\n    \t\t\t\t\t\t<div className=\"mb-4 lg5 md[90px]\">\n    \t\t\t\t\t\t\t<label className=\"block mb-2 text-sm font-bold text-gray-700 dark\" htmlFor=\"JobType\">\n                                    Job Type\n                                </label>\n    \t\t\t\t\t\t\t<input\n                                    className=\"w-full px-3 py-2 mb-3 text-sm leading-tight text-gray-700 dark border rounded shadow appearance-none focus focus\"\n                                    id=\"JobType\"\n                                    type=\"text\"\n                                   \n                                />\n    \t\t\t\t\t\t</div>\n    \t\t\t\t\t\t<div className=\"mb-4 lg5 md[90px]\">\n    \t\t\t\t\t\t\t<label className=\"block text-sm font-bold text-gray-700 dark\" htmlFor=\"JobType\">\n                                    Work Authorization\n                                </label>\n    \t\t\t\t\t\t\t<label className=\"mt-5 mb-6 flex content-start\"><input type=\"checkbox\" name=\"H1B\" className=\"mr-2 form-checkbox rounded-none ring-0 focus500 border-tan-300 border-2 w-5 h-5 text-highlight\" /> \n    \t\t\t\t\t\t\t   <span className=\"text-sm font-semibold\">H1B sponsorship</span>\n    \t\t\t\t\t\t\t</label>\n    \t\t\t\t\t\t</div>\n    \t\t\t\t\t\t<div className=\"mb-6 text-center\">\n    \t\t\t\t\t\t\t<button\n                            