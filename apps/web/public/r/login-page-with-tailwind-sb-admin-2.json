ister Account\n                            </button>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<hr class=\"mb-6 border-t\" />\n\t\t\t\t\t\t<div class=\"text-center\">\n\t\t\t\t\t\t\t<a class=\"inline-block text-sm text-blue-500 dark:text-blue-500 align-baseline hover:text-blue-800\"\n\t\t\t\t\t\t\t\thref=\"./index.html\">\n\t\t\t\t\t\t\t\tAlready have an account? Login!\n\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</form>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>"
