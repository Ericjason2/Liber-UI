      "content": "/**\n * Component: Contact form Modern\n * Author: @alif-bima-pradana (https://tailwindflex.com/@alif-bima-pradana)\n * Source: https://tailwindflex.com/@alif-bima-pradana/contact-form-modern\n * Attribution: Créé par @alif-bima-pradana sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function ContactFormModern() {\n  return (\n    <div dangerouslySetInnerHTML={{ __html: \"<!DOCTYPE html>\\n<html lang=\\\"id\\\">\\n<head>\\n    <meta charset=\\\"UTF-8\\\">\\n    <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\">\\n    <title>Modern Contact Form</title>\\n    \\n    <link rel=\\\"preconnect\\\" href=\\\"https://fonts.googleapis.com\\\">\\n    <link rel=\\\"preconnect\\\" href=\\\"https://fonts.gstatic.com\\\" crossorigin>\\n    <link href=\\\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap\\\" rel=\\\"stylesheet\\\">\\n    <link rel=\\\"stylesheet\\\" href=\\\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css\\\">\\n    \\n    <style>\\n        .glass { background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.1); }\\n        .gradient-text { background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }\\n        .shadow-glow { box-shadow: 0 0 40px rgba(99, 102, 241, 0.1); }\\n        .btn-premium { transition: all 0.3s ease; }\\n        .btn-premium:hover { transform: translateY(-2px); }\\n        input:focus, textarea:focus { box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.5); }\\n        .reveal { opacity: 0; transform: translateY(40px); transition: all 0.8s ease; }\\n        .reveal.active { opacity: 1; transform: translateY(0); }\\n    </style>\\n</head>\\n<body class=\\\"bg-slate-950 min-h-screen flex items-center justify-center p-4 md:p-8\\\">\\n    <section class=\\\"w-full max-w-2xl glass rounded-2xl p-8 md:p-12 shadow-glow reveal\\\">\\n        <div class=\\\"mb-10 text-center\\\">\\n            <h2 class=\\\"text-3xl md:text-4xl font-bold mb-2 gradient-text\\\">Contact Us</h2>\\n            <p class=\\\"text-gray-400\\\">We'd love to hear from you!</p>\\n        </div>\\n\\n        <form class=\\\"space-y-6\\\">\\n            <div class=\\\"grid grid-cols-1 md:grid-cols-2 gap-6\\\">\\n                <div>\\n                    <label class=\\\"block text-sm font-medium mb-2 text-gray-300\\\">Your Name</label>\\n                    <div class=\\\"relative\\\">\\n                        <input type=\\\"text\\\" class=\\\"w-full bg-gray-900/50 border border-gray-800 rounded-xl py-3 px-4 focus:outline-none focus:border-primary-500 transition-all\\\" placeholder=\\\"John Doe\\\">\\n                        <i class=\\\"fa-regular fa-user absolute right-4 top-1/2 -translate-y-1/2 text-gray-500\\\"></i>\\n                    </div>\\n                </div>\\n\\n                <div>\\n                    <label class=\\\"block text-sm font-medium mb-2 text-gray-300\\\">Email Address</label>\\n                    <div class=\\\"relative\\\">\\n                        <input type=\\\"email\\\" class=\\\"w-full bg-gray-900/50 border border-gray-800 rounded-xl py-3 px-4 focus:outline-none focus:border-primary-500 transition-all\\\" placeholder=\\\"johndoe@example.com\\\">\\n                        <i class=\\\"fa-regular fa-envelope absolute right-4 top-1/2 -translate-y-1/2 text-gray-500\\\"></i>\\n                    </div>\\n                </div>\\n            </div>\\n\\n            <div>\\n                <label class=\\\"block text-sm font-medium mb-2 text-gray-300\\\">Subject</label>\\n                <div class=\\\"relative\\\">\\n                    <input type=\\\"text\\\" class=\\\"w-full bg-gray-900/50 border border-gray-800 rounded-xl py-3 px-4 focus:outline-none focus:border-primary-500 transition-all\\\" placeholder=\\\"How can we help?\\\">\\n                    <i class=\\\"fa-regular fa-comment-dots absolute right-4 top-1/2 -translate-y-1/2 text-gray-500\\\"></i>\\n                </div>\\n            </div>\\n\\n            <div>\\n                <label class=\\\"block text-sm font-medium mb-2 text-gray-300\\\">Message</label>\\n                <textarea class=\\\"w-full bg-gray-900/50 border border-gray-800 rounded-xl py-3 px-4 focus:outline-none focus:border-primary-500 transition-all h-32 resize-none\\\" placeholder=\\\"Write your message here...\\\"></textarea>\\n            </div>\\n\\n            <button class=\\\"w-full btn-premium bg-gradient-to-r from-primary-600 to-secondary-600 hover:from-primary-700 hover:to-secondary-700 text-white py-3 px-6 rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-300\\\">\\n                Send Message\\n                <i class=\\\"fa-regular fa-paper-plane ml-2\\\"></i>\\n            </button>\\n        </form>\\n\\n        <div class=\\\"mt-12 grid grid-cols-1 md:grid-cols-3 gap-6 text-center\\\">\\n            <div class=\\\"glass p-6 rounded-xl hover:bg-gray-900/20 transition-all\\\">\\n                <i class=\\\"fa-solid fa-phone text-3xl mb-4 text-primary-500\\\"></i>\\n                <h4 class=\\\"font-semibold mb-2\\\">Call Us</h4>\\n                <p class=\\\"text-gray-400 text-sm\\\">+1 (555) 123-4567</p>\\n            </div>\\n            <div class=\\\"glass p-6 rounded-xl hover:bg-gray-900/20 transition-all\\\">\\n                <i class=\\\"fa-solid fa-envelope text-3xl mb-4 text-secondary-500\\\"></i>\\n                <h4 class=\\\"font-semibold mb-2\\\">Email Us</h4>\\n                <p class=\\\"text-gray-400 text-sm\\\">support@company.com</p>\\n            </div>\\n            <div class=\\\"glass p-6 rounded-xl hover:bg-gray-900/20 transition-all\\\">\\n                <i class=\\\"fa-solid fa-location-dot text-3xl mb-4 text-accent-500\\\"></i>\\n                <h4 class=\\\"font-semibold mb-2\\\">Visit Us</h4>\\n                <p class=\\\"text-gray-400 text-sm\\\">New York, USA</p>\\n            </div>\\n        </div>\\n    </section>\\n\\n    \\n</body>\\n</html>\" }} />\n  );\n}\n",
