ref=\\\"#\\\" class=\\\"hover:text-purple-300 transition-colors\\\">How it adapts</a>\\n                <a href=\\\"#\\\" class=\\\"hover:text-purple-300 transition-colors\\\">Everyday motion</a>\\n                <a href=\\\"#\\\" class=\\\"hover:text-purple-300 transition-colors\\\">Testimonials</a>\\n                <a href=\\\"#\\\" class=\\\"hover:text-purple-300 transition-colors\\\">Pricing</a>\\n            </div>\\n\\n            <button class=\\\"px-5 py-2 rounded-full border border-gray-700 text-sm hover:border-purple-500 hover:text-purple-300 transition-all duration-300\\\">\\n                Try Mist\\n            </button>\\n        </nav>\\n\\n        <!-- CONTENIDO PRINCIPAL -->\\n        <main class=\\\"relative z-10 max-w-7xl mx-auto px-6 pt-20 pb-12 flex flex-col justify-between h-[calc(100vh-100px)]\\\">\\n\\n            <!-- Sección Hero -->\\n            <div class=\\\"grid grid-cols-1 lg:grid-cols-2 gap-12 items-start mt-10\\\">\\n\\n                <!-- Columna Izquierda: Título Grande -->\\n                <div>\\n                    <h1 class=\\\"text-6xl md:text-7xl lg:text-8xl font-medium tracking-tighter leading-[0.95]\\\">\\n                        Tech that listens <br />\\n                        <span class=\\\"text-gray-400\\\">before it acts.</span>\\n                    </h1>\\n                </div>\\n\\n                <!-- Columna Derecha: Descripción y Botones -->\\n                <div class=\\\"lg:pl-10 flex flex-col justify-center h-full pt-4\\\">\\n                    <p class=\\\"text-xl text-gray-400 max-w-md leading-relaxed\\\">\\n                        We build adaptive systems that learn from context — calm, precise, and deeply human in how they respond. No friction. No noise. Just flow between thought and interface.\\n                    </p>\\n\\n                    <div class=\\\"flex flex-wrap gap-4 mt-8\\\">\\n                        <button class=\\\"px-6 py-3 rounded-full border border-gray-600 text-gray-300 hover:bg-gray-800 hover:border-gray-500 transition-all\\\">\\n                            See how it works\\n                        </button>\\n                        <button class=\\\"px-6 py-3 rounded-full bg-purple-200 text-purple-950 font-semibold hover:bg-white hover:shadow-[0_0_20px_rgba(168,85,247,0.5)] transition-all\\\">\\n                            Start for Free\\n                        </button>\\n                    </div>\\n                </div>\\n            </div>\\n\\n            <!-- Footer / Sección Inferior -->\\n            <div class=\\\"grid grid-cols-1 md:grid-cols-2 gap-8 items-end mt-auto\\\">\\n\\n                <!-- Izquierda: Datos del sistema (Estilo Terminal) -->\\n                <div class=\\\"font-mono text-xs text-purple-300/60 space-y-1 p-4 rounded-lg bg-purple-900/10 border border-purple-500/10 backdrop-blur-sm max-w-sm\\\">\\n                    <p>Context loading</p>\\n                    <p>Calendar context loaded</p>\\n                    <p>Reading focus patterns</p>\\n                    <p>Noise signals filtered</p>\\n                    <br>\\n                    <p class=\\\"text-purple-200\\\">> I see two free blocks between 2-5 PM.</p>\\n                    <p class=\\\"text-purple-200\\\">> You tend to focus best at 14:40 -</p>\\n                    <p class=\\\"text-purple-200\\\">> want me to reserve a deep-work slot?</p>\\n                    <br>\\n                    <p class=\\\"opacity-70\\\">Also: one missed message</p>\\n                    <p class=\\\"opacity-70 blur-[2px]\\\">from Sarah - need a quick summary?</p>\\n                </div>\\n\\n                <!-- Derecha: Estadísticas -->\\n                <div class=\\\"flex justify-start md:justify-end space-x-12 md:space-x-16\\\">\\n                    <div>\\n                        <div class=\\\"text-4xl md:text-5xl font-light text-white mb-1\\\">2,500+</div>\\n                        <div class=\\\"text-xs tracking-widest text-gray-500 uppercase font-medium\\\">Active Users</div>\\n                    </div>\\n                    <div>\\n                        <div class=\\\"text-4xl md:text-5xl font-light text-white mb-1\\\">98%</div>\\n                        <div class=\\\"text-xs tracking-widest text-gray-500 uppercase font-medium\\\">Retention Rate</div>\\n                    </div>\\n                    <div>\\n                        <div class=\\\"text-4xl md:text-5xl font-light text-white mb-1\\\">1.2M</div>\\n                        <div class=\\\"text-xs tracking-widest text-gray-500 uppercase font-medium\\\">Contextual Data<br>Points</div>\\n                    </div>\\n                </div>\\n\\n            </div>\\n        </main>\\n\\n    </div>\" }} />\n  );\n}\n",
