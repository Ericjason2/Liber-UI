    "rawHtml": "<section class=\"py-12 md:py-24\">\r\n    <div class=\"w-full max-w-6xl mx-auto px-4 sm:px-6 md:px-8 relative\">\r\n        <div class=\"shadow rounded-xl\">\r\n            <div class=\"grid overflow-hidden text-white shadow-xl md:grid-cols-2 bg-blue-600 rounded-xl\">\r\n                <aside class=\"p-8 space-y-4 md:p-16\">\r\n                    <h2 class=\"text-2xl font-bold tracking-tight md:text-4xl font-headline\">\r\n                        Ready to dive in?\r\n                        Start your free trial today.\r\n                    </h2>\r\n\r\n                    <p class=\"font-medium text-blue-100 md:text-2xl\">\r\n                        Create an account to enjoy your 5-day free trial, no credit card required.\r\n                    </p>\r\n\r\n                    <div>\r\n                        <a href=\"\" class=\"bg-white text-blue-600 px-4 py-2 mt-3 rounded-xl\">\r\n                            Start free trial\r\n                        </a>\r\n                    </div>\r\n                </aside>\r\n\r\n                <aside class=\"relative hidden md:block\">\r\n                    <img class=\"absolute inset-0 object-cover object-left-top w-full h-full mt-16 -mr-16 rounded-tl-lg\" src=\"https://picsum.photos/200\" alt=\"Discover our beautiful panel\">\r\n                </aside>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</section>"
