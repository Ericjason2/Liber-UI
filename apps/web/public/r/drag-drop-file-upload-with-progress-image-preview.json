    "mention": "Créé par @jugendra-gangwar sur TailwindFlex",
    "rawHtml": "<body class=\"min-h-screen bg-page text-ink\">\n  <main class=\"flex min-h-screen items-center justify-center px-4 py-10 sm:px-6\">\n\n    <section class=\"w-full max-w-3xl rounded-[28px] border border-line bg-card p-5 shadow-card sm:p-8\">\n\n      <div class=\"flex flex-col gap-5 border-b border-line pb-7 sm:flex-row sm:items-start sm:justify-between\">\n\n        <div>\n          <span class=\"inline-flex rounded-full bg-tealSoft px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-teal\">\n            File upload\n          </span>\n\n          <h1 class=\"mt-4 text-2xl font-semibold tracking-tight sm:text-3xl\">\n            Upload project files\n          </h1>\n\n          <p class=\"mt-2 max-w-xl text-sm leading-6 text-muted\">\n            Drag and drop your documents or images below. You can upload multiple files and review them before submission.\n          </p>\n        </div>\n\n        <div class=\"shrink-0 rounded-xl border border-line bg-stoneSoft px-4 py-3 text-sm\">\n          <span id=\"fileCounter\" class=\"font-semibold text-ink\">0</span>\n          <span class=\"text-muted\"> / 6 files</span>\n        </div>\n\n      </div>\n\n\n      <div\n        id=\"dropZone\"\n        tabindex=\"0\"\n        role=\"button\"\n        aria-label=\"Upload files\"\n        class=\"group mt-7 cursor-pointer rounded-2xl border-2 border-dashed border-line bg-stoneSoft px-5 py-10 text-center outline-none transition sm:px-8 sm:py-12\"\n      >\n\n        <input\n          id=\"fileInput\"\n          type=\"file\"\n          class=\"hidden\"\n          multiple\n          accept=\".png,.jpg,.jpeg,.pdf,.doc,.docx\"\n        />\n\n        <div\n          id=\"uploadIcon\"\n          class=\"mx-auto flex h-14 w-14 items-center justify-center rounded-2xl border border-line bg-white text-teal shadow-sm transition group-hover:border-teal/30\"\n        >\n          <svg\n            class=\"h-6 w-6\"\n            fill=\"none\"\n            viewBox=\"0 0 24 24\"\n            stroke=\"currentColor\"\n          >\n            <path\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              stroke-width=\"1.8\"\n              d=\"M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5M5 15.5v2.25A2.25 2.25 0 007.25 20h9.5A2.25 2.25 0 0019 17.75V15.5\"\n            />\n          </svg>\n        </div>\n\n        <h2 class=\"mt-5 text-base font-semibold\">\n          Drop files here\n        </h2>\n\n        <p class=\"mt-1.5 text-sm text-muted\">\n          or\n          <span class=\"font-semibold text-teal\">\n            browse from your device\n          </span>\n        </p>\n\n        <div class=\"mt-5 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-xs text-muted\">\n          <span>PNG</span>\n          <span class=\"h-1 w-1 rounded-full bg-slate-300\"></span>\n          <span>JPG</span>\n          <span class=\"h-1 w-1 rounded-full bg-slate-300\"></span>\n          <span>PDF</span>\n          <span class=\"h-1 w-1 rounded-full bg-slate-300\"></span>\n          <span>DOC / DOCX</span>\n          <span class=\"h-1 w-1 rounded-full bg-slate-300\"></span>\n          <span>Max 8 MB</span>\n        </div>\n\n      </div>\n\n\n      <div\n        id=\"globalError\"\n        class=\"mt-4 hidden rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700\"\n      ></div>\n\n\n      <div id=\"fileSection\" class=\"mt-8 hidden\">\n\n        <div class=\"mb-4 flex items-center justify-between\">\n\n          <div>\n            <h3 class=\"text-sm font-semibold\">\n              Selected files\n            </h3>\n\n            <p class=\"mt-1 text-xs text-muted\">\n              Files will upload automatically.\n            </p>\n          </div>\n\n          <button\n            id=\"clearAllButton\"\n            type=\"button\"\n            class=\"text-sm font-semibold text-muted transition hover:text-clay\"\n          >\n            Clear all\n          </button>\n\n        </div>\n\n\n        <div id=\"fileList\" class=\"space-y-3\"></div>\n\n      </div>\n\n\n      <div class=\"mt-8 flex flex-col-reverse gap-3 border-t border-line pt-6 sm:flex-row sm:items-center sm:justify-between\">\n\n        <p class=\"flex items-center gap-2 text-xs text-muted\">\n          <svg\n            class=\"h-4 w-4\"\n            fill=\"none\"\n            viewBox=\"0 0 24 24\"\n            stroke=\"currentColor\"\n          >\n            <path\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              stroke-width=\"1.7\"\n              d=\"M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4\"\n            />\n          </svg>\n\n          Files are processed securely.\n        </p>\n\n\n        <button\n          id=\"continueButton\"\n          type=\"button\"\n          disabled\n          class=\"inline-flex items-center justify-center rounded-xl bg-ink px-6 py-3 text-sm font-semibold text-white transition hover:bg-black disabled:cursor-not-allowed disabled:opacity-35\"\n        >\n          Continue\n\n          <svg\n            class=\"ml-2 h-4 w-4\"\n            fill=\"none\"\n            viewBox=\"0 0 24 24\"\n            stroke=\"currentColor\"\n          >\n            <path\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              stroke-width=\"1.8\"\n              d=\"M9 5l7 7-7 7\"\n            />\n          </svg>\n        </button>\n\n      </div>\n\n    </section>\n\n  </main>\n\n\n  <script>\n    const dropZone = document.getElementById(\"dropZone\");\n    const fileInput = document.getElementById(\"fileInput\");\n    const fileList = document.getElementById(\"fileList\");\n    const fileSection = document.getElementById(\"fileSection\");\n    const fileCounter = document.getElementById(\"fileCounter\");\n    const globalError = document.getElementById(\"globalError\");\n    const clearAllButton = document.getElementById(\"clearAllButton\");\n    const continueButton = document.getElementById(\"continueButton\");\n\n    const MAX_FILES = 6;\n    const MAX_SIZE = 8 * 1024 * 1024;\n\n    const allowedTypes = [\n      \"image/png\",\n      \"image/jpeg\",\n      \"application/pdf\",\n      \"application/msword\",\n      \"application/vnd.openxmlformats-officedocument.wordprocessingml.document\"\n    ];\n\n    let uploadedFiles = [];\n\n    dropZone.addEventListener(\"click\", () => {\n      fileInput.click();\n    });\n\n\n    dropZone.addEventListener(\"keydown\", event => {\n      if (event.key === \"Enter\" || event.key === \" \") {\n        event.preventDefault();\n        fileInput.click();\n      }\n    });\n\n\n    fileInput.addEventListener(\"change\", event => {\n      handleFiles([...event.target.files]);\n      fileInput.value = \"\";\n    });\n\n\n    [\"dragenter\", \"dragover\"].forEach(eventName => {\n\n      dropZone.addEventListener(eventName, event => {\n        event.preventDefault();\n\n        dropZone.classList.remove(\n          \"border-line\",\n          \"bg-stoneSoft\"\n        );\n\n        dropZone.classList.add(\n          \"border-teal\",\n          \"bg-tealSoft\"\n        );\n      });\n\n    });\n\n\n    [\"dragleave\", \"drop\"].forEach(eventName => {\n\n      dropZone.addEventListener(eventName, event => {\n        event.preventDefault();\n\n        dropZone.classList.remove(\n          \"border-teal\",\n          \"bg-tealSoft\"\n        );\n\n        dropZone.classList.add(\n          \"border-line\",\n          \"bg-stoneSoft\"\n        );\n      });\n\n    });\n\n\n    dropZone.addEventListener(\"drop\", event => {\n      handleFiles([...event.dataTransfer.files]);\n    });\n\n    function handleFiles(files) {\n\n      hideError();\n\n      if (uploadedFiles.length >= MAX_FILES) {\n        showError(`You can upload a maximum of ${MAX_FILES} files.`);\n        return;\n      }\n\n\n      const remainingSlots = MAX_FILES - uploadedFiles.length;\n\n      if (files.length > remainingSlots) {\n        showError(\n          `Only ${remainingSlots} more file${remainingSlots === 1 ? \"\" : \"s\"} can be added.`\n        );\n\n        files = files.slice(0, remainingSlots);\n      }\n\n\n      files.forEach(file => {\n\n        const validationError = validateFile(file);\n\n        if (validationError) {\n          showError(validationError);\n          return;\n        }\n\n\n        const alreadyExists = uploadedFiles.some(item =>\n          item.file.name === file.name &&\n          item.file.size === file.size\n        );\n\n\n        if (alreadyExists) {\n          showError(`${file.name} has already been added.`);\n          return;\n        }\n\n\n        const fileObject = {\n          id: generateId(),\n          file,\n          progress: 0,\n          status: \"uploading\",\n          preview: null\n        };\n\n\n        if (file.type.startsWith(\"image/\")) {\n          fileObject.preview = URL.createObjectURL(file);\n        }\n\n\n        uploadedFiles.push(fileObject);\n\n        renderFile(fileObject);\n\n        simulateUpload(fileObject.id);\n      });\n\n\n      updateInterface();\n    }\n\n\n\n    function validateFile(file) {\n\n      if (!allowedTypes.includes(file.type)) {\n        return `${file.name} is not a supported file type.`;\n      }\n\n\n      if (file.size > MAX_SIZE) {\n        return `${file.name} exceeds the 8 MB size limit.`;\n      }\n\n\n      return null;\n    }\n\n\n    function renderFile(fileObject) {\n\n      const card = document.createElement(\"div\");\n\n      card.id = `file-${fileObject.id}`;\n\n      card.className =\n        \"rounded-2xl border border-line bg-white p-4\";\n\n      card.innerHTML = `\n        <div class=\"flex items-start gap-4\">\n\n          ${getFilePreview(fileObject)}\n\n          <div class=\"min-w-0 flex-1\">\n\n            <div class=\"flex items-start justify-between gap-4\">\n\n              <div class=\"min-w-0\">\n\n                <p class=\"truncate text-sm font-semibold text-ink\">\n                  ${escapeHTML(fileObject.file.name)}\n                </p>\n\n                <div class=\"mt-1 flex flex-wrap items-center gap-x-2 text-xs text-muted\">\n\n                  <span>\n                    ${formatFileSize(fileObject.file.size)}\n                  </span>\n\n                  <span class=\"h-1 w-1 rounded-full bg-slate-300\"></span>\n\n                  <span\n                    id=\"status-${fileObject.id}\"\n                    class=\"font-medium\"\n                  >\n                    Preparing...\n                  </span>\n\n                </div>\n\n              </div>\n\n\n              <button\n                type=\"button\"\n                onclick=\"removeFile('${fileObject.id}')\"\n                aria-label=\"Remove ${escapeHTML(fileObject.file.name)}\"\n                class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-muted transition hover:bg-claySoft hover:text-clay\"\n              >\n                <svg\n                  class=\"h-4 w-4\"\n                  fill=\"none\"\n                  viewBox=\"0 0 24 24\"\n                  stroke=\"currentColor\"\n                >\n                  <path\n                    stroke-linecap=\"round\"\n                    stroke-linejoin=\"round\"\n                    stroke-width=\"1.8\"\n                    d=\"M6 18L18 6M6 6l12 12\"\n                  />\n                </svg>\n              </button>\n\n            </div>\n\n\n            <div\n              id=\"progress-wrapper-${fileObject.id}\"\n              class=\"mt-4\"\n            >\n\n              <div class=\"h-1.5 overflow-hidden rounded-full bg-line\">\n\n                <div\n                  id=\"progress-${fileObject.id}\"\n                  class=\"h-full rounded-full bg-teal transition-all duration-300\"\n                  style=\"width: 0%\"\n                ></div>\n\n              </div>\n\n\n              <div class=\"mt-2 flex items-center justify-between\">\n\n                <span\n                  id=\"progress-text-${fileObject.id}\"\n                  class=\"text-xs text-muted\"\n                >\n                  Uploading...\n                </span>\n\n                <span\n                  id=\"percentage-${fileObject.id}\"\n                  class=\"text-xs font-semibold text-ink\"\n                >\n                  0%\n                </span>\n\n              </div>\n\n            </div>\n\n          </div>\n\n        </div>\n      `;\n\n\n      fileList.appendChild(card);\n    }\n\n    function getFilePreview(fileObject) {\n\n      if (fileObject.preview) {\n\n        return `\n          <div class=\"h-12 w-12 shrink-0 overflow-hidden rounded-xl border border-line bg-stoneSoft\">\n            <img\n              src=\"${fileObject.preview}\"\n              alt=\"\"\n              class=\"h-full w-full object-cover\"\n            />\n          </div>\n        `;\n      }\n\n\n      const extension = getExtension(fileObject.file.name);\n\n\n      if (extension === \"pdf\") {\n\n        return `\n          <div class=\"flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-claySoft text-xs font-bold uppercase text-clay\">\n            PDF\n          </div>\n        `;\n      }\n\n\n      return `\n        <div class=\"flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-tealSoft text-xs font-bold uppercase text-teal\">\n          ${extension || \"FILE\"}\n        </div>\n      `;\n    }\n\n\n    function simulateUpload(id) {\n\n      const interval = setInterval(() => {\n\n        const item = uploadedFiles.find(file => file.id === id);\n\n        if (!item) {\n          clearInterval(interval);\n          return;\n        }\n\n\n        const increment = Math.floor(Math.random() * 14) + 6;\n\n        item.progress = Math.min(\n          item.progress + increment,\n          100\n        );\n\n\n        updateProgress(item);\n\n\n        if (item.progress >= 100) {\n\n          clearInterval(interval);\n\n          item.status = \"uploaded\";\n\n          completeUpload(item);\n        }\n\n      }, 420);\n    }\n\n\n\n    function updateProgress(item) {\n\n      const progressBar =\n        document.getElementById(`progress-${item.id}`);\n\n      const percentage =\n        document.getElementById(`percentage-${item.id}`);\n\n      const status =\n        document.getElementById(`status-${item.id}`);\n\n\n      if (!progressBar) return;\n\n\n      progressBar.style.width =\n        `${item.progress}%`;\n\n      percentage.textContent =\n        `${item.progress}%`;\n\n      status.textContent =\n        \"Uploading\";\n\n      status.className =\n        \"font-medium text-teal\";\n    }\n\n\n\n    function completeUpload(item) {\n\n      const status =\n        document.getElementById(`status-${item.id}`);\n\n      const wrapper =\n        document.getElementById(`progress-wrapper-${item.id}`);\n\n\n      status.innerHTML = `\n        <span class=\"inline-flex items-center gap-1.5 text-teal\">\n\n          <svg\n            class=\"h-3.5 w-3.5\"\n            fill=\"none\"\n            viewBox=\"0 0 24 24\"\n            stroke=\"currentColor\"\n          >\n            <path\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              stroke-width=\"2\"\n              d=\"M5 13l4 4L19 7\"\n            />\n          </svg>\n\n          Uploaded\n\n        </span>\n      `;\n\n\n      wrapper.innerHTML = `\n        <div class=\"mt-4 flex items-center justify-between rounded-lg bg-tealSoft px-3 py-2\">\n\n          <span class=\"text-xs font-medium text-teal\">\n            Upload complete\n          </span>\n\n          <svg\n            class=\"h-4 w-4 text-teal\"\n            fill=\"none\"\n            viewBox=\"0 0 24 24\"\n            stroke=\"currentColor\"\n          >\n            <path\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              stroke-width=\"2\"\n              d=\"M5 13l4 4L19 7\"\n            />\n          </svg>\n\n        </div>\n      `;\n\n\n      updateInterface();\n    }\n\n    window.removeFile = function(id) {\n\n      const fileIndex =\n        uploadedFiles.findIndex(item => item.id === id);\n\n\n      if (fileIndex === -1) return;\n\n\n      const fileObject =\n        uploadedFiles[fileIndex];\n\n\n      if (fileObject.preview) {\n        URL.revokeObjectURL(fileObject.preview);\n      }\n\n\n      uploadedFiles.splice(fileIndex, 1);\n\n\n      const card =\n        document.getElementById(`file-${id}`);\n\n      if (card) card.remove();\n\n\n      updateInterface();\n    }\n\n\n\n    clearAllButton.addEventListener(\"click\", () => {\n\n      uploadedFiles.forEach(item => {\n        if (item.preview) {\n          URL.revokeObjectURL(item.preview);\n        }\n      });\n\n\n      uploadedFiles = [];\n\n      fileList.innerHTML = \"\";\n\n      hideError();\n\n      updateInterface();\n    });\n\n    function updateInterface() {\n\n      fileCounter.textContent =\n        uploadedFiles.length;\n\n\n      fileSection.classList.toggle(\n        \"hidden\",\n        uploadedFiles.length === 0\n      );\n\n\n      const allUploaded =\n        uploadedFiles.length > 0 &&\n        uploadedFiles.every(\n          file => file.status === \"uploaded\"\n        );\n\n\n      continueButton.disabled =\n        !allUploaded;\n    }\n\n\n\n    continueButton.addEventListener(\"click\", () => {\n\n      if (continueButton.disabled) return;\n\n\n      const originalContent =\n        continueButton.innerHTML;\n\n\n      continueButton.disabled = true;\n\n      continueButton.innerHTML = `\n        <svg\n          class=\"mr-2 h-4 w-4 animate-spin\"\n          fill=\"none\"\n          viewBox=\"0 0 24 24\"\n        >\n          <circle\n            class=\"opacity-25\"\n            cx=\"12\"\n            cy=\"12\"\n            r=\"10\"\n            stroke=\"currentColor\"\n            stroke-width=\"4\"\n          ></circle>\n\n          <path\n            class=\"opacity-75\"\n            fill=\"currentColor\"\n            d=\"M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z\"\n          ></path>\n        </svg>\n\n        Processing\n      `;\n\n\n      setTimeout(() => {\n\n        continueButton.innerHTML = `\n          <svg\n            class=\"mr-2 h-4 w-4\"\n            fill=\"none\"\n            viewBox=\"0 0 24 24\"\n            stroke=\"currentColor\"\n          >\n            <path\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"\n              stroke-width=\"2\"\n              d=\"M5 13l4 4L19 7\"\n            />\n          </svg>\n\n          Files ready\n        `;\n\n      }, 1200);\n    });\n\n\n    function showError(message) {\n      globalError.textContent = message;\n      globalError.classList.remove(\"hidden\");\n    }\n\n\n    function hideError() {\n      globalError.classList.add(\"hidden\");\n      globalError.textContent = \"\";\n    }\n\n\n    function generateId() {\n      return `${Date.now()}-${Math.random().toString(16).slice(2)}`;\n    }\n\n\n    function formatFileSize(bytes) {\n\n      if (bytes === 0) return \"0 B\";\n\n      const sizes = [\"B\", \"KB\", \"MB\", \"GB\"];\n\n      const index =\n        Math.floor(Math.log(bytes) / Math.log(1024));\n\n      return `${(bytes / Math.pow(1024, index)).toFixed(\n        index === 0 ? 0 : 1\n      )} ${sizes[index]}`;\n    }\n\n\n    function getExtension(fileName) {\n      return fileName.split(\".\").pop().toUpperCase();\n    }\n\n\n    function escapeHTML(value) {\n\n      return value\n        .replaceAll(\"&\", \"&amp;\")\n        .replaceAll(\"<\", \"&lt;\")\n        .replaceAll(\">\", \"&gt;\")\n        .replaceAll('\"', \"&quot;\")\n        .replaceAll(\"'\", \"&#039;\");\n    }\n\n  </script>"
  }
}
