      "content": "/**\n * Component: Drag &amp; Drop File Upload with Progress &amp; Image Preview\n * Author: @jugendra-gangwar (https://tailwindflex.com/@jugendra-gangwar)\n * Source: https://tailwindflex.com/@jugendra-gangwar/drag-drop-file-upload-with-progress-image-preview\n * Attribution: Créé par @jugendra-gangwar sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function DragDropFileUploadWithProgressImagePreview() {\n  return (\n    <div dangerouslySetInnerHTML={{ __html: \"<body class=\\\"min-h-screen bg-page text-ink\\\">\\n  <main class=\\\"flex min-h-screen items-center justify-center px-4 py-10 sm:px-6\\\">\\n\\n    <section class=\\\"w-full max-w-3xl rounded-[28px] border border-line bg-card p-5 shadow-card sm:p-8\\\">\\n\\n      <div class=\\\"flex flex-col gap-5 border-b border-line pb-7 sm:flex-row sm:items-start sm:justify-between\\\">\\n\\n        <div>\\n          <span class=\\\"inline-flex rounded-full bg-tealSoft px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-teal\\\">\\n            File upload\\n          </span>\\n\\n          <h1 class=\\\"mt-4 text-2xl font-semibold tracking-tight sm:text-3xl\\\">\\n            Upload project files\\n          </h1>\\n\\n          <p class=\\\"mt-2 max-w-xl text-sm leading-6 text-muted\\\">\\n            Drag and drop your documents or images below. You can upload multiple files and review them before submission.\\n          </p>\\n        </div>\\n\\n        <div class=\\\"shrink-0 rounded-xl border border-line bg-stoneSoft px-4 py-3 text-sm\\\">\\n          <span id=\\\"fileCounter\\\" class=\\\"font-semibold text-ink\\\">0</span>\\n          <span class=\\\"text-muted\\\"> / 6 files</span>\\n        </div>\\n\\n      </div>\\n\\n\\n      <div\\n        id=\\\"dropZone\\\"\\n        tabindex=\\\"0\\\"\\n        role=\\\"button\\\"\\n        aria-label=\\\"Upload files\\\"\\n        class=\\\"group mt-7 cursor-pointer rounded-2xl border-2 border-dashed border-line bg-stoneSoft px-5 py-10 text-center outline-none transition sm:px-8 sm:py-12\\\"\\n      >\\n\\n        <input\\n          id=\\\"fileInput\\\"\\n          type=\\\"file\\\"\\n          class=\\\"hidden\\\"\\n          multiple\\n          accept=\\\".png,.jpg,.jpeg,.pdf,.doc,.docx\\\"\\n        />\\n\\n        <div\\n          id=\\\"uploadIcon\\\"\\n          class=\\\"mx-auto flex h-14 w-14 items-center justify-center rounded-2xl border border-line bg-white text-teal shadow-sm transition group-hover:border-teal/30\\\"\\n        >\\n          <svg\\n            class=\\\"h-6 w-6\\\"\\n            fill=\\\"none\\\"\\n            viewBox=\\\"0 0 24 24\\\"\\n            stroke=\\\"currentColor\\\"\\n          >\\n            <path\\n              stroke-linecap=\\\"round\\\"\\n              stroke-linejoin=\\\"round\\\"\\n              stroke-width=\\\"1.8\\\"\\n              d=\\\"M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5M5 15.5v2.25A2.25 2.25 0 007.25 20h9.5A2.25 2.25 0 0019 17.75V15.5\\\"\\n            />\\n          </svg>\\n        </div>\\n\\n        <h2 class=\\\"mt-5 text-base font-semibold\\\">\\n          Drop files here\\n        </h2>\\n\\n        <p class=\\\"mt-1.5 text-sm text-muted\\\">\\n          or\\n          <span class=\\\"font-semibold text-teal\\\">\\n            browse from your device\\n          </span>\\n        </p>\\n\\n        <div class=\\\"mt-5 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-xs text-muted\\\">\\n          <span>PNG</span>\\n          <span class=\\\"h-1 w-1 rounded-full bg-slate-300\\\"></span>\\n          <span>JPG</span>\\n          <span class=\\\"h-1 w-1 rounded-full bg-slate-300\\\"></span>\\n          <span>PDF</span>\\n          <span class=\\\"h-1 w-1 rounded-full bg-slate-300\\\"></span>\\n          <span>DOC / DOCX</span>\\n          <span class=\\\"h-1 w-1 rounded-full bg-slate-300\\\"></span>\\n          <span>Max 8 MB</span>\\n        </div>\\n\\n      </div>\\n\\n\\n      <div\\n        id=\\\"globalError\\\"\\n        class=\\\"mt-4 hidden rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700\\\"\\n      ></div>\\n\\n\\n      <div id=\\\"fileSection\\\" class=\\\"mt-8 hidden\\\">\\n\\n        <div class=\\\"mb-4 flex items-center justify-between\\\">\\n\\n          <div>\\n            <h3 class=\\\"text-sm font-semibold\\\">\\n              Selected files\\n            </h3>\\n\\n            <p class=\\\"mt-1 text-xs text-muted\\\">\\n              Files will upload automatically.\\n            </p>\\n          </div>\\n\\n          <button\\n            id=\\\"clearAllButton\\\"\\n            type=\\\"button\\\"\\n            class=\\\"text-sm font-semibold text-muted transition hover:text-clay\\\"\\n          >\\n            Clear all\\n          </button>\\n\\n        </div>\\n\\n\\n        <div id=\\\"fileList\\\" class=\\\"space-y-3\\\"></div>\\n\\n      </div>\\n\\n\\n      <div class=\\\"mt-8 flex flex-col-reverse gap-3 border-t border-line pt-6 sm:flex-row sm:items-center sm:justify-between\\\">\\n\\n        <p class=\\\"flex items-center gap-2 text-xs text-muted\\\">\\n          <svg\\n            class=\\\"h-4 w-4\\\"\\n            fill=\\\"none\\\"\\n            viewBox=\\\"0 0 24 24\\\"\\n            stroke=\\\"currentColor\\\"\\n          >\\n            <path\\n              stroke-linecap=\\\"round\\\"\\n              stroke-linejoin=\\\"round\\\"\\n              stroke-width=\\\"1.7\\\"\\n              d=\\\"M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4\\\"\\n            />\\n          </svg>\\n\\n          Files are processed securely.\\n        </p>\\n\\n\\n        <button\\n          id=\\\"continueButton\\\"\\n          type=\\\"button\\\"\\n          disabled\\n          class=\\\"inline-flex items-center justify-center rounded-xl bg-ink px-6 py-3 text-sm font-semibold text-white transition hover:bg-black disabled:cursor-not-allowed disabled:opacity-35\\\"\\n        >\\n          Continue\\n\\n          <svg\\n            class=\\\"ml-2 h-4 w-4\\\"\\n            fill=\\\"none\\\"\\n            viewBox=\\\"0 0 24 24\\\"\\n            stroke=\\\"currentColor\\\"\\n          >\\n            <path\\n              stroke-linecap=\\\"round\\\"\\n              stroke-linejoin=\\\"round\\\"\\n              stroke-width=\\\"1.8\\\"\\n              d=\\\"M9 5l7 7-7 7\\\"\\n            />\\n          </svg>\\n        </button>\\n\\n      </div>\\n\\n    </section>\\n\\n  </main>\\n\\n\\n  \" }} />\n  );\n}\n",
      "type": "registry:ui"
    }
