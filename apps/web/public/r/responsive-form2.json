      "content": "/**\n * Component: Responsive Form2\n * Author: @abdulbast (https://tailwindflex.com/@abdulbast)\n * Source: https://tailwindflex.com/@abdulbast/responsive-form2\n * Attribution: Créé par @abdulbast sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function ResponsiveForm2() {\n  return (\n    <div>\n    <section className=\"bg-white mt-4 p-1 xs8\">\n      <div className=\" max-w-96 sm4xl mx-auto border border-[#4D7C0F] rounded-lg p-8\">\n        <h2 className=\"sm text-[12px] font-bold mb-6\">Description and Skills</h2>\n        <form>\n          <div className=\"space-y-6\">\n            <div className=\"job-description mb-[20px]\"><label htmlFor=\"job-desc\" className=\"block mb-[5px]\">Job Description</label>\n              <div className=\"text-editor-toolbar  border rounded-[5px] h-14 border-[#ccc] mb-[10px]\">\n                <button className=\"ml-3  sm[5px] sm5 sm4 bg-none  rounded-[3px]\">B</button><button className=\"ml-3  sm[5px] sm[5px_20px] bg-none rounded-[3px]\"><i>i</i></button><button className=\"ml-3 sm[5px] sm[5px_10px] bg-none  rounded-[3px]\"><u>U</u></button><button className=\"ml-3 sm[5px] sm[5px_20px] bg-none   rounded-[3px]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"1\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"lucide lucide-align-left\"><line x1=\"21\" x2=\"3\" y1=\"6\" y2=\"6\"></line><line x1=\"15\" x2=\"3\" y1=\"12\" y2=\"12\"></line><line x1=\"17\" x2=\"3\" y1=\"18\" y2=\"18\"></line></svg></button><button className=\"ml-3 mt-3 sm[5px] sm[3px_10px] bg-none  rounded-[3px]\"><svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" strokeWidth=\"1\" stroke=\"currentColor\" className=\"size-5 \"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M8.242 5.992h12m-12 6.003H20.24m-12 5.999h12M4.117 7.495v-3.75H2.99m1.125 3.75H2.99m1.125 0H5.24m-1.92 2.577a1.125 1.125 0 1 1 1.591 1.59l-1.83 1.83h2.16M2.99 15.745h1.125a1.125 1.125 0 0 1 0 2.25H3.74m0-.002h.375a1.125 1.125 0 0 1 0 2.25H2.99\"></path></svg></button><button className=\"ml-3 sm[5px] sm[5px_15px] bg-none text-lg  rounded-[3px]\">\"</button>\n              </div>\n              <textarea name=\"description\" style=\"resize\" id=\"job-desc\" className=\"w-full sm[150px] h-[120px] border border-[#4D7C0F] rounded-[5px] p-[10px]\"></textarea>\n            </div>\n            <div className=\"grid sm1 grid-cols-1 gap-6\">\n              <div><label htmlFor=\"skills\" className=\"text-xs xs font-medium text-gray-700 mb-1\">Required Skills</label>\n                <div className=\"flex flex-wrap items-center border rounded-md p-2 bg-white\">\n                  <span className=\"bg-[#D9F99D] text-[#4D7C0F] px-2 py-1 rounded m-1 text-sm flex items-center\">UI/UX<button className=\"ml-1 text-[#4D7C0F] focus\" type=\"button\">×</button></span><input type=\"text\" placeholder=\"Add skill\" className=\"flex-grow outline-none text-sm ml-2\" value=\"\" />\n                </div>\n              </div>\n            </div>\n          </div>\n          <div className=\"mt-8 pt-6 border-t border-gray-200 flex justify-between\">\n            <button className=\"hidden sm underline-offset-8\">back</button><button type=\"submit\" className=\" sm[86px] w-full h-[50px] text-xs sm bg-[#4D7C0F] rounded-[5px] p-[13px_25px] gap-[10px] text-white\">Next</button>\n          </div>\n        </form>\n      </div>\n    </section>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
