e:none\" id=\"job-desc\" class=\"w-full sm:h-[150px] h-[120px] border border-[#4D7C0F] rounded-[5px] p-[10px]\"></textarea>\n        </div>\n        <div class=\"grid sm:grid-cols-1 grid-cols-1 gap-6\">\n          <div><label for=\"skills\" class=\"text-xs xs:text-sm font-medium text-gray-700 mb-1\">Required Skills</label>\n            <div class=\"flex flex-wrap items-center border rounded-md p-2 bg-white\">\n              <span class=\"bg-[#D9F99D] text-[#4D7C0F] px-2 py-1 rounded m-1 text-sm flex items-center\">UI/UX<button class=\"ml-1 text-[#4D7C0F] focus:outline-none\" type=\"button\">×</button></span><input type=\"text\" placeholder=\"Add skill\" class=\"flex-grow outline-none text-sm ml-2\" value=\"\">\n            </div>\n          </div>\n        </div>\n      </div>\n      <div class=\"mt-8 pt-6 border-t border-gray-200 flex justify-between\">\n        <button class=\"hidden sm:block underline-offset-8\">back</button><button type=\"submit\" class=\" sm:w-[86px] w-full h-[50px] text-xs sm:text-base bg-[#4D7C0F] rounded-[5px] p-[13px_25px] gap-[10px] text-white\">Next</button>\n      </div>\n    </form>\n  </div>\n</section>"
