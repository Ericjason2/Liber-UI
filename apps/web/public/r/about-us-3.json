    "rawHtml": "<section class=\"relative bg-gradient-to-r from-purple-100 via-blue-100 to-green-100 py-16 px-8 overflow-hidden\">\n  <!-- SVG Pattern Background -->\n  <div class=\"absolute inset-0 w-full h-full -z-10\">\n    <svg class=\"w-full h-full\" viewBox=\"0 0 1440 800\" xmlns=\"http://www.w3.org/2000/svg\" preserveAspectRatio=\"none\">\n      <defs>\n        <pattern id=\"dots\" patternUnits=\"userSpaceOnUse\" width=\"40\" height=\"40\" patternTransform=\"rotate(45)\">\n          <circle cx=\"10\" cy=\"10\" r=\"2\" fill=\"#3B82F6\" opacity=\"0.1\" />\n        </pattern>\n      </defs>\n      <rect width=\"1440\" height=\"800\" fill=\"url(#dots)\" />\n    </svg>\n  </div>\n\n  <!-- Content Container -->\n  <div class=\"max-w-7xl mx-auto relative z-20 grid md:grid-cols-2 gap-12 items-center\">\n    <!-- Text Content -->\n    <div class=\"p-8 bg-white bg-opacity-90 rounded-xl shadow-lg backdrop-blur-lg hover:scale-105 transform transition duration-300 ease-in-out\">\n      <h2 class=\"text-4xl font-extrabold text-gray-800 mb-4\">About Us</h2>\n      <p class=\"text-gray-600 mb-6 text-lg\">\n        We craft innovative digital experiences that elevate your brand and inspire your audience. Our passionate team leverages creativity and cutting-edge technology to bring your vision to life with precision and style.\n      </p>\n      <div class=\"space-y-6\">\n        <!-- Card for each feature -->\n        <div class=\"flex items-center space-x-4 p-4 bg-gradient-to-tr from-purple-200 via-blue-200 to-green-200 rounded-lg shadow-md hover:shadow-xl transition-shadow duration-300\">\n          <div class=\"p-3 bg-white rounded-full shadow-lg hover:scale-110 transform transition duration-300\">\n            <!-- Icon: Users -->\n            <svg class=\"w-6 h-6 text-blue-600\" fill=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path d=\"M17 20v-2a4 4 0 00-4-4H9a4 4 0 00-4 4v2H17z\" />\n              <circle cx=\"12\" cy=\"8\" r=\"4\" />\n            </svg>\n          </div>\n          <div>\n            <h3 class=\"text-xl font-semibold text-gray-700\">Dedicated Team</h3>\n            <p class=\"text-gray-500 text-sm\">A passionate group of experts committed to delivering excellence in every project.</p>\n          </div>\n        </div>\n\n        <div class=\"flex items-center space-x-4 p-4 bg-gradient-to-tr from-purple-200 via-blue-200 to-green-200 rounded-lg shadow-md hover:shadow-xl transition-shadow duration-300\">\n          <div class=\"p-3 bg-white rounded-full shadow-lg hover:scale-110 transform transition duration-300\">\n            <!-- Icon: Lightbulb -->\n            <svg class=\"w-6 h-6 text-yellow-500\" fill=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path d=\"M9 21h6v-1H9v1zm3-18a4 4 0 00-4 4c0 1.38.56 2.63 1.46 3.54A5.978 5.978 0 009 12h6a5.978 5.978 0 00-1.46-3.46A4 4 0 0015 7a4 4 0 00-4-4z\" />\n            </svg>\n          </div>\n          <div>\n            <h3 class=\"text-xl font-semibold text-gray-700\">Innovative Approach</h3>\n            <p class=\"text-gray-500 text-sm\">We embrace creativity and technology to craft unique solutions tailored for you.</p>\n          </div>\n        </div>\n\n        <div class=\"flex items-center space-x-4 p-4 bg-gradient-to-tr from-purple-200 via-blue-200 to-green-200 rounded-lg shadow-md hover:shadow-xl transition-shadow duration-300\">\n          <div class=\"p-3 bg-white rounded-full shadow-lg hover:scale-110 transform transition duration-300\">\n            <!-- Icon: User Group -->\n            <svg class=\"w-6 h-6 text-green-600\" fill=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path d=\"M16 14c-1.33 0-2.53.53-3.41 1.39A4.993 4.993 0 0012 20c1.33 0 2.53-.53 3.41-1.39A4.993 4.993 0 0016 14zM8 14c-1.33 0-2.53.53-3.41 1.39A4.993 4.993 0 004 20c1.33 0 2.53-.53 3.41-1.39A4.993 4.993 0 008 14zM12 4c-2.21 0-4 1.79-4 4 0 1.66 1.34 3 3 3h2c1.66 0 3-1.34 3-3 0-2.21-1.79-4-4-4z\" />\n            </svg>\n          </div>\n          <div>\n            <h3 class=\"text-xl font-semibold text-gray-700\">Customer Centric</h3>\n            <p class=\"text-gray-500 text-sm\">Your satisfaction is our priority — we listen, adapt, and deliver beyond expectations.</p>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Image with Overlay & Hover Effect -->\n    <div class=\"relative p-4\">\n      <div class=\"absolute inset-0 bg-gradient-to-br from-purple-400 via-blue-400 to-green-400 rounded-xl shadow-lg transform hover:scale-105 transition-transform duration-300\"></div>\n      <img src=\"https://images.unsplash.com/photo-1506744038136-46273834b3fb?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80\" alt=\"About Us\" class=\"relative rounded-xl shadow-xl object-cover w-full h-full hover:opacity-90 transition-opacity duration-300\" />\n    </div>\n  </div>\n</section>"
