      "content": "import * as React from \"react\"\n\nfunction BasicAutoHidingNavbar({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"basic-auto-hiding-navbar\"\n      className={className}\n      {...props}\n    >\n      \n          <nav id=\"navbar\" className=\"fixed w-full bg-white/80 backdrop-blur-md shadow-md transition-transform duration-300 transform-gpu z-50\">\n              <div className=\"container mx-auto px-6 py-4 flex justify-between items-center\">\n                  \n                  <a href=\"#\" className=\"text-2xl font-bold text-gray-900 hover:text-blue-600 transition-colors\">BrandName</a>\n      \n                  \n                  <ul className=\"hidden md:flex space-x-6 text-gray-700 font-medium\">\n                      <li><a href=\"#\" className=\"hover:text-blue-500 transition-colors\">Home</a></li>\n                      <li><a href=\"#\" className=\"hover:text-blue-500 transition-colors\">About</a></li>\n                      <li><a href=\"#\" className=\"hover:text-blue-500 transition-colors\">Services</a></li>\n                      <li><a href=\"#\" className=\"hover:text-blue-500 transition-colors\">Contact</a></li>\n                  </ul>\n      \n                  \n                  <button id=\"menu-btn\" className=\"md:hidden flex items-center text-gray-700\">\n                      <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" strokeWidth=\"2\" stroke=\"currentColor\" className=\"w-6 h-6\">\n                          <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M4 6h16M4 12h16m-7 6h7\" />\n                      </svg>\n                  </button>\n              </div>\n      \n              \n              <div id=\"mobile-menu\" className=\"hidden bg-white md:hidden shadow-md\">\n                  <ul className=\"space-y-4 p-4 text-gray-700 font-medium\">\n                      <li><a href=\"#\" className=\"block hover:text-blue-500 transition-colors\">Home</a></li>\n                      <li><a href=\"#\" className=\"block hover:text-blue-500 transition-colors\">About</a></li>\n                      <li><a href=\"#\" className=\"block hover:text-blue-500 transition-colors\">Services</a></li>\n                      <li><a href=\"#\" className=\"block hover:text-blue-500 transition-colors\">Contact</a></li>\n                  </ul>\n              </div>\n          </nav>\n      \n          \n          <main className=\"pt-20 px-4\">\n              <div className=\"container mx-auto max-w-4xl\">\n                  <h1 className=\"text-4xl font-bold mb-6 text-gray-900\">Main Content</h1>\n                  <p className=\"mb-4 text-gray-600\">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vivamus lacinia nisi nec tortor scelerisque, et gravida urna faucibus.</p>\n                  <div className=\"h-[1000px] bg-gray-200 rounded-lg shadow-md p-6\">\n                      \n                      <p className=\"text-gray-600\">More content here to enable scrolling and ensure visibility of the navbar behavior.</p>\n                  </div>\n                  <div className=\"h-[1000px] bg-gray-200 rounded-lg shadow-md p-6\">\n                      \n                      <p className=\"text-gray-600\">More content here to enable scrolling and ensure visibility of the navbar behavior.</p>\n                  </div>\n              </div>\n          </main>\n    </div>\n  )\n}\n\nexport { BasicAutoHidingNavbar }\n",
      "type": "registry:ui"
    }
  ],
