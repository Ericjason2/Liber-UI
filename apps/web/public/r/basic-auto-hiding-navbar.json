ntColor\\\" class=\\\"w-6 h-6\\\">\\n                    <path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" d=\\\"M4 6h16M4 12h16m-7 6h7\\\" />\\n                </svg>\\n            </button>\\n        </div>\\n\\n        <!-- Mobile Menu -->\\n        <div id=\\\"mobile-menu\\\" class=\\\"hidden bg-white md:hidden shadow-md\\\">\\n            <ul class=\\\"space-y-4 p-4 text-gray-700 font-medium\\\">\\n                <li><a href=\\\"#\\\" class=\\\"block hover:text-blue-500 transition-colors\\\">Home</a></li>\\n                <li><a href=\\\"#\\\" class=\\\"block hover:text-blue-500 transition-colors\\\">About</a></li>\\n                <li><a href=\\\"#\\\" class=\\\"block hover:text-blue-500 transition-colors\\\">Services</a></li>\\n                <li><a href=\\\"#\\\" class=\\\"block hover:text-blue-500 transition-colors\\\">Contact</a></li>\\n            </ul>\\n        </div>\\n    </nav>\\n\\n    <!-- Main Content -->\\n    <main class=\\\"pt-20 px-4\\\">\\n        <div class=\\\"container mx-auto max-w-4xl\\\">\\n            <h1 class=\\\"text-4xl font-bold mb-6 text-gray-900\\\">Main Content</h1>\\n            <p class=\\\"mb-4 text-gray-600\\\">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vivamus lacinia nisi nec tortor scelerisque, et gravida urna faucibus.</p>\\n            <div class=\\\"h-[1000px] bg-gray-200 rounded-lg shadow-md p-6\\\">\\n                <!-- Add more content here to test scroll -->\\n                <p class=\\\"text-gray-600\\\">More content here to enable scrolling and ensure visibility of the navbar behavior.</p>\\n            </div>\\n            <div class=\\\"h-[1000px] bg-gray-200 rounded-lg shadow-md p-6\\\">\\n                <!-- Add more content here to test scroll -->\\n                <p class=\\\"text-gray-600\\\">More content here to enable scrolling and ensure visibility of the navbar behavior.</p>\\n            </div>\\n        </div>\\n    </main>\\n\\n    \\n\\n</body>\\n</html>\" }} />\n  );\n}\n",
