      "content": "import * as React from \"react\"\n\nfunction TiltedButtonOnHover2({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"tilted-button-on-hover-2\"\n      className={className}\n      {...props}\n    >\n      <div className=\"bg-white dark:bg-gray-800 flex justify-center items-center w-screen h-screen p-5\">\n        <button\n              className=\"inline-flex items-center justify-center px-8 py-2\n                text-lg font-bold text-white\n                bg-gradient-to-r from-indigo-500 to-indigo-700\n                dark:from-indigo-500 dark:to-indigo-700\n                rounded-3xl\n                drop-shadow-md\n                transform-gpu\n                hover:rotate-[2deg] hover:scale-110\n                hover:skew-x-1\n                transition-all duration-300\n                shadow-lg hover:shadow-3xl will-change-transform\"\n          >\n              <span className=\"uppercase text-xs will-change-transform\">\n                Hover to tilt!\n              </span>\n        </button>\n      </div>\n    </div>\n  )\n}\n\nexport { TiltedButtonOnHover2 }\n",
      "type": "registry:ui"
    }
  ],
