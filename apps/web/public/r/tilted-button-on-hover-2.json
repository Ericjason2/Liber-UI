      "content": "/**\n * Component: Tilted button on hover.\n * Author: @bansheetech (https://tailwindflex.com/@bansheetech)\n * Source: https://tailwindflex.com/@bansheetech/tilted-button-on-hover-2\n * Attribution: Créé par @bansheetech sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function TiltedButtonOnHover2() {\n  return (\n    <div>\n    <div className=\"bg-white dark800 flex justify-center items-center w-screen h-screen p-5\">\n      <button\n            className=\"inline-flex items-center justify-center px-8 py-2\n              text-lg font-bold text-white\n              bg-gradient-to-r from-indigo-500 to-indigo-700\n              dark500 dark700\n              rounded-3xl\n              drop-shadow-md\n              transform-gpu\n              hover[2deg] hover110\n              hover1\n              transition-all duration-300\n              shadow-lg hover3xl will-change-transform\"\n        >\n            <span className=\"uppercase text-xs will-change-transform\">\n              Hover to tilt!\n            </span>\n      </button>\n    </div>\n    </div>\n  );\n}\n",
