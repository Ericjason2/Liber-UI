      "content": "/**\n * Component: Pricing section - Htmlwind\n * Author: @htmlwind (https://tailwindflex.com/@htmlwind)\n * Source: https://tailwindflex.com/@htmlwind/pricing-section-htmlwind\n * Attribution: Créé par @htmlwind sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function PricingSectionHtmlwind() {\n  return (\n    <div>\n    <div className=\"bg-white py-24 sm32\">\n      <div className=\"mx-auto max-w-7xl px-6 lg8\">\n        <div className=\"mx-auto max-w-4xl text-center\">\n          <h2 className=\"text-4xl font-semibold tracking-tight text-gray-900 sm5xl\">Pricing plan</h2>\n          <p className=\"mx-auto mt-6 w-full max-w-2xl text-pretty text-xl leading-8 text-gray-600\">Select from best plans, ensuring a perfect match. Need more or less? Customize your subscription for a seamless fit!</p>\n        </div>\n        <div className=\"mx-auto mt-16 max-w-2xl rounded-3xl ring-1 ring-gray-200 sm20 lg0 lg lg lg lg20 lg0\">\n          <div className=\"p-2 lg lg lg0 lg0\">\n            <div className=\"rounded-2xl bg-gray-50 py-10 text-center ring-1 ring-inset ring-gray-900/5 lg16\">\n              <div className=\"mx-auto max-w-xs px-8\">\n                <p className=\"text-5xl font-semibold tracking-tight text-gray-900\">$49.99</p>\n                <h3 id=\"package-premium\" className=\"mt-4 text-lg font-medium text-gray-900\">Premium package</h3>\n                <div className=\"mt-8 h-px bg-gray-900/5\"></div>\n                <p className=\"mt-8 text-sm leading-6 text-gray-600\">Empowering your brand with standout visuals that leave an impact</p>\n                <a href=\"#\" aria-describedby=\"package-premium\" className=\"mt-8 block rounded-md bg-pink-500 px-3 py-2.5 text-center text-base font-medium tracking-tight text-white shadow-sm hover400 focus-visible focus-visible2 focus-visible2 focus-visible500\">Get started</a>\n              </div>\n            </div>\n          </div>\n          <div className=\"-mt-2 p-8 sm10 lg0 lg lg0\">\n            <p className=\"text-4xl font-semibold tracking-tight text-gray-900\">Process</p>\n            <p className=\"mt-2 text-sm leading-6 text-gray-600\">Lorem ipsum dolor sit amet, consectetur adipiscing elit</p>\n            <ul className=\"mt-10 *:border-b *:border-gray-100 *:py-6\">\n              <li className=\"flex gap-x-3 first0 last0 last0 sm6\">\n                <svg className=\"mt-2 h-5 w-5 flex-none text-pink-500\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\">\n                  <g id=\"Complete\">\n                    <g id=\"tick\">\n                      <polyline fill=\"none\" points=\"3.7 14.3 9.6 19 20.3 5\" stroke=\"currentColor\" strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\"></polyline>\n                    </g>\n                  </g>\n                </svg>\n                <p className=\"text-sm leading-6 text-gray-600\">\n                  <span className=\"font-semibold text-gray-900\">Discovery Session</span>\n                  – We delve deep into understanding your brand’s core values, goals, and target audience. Our aim is to align your brand’s identity with its visual representation.\n                </p>\n              </li>\n              <li className=\"flex gap-x-3 first0 last0 last0 sm6\">\n                <svg className=\"mt-2 h-5 w-5 flex-none text-pink-500\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\">\n                  <g id=\"Complete\">\n                    <g id=\"tick\">\n                      <polyline fill=\"none\" points=\"3.7 14.3 9.6 19 20.3 5\" stroke=\"currentColor\" strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\"></polyline>\n                    </g>\n                  </g>\n                </svg>\n                <p className=\"text-sm leading-6 text-gray-600\">\n                  <span className=\"font-semibold text-gray-900\">Custom Design Concepts</span>\n                  – Receive three unique design concepts tailored to your brand, with opportunities for refinement and feedback to ensure the perfect fit.\n                </p>\n              </li>\n              <li className=\"flex gap-x-3 first0 last0 last0 sm6\">\n                <svg className=\"mt-2 h-5 w-5 flex-none text-pink-500\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\">\n                  <g id=\"Complete\">\n                    <g id=\"tick\">\n                      <polyline fill=\"none\" points=\"3.7 14.3 9.6 19 20.3 5\" stroke=\"currentColor\" strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\"></polyline>\n                    </g>\n                  </g>\n                </svg>\n                <p className=\"text-sm leading-6 text-gray-600\">\n                  <span className=\"font-semibold text-gray-900\">Deliverables</span>\n                  – All final design files will be provided, including various formats suitable for both digital and print use. We ensure your brand assets are ready for immediate implementation.\n                </p>\n              </li>\n            </ul>\n          </div>\n        </div>\n      </div>\n    </div>\n    </div>\n  );\n}\n",
