      "content": "/**\n * Component: Simple login page template\n * Author: @freja-jensen (https://tailwindflex.com/@freja-jensen)\n * Source: https://tailwindflex.com/@freja-jensen/simple-login-page-template\n * Attribution: Créé par @freja-jensen sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function SimpleLoginPageTemplate() {\n  return (\n    <div>\n    <div className=\"h-screen bg-gray-200 py-20 p-4 md20 lg32\">\n        <div className=\"max-w-sm bg-white rounded-lg overflow-hidden shadow-lg mx-auto\">\n            <div className=\"p-6\">\n                <h2 className=\"text-2xl font-bold text-gray-800 mb-2\">Welcome Back!</h2>\n                <p className=\"text-gray-700 mb-6\">Please sign in to your account</p>\n                <form>\n                    <div className=\"mb-4\">\n                        <label className=\"block text-gray-700 font-bold mb-2\" htmlFor=\"username\">\n                Username\n              </label>\n                        <input className=\"shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus focus\" id=\"username\" type=\"text\" placeholder=\"Username\" />\n                    </div>\n                    <div className=\"mb-6\">\n                        <label className=\"block text-gray-700 font-bold mb-2\" htmlFor=\"password\">\n                Password\n              </label>\n                        <input className=\"shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus focus\" id=\"password\" type=\"password\" placeholder=\"Password\" />\n                    </div>\n                    <div className=\"flex items-center justify-between\">\n                        <button className=\"bg-blue-500 hover700 text-white font-bold py-2 px-4 rounded focus focus\" type=\"button\">\n                Sign In\n              </button>\n                        <a className=\"inline-block align-baseline font-bold text-sm text-blue-500 hover800\" href=\"#\">\n                            Forgot Password?\n                        </a>\n                    </div>\n                </form>\n            </div>\n        </div>\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
  ],
