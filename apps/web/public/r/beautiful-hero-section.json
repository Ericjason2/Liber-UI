      "content": "/**\n * Component: Beautiful Hero Section\n * Author: @brandon (https://tailwindflex.com/@brandon)\n * Source: https://tailwindflex.com/@brandon/beautiful-hero-section\n * Attribution: Créé par @brandon sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function BeautifulHeroSection() {\n  return (\n    <div>\n    \r\n    \r\n    \r\n    <div className=\"relative flex flex-col items-center mx-auto lg lg5xl lg12 xl6xl\">\r\n    \r\n        \r\n        <div className=\"w-full h-64 lg1/2 lg\">\r\n            <img className=\"h-full w-full object-cover\" src=\"https://picsum.photos/id/1018/2000\" alt=\"Winding mountain road\" />\r\n        </div>\r\n        \r\n    \r\n        \r\n        <div\r\n            className=\"max-w-lg bg-white md2xl md10 md md md0 md48 lg3/5 lg0 lg20 lg20 xl24 xl12\">\r\n            \r\n            <div className=\"flex flex-col p-12 md16\">\r\n                <h2 className=\"text-2xl font-medium uppercase text-green-800 lg4xl\">Winding Mountain Road</h2>\r\n                <p className=\"mt-4\">\r\n                    Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et\r\n                    dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip\r\n                    ex ea commodo consequat.\r\n                </p>\r\n                \r\n                <div className=\"mt-8\">\r\n                    <a href=\"#\"\r\n                        className=\"inline-block w-full text-center text-lg font-medium text-gray-100 bg-green-600 border-solid border-2 border-gray-600 py-4 px-10 hover800 hover md48\">Read\r\n                        More</a>\r\n                </div>\r\n            </div>\r\n            \r\n        </div>\r\n        \r\n    \r\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
