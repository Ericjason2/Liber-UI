    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\" data-theme=\"light\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Profile UI - ApexCodeStudios.com</title>\n\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <link href=\"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css\" rel=\"stylesheet\">\n\n    <script>\n        tailwind.config = {\n            content: [],\n            theme: {\n                extend: {\n                    fontFamily: {\n                        sans: ['Inter', 'sans-serif']\n                    }\n                }\n            }\n        }\n    </script>\n\n    <style>\n        :root {\n            --header-gradient: linear-gradient(45deg, #ff9a9e 0%, #fad0c4 99%, #fad0c4 100%);\n        }\n\n        [data-theme=\"dark\"] {\n            --bg-body: #0b0e14;\n            --bg-card: #1a1d23;\n            --border-custom: #334155;\n            --text-main: #f1f5f9;\n        }\n\n        [data-theme=\"light\"] {\n            --bg-body: #f8fafc;\n            --bg-card: #ffffff;\n            --border-custom: #e2e8f0;\n            --text-main: #1e293b;\n        }\n\n        body {\n            font-family: 'Inter', sans-serif;\n            background-color: var(--bg-body);\n            color: var(--text-main);\n        }\n        .badge-skill {\n            background-color: #fef2f2;\n            color: #451a03;\n            border-radius: 12px;\n            padding: 8px 16px;\n            font-weight: 500;\n            font-size: 0.85rem;\n            margin-bottom: 8px;\n        }\n    </style>\n</head>\n<body class=\"min-h-screen flex items-center justify-center p-6\">\n\n    <!-- Theme Toggle -->\n    <button onclick=\"toggleTheme()\" \n            id=\"themeBtn\"\n            class=\"fixed top-6 right-6 z-50 px-4 py-2 bg-[var(--bg-card)] border border-gray-200 dark:border-gray-700 rounded-full flex items-center gap-2 shadow-lg hover:scale-105 transition-all\">\n        <i id=\"theme-icon\" class=\"bi bi-moon-stars-fill\"></i>\n        <span class=\"text-sm font-medium\">Switch Theme</span>\n    </button>\n\n    <div class=\"w-full max-w-[900px]\">\n\n        <!-- Profile Card -->\n        <div class=\"profile-card bg-[var(--bg-card)] rounded-3xl overflow-hidden shadow-2xl\">\n\n            <!-- Banner -->\n            <div class=\"banner-container h-56 relative\" style=\"background: url('https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=1000&auto=format&fit=crop') center/cover;\">\n                <button class=\"edit-banner-btn absolute top-6 right-6 bg-white p-3 rounded-2xl shadow-md hover:bg-gray-100 transition-all\">\n                    <i class=\"bi bi-pencil-square text-xl\"></i>\n                </button>\n            </div>\n\n            <!-- Profile Image -->\n            <div class=\"profile-img-wrapper -mt-16 ml-10 relative z-10 inline-block\">\n                <img src=\"https://images.unsplash.com/photo-1531123897727-8f129e1688ce?q=80&w=800&auto=format&fit=crop\" \n                     alt=\"Emma Smith\" \n                     class=\"profile-image w-40 h-40 rounded-full border-4 border-white object-cover shadow-xl\">\n            </div>\n\n            <div class=\"px-8 pb-8 pt-6\">\n                <div class=\"flex flex-wrap items-end gap-8\">\n                    <!-- Left Info -->\n                    <div class=\"flex-1\">\n                        <h2 class=\"text-4xl font-bold\">Emma Smith</h2>\n                        <p class=\"text-gray-500 text-lg\">Software Engineer</p>\n                        <p class=\"text-gray-500 flex items-center gap-2 mt-1\"><i class=\"bi bi-geo-alt\"></i> Los Angeles, California</p>\n                        \n                        <div class=\"flex gap-3 mt-6\">\n                            <button class=\"btn-action border border-gray-300 dark:border-gray-600 px-6 py-3 rounded-3xl font-semibold hover:bg-gray-100 dark:hover:bg-gray-800 transition-all\">Edit Profile</button>\n                            <button class=\"btn-action border border-gray-300 dark:border-gray-600 px-6 py-3 rounded-3xl font-semibold hover:bg-gray-100 dark:hover:bg-gray-800 transition-all\">Settings</button>\n                        </div>\n                    </div>\n\n                    <!-- Right Info -->\n                    <div class=\"text-right\">\n                        <div class=\"mb-6\">\n                            <p class=\"text-sm text-gray-500 mb-2\">Current role</p>\n                            <span class=\"badge bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-white border px-4 py-2 rounded-3xl font-semibold\">Software Engineer</span>\n                        </div>\n                        <div>\n                            <p class=\"text-sm text-gray-500 mb-3\">Skills</p>\n                            <div class=\"flex flex-wrap justify-end gap-2\">\n                                <span class=\"badge-skill\">HTML</span>\n                                <span class=\"badge-skill\">CSS</span>\n                                <span class=\"badge-skill\">Dart</span>\n                                <span class=\"badge-skill\">C++</span>\n                                <span class=\"badge-skill\">UI Design</span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Info Boxes -->\n                <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4 mt-12\">\n                    <a href=\"#\" class=\"info-box bg-[var(--info-card-bg)] border border-[var(--border-custom)] rounded-3xl p-6 hover:shadow-lg transition-all\">\n                        <div class=\"flex justify-between items-start\">\n                            <div>\n                                <h6 class=\"font-bold\">Ready for work</h6>\n                                <p class=\"text-sm text-gray-500 mt-2\">Show recruiters that you're ready for work.</p>\n                            </div>\n                            <div class=\"icon-circle w-9 h-9 p-5 border-2 border-blue-600 text-blue-600 rounded-full flex items-center justify-center\">\n                                →\n                            </div>\n                        </div>\n                    </a>\n\n                    <a href=\"#\" class=\"info-box bg-[var(--info-card-bg)] border border-[var(--border-custom)] rounded-3xl p-6 hover:shadow-lg transition-all\">\n                        <div class=\"flex justify-between items-start\">\n                            <div>\n                                <h6 class=\"font-bold\">Share posts</h6>\n                                <p class=\"text-sm text-gray-500 mt-2\">Share latest news to get connected with others.</p>\n                            </div>\n                            <div class=\"icon-circle w-9 h-9 p-5 border-2 border-blue-600 text-blue-600 rounded-full flex items-center justify-center\">\n                                →\n                            </div>\n                        </div>\n                    </a>\n\n                    <a href=\"#\" class=\"info-box bg-[var(--info-card-bg)] border border-[var(--border-custom)] rounded-3xl p-6 hover:shadow-lg transition-all\">\n                        <div class=\"flex justify-between items-start\">\n                            <div>\n                                <h6 class=\"font-bold\">Update</h6>\n                                <p class=\"text-sm text-gray-500 mt-2\">Keep your profile updated so recruiters know you better.</p>\n                            </div>\n                            <div class=\"icon-circle w-9 h-9 p-5 border-2 border-blue-600 text-blue-600 rounded-full flex items-center justify-center\">\n                                →\n                            </div>\n                        </div>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <script>\n        function toggleTheme() {\n            const html = document.documentElement;\n            const icon = document.getElementById('theme-icon');\n            \n            if (html.getAttribute('data-theme') === 'light') {\n                html.setAttribute('data-theme', 'dark');\n                icon.classList.remove('bi-moon-stars-fill');\n                icon.classList.add('bi-sun-fill');\n            } else {\n                html.setAttribute('data-theme', 'light');\n                icon.classList.remove('bi-sun-fill');\n                icon.classList.add('bi-moon-stars-fill');\n            }\n        }\n    </script>\n</body>\n</html>"
