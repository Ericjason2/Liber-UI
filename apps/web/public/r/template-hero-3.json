    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Brixora Clone</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        body { font-family: 'Inter', sans-serif; }\n    </style>\n</head>\n<body class=\"bg-white min-h-screen\">\n\n    <nav class=\"w-full max-w-[1400px] mx-auto flex justify-between items-center py-6 px-6 lg:px-12\">\n        <div class=\"text-2xl font-bold tracking-tight text-gray-900\">\n            Brixora®\n        </div>\n\n        <div class=\"hidden md:flex gap-8 text-gray-600 font-medium\">\n            <a href=\"#\" class=\"hover:text-black transition\">Home</a>\n            <a href=\"#\" class=\"hover:text-black transition\">About us</a>\n            <a href=\"#\" class=\"hover:text-black transition\">Services</a>\n            <a href=\"#\" class=\"hover:text-black transition\">Projects</a>\n            <a href=\"#\" class=\"hover:text-black transition\">Blogs</a>\n        </div>\n\n        <button class=\"bg-[#1e293b] text-white px-6 py-2.5 rounded-full font-medium hover:bg-black transition\">\n            Contact us\n        </button>\n    </nav>\n\n    <main class=\"max-w-[1400px] mx-auto px-6 lg:px-12 mt-8 lg:mt-16 pb-20\">\n        <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center\">\n            \n            <div class=\"flex flex-col items-start relative\">\n                \n                <div class=\"flex items-center gap-2 mb-6\">\n                    <div class=\"flex text-orange-400 text-lg\">\n                        ★ ★ ★ ★ ★\n                    </div>\n                    <span class=\"font-bold text-gray-900 ml-1\">4.9 / 5</span>\n                    <span class=\"text-gray-500 text-sm font-medium\">18K+ Reviews</span>\n                </div>\n\n                <h1 class=\"text-5xl lg:text-7xl font-bold text-gray-900 leading-[1.1] tracking-tight mb-6\">\n                    Shaping spaces<br>\n                    that inspire living\n                </h1>\n\n                <p class=\"text-gray-500 text-lg leading-relaxed max-w-md mb-8\">\n                    We design modern environments that blend comfort, beauty, timeless functionality, and enduring elegance.\n                </p>\n\n                <div class=\"flex items-center gap-6 mb-16\">\n                    <button class=\"bg-[#1e293b] text-white px-8 py-3.5 rounded-full font-medium hover:bg-black transition\">\n                        Contact Us\n                    </button>\n                    <button class=\"flex items-center gap-2 text-gray-900 font-medium hover:gap-3 transition-all\">\n                        Watch video \n                        <span>→</span>\n                    </button>\n                </div>\n\n                <div class=\"bg-white border border-gray-100 shadow-[0_8px_30px_rgb(0,0,0,0.06)] rounded-2xl p-4 flex gap-4 items-center max-w-sm w-full\">\n                    <img src=\"https://images.unsplash.com/photo-1580489944761-15a19d654956?q=80&w=200&auto=format&fit=crop\" \n                         alt=\"Sarah Johnson\" \n                         class=\"w-16 h-16 rounded-xl object-cover\">\n                    <div>\n                        <div class=\"flex text-orange-400 text-sm mb-1\">★ ★ ★ ★ ★ <span class=\"text-gray-400 ml-1 text-xs\">4.9</span></div>\n                        <h4 class=\"font-bold text-gray-900 text-sm\">Sarah Johnson</h4>\n                        <p class=\"text-gray-400 text-xs\">Customers</p>\n                    </div>\n                </div>\n\n            </div>\n\n            <div class=\"relative\">\n                <div class=\"relative w-full aspect-[4/3] rounded-[40px] overflow-hidden\">\n                    <img src=\"https://images.unsplash.com/photo-1504307651254-35680f356dfd?q=80&w=2000&auto=format&fit=crop\" \n                         alt=\"Construction Site\" \n                         class=\"w-full h-full object-cover\">\n                </div>\n\n                <div class=\"absolute bottom-8 left-8 bg-white p-6 rounded-3xl shadow-2xl max-w-[280px] w-full\">\n                    <h3 class=\"font-bold text-gray-900 mb-4\">Our verified Experts</h3>\n                    \n                    <div class=\"flex flex-col gap-4\">\n                        <div class=\"flex items-center gap-3\">\n                            <img src=\"https://images.unsplash.com/photo-1560250097-0b93528c311a?q=80&w=100&auto=format&fit=crop\" class=\"w-10 h-10 rounded-full object-cover\" alt=\"James\">\n                            <div>\n                                <p class=\"text-sm font-bold text-gray-900 leading-none\">James Anderson</p>\n                                <p class=\"text-xs text-gray-500 mt-0.5\">Project Manager</p>\n                            </div>\n                        </div>\n                        <div class=\"flex items-center gap-3\">\n                            <img src=\"https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?q=80&w=100&auto=format&fit=crop\" class=\"w-10 h-10 rounded-full object-cover\" alt=\"Olivia\">\n                            <div>\n                                <p class=\"text-sm font-bold text-gray-900 leading-none\">Olivia Thompson</p>\n                                <p class=\"text-xs text-gray-500 mt-0.5\">Lead Architect</p>\n                            </div>\n                        </div>\n                        <div class=\"flex items-center gap-3\">\n                            <img src=\"https://images.unsplash.com/photo-1619895862022-09114b41f16f?q=80&w=100&auto=format&fit=crop\" class=\"w-10 h-10 rounded-full object-cover\" alt=\"Isabella\">\n                            <div>\n                                <p class=\"text-sm font-bold text-gray-900 leading-none\">Isabella Clark</p>\n                                <p class=\"text-xs text-gray-500 mt-0.5\">Interior Designer</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n        </div>\n    </main>\n\n</body>\n</html>"
