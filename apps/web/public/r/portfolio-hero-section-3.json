      "content": "/**\n * Component: Portfolio Hero Section 3\n * Author: @sammytg7 (https://tailwindflex.com/@sammytg7)\n * Source: https://tailwindflex.com/@sammytg7/portfolio-hero-section-3\n * Attribution: Créé par @sammytg7 sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function PortfolioHeroSection3() {\n  return (\n    <div>\n    <div className=\"w-full h-screen bg-black\">\n        <header className=\"lg16 px-4 flex flex-wrap items-center py-4 shadow-lg\">\n            <div className=\"flex-1 flex justify-between items-center\">\n                <img className=\"sm[10rem] w-[7rem] z-10\" src=\"https://techakim.com/sam/tg/7268/li/imgs/samlogo2.png\" alt=\"Logo\" />\n            </div>\n            <label htmlFor=\"menu-toggle\" className=\"pointer-cursor md block\">\n                <svg className=\"fill-current text-gray-200\" xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 20 20\">\n                <title>menu</title>\n                <path d=\"M0 3h20v2H0V3zm0 6h20v2H0V9zm0 6h20v2H0v-2z\"></path>\n                </svg>\n                </label>\n            <input className=\"hidden\" type=\"checkbox\" id=\"menu-toggle\" />\n    \n            <div className=\"hidden md md md w-full z-10\" id=\"menu\">\n                <nav>\n                    <ul className=\"md items-center justify-between text-base xl text-gray-100 pt-4 md0\">\n                        <li><a className=\"md4 py-3 px-0 block text-rose-500 hover500\" href=\"#\">Home</a></li>\n                        <li><a className=\"md4 py-3 px-0 block hover500\" href=\"#\">About Me</a></li>\n                        <li><a className=\"md4 py-3 px-0 block hover500\" href=\"#\">Education</a></li>\n                        <li><a className=\"md4 py-3 px-0 block hover500\" href=\"#\">Experience</a></li>\n                        <li><a className=\"md4 py-3 px-0 block hover500\" href=\"#\">Projects</a></li>\n                        <li><a className=\"md4 py-3 px-0 block hover500 md0 mb-2\" href=\"#\">Contact</a></li>\n                    </ul>\n                </nav>\n            </div>\n        </header>\n    \n        \n        <div\n            className=\"absolute hidden sm md16 sm[8%] top-[10%] xl4 xl[30%] lg[35%] md[20%] sm[18%] left-[10%] overflow-hidden\">\n            <img className=\"2xl[760px] xl[600px] md[450px] sm[480px]\" src=\"https://techakim.com/sam/tg/7268/li/imgs/2.png\" alt=\"Image\" />\n        </div>\n    \n        \n        <div className=\"lg16 px-4 pb-4 h-full flex flex-col sm sm mt-10 sm0 text-white\">\n            \n            <div className=\"w-full flex flex-col z-10\">\n                <h4 className=\"text-lg font-semibold text-white xl2xl\">Hey There</h4>\n                <h1 className=\"2xl8xl md6xl sm4xl text-3xl font-semibold font-serif mt-2\">I'm\n                    <span className=\"\">Samuel</span>\n                </h1>\n                <h1 className=\"md6xl sm4xl text-3xl font-semibold font-serif\">Abera</h1>\n                <h4 className=\"text-rose-500 mt-4 lg2xl xl:3xl\">--FullStack Developer</h4>\n    \n                <p className=\"lg[70%] w-full text-white text-md mt-4 md 2xl2xl\">Experienced full-stack developer with 4+\n                    years\n                    of expertise in Laravel, NestJS, Nuxt.js, Next.js, Android, and some Flutter experience.</p>\n    \n                <div>\n                    <button className=\"mt-6 px-6 py-1 bg-rose-500 text-lg text-white rounded-sm lg2xl\">Get In Touch</button>\n                </div>\n            </div>\n    \n            \n            <div\n                className=\"w-full flex sm justify-center mt-4 sm0 sm8 gap-2 bg-gray-700/60 sm p-4 rounded-lg z-10\">\n                <div className=\"flex flex-col sm items-center\">\n                    <div className=\"inline-flex gap-1 items-center\">\n                        <h2 className=\"xl8xl md6xl sm4xl text-3xl font-semibold\">5</h2>\n                        <h2 className=\"text-rose-500 xl6xl md7xl sm4xl text-3xl font-extrabold\">+</h2>\n                    </div>\n                    <h4 className=\"text-sm sm xl2xl text-center\">Years of Expireance</h4>\n                </div>\n                <div className=\"flex flex-col sm items-center\">\n                    <div className=\"inline-flex gap-1 items-center\">\n                        <h2 className=\"xl8xl md6xl sm4xl text-3xl font-semibold\">55</h2>\n                        <h2 className=\"text-rose-500 xl8xl md6xl sm4xl text-3xl font-extrabold\">+</h2>\n                    </div>\n                    <h4 className=\"text-sm sm xl2xl text-center\">Component Contribution</h4>\n                </div>\n                <div className=\"flex flex-col sm items-center\">\n                    <div className=\"inline-flex gap-1 items-center\">\n                        <h2 className=\"xl8xl md6xl sm4xl text-3xl font-semibold\">127K</h2>\n                        <h2 className=\"text-rose-500 xl8xl md6xl sm4xl text-3xl font-extrabold\">+</h2>\n                    </div>\n                    <h4 className=\"text-sm sm xl2xl text-center\">User's Got Help</h4>\n                </div>\n            </div>\n        </div>\n    \n    </div>\n    </div>\n  );\n}\n",
