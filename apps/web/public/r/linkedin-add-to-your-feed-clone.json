rk400\">Airlines and Aviation</h6>\n                        \n                        <div className=\"w-fit px-3 flex justify-center items-center border border-black my-2 rounded-full dark200 dark\">\n                            <span className=\"material-symbols-outlined\">add</span>\n                            <h5 className=\"\">Follow</h5>\n                        </div>\n                    </div>\n                </div>\n    \n                <div className=\"w-full flex gap-2 px-2\">\n                    <img src=\"https://images.unsplash.com/photo-1533636721434-0e2d61030955?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w0NzEyNjZ8MHwxfHNlYXJjaHw1fHxibGFjayUyMHByb2ZpbGUlMjBpbWFnZXxlbnwwfDB8fHwxNzEzNTMwNjg5fDA&ixlib=rb-4.0.3&q=80&w=1080\" alt=\"User profile\" className=\"w-[3.4rem] h-[3.4rem] rounded-full\" />\n                    <div className=\"flex flex-col\">\n                        <h4 className=\"text-md text-gray-800 font-semibold dark200\">Eyasu Abera</h4>\n                        <h6 className=\"text-sm text-gray-600 dark400\">System Administrator</h6>\n                        \n                        <div className=\"w-fit px-3 flex justify-center items-center border border-black my-2 rounded-full dark200 dark\">\n                            <i className=\"fa fa-lock\" aria-hidden=\"true\"></i>\n                            <h5 className=\"pl-1\">Message</h5>\n                        </div>\n                    </div>\n                </div>\n    \n                <div className=\"w-full flex gap-2 px-2\">\n                    <img src=\"https://images.unsplash.com/photo-1678483790053-71367bc7a02c?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w0NzEyNjZ8MHwxfHNlYXJjaHw5fHxnb29nbGUlMjBsb2dvfGVufDB8MHx8fDE3MzIyNTc3MTF8MA&ixlib=rb-4.0.3&q=80&w=1080\" alt=\"User profile\" className=\"w-[3.4rem] h-[3.4rem] rounded-full\" />\n                    <div className=\"flex flex-col\">\n                        <h4 className=\"text-md text-gray-800 font-semibold dark200\">Google</h4>\n                        <h6 className=\"text-sm text-gray-600 dark400\">Software Development</h6>\n                        \n                        <div className=\"w-fit px-3 flex justify-center items-center border border-black my-2 rounded-full dark200 dark\">\n                            <span className=\"material-symbols-outlined\">add</span>\n                            <h5 className=\"\">Follow</h5>\n                        </div>\n                    </div>\n                </div>\n    \n                <div className=\"w-full flex gap-1 px-4 pb-2 \">\n                    <h6 className=\"text-md text-gray-600 dark400\">View all recommendations</h6>\n                    <span className=\"material-symbols-outlined dark300\">arrow_right_alt</span>\n                </div>\n            </div>\n        </div>    \n    </div>\n    </div>\n  );\n}\n",
