    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>LuxChair | Premium Seating Solutions</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n    <script>\n        tailwind.config = {\n            theme: {\n                extend: {\n                    animation: {\n                        'float': 'float 6s ease-in-out infinite',\n                        'fade-in': 'fadeIn 1s ease-out forwards',\n                        'slide-up': 'slideUp 0.8s ease-out forwards',\n                        'pulse-slow': 'pulse 3s infinite'\n                    },\n                    keyframes: {\n                        float: {\n                            '0%, 100%': { transform: 'translateY(0)' },\n                            '50%': { transform: 'translateY(-15px)' }\n                        },\n                        fadeIn: {\n                            '0%': { opacity: '0' },\n                            '100%': { opacity: '1' }\n                        },\n                        slideUp: {\n                            '0%': { transform: 'translateY(30px)', opacity: '0' },\n                            '100%': { transform: 'translateY(0)', opacity: '1' }\n                        }\n                    },\n                    colors: {\n                        furniture: {\n                            beige: '#F5F0EC',\n                            tan: '#DCC1AB',\n                            green: '#1B5B31',\n                            gray: '#111111'\n                        }\n                    }\n                }\n            }\n        }\n    </script>\n    <style type=\"text/tailwindcss\">\n        @layer utilities {\n            .text-stroke {\n                -webkit-text-stroke: 1px rgba(0,0,0,0.1);\n                text-stroke: 1px rgba(0,0,0,0.1);\n            }\n            .delay-100 {\n                animation-delay: 100ms;\n            }\n            .delay-200 {\n                animation-delay: 200ms;\n            }\n            .delay-300 {\n                animation-delay: 300ms;\n            }\n        }\n    </style>\n</head>\n<body class=\"bg-furniture-beige text-furniture-gray overflow-x-hidden\">\n    <!-- Floating Background Elements -->\n    <div class=\"fixed inset-0 -z-10 overflow-hidden opacity-10\">\n        <div class=\"absolute w-64 h-64 rounded-full bg-furniture-tan top-1/4 -left-16 animate-float\"></div>\n        <div class=\"absolute w-48 h-48 rounded-full bg-furniture-green/30 bottom-1/4 -right-12 animate-float delay-200\"></div>\n    </div>\n    \n    <!-- Navigation -->\n    <nav class=\"fixed top-0 left-0 w-full py-6 px-6 md:px-12 z-50 bg-furniture-beige/80 backdrop-blur-sm\">\n        <div class=\"max-w-7xl mx-auto flex justify-between items-center\">\n            <div class=\"flex items-center text-2xl font-serif font-bold\">\n                <span>Lux</span><span class=\"text-furniture-green\">Chair</span>\n            </div>\n            \n            <div class=\"hidden md:flex space-x-8\">\n                <a href=\"#\" class=\"text-gray-700 hover:text-furniture-green transition-colors duration-300\">Products</a>\n                <a href=\"#\" class=\"text-gray-700 hover:text-furniture-green transition-colors duration-300\">Collections</a>\n                <a href=\"#\" class=\"text-gray-700 hover:text-furniture-green transition-colors duration-300\">Showrooms</a>\n                <a href=\"#\" class=\"text-gray-700 hover:text-furniture-green transition-colors duration-300\">About</a>\n                <a href=\"#\" class=\"text-gray-700 hover:text-furniture-green transition-colors duration-300\">Contact</a>\n            </div>\n            \n            <div class=\"flex items-center space-x-4\">\n                <button class=\"p-2 text-gray-700 hover:text-furniture-green transition-colors\">\n                    <i class=\"fas fa-search\"></i>\n                </button>\n                <button class=\"p-2 text-gray-700 hover:text-furniture-green transition-colors\">\n                    <i class=\"fas fa-shopping-bag\"></i>\n                </button>\n                <button class=\"md:hidden flex flex-col space-y-1.5\">\n                    <span class=\"w-6 h-0.5 bg-gray-700\"></span>\n                    <span class=\"w-6 h-0.5 bg-gray-700\"></span>\n                    <span class=\"w-6 h-0.5 bg-gray-700\"></span>\n                </button>\n            </div>\n        </div>\n    </nav>\n    \n    <!-- Hero Section -->\n    <section class=\"min-h-screen pt-24 pb-12 px-6 md:px-12 flex flex-col lg:flex-row items-center justify-between max-w-7xl mx-auto\">\n        <div class=\"lg:w-1/2 mb-16 lg:mb-0 lg:pr-12 animate-slide-up\">\n            <h1 class=\"text-4xl md:text-5xl lg:text-6xl font-serif font-bold leading-tight mb-6\">\n                <span class=\"block\">Elevate Your</span>\n                <span class=\"block text-furniture-green\">Living Space</span>\n            </h1>\n            <p class=\"text-lg text-gray-600 mb-8 max-w-lg\">\n                Discover our premium collection of handcrafted chairs that blend comfort, style, and exceptional craftsmanship for your modern home.\n            </p>\n            <div class=\"flex flex-col sm:flex-row space-y-4 sm:space-y-0 sm:space-x-4\">\n                <button class=\"px-8 py-4 bg-furniture-green text-white rounded-lg hover:bg-furniture-green/90 transition-all duration-300 transform hover:-translate-y-1\">\n                    Shop Collection\n                </button>\n                <button class=\"px-8 py-4 border border-gray-300 text-gray-700 rounded-lg hover:bg-white transition-all duration-300\">\n                    Explore Designs\n                </button>\n            </div>\n            \n            <div class=\"mt-12 flex items-center space-x-8\">\n                <div class=\"flex flex-col\">\n                    <span class=\"text-2xl font-bold text-furniture-green\">10+</span>\n                    <span class=\"text-gray-600\">Design Awards</span>\n                </div>\n                <div class=\"flex flex-col\">\n                    <span class=\"text-2xl font-bold text-furniture-green\">100%</span>\n                    <span class=\"text-gray-600\">Sustainable</span>\n                </div>\n                <div class=\"flex flex-col\">\n                    <span class=\"text-2xl font-bold text-furniture-green\">5Y</span>\n                    <span class=\"text-gray-600\">Warranty</span>\n                </div>\n            </div>\n        </div>\n        \n        <div class=\"lg:w-1/2 relative animate-slide-up delay-200\">\n            <div class=\"relative rounded-2xl overflow-hidden shadow-xl transform rotate-1 hover:rotate-0 transition-transform duration-500\">\n                <!-- Chair image from Unsplash -->\n                <img class=\"w-full h-auto object-cover\" src=\"https://cdn.midjourney.com/7d59d8c3-4cb0-45b6-8c5a-af076246ae1c/0_0.png\" alt=\"Premium lounge chair\">\n                <div class=\"absolute inset-0 bg-gradient-to-t from-black/10 to-transparent\"></div>\n            </div>\n            \n            <!-- Floating Tag Elements -->\n            <div class=\"absolute -top-6 -left-6 bg-white p-4 rounded-lg shadow-md w-40 animate-slide-up delay-300\">\n                <h4 class=\"font-bold text-gray-800\">Handcrafted</h4>\n                <p class=\"text-sm text-gray-600\">Artisan quality</p>\n            </div>\n            \n            <div class=\"absolute -bottom-6 -right-6 bg-white p-4 rounded-lg shadow-md w-40 animate-slide-up delay-400\">\n                <h4 class=\"font-bold text-gray-800\">Eco-Friendly</h4>\n                <p class=\"text-sm text-gray-600\">Sustainable materials</p>\n            </div>\n            \n            <!-- Price Tag -->\n            <div class=\"absolute top-8 right-8 bg-furniture-green text-white px-4 py-2 rounded-full animate-pulse-slow\">\n                <span class=\"font-bold\">$899</span>\n            </div>\n        </div>\n    </section>\n    \n    <!-- Featured In Section -->\n    <div class=\"py-12 px-6 md:px-12 max-w-7xl mx-auto\">\n        <p class=\"text-center text-gray-500 mb-8\">Featured in</p>\n        <div class=\"flex flex-wrap justify-center gap-8 md:gap-16\">\n            <div class=\"text-xl font-serif italic text-gray-700\">Architectural Digest</div>\n            <div class=\"text-xl font-serif italic text-gray-700\">Dwell</div>\n            <div class=\"text-xl font-serif italic text-gray-700\">Elle Decor</div>\n            <div class=\"text-xl font-serif italic text-gray-700\">Wallpaper*</div>\n        </div>\n    </div>\n\n    <script>\n        // Navbar scroll effect\n        window.addEventListener('scroll', function() {\n            const navbar = document.querySelector('nav');\n            if (window.scrollY > 50) {\n                navbar.classList.add('shadow-sm');\n                navbar.classList.remove('bg-furniture-beige/80');\n                navbar.classList.add('bg-furniture-beige/95');\n            } else {\n                navbar.classList.remove('shadow-sm');\n                navbar.classList.add('bg-furniture-beige/80');\n                navbar.classList.remove('bg-furniture-beige/95');\n            }\n        });\n\n        // Simple animation trigger\n        document.addEventListener('DOMContentLoaded', () => {\n            const elements = document.querySelectorAll('.animate-slide-up');\n            elements.forEach((el, index) => {\n                el.style.animationDelay = `${index * 100}ms`;\n            });\n        });\n    </script>\n</body>\n</html>"
  }
