  <div class=\\\"lg:w-1/2 relative animate-slide-up delay-200\\\">\\n            <div class=\\\"relative rounded-2xl overflow-hidden shadow-xl transform rotate-1 hover:rotate-0 transition-transform duration-500\\\">\\n                <!-- Chair image from Unsplash -->\\n                <img class=\\\"w-full h-auto object-cover\\\" src=\\\"https://cdn.midjourney.com/7d59d8c3-4cb0-45b6-8c5a-af076246ae1c/0_0.png\\\" alt=\\\"Premium lounge chair\\\">\\n                <div class=\\\"absolute inset-0 bg-gradient-to-t from-black/10 to-transparent\\\"></div>\\n            </div>\\n            \\n            <!-- Floating Tag Elements -->\\n            <div class=\\\"absolute -top-6 -left-6 bg-white p-4 rounded-lg shadow-md w-40 animate-slide-up delay-300\\\">\\n                <h4 class=\\\"font-bold text-gray-800\\\">Handcrafted</h4>\\n                <p class=\\\"text-sm text-gray-600\\\">Artisan quality</p>\\n            </div>\\n            \\n            <div class=\\\"absolute -bottom-6 -right-6 bg-white p-4 rounded-lg shadow-md w-40 animate-slide-up delay-400\\\">\\n                <h4 class=\\\"font-bold text-gray-800\\\">Eco-Friendly</h4>\\n                <p class=\\\"text-sm text-gray-600\\\">Sustainable materials</p>\\n            </div>\\n            \\n            <!-- Price Tag -->\\n            <div class=\\\"absolute top-8 right-8 bg-furniture-green text-white px-4 py-2 rounded-full animate-pulse-slow\\\">\\n                <span class=\\\"font-bold\\\">$899</span>\\n            </div>\\n        </div>\\n    </section>\\n    \\n    <!-- Featured In Section -->\\n    <div class=\\\"py-12 px-6 md:px-12 max-w-7xl mx-auto\\\">\\n        <p class=\\\"text-center text-gray-500 mb-8\\\">Featured in</p>\\n        <div class=\\\"flex flex-wrap justify-center gap-8 md:gap-16\\\">\\n            <div class=\\\"text-xl font-serif italic text-gray-700\\\">Architectural Digest</div>\\n            <div class=\\\"text-xl font-serif italic text-gray-700\\\">Dwell</div>\\n  