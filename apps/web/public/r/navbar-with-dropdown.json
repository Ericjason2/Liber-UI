      "content": "/**\n * Component: Navbar with Dropdown\n * Author: @razeem-razak (https://tailwindflex.com/@razeem-razak)\n * Source: https://tailwindflex.com/@razeem-razak/navbar-with-dropdown\n * Attribution: Créé par @razeem-razak sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function NavbarWithDropdown() {\n  return (\n    <div>\n    \n      <nav className=\"bg-white shadow-lg\">\n        <div className=\"max-w-7xl mx-auto px-4 sm6 lg8\">\n          <div className=\"relative flex items-center justify-between h-16\">\n            \n            <div className=\"flex-shrink-0 flex items-center\">\n              <span className=\"text-xl font-bold text-blue-700\">HMS</span>\n            </div>\n    \n            \n            <div className=\"hidden sm sm6\">\n              <ul className=\"flex space-x-4 text-gray-700 font-medium items-center\">\n                <li><a href=\"#\" className=\"hover600 px-3 py-2 rounded-md text-sm\">Home</a></li>\n                <li><a href=\"#\" className=\"hover600 px-3 py-2 rounded-md text-sm\">Our Story</a></li>\n                <li><a href=\"#\" className=\"hover600 px-3 py-2 rounded-md text-sm\">Departments</a></li>\n                <li><a href=\"#\" className=\"hover600 px-3 py-2 rounded-md text-sm\">Health Packages</a></li>\n                <li><a href=\"#\" className=\"hover600 px-3 py-2 rounded-md text-sm\">Doctors</a></li>\n                <li><a href=\"#\" className=\"hover600 px-3 py-2 rounded-md text-sm\">Careers</a></li>\n    \n                \n                <li className=\"relative group\">\n                  <button className=\"hover600 px-3 py-2 rounded-md text-sm flex items-center\">\n                    More Info\n                    <svg className=\"ml-1 h-4 w-4\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\n                      <path fillRule=\"evenodd\"\n                        d=\"M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z\"\n                        clipRule=\"evenodd\" />\n                    </svg>\n                  </button>\n    \n                  \n                  <ul\n                    className=\"absolute left-0 mt-2 w-48 bg-white border border-gray-200 rounded-md shadow-md opacity-0 invisible group-hover100 group-hover transition-all duration-150\">\n                    <li><a href=\"#\" className=\"block px-4 py-2 hover50 hover600\">Insurance Partners</a>\n                    </li>\n                    <li><a href=\"#\" className=\"block px-4 py-2 hover50 hover600\">Patient Guidelines</a></li>\n                    <li><a href=\"#\" className=\"block px-4 py-2 hover50 hover600\">Testimonials</a></li>\n                    <li><a href=\"#\" className=\"block px-4 py-2 hover50 hover600\">FAQs</a></li>\n                  </ul>\n                </li>\n              </ul>\n            </div>\n    \n            \n            <div className=\"flex items-center gap-3\">\n              <a href=\"#\"\n                className=\"bg-blue-600 text-white px-4 py-2 rounded-md hover700 text-sm font-medium\">Book Now</a>\n    \n              \n              <div className=\"sm\">\n                <button id=\"mobile-menu-button\" type=\"button\"\n                  className=\"inline-flex items-center justify-center p-2 rounded-md text-gray-400 hover500 hover100 focus\">\n                  <span className=\"sr-only\">Open main menu</span>\n                  <svg className=\"block h-6 w-6\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\"\n                    stroke=\"currentColor\" aria-hidden=\"true\">\n                    <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\"\n                      d=\"M4 6h16M4 12h16M4 18h16\" />\n                  </svg>\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n    \n        \n        <div className=\"sm hidden\" id=\"mobile-menu\">\n          <div className=\"px-2 pt-2 pb-3 space-y-1\">\n            <a href=\"#\" className=\"block px-3 py-2 text-gray-900 rounded-md hover100 text-base font-medium\">Home</a>\n            <a href=\"#\" className=\"block px-3 py-2 text-gray-900 rounded-md hover100 text-base font-medium\">Our\n              Story</a>\n            <a href=\"#\" className=\"block px-3 py-2 text-gray-900 rounded-md hover100 text-base font-medium\">Departments</a>\n            <a href=\"#\"\n              className=\"block px-3 py-2 text-gray-900 rounded-md hover100 text-base font-medium\">Health\n              Packages</a>\n            <a href=\"#\" className=\"block px-3 py-2 text-gray-900 rounded-md hover100 text-base font-medium\">Doctors</a>\n            <a href=\"#\" className=\"block px-3 py-2 text-gray-900 rounded-md hover100 text-base font-medium\">Careers</a>\n    \n            \n            <div className=\"relative\">\n              <button\n                className=\"w-full text-left px-3 py-2 text-gray-900 rounded-md hover100 text-base font-medium flex items-center justify-between mobile-dropdown-trigger\">\n                More Info\n                <svg className=\"h-5 w-5\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\n                  <path fillRule=\"evenodd\"\n                    d=\"M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z\"\n                    clipRule=\"evenodd\" />\n                </svg>\n              </button>\n              <div className=\"hidden pl-4 py-2 mobile-dropdown-content\">\n                <a href=\"#\" className=\"block py-1 hover600\">Insurance Partners</a>\n                <a href=\"#\" className=\"block py-1 hover600\">Patient Guidelines</a>\n                <a href=\"#\" className=\"block py-1 hover600\">Testimonials</a>\n                <a href=\"#\" className=\"block py-1 hover600\">FAQs</a>\n              </div>\n            </div>\n    \n            <a href=\"#\"\n              className=\"block px-3 py-2 text-blue-600 font-semibold rounded-md text-base font-medium\">Book Now</a>\n          </div>\n        </div>\n      </nav>\n    \n      \n    </div>\n  );\n}\n",
