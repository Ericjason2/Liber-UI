    "rawHtml": "<body class=\"bg-gray-300 flex items-center justify-center min-h-screen\">\n\n  <!-- Navigation -->\n  <section class=\"fixed bottom-10 inset-x-0 flex justify-center\">\n    <ul class=\"flex space-x-4\">\n      <!-- Notion -->\n      <li class=\"group relative flex items-center justify-center w-20 transition-all duration-500 hover:w-32\">\n        <a href=\"#\" class=\"pointer-events-auto flex items-center justify-center w-full h-full\">\n          <img src=\"https://cdn.prod.website-files.com/6728a3e6f4f4161c235bc519/6728a6be92ee5ddf0080fb90_notion.png\" alt=\"Notion app icon\" class=\"w-full object-contain\">\n        </a>\n        <div class=\"absolute top-0 transform -translate-y-full bg-gray-100 text-gray-800 text-sm rounded py-1 px-2 opacity-0 group-hover:opacity-100 transition-all duration-500\">\n          Notion\n        </div>\n      </li>\n      <!-- Asana -->\n      <li class=\"group relative flex items-center justify-center w-20 transition-all duration-500 hover:w-32\">\n        <a href=\"#\" class=\"pointer-events-auto flex items-center justify-center w-full h-full\">\n          <img src=\"https://cdn.prod.website-files.com/6728a3e6f4f4161c235bc519/6728a6bef9d004f8a9cf3b29_asana.png\" alt=\"Asana app icon\" class=\"w-full object-contain\">\n        </a>\n        <div class=\"absolute top-0 transform -translate-y-full bg-gray-100 text-gray-800 text-sm rounded py-1 px-2 opacity-0 group-hover:opacity-100 transition-all duration-500\">\n          Asana\n        </div>\n      </li>\n      <!-- Slack -->\n      <li class=\"group relative flex items-center justify-center w-20 transition-all duration-500 hover:w-32\">\n        <a href=\"#\" class=\"pointer-events-auto flex items-center justify-center w-full h-full\">\n          <img src=\"https://cdn.prod.website-files.com/6728a3e6f4f4161c235bc519/6728a6be8c099d4e1ed55770_slack.png\" alt=\"Slack app icon\" class=\"w-full object-contain\">\n        </a>\n        <div class=\"absolute top-0 transform -translate-y-full bg-gray-100 text-gray-800 text-sm rounded py-1 px-2 opacity-0 group-hover:opacity-100 transition-all duration-500\">\n          Slack\n        </div>\n      </li>\n      <!-- Loom -->\n      <li class=\"group relative flex items-center justify-center w-20 transition-all duration-500 hover:w-32\">\n        <a href=\"#\" class=\"pointer-events-auto flex items-center justify-center w-full h-full\">\n          <img src=\"https://cdn.prod.website-files.com/6728a3e6f4f4161c235bc519/6728a6be5b31ba243e4da377_loom.png\" alt=\"Loom app icon\" class=\"w-full object-contain\">\n        </a>\n        <div class=\"absolute top-0 transform -translate-y-full bg-gray-100 text-gray-800 text-sm rounded py-1 px-2 opacity-0 group-hover:opacity-100 transition-all duration-500\">\n          Loom\n        </div>\n      </li>\n      <!-- Spotify -->\n      <li class=\"group relative flex items-center justify-center w-20 transition-all duration-500 hover:w-32\">\n        <a href=\"#\" class=\"pointer-events-auto flex items-center justify-center w-full h-full\">\n          <img src=\"https://cdn.prod.website-files.com/6728a3e6f4f4161c235bc519/6728a6bea97e140677496dae_spotify.png\" alt=\"Spotify app icon\" class=\"w-full object-contain\">\n        </a>\n        <div class=\"absolute top-0 transform -translate-y-full bg-gray-100 text-gray-800 text-sm rounded py-1 px-2 opacity-0 group-hover:opacity-100 transition-all duration-500\">\n          Spotify\n        </div>\n      </li>\n      <!-- Webflow -->\n      <li class=\"group relative flex items-center justify-center w-20 transition-all duration-500 hover:w-32\">\n        <a href=\"#\" class=\"pointer-events-auto flex items-center justify-center w-full h-full\">\n          <img src=\"https://cdn.prod.website-files.com/6728a3e6f4f4161c235bc519/6728a6bea73fcc6ee568f6f0_webflow.png\" alt=\"Webflow app icon\" class=\"w-full object-contain\">\n        </a>\n        <div class=\"absolute top-0 transform -translate-y-full bg-gray-100 text-gray-800 text-sm rounded py-1 px-2 opacity-0 group-hover:opacity-100 transition-all duration-500\">\n          Webflow\n        </div>\n      </li>\n      <!-- Adobe Illustrator -->\n      <li class=\"group relative flex items-center justify-center w-20 transition-all duration-500 hover:w-32\">\n        <a href=\"#\" class=\"pointer-events-auto flex items-center justify-center w-full h-full\">\n          <img src=\"https://cdn.prod.website-files.com/6728a3e6f4f4161c235bc519/6728a6bdf9d004f8a9cf3b09_adobe-illustrator.png\" alt=\"Adobe Illustrator app icon\" class=\"w-full object-contain\">\n        </a>\n        <div class=\"absolute top-0 transform -translate-y-full bg-gray-100 text-gray-800 text-sm rounded py-1 px-2 opacity-0 group-hover:opacity-100 transition-all duration-500\">\n          Adobe Illustrator\n        </div>\n      </li>\n      <!-- Figma -->\n      <li class=\"group relative flex items-center justify-center w-20 transition-all duration-500 hover:w-32\">\n        <a href=\"#\" class=\"pointer-events-auto flex items-center justify-center w-full h-full\">\n          <img src=\"https://cdn.prod.website-files.com/6728a3e6f4f4161c235bc519/6728a6be1de916069b5e1aaa_figma.png\" alt=\"Figma app icon\" class=\"w-full object-contain\">\n        </a>\n        <div class=\"absolute top-0 transform -translate-y-full bg-gray-100 text-gray-800 text-sm rounded py-1 px-2 opacity-0 group-hover:opacity-100 transition-all duration-500\">\n          Figma\n        </div>\n      </li>\n      <!-- Photoshop -->\n      <li class=\"group relative flex items-center justify-center w-20 transition-all duration-500 hover:w-32\">\n        <a href=\"#\" class=\"pointer-events-auto flex items-center justify-center w-full h-full\">\n          <img src=\"https://cdn.prod.website-files.com/6728a3e6f4f4161c235bc519/6728a6be1de916069b5e1a86_adobe-photoshop.png\" alt=\"Photoshop app icon\" class=\"w-full object-contain\">\n        </a>\n        <div class=\"absolute top-0 transform -translate-y-full bg-gray-100 text-gray-800 text-sm rounded py-1 px-2 opacity-0 group-hover:opacity-100 transition-all duration-500\">\n          Photoshop\n        </div>\n      </li>\n      <!-- Premiere Pro -->\n      <li class=\"group relative flex items-center justify-center w-20 transition-all duration-500 hover:w-32\">\n        <a href=\"#\" class=\"pointer-events-auto flex items-center justify-center w-full h-full\">\n          <img src=\"https://cdn.prod.website-files.com/6728a3e6f4f4161c235bc519/6728a6be051d32942a7aa31e_adobe-premierepro.png\" alt=\"Premiere Pro app icon\" class=\"w-full object-contain\">\n        </a>\n        <div class=\"absolute top-0 transform -translate-y-full bg-gray-100 text-gray-800 text-sm rounded py-1 px-2 opacity-0 group-hover:opacity-100 transition-all duration-500\">\n          Premiere Pro\n        </div>\n      </li>\n    </ul>\n  </section>\n</body>"
