    "rawHtml": "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Deezer Clone</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        /* Masquer la barre de défilement pour un look propre */\n        .no-scrollbar::-webkit-scrollbar {\n            display: none;\n        }\n        .no-scrollbar {\n            -ms-overflow-style: none;\n            scrollbar-width: none;\n        }\n        \n        /* Animation rotation du vinyle quand ça joue */\n        .spin {\n            animation: spin 3s linear infinite;\n        }\n        @keyframes spin {\n            from { transform: rotate(0deg); }\n            to { transform: rotate(360deg); }\n        }\n        \n        /* Dégradé personnalisé Deezer */\n        .bg-gradient-deezer {\n            background: linear-gradient(to bottom right, #111111, #1a1a1a);\n        }\n    </style>\n</head>\n<body class=\"bg-black text-white font-sans h-screen flex flex-col overflow-hidden\">\n\n    <!-- SIDEBAR (Gauche) -->\n    <aside class=\"hidden md:flex flex-col w-64 bg-neutral-900 h-full flex-shrink-0 z-20\">\n        <!-- Logo -->\n        <div class=\"p-6\">\n          <h1 class=\" text-xl font-bold \">OmerLinks Sounds</h1>\n        </div>\n\n        <!-- Navigation -->\n        <nav class=\"flex-1 px-4\">\n            <ul class=\"space-y-2\">\n                <li>\n                    <a href=\"#\" class=\"flex items-center gap-4 px-4 py-3 text-white bg-neutral-800 rounded-lg hover:bg-neutral-700 transition\">\n                        <svg class=\"w-6 h-6\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z\"/></svg>\n                        <span class=\"font-bold\">Accueil</span>\n                    </a>\n                </li>\n                <li>\n                    <a href=\"#\" class=\"flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-neutral-800 rounded-lg transition\">\n                        <svg class=\"w-6 h-6\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z\"/></svg>\n                        <span>Titres favoris</span>\n                    </a>\n                </li>\n                <li>\n                    <a href=\"#\" class=\"flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-neutral-800 rounded-lg transition\">\n                        <svg class=\"w-6 h-6\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M15 6H3v2h12V6zm0 4H3v2h12v-2zM3 16h8v-2H3v2zM17 6v8.18c-.31-.11-.65-.18-1-.18-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3V8h3V6h-5z\"/></svg>\n                        <span>Playlists</span>\n                    </a>\n                </li>\n                <li>\n                    <a href=\"#\" class=\"flex items-center gap-4 px-4 py-3 text-gray-400 hover:text-white hover:bg-neutral-800 rounded-lg transition\">\n                        <svg class=\"w-6 h-6\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z\"/></svg>\n                        <span>Mix Deezer</span>\n                    </a>\n                </li>\n            </ul>\n            \n            <div class=\"mt-8\">\n                <h3 class=\"px-4 text-xs font-bold text-gray-500 uppercase tracking-wider mb-2\">Mes Playlists</h3>\n                <ul class=\"space-y-1\">\n                    <li><a href=\"#\" class=\"block px-4 py-2 text-sm text-gray-400 hover:text-white truncate\">Driving Chill</a></li>\n                    <li><a href=\"#\" class=\"block px-4 py-2 text-sm text-gray-400 hover:text-white truncate\">Code Focus</a></li>\n                    <li><a href=\"#\" class=\"block px-4 py-2 text-sm text-gray-400 hover:text-white truncate\">Gym Workout</a></li>\n                </ul>\n            </div>\n        </nav>\n\n        <!-- Upgrade Button -->\n        <div class=\"p-4 m-4 bg-gradient-to-r from-blue-600 to-blue-800 rounded-xl cursor-pointer hover:shadow-lg transition\">\n            <h4 class=\"font-bold text-sm\">Passez en Premium</h4>\n            <p class=\"text-xs text-blue-100 mt-1 mb-2\">Écoutez sans publicité.</p>\n            <span class=\"text-xs font-bold bg-white text-blue-600 px-2 py-1 rounded\">Offrir 3 mois</span>\n        </div>\n    </aside>\n\n    <!-- MAIN CONTENT (Droite) -->\n    <main class=\"flex-1 flex flex-col h-full bg-gradient-deezer relative\">\n        \n        <!-- Top Header -->\n        <header class=\"h-20 bg-neutral-900/80 backdrop-blur-md flex items-center justify-between px-6 sticky top-0 z-10\">\n            <div class=\"flex items-center gap-4\">\n                <button class=\"text-gray-400 hover:text-white\"><svg class=\"w-6 h-6\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z\"/></svg></button>\n                <button class=\"text-gray-400 hover:text-white\"><svg class=\"w-6 h-6\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z\"/></svg></button>\n            </div>\n\n            <div class=\"flex-1 max-w-md mx-8 hidden md:block\">\n                <div class=\"relative\">\n                    <input type=\"text\" placeholder=\"Artiste, titre, album...\" class=\"w-full bg-neutral-800 text-gray-300 rounded-full py-2 pl-10 pr-4 focus:outline-none focus:ring-1 focus:ring-blue-500 text-sm\">\n                    <svg class=\"w-4 h-4 text-gray-400 absolute left-3 top-2.5\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z\"/></svg>\n                </div>\n            </div>\n\n            <div class=\"flex items-center gap-4\">\n                <span class=\"text-sm font-bold text-blue-500\">Découvrir Premium</span>\n                <div class=\"w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center font-bold text-xs cursor-pointer\">OM</div>\n            </div>\n        </header>\n\n        <!-- Scrollable Content -->\n        <div class=\"flex-1 overflow-y-auto p-8 pb-32 custom-scrollbar\">\n            \n            <!-- Hero Section -->\n            <div class=\"relative w-full h-64 md:h-80 rounded-xl overflow-hidden mb-10 group cursor-pointer\" onclick=\"playSong(0)\">\n                <img src=\"https://images.unsplash.com/photo-1493225255756-d9584f8606e9?q=80&w=2000&auto=format&fit=crop\" class=\"absolute inset-0 w-full h-full object-cover rounded-full transition duration-500 group-hover:scale-105\">\n                <div class=\"absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent opacity-80\"></div>\n                <div class=\"absolute bottom-0 left-0 p-6\">\n                    <h1 class=\"text-3xl md:text-5xl font-bold mb-2\">Weekend Vibes</h1>\n                    <p class=\"text-gray-300 text-sm md:text-base\">Le meilleur de la pop et de l'électro pour votre week-end.</p>\n                </div>\n            </div>\n\n            <!-- Section: Mixes -->\n            <div class=\"mb-8\">\n                <h2 class=\"text-xl font-bold mb-4 flex justify-between items-center\">\n                    Vos Mixes\n                    <span class=\"text-xs text-gray-500 cursor-pointer\">VOIR TOUT</span>\n                </h2>\n                <div class=\"flex gap-4 overflow-x-auto no-scrollbar pb-4\">\n                    <!-- Card 1 -->\n                    <div class=\"min-w-[160px] md:min-w-[180px] group cursor-pointer\" onclick=\"playSong(1)\">\n                        <div class=\"relative w-full aspect-square rounded-md overflow-hidden mb-3 shadow-lg\">\n                            <img src=\"https://images.unsplash.com/photo-1614613535308-eb5fbd3d2c17?q=80&w=500\" class=\"w-full h-full object-cover transition group-hover:opacity-70\">\n                            <button class=\"absolute bottom-2 right-2 bg-blue-600 rounded-full p-2 shadow-xl opacity-0 group-hover:opacity-100 transform translate-y-2 group-hover:translate-y-0 transition\">\n                                <svg class=\"w-5 h-5 text-white fill-current\" viewBox=\"0 0 24 24\"><path d=\"M8 5v14l11-7z\"/></svg>\n                            </button>\n                        </div>\n                        <h3 class=\"font-bold text-sm truncate\">Daily Mix 1</h3>\n                        <p class=\"text-xs text-gray-400 truncate\">The Weeknd, Dua Lipa...</p>\n                    </div>\n                    <!-- Card 2 -->\n                    <div class=\"min-w-[160px] md:min-w-[180px] group cursor-pointer\" onclick=\"playSong(2)\">\n                        <div class=\"relative w-full aspect-square rounded-md overflow-hidden mb-3 shadow-lg\">\n                            <img src=\"https://images.unsplash.com/photo-1470225620780-dba8ba36b745?q=80&w=500\" class=\"w-full h-full object-cover transition group-hover:opacity-70\">\n                            <button class=\"absolute bottom-2 right-2 bg-blue-600 rounded-full p-2 shadow-xl opacity-0 group-hover:opacity-100 transform translate-y-2 group-hover:translate-y-0 transition\">\n                                <svg class=\"w-5 h-5 text-white fill-current\" viewBox=\"0 0 24 24\"><path d=\"M8 5v14l11-7z\"/></svg>\n                            </button>\n                        </div>\n                        <h3 class=\"font-bold text-sm truncate\">Disco Hits</h3>\n                        <p class=\"text-xs text-gray-400 truncate\">Bee Gees, ABBA</p>\n                    </div>\n                    <!-- Card 3 -->\n                    <div class=\"min-w-[160px] md:min-w-[180px] group cursor-pointer\" onclick=\"playSong(3)\">\n                        <div class=\"relative w-full aspect-square rounded-md overflow-hidden mb-3 shadow-lg\">\n                            <img src=\"https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?q=80&w=500\" class=\"w-full h-full object-cover transition group-hover:opacity-70\">\n                            <button class=\"absolute bottom-2 right-2 bg-blue-600 rounded-full p-2 shadow-xl opacity-0 group-hover:opacity-100 transform translate-y-2 group-hover:translate-y-0 transition\">\n                                <svg class=\"w-5 h-5 text-white fill-current\" viewBox=\"0 0 24 24\"><path d=\"M8 5v14l11-7z\"/></svg>\n                            </button>\n                        </div>\n                        <h3 class=\"font-bold text-sm truncate\">Chill Lo-Fi</h3>\n                        <p class=\"text-xs text-gray-400 truncate\">Lofi Girl, Chill</p>\n                    </div>\n                    <!-- Card 4 -->\n                    <div class=\"min-w-[160px] md:min-w-[180px] group cursor-pointer\" onclick=\"playSong(4)\">\n                        <div class=\"relative w-full aspect-square rounded-md overflow-hidden mb-3 shadow-lg\">\n                            <img src=\"https://images.unsplash.com/photo-1514525253440-b393452e8d26?q=80&w=500\" class=\"w-full h-full object-cover transition group-hover:opacity-70\">\n                            <button class=\"absolute bottom-2 right-2 bg-blue-600 rounded-full p-2 shadow-xl opacity-0 group-hover:opacity-100 transform translate-y-2 group-hover:translate-y-0 transition\">\n                                <svg class=\"w-5 h-5 text-white fill-current\" viewBox=\"0 0 24 24\"><path d=\"M8 5v14l11-7z\"/></svg>\n                            </button>\n                        </div>\n                        <h3 class=\"font-bold text-sm truncate\">Rock Classics</h3>\n                        <p class=\"text-xs text-gray-400 truncate\">Queen, AC/DC</p>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Section: Albums -->\n            <div class=\"mb-8\">\n                <h2 class=\"text-xl font-bold mb-4\">Tendances</h2>\n                <div class=\"flex gap-4 overflow-x-auto no-scrollbar pb-4\">\n                     <!-- Card A -->\n                     <div class=\"min-w-[160px] md:min-w-[180px] group cursor-pointer\" onclick=\"playSong(0)\">\n                        <div class=\"relative w-full aspect-square rounded-md overflow-hidden mb-3 shadow-lg\">\n                            <img src=\"https://images.unsplash.com/photo-1619983081563-430f63602796?q=80&w=500\" class=\"w-full h-full object-cover transition group-hover:opacity-70\">\n                        </div>\n                        <h3 class=\"font-bold text-sm truncate\">New Wave</h3>\n                        <p class=\"text-xs text-gray-400 truncate\">Various Artists</p>\n                    </div>\n                     <!-- Card B -->\n                     <div class=\"min-w-[160px] md:min-w-[180px] group cursor-pointer\" onclick=\"playSong(1)\">\n                        <div class=\"relative w-full aspect-square rounded-md overflow-hidden mb-3 shadow-lg\">\n                            <img src=\"https://images.unsplash.com/photo-1621360841013-c768371e93cf?q=80&w=500\" class=\"w-full h-full object-cover transition group-hover:opacity-70\">\n                        </div>\n                        <h3 class=\"font-bold text-sm truncate\">Jazz Night</h3>\n                        <p class=\"text-xs text-gray-400 truncate\">Smooth Jazz</p>\n                    </div>\n                </div>\n            </div>\n\n        </div>\n    </main>\n\n    <!-- PLAYER BAR (Bas) -->\n    <footer class=\"h-24 bg-neutral-900 border-t border-neutral-800 flex items-center justify-between px-4 z-30 fixed bottom-0 w-full\">\n        \n        <!-- Left: Track Info -->\n        <div class=\"w-1/4 flex items-center gap-3\">\n            <img id=\"player-cover\" src=\"https://images.unsplash.com/photo-1493225255756-d9584f8606e9?q=80&w=200\" class=\"w-14 h-14 rounded shadow-md\">\n            <div class=\"hidden sm:block\">\n                <h4 id=\"player-title\" class=\"text-sm font-bold text-white hover:underline cursor-pointer\">Weekend Vibes</h4>\n                <p id=\"player-artist\" class=\"text-xs text-gray-400 hover:text-white cursor-pointer\">Deezer Mix</p>\n            </div>\n            <button class=\"text-gray-400 hover:text-blue-500 ml-2\">\n                <svg class=\"w-5 h-5\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z\"/></svg>\n            </button>\n        </div>\n\n        <!-- Center: Controls -->\n        <div class=\"w-2/4 max-w-xl flex flex-col items-center justify-center\">\n            <div class=\"flex items-center gap-4 mb-1\">\n                <button class=\"text-gray-400 hover:text-white\"><svg class=\"w-4 h-4\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M10.59 9.17L5.41 4 4 5.41l5.17 5.17 1.42-1.41zM14.5 4l2.04 2.04L4 18.59 5.41 20 17.96 7.46 20 9.5V4h-5.5zm.33 9.41l-1.41 1.41 3.13 3.13L14.5 20H20v-5.5l-2.04 2.04-3.13-3.13z\"/></svg></button>\n                <button class=\"text-gray-200 hover:text-white\"><svg class=\"w-6 h-6\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M6 6h2v12H6zm3.5 6l8.5 6V6z\"/></svg></button>\n                \n                <!-- Play/Pause Button -->\n                <button id=\"play-btn\" class=\"bg-white text-black rounded-full p-2 hover:scale-105 transition transform\">\n                    <svg id=\"icon-play\" class=\"w-6 h-6 fill-current ml-0.5\" viewBox=\"0 0 24 24\"><path d=\"M8 5v14l11-7z\"/></svg>\n                    <svg id=\"icon-pause\" class=\"w-6 h-6 fill-current hidden\" viewBox=\"0 0 24 24\"><path d=\"M6 19h4V5H6v14zm8-14v14h4V5h-4z\"/></svg>\n                </button>\n\n                <button class=\"text-gray-200 hover:text-white\"><svg class=\"w-6 h-6\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z\"/></svg></button>\n                <button class=\"text-gray-400 hover:text-white\"><svg class=\"w-4 h-4\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M17 12h-5v5h5v-5zM16 1v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2h-1V1h-2zm3 18H5V8h14v11z\"/></svg></button>\n            </div>\n            \n            <!-- Progress Bar -->\n            <div class=\"w-full flex items-center gap-2 text-[10px] text-gray-400 font-mono\">\n                <span id=\"current-time\">0:00</span>\n                <div class=\"flex-1 h-1 bg-gray-600 rounded-full cursor-pointer group relative\" id=\"progress-container\">\n                    <div id=\"progress-bar\" class=\"h-full bg-white rounded-full w-0 group-hover:bg-blue-500 transition-colors\"></div>\n                </div>\n                <span id=\"total-time\">3:45</span>\n            </div>\n        </div>\n\n        <!-- Right: Volume -->\n        <div class=\"w-1/4 flex justify-end items-center gap-2\">\n             <button class=\"text-gray-400 hover:text-white\"><svg class=\"w-5 h-5\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z\"/></svg></button>\n             <div class=\"w-20 h-1 bg-gray-600 rounded-full cursor-pointer hidden sm:block\">\n                <div class=\"h-full bg-white w-3/4 rounded-full\"></div>\n             </div>\n        </div>\n\n    </footer>\n\n    <!-- AUDIO ELEMENT & JAVASCRIPT -->\n    <!-- Utilisation d'un MP3 libre de droits pour la démo -->\n    <audio id=\"audio-player\" src=\"https://assets.mixkit.co/music/preview/mixkit-tech-house-vibes-130.mp3\"></audio>\n\n    <script>\n        const audio = document.getElementById('audio-player');\n        const playBtn = document.getElementById('play-btn');\n        const iconPlay = document.getElementById('icon-play');\n        const iconPause = document.getElementById('icon-pause');\n        const progressBar = document.getElementById('progress-bar');\n        const progressContainer = document.getElementById('progress-container');\n        const currentTimeEl = document.getElementById('current-time');\n        const totalTimeEl = document.getElementById('total-time');\n        \n        const playerTitle = document.getElementById('player-title');\n        const playerArtist = document.getElementById('player-artist');\n        const playerCover = document.getElementById('player-cover');\n\n        // Données simulées\n        const songs = [\n            { title: \"Weekend Vibes\", artist: \"Deezer Mix\", cover: \"https://images.unsplash.com/photo-1493225255756-d9584f8606e9?q=80&w=200\" },\n            { title: \"Daily Mix 1\", artist: \"The Weeknd, Dua Lipa\", cover: \"https://images.unsplash.com/photo-1614613535308-eb5fbd3d2c17?q=80&w=200\" },\n            { title: \"Disco Hits\", artist: \"Bee Gees, ABBA\", cover: \"https://images.unsplash.com/photo-1470225620780-dba8ba36b745?q=80&w=200\" },\n            { title: \"Chill Lo-Fi\", artist: \"Lofi Girl, Chill\", cover: \"https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?q=80&w=200\" },\n            { title: \"Rock Classics\", artist: \"Queen, AC/DC\", cover: \"https://images.unsplash.com/photo-1514525253440-b393452e8d26?q=80&w=200\" }\n        ];\n\n        // Fonction Play/Pause\n        playBtn.addEventListener('click', () => {\n            if (audio.paused) {\n                audio.play();\n                iconPlay.classList.add('hidden');\n                iconPause.classList.remove('hidden');\n                playerCover.classList.add('spin');\n            } else {\n                audio.pause();\n                iconPlay.classList.remove('hidden');\n                iconPause.classList.add('hidden');\n                playerCover.classList.remove('spin');\n            }\n        });\n\n        // Mise à jour de la barre de progression\n        audio.addEventListener('timeupdate', (e) => {\n            const { duration, currentTime } = e.srcElement;\n            if (isNaN(duration)) return;\n            \n            const progressPercent = (currentTime / duration) * 100;\n            progressBar.style.width = `${progressPercent}%`;\n            \n            // Formatage temps\n            currentTimeEl.innerText = formatTime(currentTime);\n            totalTimeEl.innerText = formatTime(duration);\n        });\n\n        // Click sur la barre pour avancer\n        progressContainer.addEventListener('click', (e) => {\n            const width = progressContainer.clientWidth;\n            const clickX = e.offsetX;\n            const duration = audio.duration;\n            audio.currentTime = (clickX / width) * duration;\n        });\n\n        // Fonction générique pour jouer une chanson (quand on clique sur une carte)\n        window.playSong = function(index) {\n            if(index >= songs.length) index = 0;\n            \n            // Mise à jour UI\n            playerTitle.innerText = songs[index].title;\n            playerArtist.innerText = songs[index].artist;\n            playerCover.src = songs[index].cover;\n            \n            // Reset visuel\n            playerCover.classList.remove('spin');\n            void playerCover.offsetWidth; // Trigger reflow\n            playerCover.classList.add('spin');\n            iconPlay.classList.add('hidden');\n            iconPause.classList.remove('hidden');\n\n            // Play\n            audio.play();\n        };\n\n        // Formatage minutes:secondes\n        function formatTime(seconds) {\n            const min = Math.floor(seconds / 60);\n            const sec = Math.floor(seconds % 60);\n            return `${min}:${sec < 10 ? '0' : ''}${sec}`;\n        }\n\n        // Quand la musique est finie\n        audio.addEventListener('ended', () => {\n            iconPlay.classList.remove('hidden');\n            iconPause.classList.add('hidden');\n            playerCover.classList.remove('spin');\n        });\n\n    </script>\n</body>\n</html>"
  }
}
