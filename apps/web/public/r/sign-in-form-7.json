    "rawHtml": "<div class=\"max-w-md mx-auto p-8 bg-white shadow-xl rounded-xl border border-gray-200\">\r\n  <h2 class=\"text-2xl font-bold text-center text-blue-600 mb-6\">Sign In</h2>\r\n  <form class=\"space-y-4\">\r\n    <div>\r\n      <label class=\"block mb-1 text-sm text-gray-600\">Email Address</label>\r\n      <input type=\"email\" class=\"w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500\" placeholder=\"you@example.com\" required>\r\n    </div>\r\n    <div>\r\n      <label class=\"block mb-1 text-sm text-gray-600\">Password</label>\r\n      <input type=\"password\" class=\"w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500\" placeholder=\"••••••••\" required>\r\n    </div>\r\n    <div class=\"flex items-center justify-between\">\r\n      <label class=\"flex items-center\">\r\n        <input type=\"checkbox\" class=\"mr-2\">\r\n        <span class=\"text-sm text-gray-600\">Remember me</span>\r\n      </label>\r\n      <a href=\"#\" class=\"text-sm text-blue-500 hover:underline\">Forgot password?</a>\r\n    </div>\r\n    <button type=\"submit\" class=\"w-full bg-blue-600 text-white py-2 rounded-lg hover:bg-blue-700 transition\">Sign In</button>\r\n  </form>\r\n  <p class=\"text-sm text-center text-gray-500 mt-6\">Don't have an account? <a href=\"#\"\r\n      class=\"text-blue-500 hover:underline\">Sign Up</a></p>\r\n</div>"
  }
