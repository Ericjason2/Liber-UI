vron-right text-pink-600\"></i> Photoshoot Studio</a></li>\n        <li><a href=\"#\" class=\"flex items-center gap-2 opacity-90 hover:opacity-100 hover:translate-x-1 transition\"><i class=\"fas fa-chevron-right text-pink-600\"></i> Event Hosting</a></li>\n      </ul>\n    </div>\n    \n    <!-- Contact Us -->\n    <div>\n      <h3 class=\"text-xl text-pink-600 mb-6 border-b-2 border-pink-600 pb-2\">Contact Us</h3>\n      <ul class=\"space-y-4 mb-6\">\n        <li class=\"flex items-start gap-4\">\n          <i class=\"fas fa-map-marker-alt text-pink-600 mt-1\"></i>\n          <div>\n            India \n          </div>\n        </li>\n        <li class=\"flex items-start gap-4\">\n          <i class=\"fas fa-phone-alt text-pink-600 mt-1\"></i>\n          <div>\n            <a href=\"tel:+91987654321\" class=\"block hover:underline opacity-90 hover:opacity-100\">+91 7307022824</a>\n          \n          </div>\n        </li>\n        <li class=\"flex items-start gap-4\">\n          <i class=\"fas fa-envelope text-pink-600 mt-1\"></i>\n          <div>\n            <a href=\"mailto:kuldeepprajapati2111@gmail.com\" class=\"block hover:underline opacity-90 hover:opacity-100\">kuldeepprajapati2111@gmail.com</a>\n          </div>\n        </li>\n      </ul>\n      \n      <!-- Newsletter -->\n      <h3 class=\"text-xl text-pink-600 mb-2 border-b-2 border-pink-600 pb-2\">Newsletter</h3>\n      <p class=\"mb-4 opacity-70\">Subscribe to get updates on our latest events and offers.</p>\n      <form class=\"flex\">\n        <input type=\"email\" placeholder=\"Your Email\" required class=\"flex-1 p-3 rounded-l-md focus:outline-none\" />\n        <button type=\"submit\" class=\"bg-pink-600 hover:bg-pink-500 text-white p-3 rounded-r-md transition\">\n          <i class=\"fas fa-paper-plane\"></i>\n        </button>\n      </form>\n    </div>\n  </div>\n  \n  <!-- Footer Bottom -->\n  <div class=\"mt-16 pt-8 border-t border-gray-700 text-center opacity-70 text-sm\">\n    <p>© 2024