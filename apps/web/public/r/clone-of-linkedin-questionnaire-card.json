      "content": "/**\n * Component: Clone of LinkedIn Questionnaire Card\n * Author: @sammytg7 (https://tailwindflex.com/@sammytg7)\n * Source: https://tailwindflex.com/@sammytg7/clone-of-linkedin-questionnaire-card\n * Attribution: Créé par @sammytg7 sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function CloneOfLinkedinQuestionnaireCard() {\n  return (\n    <div>\n    <div className=\"w-full h-screen flex items-center bg-gray-300 dark900\">\n        <div className=\"xl[40%] lg[50%] sm[80%] xs[96%] mx-auto shadow-lg flex flex-col gap-2 justify-center items-center p-4 mx-4 border-2 rounded-lg bg-white dark500 dark900\">\n            <img src=\"https://media.licdn.com/media/AAYQAgSuAAgAAQAAAAAAACusnN9kMj0wRRWck-KbrrrLSg.png\" alt=\"User Profile\" className=\"w-[6rem] h-[6rem] outline outline-2 outline-gray-200 rounded-full\" />\n            <div className=\"w-full pt-4 text-center\">\n                <h3 className=\"text-2xl font-serif text-gray-900 dark\">Hi Samuel, are you hiring?</h3>\n                <p className=\"text-xl text-serif pt-2 text-gray-500 dark400\">Discover free and easy ways to find a great\n                    hire,\n                    fast.</p>\n            </div>\n    \n            <div className=\"flex sm xs gap-4 pt-4 dark\">\n                <button className=\"px-6 py-1 rounded-full outline outline-1 outline-blue-700 font-serif\">Yes, I'm hiring</button>\n                <button className=\"px-6 py-1 rounded-full outline outline-1 outline-blue-700 font-serif\">No, not right now</button>\n            </div>\n        </div>\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
