    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\" class=\"dark overflow-hidden min-h-screen w-screen max-h-screen select-none\">\n\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>app:tailwinds-v3</title>\n  <link rel=\"stylesheet\" href=\"dist/output.css\" />\n  <link rel=\"stylesheet\" href=\"scrollbarsoverlay.css\" />\n  <style>\n    .os-scollbar-handle {\n      background-color: #fff !important;\n    }\n  </style>\n\n  <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/devicon/2.0/devicon.min.css\"\n    integrity=\"sha512-UXtfc3GQ+RF4dWu4Rv6hppzVajamLCOhoR5X8hfuYHedgarRXimhhhjNpsQQ3EQLWyeHTwlLcH3k+NNYifeHfA==\"\n    crossorigin=\"anonymous\" referrerpolicy=\"no-referrer\" />\n  <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/devicon/2.0/devicon-colors.min.css\"\n    integrity=\"sha512-MBJvf9Rav5eVlIXaSCKW7NUN8INmz5RhoNU4gGDLXbT58eGt5NGdcCn27tUJCQzrAstyjXFTB12EWNR71l3+7Q==\"\n    crossorigin=\"anonymous\" referrerpolicy=\"no-referrer\" />\n\n  <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/gh/mds-web/font@main/bundle-icon-ui.css\" />\n  <link href=\"\nhttps://cdn.jsdelivr.net/npm/vscode-codicons@0.0/dist/codicon.min.css\n\" rel=\"stylesheet\">\n</head>\n\n<body class=\"min-h-screen max-h-screen overflow-hidden\">\n  <div id=\"app\" class=\"max-h-screen w-screen overflow-\">\n    <div class=\"flex flex-row justify-start items-start content-start w-full overflow-hidden\">\n      <div\n        class=\"min-h-screen fixed overflow-hidden min-w-[325px] max-w-[325px] top-0 left-0 bg-[var(--bg-body)] text-[var(--text-body)] order-1 self-auto md:relative md:translate-0 flex flex-col border-r border-r-[var(--border-color)] md:min-w-[380px] md:max-w-full! md:flex-row\"\n        id=\"fileDrawer\">\n        <div\n          class=\"w-full flex items-center shrink-0 flex-row md:flex-col md:items-center min-h-[50px] md:w-[70px] md:border-r md:border-r-[var(--border-color)] md:h-screen text-[var(--text-secondary)] md:justify-start md:pb-4\"\n          id=\"drawerHeader\">\n          <div\n            class=\"w-full md:w-max *:cursor-pointer flex items-center shrink-0 flex-row md:flex-col h-full md:*:h-[4rem] *:relative *:transition-colors *:ease-in-out *:duration-200 *:mx-[0.525rem] *:md:my-0 *:md:mx-0\">\n            <div\n              class=\"w-[3rem] h-[4rem] md:h-[3rem] md:w-[4rem] text-2xl inline-flex items-center justify-center shrink-0\"\n              role=\"button\" aria-label=\"navigasi\" data-target=\"1\">\n              <i class=\"icodex-paper-airplane\"></i>\n            </div>\n            <div\n              class=\"w-[3rem] h-[4rem] md:h-[3rem] md:w-[4rem] text-2xl inline-flex items-center justify-center shrink-0 after:content-[''] after:w-full after:h-0.5 after:bg-[var(--text-primary)] after:absolute after:bottom-0 md:after:hidden md:before:content-[''] md:before:absolute md:before:left-0 md:before:top-0 md:before:h-full md:before:w-0.5 md:before:bg-[var(--text-primary)] text-[var(--text-primary)]\"\n              role=\"button\" aria-label=\"navigasi\" data-target=\"2\">\n              <i class=\"icodex-file-directory\"></i>\n            </div>\n            <div\n              class=\"w-[3rem] h-[4rem] md:h-[3rem] md:w-[4rem] text-2xl inline-flex items-center justify-center shrink-0\"\n              role=\"button\" aria-label=\"navigasi\" data-target=\"3\">\n              <i class=\"icodex-codescan\"></i>\n            </div>\n            <div\n              class=\"w-[3rem] h-[4rem] md:h-[3rem] md:w-[4rem] text-2xl inline-flex items-center justify-center shrink-0\"\n              role=\"button\" aria-label=\"navigasi\" data-target=\"4\">\n              <i class=\"icodex-git-branch\"></i>\n            </div>\n            <div\n              class=\"w-[3rem] h-[4rem] md:h-[3rem] md:w-[4rem] text-2xl inline-flex items-center justify-center md:mt-auto shrink-0\"\n              role=\"button\" aria-label=\"navigasi\" data-target=\"5\">\n              <i class=\"icodex-person\"></i>\n            </div>\n          </div>\n        </div>\n        <div id=\"dragHandle\"\n          class=\"absolute top-0 right-0 h-full w-1 bg-transparent hover:bg-neutral-800/50 cursor-col-resize hidden md:block\">\n        </div>\n        <!-- content drawer -->\n        <div class=\"w-full h-full min-h-0 hidden flex-col shrink\" data-content=\"1\">\n          <div class=\"capitalize px-4 text-inherit\">\n            welcome to search code d\n          </div>\n        </div>\n        <div class=\"w-full h-[100dvh] min-h-0 fle flex-col shrink flex\" id=\"treeView\" data-content=\"2\">\n          <div class=\"*:text-[var(--text-secondary)] flex flex-row w-full items-center min-h-[2.5rem] pl-4 pr-3\"\n            id=\"treeviewHeader\">\n            <span\n                class=\"inline-flex font-medium text-sm uppercase tracking-tight cursor-default\"\n                >files</span>\n            <div class=\"ml-auto *:cursor-pointer flex items-center shrink-0\">\n              <div class=\"w-[2.5rem] h-[2.5rem] inline-flex items-center justify-center\" aria-label=\"search\"\n                role=\"button\">\n                <i class=\"icodex-search-2 text-xl\"></i>\n              </div>\n              <div class=\"w-[2.5rem] h-[2.5rem] inline-flex items-center justify-center\" aria-label=\"currunt location\"\n                role=\"button\">\n                <i class=\"icodex-location text-lg\"></i>\n              </div>\n              <div class=\"w-[2.5rem] h-[2.5rem] inline-flex items-center justify-center\" aria-label=\"currunt location\"\n                role=\"button\">\n                <i class=\"icodex-file-added text-lg\"></i>\n              </div>\n              <div class=\"w-[2.5rem] h-[2.5rem] inline-flex items-center justify-center\" aria-label=\"currunt location\"\n                role=\"button\">\n                <i class=\"icodex-folder-plus text-xl\"></i>\n              </div>\n              <div class=\"w-[2.5rem] h-[2.5rem] inline-flex items-center justify-center\" aria-label=\"currunt location\"\n                role=\"button\">\n                <i class=\"icodex-kebab-horizontal text-2xl\"></i>\n              </div>\n            </div>\n          </div>\n          <div class=\"flex-1\" id=\"rootDir\">\n            <a draggable=\"true\"\n              class=\"w-full min-h-[40px] flex items-center pl-3 pr-3 *:inline-flex *:items-center cursor-pointer hover:bg-white/2 transition-colors ease-in-out duration-150 outline outline-transparent focus:outline-primary outline-offset-[-1px] focus:bg-primary/15\"\n              tabindex=\"0\">\n              <span\n                  class=\"codicon codicon-chevron-up text-base! rotate-90\"\n                ></span>\n              <span\n                  class=\"ml-1 whitespace-nowrap overflow-hidden text-ellipsis font-medium\"\n                  >HTML\n                </span>\n              <span\n                  class=\"icodex-kebab-horizontal text-2xl ml-auto shrink-0 basis-8 text-[var(--text-secondary)]\"\n                ></span>\n            </a>\n            <div class=\"flex-1\" id=\"dirContent1\">\n              <a draggable=\"true\" data-type=\"folder\"\n                class=\"w-full min-h-[40px] flex items-center pl-3 pr-3 *:inline-flex *:items-center cursor-pointer hover:bg-white/2 transition-colors ease-in-out duration-150 outline outline-transparent focus:outline-primary outline-offset-[-1px] focus:bg-primary/15\"\n                tabindex=\"0\">\n                <span\n                    class=\"w-2 min-h-[2.5rem] border-l border-l-[var(--border-color)] ml-[7px]\"\n                  ></span>\n                <span\n                    class=\"codicon codicon-chevron-left text-base! rotate-90\"\n                  ></span>\n                <span\n                    class=\"ml-1 whitespace-nowrap overflow-hidden text-ellipsis font-medium\"\n                    >assets\n                  </span>\n                <span\n                    class=\"icodex-kebab-horizontal text-2xl ml-auto shrink-0 basis-8 text-[var(--text-secondary)]\"\n                  ></span>\n              </a>\n              <a draggable=\"true\" data-type=\"file\"\n                class=\"w-full min-h-[40px] flex items-center pl-3 pr-3 *:inline-flex *:items-center cursor-pointer hover:bg-white/2 transition-colors ease-in-out duration-150 outline outline-transparent focus:outline-primary outline-offset-[-1px] focus:bg-primary/15\"\n                tabindex=\"0\">\n                <span\n                    class=\"w-2 min-h-[2.5rem] border-l border-l-[var(--border-color)] ml-[7px]\"\n                  ></span>\n                <span class=\"devicon devicon-html5-plain colored\"></span>\n                <span\n                    class=\"ml-1.5 whitespace-nowrap overflow-hidden text-ellipsis font-medium\"\n                    >index.html</span>\n                <span\n                    class=\"icodex-kebab-horizontal text-2xl ml-auto shrink-0 basis-8 text-[var(--text-secondary)]\"\n                  ></span>\n              </a>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"w-full h-full min-h-0 flex-col shrink hidden\" id=\"searchCode\" data-content=\"3\">\n          <div\n            class=\"*:text-[var(--text-secondary)] flex flex-row w-full items-center min-h-[51px] pl-4 pr-3 md:border-b-0\"\n            id=\"treeviewHeader\">\n            <span\n                class=\"inline-flex font-medium text-sm uppercase tracking-tight cursor-default\"\n                >search</span>\n            <div class=\"ml-auto *:cursor-pointer flex items-center shrink-0\">\n              <div class=\"w-[2.5rem] h-[3rem] inline-flex items-center justify-center\" aria-label=\"search\"\n                role=\"button\">\n                <i class=\"codicon codicon-regex text-xl\"></i>\n              </div>\n              <div class=\"w-[2.5rem] h-[3rem] inline-flex items-center justify-center\" aria-label=\"currunt location\"\n                role=\"button\">\n                <i class=\"codicon codicon-case-sensitive text-lg\"></i>\n              </div>\n              <div class=\"w-[2.5rem] h-[3rem] inline-flex items-center justify-center\" aria-label=\"currunt location\"\n                role=\"button\">\n                <i class=\"codicon codicon-whole-word\"></i>\n              </div>\n              <div class=\"w-[2.5rem] h-[3rem] inline-flex items-center justify-center\" aria-label=\"currunt location\"\n                role=\"button\">\n                <i class=\"codicon codicon-list-filter text-lg\"></i>\n              </div>\n              <div class=\"w-[2.5rem] h-[3rem] inline-flex items-center justify-center\" aria-label=\"currunt location\"\n                role=\"button\">\n                <i class=\"codicon codicon-arrow-swap text-xl\"></i>\n              </div>\n            </div>\n          </div>\n          <div class=\"capitalize px-4\">\n            <div class=\"w-full max-w-sm min-w-[200px]\">\n              <div class=\"relative flex items-center my-4\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"currentColor\"\n                  class=\"absolute w-5 h-5 top-2.5 left-2.5 text-[var(--text-secondary)]\">\n                  <path fill-rule=\"evenodd\"\n                    d=\"M10.5 3.75a6.75 6.75 0 1 0 0 13.5 6.75 6.75 0 0 0 0-13.5ZM2.25 10.5a8.25 8.25 0 1 1 14.59 5.28l4.69 4.69a.75.75 0 1 1-1.06 1.06l-4.69-4.69A8.25 8.25 0 0 1 2.25 10.5Z\"\n                    clip-rule=\"evenodd\" />\n                </svg>\n\n                <input\n                    class=\"w-full bg-secondary/40 placeholder:text-[var(--text-secondary)] text-[var(--text-body)] text-sm outline-[0.125rem] outline-offset-[-2px] outline-[var(--border-color)] rounded-xl pl-10 pr-3 py-2.5 transition duration-300 ease focus:outline-[var(--border-primary)] shadow-sm focus:shadow focus:bg-[var(--primary)]/5\"\n                    placeholder=\"Find Text\"\n                    type=\"text\"\n                  />\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div\n        class=\"min-h-screen max-h-screen overflow-hidden w-full flex-1 order-3 basis-0 grow shrink-1 self-auto bg-[var(--bg-body)] text-[var(--text-body)]\"\n        id=\"contentRight\">\n        <div\n          class=\"min-h-[50px] border-b border-b-[var(--border-color)] w-full flex items-center pl-2.5 md:px-0 text-[var(--text-secondary)]\">\n          <div class=\"flex flex-row flex-nowrap justify-start items-center content-start w-full min-h-[50px]\">\n            <div class=\"min-h-full min-w-max flex-1 order-1 basis-0 grow-0 shrink-0 self-auto items-center\">\n              <div aria-label=\"menu\" role=\"button\" class=\"min-w-max cursor-pointer md:hidden\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\"\n                  stroke=\"currentColor\" class=\"size-6\">\n                  <path stroke-linecap=\"round\" stroke-linejoin=\"round\"\n                    d=\"M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5\" />\n                </svg>\n              </div>\n            </div>\n            <div\n              class=\"min-h-[50px] min-w-[100px] flex-1 order-2 basis-60 grow shrink-0 self-auto px-2.5 flex items-center\">\n              <div style=\"\n                    overflow-x: scroll;\n                    max-width: min-content;\n                    scrollbar-width: none;\n                  \">\n                <nav class=\"text-sm font-medium w-full\" aria-label=\"breadcrumb\">\n                  <ol class=\"flex flex-nowrap items-center gap-1 shrink-0 leading-4\">\n                    <li class=\"flex items-center gap-1\">\n                      <a draggable=\"false\" href=\"#\" class=\"select-none inline-flex items-center font-[600]\">dist</a>\n                      <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"\n                        stroke-width=\"2\" stroke=\"currentColor\" class=\"size-4 mt-0.5\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"m8.25 4.5 7.5 7.5-7.5 7.5\" />\n                      </svg>\n                    </li>\n                    <li class=\"flex items-center gap-1\">\n                      <a draggable=\"false\" href=\"#\" class=\"select-none inline-flex items-center font-[600]\">public</a>\n                      <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"\n                        stroke-width=\"2\" stroke=\"currentColor\" class=\"size-4 mt-0.5\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"m8.25 4.5 7.5 7.5-7.5 7.5\" />\n                      </svg>\n                    </li>\n                    <li class=\"flex items-center leading-4 gap-1 font-medium select-none\" aria-current=\"page\">\n                      <i class=\"devicon-html5-plain colored mt-0.5\"></i>\n                      index.html\n                    </li>\n                  </ol>\n                </nav>\n              </div>\n            </div>\n            <div\n              class=\"min-h-[50px] min-w-min justify-center flex-1 order-3 basis-24 grow-0 shrink-0 self-auto cursor-default\">\n              <div class=\"inline-flex items-center w-[2.5rem] h-[3rem] justify-center cursor-pointer\" aria-label=\"run\"\n                role=\"button\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"currentColor\" class=\"size-5\">\n                  <path fill-rule=\"evenodd\"\n                    d=\"M10.5 3.75a6.75 6.75 0 1 0 0 13.5 6.75 6.75 0 0 0 0-13.5ZM2.25 10.5a8.25 8.25 0 1 1 14.59 5.28l4.69 4.69a.75.75 0 1 1-1.06 1.06l-4.69-4.69A8.25 8.25 0 0 1 2.25 10.5Z\"\n                    clip-rule=\"evenodd\" />\n                </svg>\n              </div>\n              <div class=\"inline-flex items-center min-w-[2.5rem] h-[3rem] justify-center cursor-pointer\"\n                aria-label=\"run\" role=\"button\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"currentColor\"\n                  class=\"size-5 text-emerald-500\">\n                  <path fill-rule=\"evenodd\"\n                    d=\"M4.5 5.653c0-1.427 1.529-2.33 2.779-1.643l11.54 6.347c1.295.712 1.295 2.573 0 3.286L7.28 19.99c-1.25.687-2.779-.217-2.779-1.643V5.653Z\"\n                    clip-rule=\"evenodd\" />\n                </svg>\n              </div>\n            </div>\n          </div>\n        </div>\n        s\n      </div>\n      <!-- content right end -->\n    </div>\n  </div>\n\n  <!-- pastikan sudah include GoldenLayout CSS & JS -->\n\n  <script src=\"../node_modules/interactjs/dist/interact.min.js\"></script>\n  <script>\n    const resizeDrawer = () => {\n        const handle = document.getElementById('dragHandle');\n        let interactInstance = null; // simpan instance biar bisa dimatikan\n\n        try {\n          if (typeof interact !== 'function') {\n            const lang = navigator.language.toLowerCase();\n            if (lang.startsWith('id')) {\n              throw 'interact belum didefinisikan sebelum digunakan.\\nPastikan link CDN / path lokal benar.\\nhttps://interactjs.io/';\n            } else if (lang.startsWith('en')) {\n              throw 'interact has not been defined before use.\\nCheck CDN/local path.\\nhttps://interactjs.io/';\n            }\n          }\n\n          function query() {\n            return window.matchMedia('(min-width: 768px)').matches;\n          }\n\n          function enableInteract() {\n            if (interactInstance) return; // sudah aktif → jangan double\n            interactInstance = interact('#fileDrawer').resizable({\n              edges: { right: '#dragHandle' },\n              listeners: {\n                start() {\n                  handle.classList.remove('bg-transparent');\n                  handle.classList.add('bg-neutral-700/50', 'w-1.5');\n                },\n                move(event) {\n                  event.target.style.width = event.rect.width + 'px';\n                },\n                end() {\n                  handle.classList.remove('bg-neutral-700/50', 'w-1.5');\n                  handle.classList.add('bg-transparent');\n                },\n              },\n              modifiers: [\n                interact.modifiers.restrictSize({\n                  min: { width: 325 },\n                  max: { width: window.innerWidth - 325 },\n                }),\n              ],\n            });\n            console.log('Interact diaktifkan');\n          }\n\n          function disableInteract() {\n            if (!interactInstance) return;\n            interact('#fileDrawer').unset(); // hapus semua listener resizable\n            interactInstance = null;\n            console.log('Interact dimatikan');\n          }\n\n          // pertama kali jalan\n          if (query()) {\n            enableInteract();\n          } else {\n            disableInteract();\n          }\n\n          // saat resize\n          window.addEventListener('resize', () => {\n            if (query()) {\n              enableInteract();\n            } else {\n              disableInteract();\n            }\n          });\n        } catch (e) {\n          console.warn(e);\n        }\n      };\n\n      resizeDrawer();\n  </script>\n\n  <script>\n    const tabsBtn = document.querySelectorAll('[data-target]');\n      const contents = document.querySelectorAll('[data-content]');\n\n      tabsBtn.forEach(btn => {\n        btn.addEventListener('click', () => {\n          // ambil target id dari tombol\n          const tabId = btn.dataset.target;\n\n          // sembunyikan semua konten\n          contents.forEach(content => {\n            content.classList.add('hidden'); // atau remove \"flex\"\n          });\n\n          // tampilkan konten sesuai target\n          const targetContent = document.querySelector(\n            `[data-content=\"${tabId}\"]`,\n          );\n          if (targetContent) {\n            targetContent.classList.remove('hidden');\n            targetContent.classList.add('flex'); // kalau memang mau pakai flex\n          }\n\n          // (opsional) aktifkan tombol tab\n          tabsBtn.forEach(b => {\n            b.classList.remove(\n              \"after:content-['']\",\n              'after:w-full',\n              'after:h-0.5',\n              'after:bg-[var(--text-primary)]',\n              'after:absolute',\n              'after:bottom-0',\n              'md:after:hidden',\n              \"md:before:content-['']\",\n              'md:before:absolute',\n              'md:before:left-0',\n              'md:before:top-0',\n              'md:before:h-full',\n              'md:before:w-0.5',\n              'md:before:bg-[var(--text-primary)]',\n              'text-[var(--text-primary)]',\n            );\n          });\n          btn.classList.add(\n            \"after:content-['']\",\n            'after:w-full',\n            'after:h-0.5',\n            'after:bg-[var(--text-primary)]',\n            'after:absolute',\n            'after:bottom-0',\n            'md:after:hidden',\n            \"md:before:content-['']\",\n            'md:before:absolute',\n            'md:before:left-0',\n            'md:before:top-0',\n            'md:before:h-full',\n            'md:before:w-0.5',\n            'md:before:bg-[var(--text-primary)]',\n            'text-[var(--text-primary)]',\n          );\n        });\n      });\n  </script>\n</body>\n\n</html>"
  }
}
