.com/photo-1630587148265-761cbd139043?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=1080\"\n                 className=\"w-full h-64 sm object-cover transition-transform duration-300 hover105\" alt=\"Square image\" />\n          </div>\n    \n          \n          <div className=\"sm2 relative overflow-hidden rounded-lg shadow-lg cursor-pointer\">\n            <img src=\"https://images.unsplash.com/photo-1520473378652-85d9c4aee6cf?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=1080\"\n                 className=\"w-full h-64 sm object-cover transition-transform duration-300 hover105\" alt=\"Square image\" />\n          </div>\n    \n          \n          <div className=\"sm2 relative overflow-hidden rounded-lg shadow-lg cursor-pointer\">\n            <img src=\"https://images.unsplash.com/photo-1618215650148-e8e61eae521c?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&w=1080\"\n                 className=\"w-full h-64 sm object-cover transition-transform duration-300 hover105\" alt=\"Square image\" />\n          </div>\n    \n        </div>\n    \n      </div>\n      \n    <a href=\"https://discord.gg/95CveWrbK8\"\n       target=\"_blank\"\n       rel=\"noopener\"\n       className=\"absolute bottom-4 right-4 flex items-center gap-2 text-white px-4 py-2 rounded-full shadow-lg hover500 transition-all duration-300 z-50 backdrop-blur-md\">\n      \n      <span className=\"text-sm font-medium\">Made by Chandrika</span>\n    \n      \n      <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 245 240\" className=\"w-5 h-5 fill-white\">\n        <path d=\"M104.4 104.9c-5.7 0-10.2 5-10.2 11.1s4.6 11.1 10.2 11.1c5.7 0 10.2-5 10.2-11.1.1-6.1-4.5-11.1-10.2-11.1zm36.2 0c-5.7 0-10.2 5-10.2 11.1s4.6 11.1 10.2 11.1c5.7 0 10.2-5 10.2-11.1s-4.5-11.1-10.2-11.1z\"/>\n        <path d=\"M189.5 20h-134C34.3 20 20 34.3 20 52.5v135c0 18.2 14.3 32.5 32.5 32.5h113.4l-5.3-18.3 12.8 11.8 12.1 11.1 21.6 19V52.5c-.1-18.2-14.4-32.5-32.6-32.5zM163 155s-4.6-5.5-8.4-10.3c16.7-4.7 23.1-15.1 23.1-15.1-5.2 3.4-10.1