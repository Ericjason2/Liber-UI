\n        <p class=\\\"text-gray-300 mb-8 text-lg\\\">\\n          Join our vibrant community of learners and developers. Get help, share knowledge, and grow together.\\n        </p>\\n        <a href=\\\"https://hitesh.ai/discord\\\"\\n          class=\\\"bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-8 rounded-full hover-scale transition inline-flex items-center gap-2\\\">\\n          <i class=\\\"fab fa-discord\\\"></i> Join our Discord\\n        </a>\\n      </div>\\n    </div>\\n  </section>\\n\\n  <!-- Footer -->\\n  <footer class=\\\"py-12 px-4 sm:px-8 lg:px-16 text-center\\\">\\n    <div class=\\\"max-w-4xl mx-auto\\\">\\n      <div class=\\\"flex justify-center mb-6\\\">\\n        <img src=\\\"https://docs.chaicode.com/_astro/chai-gray.BsQ6Sk6A_Z2kh8Da.webp\\\"\\n                     alt=\\\"ChaiCode Logo\\\"\\n                     class=\\\"h-12 w-auto opacity-80\\\">\\n      </div>\\n      <h3 class=\\\"text-2xl font-bold mb-4\\\">Brought to you by ChaiCode</h3>\\n      <p class=\\\"text-gray-400 mb-8 max-w-2xl mx-auto\\\">\\n        Chai aur Code is an unique initiative by Hitesh Choudhary where he mentors people who want to learn programming\\n        and grow in the field.\\n      </p>\\n      <a href=\\\"https://chaicode.com/\\\"\\n        class=\\\"inline-block border border-amber-500 text-amber-500 hover:bg-amber-500 hover:text-gray-900 font-medium py-2 px-6 rounded-full transition\\\">\\n        Learn about ChaiCode\\n      </a>\\n      <div class=\\\"mt-8 pt-8 border-t border-gray-800\\\">\\n        <div class=\\\"flex justify-center space-x-6 mb-4\\\">\\n          <a href=\\\"#\\\" class=\\\"text-gray-400 hover:text-amber-400 transition\\\">\\n            <i class=\\\"fab fa-twitter text-2xl\\\"></i>\\n          </a>\\n          <a href=\\\"#\\\" class=\\\"text-gray-400 hover:text-amber-400 transition\\\">\\n            <i class=\\\"fab fa-github text-2xl\\\"></i>\\n          </a>\\n          <a href=\\\"#\\\" class=\\\"text-gray-400 hover:text-amber-400 transition\\\">\\n            <i class=\\\"fab fa-youtube text-2xl\\\"></i>\\n          </a>\\n          <a href=\\\"#\\\" class=\\\"text-gray-400 hover:text-amber-400 transition\\\">\\n            <i class=\\\"fab fa-linkedin text-2xl\\\"></i>\\n          </a>\\n        </div>\\n        <p class=\\\"text-gray-500 text-sm\\\">\\n          © 2023 ChaiCode. All rights reserved.\\n        </p>\\n      </div>\\n    </div>\\n  </footer>\\n\\n  <!-- Mobile Menu (hidden by default) -->\\n  <div id=\\\"mobileMenu\\\" class=\\\"fixed inset-0 bg-gray-900 z-50 hidden flex-col items-center justify-center space-y-8\\\">\\n    <button id=\\\"closeMenu\\\" class=\\\"absolute top-6 right-6 text-3xl\\\">\\n            <i class=\\\"fas fa-times\\\"></i>\\n        </button>\\n    <a href=\\\"#\\\" class=\\\"text-2xl hover:text-amber-400 transition\\\">Docs</a>\\n    <a href=\\\"#\\\" class=\\\"text-2xl hover:text-amber-400 transition\\\">Tutorials</a>\\n    <a href=\\\"#\\\" class=\\\"text-2xl hover:text-amber-400 transition\\\">Community</a>\\n    <a href=\\\"#\\\" class=\\\"text-2xl hover:text-amber-400 transition\\\">About</a>\\n  </div>\\n\\n  \\n</body>\\n\\n</html>\" }} />\n  );\n}\n",
