    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Home | ChaiCode</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n  <style>\n    .gradient-text {\n      background: linear-gradient(90deg, #f59e0b, #ef4444);\n      -webkit-background-clip: text;\n      background-clip: text;\n      color: transparent;\n    }\n\n    .hover-scale {\n      transition: transform 0.3s ease;\n    }\n\n    .hover-scale:hover {\n      transform: scale(1.05);\n    }\n  </style>\n</head>\n\n<body class=\"bg-gray-900 text-gray-100 font-sans min-h-screen\">\n  <!-- Header/Navigation -->\n  <header class=\"py-6 px-4 sm:px-8 lg:px-16\">\n    <div class=\"flex justify-between items-center\">\n      <div class=\"flex items-center space-x-2\">\n        <img src=\"https://docs.chaicode.com/_astro/chai-white.DwCnUyBG_Zxcape.webp\" alt=\"Chai Logo\" class=\"h-10 w-auto\">\n        <span class=\"text-xl font-bold\">ChaiCode</span>\n      </div>\n      <nav class=\"hidden md:flex space-x-8\">\n        <a href=\"#\" class=\"hover:text-amber-400 transition\">Docs</a>\n        <a href=\"#\" class=\"hover:text-amber-400 transition\">Tutorials</a>\n        <a href=\"#\" class=\"hover:text-amber-400 transition\">Community</a>\n        <a href=\"#\" class=\"hover:text-amber-400 transition\">About</a>\n      </nav>\n      <button class=\"md:hidden text-2xl\">\n                <i class=\"fas fa-bars\"></i>\n            </button>\n    </div>\n  </header>\n\n  <!-- Hero Section -->\n  <section class=\"py-16 px-4 sm:px-8 lg:px-16 text-center\">\n    <div class=\"max-w-4xl mx-auto\">\n      <h1 class=\"text-4xl sm:text-5xl md:text-6xl font-bold mb-6\">\n        Docs You'll <span class=\"gradient-text\">Actually Read</span>\n      </h1>\n      <p class=\"text-xl sm:text-2xl text-gray-300 mb-10 max-w-3xl mx-auto\">\n        Next-gen docs that builds reading habits into your workflow.\n      </p>\n      <div class=\"flex flex-col sm:flex-row justify-center gap-4\">\n        <a href=\"https://docs.chaicode.com/youtube/getting-started/\"\n          class=\"bg-amber-500 hover:bg-amber-600 text-gray-900 font-bold py-3 px-8 rounded-full hover-scale transition\">\n          Start Learning\n        </a>\n        <a href=\"https://courses.chaicode.com/learn\"\n          class=\"bg-gray-700 hover:bg-gray-600 text-white font-bold py-3 px-8 rounded-full hover-scale transition flex items-center justify-center gap-2\">\n          <i class=\"fas fa-play\"></i> Watch Tutorials\n        </a>\n      </div>\n    </div>\n  </section>\n\n  <!-- Community Section -->\n  <section class=\"py-16 px-4 sm:px-8 lg:px-16 bg-gray-800 rounded-3xl mx-4 sm:mx-8 lg:mx-16\">\n    <div class=\"max-w-6xl mx-auto flex flex-col md:flex-row items-center gap-8\">\n      <div class=\"md:w-1/2\">\n        <img src=\"https://docs.chaicode.com/_astro/houston-love.BttrNCcZ_rVNmG.webp\"\n                     alt=\"Community\"\n                     class=\"rounded-2xl shadow-xl w-full max-w-md mx-auto\">\n      </div>\n      <div class=\"md:w-1/2 text-center md:text-left\">\n        <h2 class=\"text-3xl sm:text-4xl font-bold mb-6\">\n          Have a question or want to get involved..?\n        </h2>\n        <p class=\"text-gray-300 mb-8 text-lg\">\n          Join our vibrant community of learners and developers. Get help, share knowledge, and grow together.\n        </p>\n        <a href=\"https://hitesh.ai/discord\"\n          class=\"bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-8 rounded-full hover-scale transition inline-flex items-center gap-2\">\n          <i class=\"fab fa-discord\"></i> Join our Discord\n        </a>\n      </div>\n    </div>\n  </section>\n\n  <!-- Footer -->\n  <footer class=\"py-12 px-4 sm:px-8 lg:px-16 text-center\">\n    <div class=\"max-w-4xl mx-auto\">\n      <div class=\"flex justify-center mb-6\">\n        <img src=\"https://docs.chaicode.com/_astro/chai-gray.BsQ6Sk6A_Z2kh8Da.webp\"\n                     alt=\"ChaiCode Logo\"\n                     class=\"h-12 w-auto opacity-80\">\n      </div>\n      <h3 class=\"text-2xl font-bold mb-4\">Brought to you by ChaiCode</h3>\n      <p class=\"text-gray-400 mb-8 max-w-2xl mx-auto\">\n        Chai aur Code is an unique initiative by Hitesh Choudhary where he mentors people who want to learn programming\n        and grow in the field.\n      </p>\n      <a href=\"https://chaicode.com/\"\n        class=\"inline-block border border-amber-500 text-amber-500 hover:bg-amber-500 hover:text-gray-900 font-medium py-2 px-6 rounded-full transition\">\n        Learn about ChaiCode\n      </a>\n      <div class=\"mt-8 pt-8 border-t border-gray-800\">\n        <div class=\"flex justify-center space-x-6 mb-4\">\n          <a href=\"#\" class=\"text-gray-400 hover:text-amber-400 transition\">\n            <i class=\"fab fa-twitter text-2xl\"></i>\n          </a>\n          <a href=\"#\" class=\"text-gray-400 hover:text-amber-400 transition\">\n            <i class=\"fab fa-github text-2xl\"></i>\n          </a>\n          <a href=\"#\" class=\"text-gray-400 hover:text-amber-400 transition\">\n            <i class=\"fab fa-youtube text-2xl\"></i>\n          </a>\n          <a href=\"#\" class=\"text-gray-400 hover:text-amber-400 transition\">\n            <i class=\"fab fa-linkedin text-2xl\"></i>\n          </a>\n        </div>\n        <p class=\"text-gray-500 text-sm\">\n          © 2023 ChaiCode. All rights reserved.\n        </p>\n      </div>\n    </div>\n  </footer>\n\n  <!-- Mobile Menu (hidden by default) -->\n  <div id=\"mobileMenu\" class=\"fixed inset-0 bg-gray-900 z-50 hidden flex-col items-center justify-center space-y-8\">\n    <button id=\"closeMenu\" class=\"absolute top-6 right-6 text-3xl\">\n            <i class=\"fas fa-times\"></i>\n        </button>\n    <a href=\"#\" class=\"text-2xl hover:text-amber-400 transition\">Docs</a>\n    <a href=\"#\" class=\"text-2xl hover:text-amber-400 transition\">Tutorials</a>\n    <a href=\"#\" class=\"text-2xl hover:text-amber-400 transition\">Community</a>\n    <a href=\"#\" class=\"text-2xl hover:text-amber-400 transition\">About</a>\n  </div>\n\n  <script>\n    // Mobile menu toggle\n        document.querySelector('header button').addEventListener('click', function() {\n            document.getElementById('mobileMenu').classList.remove('hidden');\n            document.body.style.overflow = 'hidden';\n        });\n\n        document.getElementById('closeMenu').addEventListener('click', function() {\n            document.getElementById('mobileMenu').classList.add('hidden');\n            document.body.style.overflow = 'auto';\n        });\n  </script>\n</body>\n\n</html>"
  }
