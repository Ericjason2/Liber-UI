he modern individual.</p>\n            </div>\n\n            <!-- Products Grid -->\n            <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8\">\n                \n                <!-- Product 1 -->\n                <article class=\"product-card group p-0\">\n                    <div class=\"relative overflow-hidden bg-gray-200 aspect-[3/4] border-b-2 border-black\">\n                        <img \n                            src=\"https://placehold.co/600x800/e5e5e5/000000?text=WILD+JOURNEY\" \n                            alt=\"Wild Journey T-shirt\" \n                            class=\"w-full h-full object-cover\"\n                            loading=\"lazy\"\n                        />\n                    </div>\n                    \n                    <div class=\"p-6\">\n                        <div class=\"flex items-start justify-between mb-4\">\n                            <div>\n                                <div class=\"category-tag inline-block mb-2\">T-SHIRT</div>\n                                <h3 class=\"text-2xl font-bold\">WILD JOURNEY</h3>\n                            </div>\n                            <div class=\"price-tag text-right\">\n                                <span class=\"text-lg\">$35</span>\n                            </div>\n                        </div>\n                        \n                        <div class=\"flex items-center justify-between\">\n                            <div class=\"flex items-center space-x-1\">\n                                <i data-lucide=\"star\" class=\"w-4 h-4 fill-black text-black\"></i>\n                                <i data-lucide=\"star\" class=\"w-4 h-4 fill-black text-black\"></i>\n                                <i data-lucide=\"star\" class=\"w-4 h-4 fill-black text-black\"></i>\n                                <i data-lucide=\"star\" class=\"w-4 h-4 fill-black text-black\"></i>\n                                <i data-lucide=\"star\" class=\"w-4 h-4 text-