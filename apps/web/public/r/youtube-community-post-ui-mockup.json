svg class=\"w-5 h-5\" fill=\"currentColor\" viewBox=\"0 0 20 20\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z\"></path></svg>\n          </button>\n      </div>\n\n      <!-- Post Content -->\n      <div\n        class=\"text-sm text-yt-light-text-primary dark:text-yt-dark-text-primary mb-3 break-words whitespace-pre-wrap\">\n        <p>Quick update! We're working on a new series exploring advanced CSS techniques. What topics would you love to see covered? 🤔 Let us know in the comments! 👇<br><br>Also, thanks for 500K subscribers! 🎉</p>\n      </div>\n\n      <!-- Media (Optional - Example Image) -->\n      <div class=\"mb-3 rounded-lg overflow-hidden\">\n        <img src=\"https://images.unsplash.com/photo-1542831371-29b0f74f9713?ixlib=rb-1.2.1&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=crop&w=870&q=80\"\n                 alt=\"Post media content\" class=\"w-full object-cover\">\n      </div>\n\n      <!-- Action Bar -->\n      <div class=\"flex items-center space-x-4 text-yt-light-text-secondary dark:text-yt-dark-text-secondary\">\n        <div class=\"flex items-center space-x-1\">\n          <button aria-label=\"Like this post\" class=\"hover:bg-gray-100 dark:hover:bg-gray-700 rounded-full p-1.5\">\n                    <svg class=\"w-5 h-5\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"2\" stroke=\"currentColor\"><path xmlns=\"http://www.w3.org/2000/svg\" d=\"M8 10V20M8 10L4 9.99998V20L8 20M8 10L13.1956 3.93847C13.6886 3.3633 14.4642 3.11604 15.1992 3.29977L15.2467 3.31166C16.5885 3.64711 17.1929 5.21057 16.4258 6.36135L14 9.99998H18.5604C19.8225 9.99998 20.7691 11.1546 20.5216 12.3922L19.3216 18.3922C19.1346 19.3271 18.3138 20 17.3604 20L8 20\" stroke=\"#000000\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n                </button>\n          <span class=\"text-xs font-medium\">3.1K</span>\n        </div>\n        <button aria-label=\"View comments\" class=\"flex items-center space-x-1 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-full p-1.5 px-2\">\n                <svg class=\"w-5 h-5\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M2.25 12.76c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.076-4.076a1.526 1.526 0 011.037-.443 48.282 48.282 0 005.68-.494c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z\" /></svg>\n                 <span class=\"text-xs font-medium\">112</span>\n            </button>\n        <button aria-label=\"Share this post\" class=\"hover:bg-gray-100 dark:hover:bg-gray-700 rounded-full p-1.5 ml-auto\">\n                <svg class=\"w-5 h-5\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186l9.566-5.314m-9.566 7.5l9.566 5.314m0 0a2.25 2.25 0 103.935 2.186 2.25 2.25 0 00-3.935-2.186zm0-12.814a2.25 2.25 0 103.933-2.185 2.25 2.25 0 00-3.933 2.185z\" /></svg>\n            </button>\n      </div>\n\n      <!-- Add Comment Section -->\n      <div class=\"mt-4 pt-3 border-t yt-light-border dark:yt-dark-border flex items-center space-x-3\">\n        <img class=\"w-8 h-8 rounded-full object-cover flex-shrink-0\"\n                 src=\"https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?ixlib=rb-1.2.1&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=crop&w=80&q=80\"\n                 alt=\"Your Avatar\">\n        <p class=\"text-sm text-yt-light-text-secondary dark:text-yt-dark-text-secondary flex-grow cursor-text\">\n          Add a comment...\n        </p>\n      </div>\n\n    </div>\n  </div>\n\n</body>"
