dden\">\r\n                    <img src=\"https://picsum.photos/seed/picsum/400/400\" alt=\"Project Image\" class=\"w-full h-64 object-cover\">\r\n                    <div class=\"p-6\">\r\n                        <h3 class=\"text-2xl font-bold mb-4\">Project Title</h3>\r\n                        <p class=\"text-gray-700\">This project is so cool, even my cat approves! 🐱</p>\r\n                        <a href=\"#\" class=\"block text-blue-600 hover:underline mt-4\">Check it out! 🚀</a>\r\n                    </div>\r\n                </div>\r\n                <div class=\"bg-white rounded-lg shadow-md overflow-hidden\">\r\n                    <img src=\"https://picsum.photos/seed/picsum/400/400\" alt=\"Project Image\" class=\"w-full h-64 object-cover\">\r\n                    <div class=\"p-6\">\r\n                        <h3 class=\"text-2xl font-bold mb-4\">Project Title</h3>\r\n                        <p class=\"text-gray-700\">This project is so cool, even my cat approves! 🐱</p>\r\n                        <a href=\"#\" class=\"block text-blue-600 hover:underline mt-4\">Check it out! 🚀</a>\r\n                    </div>\r\n                </div>\r\n                <div class=\"bg-white rounded-lg shadow-md overflow-hidden\">\r\n                    <img src=\"https://picsum.photos/seed/picsum/400/400\" alt=\"Project Image\" class=\"w-full h-64 object-cover\">\r\n                    <div class=\"p-6\">\r\n                        <h3 class=\"text-2xl font-bold mb-4\">Project Title</h3>\r\n                        <p class=\"text-gray-700\">This project is so cool, even my cat approves! 🐱</p>\r\n                        <a href=\"#\" class=\"block text-blue-600 hover:underline mt-4\">Check it out! 🚀</a>\r\n                    </div>\r\n                </div>\r\n                <!-- Repeat for other projects -->\r\n            </div>\r\n        </div>\r\n    </section>\r\n\r\n    <!-- Contact Section -->\r\n    <section class=\"bg-gray-200 py-16\">\r\n        <div class=\"container mx-auto px-4\">\r\n            <h2 class=\"text-4xl font-bold mb-8 text-center\">✉️ Get in Touch!</h2>\r\n            <div class=\"max-w-md mx-auto\">\r\n                <form  action=\"https://fabform.io/f/xxxxx\" method=\"post\" class=\"space-y-4\">\r\n<div>\r\n                        <label for=\"name\" class=\"block font-bold mb-2\">Your Name</label>\r\n                        <input type=\"text\" id=\"name\" name=\"name\" class=\"w-full border-gray-300 rounded-md px-4 py-2 focus:outline-none focus:border-blue-500\" placeholder=\"Enter your name\">\r\n                    </div>\r\n                    <div>\r\n                        <label for=\"email\" class=\"block font-bold mb-2\">Your Email</label>\r\n                        <input type=\"email\" id=\"email\" name=\"email\" class=\"w-full border-gray-300 rounded-md px-4 py-2 focus:outline-none focus:border-blue-500\" placeholder=\"Enter your email\">\r\n                    </div>\r\n                    <div>\r\n                        <label for=\"message\" class=\"block font-bold mb-2\">Your Message</label>\r\n                        <textarea name=\"message\" id=\"message\" rows=\"4\" class=\"w-full border-gray-300 rounded-md px-4 py-2 focus:outline-none focus:border-blue-500\" placeholder=\"Enter your message\"></textarea>\r\n                    </div>\r\n                    <button type=\"submit\" class=\"bg-blue-600 text-white font-bold py-2 px-4 rounded-md hover:bg-blue-700 transition duration-300\">Send Message 🚀</button>\r\n                </form>\r\n                <p class=\"mt-4 text-center\">Prefer email? Send me an email <a target=_blank\" href=\"https://veilmail.io/irish-geoff\" class=\"text-blue-600 font-bold hover:underline\">https://veilmail.io/irish-geoff</a> instead!</p>\r\n            </div>\r\n        </div>\r\n    </section>\r\n\r\n    <!-- Footer -->\r\n    <footer class=\"bg-gray-800 text-white py-8\">\r\n        <div class=\"container mx-auto px-4 text-center\">\r\n       