tton className=\"bg-gradient-to-r from-pink-500 to-purple-500 hover600 hover600 text-white font-bold py-2 px-4 rounded-full transition duration-300 ease-in-out transform hover105 neon-border\">\n                    Contact Me\n                </button>\n                <button className=\"bg-gradient-to-r from-blue-500 to-teal-500 hover600 hover600 text-white font-bold py-2 px-4 rounded-full transition duration-300 ease-in-out transform hover105 neon-border\">\n                    View Portfolio\n                </button>\n            </div>\n        </div>\n    </body>\n    </div>\n  );\n}\n",
