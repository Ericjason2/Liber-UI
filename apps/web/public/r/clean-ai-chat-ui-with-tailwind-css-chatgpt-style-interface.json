      "content": "import * as React from \"react\"\n\nfunction CleanAiChatUiWithTailwindCssChatgptStyleInterface({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"clean-ai-chat-ui-with-tailwind-css-chatgpt-style-interface\"\n      className={className}\n      dangerouslySetInnerHTML={{ __html: \"<!DOCTYPE html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"UTF-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\" />\\n  <title>AI Assistant</title>\\n\\n  \\n  <link href=\\\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap\\\" rel=\\\"stylesheet\\\">\\n\\n  <style>\\n    body { font-family: Inter, system-ui, sans-serif; }\\n  </style>\\n</head>\\n\\n<body class=\\\"bg-[#0e0e10] text-[#ececf1]\\\">\\n\\n  <!-- App shell -->\\n  <div class=\\\"min-h-screen flex flex-col\\\">\\n\\n    <!-- Header -->\\n    <header class=\\\"h-16 flex items-center px-6 border-b border-white/10\\\">\\n      <div class=\\\"max-w-3xl w-full mx-auto flex items-center justify-between\\\">\\n        <span class=\\\"text-sm font-medium\\\">AI Assistant</span>\\n        <span class=\\\"text-xs text-white/40\\\">Online</span>\\n      </div>\\n    </header>\\n\\n    <!-- Chat stream -->\\n    <main id=\\\"chat\\\"\\n      class=\\\"flex-1 overflow-y-auto px-6 py-16 space-y-16\\\"\\n    >\\n      <!-- Assistant message -->\\n      <div class=\\\"max-w-3xl mx-auto\\\">\\n        <p class=\\\"text-sm leading-relaxed text-white/90\\\">\\n          Welcome.<br><br>\\n          Ask anything — engineering, architecture, or reasoning.<br>\\n          Responses are clear, structured, and calm.\\n        </p>\\n      </div>\\n    </main>\\n\\n    <!-- Composer -->\\n    <footer class=\\\"sticky bottom-0 bg-[#0e0e10]\\\">\\n      <div class=\\\"max-w-3xl mx-auto px-6 pb-10 pt-6\\\">\\n        <form id=\\\"form\\\"\\n          class=\\\"flex items-end gap-4 rounded-2xl bg-[#1a1a1c] px-5 py-4\\\"\\n        >\\n          <textarea\\n            id=\\\"input\\\"\\n            rows=\\\"1\\\"\\n            placeholder=\\\"Message AI assistant…\\\"\\n            class=\\\"flex-1 resize-none bg-transparent outline-none text-sm leading-relaxed placeholder-white/40\\\"\\n          ></textarea>\\n\\n          <button\\n            class=\\\"px-4 py-2 rounded-xl bg-white text-black text-sm font-medium\\\"\\n          >\\n            Send\\n          </button>\\n        </form>\\n\\n        <p class=\\\"mt-4 text-xs text-center text-white/30\\\">\\n          UI-only prototype • No backend connected\\n        </p>\\n      </div>\\n    </footer>\\n\\n  </div>\\n\\n  \\n\\n</body>\\n</html>\" }}\n      {...props}\n    />\n  )\n}\n\nexport { CleanAiChatUiWithTailwindCssChatgptStyleInterface }\n",
