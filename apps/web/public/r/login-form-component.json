      "content": "/**\n * Component: Login Form Component\n * Author: @r-thapa (https://tailwindflex.com/@r-thapa)\n * Source: https://tailwindflex.com/@r-thapa/login-form-component\n * Attribution: Créé par @r-thapa sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function LoginFormComponent() {\n  return (\n    <div>\n    <div className=\"contain py-16\">\n      <div className=\"max-w-lg mx-auto shadow px-6 py-7 rounded overflow-hidden\">\n        <h2 className=\"text-2xl uppercase font-medium mb-1\">Login</h2>\n        <p className=\"text-gray-600 mb-6 text-sm\">Welcome! So good to have you back!</p>\n        <form autoComplete=\"off\">\n          <p className=\"text-red-500\"></p>\n          <div className=\"space-y-2\">\n            <div><label htmlFor=\"email\" className=\"text-gray-600 mb-2 block\"></label>Email address<input type=\"email\" name=\"email\" id=\"email\" className=\"block w-full border border-gray-300 px-4 py-3 text-gray-600 text-sm rounded focus0 focus500 placeholder-gray-400\" placeholder=\"youremail.@domain.com\" />\n            </div>\n          </div>\n          <div className=\"space-y-2\">\n            <div><label htmlFor=\"password\" className=\"text-gray-600 mb-2 block\"></label>Password<div className=\"relative\"><input type=\"password\" name=\"password\" id=\"password\" className=\"block w-full border border-gray-300 px-4 py-3 text-gray-600 text-sm rounded focus0 focus500 placeholder-gray-400\" placeholder=\"***********\" />\n                <div\n                  className=\"cursor-pointer absolute inset-y-0 right-0 flex items-center px-8 text-gray-600 border-l border-gray-300\">\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" strokeWidth=\"1.5\"\n                    stroke=\"currentColor\" className=\"w-5 h-5\">\n                    <path strokeLinecap=\"round\" strokeLinejoin=\"round\"\n                      d=\"M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z\">\n                    </path>\n                    <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M15 12a3 3 0 11-6 0 3 3 0 016 0z\"></path>\n                  </svg>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div className=\"mt-4\">\n            <button type=\"submit\" className=\"block w-full py-2 text-center text-white bg-teal-500 border border-teal-500 rounded hover hover500 transition uppercase font-roboto font-medium\">Login</button>\n            <div className=\"flex gap-2 pt-5\">\n              <p className=\"text-gray-600 text-sm\">Don't have an account?</p><a className=\"text-gray-600 text-sm underline\"\n                href=\"/register\">Register here</a>\n            </div>\n          </div>\n        </form>\n      </div>\n    </div>\n    </div>\n  );\n}\n",
