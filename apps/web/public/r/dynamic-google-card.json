    "rawHtml": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Product Information</title>\n  <!-- Google Fonts -->\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n  <link href=\"https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&family=Roboto:wght@400;500&display=swap\" rel=\"stylesheet\" />\n  <!-- Tailwind CSS CDN -->\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    /* Para la transición de max-height en los paneles del acordeón */\n    .accordion-panel {\n      transition: max-height 0.8s cubic-bezier(0, 0.4, 0, 1);\n    }\n  </style>\n</head>\n<body class=\"p-4 lg:p-12 font-sans\" style=\"font-family: 'Open Sans', 'Roboto', Arial, sans-serif; color: #3c4043;\">\n  <div class=\"max-w-[1200px] mx-auto\">\n    <!-- Product Information -->\n    <section class=\"product-infomation\">\n      <div class=\"flex flex-col lg:flex-row bg-[#e8edd7] rounded-[32px] lg:h-[778px]\">\n        <!-- Izquierda: Imagen principal -->\n        <div class=\"w-full lg:w-1/2 h-full\">\n          <img \n            id=\"heroImage\"\n            class=\"w-full h-full object-cover lg:rounded-l-[32px] rounded-t-[32px] transition-opacity duration-1000\" \n            aria-hidden=\"true\" \n            src=\"https://lh3.googleusercontent.com/nz1xxtKWgEddMXQgK7JRT-j_xoU4KNnQpoCNKrtNHTRBTl6MTHdiQXMjYuONBy59780HS5bU8zYqlAEZY6wLccUmxPgs-qps-y0z=rw-e365-w800\" \n            alt=\"\"\n          />\n        </div>\n        <!-- Derecha: Contenido -->\n        <div class=\"w-full lg:w-1/2\">\n          <div class=\"p-10\">\n            <!-- Botón de retroceso -->\n            <div id=\"backBtn\" class=\"flex items-center mb-6 cursor-pointer\">\n              <span id=\"backIcon\" class=\"hidden mr-6\">\n                <!-- Icono de flecha izquierda -->\n                <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-6 w-6 text-[#5f6368]\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                  <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M15 19l-7-7 7-7\" />\n                </svg>\n              </span>\n              <span>Help on the go</span>\n            </div>\n            <!-- Título -->\n            <h2 id=\"productTitle\" class=\"text-[2.2rem] font-semibold leading-tight mb-6 transition-all duration-600\">\n              Help from Google, right on your wrist.\n            </h2>\n            <!-- Acordeón -->\n            <section class=\"accordion\">\n              <div class=\"bg-[#dce4c3] rounded-[20px]\">\n                <!-- Item 1 -->\n                <div class=\"accordion-header flex justify-between items-center p-6 cursor-pointer transition-all duration-300\">\n                  <div class=\"accordion-title flex-1 mr-6 text-left text-[16px] leading-6 font-bold transition-all duration-200\">\n                    Google Maps helps you find your way.\n                  </div>\n                  <span class=\"accordion-icon h-[30px] w-[30px] rounded-full bg-white flex items-center justify-center\">\n                    <!-- Icono: flecha abajo (se rotará al abrir) -->\n                    <svg class=\"w-4 h-4 text-[#5f6368] transition-transform duration-300\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\"></path>\n                    </svg>\n                  </span>\n                </div>\n                <div class=\"accordion-panel overflow-hidden max-h-0 px-6\">\n                  <p class=\"mb-4 leading-6\">\n                    Turn-by-turn directions and an interactive view help you see where you are and get to where you're going.\n                  </p>\n                  <img aria-hidden=\"true\" loading=\"lazy\" src=\"https://storage.googleapis.com/mannequin/blobs/7a807f74-7d99-4e49-8829-f9b9c852b34d.svg\" alt=\"\" width=\"32\">\n                </div>\n                <!-- Item 2 -->\n                <div class=\"accordion-header flex justify-between items-center p-6 cursor-pointer transition-all duration-300\">\n                  <div class=\"accordion-title flex-1 mr-6 text-left text-[16px] leading-6 font-bold transition-all duration-200\">\n                    Google Wallet lets you leave your cards behind.\n                  </div>\n                  <span class=\"accordion-icon h-[30px] w-[30px] rounded-full bg-white flex items-center justify-center\">\n                    <svg class=\"w-4 h-4 text-[#5f6368] transition-transform duration-300\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\"></path>\n                    </svg>\n                  </span>\n                </div>\n                <div class=\"accordion-panel overflow-hidden max-h-0 px-6\">\n                  <p class=\"mb-4 leading-6\">\n                    Add your cards digitally to Google Wallet, then use Google Pay to speed through checkout with quick, contactless payments – in shops and on public transport.\n                  </p>\n                  <img aria-hidden=\"true\" loading=\"lazy\" src=\"https://storage.googleapis.com/mannequin/blobs/ffa5ffcc-431e-4ddd-94cf-a031fb0d917d.svg\" alt=\"\" width=\"32\">\n                </div>\n                <!-- Item 3 -->\n                <div class=\"accordion-header flex justify-between items-center p-6 cursor-pointer transition-all duration-300\">\n                  <div class=\"accordion-title flex-1 mr-6 text-left text-[16px] leading-6 font-bold transition-all duration-200\">\n                    Google Assistant helps you get more done with your voice.\n                  </div>\n                  <span class=\"accordion-icon h-[30px] w-[30px] rounded-full bg-white flex items-center justify-center\">\n                    <svg class=\"w-4 h-4 text-[#5f6368] transition-transform duration-300\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\"></path>\n                    </svg>\n                  </span>\n                </div>\n                <div class=\"accordion-panel overflow-hidden max-h-0 px-6\">\n                  <p class=\"mb-4 leading-6\">\n                    Play music, respond to texts, get directions and more on your wrist. Just say 'Hey Google' to get started.\n                  </p>\n                  <img aria-hidden=\"true\" loading=\"lazy\" src=\"https://storage.googleapis.com/mannequin/blobs/abed3c42-b042-4672-baf0-073fa628238f.svg\" alt=\"\" width=\"32\">\n                </div>\n              </div>\n            </section>\n          </div>\n        </div>\n      </div>\n    </section>\n  </div>\n\n  <!-- JavaScript para la funcionalidad del acordeón y el cambio de imagen -->\n  <script>\n    document.addEventListener('DOMContentLoaded', () => {\n      const accordionHeaders = document.querySelectorAll('.accordion-header'),\n            productTitleEl   = document.getElementById('productTitle'),\n            backEl           = document.getElementById('backBtn'),\n            backIconEl       = document.getElementById('backIcon'),\n            heroImage        = document.getElementById('heroImage');\n\n      // Array de imágenes para cambiar el hero image\n      const images = [\n        'https://lh3.googleusercontent.com/nz1xxtKWgEddMXQgK7JRT-j_xoU4KNnQpoCNKrtNHTRBTl6MTHdiQXMjYuONBy59780HS5bU8zYqlAEZY6wLccUmxPgs-qps-y0z=rw-e365-w800',\n        'https://lh3.googleusercontent.com/vXIxKa19RbtY2WAeVcNi_DgwWuNVJsY4mA_PDFQfpM5_jkhAnHxrqDM7Na95RqHkMvODppqzN-bJHc7iWEZ1VLLO4bCTzy9i5tM=rw-e365-w800',\n        'https://lh3.googleusercontent.com/29aEaKMXRAbMEyPyeE4-PA4Nad6BRMT7vbrT8uw5WbG6mg5CPMc2yytofXtPgNRCAmpbZnLPUYYX-0SbWxWe66xaLFvpyxj68_M=rw-e365-w800',\n        'https://lh3.googleusercontent.com/iX2B3kXn78xv19tKAT3-WvZ6PqpwKdKznLmmQsfO-r0FhkWHouWLl3u-5k2QDxzeRFscr6lMFDxXzJ_zWXpJo-Bj4y2PUn_yGw=rw-e365-w800'\n      ];\n\n      // Función para cerrar todos los paneles del acordeón\n      const closeAccordions = () => {\n        document.querySelectorAll('.accordion-header').forEach(header => {\n          header.querySelector('.accordion-title').classList.remove('active');\n          const panel = header.nextElementSibling;\n          panel.style.maxHeight = \"0px\";\n          panel.style.paddingBottom = \"0px\";\n          header.querySelector('.accordion-icon svg').classList.remove('rotate-180');\n        });\n      };\n\n      // Función para manejar el clic en cada encabezado del acordeón\n      accordionHeaders.forEach((header, index) => {\n        header.addEventListener('click', function() {\n          // Cierra todos los acordeones abiertos\n          closeAccordions();\n\n          // Activa el botón \"back\" si no lo está\n          if (!backEl.classList.contains('active')) {\n            backEl.classList.add('active');\n            backIconEl.classList.remove('hidden');\n          }\n\n          // Cambia el estado del título\n          this.querySelector('.accordion-title').classList.toggle('active');\n          productTitleEl.classList.add('active');\n\n          // Muestra u oculta el panel correspondiente\n          const panel = this.nextElementSibling;\n          if (panel.style.maxHeight && panel.style.maxHeight !== \"0px\") {\n            panel.style.maxHeight = \"0px\";\n            panel.style.paddingBottom = \"0px\";\n          } else {\n            panel.style.maxHeight = (panel.scrollHeight + 24) + \"px\";\n            panel.style.paddingBottom = \"24px\";\n          }\n\n          // Rota el icono (usa rotate-180 de Tailwind)\n          const iconSvg = this.querySelector('.accordion-icon svg');\n          iconSvg.classList.toggle('rotate-180');\n\n          // Cambia la imagen principal con efecto de fundido\n          heroImage.classList.add('opacity-0');\n          setTimeout(() => {\n            heroImage.src = images[index + 1] || images[0];\n            heroImage.classList.remove('opacity-0');\n          }, 300);\n        });\n      });\n\n      // Función para volver al estado inicial\n      const goBack = () => {\n        if (backEl.classList.contains('active')) {\n          backEl.classList.remove('active');\n          backIconEl.classList.add('hidden');\n          productTitleEl.classList.remove('active');\n          closeAccordions();\n          // Restablece la imagen principal\n          heroImage.classList.add('opacity-0');\n          setTimeout(() => {\n            heroImage.src = images[0];\n            heroImage.classList.remove('opacity-0');\n          }, 300);\n        }\n      };\n\n      backEl.addEventListener('click', goBack);\n    });\n  </script>\n</body>\n</html>"
  }
}
