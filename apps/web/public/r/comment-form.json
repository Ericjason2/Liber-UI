      "content": "/**\n * Component: Comment form\n * Author: @sophia-baker (https://tailwindflex.com/@sophia-baker)\n * Source: https://tailwindflex.com/@sophia-baker/comment-form\n * Attribution: Créé par @sophia-baker sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function CommentForm() {\n  return (\n    <div>\n    <div className=\"border border-gray-300 p-4 rounded-lg max-w-xl mx-auto mt-40\">\n        <h2 className=\"text-lg font-medium mb-2\">Leave a comment</h2>\n        <form>\n            <div className=\"mb-4\">\n                <label className=\"block text-gray-700 font-medium mb-2\" htmlFor=\"name\">\n                    Name\n                </label>\n                <input\n                    className=\"appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus focus500\"\n                    id=\"name\" type=\"text\" placeholder=\"Enter your name\" />\n            </div>\n            <div className=\"mb-4\">\n                <label className=\"block text-gray-700 font-medium mb-2\" htmlFor=\"comment\">\n                    Comment\n                </label>\n                <textarea rows=\"4\"\n                    className=\"appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus focus500\"\n                    id=\"comment\" placeholder=\"Enter your comment\"></textarea>\n            </div>\n            <div className=\"flex justify-end\">\n                <button\n                    className=\"bg-blue-500 hover700 text-white font-medium py-2 px-4 rounded focus focus\"\n                    type=\"button\">Post Comment</button>\n            </div>\n        </form>\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
  ],
