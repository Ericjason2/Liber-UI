    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Hero Section</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n</head>\n<body class=\"bg-gray-100\">\n\n  <section class=\"min-h-screen flex items-center bg-white px-6 py-12\">\n    <div class=\"flex flex-col-reverse md:flex-row items-center max-w-7xl mx-auto w-full\">\n      \n      <!-- Left Content -->\n      <div class=\"w-full md:w-1/2 text-center md:text-left mt-10 md:mt-0 space-y-6\">\n        <h1 class=\"text-4xl sm:text-5xl font-bold text-gray-900 leading-tight\">\n          Hi, I’m <span class=\"text-blue-600\">Sudip Chaudhary</span>\n        </h1>\n        <p class=\"text-gray-600 text-base sm:text-lg\">\n          A passionate frontend & backend developer creating smooth web experiences with modern design.\n        </p>\n        <div class=\"flex justify-center md:justify-start gap-4\">\n          <button onclick=\"greetUser()\" class=\"bg-blue-600 text-white px-6 py-3 rounded-xl hover:bg-blue-700 transition\">\n            Say Hello 👋\n          </button>\n          <a href=\"#projects\" class=\"border border-blue-600 text-blue-600 px-6 py-3 rounded-xl hover:bg-blue-50 transition\">\n            View Projects\n          </a>\n        </div>\n      </div>\n\n      <!-- Right Circular Image -->\n      <div class=\"w-full md:w-1/2 flex justify-center\">\n        <img src=\"https://images.unsplash.com/photo-1503235930437-8c6293ba41f5?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w0NzEyNjZ8MHwxfHNlYXJjaHwzfHxlbG9uJTIwbXVzayUyMHBob3RvJTIwcHJvZmlsZXxlbnwwfDB8fHwxNzQ5MDQ5NTUzfDA&ixlib=rb-4.1.0&q=80&w=1080\" alt=\"Profile\" \n             class=\"w-64 h-64 object-cover rounded-full border-4 border-blue-600 shadow-lg\" />\n      </div>\n    </div>\n  </section>\n\n  <!-- JavaScript -->\n  <script>\n    function greetUser() {\n      alert(\"Hello! Thanks for visiting 😊\");\n      console.log(\"Sudip says hello from the hero section!\");\n    }\n  </script>\n\n</body>\n</html>"
