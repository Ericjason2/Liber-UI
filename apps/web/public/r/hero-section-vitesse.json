        <span class=\\\"relative inline-flex rounded-full h-2 w-2 bg-blue-600\\\"></span>\\n            </span>\\n            <span class=\\\"text-blue-700 font-bold tracking-widest text-[10px] md:text-xs uppercase italic\\\">Logistique Congo 242</span>\\n        </div>\\n\\n        <h1 class=\\\"text-[3.5rem] sm:text-[5rem] md:text-8xl lg:text-[9rem] font-black leading-[0.9] tracking-tighter mb-8 text-zinc-900 uppercase italic reveal\\\">\\n            VITESSE.<br>\\n            <span class=\\\"text-transparent stroke-text\\\">PRÉCISION.</span><br>\\n            <span class=\\\"bg-gradient-to-r from-blue-600 to-cyan-500 bg-clip-text text-transparent\\\">IMPACT.</span>\\n        </h1>\\n\\n        <div class=\\\"max-w-xl mb-10 reveal\\\">\\n            <p class=\\\"text-lg md:text-2xl text-zinc-500 font-medium leading-relaxed border-l-4 border-blue-600 pl-6\\\">\\n                Connectez vos marchandises avec une <span class=\\\"text-zinc-900 font-bold\\\">précision chirurgicale</span>. \\n                L'excellence logistique redéfinie à <span class=\\\"text-blue-600\\\">Brazzaville</span>.\\n            </p>\\n        </div>\\n\\n        <div class=\\\"flex flex-col sm:flex-row gap-4 md:gap-6 reveal\\\">\\n            <a href=\\\"#contact\\\" class=\\\"btn-primary btn-lg group flex items-center justify-center gap-4\\\">\\n                <span class=\\\"font-black uppercase tracking-widest\\\">Expédier</span>\\n                <div class=\\\"bg-white/20 p-1 rounded-lg group-hover:translate-x-2 transition-transform\\\">\\n                    <svg class=\\\"w-5 h-5\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\">\\n                        <path stroke-linecap=\\\"square\\\" stroke-linejoin=\\\"miter\\\" stroke-width=\\\"3\\\" d=\\\"M14 5l7 7m0 0l-7 7m7-7H3\\\"></path>\\n                    </svg>\\n                </div>\\n            </a>\\n\\n            <a href=\\\"#services\\\" class=\\\"btn-outline btn-lg font-black uppercase tracking-widest text-center\\\">\\n                Voir Services\\n            </a>\\n        </div>\\n    </div>\\n\\n    <div class=\\\"absolute bottom-8 left-12 hidden lg:block z-30\\\">\\n        <div class=\\\"flex flex-col items-center gap-3\\\">\\n            <span class=\\\"[writing-mode:vertical-lr] text-[10px] font-black uppercase tracking-[0.3em] text-zinc-400\\\">Scroll</span>\\n            <div class=\\\"w-[1.5px] h-12 bg-zinc-100 relative overflow-hidden\\\">\\n                <div class=\\\"absolute top-0 left-0 w-full h-1/2 bg-blue-600 animate-[scrollAnim_2s_infinite]\\\"></div>\\n            </div>\\n        </div>\\n    </div>\\n</section>\\n\\n<style>\\n    /* Effet de contour pour le mot PRECISION */\\n    .stroke-text {\\n        -webkit-text-stroke: 1px #18181b;\\n        color: transparent;\\n    }\\n    @media (min-width: 768px) {\\n        .stroke-text { -webkit-text-stroke: 2px #18181b; }\\n    }\\n\\n    @keyframes scrollAnim {\\n        0% { transform: translateY(-100%); }\\n        100% { transform: translateY(200%); }\\n    }\\n\\n    /* Utilitaires pour boutons si non définis */\\n    .btn-primary { @apply bg-blue-600 text-white px-8 py-5 rounded-xl hover:bg-blue-700 transition-all shadow-lg shadow-blue-200; }\\n    .btn-outline { @apply border-2 border-zinc-900 text-zinc-900 px-8 py-5 rounded-xl hover:bg-zinc-900 hover:text-white transition-all; }\\n</style>\" }} />\n  );\n}\n",
