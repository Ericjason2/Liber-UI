      "content": "/**\n * Component: Team Showcase\n * Author: @kuldeep541 (https://tailwindflex.com/@kuldeep541)\n * Source: https://tailwindflex.com/@kuldeep541/team-showcase\n * Attribution: Créé par @kuldeep541 sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function TeamShowcase() {\n  return (\n    <div>\n    \n    <section className=\"py-16 bg-gray-50\">\n      <div className=\"max-w-7xl mx-auto px-4\">\n        \n        <div className=\"text-center mb-12\">\n          <h2 className=\"text-4xl font-bold text-gray-900 mb-4\">Meet The Instructors</h2>\n          <p className=\"text-lg text-gray-600 max-w-2xl mx-auto\">\n            Learn from industry professionals with years of experience in their respective fields\n          </p>\n        </div>\n        \n        <div className=\"grid grid-cols-1 sm2 lg4 gap-8\">\n          \n          \n          <div className=\"relative overflow-hidden group bg-white rounded-xl shadow-lg transition-transform transform hover105 hover duration-300\">\n            \n            <div className=\"aspect-w-3 aspect-h-4 bg-gray-200 rounded-xl overflow-hidden relative\">\n              <img \n                src=\"https://images.unsplash.com/photo-1531123414780-f74242c2b052?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80\" \n                alt=\"Rajesh Kumar\" \n                className=\"w-full h-full object-cover object-center\"\n              />\n              \n              <div className=\"absolute inset-0 bg-gradient-to-t from-black via-black/50 to-transparent opacity-0 group-hover100 transition-opacity duration-300\"></div>\n            </div>\n            \n            <div className=\"p-4\">\n              <h3 className=\"font-playfair text-xl font-semibold mb-2\">Rajesh Kumar</h3>\n              <p className=\"text-tab-purple mb-4\">Classical Music Director</p>\n            </div>\n            \n            <div className=\"absolute bottom-0 left-0 right-0 bg-white p-4 transform translate-y-full group-hover0 transition-transform duration-300 ease-in-out shadow-lg rounded-t-lg\">\n              <p className=\"text-sm text-gray-700\">\n                With over 20 years of experience in classical music, Rajesh has performed on international stages and trained hundreds of students.\n              </p>\n            </div>\n          </div>\n          \n          \n          <div className=\"relative overflow-hidden group bg-white rounded-xl shadow-lg transition-transform transform hover105 hover duration-300\">\n            <div className=\"aspect-w-3 aspect-h-4 bg-gray-200 rounded-xl overflow-hidden relative\">\n              <img \n                src=\"https://images.unsplash.com/photo-1494790108377-be9c29b29330?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80\" \n                alt=\"Priya Singh\" \n                className=\"w-full h-full object-cover object-center\"\n              />\n              <div className=\"absolute inset-0 bg-gradient-to-t from-black via-black/50 to-transparent opacity-0 group-hover100 transition-opacity duration-300\"></div>\n            </div>\n            <div className=\"p-4\">\n              <h3 className=\"font-playfair text-xl font-semibold mb-2\">Priya Singh</h3>\n              <p className=\"text-tab-purple mb-4\">Dance Instructor</p>\n            </div>\n            <div className=\"absolute bottom-0 left-0 right-0 bg-white p-4 transform translate-y-full group-hover0 transition-transform duration-300 ease-in-out shadow-lg rounded-t-lg\">\n              <p className=\"text-sm text-gray-700\">\n                Priya is a celebrated dancer specializing in both classical and contemporary styles with numerous awards to her name.\n              </p>\n            </div>\n          </div>\n          \n          \n          <div className=\"relative overflow-hidden group bg-white rounded-xl shadow-lg transition-transform transform hover105 hover duration-300\">\n            <div className=\"aspect-w-3 aspect-h-4 bg-gray-200 rounded-xl overflow-hidden relative\">\n              <img \n                src=\"https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80\" \n                alt=\"Vikram Mehta\" \n                className=\"w-full h-full object-cover object-center\"\n              />\n              <div className=\"absolute inset-0 bg-gradient-to-t from-black via-black/50 to-transparent opacity-0 group-hover100 transition-opacity duration-300\"></div>\n            </div>\n            <div className=\"p-4\">\n              <h3 className=\"font-playfair text-xl font-semibold mb-2\">Vikram Mehta</h3>\n              <p className=\"text-tab-purple mb-4\">Acting Coach</p>\n            </div>\n            <div className=\"absolute bottom-0 left-0 right-0 bg-white p-4 transform translate-y-full group-hover0 transition-transform duration-300 ease-in-out shadow-lg rounded-t-lg\">\n              <p className=\"text-sm text-gray-700\">\n                A veteran of stage and screen, Vikram brings his 15 years of industry experience to nurture the next generation of actors.\n              </p>\n            </div>\n          </div>\n          \n          \n          <div className=\"relative overflow-hidden group bg-white rounded-xl shadow-lg transition-transform transform hover105 hover duration-300\">\n            <div className=\"aspect-w-3 aspect-h-4 bg-gray-200 rounded-xl overflow-hidden relative\">\n              <img \n                src=\"https://images.unsplash.com/photo-1544005313-94ddf0286df2?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80\" \n                alt=\"Aisha Kapoor\" \n                className=\"w-full h-full object-cover object-center\"\n              />\n              <div className=\"absolute inset-0 bg-gradient-to-t from-black via-black/50 to-transparent opacity-0 group-hover100 transition-opacity duration-300\"></div>\n            </div>\n            <div className=\"p-4\">\n              <h3 className=\"font-playfair text-xl font-semibold mb-2\">Aisha Kapoor</h3>\n              <p className=\"text-tab-purple mb-4\">Photography Mentor</p>\n            </div>\n            <div className=\"absolute bottom-0 left-0 right-0 bg-white p-4 transform translate-y-full group-hover0 transition-transform duration-300 ease-in-out shadow-lg rounded-t-lg\">\n              <p className=\"text-sm text-gray-700\">\n                Award-winning photographer Aisha specializes in portrait and fashion photography with publications in leading magazines.\n              </p>\n            </div>\n          </div>\n          \n        </div>\n        \n        <div className=\"text-center mt-12\">\n          <a href=\"/team\" className=\"inline-block bg-tab-purple text-white font-semibold px-6 py-3 rounded-lg shadow-md hover transition-colors duration-300 transform hover1\">\n            View All Instructors\n          </a>\n        </div>\n      </div>\n    </section>\n    </div>\n  );\n}\n",
