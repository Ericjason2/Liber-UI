 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z\" />\n        </svg>\n        <div class=\"menu-toggle\" id=\"mobile-menu-toggle\">\n          <svg class=\"icon-menu\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5\" />\n          </svg>\n          <svg class=\"icon-close\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 18L18 6M6 6l12 12\" />\n          </svg>\n        </div>\n      </div>\n    </nav>\n  </header>\n\n  <section class=\"hero-slider\">\n    <div class=\"swiper heroSwiper\">\n      <div class=\"swiper-wrapper\">\n        <div class=\"swiper-slide\">\n          <div class=\"slide-bg\"\n            style=\"background-image: url('https://saree-fashion.vercel.app/assets/home-page/hero-slider/Website-Banner-9.jpg'); background-color: #222;\">\n          </div>\n          <div class=\"slide-overlay\"></div>\n          <div class=\"slide-content\">\n            <div class=\"slide-text-left\">\n              <span class=\"slide-subtitle\">New Arrivals</span>\n              <h2 class=\"slide-title\">Royal Banarasi Silk</h2>\n              <a href=\"#\" class=\"slide-btn\">Shop Now</a>\n            </div>\n          </div>\n        </div>\n        <div class=\"swiper-slide\">\n          <div class=\"slide-bg\"\n            style=\"background-image: url('https://saree-fashion.vercel.app/assets/home-page/hero-slider/Website-Banner-7.jpg'); background-color: #333;\">\n          </div>\n          <div class=\"slide-overlay\"></div>\n          <div class=\"slide-content\">\n            <div class=\"slide-text-left\">\n              <span class=\"slide-subtitle\">New Arrivals</span>\n              <h2 class=\"slide-title\">Elegant Kanjeevaram</h2>\n              <a href=\"#\" class=\"slide-btn\">Shop Now</a>\n            </div>\n          </div>\n        </div>\n        <div class=\"swiper-slide\">\n          <div class=\"slide-bg\"\n            style=\"background-image: url('https://saree-fashion.vercel.app/assets/home-page/hero-slider/Website-Banner-4.jpg'); background-color: #2a2a2a;\">\n          </div>\n          <div class=\"slide-overlay\"></div>\n          <div class=\"slide-content\">\n            <div class=\"slide-text-left\">\n              <span class=\"slide-subtitle\">New Arrivals</span>\n              <h2 class=\"slide-title\">Modern Chiffon Drape</h2>\n              <a href=\"#\" class=\"slide-btn\">Shop Now</a>\n            </div>\n          </div>\n        </div>\n        <div class=\"swiper-slide\">\n          <div class=\"slide-bg\"\n            style=\"background-image: url('https://saree-fashion.vercel.app/assets/home-page/hero-slider/Website-Banner-3.jpg'); background-color: #222;\">\n          </div>\n          <div class=\"slide-overlay\"></div>\n          <div class=\"slide-content\">\n            <div class=\"slide-text-left\">\n              <span class=\"slide-subtitle\">New Arrivals</span>\n              <h2 class=\"slide-title\">Midnight Georgette</h2>\n              <a href=\"#\" class=\"slide-btn\">Shop Now</a>\n            </div>\n          </div>\n        </div>\n        <div class=\"swiper-slide\">\n          <div class=\"slide-bg\"\n            style=\"background-image: url('https://saree-fashion.vercel.app/assets/home-page/hero-slider/Website-Banner-5.png'); background-color: #333;\">\n          </div>\n          <div class=\"slide-overlay\"></div>\n          <div class=\"slide-content\">\n            <div class=\"slide-text-left\">\n              <span class=\"slide-subtitle\">New Arrivals</span>\n              <h2 class=\"slide-title\">Regal Maroon Bridal</h2>\n              <a href=\"#\" class=\"slide-btn\">Shop Now</a>\n            </div>\n          </div>\n        </div>\n        <div class=\"swiper-slide\">\n          <div class=\"slide-bg\"\n            style=\"background-image: url('https://saree-fashion.vercel.app/assets/home-page/hero-slider/Website-Banner-2.jpg'); background-color: #2a2a2a;\">\n          </div>\n          <div class=\"slide-overlay\"></div>\n          <div class=\"slide-content\">\n            <div class=\"slide-text-left\">\n              <span class=\"slide-subtitle\">New Arrivals</span>\n              <h2 class=\"slide-title\">Classic Handloom</h2>\n              <a href=\"#\" class=\"slide-btn\">Shop Now</a>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div class=\"swiper-pagination\"></div>\n  </section>\n  <section class=\"new-arrivals\">\n    <div class=\"section-header reveal-up\">\n      <span class=\"section-subtitle\">Curated Collection</span>\n      <h2 class=\"section-title\">New Arrivals</h2>\n    </div>\n    <div class=\"product-grid reveal-stagger\">\n      <div class=\"product-card\">\n        <div class=\"product-image-wrapper\">\n          <img src=\"https://saree-fashion.vercel.app/assets/home-page/card/card.png\" alt=\"Saree 1\"\n                        class=\"product-image\">\n        </div>\n        <div class=\"product-info\">\n          <span class=\"product-category\">Silk Collection</span>\n          <h3 class=\"product-name\">Ethereal Gold Banarasi</h3>\n        </div>\n      </div>\n      <div class=\"product-card\">\n        <div class=\"product-image-wrapper\">\n          <img src=\"https://saree-fashion.vercel.app/assets/home-page/card/Website-Banner-6.jpg\" alt=\"Saree 2\"\n                        class=\"product-image\">\n        </div>\n        <div class=\"product-info\">\n          <span class=\"product-category\">Bridal Wear</span>\n          <h3 class=\"product-name\">Regal Maroon Bridal</h3>\n        </div>\n      </div>\n      <div class=\"product-card\">\n        <div class=\"product-image-wrapper\">\n          <img src=\"https://saree-fashion.vercel.app/assets/home-page/card/card-3.png\" alt=\"Saree 3\"\n                        class=\"product-image\">\n        </div>\n        <div class=\"product-info\">\n          <span class=\"product-category\">Modern Drape</span>\n          <h3 class=\"product-name\">Midnight Georgette</h3>\n        </div>\n      </div>\n      <div class=\"product-card\">\n        <div class=\"product-image-wrapper\">\n          <img src=\"https://saree-fashion.vercel.app/assets/home-page/card/card-2.png\" alt=\"Saree 4\"\n                        class=\"product-image\">\n        </div>\n        <div class=\"product-info\">\n          <span class=\"product-category\">Classic Weave</span>\n          <h3 class=\"product-name\">Elegant Kanjeevaram</h3>\n        </div>\n      </div>\n    </div>\n  </section>\n  <section class=\"featured-collections\">\n    <div class=\"section-header reveal-up\">\n      <span class=\"section-subtitle\">Discover Your Style</span>\n      <h2 class=\"section-title\">Featured Collections</h2>\n    </div>\n    <div class=\"collections-grid reveal-stagger\">\n      <div class=\"collection-card\">\n        <img src=\"https://saree-fashion.vercel.app/assets/home-page/hero-slider/Website-Banner-5.png\" alt=\"Bridal Collection\">\n        <div class=\"collection-overlay\">\n          <h3>Bridal Elegance</h3>\n          <a href=\"#\" class=\"collection-link\">Shop Collection</a>\n        </div>\n      </div>\n      <div class=\"collection-card\">\n        <img src=\"https://saree-fashion.vercel.app/assets/home-page/hero-slider/Website-Banner-4.jpg\" alt=\"Party Wear\">\n        <div class=\"collection-overlay\">\n          <h3>Evening Glamour</h3>\n          <a href=\"#\" class=\"collection-link\">Shop Collection</a>\n        </div>\n      </div>\n      <div class=\"collection-card\">\n        <img src=\"https://saree-fashion.vercel.app/assets/home-page/hero-slider/Website-Banner-2.jpg\"\n                    alt=\"Handloom Heritage\">\n        <div class=\"collection-overlay\">\n          <h3>Handloom Heritage</h3>\n          <a href=\"#\" class=\"collection-link\">Shop Collection</a>\n        </div>\n      </div>\n    </div>\n  </section>\n  <section class=\"craftsmanship-section\">\n    <div class=\"craftsmanship-container\">\n      <div class=\"craftsmanship-image reveal-left\">\n        <img src=\"https://saree-fashion.vercel.app/assets/home-page/bento/gird-1.png\" alt=\"Weaving Process\">\n      </div>\n      <div class=\"craftsmanship-content reveal-right\">\n        <span class=\"section-subtitle\">Our Heritage</span>\n        <h2 class=\"section-title\">The Art of Weaving</h2>\n        <p>For generations, our artisans have passed down the intricate secrets of weaving. Every thread tells a\n          story of dedication, precision, and passion.</p>\n        <p>We source the finest silks and cottons to ensure that each piece is not just a garment, but an\n          heirloom to be cherished.</p>\n        <br>\n        <a href=\"#\" class=\"btn-primary\">Read Our Story</a>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"bento-section\">\n    <div class=\"bento-grid\">\n      <div class=\"bento-item item-1 reveal-left\">\n        <img src=\"https://saree-fashion.vercel.app/assets/home-page/bento/gird-1.png\" alt=\"Fashion Show\">\n      </div>\n\n      <div class=\"bento-item item-2 text-card reveal-right\">\n        <h3>Timeless Heritage</h3>\n        <p>Every weave tells a story of tradition, refined for the modern woman who values elegance and comfort.\n        </p>\n      </div>\n\n      <div class=\"bento-item item-3 reveal-left\">\n        <img src=\"https://saree-fashion.vercel.app/assets/home-page/hero-slider/Website-Banner-3.jpg\"\n                    alt=\"Detail View\">\n      </div>\n\n      <div class=\"bento-item item-4 reveal-right\">\n        <img src=\"https://saree-fashion.vercel.app/assets/home-page/bento/gird-2.png\" alt=\"Texture\">\n      </div>\n    </div>\n  </section>\n\n  <section class=\"full-width-banner\">\n    <div class=\"banner-bg\"\n      style=\"background-image: url('https://saree-fashion.vercel.app/assets/home-page/Untitled-1.jpg');\"></div>\n    <div class=\"banner-overlay\"></div>\n    <div class=\"banner-content reveal-left\">\n      <h2 class=\"banner-title\">The Art of Modern Draping</h2>\n      <p class=\"banner-description\">Experience the fusion of centuries-old craftsmanship with contemporary\n        designs.\n        Our saris are crafted for the bold, the elegant, and the timeless woman of today.</p>\n      <a href=\"#\" class=\"banner-btn\">Explore Heritage</a>\n    </div>\n  </section>\n\n  <section class=\"testimonials-section\">\n    <div class=\"section-header reveal-up\">\n      <span class=\"section-subtitle\">Customer Stories</span>\n      <h2 class=\"section-title\">What They Say</h2>\n    </div>\n    <div class=\"testimonials-grid reveal-stagger\">\n      <div class=\"testimonial-card\">\n        <div class=\"stars\">★★★★★</div>\n        <p class=\"quote\">\"The silk is incredibly soft and the colors are vibrant. I felt like royalty on my\n          wedding day!\"</p>\n        <span class=\"author\">- Ananya S.</span>\n      </div>\n      <div class=\"testimonial-card\">\n        <div class=\"stars\">★★★★★</div>\n        <p class=\"quote\">\"Stunning craftsmanship. The attention to detail is evident in every drape. Will\n          definitely buy again.\"</p>\n        <span class=\"author\">- Priya M.</span>\n      </div>\n      <div class=\"testimonial-card\">\n        <div class=\"stars\">★★★★★</div>\n        <p class=\"quote\">\"A perfect blend of traditional patterns and modern aesthetics. Absolutely in love with\n          my new sari.\"</p>\n        <span class=\"author\">- Kavita R.</span>\n      </div>\n    </div>\n  </section>\n\n  <main class=\"main-content reveal-up\">\n    <h2\n      style=\"font-family: var(--font-logo); font-weight: 300; font-size: 2.5rem; color: var(--text-color); margin-bottom: 1rem;\">\n      Discover the Elegance</h2>\n    <p style=\"font-size: 1.1rem; color: #666; max-width: 600px; margin: 0 auto; line-height: 1.6;\">\n      Explore our curated collection of fine Indian saris. Handcrafted with love and tradition, brought to the\n      modern\n      era.\n    </p>\n  </main>\n\n  <section class=\"newsletter-section reveal-up\">\n    <div class=\"newsletter-content\">\n      <h2 style=\"font-family: var(--font-logo); font-weight: 300; font-size: 2.5rem; margin-bottom: 1rem;\">Join\n        Our Community</h2>\n      <p style=\"margin-bottom: 2rem; color: #666;\">Subscribe to receive updates, access to exclusive deals, and\n        10% off your first order.</p>\n      <form class=\"newsletter-form\">\n        <input type=\"email\" placeholder=\"Enter your email address\" required>\n        <button type=\"submit\">Subscribe</button>\n      </form>\n    </div>\n  </section>\n\n  <footer\n    style=\"padding: 2rem; text-align: center; border-top: 1px solid rgba(0,0,0,0.05); background: var(--bg-color);\">\n    <p>&copy; 2026 Modern Saris. All rights reserved.</p>\n  </footer>\n\n  <script src=\"https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js\"></script>\n  <script src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js\"></script>\n  <script src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js\"></script>\n  <script src=\"https://unpkg.com/@studio-freight/lenis@1.0.33/dist/lenis.min.js\"></script>\n  <script src=\"js/animations.js\"></script>\n\n  <script>\n    const lenis = new Lenis({\n            duration: 1.2,\n            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),\n            orientation: 'vertical',\n            gestureOrientation: 'vertical',\n            smoothWheel: true,\n            wheelMultiplier: 1,\n            smoothTouch: false,\n            touchMultiplier: 2,\n            infinite: false,\n        })\n\n        function raf(time) {\n            lenis.raf(time)\n            requestAnimationFrame(raf)\n        }\n\n        requestAnimationFrame(raf)\n\n        lenis.on('scroll', ScrollTrigger.update)\n\n        gsap.ticker.add((time) => {\n            lenis.raf(time * 1000)\n        })\n\n        gsap.ticker.lagSmoothing(0)\n  </script>\n\n  <script>\n    var swiper = new Swiper(\".heroSwiper\", {\n            slidesPerView: 1,\n            loop: true,\n            effect: \"fade\",\n            autoplay: {\n                delay: 5000,\n                disableOnInteraction: false,\n            },\n            pagination: {\n                el: \".swiper-pagination\",\n                clickable: true,\n            },\n            on: {\n                init: function () {\n                    setTimeout(() => {\n                        if (typeof animateSlideContent === 'function') {\n                            animateSlideContent(this.slides[this.activeIndex]);\n                        }\n                    }, 100);\n                },\n                slideChangeTransitionStart: function () {\n                    this.slides.forEach(slide => {\n                        if (typeof resetSlideContent === 'function') {\n                            resetSlideContent(slide);\n                        }\n                    });\n                },\n                slideChangeTransitionEnd: function () {\n                    if (typeof animateSlideContent === 'function') {\n                        animateSlideContent(this.slides[this.activeIndex]);\n                    }\n                }\n            }\n        });\n  </script>\n\n<script>\n  document.addEventListener('DOMContentLoaded', function() {\n    gsap.registerPlugin(ScrollTrigger);\n\n    gsap.set(\".site-header\", { y: -100 });\n    gsap.to(\".site-header\", {\n        y: 0,\n        autoAlpha: 1,\n        duration: 1.2,\n        ease: \"power3.out\",\n        delay: 0.1,\n        force3D: true\n    });\n\n    const revealUps = document.querySelectorAll('.reveal-up');\n    revealUps.forEach((el) => {\n        gsap.fromTo(el, \n            { y: 60, autoAlpha: 0 },\n            {\n                scrollTrigger: {\n                    trigger: el,\n                    start: \"top 92%\",\n                    toggleActions: \"play none none none\", // Changed to play once for better performance\n                    once: true\n                },\n                y: 0,\n                autoAlpha: 1,\n                duration: 1.2,\n                ease: \"power2.out\",\n                force3D: true\n            }\n        );\n    });\n\n    const revealLefts = document.querySelectorAll('.reveal-left');\n    revealLefts.forEach((el) => {\n        gsap.fromTo(el, \n            { x: -80, autoAlpha: 0 },\n            {\n                scrollTrigger: {\n                    trigger: el,\n                    start: \"top 92%\",\n                    toggleActions: \"play none none none\",\n                    once: true\n                },\n                x: 0,\n                autoAlpha: 1,\n                duration: 1.2,\n                ease: \"power2.out\",\n                force3D: true\n            }\n        );\n    });\n\n    const revealRights = document.querySelectorAll('.reveal-right');\n    revealRights.forEach((el) => {\n        gsap.fromTo(el, \n            { x: 80, autoAlpha: 0 },\n            {\n                scrollTrigger: {\n                    trigger: el,\n                    start: \"top 92%\",\n                    toggleActions: \"play none none none\",\n                    once: true\n                },\n                x: 0,\n                autoAlpha: 1,\n                duration: 1.2,\n                ease: \"power2.out\",\n                force3D: true\n            }\n        );\n    });\n\n    const revealStaggers = document.querySelectorAll('.reveal-stagger');\n    revealStaggers.forEach((container) => {\n        const children = container.children;\n        gsap.fromTo(children, \n            { y: 50, autoAlpha: 0 },\n            {\n                scrollTrigger: {\n                    trigger: container,\n                    start: \"top 90%\",\n                    toggleActions: \"play none none none\",\n                    once: true\n                },\n                y: 0,\n                autoAlpha: 1,\n                duration: 1,\n                stagger: 0.1,\n                ease: \"power2.out\",\n                force3D: true\n            }\n        );\n    });\n\n    ScrollTrigger.refresh();\n    \n    function handleScroll() {\n        const header = document.querySelector('.site-header');\n        if (window.scrollY > 50) {\n            header.classList.add('scrolled');\n        } else {\n            header.classList.remove('scrolled');\n        }\n    }\n\n    window.addEventListener('scroll', handleScroll, { passive: true });\n    handleScroll();\n\n    const menuToggle = document.getElementById('mobile-menu-toggle');\n    const navLinks = document.querySelector('.nav-links');\n\n    if (menuToggle && navLinks) {\n        menuToggle.addEventListener('click', () => {\n            navLinks.classList.toggle('active');\n            menuToggle.classList.toggle('active');\n        });\n    }\n});\n\nfunction animateSlideContent(activeSlide) {\n    const elements = activeSlide.querySelectorAll('.slide-subtitle, .slide-title, .slide-btn');\n    gsap.fromTo(elements,\n        { y: 30, opacity: 0 },\n        { y: 0, opacity: 1, duration: 1, stagger: 0.15, ease: \"power3.out\", force3D: true }\n    );\n}\n\nfunction resetSlideContent(slide) {\n    const elements = slide.querySelectorAll('.slide-subtitle, .slide-title, .slide-btn');\n    gsap.set(elements, { y: 30, opacity: 0 });\n}\n</script>\n\n</body>\n\n</html>"
  }
}
