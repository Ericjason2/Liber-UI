      "content": "/**\n * Component: Profile Form\n * Author: @team-tailwindflex (https://tailwindflex.com/@team-tailwindflex)\n * Source: https://tailwindflex.com/@team-tailwindflex/profile-form\n * Attribution: Créé par @team-tailwindflex sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function ProfileForm() {\n  return (\n    <div>\n    <div className=\"flex justify-center mt-20 px-8\">\n        <form className=\"max-w-2xl\">\n            <div className=\"flex flex-wrap border shadow rounded-lg p-3 dark600\">\n                <h2 className=\"text-xl text-gray-600 dark300 pb-2\">Account settings:</h2>\n    \n                <div className=\"flex flex-col gap-2 w-full border-gray-400\">\n    \n                    <div>\n                        <label className=\"text-gray-600 dark400\">User\n                            name\n                        </label>\n                        <input\n                            className=\"w-full py-3 border border-slate-200 rounded-lg px-3 focus focus500 hover dark600 dark100\"\n                            type=\"text\" />\n                    </div>\n    \n                    <div>\n                        <label className=\"text-gray-600 dark400\">Email</label>\n                        <input\n                            className=\"w-full py-3 border border-slate-200 rounded-lg px-3 focus focus500 hover dark600 dark100\"\n                            type=\"text\" />\n                    </div>\n    \n                    <div>\n                        <label className=\"text-gray-600 dark400\">Bio</label>\n                        <textarea\n                            className=\"w-full py-3 border border-slate-200 rounded-lg px-3 focus focus500 hover dark600 dark100\"\n                            name=\"bio\"></textarea>\n                    </div>\n                    <div className=\"flex justify-end\">\n                        <button\n                            className=\"py-1.5 px-3 m-1 text-center bg-violet-700 border rounded-md text-white  hover500 hover100 dark200 dark700\"\n                            type=\"submit\">Save changes</button>\n                    </div>\n                </div>\n            </div>\n        </form>\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
