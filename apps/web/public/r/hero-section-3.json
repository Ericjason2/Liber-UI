      "content": "/**\n * Component: Hero section\n * Author: @prajwal (https://tailwindflex.com/@prajwal)\n * Source: https://tailwindflex.com/@prajwal/hero-section-3\n * Attribution: Créé par @prajwal sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function HeroSection3() {\n  return (\n    <div>\n    <div className=\"relative h-[400px] bg-gradient-to-tr from-indigo-600 via-indigo-700 to-violet-800\">\n        <div className=\"flex flex-col gap-4 justify-center items-center w-full h-full px-3 md0\">\n    \n            <h1 className=\"text-4xl md5xl lg6xl font-bold text-white\">\n                McqMate\n            </h1>\n            <p className=\"text-gray-300\">\n                For Students, From Students\n            </p>\n    \n    \n            <div className=\"relative p-3 border border-gray-200 rounded-lg w-full max-w-lg\">\n                <input type=\"text\" className=\"rounded-md w-full p-3 \" placeholder=\"Search MCQ | Topic | Course\" />\n    \n    \n                <button type=\"submit\" className=\"absolute right-6 top-6\">\n    \n                        <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" strokeWidth=\"1.5\"\n                            stroke=\"currentColor\" className=\"w-6 h-6\">\n                            <path strokeLinecap=\"round\" strokeLinejoin=\"round\"\n                                d=\"M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z\" />\n                        </svg>\n                    </button>\n    \n            </div>\n        </div>\n    \n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
