    "rawHtml": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Navbar</title>\n  <script src=\"https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css\"></script>\n  <script>\n    function toggleMenu() {\n      const menu = document.getElementById(\"menu\");\n      menu.classList.toggle(\"hidden\");\n    }\n  </script>\n</head>\n<body class=\"bg-gray-100\">\n\n  <nav class=\"fixed top-0 left-0 right-0 z-50 bg-white bg-opacity-90 backdrop-blur-md\">\n    <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n      <div class=\"flex items-center justify-between h-16\">\n        <div class=\"flex-shrink-0\">\n          <a href=\"/\" class=\"text-black font-bold text-2xl\">\n            <svg class=\"h-6 w-auto\" viewBox=\"0 0 342 35\" xmlns=\"http://www.w3.org/2000/svg\">\n              <path d=\"M0 .1a9.7 9.7 0 0 0 7 7h11l.5.1v27.6h6.8V7.3L26 7h11a9.8 9.8 0 0 0 7-7H0zm238.6 0h-6.8v34.8H263a9.7 9.7 0 0 0 6-6.8h-30.3V0zm-52.3 6.8c3.6-1 6.6-3.8 7.4-6.9l-38.1.1v20.6h31.1v7.2h-24.4a13.6 13.6 0 0 0-8.7 7h39.9v-21h-31.2v-7h24zm116.2 28h6.7v-14h24.6v14h6.7v-21h-38zM85.3 7h26a9.6 9.6 0 0 0 7.1-7H78.3a9.6 9.6 0 0 0 7 7zm0 13.8h26a9.6 9.6 0 0 0 7.1-7H78.3a9.6 9.6 0 0 0 7 7zm0 14.1h26a9.6 9.6 0 0 0 7.1-7H78.3a9.6 9.6 0 0 0 7 7zM308.5 7h26a9.6 9.6 0 0 0 7-7h-40a9.6 9.6 0 0 0 7 7z\" fill=\"currentColor\"></path>\n            </svg>\n          </a>\n        </div>\n        <div class=\"hidden md:block\">\n          <div class=\"ml-10 flex items-baseline space-x-4\">\n            <a href=\"#\" class=\"text-sm font-medium text-gray-900 hover:text-gray-600 px-3 py-2 rounded-md transition-colors duration-300\">Model S</a>\n            <a href=\"#\" class=\"text-sm font-medium text-gray-900 hover:text-gray-600 px-3 py-2 rounded-md transition-colors duration-300\">Model 3</a>\n            <a href=\"#\" class=\"text-sm font-medium text-gray-900 hover:text-gray-600 px-3 py-2 rounded-md transition-colors duration-300\">Model X</a>\n            <a href=\"#\" class=\"text-sm font-medium text-gray-900 hover:text-gray-600 px-3 py-2 rounded-md transition-colors duration-300\">Model Y</a>\n            <a href=\"#\" class=\"text-sm font-medium text-gray-900 hover:text-gray-600 px-3 py-2 rounded-md transition-colors duration-300\">Solar Roof</a>\n            <a href=\"#\" class=\"text-sm font-medium text-gray-900 hover:text-gray-600 px-3 py-2 rounded-md transition-colors duration-300\">Solar Panels</a>\n          </div>\n        </div>\n        <div class=\"hidden md:block\">\n          <div class=\"ml-4 flex items-center md:ml-6\">\n            <a href=\"#\" class=\"text-sm font-medium text-gray-900 hover:text-gray-600 px-3 py-2 rounded-md transition-colors duration-300\">Shop</a>\n            <a href=\"#\" class=\"text-sm font-medium text-gray-900 hover:text-gray-600 px-3 py-2 rounded-md transition-colors duration-300\">Account</a>\n            <a href=\"#\" class=\"text-sm font-medium text-gray-900 hover:text-gray-600 px-3 py-2 rounded-md transition-colors duration-300\">Menu</a>\n          </div>\n        </div>\n        <div class=\"md:hidden\">\n          <button onclick=\"toggleMenu()\" class=\"inline-flex items-center justify-center p-2 rounded-md text-gray-900 hover:text-gray-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-gray-800 focus:ring-white\">\n            <span class=\"sr-only\">Open main menu</span>\n            <svg id=\"menu-icon\" class=\"h-6 w-6\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <path d=\"M3 12h18M3 6h18M3 18h18\"></path>\n            </svg>\n            <svg id=\"close-icon\" class=\"h-6 w-6 hidden\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n              <path d=\"M6 18L18 6M6 6l12 12\"></path>\n            </svg>\n          </button>\n        </div>\n      </div>\n    </div>\n\n    <div id=\"menu\" class=\"md:hidden hidden\">\n      <div class=\"px-2 pt-2 pb-3 space-y-1 sm:px-3\">\n        <a href=\"#\" class=\"text-gray-900 hover:text-gray-600 block px-3 py-2 rounded-md text-base font-medium\">Model S</a>\n        <a href=\"#\" class=\"text-gray-900 hover:text-gray-600 block px-3 py-2 rounded-md text-base font-medium\">Model 3</a>\n        <a href=\"#\" class=\"text-gray-900 hover:text-gray-600 block px-3 py-2 rounded-md text-base font-medium\">Model X</a>\n        <a href=\"#\" class=\"text-gray-900 hover:text-gray-600 block px-3 py-2 rounded-md text-base font-medium\">Model Y</a>\n        <a href=\"#\" class=\"text-gray-900 hover:text-gray-600 block px-3 py-2 rounded-md text-base font-medium\">Solar Roof</a>\n        <a href=\"#\" class=\"text-gray-900 hover:text-gray-600 block px-3 py-2 rounded-md text-base font-medium\">Solar Panels</a>\n        <a href=\"#\" class=\"text-gray-900 hover:text-gray-600 block px-3 py-2 rounded-md text-base font-medium\">Shop</a>\n        <a href=\"#\" class=\"text-gray-900 hover:text-gray-600 block px-3 py-2 rounded-md text-base font-medium\">Account</a>\n      </div>\n    </div>\n  </nav>\n\n</body>\n</html>"
