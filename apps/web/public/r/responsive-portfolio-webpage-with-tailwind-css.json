    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n\n  <title>Ayyamperumal | Senior Software Developer (Nagercoil & Kochi)</title>\n\n  <meta name=\"description\" content=\"Senior Software Developer with 9+ years of experience building scalable mobile and web applications using React Native, React.js, Next.js, and modern backend systems.\" />\n\n  <meta name=\"keywords\" content=\"Senior Software Developer Nagercoil, Senior Software Developer Kochi, React Native Developer, Full Stack Developer, Mobile App Architect\" />\n\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n\n  <style>\n    body { font-family: Inter, system-ui, sans-serif; }\n  </style>\n</head>\n\n<body class=\"bg-[#f8f9fb] text-gray-900\">\n\n  <!-- Header -->\n  <header class=\"sticky top-0 z-20 bg-white/80 backdrop-blur border-b border-gray-200\">\n    <div class=\"max-w-6xl mx-auto px-6 h-16 flex items-center justify-between\">\n      <span class=\"font-semibold\">Ayyamperumal</span>\n      <nav class=\"flex gap-6 text-sm text-gray-600\">\n        <a href=\"#about\" class=\"hover:text-black\">About</a>\n        <a href=\"#skills\" class=\"hover:text-black\">Skills</a>\n        <a href=\"#experience\" class=\"hover:text-black\">Experience</a>\n        <a href=\"#contact\" class=\"hover:text-black\">Contact</a>\n      </nav>\n    </div>\n  </header>\n\n  <!-- Hero -->\n  <section class=\"py-28\">\n    <div class=\"max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-16 items-center\">\n      <div class=\"space-y-8\">\n        <h1 class=\"text-5xl font-semibold leading-tight\">\n          Senior Software Developer<br>\n          building scalable products\n        </h1>\n\n        <p class=\"text-lg text-gray-600 leading-relaxed\">\n          I’m a senior mobile and full-stack developer with 9+ years of experience\n          building high-performance applications across mobile and web.\n          I specialize in React Native, React, and modern system architecture.\n        </p>\n\n        <div class=\"flex gap-4\">\n          <a href=\"#contact\"\n             class=\"px-6 py-3 bg-black text-white rounded-lg text-sm font-medium\">\n            Contact Me\n          </a>\n          <a href=\"https://portfolio-ayyam.vercel.app/\"\n             class=\"px-6 py-3 border border-gray-300 rounded-lg text-sm\">\n            View Portfolio\n          </a>\n        </div>\n      </div>\n\n      <img\n        src=\"https://images.unsplash.com/photo-1500648767791-00dcc994a43e?q=80&w=1200\"\n        alt=\"Profile\"\n        class=\"rounded-xl object-cover w-full h-[420px]\"\n      />\n    </div>\n  </section>\n\n  <!-- About -->\n  <section id=\"about\" class=\"py-24 bg-white\">\n    <div class=\"max-w-4xl mx-auto px-6 space-y-6\">\n      <h2 class=\"text-3xl font-semibold\">About</h2>\n      <p class=\"text-gray-600 leading-relaxed\">\n        I focus on designing and building systems that scale — technically and\n        operationally. Over the years, I’ve worked across healthcare,\n        e-commerce, and enterprise platforms, delivering maintainable,\n        production-grade applications.\n      </p>\n    </div>\n  </section>\n\n  <!-- Skills -->\n  <section id=\"skills\" class=\"py-24\">\n    <div class=\"max-w-6xl mx-auto px-6 space-y-12\">\n      <h2 class=\"text-3xl font-semibold\">Skills</h2>\n\n      <div class=\"grid sm:grid-cols-2 md:grid-cols-4 gap-6\">\n        <div class=\"p-6 bg-white rounded-xl border\">\n          <h4 class=\"font-medium\">React Native</h4>\n          <p class=\"text-sm text-gray-600 mt-2\">iOS & Android apps</p>\n        </div>\n        <div class=\"p-6 bg-white rounded-xl border\">\n          <h4 class=\"font-medium\">React / Next.js</h4>\n          <p class=\"text-sm text-gray-600 mt-2\">Web platforms</p>\n        </div>\n        <div class=\"p-6 bg-white rounded-xl border\">\n          <h4 class=\"font-medium\">TypeScript</h4>\n          <p class=\"text-sm text-gray-600 mt-2\">Large codebases</p>\n        </div>\n        <div class=\"p-6 bg-white rounded-xl border\">\n          <h4 class=\"font-medium\">AWS & Docker</h4>\n          <p class=\"text-sm text-gray-600 mt-2\">Cloud & deployment</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Experience -->\n  <section id=\"experience\" class=\"py-24 bg-white\">\n    <div class=\"max-w-4xl mx-auto px-6 space-y-12\">\n      <h2 class=\"text-3xl font-semibold\">Experience</h2>\n\n      <div class=\"space-y-8\">\n        <div>\n          <h4 class=\"font-medium\">Senior Software Developer</h4>\n          <p class=\"text-sm text-gray-600 mt-1\">\n            Led development of scalable mobile and web applications using\n            React Native and Next.js, focusing on performance and maintainability.\n          </p>\n        </div>\n\n        <div>\n          <h4 class=\"font-medium\">Lead Mobile Developer</h4>\n          <p class=\"text-sm text-gray-600 mt-1\">\n            Architected multiple React Native applications with complex state\n            management and backend integrations.\n          </p>\n        </div>\n\n        <div>\n          <h4 class=\"font-medium\">Full Stack Developer</h4>\n          <p class=\"text-sm text-gray-600 mt-1\">\n            Delivered end-to-end features including APIs, authentication,\n            notifications, and payment flows.\n          </p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Contact -->\n  <section id=\"contact\" class=\"py-24\">\n    <div class=\"max-w-4xl mx-auto px-6 space-y-8\">\n      <h2 class=\"text-3xl font-semibold\">Contact</h2>\n\n      <form class=\"grid gap-6 bg-white p-8 rounded-xl border\">\n        <input type=\"text\" placeholder=\"Name\"\n          class=\"border px-4 py-3 rounded-lg\" />\n        <input type=\"email\" placeholder=\"Email\"\n          class=\"border px-4 py-3 rounded-lg\" />\n        <textarea rows=\"4\" placeholder=\"Message\"\n          class=\"border px-4 py-3 rounded-lg\"></textarea>\n        <button class=\"bg-black text-white px-6 py-3 rounded-lg text-sm\">\n          Send Message\n        </button>\n      </form>\n    </div>\n  </section>\n\n  <!-- Footer -->\n  <footer class=\"py-10 text-center text-sm text-gray-500\">\n    © 2025 Ayyamperumal. All rights reserved.\n  </footer>\n\n</body>\n</html>"
