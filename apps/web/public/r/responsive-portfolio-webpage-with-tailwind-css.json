      "content": "import * as React from \"react\"\n\nfunction ResponsivePortfolioWebpageWithTailwindCss({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"responsive-portfolio-webpage-with-tailwind-css\"\n      className={className}\n      {...props}\n    >\n      <style>{\"body { font-family: Inter, system-ui, sans-serif; }\"}</style>\n      \n        <header className=\"sticky top-0 z-20 bg-white/80 backdrop-blur border-b border-gray-200\">\n          <div className=\"max-w-6xl mx-auto px-6 h-16 flex items-center justify-between\">\n            <span className=\"font-semibold\">Ayyamperumal</span>\n            <nav className=\"flex gap-6 text-sm text-gray-600\">\n              <a href=\"#about\" className=\"hover:text-black\">About</a>\n              <a href=\"#skills\" className=\"hover:text-black\">Skills</a>\n              <a href=\"#experience\" className=\"hover:text-black\">Experience</a>\n              <a href=\"#contact\" className=\"hover:text-black\">Contact</a>\n            </nav>\n          </div>\n        </header>\n      \n        \n        <section className=\"py-28\">\n          <div className=\"max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-16 items-center\">\n            <div className=\"space-y-8\">\n              <h1 className=\"text-5xl font-semibold leading-tight\">\n                Senior Software Developer<br />\n                building scalable products\n              </h1>\n      \n              <p className=\"text-lg text-gray-600 leading-relaxed\">\n                I’m a senior mobile and full-stack developer with 9+ years of experience\n                building high-performance applications across mobile and web.\n                I specialize in React Native, React, and modern system architecture.\n              </p>\n      \n              <div className=\"flex gap-4\">\n                <a href=\"#contact\"\n                   className=\"px-6 py-3 bg-black text-white rounded-lg text-sm font-medium\">\n                  Contact Me\n                </a>\n                <a href=\"https://portfolio-ayyam.vercel.app/\"\n                   className=\"px-6 py-3 border border-gray-300 rounded-lg text-sm\">\n                  View Portfolio\n                </a>\n              </div>\n            </div>\n      \n            <img\n              src=\"https://images.unsplash.com/photo-1500648767791-00dcc994a43e?q=80&w=1200\"\n              alt=\"Profile\"\n              className=\"rounded-xl object-cover w-full h-[420px]\"\n            />\n          </div>\n        </section>\n      \n        \n        <section id=\"about\" className=\"py-24 bg-white\">\n          <div className=\"max-w-4xl mx-auto px-6 space-y-6\">\n            <h2 className=\"text-3xl font-semibold\">About</h2>\n            <p className=\"text-gray-600 leading-relaxed\">\n              I focus on designing and building systems that scale — technically and\n              operationally. Over the years, I’ve worked across healthcare,\n              e-commerce, and enterprise platforms, delivering maintainable,\n              production-grade applications.\n            </p>\n          </div>\n        </section>\n      \n        \n        <section id=\"skills\" className=\"py-24\">\n          <div className=\"max-w-6xl mx-auto px-6 space-y-12\">\n            <h2 className=\"text-3xl font-semibold\">Skills</h2>\n      \n            <div className=\"grid sm:grid-cols-2 md:grid-cols-4 gap-6\">\n              <div className=\"p-6 bg-white rounded-xl border\">\n                <h4 className=\"font-medium\">React Native</h4>\n                <p className=\"text-sm text-gray-600 mt-2\">iOS & Android apps</p>\n              </div>\n              <div className=\"p-6 bg-white rounded-xl border\">\n                <h4 className=\"font-medium\">React / Next.js</h4>\n                <p className=\"text-sm text-gray-600 mt-2\">Web platforms</p>\n              </div>\n              <div className=\"p-6 bg-white rounded-xl border\">\n                <h4 className=\"font-medium\">TypeScript</h4>\n                <p className=\"text-sm text-gray-600 mt-2\">Large codebases</p>\n              </div>\n              <div className=\"p-6 bg-white rounded-xl border\">\n                <h4 className=\"font-medium\">AWS & Docker</h4>\n                <p className=\"text-sm text-gray-600 mt-2\">Cloud & deployment</p>\n              </div>\n            </div>\n          </div>\n        </section>\n      \n        \n        <section id=\"experience\" className=\"py-24 bg-white\">\n          <div className=\"max-w-4xl mx-auto px-6 space-y-12\">\n            <h2 className=\"text-3xl font-semibold\">Experience</h2>\n      \n            <div className=\"space-y-8\">\n              <div>\n                <h4 className=\"font-medium\">Senior Software Developer</h4>\n                <p className=\"text-sm text-gray-600 mt-1\">\n                  Led development of scalable mobile and web applications using\n                  React Native and Next.js, focusing on performance and maintainability.\n                </p>\n              </div>\n      \n              <div>\n                <h4 className=\"font-medium\">Lead Mobile Developer</h4>\n                <p className=\"text-sm text-gray-600 mt-1\">\n                  Architected multiple React Native applications with complex state\n                  management and backend integrations.\n                </p>\n              </div>\n      \n              <div>\n                <h4 className=\"font-medium\">Full Stack Developer</h4>\n                <p className=\"text-sm text-gray-600 mt-1\">\n                  Delivered end-to-end features including APIs, authentication,\n                  notifications, and payment flows.\n                </p>\n              </div>\n            </div>\n          </div>\n        </section>\n      \n        \n        <section id=\"contact\" className=\"py-24\">\n          <div className=\"max-w-4xl mx-auto px-6 space-y-8\">\n            <h2 className=\"text-3xl font-semibold\">Contact</h2>\n      \n            <form className=\"grid gap-6 bg-white p-8 rounded-xl border\">\n              <input type=\"text\" placeholder=\"Name\"\n                className=\"border px-4 py-3 rounded-lg\" />\n              <input type=\"email\" placeholder=\"Email\"\n                className=\"border px-4 py-3 rounded-lg\" />\n              <textarea rows=\"4\" placeholder=\"Message\"\n                className=\"border px-4 py-3 rounded-lg\"></textarea>\n              <button className=\"bg-black text-white px-6 py-3 rounded-lg text-sm\">\n                Send Message\n              </button>\n            </form>\n          </div>\n        </section>\n      \n        \n        <footer className=\"py-10 text-center text-sm text-gray-500\">\n          © 2025 Ayyamperumal. All rights reserved.\n        </footer>\n    </div>\n  )\n}\n\nexport { ResponsivePortfolioWebpageWithTailwindCss }\n",
