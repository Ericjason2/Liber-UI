    "rawHtml": "<div class=\"flex flex-col items-center justify-center min-h-screen bg-gray-100 gap-8\">\n  \n  <!-- Conteneur principal avec perspective 3D -->\n  <div class=\"w-96 h-56 [perspective:1000px]\">\n    \n    <!-- Conteneur interne qui va pivoter via JS -->\n    <div id=\"cardContainer\" class=\"relative w-full h-full transition-transform duration-700 [transform-style:preserve-3d]\">\n      \n      <!-- CARD RECTO (Face avant - Effet Aluminium) -->\n      <div class=\"absolute inset-0 w-full h-full rounded-2xl px-8 py-6 bg-gradient-to-br from-gray-300 via-gray-100 to-gray-400 text-gray-800 shadow-xl flex flex-col justify-end gap-6 [backface-visibility:hidden]\">\n        \n        <!-- Puce & Logo Visa -->\n        <div class=\"absolute top-6 left-8 flex items-center gap-2\">\n          <!-- Puce dorée réaliste -->\n          <div class=\"w-11 h-8 rounded-md bg-gradient-to-r from-yellow-200 via-yellow-400 to-yellow-300 border border-yellow-500 opacity-80 shadow-inner\"></div>\n        </div>\n        \n        <div class=\"logo absolute top-6 right-8 w-16 h-8 flex items-center\">\n          <svg viewBox=\"0 0 1000 324.68\" class=\"w-full h-full\">\n            <path d=\"m651.19 0.5c-70.933 0-134.32 36.766-134.32 104.69 0 77.9 112.42 83.281 112.42 122.42 0 16.478-18.884 31.229-51.137 31.229-45.773 0-79.984-20.611-79.984-20.611l-14.638 68.547s39.41 17.41 91.734 17.41c77.552 0 138.58-38.571 138.58-107.66 0-82.316-112.89-87.536-112.89-123.86 0-12.908 15.502-27.052 47.663-27.052 36.287 0 65.892 14.99 65.892 14.99l14.326-66.204s-32.213-13.897-77.642-13.897zm-648.97 4.9966-1.7176 9.9931s29.842 5.4615 56.719 16.356c34.607 12.493 37.072 19.765 42.9 42.354l63.511 244.83h85.137l131.16-313.53h-84.942l-84.278 213.17-34.39-180.7c-3.1539-20.681-19.129-32.478-38.684-32.478h-135.41zm411.87 0-66.634 313.53h80.999l66.4-313.53h-80.765zm451.76 0c-19.532 0-29.88 10.457-37.474 28.73l-118.67 284.8h84.942l16.434-47.467h103.48l9.9931 47.467h74.948l-65.385-313.53h-68.273zm11.047 84.707 25.178 117.65h-67.454l42.276-117.65z\" fill=\"#1f2937\" />\n          </svg>\n        </div>\n\n        <!-- Numéro de carte -->\n        <div class=\"number whitespace-nowrap text-2xl font-bold tracking-widest text-gray-800 drop-shadow-sm\" style=\"font-family: 'Courier New', Courier, monospace;\">\n          4242&nbsp;4242&nbsp;4242&nbsp;4242\n        </div>\n\n        <!-- Infos titulaire -->\n        <div class=\"credentials flex gap-8 text-gray-700\">\n          <div class=\"owner flex flex-col w-max\">\n            <span class=\"text-[10px] uppercase font-bold tracking-wider text-gray-500\">Card holder</span>\n            <span class=\"whitespace-nowrap text-base font-semibold uppercase\">John Doe</span>\n          </div>\n          <div class=\"expires flex flex-col w-max\">\n            <span class=\"text-[10px] uppercase font-bold tracking-wider text-gray-500\">Expires</span>\n            <span class=\"whitespace-nowrap text-base font-semibold\">09/28</span>\n          </div>\n        </div>\n      </div>\n\n      <!-- CARD VERSO (Face arrière) -->\n      <div class=\"absolute inset-0 w-full h-full rounded-2xl bg-gradient-to-br from-gray-300 via-gray-100 to-gray-400 text-gray-800 shadow-xl flex flex-col justify-between py-6 [backface-visibility:hidden] [transform:rotateY(180deg)]\">\n        <!-- Bande magnétique -->\n        <div class=\"w-full h-12 bg-gray-800 mt-2\"></div>\n        \n        <!-- Zone Signature & CVC -->\n        <div class=\"px-8 flex items-center justify-end gap-3 w-full\">\n          <div class=\"w-48 h-9 bg-gray-200 border border-gray-300 rounded flex items-center justify-end px-3 italic text-gray-500 text-sm select-none shadow-inner bg-opacity-70\">\n            John Doe\n          </div>\n          <div class=\"flex flex-col items-center\">\n            <span class=\"text-[9px] uppercase font-bold text-gray-500\">CVC</span>\n            <div class=\"w-12 h-8 bg-amber-100 rounded flex items-center justify-center font-bold text-gray-800 border border-amber-200 shadow-sm\" style=\"font-family: 'Courier New', monospace;\">\n              123\n            </div>\n          </div>\n        </div>\n\n        <!-- Mentions légales fictives bas de carte -->\n        <div class=\"px-8 text-[8px] text-gray-500 text-center leading-tight\">\n          Cette carte est strictement personnelle. En cas de perte ou de vol, merci de prévenir immédiatement votre banque.\n        </div>\n      </div>\n\n    </div>\n  </div>\n\n  <!-- Bouton de contrôle interactif -->\n  <button id=\"flipBtn\" class=\"px-6 py-2.5 bg-gray-900 hover:bg-gray-800 text-white font-medium rounded-xl shadow-md transition-all active:scale-95 flex items-center gap-2 text-sm tracking-wide\">\n   \n    Retourner la carte\n  </button>\n\n</div>\n\n<!-- JavaScript pour l'animation -->\n<script>\n  const cardContainer = document.getElementById('cardContainer');\n  const flipBtn = document.getElementById('flipBtn');\n  let isFlipped = false;\n\n  flipBtn.addEventListener('click', () => {\n    isFlipped = !isFlipped;\n    if (isFlipped) {\n      cardContainer.style.transform = 'rotateY(180deg)';\n    } else {\n      cardContainer.style.transform = 'rotateY(0deg)';\n    }\n  });\n</script>"
