53h-84.942l-84.278 213.17-34.39-180.7c-3.1539-20.681-19.129-32.478-38.684-32.478h-135.41zm411.87 0-66.634 313.53h80.999l66.4-313.53h-80.765zm451.76 0c-19.532 0-29.88 10.457-37.474 28.73l-118.67 284.8h84.942l16.434-47.467h103.48l9.9931 47.467h74.948l-65.385-313.53h-68.273zm11.047 84.707 25.178 117.65h-67.454l42.276-117.65z\" fill=\"#1f2937\" />\n              </svg>\n            </div>\n    \n            \n            <div className=\"number whitespace-nowrap text-2xl font-bold tracking-widest text-gray-800 drop-shadow-sm\" style=\"font-family: 'Courier New', Courier, monospace;\">\n              4242&nbsp;4242&nbsp;4242&nbsp;4242\n            </div>\n    \n            \n            <div className=\"credentials flex gap-8 text-gray-700\">\n              <div className=\"owner flex flex-col w-max\">\n                <span className=\"text-[10px] uppercase font-bold tracking-wider text-gray-500\">Card holder</span>\n                <span className=\"whitespace-nowrap text-base font-semibold uppercase\">John Doe</span>\n              </div>\n              <div className=\"expires flex flex-col w-max\">\n                <span className=\"text-[10px] uppercase font-bold tracking-wider text-gray-500\">Expires</span>\n                <span className=\"whitespace-nowrap text-base font-semibold\">09/28</span>\n              </div>\n            </div>\n          </div>\n    \n          \n          <div className=\"absolute inset-0 w-full h-full rounded-2xl bg-gradient-to-br from-gray-300 via-gray-100 to-gray-400 text-gray-800 shadow-xl flex flex-col justify-between py-6 [backface-visibility] [transform(180deg)]\">\n            \n            <div className=\"w-full h-12 bg-gray-800 mt-2\"></div>\n            \n            \n            <div className=\"px-8 flex items-center justify-end gap-3 w-full\">\n              <div className=\"w-48 h-9 bg-gray-200 border border-gray-300 rounded flex items-center justify-end px-3 italic text-gray-500 text-sm select-none shadow-inner bg-opacity-70\">\n                John Doe\n              </div>\n              <div className=\"flex flex-col items-center\">\n                <span className=\"text-[9px] uppercase font-bold text-gray-500\">CVC</span>\n                <div className=\"w-12 h-8 bg-amber-100 rounded flex items-center justify-center font-bold text-gray-800 border border-amber-200 shadow-sm\" style=\"font-family: 'Courier New', monospace;\">\n                  123\n                </div>\n              </div>\n            </div>\n    \n            \n            <div className=\"px-8 text-[8px] text-gray-500 text-center leading-tight\">\n              Cette carte est strictement personnelle. En cas de perte ou de vol, merci de prévenir immédiatement votre banque.\n            </div>\n          </div>\n    \n        </div>\n      </div>\n    \n      \n      <button id=\"flipBtn\" className=\"px-6 py-2.5 bg-gray-900 hover800 text-white font-medium rounded-xl shadow-md transition-all active95 flex items-center gap-2 text-sm tracking-wide\">\n       \n        Retourner la carte\n      </button>\n    \n    </div>\n    \n    \n    \n    </div>\n  );\n}\n",
