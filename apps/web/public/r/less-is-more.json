100% 100%, 0% 100%);\n            }\n        }\n    </style>\n</head>\n<body class=\"bg-white text-black font-framer antialiased overflow-x-hidden\">\n    <!-- Navigation -->\n    <nav class=\"fixed w-full z-50 bg-white/90 backdrop-blur-sm border-b border-black/5\">\n        <div class=\"max-w-7xl mx-auto px-6 py-4\">\n            <div class=\"flex items-center justify-between\">\n                <div class=\"flex items-center space-x-12\">\n                    <span class=\"text-2xl font-bold tracking-tighter\">STUDIO</span>\n                    <div class=\"hidden md:flex space-x-8\">\n                        <a href=\"#\" class=\"text-sm font-medium hover:text-black/60 transition-colors duration-300 relative group\">\n                            Work\n                            <span class=\"absolute bottom-0 left-0 w-0 h-px bg-black transition-all duration-300 group-hover:w-full\"></span>\n                        </a>\n                        <a href=\"#\" class=\"text-sm font-medium hover:text-black/60 transition-colors duration-300 relative group\">\n                            Studio\n                            <span class=\"absolute bottom-0 left-0 w-0 h-px bg-black transition-all duration-300 group-hover:w-full\"></span>\n                        </a>\n                        <a href=\"#\" class=\"text-sm font-medium hover:text-black/60 transition-colors duration-300 relative group\">\n                            Journal\n                            <span class=\"absolute bottom-0 left-0 w-0 h-px bg-black transition-all duration-300 group-hover:w-full\"></span>\n                        </a>\n                        <a href=\"#\" class=\"text-sm font-medium hover:text-black/60 transition-colors duration-300 relative group\">\n                            Contact\n                            <span class=\"absolute bottom-0 left-0 w-0 h-px bg-black transition-all duration-300 group-hover:w-full\"></span>\n                        </a>\n                    </div