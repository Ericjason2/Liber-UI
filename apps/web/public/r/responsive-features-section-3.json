10-2h11.586l-2.293-2.293a1 1 0 010-1.414z\" clipRule=\"evenodd\" />\n                </svg>\n              </a>\n            </div>\n    \n            \n            <div className=\"group bg-white p-8 rounded-xl border border-gray-200 hover500 transition-all duration-300 hover2\">\n              <div className=\"w-12 h-12 rounded-lg bg-blue-50 flex items-center justify-center mb-6\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"h-6 w-6 text-blue-600\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                  <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z\" />\n                </svg>\n              </div>\n              <h3 className=\"text-xl font-semibold text-gray-900 mb-3\">Customizable</h3>\n              <p className=\"text-gray-600 mb-6\">\n                Tailor the interface to your workflow with modular components and themes.\n              </p>\n              <a href=\"#\" className=\"inline-flex items-center text-blue-600 hover800 transition-colors\">\n                <span className=\"text-sm font-medium\">Learn more</span>\n                <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"h-4 w-4 ml-1\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\n                  <path fillRule=\"evenodd\" d=\"M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z\" clipRule=\"evenodd\" />\n                </svg>\n              </a>\n            </div>\n          </div>\n        </div>\n      </section>\n    </div>\n    </div>\n  );\n}\n",
