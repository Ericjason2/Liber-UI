py-2 border-b-2 border-gray-200 dark2 dark600 pl-4 hover400 hover hover500\">\r\n                                <div\r\n                                    className=\"flex md2 sm text-md font-semibold dark cursor-pointer\">\r\n                                    Step - <h1\r\n                                        className=\"md3xl text-lg sm flex justify-center sm2 sm500 rounded-lg\">\r\n                                        2\r\n                                    </h1>\r\n                                </div>\r\n                            </div>\r\n                            <div\r\n                                className=\"rounded-sm py-2 border-b-2 border-gray-200 dark2 dark600 pl-4 hover400 hover hover500\">\r\n                                <div\r\n                                    className=\"flex md2 sm text-md font-semibold dark cursor-pointer\">\r\n                                    Step - <h1\r\n                                        className=\"md3xl text-lg sm flex justify-center sm2 sm500 rounded-lg\">\r\n                                        3\r\n                                    </h1>\r\n                                </div>\r\n                            </div>\r\n                            <div\r\n                                className=\"rounded-sm py-2 border-b-2 border-gray-200 dark2 dark600 pl-4 hover400 hover hover500\">\r\n                                <div\r\n                                    className=\"flex md2 sm text-md font-semibold dark cursor-pointer\">\r\n                                    Step - <h1\r\n                                        className=\"md3xl text-lg sm flex justify-center px-2 sm500 rounded-lg\">\r\n                                        4\r\n                                    </h1>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n    \r\n                        \r\n                        <div className=\"bg-gray-100