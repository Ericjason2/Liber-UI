ient-to-r from-[#44BCFF] via-[#FF44EC] to-[#FF675E] rounded-xl blur-lg group-hover100 group-hover1 group-hover200 animate-tilt\"></div>\n    \n                        <a href=\"#\" title=\"\" className=\"relative inline-flex items-center justify-center px-8 py-4 text-lg font-bold text-white transition-all duration-200 bg-gray-900 font-pj rounded-xl focus focus2 focus2 focus900\" role=\"button\">\n                            Get access to 4,958 resources\n                        </a>\n                    </div>\n                </div>\n            </div>\n    \n            <div className=\"mt-16 md20\">\n                <img className=\"object-cover object-top w-full h-auto mx-auto scale-150 2xl2xl xl100\" src=\"https://d33wubrfki0l68.cloudfront.net/54780decfb9574945bc873b582cdc6156144a2ba/d9fa1/images/hero/4/illustration.png\" alt=\"\" />\n            </div>\n        </section>\n    </div>\n    </div>\n  );\n}\n",
