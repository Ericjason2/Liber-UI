      "content": "/**\n * Component: Premium SAAS HERO Section\n * Author: @mdadul (https://tailwindflex.com/@mdadul)\n * Source: https://tailwindflex.com/@mdadul/premium-saas-hero-section\n * Attribution: Créé par @mdadul sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function PremiumSaasHeroSection() {\n  return (\n    <div>\n    <header className=\"relative\">\n      \n      <img src=\"https://uploads-ssl.webflow.com/646f65e37fe0275cfb808405/646f66cdeeb4ddfdae25a26e_Background%20Hero.svg\" alt=\"\" className=\"absolute -z-10 inline-block h-full w-full object-cover\" />\n      \n      <div className=\"mx-auto w-full max-w-7xl px-5 py-16 md10 md24 lg32\">\n        \n        <div className=\"mx-auto max-w-3xl text-center\">\n          <h1 className=\"mb-6 pb-4 text-4xl font-bold text-white md6xl\">The Website You Want Without The Dev Time.</h1>\n          <p className=\"mx-auto mb-5 max-w-[528px] text-xl text-[#636262] lg8\">Lorem ipsum dolor sit amet, consectetur adipiscing elit ut aliquam, purus sit amet luctus venenatis, lectus</p>\n          <a href=\"#\" className=\"inline-block rounded-full bg-[#c9fd02] px-8 py-4 text-center font-bold text-black transition hover hover\">Get Started</a>\n        </div>\n        \n        <div className=\"mx-auto mt-16 grid max-w-[1040px] grid-cols-2 gap-8 py-20 sm3 sm12 md5\">\n          <div className=\"mx-auto\">\n            <img src=\"https://uploads-ssl.webflow.com/646f65e37fe0275cfb808405/646f66cdeeb4ddfdae25a267_Microsoft%20Logo.svg\" alt=\"\" className=\"inline-block\" />\n          </div>\n          <div className=\"mx-auto\">\n            <img src=\"https://uploads-ssl.webflow.com/646f65e37fe0275cfb808405/646f66cdeeb4ddfdae25a26a_PayPal%20Logo.svg\" alt=\"\" className=\"inline-block\" />\n          </div>\n          <div className=\"mx-auto\">\n            <img src=\"https://uploads-ssl.webflow.com/646f65e37fe0275cfb808405/646f66cdeeb4ddfdae25a268_Google%20Logo.svg\" alt=\"\" className=\"inline-block\" />\n          </div>\n          <div className=\"mx-auto\">\n            <img src=\"https://uploads-ssl.webflow.com/646f65e37fe0275cfb808405/646f66cdeeb4ddfdae25a269_Chase%20Logo.svg\" alt=\"\" className=\"inline-block\" />\n          </div>\n          <div className=\"mx-auto\">\n            <img src=\"https://uploads-ssl.webflow.com/646f65e37fe0275cfb808405/646f66cdeeb4ddfdae25a26b_Walmart%20Logo.svg\" alt=\"\" className=\"inline-block\" />\n          </div>\n        </div>\n      </div>\n    </header>\n    </div>\n  );\n}\n",
