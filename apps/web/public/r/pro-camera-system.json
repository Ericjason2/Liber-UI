    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>iPhone 15 Pro | Apple</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css\">\n    <style>\n        @keyframes subtlePulse {\n            0%, 100% { transform: scale(1); }\n            50% { transform: scale(1.02); }\n        }\n        .hero-gradient {\n            background: radial-gradient(circle at 70% 30%, rgba(40,40,40,1) 0%, rgba(10,10,10,1) 70%);\n        }\n        .feature-card:hover {\n            transform: translateY(-8px);\n            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);\n        }\n    </style>\n</head>\n<body class=\"bg-black text-white font-sans antialiased overflow-x-hidden\">\n    <!-- Navigation -->\n    <nav class=\"container mx-auto px-6 py-4 flex justify-between items-center\">\n        <div class=\"text-2xl font-semibold\"></div>\n        <div class=\"hidden md:flex space-x-8\">\n            <a href=\"#\" class=\"text-gray-400 hover:text-white transition\">Overview</a>\n            <a href=\"#\" class=\"text-gray-400 hover:text-white transition\">Tech Specs</a>\n            <a href=\"#\" class=\"text-gray-400 hover:text-white transition\">Compare</a>\n            <a href=\"#\" class=\"text-gray-400 hover:text-white transition\">Support</a>\n        </div>\n        <button class=\"bg-blue-600 hover:bg-blue-700 px-6 py-2 rounded-full font-medium transition\">\n            Buy\n        </button>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero-gradient min-h-screen flex flex-col md:flex-row items-center justify-center px-6 md:px-12 lg:px-24 gap-12 md:gap-24\">\n        <!-- Text Content -->\n        <div class=\"md:w-1/2 space-y-6 text-center md:text-left animate__animated animate__fadeInLeft\">\n            <div class=\"flex items-center justify-center md:justify-start gap-2\">\n                <span class=\"bg-blue-900 text-blue-300 text-xs px-2 py-1 rounded\">New</span>\n                <span class=\"text-gray-400 text-sm\">iPhone 15 Pro</span>\n            </div>\n            <h1 class=\"text-5xl md:text-6xl lg:text-7xl font-bold leading-tight\">\n                <span class=\"bg-gradient-to-r from-blue-400 to-purple-500 bg-clip-text text-transparent\">Pro</span> \n                <span class=\"bg-gradient-to-r from-gray-100 to-gray-300 bg-clip-text text-transparent\">Camera</span> \n                <span class=\"bg-gradient-to-r from-blue-500 to-cyan-400 bg-clip-text text-transparent\">System</span>\n            </h1>\n            <h2 class=\"text-xl md:text-2xl text-gray-300 font-light max-w-lg\">\n                Transform the way you shoot with our most advanced camera system ever.\n            </h2>\n            <p class=\"text-gray-400 max-w-md\">\n                48MP Main camera. Next-generation portraits. Night mode on all cameras. \n                Cinematic mode now in 4K HDR.\n            </p>\n            <div class=\"flex flex-col sm:flex-row gap-4 justify-center md:justify-start pt-4\">\n                <button class=\"bg-blue-600 hover:bg-blue-700 text-white px-8 py-3 rounded-full font-medium transition duration-300 flex items-center gap-2\">\n                    <span>Buy now</span>\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\n                        <path fill-rule=\"evenodd\" d=\"M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-8.707l-3-3a1 1 0 00-1.414 1.414L10.586 9H7a1 1 0 100 2h3.586l-1.293 1.293a1 1 0 101.414 1.414l3-3a1 1 0 000-1.414z\" clip-rule=\"evenodd\" />\n                    </svg>\n                </button>\n                <button class=\"border border-gray-700 hover:bg-gray-900 text-white px-8 py-3 rounded-full font-medium transition duration-300\">\n                    Watch the film <span class=\"text-blue-400\">▶</span>\n                </button>\n            </div>\n        </div>\n\n        <!-- iPhone Image -->\n        <div class=\"md:w-1/2 flex justify-center animate__animated animate__fadeIn animate__delay-1s\">\n            <div class=\"relative\">\n                <img \n                    src=\"https://wrufc.org/wp-content/uploads/2024/03/iphone-2.jpg\" \n                    alt=\"iPhone 15 Pro in Titanium\" \n                    class=\"w-full max-w-md xl:max-w-xl object-contain animate-subtlePulse\"\n                    style=\"animation-duration: 8s;\"\n                >\n                <div class=\"absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent opacity-40\"></div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Features Grid -->\n    <section class=\"py-20 px-6 md:px-12 lg:px-24 bg-gradient-to-b from-black to-gray-900\">\n        <div class=\"max-w-7xl mx-auto\">\n            <h2 class=\"text-3xl md:text-4xl font-bold text-center mb-16\">\n                <span class=\"bg-gradient-to-r from-blue-400 to-cyan-400 bg-clip-text text-transparent\">\n                    Designed for pros. Loved by everyone.\n                </span>\n            </h2>\n            \n            <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8\">\n                <!-- Feature 1 -->\n                <div class=\"feature-card bg-gray-900 rounded-2xl p-8 transition-all duration-300 hover:border hover:border-gray-700\">\n                    <div class=\"text-blue-500 text-4xl mb-6\">🛠️</div>\n                    <h3 class=\"text-xl font-semibold mb-3\">Aerospace-Grade Titanium</h3>\n                    <p class=\"text-gray-400 mb-4\">Our lightest Pro design ever with the strongest metal in a smartphone.</p>\n                    <div class=\"h-px bg-gray-800 my-4\"></div>\n                    <div class=\"text-sm text-blue-400 flex items-center gap-1\">\n                    