ate-300 text-indigo-600 focus500\" />\n                  <span>\n                    I agree to the\n                    <a href=\"#\" className=\"font-medium text-slate-900\">Terms</a>\n                    and\n                    <a href=\"#\" className=\"font-medium text-slate-900\">Privacy Policy</a>.\n                  </span>\n                </label>\n                <button className=\"w-full rounded-xl bg-slate-900 py-3.5 text-sm font-semibold text-white shadow-lg shadow-slate-900/20 transition hover800\">\n                  Create Account\n                </button>\n              </form>\n              <p className=\"mt-8 text-center text-sm text-slate-500\">\n                Already have an account?\n                <a href=\"#\" className=\"font-semibold text-slate-900 hover\">\n                  Sign in\n                </a>\n              </p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n    </div>\n  );\n}\n",
