      "content": "/**\n * Component: Buttons with Icon\n * Author: @ui-dev-amar (https://tailwindflex.com/@ui-dev-amar)\n * Source: https://tailwindflex.com/@ui-dev-amar/buttons-with-icon\n * Attribution: Créé par @ui-dev-amar sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function ButtonsWithIcon() {\n  return (\n    <div>\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.13.1/css/all.min.css\" />\n    \n    <section className=\"flex flex-col md\">\n        <div className=\"flex-1 m-6\">\n            <p className=\"text-lg text-center\">Left icon</p>\n            <hr className=\"my-2\" />\n            <div className=\"flex flex-wrap justify-center\">\n                <button className=\"bg-black rounded-lg text-white text-xs text-center self-center px-3 py-2 my-2 mx-2\"><i className=\"fab fa-github mr-1\"></i> Github</button>\n                <button className=\"bg-blue-700 rounded-lg text-white text-xs text-center self-center px-3 py-2 my-2 mx-2\"><i className=\"fab fa-facebook mr-1\"></i> Facebook</button>\n                <button className=\"bg-red-700 rounded-lg text-white text-xs text-center self-center px-3 py-2 my-2 mx-2\"><i className=\"fab fa-youtube mr-1\"></i> Youtube</button>\n                <button className=\"bg-red-500 rounded-lg text-white text-xs text-center self-center px-3 py-2 my-2 mx-2\"><i className=\"fab fa-laravel mr-1\"></i> Laravel</button>\n                <button className=\"bg-green-200 text-green-800 rounded-lg text-xs text-center self-center px-3 py-2 my-2 mx-2\"><i className=\"fab fa-vuejs mr-1\"></i> VueJS</button>\n            </div>\n        </div>\n        <div className=\"flex-1 m-6\">\n            <p className=\"text-lg text-center\">Right icon</p>\n            <hr className=\"my-2\" />\n            <div className=\"flex flex-wrap justify-center\">\n                <button className=\"bg-black rounded-lg text-white text-xs text-center self-center px-3 py-2 my-2 mx-2\">Github <i className=\"fab fa-github ml-1\"></i></button>\n                <button className=\"bg-blue-700 rounded-lg text-white text-xs text-center self-center px-3 py-2 my-2 mx-2\">Facebook <i className=\"fab fa-facebook ml-1\"></i></button>\n                <button className=\"bg-red-700 rounded-lg text-white text-xs text-center self-center px-3 py-2 my-2 mx-2\">Youtube <i className=\"fab fa-youtube ml-1\"></i></button>\n                <button className=\"bg-red-500 rounded-lg text-white text-xs text-center self-center px-3 py-2 my-2 mx-2\">Laravel <i className=\"fab fa-laravel ml-1\"></i></button>\n                <button className=\"bg-green-200 text-green-800 rounded-lg text-xs text-center self-center px-3 py-2 my-2 mx-2\">VueJS <i className=\"fab fa-vuejs ml-1\"></i></button>\n            </div>\n        </div>\n    </section>\n    \n    </div>\n  );\n}\n",
