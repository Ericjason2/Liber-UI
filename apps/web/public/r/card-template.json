class=\"w-4 h-4 text-gray-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6\"></path></svg>\n                        <span class=\"text-sm text-gray-300\"><strong>1</strong> Room</span>\n                    </div>\n                </div>\n\n                <div class=\"flex justify-between items-center mt-3 mb-5 text-sm\">\n                    <div class=\"text-gray-400\">\n                        By <a href=\"#\" class=\"text-white underline decoration-gray-500 underline-offset-2\">Waleed Sabir</a>\n                    </div>\n                    <div class=\"text-gray-500\">5 days ago</div>\n                </div>\n\n                <button class=\"w-full bg-gradient-to-b from-gray-100 to-gray-200 hover:to-white text-black font-semibold py-3.5 rounded-2xl transition-all shadow-lg\">\n                    View Details\n                </button>\n            </div>\n        </div>\n\n    </div>\n\n</body>\n</html>"
