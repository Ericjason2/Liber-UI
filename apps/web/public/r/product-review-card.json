      "content": "/**\n * Component: Product review card\n * Author: @moriba1 (https://tailwindflex.com/@moriba1)\n * Source: https://tailwindflex.com/@moriba1/product-review-card\n * Attribution: Créé par @moriba1 sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function ProductReviewCard() {\n  return (\n    <div>\n    <section className=\"container mx-auto p-10 md20 px-0 md10 md0\">\n        <section className=\"relative px-10 md0 transform duration-500 hover2xl cursor-pointer hover1 \">\n            <img className=\"xl6xl\" src=\"https://images.pexels.com/photos/5990153/pexels-photo-5990153.jpeg?auto=compress&amp;cs=tinysrgb&amp;dpr=3&amp;h=750&amp;w=1860\" alt=\"\" />\n            <div className=\"content bg-white p-2 pt-8 md12 pb-12 lg w-full lg top-48 right-5\">\n                <div className=\"flex justify-between font-bold text-sm\">\n                    <p>Product Review</p>\n                    <p className=\"text-gray-400\">17th March, 2021</p>\n                </div>\n                <h2 className=\"text-3xl font-semibold mt-4 md10\">Coffee From Heaven</h2>\n                <p className=\"my-3 text-justify font-medium text-gray-700 leading-relaxed\">Lorem ipsum dolor sit amet\n                    consectetur adipisicing elit. Autem aperiam nulla cupiditate saepe sed quis veritatis minus rem adipisci\n                    aliquid.</p>\n                <button className=\"mt-2 md5 p-3 px-5 bg-black text-white font-bold text-sm hover800\">Read\n              More</button>\n            </div>\n        </section>\n    </section>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
