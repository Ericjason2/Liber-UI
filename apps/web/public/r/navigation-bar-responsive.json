      "content": "/**\n * Component: Navigation Bar Responsive\n * Author: @sai-bende (https://tailwindflex.com/@sai-bende)\n * Source: https://tailwindflex.com/@sai-bende/navigation-bar-responsive\n * Attribution: Créé par @sai-bende sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function NavigationBarResponsive() {\n  return (\n    <div>\n    <nav className=\"bg-black p-4\">\n        <div className=\"container mx-auto flex flex-col lg justify-between items-center\">\n            <div className=\"text-white font-bold text-3xl mb-4 lg0 hover600 hover\">Porfolio\n            </div>\n    \n            <div className=\"lg\">\n                <button className=\"text-white focus\">\n                        <svg\n                            className=\"h-6 w-6\"\n                            fill=\"none\"\n                            stroke=\"currentColor\"\n                            viewBox=\"0 0 24 24\"\n                            xmlns=\"http://www.w3.org/2000/svg\"\n                        >\n                            <path\n                                strokeLinecap=\"round\"\n                                strokeLinejoin=\"round\"\n                                strokeWidth=\"2\"\n                                d=\"M4 6h16M4 12h16m-7 6h7\"\n                            ></path>\n                        </svg>\n                    </button>\n            </div>\n    \n            <div className=\"lg flex-col lg lg4 lg0 mt-4 flex flex-col items-center text-xl\">\n                <a href=\"/\" className=\"text-white  px-4 py-2 hover600 \">Home</a>\n                <a href=\"#Projects\" className=\"text-white  px-4 py-2  hover600\">Projects</a>\n                <a href=\"/\" className=\"text-white  px-4 py-2  hover600\">About</a>\n                <a href=\"/\" className=\"text-white  px-4 py-2  hover600\">Contact Me</a>\n            </div>\n        </div>\n    \n    </nav>\n    \n    \n    \n    \n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
