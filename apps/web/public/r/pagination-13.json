    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Interactive Pagination</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n    <style>\n        @keyframes pulse {\n            0% { transform: scale(1); }\n            50% { transform: scale(1.05); }\n            100% { transform: scale(1); }\n        }\n        \n        @keyframes bounce {\n            0%, 100% { transform: translateY(0); }\n            50% { transform: translateY(-5px); }\n        }\n        \n        @keyframes fadeIn {\n            from { opacity: 0; transform: translateY(10px); }\n            to { opacity: 1; transform: translateY(0); }\n        }\n        \n        .pagination-item {\n            transition: all 0.3s ease;\n        }\n        \n        .pagination-item:hover {\n            transform: translateY(-2px);\n            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);\n        }\n        \n        .pagination-item.active {\n            animation: pulse 1.5s infinite;\n        }\n        \n        .page-transition {\n            animation: fadeIn 0.5s ease-out;\n        }\n    </style>\n</head>\n<body class=\"bg-gradient-to-br from-blue-50 to-indigo-100 min-h-screen flex flex-col items-center justify-center p-4\">\n    <div class=\"max-w-4xl w-full\">\n        <h1 class=\"text-4xl font-bold text-center text-indigo-800 mb-2\">Interactive Pagination</h1>\n        <p class=\"text-center text-gray-600 mb-10\">A responsive pagination with smooth animations</p>\n        \n        <!-- Content Section -->\n        <div class=\"bg-white rounded-xl shadow-lg p-6 mb-8 page-transition\" id=\"content\">\n            <h2 class=\"text-2xl font-bold text-gray-800 mb-4\">Page <span id=\"current-page\">1</span> Content</h2>\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n                <div class=\"bg-gradient-to-br from-blue-100 to-indigo-200 rounded-lg p-4 transform transition-transform duration-300 hover:scale-105\">\n                    <h3 class=\"font-semibold text-lg text-indigo-700 mb-2\">Feature One</h3>\n                    <p class=\"text-gray-600\">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore.</p>\n                </div>\n                <div class=\"bg-gradient-to-br from-purple-100 to-pink-200 rounded-lg p-4 transform transition-transform duration-300 hover:scale-105\">\n                    <h3 class=\"font-semibold text-lg text-purple-700 mb-2\">Feature Two</h3>\n                    <p class=\"text-gray-600\">Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo.</p>\n                </div>\n            </div>\n        </div>\n        \n        <!-- Pagination Component -->\n        <div class=\"bg-white rounded-xl shadow-lg p-6\">\n            <div class=\"flex flex-col items-center\">\n                <div class=\"flex items-center space-x-2 mb-4\">\n                    <!-- Previous Button -->\n                    <button id=\"prev-btn\" class=\"pagination-item flex items-center justify-center w-10 h-10 rounded-full bg-indigo-100 text-indigo-700 hover:bg-indigo-200 transition-colors duration-300\">\n                        <i class=\"fas fa-chevron-left\"></i>\n                    </button>\n                    \n                    <!-- Page Numbers -->\n                    <div class=\"flex space-x-2\" id=\"pagination-numbers\">\n                        <!-- Page numbers will be generated here -->\n                    </div>\n                    \n                    <!-- Next Button -->\n                    <button id=\"next-btn\" class=\"pagination-item flex items-center justify-center w-10 h-10 rounded-full bg-indigo-100 text-indigo-700 hover:bg-indigo-200 transition-colors duration-300\">\n                        <i class=\"fas fa-chevron-right\"></i>\n                    </button>\n                </div>\n                \n                <!-- Page Info -->\n                <div class=\"text-sm text-gray-600 mt-2\">\n                    Showing page <span id=\"page-info\">1</span> of <span id=\"total-pages\">5</span>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <script>\n        document.addEventListener('DOMContentLoaded', function() {\n            const totalPages = 5;\n            let currentPage = 1;\n            \n            const contentElement = document.getElementById('content');\n            const currentPageElement = document.getElementById('current-page');\n            const paginationNumbers = document.getElementById('pagination-numbers');\n            const prevButton = document.getElementById('prev-btn');\n            const nextButton = document.getElementById('next-btn');\n            const pageInfo = document.getElementById('page-info');\n            const totalPagesElement = document.getElementById('total-pages');\n            \n            // Initialize pagination\n            totalPagesElement.textContent = totalPages;\n            renderPagination();\n            updateButtons();\n            \n            // Generate pagination numbers\n            function renderPagination() {\n                paginationNumbers.innerHTML = '';\n                \n                // Always show first page\n                addPageNumber(1);\n                \n                // Calculate range of pages to show\n                let startPage = Math.max(2, currentPage - 1);\n                let endPage = Math.min(totalPages - 1, currentPage + 1);\n                \n                // Add ellipsis if needed\n                if (startPage > 2) {\n                    addEllipsis();\n                }\n                \n                // Add middle pages\n                for (let i = startPage; i <= endPage; i++) {\n                    addPageNumber(i);\n                }\n                \n                // Add ellipsis if needed\n                if (endPage < totalPages - 1) {\n                    addEllipsis();\n                }\n                \n                // Always show last page if there's more than one page\n                if (totalPages > 1) {\n                    addPageNumber(totalPages);\n                }\n            }\n            \n            function addPageNumber(pageNumber) {\n                const pageElement = document.createElement('button');\n                pageElement.className = `pagination-item flex items-center justify-center w-10 h-10 rounded-full transition-all duration-300 ${\n                    pageNumber === currentPage \n                    ? 'bg-indigo-600 text-white active shadow-md' \n                    : 'bg-gray-100 text-gray-700 hover:bg-indigo-100 hover:text-indigo-700'\n                }`;\n                pageElement.textContent = pageNumber;\n                pageElement.addEventListener('click', () => goToPage(pageNumber));\n                paginationNumbers.appendChild(pageElement);\n            }\n            \n            function addEllipsis() {\n                const ellipsis = document.createElement('span');\n                ellipsis.className = 'flex items-center justify-center w-10 h-10 text-gray-500';\n                ellipsis.textContent = '...';\n                paginationNumbers.appendChild(ellipsis);\n            }\n            \n            function goToPage(pageNumber) {\n                if (pageNumber < 1 || pageNumber > totalPages || pageNumber === currentPage) return;\n                \n                // Add animation to content\n                contentElement.classList.remove('page-transition');\n                void contentElement.offsetWidth; // Trigger reflow\n                contentElement.classList.add('page-transition');\n                \n                currentPage = pageNumber;\n                currentPageElement.textContent = currentPage;\n                pageInfo.textContent = currentPage;\n                \n                renderPagination();\n                updateButtons();\n                \n                // Update content based on page\n                updateContent();\n            }\n            \n            function updateButtons() {\n                prevButton.disabled = currentPage === 1;\n                nextButton.disabled = currentPage === totalPages;\n                \n                if (prevButton.disabled) {\n                    prevButton.classList.add('opacity-50', 'cursor-not-allowed');\n                    prevButton.classList.remove('hover:bg-indigo-200');\n                } else {\n                    prevButton.classList.remove('opacity-50', 'cursor-not-allowed');\n                    prevButton.classList.add('hover:bg-indigo-200');\n                }\n                \n                if (nextButton.disabled) {\n                    nextButton.classList.add('opacity-50', 'cursor-not-allowed');\n                    nextButton.classList.remove('hover:bg-indigo-200');\n                } else {\n                    nextButton.classList.remove('opacity-50', 'cursor-not-allowed');\n                    nextButton.classList.add('hover:bg-indigo-200');\n                }\n            }\n            \n            function updateContent() {\n                // In a real application, you would fetch new content here\n                // For this demo, we'll just update the text\n                const featureOne = contentElement.querySelector('div:first-child h3');\n                const featureTwo = contentElement.querySelector('div:last-child h3');\n                \n                featureOne.textContent = `Feature ${(currentPage - 1) * 2 + 1}`;\n                featureTwo.textContent = `Feature ${(currentPage - 1) * 2 + 2}`;\n            }\n            \n            // Event listeners\n            prevButton.addEventListener('click', () => goToPage(currentPage - 1));\n            nextButton.addEventListener('click', () => goToPage(currentPage + 1));\n            \n            // Add keyboard navigation\n            document.addEventListener('keydown', (e) => {\n                if (e.key === 'ArrowLeft') {\n                    goToPage(currentPage - 1);\n                } else if (e.key === 'ArrowRight') {\n                    goToPage(currentPage + 1);\n                }\n            });\n        });\n    </script>\n</body>\n</html>"
  }
