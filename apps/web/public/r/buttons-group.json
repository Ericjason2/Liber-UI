:-translate-x-full\n          hover:before:translate-x-full\n          before:transition-transform\n          before:duration-700\n        \">\n          Glass Outlined\n        </button>\n      </div>\n    </div>\n\n    <!-- Link Buttons Section -->\n    <div class=\"mb-8\">\n      <h2 class=\"text-xl font-semibold text-teal-900 dark:text-teal-100 mb-4\">Link Buttons</h2>\n      <div class=\"flex flex-wrap gap-4\">\n        <!-- Animated Link -->\n        <button class=\"\n          group\n          px-4 py-1\n          text-teal-600 dark:text-teal-300\n          font-medium\n          relative\n          overflow-hidden\n          hover:text-teal-800 dark:hover:text-teal-100\n          transition-colors duration-300\n          after:content-['']\n          after:absolute\n          after:w-full\n          after:h-0.5\n          after:bg-teal-500\n          after:left-0\n          after:bottom-0\n          after:transform\n          after:scale-x-0\n          after:origin-right\n          hover:after:scale-x-100\n          hover:after:origin-left\n          after:transition-transform\n          after:duration-300\n        \">\n          Animated Link\n        </button>\n\n        <!-- Glass Link -->\n        <button class=\"\n          relative\n          px-4 py-1\n          text-teal-700 dark:text-teal-200\n          font-medium\n          backdrop-blur-sm\n          rounded\n          overflow-hidden\n          hover:bg-teal-400/10\n          active:transform active:scale-95\n          transition-all duration-300\n          before:content-['']\n          before:absolute\n          before:top-0\n          before:left-0\n          before:w-full\n          before:h-full\n          before:bg-gradient-to-r\n          before:from-transparent\n          before:via-white/20\n          before:to-transparent\n          before:-translate-x-full\n          hover:before:translate-x-full\n          before:transition-transform\n          before:duration-700\n        \">\n     