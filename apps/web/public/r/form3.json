      "content": "/**\n * Component: form3\n * Author: @abdulbast (https://tailwindflex.com/@abdulbast)\n * Source: https://tailwindflex.com/@abdulbast/form3\n * Attribution: Créé par @abdulbast sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function Form3() {\n  return (\n    <div>\n    <section className=\"bg-white mt-4 p-1 xs8\">\n      <div className=\" max-w-96 sm4xl mx-auto border  border-[#4D7C0F] rounded-lg p-8\">\n        <h2 className=\"sm text-[12px] font-bold mb-6\">Description and Skills</h2>\n        <form>\n          <div className=\"space-y-6\">\n            <div className=\"grid sm3 grid-cols-1 gap-6\">\n              <div>\n                <label htmlFor=\"category\" className=\"text-xs xs font-medium text-gray-700 mb-1\">Jop Type</label><select name=\"type\" id=\"type\" className=\"h-[50px] rounded-[5px] text-xs xs border border-[#D1D5DB] w-full px-2\"><option value=\"Hourly\" selected=\"\">Hourly</option><option value=\"FixedRate\">Fixed rate</option></select>\n              </div>\n              <div>\n                <label htmlFor=\"from\" className=\"text-xs xs font-medium text-gray-700 mb-1\">From <span className=\"font-light\">(Optional)</span></label>\n                <div className=\"relative max-w-xs\">\n                  <span className=\"absolute inset-y-0 left-0 flex items-center pl-3 text-gray-500 text-lg font-medium\">$</span><input type=\"text\" className=\"h-[50px] rounded-[5px] text-xs xs border border-[#D1D5DB] w-full px-2 pl-8 font-light\" placeholder=\"0.00\" value=\"\" />\n                </div>\n              </div>\n              <div>\n                <label htmlFor=\"to\" className=\"text-xs xs font-medium text-gray-700 mb-1\">To <span className=\"font-light\">(Optional)</span></label>\n                <div className=\"relative max-w-xs\">\n                  <span className=\"absolute inset-y-0 left-0 flex items-center pl-3 text-gray-500 text-lg font-medium\">$</span><input type=\"text\" className=\"h-[50px] rounded-[5px] text-xs xs border border-[#D1D5DB] w-full px-2 pl-8 font-light\" placeholder=\"0.00\" value=\"\" />\n                </div>\n              </div>\n            </div>\n            <div className=\"relative h-12 pt-3 mb-4\"><input type=\"date\" className=\"bg-white border border-gray-300 text-gray-900 text-sm rounded-lg w-full pl-10 p-5\" name=\"date\" value=\"\" />\n              <div className=\"absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none\"></div>\n            </div>\n          </div>\n          <div className=\"mt-8 pt-6 border-t border-gray-200 flex justify-between\">\n            <button className=\"hidden sm underline-offset-8\">back</button><button type=\"submit\" className=\" sm[86px] w-full h-[50px] text-xs sm bg-[#4D7C0F] rounded-[5px] p-[13px_25px] gap-[10px] text-white\">Next</button>\n          </div>\n        </form>\n      </div>\n    </section>\n    \n    \n    <section className=\"bg-white mt-4 p-1 xs8\">\n      <div className=\" max-w-96 sm4xl mx-auto border border-[#4D7C0F] rounded-lg p-3 xs8\">\n        <h2 className=\"sm text-[12px] font-bold mb-6\">Publish</h2>\n        <form>\n          <div className=\"space-y-6\">\n            <div className=\"grid sm4 grid-cols-4 gap-1\">\n              <div><label htmlFor=\"category\" className=\"text-xs xs font-medium text-gray-700 mb-1\">Jop adience</label></div>\n              <div className=\"flex items-center col-span-1\">\n                <input type=\"checkbox\" id=\"custom-checkbox\" className=\"appearance-none w-4 h-4 xs5 xs5 border border-black  rounded-sm bg-white checked[#4D7C0F] checked[#4D7C0F] cursor-pointer transition-colors duration-200 ease-in-out relative\" /><label htmlFor=\"\" className=\"ml-1 xs3 text-[14px]\">Public</label>\n              </div>\n              <div className=\"flex items-center col-span-2\">\n                <input type=\"checkbox\" id=\"custom-checkbox\" className=\"appearance-none w-4 h-4 xs5 xs5 border border-black  rounded-sm bg-white checked[#4D7C0F] checked[#4D7C0F] cursor-pointer transition-colors duration-200 ease-in-out relative\" name=\"Invite\" /><label htmlFor=\"Invite\" className=\"ml-1 xs3 text-[14px] xs\">Invite freelancer</label>\n              </div>\n            </div>\n          </div>\n          <div className=\"mt-8 pt-6 border-t border-gray-200 flex justify-between\">\n            <button className=\"hidden sm underline-offset-8\">back</button><button type=\"submit\" className=\" sm[86px] w-full h-[50px] text-xs sm bg-[#4D7C0F] rounded-[5px] p-[13px_25px] gap-[10px] text-white\">Post</button>\n          </div>\n        </form>\n      </div>\n    </section>\n    </div>\n  );\n}\n",
