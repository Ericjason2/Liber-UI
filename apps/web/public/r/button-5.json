    "mention": "Créé par @nabile-7 sur TailwindFlex",
    "rawHtml": "<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css\">\n\n\n<button id=\"btn\" class=\"border rounded-md m-3 p-2 bg-blue-500 text-white font-bold active:translate-y-1 hover:scale-[1.1] transition-all\" onclick=\"handleSubscribe()\">\n   <i id=\"spin\" class=\"fa-solid fa-spinner fa-spin-pulse\" hidden></i>\n   <span id=\"btnText\">Subscribe</span>\n</button>\n\n<script>\n    function handleSubscribe() {\n        const btn = document.querySelector('#btn');\n        const spin = document.querySelector('#spin');\n        const btnText = document.querySelector('#btnText');\n\n        // 1. Afficher le spinner et changer le texte\n        spin.hidden = false; \n        btnText.innerText = \"Loading...\";\n        btn.disabled = true; // Désactive le bouton pour éviter les doubles clics\n        btn.classList.add('opacity-75', 'cursor-not-allowed');\n\n        // 2. Simuler un appel serveur (ex: ajout d'un étudiant en base de données)\n        setTimeout(() => {\n            spin.hidden = true;\n            btnText.innerText = \"Subscribed !\";\n            btn.classList.replace('bg-blue-500', 'bg-green-500');\n        }, 3000);\n    }\n</script>"
  }
