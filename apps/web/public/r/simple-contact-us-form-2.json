      "content": "/**\n * Component: Simple contact us form\n * Author: @geoffrey-callaghan (https://tailwindflex.com/@geoffrey-callaghan)\n * Source: https://tailwindflex.com/@geoffrey-callaghan/simple-contact-us-form-2\n * Attribution: Créé par @geoffrey-callaghan sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function SimpleContactUsForm2() {\n  return (\n    <div>\n    <div className=\"flex items-center justify-center p-12\">\n        \n        \n        <div className=\"mx-auto w-full max-w-[550px] bg-white\">\n            <form action=\"https://fabform.io/f/{form-id}\" method=\"post\">\n                <div className=\"mb-5\">\n                    <label htmlFor=\"name\" className=\"mb-3 block text-base font-medium text-[#07074D]\">\n                        Full Name\n                    </label>\n                    <input type=\"text\" name=\"name\" id=\"name\" placeholder=\"Full Name\"\n                        className=\"w-full rounded-md border border-[#e0e0e0] bg-white py-3 px-6 text-base font-medium text-[#6B7280] outline-none focus[#6A64F1] focus\" />\n                </div>\n                <div className=\"mb-5\">\n                    <label htmlFor=\"email\" className=\"mb-3 block text-base font-medium text-[#07074D]\">\n                        Email Address\n                    </label>\n                    <input type=\"email\" name=\"email\" id=\"email\" placeholder=\"example.com\"\n                        className=\"w-full rounded-md border border-[#e0e0e0] bg-white py-3 px-6 text-base font-medium text-[#6B7280] outline-none focus[#6A64F1] focus\" />\n                </div>\n                <div className=\"mb-5\">\n                    <label htmlFor=\"subject\" className=\"mb-3 block text-base font-medium text-[#07074D]\">\n                        Subject\n                    </label>\n                    <input type=\"text\" name=\"subject\" id=\"subject\" placeholder=\"Enter your subject\"\n                        className=\"w-full rounded-md border border-[#e0e0e0] bg-white py-3 px-6 text-base font-medium text-[#6B7280] outline-none focus[#6A64F1] focus\" />\n                </div>\n                <div className=\"mb-5\">\n                    <label htmlFor=\"message\" className=\"mb-3 block text-base font-medium text-[#07074D]\">\n                        Message\n                    </label>\n                    <textarea rows=\"4\" name=\"message\" id=\"message\" placeholder=\"Type your message\"\n                        className=\"w-full resize-none rounded-md border border-[#e0e0e0] bg-white py-3 px-6 text-base font-medium text-[#6B7280] outline-none focus[#6A64F1] focus\"></textarea>\n                </div>\n                <div>\n                    <button\n                        className=\"hover rounded-md bg-[#6A64F1] py-3 px-8 text-base font-semibold text-white outline-none\">\n                        Submit\n                    </button>\n                </div>\n            </form>\n            <a href=\"https://veilmail.io/e/FkKh7o\" className=\"font-medium text-blue-600 hover\">Or\n                click here to reveal our protected email address</a>\n    \n        </div>\n    \n    </div>\n    </div>\n  );\n}\n",
