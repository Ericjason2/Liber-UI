      "content": "/**\n * Component: content section\n * Author: @thuggys (https://tailwindflex.com/@thuggys)\n * Source: https://tailwindflex.com/@thuggys/content-section\n * Attribution: Créé par @thuggys sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function ContentSection() {\n  return (\n    <div dangerouslySetInnerHTML={{ __html: \"\\n</head>\\n<body class=\\\"bg-neutral-950\\\">\\n    <!-- Content Section Component -->\\n    <section class=\\\"relative py-8 sm:py-12 md:py-16 overflow-hidden\\\">\\n        <!-- Content Container -->\\n        <div class=\\\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\\\">\\n            <!-- Content Grid -->\\n            <div class=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8\\\">\\n                <!-- Main Content -->\\n                <div class=\\\"lg:col-span-7 xl:col-span-8 order-2 lg:order-1\\\">\\n                    <article class=\\\"prose prose-invert prose-lg max-w-none\\\">\\n                        <h2 class=\\\"text-2xl sm:text-3xl font-light tracking-tight text-white mb-6 sm:mb-8 animate-fade-in\\\">\\n                            The Evolution of Modern Design\\n                        </h2>\\n                        <div class=\\\"space-y-4 sm:space-y-6 text-neutral-300 text-base sm:text-lg\\\">\\n                            <p class=\\\"animate-slide-up\\\" style=\\\"animation-delay: 0.1s\\\">\\n                                Design is no longer just about aesthetics—it's about creating experiences that resonate with users on a deeper level. Through careful consideration of space, typography, and interaction, we craft interfaces that feel both familiar and innovative.\\n                            </p>\\n                            <p class=\\\"animate-slide-up\\\" style=\\\"animation-delay: 0.2s\\\">\\n                                The key lies in understanding the delicate balance between form and function. Each element serves a purpose, contributing to a cohesive whole that guides users naturally through their journey.\\n                            </p>\\n                            <div class=\\\"relative my-8 sm:my-12 animate-fade-in\\\" style=\\\"animation-delay: 0.3s\\\">\\n                                <div class=\\\"absolute inset-0 bg-gradient-to-r from-neutral-800/50 to-transparent rounded-lg sm:rounded-xl\\\"></div>\\n                                <blockquote class=\\\"relative border-l-2 border-neutral-700 pl-4 sm:pl-6 py-3 sm:py-4\\\">\\n                                    <p class=\\\"text-lg sm:text-xl text-white italic font-light\\\">\\n                                        \\\"Design is not just what it looks like and feels like. Design is how it works.\\\"\\n                                    </p>\\n                                    <cite class=\\\"block mt-3 sm:mt-4 text-sm text-neutral-400\\\">— Steve Jobs</cite>\\n                                </blockquote>\\n                            </div>\\n                            <p class=\\\"animate-slide-up\\\" style=\\\"animation-delay: 0.4s\\\">\\n                                As we move forward, the focus shifts towards creating sustainable, accessible, and inclusive designs that stand the test of time while pushing the boundaries of innovation.\\n                            </p>\\n                        </div>\\n                    </article>\\n                </div>\\n\\n                <!-- Sidebar Content -->\\n                <aside class=\\\"lg:col-span-5 xl:col-span-4 order-1 lg:order-2 space-y-6 sm:space-y-8\\\">\\n                    <!-- Key Points -->\\n                    <div class=\\\"bg-neutral-900/50 backdrop-blur-sm border border-neutral-800 rounded-lg sm:rounded-xl p-4 sm:p-6 animate-slide-left\\\" style=\\\"animation-delay: 0.5s\\\">\\n                        <h3 class=\\\"text-base sm:text-lg font-light text-white mb-3 sm:mb-4\\\">Key Principles</h3>\\n                        <ul class=\\\"space-y-2 sm:space-y-3 text-neutral-400 text-sm sm:text-base\\\">\\n                            <li class=\\\"flex items-center gap-3\\\">\\n                                <div class=\\\"w-1 h-1 bg-neutral-700 rounded-full\\\"></div>\\n                                <span>Minimalist Approach</span>\\n                            </li>\\n                            <li class=\\\"flex items-center gap-3\\\">\\n                                <div class=\\\"w-1 h-1 bg-neutral-700 rounded-full\\\"></div>\\n                                <span>Functional Aesthetics</span>\\n                            </li>\\n                            <li class=\\\"flex items-center gap-3\\\">\\n                                <div class=\\\"w-1 h-1 bg-neutral-700 rounded-full\\\"></div>\\n                                <span>User-Centric Focus</span>\\n                            </li>\\n                            <li class=\\\"flex items-center gap-3\\\">\\n                                <div class=\\\"w-1 h-1 bg-neutral-700 rounded-full\\\"></div>\\n                                <span>Responsive Elements</span>\\n                            </li>\\n                        </ul>\\n                    </div>\\n\\n                    <!-- Related Topics -->\\n                    <div class=\\\"space-y-3 sm:space-y-4 animate-slide-left\\\" style=\\\"animation-delay: 0.6s\\\">\\n                        <h3 class=\\\"text-base sm:text-lg font-light text-white\\\">Related Topics</h3>\\n                        <div class=\\\"flex flex-wrap gap-2\\\">\\n                            <span class=\\\"px-2 sm:px-3 py-1 bg-neutral-900/50 border border-neutral-800 rounded-full text-xs sm:text-sm text-neutral-400 hover:text-white hover:border-neutral-700 transition-colors duration-300\\\">Typography</span>\\n                            <span class=\\\"px-2 sm:px-3 py-1 bg-neutral-900/50 border border-neutral-800 rounded-full text-xs sm:text-sm text-neutral-400 hover:text-white hover:border-neutral-700 transition-colors duration-300\\\">Layout</span>\\n                            <span class=\\\"px-2 sm:px-3 py-1 bg-neutral-900/50 border border-neutral-800 rounded-full text-xs sm:text-sm text-neutral-400 hover:text-white hover:border-neutral-700 transition-colors duration-300\\\">Color Theory</span>\\n                            <span class=\\\"px-2 sm:px-3 py-1 bg-neutral-900/50 border border-neutral-800 rounded-full text-xs sm:text-sm text-neutral-400 hover:text-white hover:border-neutral-700 transition-colors duration-300\\\">Interaction</span>\\n                            <span class=\\\"px-2 sm:px-3 py-1 bg-neutral-900/50 border border-neutral-800 rounded-full text-xs sm:text-sm text-neutral-400 hover:text-white hover:border-neutral-700 transition-colors duration-300\\\">Accessibility</span>\\n                        </div>\\n                    </div>\\n                </aside>\\n            </div>\\n        </div>\\n    </section>\\n</body>\\n</html>\" }} />\n  );\n}\n",
      "type": "registry:ui"
    }
