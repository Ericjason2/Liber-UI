      "content": "/**\n * Component: Mobile Developer Hero\n * Author: @reuben-enahoro (https://tailwindflex.com/@reuben-enahoro)\n * Source: https://tailwindflex.com/@reuben-enahoro/mobile-developer-hero\n * Attribution: Créé par @reuben-enahoro sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function MobileDeveloperHero() {\n  return (\n    <div>\n    <section aria-labelledby=\"hero-heading\" className=\"relative sm6 lg8 mt-12 mx-auto px-4 sm6 lg8 overflow-hidden\">\n        \n        <div className=\"absolute inset-0 -z-10 overflow-hidden\" aria-hidden=\"true\">\n          <div className=\"absolute -top-40 -right-40 w-96 h-96 bg-indigo-500 rounded-full blur-3xl opacity-10\"></div>\n          <div className=\"absolute -bottom-40 -left-40 w-96 h-96 bg-purple-500 rounded-full blur-3xl opacity-10\"></div>\n        </div>\n    \n        <div className=\"my-10 mx-auto max-w-7xl px-4 sm12 sm6 md16 lg20 lg8 xl28 flex gap-8 lg12 items-center flex-col-reverse lg\">\n          \n          <div className=\"sm lg flex-1\">\n            <h1 id=\"hero-heading\" className=\"text-4xl tracking-tight font-extrabold text-gray-800 sm5xl md6xl\">\n              <span className=\"block xl dark800\">Full Stack Mobile</span>\n              <span className=\"block text-transparent bg-clip-text bg-[#066F6F] dark[#066F6F] dark400 xl\">Developer</span>\n            </h1>\n    \n            <p className=\"mt-3 text-base text-gray-500 dark400 sm5 sm sm sm md5 md lg0\">\n              Building mobile-first, full-stack solutions for modern applications.\n            </p>\n    \n            \n            <div className=\"mt-5 sm8 sm sm lg\">\n              <div className=\"rounded-md shadow-lg transform transition-transform hover105 hover1\">\n                <a href=\"#projects\" className=\"w-full flex items-center justify-center px-8 py-3 border border-transparent text-base font-medium rounded-md text-white bg-[#066F6F] hover2 hover hover[#066F6F] hover[#066F6F] md4 md md10 transition-all duration-200 focus focus2 focus2 focus500\">\n                  View Projects\n                </a>\n              </div>\n              <div className=\"mt-3 sm0 sm3 transform transition-transform hover105 hover1\">\n                <a href=\"#contact\" className=\"w-full flex items-center justify-center px-8 py-3 border-2 border-[#066F6F] dark[#066F6F] text-base font-medium rounded-md text-[#066F6F] dark[#066F6F] bg-transparent hover50 dark900/20 md4 md md10 transition-all duration-200 focus focus2 focus2 focus500\">\n                  Get in Touch\n                </a>\n              </div>\n            </div>\n          </div>\n    \n          \n          <div className=\"flex-1 relative w-full lg1/2\">\n            <div className=\"relative w-full h-full min-h-[400px] sm[500px] lg[600px] animate-bounce-slow\">\n              \n              <div className=\"absolute inset-0 bg-gradient-to-br from-indigo-100 to-purple-100 dark900/20 dark900/20 rounded-3xl blur-2xl opacity-50\" aria-hidden=\"true\"></div>\n    \n              \n              <img id=\"hero-image\" src=\"https://cdn.pixabay.com/photo/2024/02/15/22/58/ai-generated-8576296_1280.jpg\" className=\"relative w-full h-full object-cover rounded-2xl shadow-2xl\" alt=\"Mobile development workspace with IDE and devices\" loading=\"eager\" />\n    \n              \n              <div className=\"absolute inset-0 bg-gradient-to-t from-black/10 to-transparent rounded-2xl pointer-events-none\" aria-hidden=\"true\"></div>\n            </div>\n    \n            \n            <div className=\"absolute -bottom-4 -left-4 bg-white dark800 rounded-xl shadow-xl p-4 border border-gray-100 dark700\">\n              <div className=\"flex items-center gap-3\">\n                <div className=\"w-12 h-12 rounded-full bg-gradient-to-br from-indigo-500 to-purple-500 flex items-center justify-center\">\n                  <svg className=\"w-6 h-6 text-white\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n                    <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z\" />\n                  </svg>\n                </div>\n                <div>\n                  <p className=\"text-sm font-semibold text-gray-900 dark\">5+ Years</p>\n                  <p className=\"text-xs text-gray-500 dark400\">Experience</p>\n                </div>\n              </div>\n            </div>\n    \n            <div className=\"absolute -top-4 -right-4 bg-white dark800 rounded-xl shadow-xl p-4 border border-gray-100 dark700\">\n              <div className=\"flex items-center gap-3\">\n                <div className=\"w-12 h-12 rounded-full bg-gradient-to-br from-green-500 to-emerald-500 flex items-center justify-center\">\n                  <svg className=\"w-6 h-6 text-white\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n                    <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z\" />\n                  </svg>\n                </div>\n                <div>\n                  <p className=\"text-sm font-semibold text-gray-900 dark\">200K+</p>\n                  <p className=\"text-xs text-gray-500 dark400\">Downloads</p>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n    </div>\n  );\n}\n",
