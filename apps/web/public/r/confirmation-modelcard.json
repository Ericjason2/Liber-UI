      "content": "/**\n * Component: Confirmation modal/card\n * Author: @sophia-baker (https://tailwindflex.com/@sophia-baker)\n * Source: https://tailwindflex.com/@sophia-baker/confirmation-modelcard\n * Attribution: Créé par @sophia-baker sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function ConfirmationModelcard() {\n  return (\n    <div>\n    <div className=\"border rounded-lg shadow relative max-w-sm\">\n        <div className=\"flex justify-end p-2\">\n            <button type=\"button\" className=\"text-gray-400 bg-transparent hover200 hover900 rounded-lg text-sm p-1.5 ml-auto inline-flex items-center\">\n                <svg className=\"w-5 h-5\" fill=\"currentColor\" viewBox=\"0 0 20 20\" xmlns=\"http://www.w3.org/2000/svg\"><path fillRule=\"evenodd\" d=\"M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z\" clipRule=\"evenodd\"></path></svg>\n            </button>\n        </div>\n    \n        <div className=\"p-6 pt-0 text-center\">\n            <svg className=\"w-20 h-20 text-red-600 mx-auto\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"\n                xmlns=\"http://www.w3.org/2000/svg\">\n                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\"\n                    d=\"M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"></path>\n            </svg>\n            <h3 className=\"text-xl font-normal text-gray-500 mt-5 mb-6\">Are you sure you want to delete this user?</h3>\n            <a href=\"#\"\n                className=\"text-white bg-red-600 hover800 focus4 focus300 font-medium rounded-lg text-base inline-flex items-center px-3 py-2.5 text-center mr-2\">\n                Yes, I'm sure\n            </a>\n            <a href=\"#\"\n                className=\"text-gray-900 bg-white hover100 focus4 focus200 border border-gray-200 font-medium inline-flex items-center rounded-lg text-base px-3 py-2.5 text-center\">\n                No, cancel\n            </a>\n        </div>\n    </div>\n    </div>\n  );\n}\n",
