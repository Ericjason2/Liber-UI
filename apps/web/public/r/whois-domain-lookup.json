    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>WHOIS Domain Lookup</title>\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/alpinejs/3.12.0/cdn.min.js\" defer></script>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n</head>\n<body class=\"bg-gray-100 min-h-screen flex items-center justify-center p-4\">\n    <div class=\"w-full max-w-2xl\" x-data=\"{ \n        domain: '',\n        isLoading: false,\n        error: '',\n        result: null,\n        validDomain: false,\n        \n        validateDomain() {\n            const domainRegex = /^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9][a-z0-9-]{0,61}[a-z0-9]$/i;\n            this.validDomain = domainRegex.test(this.domain);\n            this.error = '';\n        },\n        \n        async checkDomain() {\n            if (!this.validDomain) {\n                this.error = 'Please enter a valid domain name';\n                return;\n            }\n            \n            this.isLoading = true;\n            this.result = null;\n            \n            try {\n                // This is a demo - in a real implementation, you would call an actual WHOIS API here\n                // For example: const response = await fetch(`https://your-whois-api.com/api?domain=${this.domain}`);\n                \n                // Simulating API call with timeout\n                await new Promise(resolve => setTimeout(resolve, 1500));\n                \n                // Mock response - in reality you'd parse the actual API response\n                if (this.domain === 'example.com') {\n                    this.result = {\n                        domainName: 'example.com',\n                        registrar: 'ICANN',\n                        registrantName: 'Internet Assigned Numbers Authority',\n                        registrantOrganization: 'Internet Corporation for Assigned Names and Numbers',\n                        registrantCountry: 'United States',\n                        creationDate: '1992-01-01',\n                        expirationDate: '2023-12-31',\n                        updatedDate: '2022-06-15',\n                        nameServers: ['a.iana-servers.net', 'b.iana-servers.net'],\n                        status: ['clientTransferProhibited'],\n                        dnssec: 'unsigned'\n                    };\n                } else {\n                    this.result = {\n                        domainName: this.domain,\n                        registrar: 'Example Registrar, LLC',\n                        registrantName: 'Domain Administrator',\n                        registrantOrganization: 'Example Organization',\n                        registrantCountry: 'US',\n                        creationDate: '2020-01-01',\n                        expirationDate: '2025-01-01',\n                        updatedDate: '2023-01-01',\n                        nameServers: ['ns1.example-registrar.com', 'ns2.example-registrar.com'],\n                        status: ['clientTransferProhibited', 'clientUpdateProhibited'],\n                        dnssec: 'unsigned'\n                    };\n                }\n            } catch (error) {\n                this.error = 'Failed to fetch WHOIS information. Please try again later.';\n                console.error('Error:', error);\n            } finally {\n                this.isLoading = false;\n            }\n        }\n    }\">\n        <div class=\"bg-white rounded-lg shadow-lg overflow-hidden\">\n            <div class=\"bg-blue-600 p-6\">\n                <h1 class=\"text-3xl font-bold text-white text-center\">WHOIS Domain Lookup</h1>\n                <p class=\"text-blue-100 text-center mt-2\">Check registration details for any domain name</p>\n            </div>\n            \n            <div class=\"p-6\">\n                <div class=\"mb-6\">\n                    <label for=\"domain\" class=\"block text-sm font-medium text-gray-700 mb-1\">Domain Name</label>\n                    <div class=\"flex\">\n                        <input \n                            type=\"text\" \n                            id=\"domain\" \n                            x-model=\"domain\"\n                            @input=\"validateDomain\"\n                            placeholder=\"example.com\" \n                            class=\"flex-1 block w-full rounded-l-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm p-3 border\"\n                        >\n                        <button \n                            @click=\"checkDomain\"\n                            :disabled=\"!validDomain || isLoading\"\n                            class=\"bg-blue-600 text-white px-4 py-2 rounded-r-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed\"\n                        >\n                            <span x-show=\"!isLoading\">Lookup</span>\n                            <span x-show=\"isLoading\" class=\"flex items-center\">\n                                <svg class=\"animate-spin -ml-1 mr-2 h-4 w-4 text-white\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\">\n                                    <circle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\"></circle>\n                                    <path class=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z\"></path>\n                                </svg>\n                                Loading...\n                            </span>\n                        </button>\n                    </div>\n                    <p x-show=\"error\" x-text=\"error\" class=\"mt-2 text-sm text-red-600\"></p>\n                    <p class=\"mt-2 text-xs text-gray-500\">Enter a domain name without http:// or www (e.g., example.com)</p>\n                </div>\n                \n                <!-- Results Section -->\n                <div x-show=\"result\" class=\"mt-6 border-t border-gray-200 pt-6\">\n                    <h2 class=\"text-lg font-medium text-gray-900\">WHOIS Results for <span x-text=\"result?.domainName\" class=\"font-bold\"></span></h2>\n                    \n                    <div class=\"mt-4 space-y-4\">\n                        <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                            <div>\n                                <h3 class=\"text-sm font-medium text-gray-500\">Registrar</h3>\n                                <p x-text=\"result?.registrar\" class=\"mt-1 text-sm text-gray-900\"></p>\n                            </div>\n                            <div>\n                                <h3 class=\"text-sm font-medium text-gray-500\">Registrant Organization</h3>\n                                <p x-text=\"result?.registrantOrganization\" class=\"mt-1 text-sm text-gray-900\"></p>\n                            </div>\n                            <div>\n                                <h3 class=\"text-sm font-medium text-gray-500\">Registrant Country</h3>\n                                <p x-text=\"result?.registrantCountry\" class=\"mt-1 text-sm text-gray-900\"></p>\n                            </div>\n                            <div>\n                                <h3 class=\"text-sm font-medium text-gray-500\">DNSSEC</h3>\n                                <p x-text=\"result?.dnssec\" class=\"mt-1 text-sm text-gray-900\"></p>\n                            </div>\n                        </div>\n                        \n                        <div class=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\n                            <div>\n                                <h3 class=\"text-sm font-medium text-gray-500\">Creation Date</h3>\n                                <p x-text=\"result?.creationDate\" class=\"mt-1 text-sm text-gray-900\"></p>\n                            </div>\n                            <div>\n                                <h3 class=\"text-sm font-medium text-gray-500\">Updated Date</h3>\n                                <p x-text=\"result?.updatedDate\" class=\"mt-1 text-sm text-gray-900\"></p>\n                            </div>\n                            <div>\n                                <h3 class=\"text-sm font-medium text-gray-500\">Expiration Date</h3>\n                                <p x-text=\"result?.expirationDate\" class=\"mt-1 text-sm text-gray-900\"></p>\n                            </div>\n                        </div>\n                        \n                        <div>\n                            <h3 class=\"text-sm font-medium text-gray-500\">Name Servers</h3>\n                            <ul class=\"mt-1 space-y-1\">\n                                <template x-for=\"server in result?.nameServers\" :key=\"server\">\n                                    <li x-text=\"server\" class=\"text-sm text-gray-900\"></li>\n                                </template>\n                            </ul>\n                        </div>\n                        \n                        <div>\n                            <h3 class=\"text-sm font-medium text-gray-500\">Domain Status</h3>\n                            <ul class=\"mt-1 space-y-1\">\n                                <template x-for=\"status in result?.status\" :key=\"status\">\n                                    <li x-text=\"status\" class=\"text-sm text-gray-900\"></li>\n                                </template>\n                            </ul>\n                        </div>\n                    </div>\n                </div>\n                \n                <!-- No Results Message -->\n                <div x-show=\"!result && !isLoading && !error\" class=\"mt-6 text-center p-6 border border-gray-200 rounded-md bg-gray-50\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"mx-auto h-12 w-12 text-gray-400\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z\" />\n                    </svg>\n                    <h3 class=\"mt-2 text-sm font-medium text-gray-900\">No Results</h3>\n                    <p class=\"mt-1 text-sm text-gray-500\">Enter a domain name and click Lookup to see WHOIS information.</p>\n                </div>\n            </div>\n            \n            <div class=\"bg-gray-50 px-6 py-4 text-xs text-gray-500 text-center border-t border-gray-200\">\n                Disclaimer: WHOIS information is provided for informational purposes only and may not be entirely accurate or up-to-date.\n            </div>\n        </div>\n    </div>\n</body>\n</html>"
  }
