      "path": "ui/animated-profile-card.tsx",
      "content": "/**\n * Component: Animated Profile Card\n * Author: @shivam-vishvakarma (https://tailwindflex.com/@shivam-vishvakarma)\n * Source: https://tailwindflex.com/@shivam-vishvakarma/animated-profile-card\n * Attribution: Créé par @shivam-vishvakarma sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function AnimatedProfileCard() {\n  return (\n    <div>\n    <div className=\"flex flex-col items-center bg-purple-500 py-5 px-3 transition-all hover2xl hover2 cursor-pointer rounded-xl shadow-xl\">\n      <div className=\"relative size-24\">\n        <div className=\"absolute z-0 inset-0 scale-110\">\n          <svg className=\"w-full h-full\" viewbox=\"0 0 100 100\">\n            <defs>\n              <clipPath id=\"circleView\">\n                <circle cx=\"50\" cy=\"50\" r=\"35\" />\n              </clipPath>\n            </defs>\n            \n            <path fill=\"none\" className=\"stroke-white\" strokeLinecap=\"round\" strokeWidth=\"5\" stroke=\"current-color\" stroke-dasharray=\"150.72,251.2\"\n              d=\"M50 10 a 40 40 0 0 1 0 80 a 40 40 0 0 1 0 -80\">\n              \n              <animate attributeName=\"stroke-dasharray\" from=\"0,251.2\" to=\"150.72,251.2\" dur=\"5s\" />\n            </path>\n            <image width=\"100\" height=\"100\" xlink\n              clip-path=\"url(#circleView)\" />\n          </svg>\n        </div>\n      </div>\n      <h4 className=\"mx-2 mt-2 font-medium tracking-widest uppercase text-white\">\n        Shivam\n      </h4>\n      <p className=\"mx-2 text-xs tracking-wide text-white uppercase\">\n        Profile 60% Completed\n      </p>\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
  ],
