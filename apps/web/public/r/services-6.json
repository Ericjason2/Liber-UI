mt-0\">\n              <button class=\"px-8 py-4 bg-black text-white text-base font-medium hover:bg-gray-800 transition-colors whitespace-nowrap\">\n                                Learn More\n                            </button>\n            </div>\n          </div>\n        </div>\n\n        <!-- Service 2 -->\n        <div class=\"bg-white p-12 rounded-none shadow-sm\">\n          <div class=\"flex flex-col lg:flex-row lg:items-center lg:justify-between\">\n            <div class=\"mb-5 lg:mb-0 lg:mr-16 lg:flex-1\">\n              <h3 class=\"text-2xl font-semibold text-black mb-3\">UI/UX Design</h3>\n              <p class=\"text-lg text-gray-600 leading-relaxed\">\n                Our team creates intuitive user interfaces that enhance experience and engagement for your digital\n                products.\n              </p>\n            </div>\n            <div class=\"flex lg:items-center mt-5 lg:mt-0\">\n              <button class=\"px-8 py-4 bg-black text-white text-base font-medium hover:bg-gray-800 transition-colors whitespace-nowrap\">\n                                Learn More\n                            </button>\n            </div>\n          </div>\n        </div>\n\n        <!-- Service 3 -->\n        <div class=\"bg-white p-12 rounded-none shadow-sm\">\n          <div class=\"flex flex-col lg:flex-row lg:items-center lg:justify-between\">\n            <div class=\"mb-5 lg:mb-0 lg:mr-16 lg:flex-1\">\n              <h3 class=\"text-2xl font-semibold text-black mb-3\">Digital Marketing</h3>\n              <p class=\"text-lg text-gray-600 leading-relaxed\">\n                We help businesses grow their online presence through strategic campaigns and SEO optimization.\n              </p>\n            </div>\n            <div class=\"flex lg:items-center mt-5 lg:mt-0\">\n              <button class=\"px-8 py-4 bg-black text-white text-base font-medium hover:bg-gray-800 transition-colors whitespace-nowrap\">\n                                Learn More\n                            </button>\n            </div>\n          </div>\n        </div>\n\n        <!-- Service 4 -->\n        <div class=\"bg-white p-12 rounded-none shadow-sm\">\n          <div class=\"flex flex-col lg:flex-row lg:items-center lg:justify-between\">\n            <div class=\"mb-5 lg:mb-0 lg:mr-16 lg:flex-1\">\n              <h3 class=\"text-2xl font-semibold text-black mb-3\">Mobile App Development</h3>\n              <p class=\"text-lg text-gray-600 leading-relaxed\">\n                We build native and cross-platform mobile applications with seamless user experiences and high\n                performance.\n              </p>\n            </div>\n            <div class=\"flex lg:items-center mt-5 lg:mt-0\">\n              <button class=\"px-8 py-4 bg-black text-white text-base font-medium hover:bg-gray-800 transition-colors whitespace-nowrap\">\n                                Learn More\n                            </button>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n</body>\n\n</html>"
