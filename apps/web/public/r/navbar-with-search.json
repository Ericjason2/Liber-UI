9-4-4m0-7A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z\" />\n              </svg>\n              <span className=\"sr-only\">Search icon</span>\n            </div>\n            <input type=\"text\" id=\"search-navbar\" className=\"block w-full p-2 pl-10 text-sm text-gray-900 border border-gray-300 rounded-lg bg-gray-50 focus500 focus500 dark700 dark600 dark400 dark dark500 dark500\" placeholder=\"Search...\" />\n          </div>\n          <button data-collapse-toggle=\"navbar-search\" type=\"button\" className=\"inline-flex items-center p-2 w-10 h-10 justify-center text-sm text-gray-500 rounded-lg md hover100 focus focus2 focus200 dark400 dark700 dark600\" aria-controls=\"navbar-search\" aria-expanded=\"false\">\n            <span className=\"sr-only\">Open main menu</span>\n            <svg className=\"w-5 h-5\" aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 17 14\">\n                <path stroke=\"currentColor\" strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"M1 1h15M1 7h15M1 13h15\"/>\n            </svg>\n        </button>\n        </div>\n        <div className=\"items-center justify-between hidden w-full md md md1\" id=\"navbar-search\">\n          <div className=\"relative mt-3 md\">\n            <div className=\"absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none\">\n              <svg className=\"w-4 h-4 text-gray-500 dark400\" aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\"\n                fill=\"none\" viewBox=\"0 0 20 20\">\n                <path stroke=\"currentColor\" strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\"\n                  d=\"m19 19-4-4m0-7A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z\" />\n              </svg>\n            </div>\n            <input type=\"text\" id=\"search-navbar\" className=\"block w-full p-2 pl-10 text-sm text-gray-900 border border-gray-300 rounded-lg bg-gray-50 focus500 focus500 dark700 dark600 dark400 dark dark500 dark500\" placeholder=\"Search...\" />\n          </div>\n          <ul\n            className=\"flex flex-col p-4 md0 mt-4 font-medium border border-gray-100 rounded-lg bg-gray-50 md md8 md0 md0 md dark800 md900 dark700\">\n            <li>\n              <a href=\"#\"\n                className=\"block py-2 pl-3 pr-4 text-white bg-blue-700 rounded md md700 md0 md500\"\n                aria-current=\"page\">Home</a>\n            </li>\n            <li>\n              <a href=\"#\"\n                className=\"block py-2 pl-3 pr-4 text-gray-900 rounded hover100 md md700 md0 md500 dark dark700 dark md dark700\">About</a>\n            </li>\n            <li>\n              <a href=\"#\"\n                className=\"block py-2 pl-3 pr-4 text-gray-900 rounded hover100 md md700 md0 dark md500 dark700 dark md dark700\">Services</a>\n            </li>\n          </ul>\n        </div>\n      </div>\n    </nav>\n    </div>\n  );\n}\n",
