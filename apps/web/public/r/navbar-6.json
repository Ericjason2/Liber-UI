g>\\n                            <svg x-show=\\\"isOpen\\\" class=\\\"w-6 h-6 text-blue-200 group-hover:text-white\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\">\\n                                <path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" stroke-width=\\\"2\\\" d=\\\"M6 18L18 6M6 6l12 12\\\"/>\\n                            </svg>\\n                        </div>\\n                    </button>\\n                </div>\\n            </div>\\n\\n            <!-- Mobile Menu Dropdown -->\\n            <div x-show=\\\"isOpen\\\" x-transition:enter=\\\"transition ease-out duration-200\\\" x-transition:enter-start=\\\"opacity-0 -translate-y-2\\\" x-transition:enter-end=\\\"opacity-100 translate-y-0\\\" x-transition:leave=\\\"transition ease-in duration-150\\\" x-transition:leave-start=\\\"opacity-100 translate-y-0\\\" x-transition:leave-end=\\\"opacity-0 -translate-y-2\\\" class=\\\"relative mt-4 md:hidden\\\">\\n                <div class=\\\"px-2 pt-2 pb-3 space-y-1 bg-blue-900/50 backdrop-blur-sm rounded-lg border border-blue-500/10\\\">\\n                    <a href=\\\"#\\\" class=\\\"block px-3 py-2 rounded-md text-base font-medium text-blue-100 hover:text-white hover:bg-blue-800/50 transition-all duration-200\\\">Home</a>\\n                    <a href=\\\"#\\\" class=\\\"block px-3 py-2 rounded-md text-base font-medium text-blue-100 hover:text-white hover:bg-blue-800/50 transition-all duration-200\\\">Features</a>\\n                    <a href=\\\"#\\\" class=\\\"block px-3 py-2 rounded-md text-base font-medium text-blue-100 hover:text-white hover:bg-blue-800/50 transition-all duration-200\\\">About</a>\\n                    <a href=\\\"#\\\" class=\\\"block px-3 py-2 rounded-md text-base font-medium text-blue-100 hover:text-white hover:bg-blue-800/50 transition-all duration-200\\\">Contact</a>\\n                    <!-- Mobile CTA Button -->\\n                    <div class=\\\"px-3 py-2\\\">\\n                  