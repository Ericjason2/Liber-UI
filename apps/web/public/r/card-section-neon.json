n                    <div className=\"inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs ring-1 ring-white/20 mb-3\">\n                      <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"h-3 w-3 text-lime-300\">\n                        <path d=\"M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z\" className=\"\">\n                        </path>\n                        <polyline points=\"7.5 4.21 12 6.81 16.5 4.21\" className=\"\"></polyline>\n                        <polyline points=\"7.5 19.79 7.5 14.6 3 12\" className=\"\"></polyline>\n                        <polyline points=\"21 12 16.5 14.6 16.5 19.79\" className=\"\"></polyline>\n                        <polyline points=\"3.27 6.96 12 12.01 20.73 6.96\" className=\"\"></polyline>\n                        <line x1=\"12\" x2=\"12\" y1=\"22.08\" y2=\"12\" className=\"\"></line>\n                      </svg>\n                      <span className=\"text-white\">Design Lead</span>\n                    </div>\n                    <p className=\"text-xl font-semibold tracking-tight text-white\">\n                      Maya Patel\n                    </p>\n                  </div>\n                </div>\n    \n                <div className=\"carousel-card absolute w-80 h-[460px] rounded-2xl overflow-hidden ring-1 ring-white/10 transition-all duration-500\" data-index=\"5\" style=\"transform: translateX(540px) scale(0.75) rotateY(-45deg); opacity: 0; filter: brightness(0.5); z-index: 1;\">\n                  <img src=\"https://images.unsplash.com/photo-1611004061856-ccc3cbe944b2?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w0NzEyNjZ8MHwxfHNlYXJjaHwxfHxjYXNxdWV8ZW58MHwwfHx8MTc3MDM2NDAzN3ww&ixlib=rb-4.1.0&q=80&w=1080\" alt=\"Team member\" className=\"h-full w-ful