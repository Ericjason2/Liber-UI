    "rawHtml": "<div class=\"container mx-auto p-4\">\n  <!-- Page Title -->\n  <h1 class=\"text-3xl font-bold text-[black] mb-6\">Create Event</h1>\n\n  <form class=\"grid grid-cols-1 gap-6\">\n    <!-- Title -->\n    <div class=\"p-2\">\n      <input type=\"text\" id=\"title\" name=\"title\" placeholder=\"Event Title\" class=\"block w-full rounded-md border-gray-300 shadow-sm focus:border-[#8c0327] focus:ring-[#8c0327] focus:ring-opacity-50 p-2\" style=\"background-color: #f6f6f6;\">\n    </div>\n\n    <!-- Category -->\n    <div class=\"p-2\">\n      <select id=\"category\" name=\"category\" class=\"block w-full rounded-md border-gray-300 shadow-sm focus:border-[#8c0327] focus:ring-[#8c0327] focus:ring-opacity-50 p-2\" style=\"background-color: #f6f6f6;\">\n        <option value=\"\">Select a category</option>\n        <option>Music</option>\n        <option>Sports</option>\n        <option>Arts</option>\n        <option>Technology</option>\n      </select>\n    </div>\n\n    <!-- Description and Image Upload -->\n    <div class=\"p-2 grid grid-cols-1 md:grid-cols-2 gap-6\">\n      <!-- Description -->\n      <div>\n        <textarea id=\"description\" name=\"description\" rows=\"3\" placeholder=\"Event Description\" class=\"block w-full h-48 rounded-md border-gray-300 shadow-sm focus:border-[#8c0327] focus:ring-[#8c0327] focus:ring-opacity-50 p-2\" style=\"background-color: #f6f6f6;\"></textarea>\n      </div>\n\n      <!-- Image Upload -->\n      <div>\n        <label for=\"image-upload\" class=\"block w-full h-48 border-2 border-dashed border-gray-300 rounded-md cursor-pointer flex flex-col items-center justify-center bg-[#f6f6f6] hover:bg-gray-50\">\n          <div class=\"text-center\">\n            <div class=\"mb-2\">\n              <button type=\"button\" class=\"bg-[#8c0327] hover:bg-[#6b0220] text-white rounded-full py-2 px-4\">Select from the computer</button>\n            </div>\n            <p class=\"text-gray-500\">or drag photo here</p>\n            <p class=\"text-gray-500 text-sm mt-1\">PNG, JPG, SVG</p>\n          </div>\n        </label>\n        <input id=\"image-upload\" name=\"image\" type=\"file\" accept=\"image/*\" class=\"sr-only\">\n      </div>\n    </div>\n\n    <!-- Location -->\n    <div class=\"p-2\">\n      <input type=\"text\" id=\"location\" name=\"location\" placeholder=\"Location\" class=\"block w-full rounded-md border-gray-300 shadow-sm focus:border-[#8c0327] focus:ring-[#8c0327] focus:ring-opacity-50 p-2\" style=\"background-color: #f6f6f6;\">\n    </div>\n\n    <!-- Organizer Name and Email -->\n    <div class=\"p-2 grid grid-cols-1 md:grid-cols-2 gap-6\">\n      <!-- Organizer Name -->\n      <div>\n        <input type=\"text\" id=\"organizer-name\" name=\"organizer-name\" placeholder=\"Organizer Name\" class=\"block w-full rounded-md border-gray-300 shadow-sm focus:border-[#8c0327] focus:ring-[#8c0327] focus:ring-opacity-50 p-2\" style=\"background-color: #f6f6f6;\">\n      </div>\n\n      <!-- Organizer Email -->\n      <div>\n        <input type=\"email\" id=\"organizer-email\" name=\"organizer-email\" placeholder=\"Organizer Email\" class=\"block w-full rounded-md border-gray-300 shadow-sm focus:border-[#8c0327] focus:ring-[#8c0327] focus:ring-opacity-50 p-2\" style=\"background-color: #f6f6f6;\">\n      </div>\n    </div>\n\n    <!-- Organizer Address -->\n    <div class=\"p-2\">\n      <input type=\"text\" id=\"organizer-address\" name=\"organizer-address\" placeholder=\"Organizer Address\" class=\"block w-full rounded-md border-gray-300 shadow-sm focus:border-[#8c0327] focus:ring-[#8c0327] focus:ring-opacity-50 p-2\" style=\"background-color: #f6f6f6;\">\n    </div>\n\n    <!-- Start Date and End Date -->\n    <div class=\"p-2 grid grid-cols-1 md:grid-cols-2 gap-6\">\n      <!-- Start Date -->\n      <div class=\"flex items-center bg-[#f6f6f6] rounded-md p-2\">\n        <span class=\"flex-shrink-0 flex items-center mr-3 text-gray-500\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-5 h-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 3v2M19 3v2M5 10h14M4 21h16a1 1 0 001-1V8a1 1 0 00-1-1H4a1 1 0 00-1 1v12a1 1 0 001 1z\"></path>\n          </svg>\n          <span class=\"ml-2\">Start Date</span>\n        </span>\n        <input type=\"datetime-local\" id=\"start-date\" name=\"start-date\" class=\"block w-full rounded-md border-gray-300 shadow-sm focus:border-[#8c0327] focus:ring-[#8c0327] focus:ring-opacity-50 p-2\" style=\"background-color: #f6f6f6;\">\n      </div>\n\n      <!-- End Date -->\n      <div class=\"flex items-center bg-[#f6f6f6] rounded-md p-2\">\n        <span class=\"flex-shrink-0 flex items-center mr-3 text-gray-500\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-5 h-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 3v2M19 3v2M5 10h14M4 21h16a1 1 0 001-1V8a1 1 0 00-1-1H4a1 1 0 00-1 1v12a1 1 0 001 1z\"></path>\n          </svg>\n          <span class=\"ml-2\">End Date</span>\n        </span>\n        <input type=\"datetime-local\" id=\"end-date\" name=\"end-date\" class=\"block w-full rounded-md border-gray-300 shadow-sm focus:border-[#8c0327] focus:ring-[#8c0327] focus:ring-opacity-50 p-2\" style=\"background-color: #f6f6f6;\">\n      </div>\n    </div>\n\n    <!-- Status and Tags -->\n    <div class=\"p-2 grid grid-cols-1 md:grid-cols-2 gap-6\">\n      <!-- Status -->\n      <div class=\"flex items-center bg-[#f6f6f6] rounded-md\">\n        <select id=\"status\" name=\"status\" class=\"block w-full h-12 rounded-md border-gray-300 shadow-sm focus:border-[#8c0327] focus:ring-[#8c0327] focus:ring-opacity-50\" style=\"background-color: #f6f6f6; padding: 0;\">\n          <option value=\"\">Select Status</option>\n          <option value=\"active\">Active</option>\n          <option value=\"inactive\">Inactive</option>\n        </select>\n      </div>\n\n      <!-- Tags -->\n      <div>\n        <input type=\"text\" id=\"tags\" name=\"tags\" placeholder=\"Tags (comma-separated)\" class=\"block w-full rounded-md border-gray-300 shadow-sm focus:border-[#8c0327] focus:ring-[#8c0327] focus:ring-opacity-50 h-12\" style=\"background-color: #f6f6f6;\">\n      </div>\n    </div>\n\n    <!-- Registration Button -->\n    <div class=\"col-span-full mt-6 p-2\">\n      <button type=\"submit\" class=\"block w-full bg-[#8c0327] hover:bg-[#6b0220] text-white font-bold py-3 px-4 rounded-full\">\n        Register for Event\n      </button>\n    </div>\n  </form>\n</div>"
