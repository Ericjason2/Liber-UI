      "content": "/**\n * Component: create event modified\n * Author: @seth-dridi (https://tailwindflex.com/@seth-dridi)\n * Source: https://tailwindflex.com/@seth-dridi/create-event\n * Attribution: Créé par @seth-dridi sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function CreateEvent() {\n  return (\n    <div>\n    <div className=\"container mx-auto p-4\">\n      \n      <h1 className=\"text-3xl font-bold text-[black] mb-6\">Create Event</h1>\n    \n      <form className=\"grid grid-cols-1 gap-6\">\n        \n        <div className=\"p-2\">\n          <input type=\"text\" id=\"title\" name=\"title\" placeholder=\"Event Title\" className=\"block w-full rounded-md border-gray-300 shadow-sm focus[#8c0327] focus[#8c0327] focus50 p-2\" style=\"background-color: #f6f6f6;\" />\n        </div>\n    \n        \n        <div className=\"p-2\">\n          <select id=\"category\" name=\"category\" className=\"block w-full rounded-md border-gray-300 shadow-sm focus[#8c0327] focus[#8c0327] focus50 p-2\" style=\"background-color: #f6f6f6;\">\n            <option value=\"\">Select a category</option>\n            <option>Music</option>\n            <option>Sports</option>\n            <option>Arts</option>\n            <option>Technology</option>\n          </select>\n        </div>\n    \n        \n        <div className=\"p-2 grid grid-cols-1 md2 gap-6\">\n          \n          <div>\n            <textarea id=\"description\" name=\"description\" rows=\"3\" placeholder=\"Event Description\" className=\"block w-full h-48 rounded-md border-gray-300 shadow-sm focus[#8c0327] focus[#8c0327] focus50 p-2\" style=\"background-color: #f6f6f6;\"></textarea>\n          </div>\n    \n          \n          <div>\n            <label htmlFor=\"image-upload\" className=\"block w-full h-48 border-2 border-dashed border-gray-300 rounded-md cursor-pointer flex flex-col items-center justify-center bg-[#f6f6f6] hover50\">\n              <div className=\"text-center\">\n                <div className=\"mb-2\">\n                  <button type=\"button\" className=\"bg-[#8c0327] hover[#6b0220] text-white rounded-full py-2 px-4\">Select from the computer</button>\n                </div>\n                <p className=\"text-gray-500\">or drag photo here</p>\n                <p className=\"text-gray-500 text-sm mt-1\">PNG, JPG, SVG</p>\n              </div>\n            </label>\n            <input id=\"image-upload\" name=\"image\" type=\"file\" accept=\"image/*\" className=\"sr-only\" />\n          </div>\n        </div>\n    \n        \n        <div className=\"p-2\">\n          <input type=\"text\" id=\"location\" name=\"location\" placeholder=\"Location\" className=\"block w-full rounded-md border-gray-300 shadow-sm focus[#8c0327] focus[#8c0327] focus50 p-2\" style=\"background-color: #f6f6f6;\" />\n        </div>\n    \n        \n        <div className=\"p-2 grid grid-cols-1 md2 gap-6\">\n          \n          <div>\n            <input type=\"text\" id=\"organizer-name\" name=\"organizer-name\" placeholder=\"Organizer Name\" className=\"block w-full rounded-md border-gray-300 shadow-sm focus[#8c0327] focus[#8c0327] focus50 p-2\" style=\"background-color: #f6f6f6;\" />\n          </div>\n    \n          \n          <div>\n            <input type=\"email\" id=\"organizer-email\" name=\"organizer-email\" placeholder=\"Organizer Email\" className=\"block w-full rounded-md border-gray-300 shadow-sm focus[#8c0327] focus[#8c0327] focus50 p-2\" style=\"background-color: #f6f6f6;\" />\n          </div>\n        </div>\n    \n        \n        <div className=\"p-2\">\n          <input type=\"text\" id=\"organizer-address\" name=\"organizer-address\" placeholder=\"Organizer Address\" className=\"block w-full rounded-md border-gray-300 shadow-sm focus[#8c0327] focus[#8c0327] focus50 p-2\" style=\"background-color: #f6f6f6;\" />\n        </div>\n    \n        \n        <div className=\"p-2 grid grid-cols-1 md2 gap-6\">\n          \n          <div className=\"flex items-center bg-[#f6f6f6] rounded-md p-2\">\n            <span className=\"flex-shrink-0 flex items-center mr-3 text-gray-500\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"w-5 h-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"M5 3v2M19 3v2M5 10h14M4 21h16a1 1 0 001-1V8a1 1 0 00-1-1H4a1 1 0 00-1 1v12a1 1 0 001 1z\"></path>\n              </svg>\n              <span className=\"ml-2\">Start Date</span>\n            </span>\n            <input type=\"datetime-local\" id=\"start-date\" name=\"start-date\" className=\"block w-full rounded-md border-gray-300 shadow-sm focus[#8c0327] focus[#8c0327] focus50 p-2\" style=\"background-color: #f6f6f6;\" />\n          </div>\n    \n          \n          <div className=\"flex items-center bg-[#f6f6f6] rounded-md p-2\">\n            <span className=\"flex-shrink-0 flex items-center mr-3 text-gray-500\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"w-5 h-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"M5 3v2M19 3v2M5 10h14M4 21h16a1 1 0 001-1V8a1 1 0 00-1-1H4a1 1 0 00-1 1v12a1 1 0 001 1z\"></path>\n              </svg>\n              <span className=\"ml-2\">End Date</span>\n            </span>\n            <input type=\"datetime-local\" id=\"end-date\" name=\"end-date\" className=\"block w-full rounded-md border-gray-300 shadow-sm focus[#8c0327] focus[#8c0327] focus50 p-2\" style=\"background-color: #f6f6f6;\" />\n          </div>\n        </div>\n    \n        \n        <div className=\"p-2 grid grid-cols-1 md2 gap-6\">\n          \n          <div className=\"flex items-center bg-[#f6f6f6] rounded-md\">\n            <select id=\"status\" name=\"status\" className=\"block w-full h-12 rounded-md border-gray-300 shadow-sm focus[#8c0327] focus[#8c0327] focus50\" style=\"background-color: #f6f6f6; padding: 0;\">\n              <option value=\"\">Select Status</option>\n              <option value=\"active\">Active</option>\n              <option value=\"inactive\">Inactive</option>\n            </select>\n          </div>\n    \n          \n          <div>\n            <input type=\"text\" id=\"tags\" name=\"tags\" placeholder=\"Tags (comma-separated)\" className=\"block w-full rounded-md border-gray-300 shadow-sm focus[#8c0327] focus[#8c0327] focus50 h-12\" style=\"background-color: #f6f6f6;\" />\n          </div>\n        </div>\n    \n        \n        <div className=\"col-span-full mt-6 p-2\">\n          <button type=\"submit\" className=\"block w-full bg-[#8c0327] hover[#6b0220] text-white font-bold py-3 px-4 rounded-full\">\n            Register for Event\n          </button>\n        </div>\n      </form>\n    </div>\n    </div>\n  );\n}\n",
