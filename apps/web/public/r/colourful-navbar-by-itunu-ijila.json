ref=\\\"#\\\" class=\\\"text-white hover:text-purple-300 block px-3 py-3 rounded-md text-base font-medium transition-all duration-300 hover:bg-white hover:bg-opacity-20\\\">\\n                    About\\n                </a>\\n                <a href=\\\"#\\\" class=\\\"text-white hover:text-blue-300 block px-3 py-3 rounded-md text-base font-medium transition-all duration-300 hover:bg-white hover:bg-opacity-20\\\">\\n                    Services\\n                </a>\\n                <a href=\\\"#\\\" class=\\\"text-white hover:text-green-300 block px-3 py-3 rounded-md text-base font-medium transition-all duration-300 hover:bg-white hover:bg-opacity-20\\\">\\n                    Contact\\n                </a>\\n            </div>\\n        </div>\\n    </nav>\\n\\n    <div class=\\\"max-w-7xl mx-auto px-4 py-8\\\">\\n        <h2 class=\\\"text-3xl font-bold text-gray-800 mb-4\\\">Welcome!</h2>\\n        <p class=\\\"text-gray-600\\\">This is a colorful, responsive navbar built with Tailwind CSS.</p>\\n    </div>\\n\\n    \\n</body>\\n</html>\" }} />\n  );\n}\n",
