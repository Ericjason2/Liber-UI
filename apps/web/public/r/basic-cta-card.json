      "content": "/**\n * Component: Basic CTA card\n * Author: @kishan-pc (https://tailwindflex.com/@kishan-pc)\n * Source: https://tailwindflex.com/@kishan-pc/basic-cta-card\n * Attribution: Créé par @kishan-pc sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function BasicCtaCard() {\n  return (\n    <div>\n    <div className=\"flex justify-center items-center h-screen dark800\">\n      <section className=\"w-full max-w-5xl mx-auto rounded-xl py-14 lg20 px-5 lg0\">\n        <div\n          className=\"rounded-2xl p-5 py-14 bg-[#DEF6F5] dark700 mx-auto flex flex-col gap-y-5 justify-center items-center\">\n          <h3\n            className=\"text-3xl md4xl lg5xl max-w-xl lg3xl mx-auto font-bold text-black dark text-center\">\n            Discover endless learning opportunities.</h3>\n          <p className=\"text-base md lg text-center text-gray-800 dark300\">Unlock your potential with\n            our wide range of courses and resources.</p>\n          <button className=\"bg-[#1EBFC1] dark[#0E6B6D] w-1/2 md1/3 hover border border-transparent hover transition duration-200 lg1/3 text-white font-semibold text-sm lg rounded px-4 py-2\">Get Started</button>\n        </div>\n      </section>\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
