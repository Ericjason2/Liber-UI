    "rawHtml": "<div class=\"flex justify-center items-center h-screen dark:bg-gray-800\">\n  <section class=\"w-full max-w-5xl mx-auto rounded-xl py-14 lg:py-20 px-5 lg:px-0\">\n    <div\n      class=\"rounded-2xl p-5 py-14 bg-[#DEF6F5] dark:bg-gray-700 mx-auto flex flex-col gap-y-5 justify-center items-center\">\n      <h3\n        class=\"text-3xl md:text-4xl lg:text-5xl max-w-xl lg:max-w-3xl mx-auto font-bold text-black dark:text-white text-center\">\n        Discover endless learning opportunities.</h3>\n      <p class=\"text-base md:text-lg lg:text-xl text-center text-gray-800 dark:text-gray-300\">Unlock your potential with\n        our wide range of courses and resources.</p>\n      <button class=\"bg-[#1EBFC1] dark:bg-[#0E6B6D] w-1/2 md:w-1/3 hover:shadow-lg border border-transparent hover:drop-shadow transition duration-200 lg:w-1/3 text-white font-semibold text-sm lg:text-base rounded px-4 py-2\">Get Started</button>\n    </div>\n  </section>\n</div>"
