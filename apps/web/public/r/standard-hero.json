      "content": "/**\n * Component: Standard Hero\n * Author: @anonymous (https://tailwindflex.com/@anonymous)\n * Source: https://tailwindflex.com/@anonymous/standard-hero\n * Attribution: Créé par @anonymous sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function StandardHero() {\n  return (\n    <div>\n    <div className=\"bg-gray-900 py-20\">\r\n        <div className=\"container mx-auto px-6 md12\">\r\n            <div className=\"flex flex-col md items-center\">\r\n                <div className=\"md1/2 lg2/3\">\r\n                    <h1 className=\"text-4xl md6xl lg7xl text-white font-bold mb-6\">\r\n                        Welcome to our <br className=\"hidden md\" />\r\n                        <span className=\"text-indigo-500\">Awesome</span> Website\r\n                    </h1>\r\n                    <p className=\"text-lg md lg2xl text-gray-400 mb-8\">\r\n                        We create beautiful and functional websites for businesses of all sizes.\r\n                    </p>\r\n                    <div className=\"flex gap-2\">\r\n                        <a href=\"#\" className=\"bg-indigo-500 hover600 text-white font-bold py-3 px-6 rounded-md\">Get\r\n                            Started\r\n                        </a>\r\n                        <a href=\"#\" className=\"bg-gray-700 hover600 text-white font-bold py-3 px-6 rounded-md\">Learn\r\n                            More\r\n                        </a>\r\n                    </div>\r\n                </div>\r\n                <div className=\"md1/2 lg1/3 mt-8 md0\">\r\n                    <img src=\"https://via.placeholder.com/500x500\" alt=\"Hero Image\" className=\"rounded-lg shadow-lg\" />\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
