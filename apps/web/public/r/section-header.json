<!-- BENTO GRID -->\\n    <div class=\\\"max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-6\\\">\\n\\n      <!-- CARD 1: Own Your Data (Shield) -->\\n      <div class=\\\"group relative bg-white border border-slate-100 rounded-[2rem] p-8 md:p-10 shadow-[0_4px_20px_-10px_rgba(0,0,0,0.05)] hover:shadow-[0_20px_40px_-15px_rgba(255,45,85,0.15)] transition-all duration-300 overflow-hidden min-h-[400px] flex flex-col justify-end\\\">\\n        \\n        <!-- Illustration Area -->\\n        <div class=\\\"absolute inset-x-0 top-0 h-2/3 flex items-center justify-center bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-rose-50/80 via-white to-white\\\">\\n            <!-- Icon floating top left -->\\n            <div class=\\\"absolute top-8 left-8 w-10 h-10 rounded-full bg-white shadow-sm border border-rose-100 flex items-center justify-center text-rose-500\\\">\\n              <svg class=\\\"w-5 h-5\\\" fill=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\"><path d=\\\"M12 2L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-3z\\\"/></svg>\\n            </div>\\n\\n            <!-- Abstract Graphic: Shield Layers -->\\n            <div class=\\\"relative w-48 h-56 perspective-1000\\\">\\n              <div class=\\\"absolute inset-0 bg-gradient-to-br from-rose-500 to-rose-600 rounded-2xl opacity-10 transform translate-x-4 translate-y-4 scale-90\\\"></div>\\n              <div class=\\\"absolute inset-0 bg-gradient-to-br from-rose-500 to-rose-600 rounded-2xl opacity-20 transform translate-x-2 translate-y-2 scale-95\\\"></div>\\n              <div class=\\\"relative w-full h-full bg-gradient-to-b from-white to-rose-50 border border-rose-100 rounded-2xl shadow-xl flex items-center justify-center overflow-hidden\\\">\\n                 <div class=\\\"absolute inset-0 bg-grid-slate-500/[0.05] [mask-image:linear-gradient(0deg,white,transparent)]\\\"></div>\\n                 <svg class=\\\"w-20 h-20 text-rose-200\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\"><path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" stroke-width=\\\"1\\\" d=\\\"M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z\\\"></path></svg>\\n                 <!-- Red Dot -->\\n                 <div class=\\\"absolute top-4 right-4 w-2 h-2 rounded-full bg-rose-500\\\"></div>\\n              </div>\\n            </div>\\n        </div>\\n\\n        <!-- Content -->\\n        <div class=\\\"relative z-10 mt-48\\\">\\n          <h3 class=\\\"text-xl font-bold text-slate-900 mb-2\\\">Own Your Data, End-to-End</h3>\\n          <p class=\\\"text-slate-500 leading-relaxed text-sm\\\">\\n            CipherMesh gives you total control with native encryption, permission layers, and zero-knowledge privacy baked into every interaction.\\n          </p>\\n        </div>\\n      </div>\\n\\n      <!-- CARD 2: Modular by Default (Blocks) -->\\n      <div class=\\\"group relative bg-white border border-slate-100 rounded-[2rem] p-8 md:p-10 shadow-[0_4px_20px_-10px_rgba(0,0,0,0.05)] hover:shadow-[0_20px_40px_-15px_rgba(255,45,85,0.15)] transition-all duration-300 overflow-hidden min-h-[400px] flex flex-col justify-end\\\">\\n        \\n         <!-- Illustration Area -->\\n         <div class=\\\"absolute inset-x-0 top-0 h-2/3 flex items-center justify-center overflow-hidden\\\">\\n             <!-- Icon floating top left -->\\n            <div class=\\\"absolute top-8 left-8 w-10 h-10 rounded-full bg-white shadow-sm border border-rose-100 flex items-center justify-center text-rose-500 z-20\\\">\\n              <svg class=\\\"w-5 h-5\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\"><path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" stroke-width=\\\"2\\\" d=\\\"M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z\\\"></path></svg>\\n            </div>\\n\\n            <!-- Abstract Graphic: Isometric Layers -->\\n            <div class=\\\"relative w-full h-full\\\">\\n              <!-- Background mesh/grid effect -->\\n              <div class=\\\"absolute top-0 right-0 w-[150%] h-[150%] bg-[radial-gradient(#ff2d55_1px,transparent_1px)] [background-size:20px_20px] opacity-[0.03]\\\"></div>\\n              \\n              <!-- Isometric Block Representation -->\\n              <div class=\\\"absolute top-1/2 right-0 transform -translate-y-1/2 translate-x-10\\\">\\n                 <!-- Layer 3 (Bottom) -->\\n                 <div class=\\\"w-64 h-40 bg-gradient-to-l from-rose-100 to-transparent transform -skew-y-12 translate-y-12 translate-x-12 rounded-lg opacity-50 blur-sm\\\"></div>\\n                 <!-- Layer 2 (Middle) -->\\n                 <div class=\\\"w-64 h-40 bg-gradient-to-l from-rose-300 to-rose-100 transform -skew-y-12 translate-y-6 translate-x-6 rounded-lg opacity-80 shadow-lg\\\"></div>\\n                 <!-- Layer 1 (Top) -->\\n                 <div class=\\\"w-64 h-40 bg-gradient-to-br from-[#ff2d55] to-rose-600 transform -skew-y-12 rounded-lg shadow-2xl flex items-center justify-center relative overflow-hidden group-hover:-translate-y-2 transition-transform duration-500\\\">\\n                    <!-- Grid/Modules on top layer -->\\n                    <div class=\\\"grid grid-cols-2 gap-2 p-6 w-full h-full opacity-30\\\">\\n                        <div class=\\\"bg-white rounded\\\"></div><div class=\\\"bg-white rounded\\\"></div>\\n                        <div class=\\\"bg-white rounded\\\"></div><div class=\\\"bg-white rounded\\\"></div>\\n                    </div>\\n                 </div>\\n              </div>\\n            </div>\\n         </div>\\n\\n        <!-- Content -->\\n        <div class=\\\"relative z-10 mt-48 max-w-sm\\\">\\n          <h3 class=\\\"text-xl font-bold text-slate-900 mb-2\\\">Modular by Default</h3>\\n          <p class=\\\"text-slate-500 leading-relaxed text-sm\\\">\\n            Plug into just the parts you need — run a node, store data, or launch apps.\\n          </p>\\n        </div>\\n      </div>\\n\\n      <!-- CARD 3: Cross-Chain Ready (Speedometer/Gauge) -->\\n      <div class=\\\"group relative bg-white border border-slate-100 rounded-[2rem] p-8 md:p-10 shadow-[0_4px_20px_-10px_rgba(0,0,0,0.05)] hover:shadow-[0_20px_40px_-15px_rgba(255,45,85,0.15)] transition-all duration-300 overflow-hidden min-h-[360px] flex flex-col justify-end\\\">\\n        \\n        <!-- Illustration Area -->\\n        <div class=\\\"absolute inset-x-0 top-0 h-3/4 flex items-center justify-center\\\">\\n             <!-- Icon floating top left -->\\n            <div class=\\\"absolute top-8 left-8 w-10 h-10 rounded-full bg-white shadow-sm border border-rose-100 flex items-center justify-center text-rose-500 z-20\\\">\\n              <svg class=\\\"w-5 h-5\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\"><path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" stroke-width=\\\"2\\\" d=\\\"M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z\\\"></path></svg>\\n            </div>\\n\\n            <!-- Gauge Graphic -->\\n            <div class=\\\"relative w-full max-w-[300px] h-[150px] overflow-hidden mt-10\\\">\\n               <!-- Semi circle bg -->\\n               <div class=\\\"absolute bottom-0 left-0 w-full h-[300px] rounded-full border-[20px] border-rose-50 border-t-rose-100\\\"></div>\\n               <!-- Active arc -->\\n               <div class=\\\"absolute bottom-0 left-0 w-full h-[300px] rounded-full border-[20px] border-transparent border-t-[#ff2d55] opacity-20\\\"></div>\\n               <!-- Gradient Fill -->\\n               <div class=\\\"absolute bottom-0 left-1/2 -translate-x-1/2 w-[90%] h-[90%] bg-gradient-to-t from-white via-rose-50 to-[#ff2d55] rounded-t-full opacity-10\\\"></div>\\n               \\n               <!-- Ticks -->\\n               <div class=\\\"absolute bottom-0 left-0 w-full h-full flex justify-center items-end pb-4\\\">\\n                  <div class=\\\"w-full h-full absolute flex justify-center items-end\\\">\\n                      <div class=\\\"w-[280px] h-[140px] border-t border-dashed border-rose-300 rounded-t-full opacity-50\\\"></div>\\n                  </div>\\n                  <!-- The Link Icon centered -->\\n                  <div class=\\\"bg-white rounded-full p-3 shadow-lg border border-rose-100 mb-2 relative z-10\\\">\\n                    <svg class=\\\"w-8 h-8 text-[#ff2d55]\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\"><path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" stroke-width=\\\"2\\\" d=\\\"M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1\\\"></path></svg>\\n                  </div>\\n               </div>\\n               \\n               <!-- Red glow/aura -->\\n               <div class=\\\"absolute bottom-0 left-1/2 -translate-x-1/2 w-3/4 h-3/4 bg-[#ff2d55] blur-[60px] opacity-20 rounded-full\\\"></div>\\n            </div>\\n        </div>\\n\\n        <!-- Content -->\\n        <div class=\\\"relative z-10 mt-12\\\">\\n          <h3 class=\\\"text-xl font-bold text-slate-900 mb-2\\\">Cross-Chain Ready</h3>\\n          <p class=\\\"text-slate-500 leading-relaxed text-sm\\\">\\n            Bridge assets, logic, and identity across Ethereum, Cosmos, and beyond — fast, gas-optimized.\\n          </p>\\n        </div>\\n      </div>\\n\\n      <!-- CARD 4: Uptime Infrastructure (Chart) -->\\n      <div class=\\\"group relative bg-white border border-slate-100 rounded-[2rem] p-8 md:p-10 shadow-[0_4px_20px_-10px_rgba(0,0,0,0.05)] hover:shadow-[0_20px_40px_-15px_rgba(255,45,85,0.15)] transition-all duration-300 overflow-hidden min-h-[360px] flex flex-col justify-end\\\">\\n        \\n        <!-- Illustration Area -->\\n        <div class=\\\"absolute inset-x-0 top-0 h-3/4\\\">\\n             <!-- Icon floating top left -->\\n            <div class=\\\"absolute top-8 left-8 w-10 h-10 rounded-full bg-white shadow-sm border border-rose-100 flex items-center justify-center text-rose-500 z-20\\\">\\n              <svg class=\\\"w-5 h-5\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\"><path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" stroke-width=\\\"2\\\" d=\\\"M13 7h8m0 0v8m0-8l-8 8-4-4-6 6\\\"></path></svg>\\n            </div>\\n\\n            <!-- Graph Graphic -->\\n            <div class=\\\"absolute inset-0 flex items-center justify-center pt-8\\\">\\n               <div class=\\\"w-full h-full relative\\\">\\n                  <!-- The Sine Wave Line -->\\n                  <svg class=\\\"absolute bottom-0 left-0 w-full h-[70%]\\\" viewBox=\\\"0 0 400 150\\\" preserveAspectRatio=\\\"none\\\">\\n                     <defs>\\n                        <linearGradient id=\\\"chartGradient\\\" x1=\\\"0\\\" y1=\\\"0\\\" x2=\\\"0\\\" y2=\\\"1\\\">\\n                           <stop offset=\\\"0%\\\" stop-color=\\\"#ff2d55\\\" stop-opacity=\\\"0.2\\\"/>\\n                           <stop offset=\\\"100%\\\" stop-color=\\\"#fff\\\" stop-opacity=\\\"0\\\"/>\\n                        </linearGradient>\\n                     </defs>\\n                     <path d=\\\"M0,100 C100,20 200,100 300,50 C350,25 400,0 400,0 V150 H0 Z\\\" fill=\\\"url(#chartGradient)\\\" />\\n                     <path d=\\\"M0,100 C100,20 200,100 300,50 C350,25 400,0 400,0\\\" fill=\\\"none\\\" stroke=\\\"#ff2d55\\\" stroke-width=\\\"3\\\" stroke-linecap=\\\"round\\\" vector-effect=\\\"non-scaling-stroke\\\" />\\n                  </svg>\\n                  \\n                  <!-- Data Point -->\\n                  <div class=\\\"absolute top-[28%] right-[25%] flex flex-col items-center\\\">\\n                     <div class=\\\"text-[#ff2d55] font-bold text-lg mb-1\\\">99.9%</div>\\n                     <div class=\\\"text-xs text-rose-300 uppercase tracking-wider mb-2\\\">Uptime Rate</div>\\n                     <div class=\\\"w-3 h-3 bg-[#ff2d55] rounded-full border-2 border-white shadow-md relative z-10\\\"></div>\\n                     <div class=\\\"w-[1px] h-32 border-l border-dashed border-rose-200 mt-0\\\"></div>\\n                  </div>\\n               </div>\\n            </div>\\n        </div>\\n\\n        <!-- Content -->\\n        <div class=\\\"relative z-10 mt-12\\\">\\n          <h3 class=\\\"text-xl font-bold text-slate-900 mb-2\\\">Always Uptime Infrastructure</h3>\\n          <p class=\\\"text-slate-500 leading-relaxed text-sm\\\">\\n            CipherMesh runs on a globally distributed mesh of validators and relayers, ensuring high availability and redundancy.\\n          </p>\\n        </div>\\n      </div>\\n\\n    </div>\\n  </div>\\n</div>\\n\\n\\n<style scoped>\\n/* Estilos adicionales si fueran necesarios */\\n.perspective-1000 {\\n  perspective: 1000px;\\n}\\n</style>\" }} />\n  );\n}\n",
