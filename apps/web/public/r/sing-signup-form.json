      "content": "import * as React from \"react\"\n\nfunction SingSignupForm({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"sing-signup-form\"\n      className={className}\n      {...props}\n    >\n      <div className=\"w-full max-w-md bg-white shadow-lg rounded-2xl p-6 md:p-8 transition-all duration-300\">\n              \n              <div className=\"flex justify-between mb-6 border-b border-gray-200\">\n                  <button id=\"signInTab\" className=\"w-1/2 text-center text-gray-600 pb-2 font-medium border-b-2 border-transparent hover:border-indigo-500 focus:outline-none transition\">Sign In</button>\n                  <button id=\"signUpTab\" className=\"w-1/2 text-center text-gray-600 pb-2 font-medium border-b-2 border-transparent hover:border-indigo-500 focus:outline-none transition\">Sign Up</button>\n              </div>\n      \n              \n              <form id=\"signInForm\" className=\"space-y-4\">\n                  <div>\n                      <label className=\"block text-gray-700 font-medium mb-1\">Email</label>\n                      <input type=\"email\" className=\"w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500\" placeholder=\"rajesh@email.com\" />\n                  </div>\n                  <div>\n                      <label className=\"block text-gray-700 font-medium mb-1\">Password</label>\n                      <input type=\"password\" className=\"w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500\" placeholder=\"••••••••\" />\n                  </div>\n                  <div className=\"flex justify-between text-sm text-gray-600\">\n                      <label className=\"flex items-center space-x-2\">\n                          <input type=\"checkbox\" className=\"h-4 w-4 text-indigo-600 border-gray-300 rounded\" />\n                          <span>Remember me</span>\n                      </label>\n                      <a href=\"#\" className=\"text-indigo-600 hover:underline\">Forgot password?</a>\n                  </div>\n                  <button className=\"w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-3 rounded-lg shadow-md hover:shadow-lg transition\">Sign In</button>\n              </form>\n      \n              \n              <form id=\"signUpForm\" className=\"space-y-4 hidden\">\n                  <div>\n                      <label className=\"block text-gray-700 font-medium mb-1\">Full Name</label>\n                      <input type=\"text\" className=\"w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500\" placeholder=\"Rajesh Maheshwari\" />\n                  </div>\n                  <div>\n                      <label className=\"block text-gray-700 font-medium mb-1\">Email</label>\n                      <input type=\"email\" className=\"w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500\" placeholder=\"rajesh@email.com\" />\n                  </div>\n                  <div>\n                      <label className=\"block text-gray-700 font-medium mb-1\">Password</label>\n                      <input type=\"password\" className=\"w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500\" placeholder=\"••••••••\" />\n                  </div>\n                  <div>\n                      <label className=\"block text-gray-700 font-medium mb-1\">Confirm Password</label>\n                      <input type=\"password\" className=\"w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500\" placeholder=\"••••••••\" />\n                  </div>\n                  <button className=\"w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-3 rounded-lg shadow-md hover:shadow-lg transition\">Sign Up</button>\n              </form>\n      \n              \n           <div className=\"mt-6\">\n                  <p className=\"text-center text-gray-500\">Or continue with</p>\n                  <div className=\"mt-4 flex space-x-3\">\n                      \n                      <button className=\"flex-1 bg-gray-100 hover:bg-gray-200 transition p-3 rounded-lg flex items-center justify-center\">\n                          <img src=\"https://upload.wikimedia.org/wikipedia/commons/0/05/Facebook_Logo_%282019%29.png\" className=\"h-5\" />\n                      </button>\n                      <button className=\"flex-1 bg-gray-100 hover:bg-gray-200 transition p-3 rounded-lg flex items-center justify-center\">\n                          <img src=\"https://upload.wikimedia.org/wikipedia/commons/9/91/Octicons-mark-github.svg\" className=\"h-5\" />\n                      </button>\n                  </div>\n              </div>\n      \n          </div>\n    </div>\n  )\n}\n\nexport { SingSignupForm }\n",
      "type": "registry:ui"
    }
  ],
  "meta": {
    "kind": "component",
