      "content": "import * as React from \"react\"\n\nfunction PremiumGamingUiCardFormAnimatedButtonTailwindCss({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"premium-gaming-ui-card-form-animated-button-tailwind-css\"\n      className={className}\n      {...props}\n    >\n      <style>{\"body { font-family: Inter, system-ui, sans-serif; }\\n\\n    /* Button animation – restrained, premium */\\n    .glow-btn {\\n      position: relative;\\n      overflow: hidden;\\n    }\\n\\n    .glow-btn::before {\\n      content: \\\"\\\";\\n      position: absolute;\\n      inset: 0;\\n      background: linear-gradient(\\n        120deg,\\n        transparent 30%,\\n        rgba(255,255,255,0.35),\\n        transparent 70%\\n      );\\n      transform: translateX(-100%);\\n      transition: transform 0.6s ease;\\n    }\\n\\n    .glow-btn:hover::before {\\n      transform: translateX(100%);\\n    }\"}</style>\n      <main className=\"min-h-screen flex items-center justify-center px-6 py-24\">\n      \n          <div className=\"max-w-6xl w-full grid md:grid-cols-2 gap-20 items-start\">\n      \n            \n            <section className=\"space-y-8\">\n              <div className=\"bg-[#12151b] border border-white/10 rounded-2xl p-10 space-y-6\">\n                <span className=\"text-xs uppercase tracking-widest text-white/50\">\n                  Competitive Gaming Platform\n                </span>\n      \n                <h1 className=\"text-4xl font-semibold leading-tight\">\n                  Play smarter.<br />\n                  Compete harder.\n                </h1>\n      \n                <p className=\"text-white/60 leading-relaxed\">\n                  A modern gaming platform built for competitive players.\n                  Track performance, join tournaments, and connect with elite teams —\n                  all in one place.\n                </p>\n      \n                <ul className=\"space-y-3 text-sm text-white/70\">\n                  <li>• Ranked matchmaking & tournaments</li>\n                  <li>• Team analytics & performance stats</li>\n                  <li>• Secure accounts & fair-play systems</li>\n                </ul>\n      \n                <button\n                  className=\"glow-btn mt-6 inline-flex items-center justify-center\n                         px-6 py-3 rounded-xl bg-white text-black\n                         text-sm font-medium transition hover:scale-[1.02]\">\n                  Explore the Arena\n                </button>\n              </div>\n            </section>\n      \n            \n            <section className=\"space-y-10\">\n              <div className=\"bg-[#12151b] border border-white/10 rounded-2xl p-10 space-y-8\">\n      \n                <div className=\"space-y-2\">\n                  <h2 className=\"text-2xl font-semibold\">Join the next match</h2>\n                  <p className=\"text-sm text-white/50\">\n                    Create your player profile to access competitive features.\n                  </p>\n                </div>\n      \n                <form className=\"space-y-6\">\n                  <div className=\"space-y-2\">\n                    <label className=\"text-xs text-white/50\">Gamer Tag</label>\n                    <input\n                      type=\"text\"\n                      placeholder=\"ShadowStrike\"\n                      className=\"w-full bg-[#0b0d10] border border-white/10\n                             rounded-lg px-4 py-3 text-sm\n                             outline-none focus:border-white/30\"\n                    />\n                  </div>\n      \n                  <div className=\"space-y-2\">\n                    <label className=\"text-xs text-white/50\">Email</label>\n                    <input\n                      type=\"email\"\n                      placeholder=\"player@email.com\"\n                      className=\"w-full bg-[#0b0d10] border border-white/10\n                             rounded-lg px-4 py-3 text-sm\n                             outline-none focus:border-white/30\"\n                    />\n                  </div>\n      \n                  <div className=\"space-y-2\">\n                    <label className=\"text-xs text-white/50\">Primary Game</label>\n                    <select\n                      className=\"w-full bg-[#0b0d10] border border-white/10\n                             rounded-lg px-4 py-3 text-sm\n                             outline-none focus:border-white/30\">\n                      <option>Valorant</option>\n                      <option>CS2</option>\n                      <option>Fortnite</option>\n                      <option>League of Legends</option>\n                    </select>\n                  </div>\n      \n                  <button\n                    type=\"submit\"\n                    className=\"glow-btn w-full px-6 py-3 rounded-xl\n                           bg-gradient-to-r from-indigo-500 to-purple-600\n                           text-white text-sm font-medium\n                           transition hover:scale-[1.02]\">\n                    Create Player Profile\n                  </button>\n                </form>\n      \n                <p className=\"text-xs text-white/40 text-center\">\n                  No spam. Competitive integrity guaranteed.\n                </p>\n              </div>\n            </section>\n      \n          </div>\n      \n        </main>\n    </div>\n  )\n}\n\nexport { PremiumGamingUiCardFormAnimatedButtonTailwindCss }\n",
