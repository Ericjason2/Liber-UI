      "content": "/**\n * Component: Pricing Plans\n * Author: @blvpeppa (https://tailwindflex.com/@blvpeppa)\n * Source: https://tailwindflex.com/@blvpeppa/pricing-plans\n * Attribution: Créé par @blvpeppa sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function PricingPlans() {\n  return (\n    <div>\n    <section className=\"py-16 bg-gray-50 px-6\">\n      <div className=\"max-w-7xl mx-auto text-center mb-12\">\n        <h2 className=\"text-3xl font-bold text-gray-900\">Pricing Plans</h2>\n        <p className=\"mt-2 text-gray-600 max-w-xl mx-auto\">Choose the plan that works best for you.</p>\n    \n        <div className=\"mt-6 flex justify-center items-center space-x-4\">\n          <span className=\"text-gray-700 font-medium\">Monthly</span>\n          <label htmlFor=\"toggle\" className=\"inline-flex relative items-center cursor-pointer\">\n            <input type=\"checkbox\" id=\"toggle\" className=\"sr-only peer\" />\n            <div className=\"w-11 h-6 bg-gray-300 rounded-full peer peer-checked600 transition\"></div>\n            <div className=\"absolute left-1 top-1 w-4 h-4 bg-white rounded-full peer-checked5 transition\"></div>\n          </label>\n          <span className=\"text-gray-700 font-medium\">Yearly</span>\n        </div>\n      </div>\n    \n      <div id=\"pricing-cards\" className=\"max-w-7xl mx-auto grid gap-8 sm2 lg3\">\n        \n        <div className=\"bg-white border border-gray-200 rounded-lg p-6 shadow-sm flex flex-col\">\n          <h3 className=\"text-xl font-semibold mb-4\">Basic</h3>\n          <p className=\"text-3xl font-bold mb-2\"><span className=\"price-monthly\">$10</span><span className=\"price-yearly hidden\">$100</span><span className=\"text-base font-normal\">/mo</span></p>\n          <ul className=\"mb-6 space-y-2 text-gray-600 flex-grow\">\n            <li>✔️ 10 Projects</li>\n            <li>✔️ 5 GB Storage</li>\n            <li>✔️ Basic Support</li>\n          </ul>\n          <button className=\"mt-auto bg-blue-600 text-white py-2 rounded hover700 transition\">Choose Plan</button>\n        </div>\n        \n        <div className=\"bg-white border border-gray-200 rounded-lg p-6 shadow-sm flex flex-col\">\n          <h3 className=\"text-xl font-semibold mb-4\">Pro</h3>\n          <p className=\"text-3xl font-bold mb-2\"><span className=\"price-monthly\">$25</span><span className=\"price-yearly hidden\">$250</span><span className=\"text-base font-normal\">/mo</span></p>\n          <ul className=\"mb-6 space-y-2 text-gray-600 flex-grow\">\n            <li>✔️ 50 Projects</li>\n            <li>✔️ 50 GB Storage</li>\n            <li>✔️ Priority Support</li>\n          </ul>\n          <button className=\"mt-auto bg-blue-600 text-white py-2 rounded hover700 transition\">Choose Plan</button>\n        </div>\n        \n        <div className=\"bg-white border border-gray-200 rounded-lg p-6 shadow-sm flex flex-col\">\n          <h3 className=\"text-xl font-semibold mb-4\">Enterprise</h3>\n          <p className=\"text-3xl font-bold mb-2\"><span className=\"price-monthly\">$50</span><span className=\"price-yearly hidden\">$500</span><span className=\"text-base font-normal\">/mo</span></p>\n          <ul className=\"mb-6 space-y-2 text-gray-600 flex-grow\">\n            <li>✔️ Unlimited Projects</li>\n            <li>✔️ 200 GB Storage</li>\n            <li>✔️ 24/7 Support</li>\n          </ul>\n          <button className=\"mt-auto bg-blue-600 text-white py-2 rounded hover700 transition\">Choose Plan</button>\n        </div>\n      </div>\n    \n      \n    </section>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
