      "content": "import * as React from \"react\"\n\nfunction Htmlbasics({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"htmlbasics\"\n      className={className}\n      {...props}\n    >\n      <header className=\"main-header\">\n          <div className=\"logo\">Pro<span>LogiX</span></div>\n          <nav className=\"navbar\">\n            <ul>\n              <li><a href=\"#home\">Home</a></li>\n              <li><a href=\"#services\">Services</a></li>\n              <li><a href=\"#clients\">Clients</a></li>\n              <li><a href=\"#contact\">Contact</a></li>\n            </ul>\n          </nav>\n        </header>\n      \n        <section className=\"hero\" id=\"home\">\n          <div className=\"hero-text\">\n            <h1>Delivering Smarter Logistics Solutions</h1>\n            <p>Seamless. Scalable. Secure.</p>\n            <a href=\"#services\" className=\"btn primary-btn\">Explore Services</a>\n          </div>\n        </section>\n      \n        <section className=\"services-section\" id=\"services\">\n          <h2>Our Core Services</h2>\n          <div className=\"services-grid\">\n            <div className=\"service-card\">\n              <img src=\"https://images.unsplash.com/photo-1581091012184-5c8d6d09f67d?auto=format&fit=crop&w=500&q=80\" alt=\"Freight\" />\n              <h3>Global Freight</h3>\n              <p>Reliable air, land, and sea freight solutions to keep your cargo on the move worldwide.</p>\n            </div>\n            <div className=\"service-card\">\n              <img src=\"https://images.unsplash.com/photo-1604145559206-e3d9c699fa36?auto=format&fit=crop&w=500&q=80\" alt=\"Warehouse\" />\n              <h3>Smart Warehousing</h3>\n              <p>Secure, scalable storage options backed by automation and real-time tracking.</p>\n            </div>\n            <div className=\"service-card\">\n              <img src=\"https://images.unsplash.com/photo-1579427427702-52bbba76f1f4?auto=format&fit=crop&w=500&q=80\" alt=\"Customs\" />\n              <h3>Customs Management</h3>\n              <p>Clearances, documentation, and compliance handled efficiently across borders.</p>\n            </div>\n            <div className=\"service-card\">\n              <img src=\"https://images.unsplash.com/photo-1620894291458-4823b420f1cf?auto=format&fit=crop&w=500&q=80\" alt=\"Tech\" />\n              <h3>Logistics Tech</h3>\n              <p>Integrate AI, analytics, and apps to optimize your entire logistics pipeline.</p>\n            </div>\n          </div>\n        </section>\n      \n        <section className=\"clients-section\" id=\"clients\">\n          <h2>Trusted by Global Leaders</h2>\n          <div className=\"client-logos\">\n            <img src=\"https://upload.wikimedia.org/wikipedia/commons/thumb/f/fa/Apple_logo_black.svg/200px-Apple_logo_black.svg.png\" alt=\"Apple\" />\n            <img src=\"https://upload.wikimedia.org/wikipedia/commons/thumb/0/08/Google_2015_logo.svg/200px-Google_2015_logo.svg.png\" alt=\"Google\" />\n            <img src=\"https://upload.wikimedia.org/wikipedia/commons/thumb/4/44/Microsoft_logo.svg/200px-Microsoft_logo.svg.png\" alt=\"Microsoft\" />\n            <img src=\"https://upload.wikimedia.org/wikipedia/commons/thumb/5/51/Amazon_logo.svg/200px-Amazon_logo.svg.png\" alt=\"Amazon\" />\n          </div>\n          <div className=\"testimonial-cards\">\n            <div className=\"testimonial\">\n              <p>“ProLogiX reduced our logistics overhead by 32%. Their team is world-class.”</p>\n              <h4>– GlobalTech Inc.</h4>\n            </div>\n            <div className=\"testimonial\">\n              <p>“They helped us scale warehousing and stay fully compliant across 12 countries.”</p>\n              <h4>– NovaExports</h4>\n            </div>\n          </div>\n        </section>\n      \n        <footer className=\"footer\" id=\"contact\">\n          <div className=\"footer-content\">\n            <div>\n              <h3>Contact</h3>\n              <p>Email: connect@prologix.com</p>\n              <p>Phone: +1-800-LOGIX</p>\n            </div>\n            <div>\n              <h3>Subscribe</h3>\n              <form id=\"newsletter-form\">\n                <input type=\"email\" id=\"email\" placeholder=\"Enter your email\" required />\n                <button type=\"submit\">Subscribe</button>\n                <p className=\"error-message\"></p>\n              </form>\n            </div>\n          </div>\n          <p className=\"footer-note\">© 2025 ProLogiX. All rights reserved.</p>\n        </footer>\n    </div>\n  )\n}\n\nexport { Htmlbasics }\n",
      "type": "registry:ui"
    }
  ],
  "meta": {
    "kind": "component",
    "tags": [
