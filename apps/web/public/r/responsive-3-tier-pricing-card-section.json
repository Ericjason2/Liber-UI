 Feature C</span>\n          </li>\n          <li class=\"flex items-start\">\n            <i class=\"feature-checkmark\"></i>\n            <span class=\"text-gray-700\">Limited Feature D</span>\n          </li>\n        </ul>\n      </div>\n\n      <!-- Card 2: Standard -->\n      <div class=\"bg-white rounded-xl p-6 sm:p-8 shadow-sm flex flex-col w-full md:w-1/3\">\n        <!-- Icon -->\n        <div class=\"text-center mb-4\">\n          <i class=\"fas fa-seedling text-3xl text-gray-700\"></i> <!-- Placeholder Icon -->\n        </div>\n        <!-- Header -->\n        <div class=\"text-center mb-3\">\n          <h3 class=\"text-2xl font-semibold text-gray-900 mb-1\">Standard</h3>\n          <p class=\"text-sm text-gray-600\">For regular usage</p>\n        </div>\n        <!-- Price -->\n        <div class=\"text-center mb-6 min-h-[70px]\">\n          <!-- Added min-height for alignment -->\n          <p class=\"text-4xl font-bold text-gray-900 mb-1\">$19</p>\n          <p class=\"text-xs text-gray-500 leading-tight\">Per month, billed annually<br>or $25 billed monthly.</p>\n        </div>\n        <!-- CTA -->\n        <a href=\"#\"\n          class=\"block w-full bg-gray-900 text-white text-center py-3 px-6 rounded-full font-semibold hover:bg-gray-700 transition duration-200 mb-6\">\n          Choose Plan\n        </a>\n        <!-- Separator -->\n        <hr class=\"border-gray-200 mb-6\">\n        <!-- Features -->\n        <div class=\"flex-grow\">\n          <p class=\"text-sm font-medium text-gray-800 mb-4\">Everything in Basic, plus:</p>\n          <ul class=\"space-y-3 text-sm\">\n            <li class=\"flex items-start\">\n              <i class=\"feature-checkmark\"></i>\n              <span class=\"text-gray-700\">Advanced Feature E</span>\n            </li>\n            <li class=\"flex items-start\">\n              <i class=\"feature-checkmark\"></i>\n              <span class=\"text-gray-700\">Enhanced Feature F</span>\n            </li>\n            <li class=\"flex items-start\">\n              <i class=\"feature-checkmark\"></i>\n              <span class=\"text-gray-700\">More capacity for Feature B</span>\n            </li>\n            <li class=\"flex items-start\">\n              <i class=\"feature-checkmark\"></i>\n              <span class=\"text-gray-700\">Collaboration tools</span>\n            </li>\n          </ul>\n        </div>\n      </div>\n\n      <!-- Card 3: Premium -->\n      <div class=\"bg-white rounded-xl p-6 sm:p-8 shadow-sm flex flex-col w-full md:w-1/3\">\n        <!-- Icon -->\n        <div class=\"text-center mb-4\">\n          <i class=\"fas fa-tree text-3xl text-gray-700\"></i> <!-- Placeholder Icon -->\n        </div>\n        <!-- Header -->\n        <div class=\"text-center mb-3\">\n          <h3 class=\"text-2xl font-semibold text-gray-900 mb-1\">Premium</h3>\n          <p class=\"text-sm text-gray-600\">For power users & teams</p>\n        </div>\n        <!-- Price -->\n        <div class=\"text-center mb-6 min-h-[70px]\">\n          <!-- Added min-height for alignment -->\n          <p class=\"text-4xl font-bold text-gray-900 mb-1\">From $99</p>\n          <p class=\"text-xs text-gray-500 leading-tight\">Per user / month<br>Volume discounts available.</p>\n        </div>\n        <!-- CTA -->\n        <a href=\"#\"\n          class=\"block w-full bg-gray-900 text-white text-center py-3 px-6 rounded-full font-semibold hover:bg-gray-700 transition duration-200 mb-6\">\n          Contact Us\n        </a>\n        <!-- Separator -->\n        <hr class=\"border-gray-200 mb-6\">\n        <!-- Features -->\n        <div class=\"flex-grow\">\n          <p class=\"text-sm font-medium text-gray-800 mb-4\">Everything in Standard, plus:</p>\n          <ul class=\"space-y-3 text-sm\">\n            <li class=\"flex items-start\">\n              <i class=\"feature-checkmark\"></i>\n              <span class=\"text-gray-700\">Unlimited Feature A & B</span>\n            </li>\n        