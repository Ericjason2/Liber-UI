lex items-center\\\">\\n          <span class=\\\"text-teal-600 font-semibold\\\">\\n            <span>\\n              <i class=\\\"fas fa-star\\\"></i>\\n              <i class=\\\"fas fa-star\\\"></i>\\n              <i class=\\\"fas fa-star\\\"></i>\\n              <i class=\\\"fas fa-star\\\"></i>\\n              <i class=\\\"far fa-star\\\"></i>\\n              <span>\\n              </span>\\n              <span class=\\\"ml-2 text-gray-600 text-sm\\\">34 reviews</span>\\n        </div>\\n      </div>\\n    </div>\\n  </div>\\n</div>\" }} />\n  );\n}\n",
