t-emerald-700 mt-1\\\">Secure endpoint on port 443</p>\\n  </div>\\n  <form data-form class=\\\"space-y-4\\\" novalidate>\\n    <div>\\n      <label for=\\\"user\\\" class=\\\"text-xs text-emerald-500 block mb-1.5\\\">$ username</label>\\n      <input id=\\\"user\\\" type=\\\"text\\\" required autocomplete=\\\"username\\\" placeholder=\\\"dev_node\\\" class=\\\"w-full bg-emerald-950/40 border border-emerald-500/30 rounded-lg px-3 py-3 text-sm text-emerald-200 placeholder-emerald-800 transition focus:outline-none focus:border-emerald-400 focus:ring-4 focus:ring-emerald-400/15\\\">\\n    </div>\\n    <div>\\n  <div class=\\\"flex items-center justify-between mb-1.5\\\">\\n    <label for=\\\"pw\\\" class=\\\"text-xs text-emerald-500\\\">$ password</label>\\n  </div>\\n  <div class=\\\"relative\\\">\\n    <input id=\\\"pw\\\" type=\\\"password\\\" required minlength=\\\"6\\\" autocomplete=\\\"current-password\\\" placeholder=\\\"••••••••\\\" class=\\\"w-full bg-emerald-950/40 border border-emerald-500/30 rounded-lg px-3 py-3 text-sm text-emerald-200 placeholder-emerald-800 transition focus:outline-none focus:border-emerald-400 focus:ring-4 focus:ring-emerald-400/15 pr-16\\\">\\n    <button type=\\\"button\\\" data-toggle=\\\"pw\\\" aria-pressed=\\\"false\\\" class=\\\"absolute right-3 top-1/2 -translate-y-1/2 text-xs font-semibold text-emerald-500 hover:text-emerald-300 focus-visible:outline-none focus-visible:underline\\\">Show</button>\\n  </div>\\n</div>\\n    <button type=\\\"submit\\\" data-loading=\\\"authenticating...\\\" class=\\\"w-full bg-emerald-500 hover:bg-emerald-400 text-black font-bold text-sm py-3 rounded-lg transition shadow-[0_0_18px_rgba(16,185,129,0.4)] active:scale-[0.99] focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-emerald-300/40\\\">Run login</button>\\n  </form>\\n  <div class=\\\"mt-5 pt-4 border-t border-emerald-950 flex justify-between text-xs text-emerald-600\\\">\\n    <a href=\\\"#\\\" class=\\\"hover:text-emerald-300\\\">Recover access</a><a href=\\\"#\\\" class=\\\"hover:text-emerald-300\\\">Use SSH key</a>\\n  </div>\\n</section>\\n</main>\\n\\n</body>\\n</html>\" }} />\n  );\n}\n",
