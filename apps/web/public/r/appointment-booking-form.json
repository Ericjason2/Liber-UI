      "content": "/**\n * Component: Appointment booking form\n * Author: @leif99 (https://tailwindflex.com/@leif99)\n * Source: https://tailwindflex.com/@leif99/appointment-booking-form\n * Attribution: Créé par @leif99 sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function AppointmentBookingForm() {\n  return (\n    <div>\n    <div className=\"max-w-md mx-auto mt-10 bg-white shadow-lg rounded-lg overflow-hidden\">\n        <div className=\"text-2xl py-4 px-6 bg-gray-900 text-white text-center font-bold uppercase\">\n            Book an Appointment\n        </div>\n        <form className=\"py-4 px-6\" action=\"\" method=\"POST\">\n            <div className=\"mb-4\">\n                <label className=\"block text-gray-700 font-bold mb-2\" htmlFor=\"name\">\n                    Name\n                </label>\n                <input\n                    className=\"shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus focus\"\n                    id=\"name\" type=\"text\" placeholder=\"Enter your name\" />\n            </div>\n            <div className=\"mb-4\">\n                <label className=\"block text-gray-700 font-bold mb-2\" htmlFor=\"email\">\n                    Email\n                </label>\n                <input\n                    className=\"shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus focus\"\n                    id=\"email\" type=\"email\" placeholder=\"Enter your email\" />\n            </div>\n            <div className=\"mb-4\">\n                <label className=\"block text-gray-700 font-bold mb-2\" htmlFor=\"phone\">\n                    Phone Number\n                </label>\n                <input\n                    className=\"shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus focus\"\n                    id=\"phone\" type=\"tel\" placeholder=\"Enter your phone number\" />\n            </div>\n            <div className=\"mb-4\">\n                <label className=\"block text-gray-700 font-bold mb-2\" htmlFor=\"date\">\n                    Date\n                </label>\n                <input\n                    className=\"shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus focus\"\n                    id=\"date\" type=\"date\" placeholder=\"Select a date\" />\n            </div>\n            <div className=\"mb-4\">\n                <label className=\"block text-gray-700 font-bold mb-2\" htmlFor=\"time\">\n                    Time\n                </label>\n                <input\n                    className=\"shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus focus\"\n                    id=\"time\" type=\"time\" placeholder=\"Select a time\" />\n            </div>\n            <div className=\"mb-4\">\n                <label className=\"block text-gray-700 font-bold mb-2\" htmlFor=\"service\">\n                    Service\n                </label>\n                <select\n                    className=\"shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus focus\"\n                    id=\"service\" name=\"service\">\n                    <option value=\"\">Select a service</option>\n                    <option value=\"haircut\">Haircut</option>\n                    <option value=\"coloring\">Coloring</option>\n                    <option value=\"styling\">Styling</option>\n                    <option value=\"facial\">Facial</option>\n                </select>\n            </div>\n            <div className=\"mb-4\">\n                <label className=\"block text-gray-700 font-bold mb-2\" htmlFor=\"message\">\n                    Message\n                </label>\n                <textarea\n                    className=\"shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus focus\"\n                    id=\"message\" rows=\"4\" placeholder=\"Enter any additional information\"></textarea>\n            </div>\n            <div className=\"flex items-center justify-center mb-4\">\n                <button\n                    className=\"bg-gray-900 text-white py-2 px-4 rounded hover800 focus focus\"\n                    type=\"submit\">\n                    Book Appointment\n                </button>\n            </div>\n    \n        </form>\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
  ],
