      "content": "import * as React from \"react\"\n\nfunction ChatsScreenInNeomorphism({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"chats-screen-in-neomorphism\"\n      className={className}\n      {...props}\n    >\n      <style>{\".neo-shadow {\\n            box-shadow: 5px 5px 10px #d1d9e6, -5px -5px 10px #ffffff;\\n        }\\n        .neo-inset {\\n            box-shadow: inset 5px 5px 10px #d1d9e6, inset -5px -5px 10px #ffffff;\\n        }\"}</style>\n      <div className=\"max-w-md mx-auto bg-gray-100 rounded-xl neo-shadow p-6\">\n              <h1 className=\"text-2xl font-bold mb-4\">Chats</h1>\n              \n              <div className=\"space-y-4\">\n                  \n                  <div className=\"flex items-center space-x-4 p-4 rounded-lg neo-shadow\">\n                      <div className=\"w-12 h-12 rounded-full neo-inset flex items-center justify-center\">\n                          <span className=\"text-xl\">👤</span>\n                      </div>\n                      <div>\n                          <h2 className=\"font-semibold\">John Doe</h2>\n                          <p className=\"text-sm text-gray-600\">Hello, how are you?</p>\n                      </div>\n                  </div>\n                  \n                  \n                  <div className=\"flex items-center space-x-4 p-4 rounded-lg neo-shadow\">\n                      <div className=\"w-12 h-12 rounded-full neo-inset flex items-center justify-center\">\n                          <span className=\"text-xl\">👤</span>\n                      </div>\n                      <div>\n                          <h2 className=\"font-semibold\">Jane Smith</h2>\n                          <p className=\"text-sm text-gray-600\">Are we meeting today?</p>\n                      </div>\n                  </div>\n              </div>\n              \n              \n              <button className=\"mt-6 w-full py-2 rounded-lg neo-shadow hover:neo-inset transition-all duration-300 focus:outline-none\">\n                  New Chat\n              </button>\n          </div>\n    </div>\n  )\n}\n\nexport { ChatsScreenInNeomorphism }\n",
      "type": "registry:ui"
    }
