      "content": "/**\n * Component: Call to example\n * Author: @oliver-hansen (https://tailwindflex.com/@oliver-hansen)\n * Source: https://tailwindflex.com/@oliver-hansen/call-to-example\n * Attribution: Créé par @oliver-hansen sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function CallToExample() {\n  return (\n    <div>\n    <div className=\"mx-auto max-w-7xl sm6 lg8 mt-20\">\r\n    \r\n        <div\r\n            className=\"relative isolate overflow-hidden bg-white px-6 py-20 text-center sm3xl sm sm100 sm16 sm\">\r\n    \r\n            <h2 className=\"mx-auto max-w-2xl text-3xl font-bold tracking-tight text-gray-900 sm4xl\">\r\n                Join our community today!\r\n            </h2>\r\n    \r\n            <h3 className=\"mx-auto mt-6 max-w-xl text-lg leading-8 text-gray-500\">\r\n                Sign up for exclusive access to events, resources, and more\r\n            </h3>\r\n    \r\n            <div className=\"mt-8 flex items-center justify-center gap-x-6\">\r\n                <a className=\"inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-4 py-3 text-sm font-semibold text-white shadow-sm transition-all duration-150 hover500 focus-visible focus-visible2 focus-visible2 focus-visible600\"\r\n                    href=\"#\">\r\n                    Explore the forum\r\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"h-4 w-4\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\r\n                        <path fillRule=\"evenodd\"\r\n                            d=\"M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z\"\r\n                            clipRule=\"evenodd\"></path>\r\n                    </svg>\r\n                </a>\r\n            </div>\r\n    \r\n            \r\n            <svg viewBox=\"0 0 1024 1024\"\r\n                className=\"absolute left-1/2 top-1/2 -z-10 h-[64rem] w-[64rem] -translate-x-1/2 [mask-image(closest-side,white,transparent)]\"\r\n                aria-hidden=\"true\">\r\n                <circle cx=\"512\" cy=\"512\" r=\"512\" fill=\"url(#827591b1-ce8c-4110-b064-7cb85a0b1217)\" fill-opacity=\"0.7\">\r\n                </circle>\r\n                <defs>\r\n                    <radialGradient id=\"827591b1-ce8c-4110-b064-7cb85a0b1217\">\r\n                        <stop stopColor=\"#3b82f6\"></stop>\r\n                        <stop offset=\"1\" stopColor=\"#1d4ed8\"></stop>\r\n                    </radialGradient>\r\n                </defs>\r\n            </svg>\r\n    \r\n        </div>\r\n        \r\n    </div>\n    </div>\n  );\n}\n",
