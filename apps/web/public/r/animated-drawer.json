      "content": "/**\n * Component: Animated Drawer\n * Author: @eamon-carter (https://tailwindflex.com/@eamon-carter)\n * Source: https://tailwindflex.com/@eamon-carter/animated-drawer\n * Attribution: Créé par @eamon-carter sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function AnimatedDrawer() {\n  return (\n    <div>\n    <div className=\"bg-gray-100\">\r\n    \r\n        <div className=\"h-screen flex overflow-hidden bg-gray-200\">\r\n            \r\n            <div className=\"absolute bg-gray-800 text-white w-56 min-h-screen overflow-y-auto transition-transform transform -translate- ease-in-out duration-300\"\r\n                id=\"sidebar\">\r\n                \r\n                <div className=\"p-4\">\r\n                    <h1 className=\"text-2xl font-semibold\">Sidebar</h1>\r\n                    <ul className=\"mt-4\">\r\n                        <li className=\"mb-2\"><a href=\"#\" className=\"block hover400\">Home</a></li>\r\n                        <li className=\"mb-2\"><a href=\"#\" className=\"block hover400\">About</a></li>\r\n                        <li className=\"mb-2\"><a href=\"#\" className=\"block hover400\">Services</a></li>\r\n                        <li className=\"mb-2\"><a href=\"#\" className=\"block hover400\">Contact</a></li>\r\n                    </ul>\r\n                </div>\r\n            </div>\r\n    \r\n            \r\n            <div className=\"flex-1 flex flex-col overflow-hidden\">\r\n                \r\n                <div className=\"bg-white shadow\">\r\n                    <div className=\"container mx-auto\">\r\n                        <div className=\"flex justify-between items-center py-4 px-2\">\r\n                            <h1 className=\"text-xl font-semibold\">Animated Drawer</h1>\r\n    \r\n                            <button className=\"text-gray-500 hover600\" id=\"open-sidebar\">\r\n                            <svg className=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"M4 6h16M4 12h16M4 18h16\"></path>\r\n                            </svg>\r\n                        </button>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                \r\n                <div className=\"flex-1 overflow-auto p-4\">\r\n                    <h1 className=\"text-2xl font-semibold\">Welcome to our website</h1>\r\n                    <p>... Content goes here ...</p>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    \r\n        \r\n    \r\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
