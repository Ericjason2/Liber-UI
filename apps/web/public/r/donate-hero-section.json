    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Donation Modal</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Rufina:wght@700&display=swap\" rel=\"stylesheet\">\n    <style>\n        .font-rufina {\n            font-family: 'Rufina', serif;\n        }\n        .font-poppins {\n            font-family: 'Poppins', sans-serif;\n        }\n    </style>\n</head>\n<body>\n    <!-- Full-screen Donation Modal -->\n    <div class=\"fixed inset-0 bg-white z-40 overflow-y-auto pt-20\">\n        <!-- Hero Section -->\n        <section class=\"bg-[#C2EFD4] min-h-[50vh] flex items-center\">\n            <div class=\"container mx-auto px-6 py-12 lg:py-24\">\n                <div class=\"flex flex-col lg:flex-row items-center justify-between\">\n                    <div class=\"lg:w-1/2 mb-12 lg:mb-0\">\n                        <h1 class=\"text-[#224f34] text-4xl md:text-5xl lg:text-6xl xl:text-[72px] font-bold font-rufina leading-tight mb-6\">\n                            Your Support Creates Brighter Futures!\n                        </h1>\n                        <p class=\"text-[#267d49] text-xl lg:text-2xl font-medium font-poppins leading-relaxed mb-8\">\n                            Every donation helps provide education, shelter, and hope to children in need. \n                            Join us in making a lasting difference.\n                        </p>\n                        <button class=\"px-8 py-4 text-white text-lg font-medium font-poppins uppercase bg-[#224e34] rounded-[3px] shadow-lg hover:bg-[#1a3a27] transition-colors\">\n                            Learn About Our Impact\n                        </button>\n                    </div>\n                    <div class=\"lg:w-1/2 flex justify-center\">\n                        <img \n                            class=\"w-full max-w-xl rounded-lg shadow-xl\" \n                            src=\"https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80\" \n                            alt=\"Children benefiting from donations\" \n                        />\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- Donation Form Section -->\n        <section class=\"py-16 bg-white\">\n            <div class=\"container mx-auto px-6\">\n                <div class=\"max-w-4xl mx-auto\">\n                    <h2 class=\"text-3xl md:text-4xl font-bold text-center text-gray-800 mb-12\">\n                        Make a Donation\n                    </h2>\n                    \n                    <form class=\"grid grid-cols-1 lg:grid-cols-2 gap-12\">\n                        <!-- Left Column - Donation Info -->\n                        <div>\n                            <div class=\"mb-8\">\n                                <label class=\"block text-gray-700 font-medium mb-4 text-xl\">\n                                    Donation Amount\n                                </label>\n                                <div class=\"grid grid-cols-3 md:grid-cols-5 gap-4 mb-6\">\n                                    <button\n                                        type=\"button\"\n                                        class=\"py-4 rounded-md text-lg font-medium transition-colors bg-gray-100 text-gray-800 hover:bg-gray-200\"\n                                    >\n                                        $10\n                                    </button>\n                                    <button\n                                        type=\"button\"\n                                        class=\"py-4 rounded-md text-lg font-medium transition-colors bg-gray-100 text-gray-800 hover:bg-gray-200\"\n                                    >\n                                        $25\n                                    </button>\n                                    <button\n                                        type=\"button\"\n                                        class=\"py-4 rounded-md text-lg font-medium transition-colors bg-emerald-600 text-white\"\n                                    >\n                                        $50\n                                    </button>\n                                    <button\n                                        type=\"button\"\n                                        class=\"py-4 rounded-md text-lg font-medium transition-colors bg-gray-100 text-gray-800 hover:bg-gray-200\"\n                                    >\n                                        $100\n                                    </button>\n                                    <button\n                                        type=\"button\"\n                                        class=\"py-4 rounded-md text-lg font-medium transition-colors bg-gray-100 text-gray-800 hover:bg-gray-200\"\n                                    >\n                                        $250\n                                    </button>\n                                </div>\n                                <div class=\"relative\">\n                                    <span class=\"absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400\">$</span>\n                                    <input\n                                        type=\"number\"\n                                        value=\"50\"\n                                        placeholder=\"Other amount\"\n                                        class=\"w-full pl-14 pr-6 py-4 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-xl\"\n                                        required\n                                    />\n                                </div>\n                            </div>\n                        </div>\n\n                        <!-- Right Column - Payment Info -->\n                        <div>\n                            <div class=\"mb-8\">\n                                <label class=\"block text-gray-700 font-medium mb-4 text-xl\">\n                                    Payment Method\n                                </label>\n                                <div class=\"space-y-4\">\n                                    <label class=\"flex items-center space-x-4 p-4 border-2 border-gray-200 rounded-lg hover:border-emerald-400 transition-colors cursor-pointer\">\n                                        <input\n                                            type=\"radio\"\n                                            name=\"paymentMethod\"\n                                            value=\"card\"\n                                            checked\n                                            class=\"h-6 w-6 text-emerald-600 focus:ring-emerald-500\"\n                                        />\n                                        <span class=\"flex items-center text-xl\">\n                                            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"mr-3\">\n                                                <rect x=\"1\" y=\"4\" width=\"22\" height=\"16\" rx=\"2\" ry=\"2\"></rect>\n                                                <line x1=\"1\" y1=\"10\" x2=\"23\" y2=\"10\"></line>\n                                            </svg>\n                                            Credit/Debit Card\n                                        </span>\n                                    </label>\n                                    <label class=\"flex items-center space-x-4 p-4 border-2 border-gray-200 rounded-lg hover:border-emerald-400 transition-colors cursor-pointer\">\n                                        <input\n                                            type=\"radio\"\n                                            name=\"paymentMethod\"\n                                            value=\"mobile\"\n                                            class=\"h-6 w-6 text-emerald-600 focus:ring-emerald-500\"\n                                        />\n                                        <span class=\"text-xl\">Mobile Money</span>\n                                    </label>\n                                </div>\n                            </div>\n\n                            <button\n                                type=\"submit\"\n                                class=\"w-full bg-emerald-600 text-white py-5 px-8 rounded-lg hover:bg-emerald-700 transition-colors font-bold text-xl flex items-center justify-center gap-4 shadow-lg\"\n                            >\n                                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                                    <path d=\"M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z\"></path>\n                                    <path d=\"M12 5 9.04 7.96a2.17 2.17 0 0 0 0 3.08v0c.82.82 2.13.85 3 .07l2.07-1.9a2.82 2.82 0 0 1 3.79 0l2.96 2.66\"></path>\n                                    <path d=\"m18 15-2-2\"></path>\n                                    <path d=\"m15 18-2-2\"></path>\n                                </svg>\n                                Complete Donation\n                            </button>\n\n                            <p class=\"text-gray-500 mt-6 text-center text-lg\">\n                                Your donation is secure and tax-deductible. \n                                <br />We respect your privacy and never share your information.\n                            </p>\n                        </div>\n                    </form>\n                </div>\n            </div>\n        </section>\n\n        <!-- Footer Section -->\n        <footer class=\"bg-gray-50 py-8\">\n            <div class=\"container mx-auto px-6 text-center\">\n                <p class=\"text-gray-600\">\n                    Orthodox Rwanda is a registered 501(c)(3) nonprofit organization.\n                    <br />\n                    All donations are tax-deductible to the fullest extent allowed by law.\n                </p>\n            </div>\n        </footer>\n    </div>\n</body>\n</html>"
