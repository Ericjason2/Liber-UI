-full h-full object-cover transition-transform duration-500 group-hover:scale-105\"\n                            loading=\"lazy\"\n                        />\n                        <div class=\"absolute top-4 right-4\">\n                            <span class=\"bg-white/90 backdrop-blur-sm px-3 py-1 rounded-full text-xs font-medium text-gray-700\">New</span>\n                        </div>\n                    </div>\n                    \n                    <div class=\"space-y-2\">\n                        <div class=\"flex items-center justify-between\">\n                            <h3 class=\"text-xl font-normal text-gray-900\">Wild Journey</h3>\n                            <span class=\"text-lg font-medium text-gray-900\">$35</span>\n                        </div>\n                        <p class=\"text-gray-500 text-sm\">Classic fit t-shirt</p>\n                        \n                        <div class=\"flex items-center justify-between pt-2\">\n                            <div class=\"flex items-center space-x-1\">\n                                <i data-lucide=\"star\" class=\"w-4 h-4 fill-gray-300 text-gray-300\"></i>\n                                <i data-lucide=\"star\" class=\"w-4 h-4 fill-gray-300 text-gray-300\"></i>\n                                <i data-lucide=\"star\" class=\"w-4 h-4 fill-gray-300 text-gray-300\"></i>\n                                <i data-lucide=\"star\" class=\"w-4 h-4 fill-gray-300 text-gray-300\"></i>\n                                <i data-lucide=\"star\" class=\"w-4 h-4 fill-gray-300 text-gray-300\"></i>\n                                <span class=\"text-sm text-gray-400 ml-1\">(No reviews)</span>\n                            </div>\n                            <button class=\"text-gray-400 hover:text-gray-600 transition-colors\">\n                                <i data-lucide=\"heart\" class=\"w-5 h-5\"></i>\n                            </button>\n                        </div>\n                    </div>\