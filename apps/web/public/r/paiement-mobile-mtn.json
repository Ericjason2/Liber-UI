      "content": "/**\n * Component: Paiement Mobile MTN\n * Author: @omer-fils-elenga (https://tailwindflex.com/@omer-fils-elenga)\n * Source: https://tailwindflex.com/@omer-fils-elenga/paiement-mobile-mtn\n * Attribution: Créé par @omer-fils-elenga sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function PaiementMobileMtn() {\n  return (\n    <div dangerouslySetInnerHTML={{ __html: \"<!DOCTYPE html>\\n<html lang=\\\"fr\\\">\\n<head>\\n    <meta charset=\\\"UTF-8\\\">\\n    <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\">\\n    <title>Paiement & Succès | Kelaplus</title>\\n    \\n    \\n    \\n    <link href=\\\"https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;900&display=swap\\\" rel=\\\"stylesheet\\\">\\n\\n    <style>\\n        body { font-family: 'Outfit', sans-serif; background: #f8fafc; }\\n        [x-cloak] { display: none !important; }\\n        .bg-mtn { background-color: #FFCC00; }\\n        .bg-climax { background: linear-gradient(135deg, #0047FF 0%, #00B2FF 100%); }\\n        .key-shadow { box-shadow: 0 4px 0px rgba(0,0,0,0.05); }\\n        .key-shadow:active { transform: translateY(2px); box-shadow: 0 2px 0px rgba(0,0,0,0.05); }\\n    </style>\\n</head>\\n<body x-data=\\\"paymentSystem()\\\" @keydown.window=\\\"handleKeyboard($event)\\\">\\n\\n    <template x-if=\\\"step === 'payment'\\\">\\n        <div class=\\\"min-h-screen flex flex-col md:flex-row animate-fade-in\\\">\\n            <div class=\\\"w-full md:w-1/2 bg-white flex flex-col items-center justify-center p-12 md:rounded-r-[3rem] shadow-xl z-10\\\">\\n                <div class=\\\"w-20 h-20 bg-mtn rounded-3xl flex items-center justify-center mb-8 shadow-lg rotate-3\\\">\\n                    <span class=\\\"font-black text-black text-xl\\\">MTN</span>\\n                </div>\\n                <h2 class=\\\"text-4xl font-black text-slate-900 mb-2\\\">Paiement Mobile</h2>\\n                <p class=\\\"text-slate-400 font-medium mb-10\\\">Validation de l'accès aux résultats</p>\\n\\n                <div class=\\\"w-full max-w-sm bg-slate-50 border-2 border-slate-100 rounded-[2.5rem] p-8 text-center\\\">\\n                    <div class=\\\"flex justify-between items-center mb-6\\\">\\n                        <span class=\\\"text-[10px] font-black uppercase tracking-widest text-slate-400\\\">Montant à payer</span>\\n                        <span class=\\\"px-4 py-1 bg-blue-100 text-blue-600 rounded-full font-black text-xs\\\">100 FCFA</span>\\n                    </div>\\n                    <div class=\\\"text-4xl font-black tracking-[0.2em] text-slate-900 py-4 bg-white rounded-2xl shadow-inner\\\" \\n                         x-text=\\\"phone || '--------'\\\">\\n                    </div>\\n                    <p class=\\\"text-[10px] text-slate-300 font-bold mt-4 uppercase\\\">Utilisez le clavier ou les touches</p>\\n                </div>\\n            </div>\\n\\n            <div class=\\\"w-full md:w-1/2 bg-mtn flex items-center justify-center p-8\\\">\\n                <div class=\\\"max-w-xs w-full\\\">\\n                    <div class=\\\"grid grid-cols-3 gap-4 mb-8\\\">\\n                        <template x-for=\\\"key in ['1','2','3','4','5','6','7','8','9','C','0','⌫']\\\">\\n                            <button @click=\\\"inputDigit(key)\\\" \\n                                    class=\\\"key-shadow h-20 w-20 flex items-center justify-center bg-white hover:bg-slate-50 text-slate-900 text-2xl font-black rounded-3xl transition-all\\\"\\n                                    x-text=\\\"key\\\">\\n                            </button>\\n                        </template>\\n                    </div>\\n                    <button @click=\\\"processPayment()\\\" \\n                            :disabled=\\\"phone.length < 9 || isProcessing\\\"\\n                            class=\\\"w-full py-6 bg-slate-900 text-white rounded-[2rem] font-black uppercase tracking-widest text-sm shadow-2xl disabled:opacity-30 active:scale-95 transition-all\\\">\\n                        <span x-show=\\\"!isProcessing\\\">Confirmer le paiement</span>\\n                        <span x-show=\\\"isProcessing\\\" class=\\\"flex items-center justify-center gap-2\\\">\\n                            <svg class=\\\"animate-spin h-5 w-5 text-white\\\" viewBox=\\\"0 0 24 24\\\"><circle class=\\\"opacity-25\\\" cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"10\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"4\\\"></circle><path class=\\\"opacity-75\\\" fill=\\\"currentColor\\\" d=\\\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z\\\"></path></svg>\\n                            Traitement...\\n                        </span>\\n                    </button>\\n                </div>\\n            </div>\\n        </div>\\n    </template>\\n\\n    <template x-if=\\\"step === 'success'\\\">\\n        <div class=\\\"min-h-screen flex flex-col md:flex-row bg-white overflow-hidden\\\">\\n            <div class=\\\"w-full md:w-5/12 bg-climax relative flex flex-col items-center justify-center p-12 text-white overflow-hidden\\\">\\n                <div class=\\\"absolute -top-20 -left-20 w-96 h-96 bg-white/10 rounded-full blur-3xl\\\"></div>\\n                <div class=\\\"z-10 text-center\\\">\\n                    <div class=\\\"w-28 h-28 bg-white rounded-full flex items-center justify-center mx-auto mb-8 shadow-2xl animate-bounce\\\">\\n                        <svg class=\\\"w-14 h-14 text-blue-600\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\"><path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" stroke-width=\\\"4\\\" d=\\\"M5 13l4 4L19 7\\\"></path></svg>\\n                    </div>\\n                    <h2 class=\\\"text-6xl font-black tracking-tighter mb-4\\\">SUCCÈS !</h2>\\n                    <div class=\\\"inline-block px-6 py-2 bg-white/20 backdrop-blur-md rounded-full border border-white/30\\\">\\n                        <span class=\\\"text-sm font-black uppercase tracking-widest\\\">Mention Très Bien</span>\\n                    </div>\\n                </div>\\n            </div>\\n\\n            <div class=\\\"w-full md:w-7/12 flex items-center justify-center p-8 md:p-20\\\">\\n                <div class=\\\"max-w-md w-full\\\">\\n                    <header class=\\\"mb-12\\\">\\n                        <p class=\\\"text-blue-600 font-black text-xs uppercase tracking-[0.4em] mb-4\\\">Résultat Officiel BEPC 2026</p>\\n                        <h1 class=\\\"text-5xl font-black text-slate-900 leading-tight\\\">Félicitations,<br><span class=\\\"text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-cyan-500\\\">M. le Lauréat</span></h1>\\n                    </header>\\n\\n                    <div class=\\\"grid grid-cols-2 gap-4 mb-10\\\">\\n                        <div class=\\\"bg-slate-50 p-6 rounded-[2rem] border border-slate-100\\\">\\n                            <p class=\\\"text-[10px] font-black text-slate-400 uppercase mb-1\\\">Candidat</p>\\n                            <p class=\\\"font-black text-slate-800\\\">DEF30004</p>\\n                        </div>\\n                        <div class=\\\"bg-slate-50 p-6 rounded-[2rem] border border-slate-100\\\">\\n                            <p class=\\\"text-[10px] font-black text-slate-400 uppercase mb-1\\\">Décision</p>\\n                            <p class=\\\"font-black text-green-600\\\">ADMIS(E)</p>\\n                        </div>\\n                    </div>\\n\\n                    <div class=\\\"space-y-4\\\">\\n                        <button class=\\\"w-full bg-slate-900 text-white font-black py-6 rounded-[2rem] shadow-xl hover:bg-black transition-all flex items-center justify-center gap-3\\\">\\n                            <span>Télécharger mon Diplôme PDF</span>\\n                            <svg class=\\\"w-5 h-5\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\"><path d=\\\"M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z\\\" stroke-width=\\\"2\\\"></path></svg>\\n                        </button>\\n                        <button @click=\\\"step = 'payment'; phone = ''\\\" class=\\\"w-full text-slate-400 font-black text-[10px] uppercase tracking-widest py-4 hover:text-blue-600 transition\\\">Effectuer un autre paiement</button>\\n                    </div>\\n                </div>\\n            </div>\\n        </div>\\n    </template>\\n\\n    \\n</body>\\n</html>\" }} />\n  );\n}\n",
      "type": "registry:ui"
    }
  ],
