    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Logo Grid</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        body {\n            font-family: 'Inter', sans-serif;\n        }\n        .logo-container {\n            filter: grayscale(100%);\n            opacity: 0.7;\n            transition: all 0.3s ease;\n        }\n        .logo-container:hover {\n            filter: grayscale(0%);\n            opacity: 1;\n        }\n    </style>\n</head>\n<body class=\"bg-[#f9f9f9] font-sans\">\n    <section class=\"py-16 px-4 sm:px-6 lg:px-8\">\n        <div class=\"max-w-7xl mx-auto\">\n            <!-- Header Section -->\n            <div class=\"text-center mb-12\">\n                <h2 class=\"text-3xl font-semibold text-gray-900 mb-4\">Trusted by Industry Leaders</h2>\n                <p class=\"text-lg text-gray-600 max-w-2xl mx-auto\">We're proud to partner with innovative companies across various industries to deliver exceptional results.</p>\n            </div>\n\n            <!-- Logo Grid -->\n            <div class=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 md:gap-6\">\n                <!-- Apple Logo -->\n                <div class=\"bg-white border border-gray-300 p-4 flex items-center justify-center h-24 logo-container\">\n                    <img src=\"https://upload.wikimedia.org/wikipedia/commons/f/fa/Apple_logo_black.svg\" alt=\"Apple\" class=\"max-h-10\">\n                </div>\n                \n                <!-- Microsoft Logo -->\n                <div class=\"bg-white border border-gray-300 p-4 flex items-center justify-center h-24 logo-container\">\n                    <img src=\"https://upload.wikimedia.org/wikipedia/commons/9/96/Microsoft_logo_%282012%29.svg\" alt=\"Microsoft\" class=\"max-h-8\">\n                </div>\n                \n                <!-- Google Logo -->\n                <div class=\"bg-white border border-gray-300 p-4 flex items-center justify-center h-24 logo-container\">\n                    <img src=\"https://upload.wikimedia.org/wikipedia/commons/2/2f/Google_2015_logo.svg\" alt=\"Google\" class=\"max-h-10\">\n                </div>\n                \n                <!-- Amazon Logo -->\n                <div class=\"bg-white border border-gray-300 p-4 flex items-center justify-center h-24 logo-container\">\n                    <img src=\"https://upload.wikimedia.org/wikipedia/commons/a/a9/Amazon_logo.svg\" alt=\"Amazon\" class=\"max-h-8\">\n                </div>\n                \n                <!-- Facebook Logo -->\n                <div class=\"bg-white border border-gray-300 p-4 flex items-center justify-center h-24 logo-container\">\n                    <img src=\"https://upload.wikimedia.org/wikipedia/commons/5/51/Facebook_f_logo_%282019%29.svg\" alt=\"Facebook\" class=\"max-h-10\">\n                </div>\n                \n                <!-- Netflix Logo -->\n                <div class=\"bg-white border border-gray-300 p-4 flex items-center justify-center h-24 logo-container\">\n                    <img src=\"https://upload.wikimedia.org/wikipedia/commons/0/08/Netflix_2015_logo.svg\" alt=\"Netflix\" class=\"max-h-8\">\n                </div>\n            </div>\n            \n            <!-- Second Row of Logos -->\n            <div class=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 md:gap-6 mt-4 md:mt-6\">\n                <!-- Adobe Logo -->\n                <div class=\"bg-white border border-gray-300 p-4 flex items-center justify-center h-24 logo-container\">\n                    <img src=\"https://upload.wikimedia.org/wikipedia/commons/6/6e/Adobe_Corporate_logo.svg\" alt=\"Adobe\" class=\"max-h-8\">\n                </div>\n                \n                <!-- IBM Logo -->\n                <div class=\"bg-white border border-gray-300 p-4 flex items-center justify-center h-24 logo-container\">\n                    <img src=\"https://upload.wikimedia.org/wikipedia/commons/5/51/IBM_logo.svg\" alt=\"IBM\" class=\"max-h-6\">\n                </div>\n                \n                <!-- Intel Logo -->\n                <div class=\"bg-white border border-gray-300 p-4 flex items-center justify-center h-24 logo-container\">\n                    <img src=\"https://upload.wikimedia.org/wikipedia/commons/7/7d/Intel_logo_%282006-2020%29.svg\" alt=\"Intel\" class=\"max-h-8\">\n                </div>\n                \n                <!-- Tesla Logo -->\n                <div class=\"bg-white border border-gray-300 p-4 flex items-center justify-center h-24 logo-container\">\n                    <img src=\"https://upload.wikimedia.org/wikipedia/commons/b/bd/Tesla_Motors.svg\" alt=\"Tesla\" class=\"max-h-10\">\n                </div>\n                \n                <!-- Spotify Logo -->\n                <div class=\"bg-white border border-gray-300 p-4 flex items-center justify-center h-24 logo-container\">\n                    <img src=\"https://upload.wikimedia.org/wikipedia/commons/1/19/Spotify_logo_without_text.svg\" alt=\"Spotify\" class=\"max-h-10\">\n                </div>\n                \n                <!-- Airbnb Logo -->\n                <div class=\"bg-white border border-gray-300 p-4 flex items-center justify-center h-24 logo-container\">\n                    <img src=\"https://upload.wikimedia.org/wikipedia/commons/6/69/Airbnb_Logo_B%C3%A9lo.svg\" alt=\"Airbnb\" class=\"max-h-8\">\n                </div>\n            </div>\n            \n            <!-- CTA Section -->\n            <div class=\"text-center mt-12\">\n                <p class=\"text-gray-600 mb-6\">Want to join our growing list of partners?</p>\n                <a href=\"#\" class=\"inline-block bg-gray-900 text-white px-6 py-3 border border-gray-900 font-medium hover:bg-gray-800 transition-colors duration-300\">\n                    Become a Partner\n                </a>\n            </div>\n        </div>\n    </section>\n</body>\n</html>"
