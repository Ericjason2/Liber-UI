      "content": "/**\n * Component: Button group\n * Author: @team-tailwindflex (https://tailwindflex.com/@team-tailwindflex)\n * Source: https://tailwindflex.com/@team-tailwindflex/button-group\n * Attribution: Créé par @team-tailwindflex sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function ButtonGroup() {\n  return (\n    <div>\n    <div className=\"flex justify-center m-r-auto bg-violet-600\" id=\"buttons_container\">\n        <button className=\"text-gray-200 px-6 py-2 text-xl font-mono border-r-2 hover50\"\n           >\n            sm\n        </button>\n        <button className=\"text-gray-200 px-6 py-2 text-xl font-mono border-r-2 hover50\"\n           >\n            md\n        </button>\n        <button className=\"text-gray-200 px-6 py-2 text-xl font-mono border-r-2 hover50\"\n           >\n            lg\n        </button>\n        <button className=\"text-gray-200 px-6 py-2 text-xl font-mono hover50\"\n           >\n            xl\n        </button>\n    </div>\n    \n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
