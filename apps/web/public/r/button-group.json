    "mention": "Créé par @team-tailwindflex sur TailwindFlex",
    "rawHtml": "<div class=\"flex justify-center m-r-auto bg-violet-600\" id=\"buttons_container\">\n    <button class=\"text-gray-200 px-6 py-2 text-xl font-mono border-r-2 hover:text-slate-50\"\n        onclick=\"toggle(0)\">\n        sm\n    </button>\n    <button class=\"text-gray-200 px-6 py-2 text-xl font-mono border-r-2 hover:text-slate-50\"\n        onclick=\"toggle(1)\">\n        md\n    </button>\n    <button class=\"text-gray-200 px-6 py-2 text-xl font-mono border-r-2 hover:text-slate-50\"\n        onclick=\"toggle(2)\">\n        lg\n    </button>\n    <button class=\"text-gray-200 px-6 py-2 text-xl font-mono hover:text-slate-50\"\n        onclick=\"toggle(3)\">\n        xl\n    </button>\n</div>\n<script>\n    function toggle(index) {\n        var buttons = document.getElementById('buttons_container').children;\n        for (var i = 0; i < buttons.length; i++) {\n            buttons[i].classList.remove('text-white');\n            buttons[i].classList.remove('underline');\n        }\n        buttons[index].classList.add('text-white');\n        buttons[index].classList.add('underline');\n    }\n</script>"
  }
