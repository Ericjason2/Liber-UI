      "content": "/**\n * Component: Buttons\n * Author: @maximus (https://tailwindflex.com/@maximus)\n * Source: https://tailwindflex.com/@maximus/buttons\n * Attribution: Créé par @maximus sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function Buttons() {\n  return (\n    <div>\n    <div className=\"grid grid-cols-1 md5 gap-6\">\n                    \n                    <button className=\"bg-blue-600 text-white px-6 py-3 rounded-lg hover700 transition duration-300\">\n                        Primary Action\n                    </button>\n    \n                    \n                    <button className=\"bg-gradient-to-r from-pink-500 to-purple-600 text-white px-6 py-3 rounded-xl hover90 transition duration-300\">\n                        Get Started\n                    </button>\n    \n                    \n                    <button className=\"border-2 border-green-500 text-green-600 px-6 py-3 rounded-lg hover500 hover transition duration-300\">\n                        Learn More\n                    </button>\n    \n                    \n                    <button className=\"bg-gray-900 text-white px-6 py-3 rounded-lg flex items-center justify-center space-x-2 hover800 transition duration-300\">\n                        <i className=\"fas fa-moon mr-2\"></i>\n                        Dark Mode\n                    </button>\n    \n                    \n                    <button className=\"bg-red-500 text-white px-6 py-3 rounded-lg relative hover600 transition duration-300\">\n                        <span className=\"absolute -top-2 -right-2 bg-yellow-400 text-gray-900 text-xs rounded-full w-5 h-5 flex items-center justify-center\">5</span>\n                        Notifications\n                    </button>\n    \n                    \n                    <button className=\"bg-white text-gray-800 border border-gray-300 px-6 py-3 rounded-lg hover100 transition duration-300 shadow-md\">\n                        View Details\n                    </button>\n    \n                    \n                    <button className=\"bg-orange-500 text-white px-6 py-3 rounded-xl hover600 transition duration-300 transform hover105\">\n                        Take Action\n                    </button>\n    \n                    \n                    <button className=\"bg-purple-500 text-white px-6 py-3 rounded-lg hover600 transition duration-300 shadow-lg\">\n                        Explore Options\n                    </button>\n    \n                    \n                    <button className=\"bg-gradient-to-r from-teal-400 to-blue-500 text-white px-6 py-3 rounded-lg hover90 transition duration-300\">\n                        Connect Now\n                    </button>\n    \n                    \n                    <button className=\"border-2 border-red-500 text-red-600 px-6 py-3 rounded-lg hover500 hover transition duration-300\">\n                        Cancel Subscription\n                    </button>\n    \n                    \n                    <button className=\"bg-indigo-600 text-white px-6 py-3 rounded-lg flex items-center justify-center space-x-2 hover700 transition duration-300\">\n                        <i className=\"fas fa-rocket mr-2\"></i>\n                        Launch Project\n                    </button>\n    \n                    \n                    <button className=\"bg-gray-200 text-gray-800 px-6 py-3 rounded-lg hover300 transition duration-300\">\n                        Secondary Action\n                    </button>\n    \n                    \n                    <button className=\"bg-green-500 text-white px-6 py-3 rounded-lg hover600 transition duration-300\">\n                        Confirm\n                    </button>\n    \n                    \n                    <button className=\"bg-red-500 text-white px-6 py-3 rounded-lg hover600 transition duration-300\">\n                        Delete\n                    </button>\n    \n                    \n                    <button className=\"bg-blue-400 text-white px-6 py-3 rounded-xl hover500 transition duration-300\">\n                        Update\n                    </button>\n    \n                    \n                    <button className=\"bg-gradient-to-r from-yellow-500 to-orange-600 text-white px-6 py-3 rounded-lg hover90 transition duration-300\">\n                        Continue\n                    </button>\n    \n                    \n                    <button className=\"bg-green-500 text-white px-6 py-3 rounded-lg flex items-center justify-center space-x-2 hover600 transition duration-300\">\n                        Submit\n                        <i className=\"fas fa-arrow-right ml-2\"></i>\n                    </button>\n    \n                    \n                    <button className=\"text-gray-900 hover100 px-6 py-3 rounded-lg transition duration-300\">\n                        Simple Link\n                    </button>\n    \n                    \n                    <button className=\"bg-indigo-500 text-white px-6 py-3 rounded-lg relative overflow-hidden group\">\n                        <span className=\"absolute inset-0 bg-indigo-600 opacity-0 group-hover100 transition-opacity\"></span>\n                        <span className=\"relative z-10\">Hover Me</span>\n                    </button>\n    \n                    \n                    <button className=\"bg-white text-gray-800 px-6 py-3 rounded-xl shadow-md hover transition duration-300\">\n                        Soft Button\n                    </button>\n    \n                    <button className=\"bg-white bg-opacity-20 backdrop-blur-lg border border-white border-opacity-30 text-gray-800 px-6 py-3 rounded-xl hover40 transition duration-300\">\n                        Glassmorphism\n                    </button>\n    \n                    \n                    <button className=\"bg-purple-600 text-white px-6 py-3 rounded-lg animate-pulse hover shadow-lg hover500/50 transition duration-300\">\n                        Neon Button\n                    </button>\n    \n                    \n                    <button className=\"bg-teal-500 text-white px-6 py-3 rounded-lg hover6 transition duration-300\">\n                        Skew Hover\n                    </button>\n    \n                    \n                    <button className=\"border-4 border-transparent bg-gradient-to-r from-pink-500 to-purple-500 text-white px-6 py-3 rounded-lg bg-clip-padding hover600 hover600\">\n                        Gradient Border\n                    </button>\n    \n                    \n                    <button className=\"bg-gradient-to-br from-blue-400 to-purple-500 text-white px-6 py-3 rounded-xl hover90 transition duration-300\">\n                        Soft Gradient\n                    </button>\n    \n                    \n                    <button className=\"relative px-6 py-3 rounded-lg overflow-hidden group bg-white border-2 border-indigo-500 text-indigo-500 hover\">\n                        <span className=\"absolute inset-0 bg-indigo-500 transform -translate- group-hover0 transition duration-300\"></span>\n                        <span className=\"relative z-10 group-hover\">\n                            Animated Border\n                        </span>\n                    </button>\n    \n                    \n                    <button className=\"bg-blue-600 text-white px-6 py-3 rounded-lg flex items-center justify-center space-x-2 hover700 transition duration-300\">\n                        <i className=\"fab fa-facebook mr-2\"></i>\n                        Facebook\n                    </button>\n    \n                    \n                    <button className=\"bg-green-500 text-white px-6 py-3 rounded-lg animate-pulse hover transition duration-300\">\n                        Pulsating Button\n                    </button>\n    \n                    \n                    <button className=\"border-2 border-transparent bg-gradient-to-r from-green-400 to-blue-500 text-white px-6 py-3 rounded-lg bg-clip-padding hover500 hover600\">\n                        Outline Gradient\n                    </button>\n    \n                    \n                    <button className=\"bg-orange-500 text-white px-6 py-3 rounded-xl hover600 transition duration-300 shadow-md\">\n                        Soft Rounded\n                    </button>\n    \n                    \n                    <button className=\"bg-indigo-600 text-white px-6 py-3 rounded-lg transform transition duration-300 hover1 hover\">\n                        3D Hover Effect\n                    </button>\n    \n                    \n                    <button className=\"border border-gray-300 text-gray-700 px-6 py-3 rounded-lg hover100 transition duration-300\">\n                        Minimal Outline\n                    </button>\n    \n                    \n                    <button className=\"bg-gradient-to-r from-pink-500 via-red-500 to-yellow-500 text-white px-6 py-3 rounded-lg hover90 transition duration-300\">\n                        Vibrant Gradient\n                    </button>\n    \n                    \n                    <button className=\"bg-purple-500 text-white px-6 py-3 rounded-lg flex items-center justify-center hover600 transition duration-300\">\n                        <i className=\"fas fa-power-off mr-2\"></i>\n                        Toggle\n                    </button>\n    \n                    \n                    <button className=\"border border-blue-500 text-blue-600 px-6 py-3 rounded-lg hover500 hover transition duration-300 shadow-sm\">\n                        Soft Shadow\n                    </button>\n    \n                    \n                    <button className=\"bg-black text-green-400 px-6 py-3 rounded-sm border-2 border-green-400 hover400 hover transition duration-300 font-mono\">\n                        Cyberpunk\n                    </button>\n    \n                    \n                    <button className=\"border-2 border-transparent bg-gradient-to-r from-purple-500 to-pink-500 text-white px-6 py-3 rounded-full bg-clip-padding hover600 hover600 transition duration-300\">\n                        Gradient Outline\n                    </button>\n    \n                    \n                    <button className=\"bg-white text-gray-800 px-6 py-3 rounded-lg border border-gray-200 hover100 transition duration-300 shadow-sm\">\n                        Minimalist\n                    </button>\n    \n                    \n                    <button className=\"bg-red-500 text-white px-6 py-3 rounded-none hover600 transition duration-300 border-4 border-black font-pixel\">\n                        Pixel Style\n                    </button>\n    \n                    \n                    <button className=\"bg-blue-600 text-white px-6 py-3 rounded-xl relative overflow-hidden group\">\n                        <span className=\"absolute top-0 left-0 w-full h-full bg-white opacity-20 transform -skew-x-12 -translate- group-hover0 transition duration-500\"></span>\n                        <span className=\"relative z-10\">Liquid Hover</span>\n                    </button>\n    \n                    \n                    <button className=\"bg-green-600 text-white px-6 py-3 rounded-lg hover700 transition duration-300 flex items-center justify-center space-x-2\">\n                        <i className=\"fas fa-leaf mr-2\"></i>\n                        Eco Action\n                    </button>\n    \n                    \n                    <button className=\"bg-white bg-opacity-20 backdrop-blur-lg border border-white border-opacity-30 text-gray-900 px-6 py-3 rounded-xl hover40 transition duration-300\">\n                        Frosted Glass\n                    </button>\n    \n                    \n                    <button className=\"bg-gradient-to-br from-indigo-600 to-purple-600 text-white px-6 py-3 rounded-lg hover700 hover700 transition duration-300\">\n                        Duotone\n                    </button>\n    \n                    \n                    <button className=\"relative border-2 border-gray-800 text-gray-800 px-6 py-3 rounded-lg overflow-hidden group\">\n                        <span className=\"absolute inset-0 bg-gray-800 transform -translate- group-hover0 transition duration-300\"></span>\n                        <span className=\"relative z-10 group-hover\">\n                            Outline Shift\n                        </span>\n                    </button>\n    \n                    \n                    <button className=\"bg-pink-300 text-white px-6 py-3 rounded-xl hover400 transition duration-300 shadow-md\">\n                        Pastel Soft\n                    </button>\n    \n                    \n                    <button className=\"bg-blue-500 text-white px-6 py-3 rounded-lg hover600 transition duration-300 shadow-xl hover500/50\">\n                        Tech Glow\n                    </button>\n    \n                    \n                    <button className=\"border-2 border-transparent bg-gradient-to-r from-green-400 to-blue-500 text-white px-6 py-3 rounded-lg bg-clip-padding hover500 hover600\">\n                        Gradient Line\n                    </button>\n    \n                    \n                    <button className=\"bg-gray-900 text-white px-6 py-3 rounded-lg hover800 transition duration-300 border-2 border-gray-700\">\n                        Cosmic Dark\n                    </button>\n    \n                    \n                    <button className=\"bg-yellow-400 text-gray-900 px-6 py-3 rounded-full hover500 transition duration-300 transform hover105 shadow-lg\">\n                        Creative Touch\n                    </button>\n                </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
