    "rawHtml": "<div class=\"grid grid-cols-1 md:grid-cols-5 gap-6\">\n                <!-- 1. Classic Blue Primary -->\n                <button class=\"bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition duration-300\">\n                    Primary Action\n                </button>\n\n                <!-- 2. Gradient Vibrant -->\n                <button class=\"bg-gradient-to-r from-pink-500 to-purple-600 text-white px-6 py-3 rounded-xl hover:opacity-90 transition duration-300\">\n                    Get Started\n                </button>\n\n                <!-- 3. Soft Green Outline -->\n                <button class=\"border-2 border-green-500 text-green-600 px-6 py-3 rounded-lg hover:bg-green-500 hover:text-white transition duration-300\">\n                    Learn More\n                </button>\n\n                <!-- 4. Dark Mode Toggle -->\n                <button class=\"bg-gray-900 text-white px-6 py-3 rounded-lg flex items-center justify-center space-x-2 hover:bg-gray-800 transition duration-300\">\n                    <i class=\"fas fa-moon mr-2\"></i>\n                    Dark Mode\n                </button>\n\n                <!-- 5. Animated Notification -->\n                <button class=\"bg-red-500 text-white px-6 py-3 rounded-lg relative hover:bg-red-600 transition duration-300\">\n                    <span class=\"absolute -top-2 -right-2 bg-yellow-400 text-gray-900 text-xs rounded-full w-5 h-5 flex items-center justify-center\">5</span>\n                    Notifications\n                </button>\n\n                <!-- 6. Elegant White -->\n                <button class=\"bg-white text-gray-800 border border-gray-300 px-6 py-3 rounded-lg hover:bg-gray-100 transition duration-300 shadow-md\">\n                    View Details\n                </button>\n\n                <!-- 7. Vibrant Orange -->\n                <button class=\"bg-orange-500 text-white px-6 py-3 rounded-xl hover:bg-orange-600 transition duration-300 transform hover:scale-105\">\n                    Take Action\n                </button>\n\n                <!-- 8. Soft Purple -->\n                <button class=\"bg-purple-500 text-white px-6 py-3 rounded-lg hover:bg-purple-600 transition duration-300 shadow-lg\">\n                    Explore Options\n                </button>\n\n                <!-- 9. Teal Gradient -->\n                <button class=\"bg-gradient-to-r from-teal-400 to-blue-500 text-white px-6 py-3 rounded-lg hover:opacity-90 transition duration-300\">\n                    Connect Now\n                </button>\n\n                <!-- 10. Outline Red -->\n                <button class=\"border-2 border-red-500 text-red-600 px-6 py-3 rounded-lg hover:bg-red-500 hover:text-white transition duration-300\">\n                    Cancel Subscription\n                </button>\n\n                <!-- 11. Icon Left -->\n                <button class=\"bg-indigo-600 text-white px-6 py-3 rounded-lg flex items-center justify-center space-x-2 hover:bg-indigo-700 transition duration-300\">\n                    <i class=\"fas fa-rocket mr-2\"></i>\n                    Launch Project\n                </button>\n\n                <!-- 12. Subtle Gray -->\n                <button class=\"bg-gray-200 text-gray-800 px-6 py-3 rounded-lg hover:bg-gray-300 transition duration-300\">\n                    Secondary Action\n                </button>\n\n                <!-- 13. Green Success -->\n                <button class=\"bg-green-500 text-white px-6 py-3 rounded-lg hover:bg-green-600 transition duration-300\">\n                    Confirm\n                </button>\n\n                <!-- 14. Red Danger -->\n                <button class=\"bg-red-500 text-white px-6 py-3 rounded-lg hover:bg-red-600 transition duration-300\">\n                    Delete\n                </button>\n\n                <!-- 15. Soft Blue -->\n                <button class=\"bg-blue-400 text-white px-6 py-3 rounded-xl hover:bg-blue-500 transition duration-300\">\n                    Update\n                </button>\n\n                <!-- 16. Gradient Sunset -->\n                <button class=\"bg-gradient-to-r from-yellow-500 to-orange-600 text-white px-6 py-3 rounded-lg hover:opacity-90 transition duration-300\">\n                    Continue\n                </button>\n\n                <!-- 17. Icon Right -->\n                <button class=\"bg-green-500 text-white px-6 py-3 rounded-lg flex items-center justify-center space-x-2 hover:bg-green-600 transition duration-300\">\n                    Submit\n                    <i class=\"fas fa-arrow-right ml-2\"></i>\n                </button>\n\n                <!-- 18. Minimal Black -->\n                <button class=\"text-gray-900 hover:bg-gray-100 px-6 py-3 rounded-lg transition duration-300\">\n                    Simple Link\n                </button>\n\n                <!-- 19. Animated Hover -->\n                <button class=\"bg-indigo-500 text-white px-6 py-3 rounded-lg relative overflow-hidden group\">\n                    <span class=\"absolute inset-0 bg-indigo-600 opacity-0 group-hover:opacity-100 transition-opacity\"></span>\n                    <span class=\"relative z-10\">Hover Me</span>\n                </button>\n\n                <!-- 20. Soft Shadow -->\n                <button class=\"bg-white text-gray-800 px-6 py-3 rounded-xl shadow-md hover:shadow-lg transition duration-300\">\n                    Soft Button\n                </button>\n\n                <button class=\"bg-white bg-opacity-20 backdrop-blur-lg border border-white border-opacity-30 text-gray-800 px-6 py-3 rounded-xl hover:bg-opacity-40 transition duration-300\">\n                    Glassmorphism\n                </button>\n\n                <!-- 22. Neon Effect -->\n                <button class=\"bg-purple-600 text-white px-6 py-3 rounded-lg animate-pulse hover:animate-none shadow-lg hover:shadow-purple-500/50 transition duration-300\">\n                    Neon Button\n                </button>\n\n                <!-- 23. Skew Hover -->\n                <button class=\"bg-teal-500 text-white px-6 py-3 rounded-lg hover:skew-x-6 transition duration-300\">\n                    Skew Hover\n                </button>\n\n                <!-- 24. Gradient Border -->\n                <button class=\"border-4 border-transparent bg-gradient-to-r from-pink-500 to-purple-500 text-white px-6 py-3 rounded-lg bg-clip-padding hover:from-pink-600 hover:to-purple-600\">\n                    Gradient Border\n                </button>\n\n                <!-- 25. Soft Gradient -->\n                <button class=\"bg-gradient-to-br from-blue-400 to-purple-500 text-white px-6 py-3 rounded-xl hover:opacity-90 transition duration-300\">\n                    Soft Gradient\n                </button>\n\n                <!-- 26. Animated Border -->\n                <button class=\"relative px-6 py-3 rounded-lg overflow-hidden group bg-white border-2 border-indigo-500 text-indigo-500 hover:text-white\">\n                    <span class=\"absolute inset-0 bg-indigo-500 transform -translate-x-full group-hover:translate-x-0 transition duration-300\"></span>\n                    <span class=\"relative z-10 group-hover:text-white\">\n                        Animated Border\n                    </span>\n                </button>\n\n                <!-- 27. Social Media Button -->\n                <button class=\"bg-blue-600 text-white px-6 py-3 rounded-lg flex items-center justify-center space-x-2 hover:bg-blue-700 transition duration-300\">\n                    <i class=\"fab fa-facebook mr-2\"></i>\n                    Facebook\n                </button>\n\n                <!-- 28. Pulsating Button -->\n                <button class=\"bg-green-500 text-white px-6 py-3 rounded-lg animate-pulse hover:animate-none transition duration-300\">\n                    Pulsating Button\n                </button>\n\n                <!-- 29. Outline Gradient -->\n                <button class=\"border-2 border-transparent bg-gradient-to-r from-green-400 to-blue-500 text-white px-6 py-3 rounded-lg bg-clip-padding hover:from-green-500 hover:to-blue-600\">\n                    Outline Gradient\n                </button>\n\n                <!-- 30. Soft Rounded -->\n                <button class=\"bg-orange-500 text-white px-6 py-3 rounded-xl hover:bg-orange-600 transition duration-300 shadow-md\">\n                    Soft Rounded\n                </button>\n\n                <!-- 31. 3D Effect -->\n                <button class=\"bg-indigo-600 text-white px-6 py-3 rounded-lg transform transition duration-300 hover:-translate-y-1 hover:shadow-lg\">\n                    3D Hover Effect\n                </button>\n\n                <!-- 32. Minimal Outline -->\n                <button class=\"border border-gray-300 text-gray-700 px-6 py-3 rounded-lg hover:bg-gray-100 transition duration-300\">\n                    Minimal Outline\n                </button>\n\n                <!-- 33. Vibrant Gradient -->\n                <button class=\"bg-gradient-to-r from-pink-500 via-red-500 to-yellow-500 text-white px-6 py-3 rounded-lg hover:opacity-90 transition duration-300\">\n                    Vibrant Gradient\n                </button>\n\n                <!-- 34. Icon Toggle -->\n                <button class=\"bg-purple-500 text-white px-6 py-3 rounded-lg flex items-center justify-center hover:bg-purple-600 transition duration-300\">\n                    <i class=\"fas fa-power-off mr-2\"></i>\n                    Toggle\n                </button>\n\n                <!-- 35. Soft Shadow Outline -->\n                <button class=\"border border-blue-500 text-blue-600 px-6 py-3 rounded-lg hover:bg-blue-500 hover:text-white transition duration-300 shadow-sm\">\n                    Soft Shadow\n                </button>\n\n                <!-- 37. Cyberpunk Style -->\n                <button class=\"bg-black text-green-400 px-6 py-3 rounded-sm border-2 border-green-400 hover:bg-green-400 hover:text-black transition duration-300 font-mono\">\n                    Cyberpunk\n                </button>\n\n                <!-- 38. Soft Gradient Outline -->\n                <button class=\"border-2 border-transparent bg-gradient-to-r from-purple-500 to-pink-500 text-white px-6 py-3 rounded-full bg-clip-padding hover:from-purple-600 hover:to-pink-600 transition duration-300\">\n                    Gradient Outline\n                </button>\n\n                <!-- 39. Minimalist White -->\n                <button class=\"bg-white text-gray-800 px-6 py-3 rounded-lg border border-gray-200 hover:bg-gray-100 transition duration-300 shadow-sm\">\n                    Minimalist\n                </button>\n\n                <!-- 40. Retro Pixel -->\n                <button class=\"bg-red-500 text-white px-6 py-3 rounded-none hover:bg-red-600 transition duration-300 border-4 border-black font-pixel\">\n                    Pixel Style\n                </button>\n\n                <!-- 41. Liquid Hover -->\n                <button class=\"bg-blue-600 text-white px-6 py-3 rounded-xl relative overflow-hidden group\">\n                    <span class=\"absolute top-0 left-0 w-full h-full bg-white opacity-20 transform -skew-x-12 -translate-x-full group-hover:translate-x-0 transition duration-500\"></span>\n                    <span class=\"relative z-10\">Liquid Hover</span>\n                </button>\n\n                <!-- 42. Eco Green -->\n                <button class=\"bg-green-600 text-white px-6 py-3 rounded-lg hover:bg-green-700 transition duration-300 flex items-center justify-center space-x-2\">\n                    <i class=\"fas fa-leaf mr-2\"></i>\n                    Eco Action\n                </button>\n\n                <!-- 43. Frosted Glass -->\n                <button class=\"bg-white bg-opacity-20 backdrop-blur-lg border border-white border-opacity-30 text-gray-900 px-6 py-3 rounded-xl hover:bg-opacity-40 transition duration-300\">\n                    Frosted Glass\n                </button>\n\n                <!-- 44. Duotone Gradient -->\n                <button class=\"bg-gradient-to-br from-indigo-600 to-purple-600 text-white px-6 py-3 rounded-lg hover:from-indigo-700 hover:to-purple-700 transition duration-300\">\n                    Duotone\n                </button>\n\n                <!-- 45. Outline Shift -->\n                <button class=\"relative border-2 border-gray-800 text-gray-800 px-6 py-3 rounded-lg overflow-hidden group\">\n                    <span class=\"absolute inset-0 bg-gray-800 transform -translate-x-full group-hover:translate-x-0 transition duration-300\"></span>\n                    <span class=\"relative z-10 group-hover:text-white\">\n                        Outline Shift\n                    </span>\n                </button>\n\n                <!-- 46. Pastel Soft -->\n                <button class=\"bg-pink-300 text-white px-6 py-3 rounded-xl hover:bg-pink-400 transition duration-300 shadow-md\">\n                    Pastel Soft\n                </button>\n\n                <!-- 47. Tech Glow -->\n                <button class=\"bg-blue-500 text-white px-6 py-3 rounded-lg hover:bg-blue-600 transition duration-300 shadow-xl hover:shadow-blue-500/50\">\n                    Tech Glow\n                </button>\n\n                <!-- 48. Outline Gradient -->\n                <button class=\"border-2 border-transparent bg-gradient-to-r from-green-400 to-blue-500 text-white px-6 py-3 rounded-lg bg-clip-padding hover:from-green-500 hover:to-blue-600\">\n                    Gradient Line\n                </button>\n\n                <!-- 49. Cosmic Dark -->\n                <button class=\"bg-gray-900 text-white px-6 py-3 rounded-lg hover:bg-gray-800 transition duration-300 border-2 border-gray-700\">\n                    Cosmic Dark\n                </button>\n\n                <!-- 50. Final Creative -->\n                <button class=\"bg-yellow-400 text-gray-900 px-6 py-3 rounded-full hover:bg-yellow-500 transition duration-300 transform hover:scale-105 shadow-lg\">\n                    Creative Touch\n                </button>\n            </div>"
  }
}
