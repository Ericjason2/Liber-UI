      "content": "/**\n * Component: Pricing card\n * Author: @piet-vriend (https://tailwindflex.com/@piet-vriend)\n * Source: https://tailwindflex.com/@piet-vriend/pricing-card-9\n * Attribution: Créé par @piet-vriend sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function PricingCard9() {\n  return (\n    <div>\n    <div className=\"bg-white rounded-lg shadow-md overflow-hidden max-w-xs\">\n        <div className=\"bg-purple-500 px-6 py-8\">\n            <h3 className=\"text-lg font-medium text-white\">Starter Plan</h3>\n            <p className=\"text-gray-200 mt-2\">The perfect plan to get started</p>\n            <p className=\"text-gray-200 mt-2 text-2xl font-bold\">$9<span className=\"text-white text-base font-medium\">/month</span>\n            </p>\n        </div>\n        <div className=\"px-6 py-8\">\n            <ul className=\"text-gray-700 text-base leading-6\">\n                <li><span className=\"text-purple-500 font-medium mr-2\">&#10003;</span>Unlimited users</li>\n                <li><span className=\"text-purple-500 font-medium mr-2\">&#10003;</span>10GB storage</li>\n                <li><span className=\"text-purple-500 font-medium mr-2\">&#10003;</span>Email support</li>\n                <li><span className=\"text-purple-500 font-medium mr-2\">&#10003;</span>Basic analytics</li>\n            </ul>\n            <button className=\"mt-6 px-4 py-2 bg-purple-500 text-white font-medium rounded-full hover600 transition duration-200\">Sign up now</button>\n        </div>\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
