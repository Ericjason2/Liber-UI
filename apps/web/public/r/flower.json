    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Floral Elegance | Modern Hero Page</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n    <script>\n        tailwind.config = {\n            theme: {\n                extend: {\n                    animation: {\n                        'fade-in': 'fadeIn 1s ease-in-out',\n                        'float': 'float 8s infinite ease-in-out',\n                        'pulse-slow': 'pulse 4s infinite',\n                        'slide-up': 'slideUp 0.8s ease-out forwards',\n                    },\n                    keyframes: {\n                        fadeIn: {\n                            '0%': { opacity: '0' },\n                            '100%': { opacity: '1' },\n                        },\n                        float: {\n                            '0%, 100%': { transform: 'translateY(0)' },\n                            '50%': { transform: 'translateY(-15px)' },\n                        },\n                        slideUp: {\n                            '0%': { transform: 'translateY(30px)', opacity: '0' },\n                            '100%': { transform: 'translateY(0)', opacity: '1' },\n                        },\n                    },\n                    colors: {\n                        floral: {\n                            pink: '#F8C8DC',\n                            green: '#C1E1C1',\n                            peach: '#FFDAB9',\n                            lavender: '#E6E6FA',\n                        }\n                    }\n                }\n            }\n        }\n    </script>\n    <style type=\"text/tailwindcss\">\n        @layer utilities {\n            .text-shadow {\n                text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.2);\n            }\n            .delay-100 {\n                animation-delay: 100ms;\n            }\n            .delay-200 {\n                animation-delay: 200ms;\n            }\n            .delay-300 {\n                animation-delay: 300ms;\n            }\n            .delay-400 {\n                animation-delay: 400ms;\n            }\n        }\n    </style>\n</head>\n<body class=\"bg-white text-gray-800 overflow-x-hidden\">\n    <!-- Floral Background Elements -->\n    <div class=\"fixed inset-0 -z-10 overflow-hidden opacity-20\">\n        <div class=\"absolute w-64 h-64 rounded-full bg-floral-pink top-1/4 -left-16 animate-float\"></div>\n        <div class=\"absolute w-48 h-48 rounded-full bg-floral-green bottom-1/4 -right-12 animate-float delay-200\"></div>\n        <div class=\"absolute w-32 h-32 rounded-full bg-floral-peach top-1/3 right-1/4 animate-float delay-300\"></div>\n        <div class=\"absolute w-40 h-40 rounded-full bg-floral-lavender bottom-1/3 left-1/4 animate-float delay-400\"></div>\n    </div>\n    \n    <!-- Elegant Navbar -->\n    <nav class=\"fixed top-0 left-0 w-full py-5 px-6 md:px-12 z-50 bg-white/90 backdrop-blur-sm border-b border-gray-100\">\n        <div class=\"max-w-7xl mx-auto flex justify-between items-center\">\n            <div class=\"flex items-center\">\n                <span class=\"text-2xl font-serif font-bold text-gray-800\">Floral</span>\n                <span class=\"text-2xl font-serif font-bold text-floral-pink animate-pulse-slow\">.</span>\n            </div>\n            \n            <div class=\"hidden md:flex space-x-8\">\n                <a href=\"#\" class=\"relative group text-gray-600 hover:text-gray-900 transition-colors duration-300\">\n                    <span class=\"relative\">\n                        Home\n                        <span class=\"absolute bottom-0 left-0 w-0 h-px bg-floral-pink group-hover:w-full transition-all duration-300\"></span>\n                    </span>\n                </a>\n                <a href=\"#\" class=\"relative group text-gray-600 hover:text-gray-900 transition-colors duration-300\">\n                    <span class=\"relative\">\n                        Collections\n                        <span class=\"absolute bottom-0 left-0 w-0 h-px bg-floral-green group-hover:w-full transition-all duration-300\"></span>\n                    </span>\n                </a>\n                <a href=\"#\" class=\"relative group text-gray-600 hover:text-gray-900 transition-colors duration-300\">\n                    <span class=\"relative\">\n                        About\n                        <span class=\"absolute bottom-0 left-0 w-0 h-px bg-floral-peach group-hover:w-full transition-all duration-300\"></span>\n                    </span>\n                </a>\n                <a href=\"#\" class=\"relative group text-gray-600 hover:text-gray-900 transition-colors duration-300\">\n                    <span class=\"relative\">\n                        Contact\n                        <span class=\"absolute bottom-0 left-0 w-0 h-px bg-floral-lavender group-hover:w-full transition-all duration-300\"></span>\n                    </span>\n                </a>\n            </div>\n            \n            <div class=\"flex items-center space-x-4\">\n                <button class=\"hidden md:block px-4 py-2 text-gray-600 hover:text-gray-900 transition-colors\">\n                    <i class=\"fas fa-search\"></i>\n                </button>\n                <button class=\"px-4 py-2 bg-floral-pink text-white rounded-lg hover:bg-floral-pink/90 transition-all duration-300\">\n                    <i class=\"fas fa-shopping-bag mr-2\"></i> Shop\n                </button>\n                <button class=\"md:hidden flex flex-col space-y-1.5\">\n                    <span class=\"w-6 h-0.5 bg-gray-800\"></span>\n                    <span class=\"w-6 h-0.5 bg-gray-800\"></span>\n                    <span class=\"w-6 h-0.5 bg-gray-800\"></span>\n                </button>\n            </div>\n        </div>\n    </nav>\n    \n    <!-- Floral Hero Section -->\n    <section class=\"min-h-screen pt-24 pb-12 px-6 md:px-12 flex flex-col lg:flex-row items-center justify-center max-w-7xl mx-auto\">\n        <div class=\"lg:w-1/2 mb-12 lg:mb-0 lg:pr-12 animate-slide-up\">\n            <h1 class=\"text-4xl md:text-5xl lg:text-6xl font-serif font-bold leading-tight mb-6 text-gray-800\">\n                <span class=\"block\">Nature's</span>\n                <span class=\"block text-transparent bg-clip-text bg-gradient-to-r from-floral-pink to-floral-green\">Floral Elegance</span>\n                <span class=\"block\">In Every Petal</span>\n            </h1>\n            <p class=\"text-lg text-gray-600 mb-8 max-w-lg\">\n                Discover the perfect harmony of nature and design with our exquisite floral arrangements. Each bouquet tells a unique story of beauty and grace.\n            </p>\n            <div class=\"flex flex-col sm:flex-row space-y-4 sm:space-y-0 sm:space-x-4\">\n                <button class=\"px-8 py-3 bg-gradient-to-r from-floral-pink to-floral-green text-white rounded-lg hover:shadow-lg transition-all duration-300 transform hover:-translate-y-1 flex items-center justify-center\">\n                    Explore Collections\n                    <svg class=\"w-5 h-5 ml-2\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"></path>\n                    </svg>\n                </button>\n                <button class=\"px-8 py-3 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-all duration-300 flex items-center justify-center\">\n                    <i class=\"fas fa-play mr-2 text-floral-pink\"></i>\n                    Our Story\n                </button>\n            </div>\n            \n            <div class=\"mt-12 flex items-center space-x-8\">\n                <div class=\"flex flex-col\">\n                    <span class=\"text-3xl font-bold text-floral-pink\">250+</span>\n                    <span class=\"text-gray-600\">Floral Varieties</span>\n                </div>\n                <div class=\"flex flex-col\">\n                    <span class=\"text-3xl font-bold text-floral-green\">15</span>\n                    <span class=\"text-gray-600\">Years Experience</span>\n                </div>\n                <div class=\"flex flex-col\">\n                    <span class=\"text-3xl font-bold text-floral-peach\">5K+</span>\n                    <span class=\"text-gray-600\">Happy Clients</span>\n                </div>\n            </div>\n        </div>\n        \n        <div class=\"lg:w-1/2 relative animate-slide-up delay-200\">\n            <div class=\"relative rounded-2xl overflow-hidden shadow-xl transform rotate-1 hover:rotate-0 transition-transform duration-500\">\n                <!-- Floral image from Unsplash -->\n                <img class=\"w-full h-auto object-cover\" src=\"https://images.unsplash.com/photo-1578972497170-bfc780c65f65?w=600&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8NTZ8fGZsb3dlcnxlbnwwfHwwfHx8MA%3D%3D\" alt=\"Colorful bouquet of flowers\">\n                <div class=\"absolute inset-0 bg-gradient-to-t from-black/20 to-transparent\"></div>\n            </div>\n            \n            <!-- Floating Floral Elements -->\n            <div class=\"absolute -top-6 -left-6 bg-white p-3 rounded-lg shadow-md w-32 animate-slide-up delay-300\">\n                <div class=\"w-6 h-6 rounded-full bg-floral-pink/20 text-floral-pink flex items-center justify-center mb-1\">\n                    <i class=\"fas fa-leaf text-xs\"></i>\n                </div>\n                <h4 class=\"font-bold text-gray-800 text-sm\">Fresh Daily</h4>\n                <p class=\"text-xs text-gray-600\">Locally sourced</p>\n            </div>\n            \n            <div class=\"absolute -bottom-6 -right-6 bg-white p-3 rounded-lg shadow-md w-32 animate-slide-up delay-400\">\n                <div class=\"w-6 h-6 rounded-full bg-floral-green/20 text-floral-green flex items-center justify-center mb-1\">\n                    <i class=\"fas fa-truck text-xs\"></i>\n                </div>\n                <h4 class=\"font-bold text-gray-800 text-sm\">Free Delivery</h4>\n                <p class=\"text-xs text-gray-600\">On all orders</p>\n            </div>\n        </div>\n    </section>\n    \n    <!-- Floral Brands Section -->\n    <div class=\"py-12 px-6 md:px-12 max-w-7xl mx-auto bg-floral-lavender/20 rounded-3xl mb-16\">\n        <p class=\"text-center text-gray-600 mb-8\">Featured in</p>\n        <div class=\"flex flex-wrap justify-center gap-8 md:gap-16\">\n            <div class=\"text-xl font-serif italic text-gray-700\">Vogue</div>\n            <div class=\"text-xl font-serif italic text-gray-700\">Elle Decor</div>\n            <div class=\"text-xl font-serif italic text-gray-700\">Floral Times</div>\n            <div class=\"text-xl font-serif italic text-gray-700\">Bloom</div>\n            <div class=\"text-xl font-serif italic text-gray-700\">The Garden</div>\n        </div>\n    </div>\n\n    <script>\n        // Add scroll effect to navbar\n        window.addEventListener('scroll', function() {\n            const navbar = document.querySelector('nav');\n            if (window.scrollY > 50) {\n                navbar.classList.add('shadow-sm');\n                navbar.classList.remove('bg-white/90');\n                navbar.classList.add('bg-white/95');\n            } else {\n                navbar.classList.remove('shadow-sm');\n                navbar.classList.add('bg-white/90');\n                navbar.classList.remove('bg-white/95');\n            }\n        });\n\n        // Simple animation trigger\n        document.addEventListener('DOMContentLoaded', () => {\n            const elements = document.querySelectorAll('.animate-slide-up');\n            elements.forEach((el, index) => {\n                el.style.animationDelay = `${index * 100}ms`;\n            });\n        });\n    </script>\n</body>\n</html>"
  }
