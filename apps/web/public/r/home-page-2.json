Выбрать требу</a></button>\n                                <button className=\"ml-4 inline-flex border-b py-2 px-6 focus text-lg transform motion-safe110 bg-sky-700 text-white font-medium rounded-lg\n                                hover950 transition duration-700 ease-in-out\">Пожертвовать</button>\n                            </div>\n                        </div>\n                        <div className=\"lg lg md1/2 w-5/6 shadow-2xl hover contrast-125 scale-100\">\n                            <img className=\"object-cover object-center rounded-2xl shadow-xl shadow-gray-400\" alt=\"hero\" src=\"/images/fon.jpg\" />\n                        </div>\n                    </div>\n                </div>\n            </section>\n    \n            <section className=\"text-gray-600 body-font\">\n                <div className=\"container px-5 mt-8 mx-auto\">\n                    <div className=\"flex flex-wrap sm4 -mx-4 -mb-10 -mt-4\">\n                            <div className=\"p-4 md1/3 sm0 mb-6\">\n                                <div className=\"w-full p-5 bg-blue-200 place-content-center text-sm rounded-2xl shadow-xl shadow-gray-400\">\n                                    <div className=\"text-centre\">\n                                        <span>23</span>\n                                        <span>ПН</span>\n                                    </div>\n                                    <span className=\"\">9:00</span>\n                                    <span>Часы</span>\n                                    <span className=\"\">9:30</span>\n                                    <span>Литургия</span>\n                                    <span className=\"\">11:00</span>\n                                    <span>Молебень</span>\n                                    <span>Вознесению Господню</span>\n                                </div>\n                            </div>\n                            <div className=\"p-4 md1/3 sm0 mb-6\">\n                  