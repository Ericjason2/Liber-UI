      "content": "/**\n * Component: Hero section for website\n * Author: @leon-bachmann (https://tailwindflex.com/@leon-bachmann)\n * Source: https://tailwindflex.com/@leon-bachmann/hero-section-for-website\n * Attribution: Créé par @leon-bachmann sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function HeroSectionForWebsite() {\n  return (\n    <div>\n    <div className=\"flex h-screen justify-center items-center dark800\">\n        <div className=\"text-center max-w-6xl mx-10\">\n            <p className=\"my-3 text-sm tracking-widest text-indigo-500 uppercase\">Fast &amp; SEO friendly</p>\n            <h1 className=\"my-3 text-3xl font-bold tracking-tight text-gray-800 md5xl dark100\">\n                Best Service\n                Offered Here\n            </h1>\n            <div>\n                <p className=\"max-w-2xl mx-auto my-2 text-base text-gray-500 md md dark400\">\n                    Introducing our latest service offering. Get started quickly and efficiently with our range of\n                    solutions.\n                    Designed to meet your needs using the latest technologies.\n                </p>\n            </div>\n            <div className=\"flex flex-col items-center justify-center gap-5 mt-6 md\"><a\n                    className=\"inline-block w-auto text-center min-w-[200px] px-6 py-4 text-white transition-all rounded-md shadow-xl sm bg-gradient-to-r from-blue-600 to-blue-500 hover dark900 shadow-blue-200 hover2xl hover400 hover \"\n                    href=\"\">Browse All Examples\n                </a>\n                <a className=\"inline-block w-auto text-center min-w-[200px] px-6 py-4 text-white transition-all bg-gray-700 dark dark800 rounded-md shadow-xl sm hover900 hover shadow-neutral-300 dark700 hover2xl hover400 hover\"\n                    href=\"\">Seach Examples\n                </a>\n            </div>\n        </div>\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
