    "rawHtml": "<div class=\"bg-white dark:bg-gray-800 flex justify-center items-center w-screen h-screen p-5\">\n    <ul class=\"list-disc text-lg px-6\">\n      <button class=\"relative px-8 py-4 font-bold text-white rounded-lg group overflow-hidden\">\n        <!-- Glowing background effect -->\n        <span class=\"absolute inset-0 w-full h-full bg-gradient-to-r from-cyan-500 to-blue-500 opacity-70 blur-xl group-hover:opacity-100 transition-opacity duration-300\"></span>\n        \n        <!-- Main button background -->\n        <span class=\"absolute inset-0 w-full h-full bg-gradient-to-r from-cyan-600 to-blue-600 opacity-90\"></span>\n        \n        <!-- Shine effect -->\n        <span class=\"absolute inset-0 w-1/4 h-full bg-white/20 skew-x-12 transform -translate-x-full group-hover:translate-x-[400%] transition-transform duration-1000\"></span>\n        \n        <!-- Button text -->\n        <span class=\"relative flex items-center gap-2\">\n            <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 10V3L4 14h7v7l9-11h-7z\"/>\n            </svg>\n            <span class=\"tracking-wider\">ACTIVATE</span>\n        </span>\n        \n        <!-- Border glow effect -->\n        <span class=\"absolute inset-0 w-full h-full border border-cyan-300/50 rounded-lg\"></span>\n    </button>\n    </ul>\n  </div>\n</div>"
