d-full\">\n                    <span className=\"material-symbols-outlined\">arrow_outward</span>\n                  </a>\n                </div>\n              </div>\n            </div>\n            <div className=\"content py-4 px-2.5\">\n              <h3 className=\"capitalize text-[clamp(1.5rem,1.3909rem+0.4364vw,1.8rem)]\">trust & co.</h3>\n              <p className=\"my-4 text-[#565656]\">Fill out the form and the algorithm will offer the right team of experts</p>\n              <ul className=\"flex flex-wrap gap-2\">\n                <li className=\"uppercase font-bold text-xs text-[#282828] bg-[#d3b19a] px-2 py-1 rounded\">branding</li>\n                <li className=\"uppercase font-bold text-xs text-[#282828] bg-[#70b3b1] px-2 py-1 rounded\">packaging</li>\n              </ul>\n            </div>\n          </div>\n          \n          \n          \n        </div>\n      </div>\n    </section>\n    </div>\n  );\n}\n",
