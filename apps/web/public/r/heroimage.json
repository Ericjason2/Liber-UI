s/service1.jpeg\\\" alt=\\\"Freight Transport\\\">\\n        <h3>Freight Transport</h3>\\n        <p>Reliable ground and air freight services.</p>\\n      </div>\\n      <div class=\\\"card\\\">\\n        <img src=\\\"images/service2.jpeg\\\" alt=\\\"Warehousing\\\">\\n        <h3>Warehousing</h3>\\n        <p>Secure and scalable warehouse solutions.</p>\\n      </div>\\n      <div class=\\\"card\\\">\\n        <img src=\\\"images/service3.jpg\\\" alt=\\\"Inventory Management\\\">\\n        <h3>Inventory Management</h3>\\n        <p>Track, manage, and restock with ease.</p>\\n      </div>\\n      <div class=\\\"card\\\">\\n        <img src=\\\"images/service4.jpg\\\" alt=\\\"Customs Clearance\\\">\\n        <h3>Customs Clearance</h3>\\n        <p>Fast and reliable customs handling.</p>\\n      </div>\\n      \\n\\n    </div>\\n  </section>\\n\\n  <!-- Testimonials Section -->\\n  <!-- Testimonials Section -->\\n<section id=\\\"testimonials\\\">\\n  <h2>What Our Clients Say</h2>\\n  <div class=\\\"testimonial\\\">\\n    <img src=\\\"images/avatar.jpg\\\" alt=\\\"Client 1\\\" class=\\\"client-avatar\\\">\\n    <p>\\\"Great experience with LogiTrans! Highly reliable and professional.\\\"</p>\\n    <button class=\\\"read-more\\\">Read More</button>\\n  </div>\\n  <div class=\\\"testimonial\\\">\\n    <img src=\\\"images/avatar2.jpg\\\" alt=\\\"Client 2\\\" class=\\\"client-avatar\\\">\\n    <p>\\\"On-time delivery and excellent support team!\\\"</p>\\n    <button class=\\\"read-more\\\">Read More</button>\\n  </div>\\n</section>\\n\\n\\n  <!-- Modal -->\\n  <div id=\\\"modal\\\" class=\\\"modal\\\">\\n    <div class=\\\"modal-content\\\">\\n      <span class=\\\"close\\\">&times;</span>\\n      <p id=\\\"modal-text\\\"></p>\\n    </div>\\n  </div>\\n\\n  <!-- Footer Section -->\\n  <footer id=\\\"footer\\\">\\n    <div class=\\\"contact\\\">\\n      <h3>Contact Us</h3>\\n      <p>Email: contact@logitrans.com</p>\\n      <p>Phone: +123-456-7890</p>\\n    </div>\\n    <form id=\\\"newsletter-form\\\">\\n      <label for=\\\"email\\\">Subscribe to our newsletter:</label>\\n      <input type=\\\"email\\\" id=\\\"email\\\" placeholder=\\\"Enter your email\\\" required>\\n      <button type=\\\"submit\\\">Submit</button>\\n    </form>\\n  </footer>\\n\\n  \\n</body>\\n</html>\" }} />\n  );\n}\n",
