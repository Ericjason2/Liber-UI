      "content": "import * as React from \"react\"\n\nfunction Heroimage({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"heroimage\"\n      className={className}\n      {...props}\n    >\n      \n        <div id=\"progress-bar\"></div>\n      \n        \n        <header>\n          <div className=\"logo\">\n            <svg viewBox=\"0 0 100 100\" id=\"logo\">\n              <circle cx=\"50\" cy=\"50\" r=\"40\" stroke=\"#4b2e2e\" strokeWidth=\"5\" fill=\"white\" />\n              <text x=\"50%\" y=\"55%\" dominantBaseline=\"middle\" textAnchor=\"middle\" fill=\"#4b2e2e\" font-size=\"20\">LT</text>\n            </svg>\n          </div>\n          <nav id=\"navbar\">\n            <ul>\n              <li><a href=\"#hero\">Home</a></li>\n              <li><a href=\"#services\">Services</a></li>\n              <li><a href=\"#testimonials\">Clients</a></li>\n              <li><a href=\"#footer\">Contact Us</a></li>\n              <li><a href=\"#about\">About</a></li>\n            </ul>\n            <div id=\"hamburger\">&#9776;</div>\n            \n          </nav>\n        </header>\n      \n        \n        <section id=\"hero\">\n          <h1>Efficient Logistics, Delivered</h1>\n          <button className=\"hero-btn\">Explore Us / Hire Us</button>\n        </section>\n      \n        \n        <section id=\"services\">\n          <h2>Our Services</h2>\n          <div className=\"service-cards\">\n            <div className=\"card\">\n              <img src=\"images/service1.jpeg\" alt=\"Freight Transport\" />\n              <h3>Freight Transport</h3>\n              <p>Reliable ground and air freight services.</p>\n            </div>\n            <div className=\"card\">\n              <img src=\"images/service2.jpeg\" alt=\"Warehousing\" />\n              <h3>Warehousing</h3>\n              <p>Secure and scalable warehouse solutions.</p>\n            </div>\n            <div className=\"card\">\n              <img src=\"images/service3.jpg\" alt=\"Inventory Management\" />\n              <h3>Inventory Management</h3>\n              <p>Track, manage, and restock with ease.</p>\n            </div>\n            <div className=\"card\">\n              <img src=\"images/service4.jpg\" alt=\"Customs Clearance\" />\n              <h3>Customs Clearance</h3>\n              <p>Fast and reliable customs handling.</p>\n            </div>\n            \n      \n          </div>\n        </section>\n      \n        \n        \n      <section id=\"testimonials\">\n        <h2>What Our Clients Say</h2>\n        <div className=\"testimonial\">\n          <img src=\"images/avatar.jpg\" alt=\"Client 1\" className=\"client-avatar\" />\n          <p>\"Great experience with LogiTrans! Highly reliable and professional.\"</p>\n          <button className=\"read-more\">Read More</button>\n        </div>\n        <div className=\"testimonial\">\n          <img src=\"images/avatar2.jpg\" alt=\"Client 2\" className=\"client-avatar\" />\n          <p>\"On-time delivery and excellent support team!\"</p>\n          <button className=\"read-more\">Read More</button>\n        </div>\n      </section>\n      \n      \n        \n        <div id=\"modal\" className=\"modal\">\n          <div className=\"modal-content\">\n            <span className=\"close\">&times;</span>\n            <p id=\"modal-text\"></p>\n          </div>\n        </div>\n      \n        \n        <footer id=\"footer\">\n          <div className=\"contact\">\n            <h3>Contact Us</h3>\n            <p>Email: contact@logitrans.com</p>\n            <p>Phone: +123-456-7890</p>\n          </div>\n          <form id=\"newsletter-form\">\n            <label htmlFor=\"email\">Subscribe to our newsletter:</label>\n            <input type=\"email\" id=\"email\" placeholder=\"Enter your email\" required />\n            <button type=\"submit\">Submit</button>\n          </form>\n        </footer>\n    </div>\n  )\n}\n\nexport { Heroimage }\n",
      "type": "registry:ui"
    }
  ],
  "meta": {
    "kind": "component",
    "tags": [
      "hero"
