en md md10 list-none\">\r\n                    <li>\r\n                        <a href=\"#\" className=\"text-base font-normal text-gray-500 list-none hover900\"\r\n                            target=\"\">Pricing</a>\r\n                    </li>\r\n                    <li>\r\n                        <a href=\"#\" className=\"text-base font-normal text-gray-500 list-none hover900\"\r\n                            target=\"\">Gallary\r\n                        </a>\r\n                    </li>\r\n                    <li>\r\n                        <a href=\"#\" className=\"text-base font-normal text-gray-500 list-none hover900\"\r\n                            target=\"_blank\">Blog\r\n                        </a>\r\n                    </li>\r\n                </div>\r\n                <div className=\"hidden md md md md md0 md0\">\r\n                    <div className=\"inline-flex rounded-full shadow\">\r\n                        <div href=\"#\"\r\n                            className=\"inline-flex items-center px-4 py-2 text-base text-gray-900 bg-white border border-transparent rounded-full cursor-pointer font-base hover50 \">\r\n                            Sign in\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </nav>\r\n        </div>\r\n    </div>\n    </div>\n  );\n}\n",
