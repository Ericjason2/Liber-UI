      "content": "/**\n * Component: Tailwind Sidebar Layout\n * Author: @oliver-hansen (https://tailwindflex.com/@oliver-hansen)\n * Source: https://tailwindflex.com/@oliver-hansen/tailwind-sidebar-layout\n * Attribution: Créé par @oliver-hansen sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function TailwindSidebarLayout() {\n  return (\n    <div>\n    <div className=\"flex h-screen bg-gray-100\">\r\n    \r\n        \r\n        <div className=\"hidden md flex-col w-64 bg-gray-800\">\r\n            <div className=\"flex items-center justify-center h-16 bg-gray-900\">\r\n                <span className=\"text-white font-bold uppercase\">Sidebar</span>\r\n            </div>\r\n            <div className=\"flex flex-col flex-1 overflow-y-auto\">\r\n                <nav className=\"flex-1 px-2 py-4 bg-gray-800\">\r\n                    <a href=\"#\" className=\"flex items-center px-4 py-2 text-gray-100 hover700\">\r\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"h-6 w-6 mr-2\" fill=\"none\" viewBox=\"0 0 24 24\"\r\n                            stroke=\"currentColor\">\r\n                            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\"\r\n                                d=\"M4 6h16M4 12h16M4 18h16\" />\r\n                        </svg>\r\n                        Dashboard\r\n                    </a>\r\n                    <a href=\"#\" className=\"flex items-center px-4 py-2 mt-2 text-gray-100 hover700\">\r\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"h-6 w-6 mr-2\" fill=\"none\" viewBox=\"0 0 24 24\"\r\n                            stroke=\"currentColor\">\r\n                            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\"\r\n                                d=\"M6 18L18 6M6 6l12 12\" />\r\n                        </svg>\r\n                        Messages\r\n                    </a>\r\n                    <a href=\"#\" className=\"flex items-center px-4 py-2 mt-2 text-gray-100 hover700\">\r\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"h-6 w-6 mr-2\" fill=\"none\" viewBox=\"0 0 24 24\"\r\n                            stroke=\"currentColor\">\r\n                            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\"\r\n                                d=\"M13 10V3L4 14h7v7l9-11h-7z\" />\r\n                        </svg>\r\n                        Settings\r\n                    </a>\r\n                </nav>\r\n            </div>\r\n        </div>\r\n    \r\n        \r\n        <div className=\"flex flex-col flex-1 overflow-y-auto\">\r\n            <div className=\"flex items-center justify-between h-16 bg-white border-b border-gray-200\">\r\n                <div className=\"flex items-center px-4\">\r\n                    <button className=\"text-gray-500 focus focus700\">\r\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"h-6 w-6\" fill=\"none\" viewBox=\"0 0 24 24\"\r\n                            stroke=\"currentColor\">\r\n                            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\"\r\n                                d=\"M4 6h16M4 12h16M4 18h16\" />\r\n                        </svg>\r\n                    </button>\r\n                    <input className=\"mx-4 w-full border rounded-md px-4 py-2\" type=\"text\" placeholder=\"Search\" />\r\n                </div>\r\n                <div className=\"flex items-center pr-4\">\r\n    \r\n                    <button\r\n                        className=\"flex items-center text-gray-500 hover700 focus focus700\">\r\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"h-6 w-6\" fill=\"none\" viewBox=\"0 0 24 24\"\r\n                            stroke=\"currentColor\">\r\n                            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\"\r\n                                d=\"M12 19l-7-7 7-7m5 14l7-7-7-7\" />\r\n                        </svg>\r\n                    </button>\r\n                </div>\r\n            </div>\r\n            <div className=\"p-4\">\r\n                <h1 className=\"text-2xl font-bold\">Welcome to my dashboard!</h1>\r\n                <p className=\"mt-2 text-gray-600\">This is an example dashboard using Tailwind CSS.</p>\r\n            </div>\r\n        </div>\r\n        \r\n    </div>\n    </div>\n  );\n}\n",
