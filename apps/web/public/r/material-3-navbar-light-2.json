      "content": "/**\n * Component: Material 3 NavBar [Light]\n * Author: @nickgirga (https://tailwindflex.com/@nickgirga)\n * Source: https://tailwindflex.com/@nickgirga/material-3-navbar-light-2\n * Attribution: Créé par @nickgirga sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function Material3NavbarLight2() {\n  return (\n    <div>\n    <head>\n        \n        <link href=\"https://fonts.googleapis.com/css2?family=Roboto@300;400;600;700&amp;display=swap\" rel=\"stylesheet\" />\n        \n        \n        <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" />\n    </head>\n    \n    <body data-theme=\"light\">\n        \n        <div className=\"flex flex-col items-center text-center my-32\">\n            <span id=\"fake-page-heading\" className=\"text-4xl\">Home Page</span>\n        </div>\n    \n        \n        <div className=\"navbar fixed bottom-0 z-1\">\n            \n            <div className=\"navbar-container\">\n    \n                \n                <button id=\"navbar-home\"\n                    className=\"navbar-item navbar-item-active\"\n                   >\n                    <div className=\"navbar-item-icon\">\n                        <span className=\"material-symbols-outlined !text-lg\">home</span>\n                    </div>\n                    Home\n                </button>\n                \n                \n                <button id=\"navbar-search\"\n                    className=\"navbar-item\"\n                   >\n                    <div className=\"navbar-item-icon\">\n                        <span className=\"material-symbols-outlined !text-lg\">search</span>\n                    </div>\n                    Search\n                </button>\n    \n                \n                <button id=\"navbar-library\"\n                    className=\"navbar-item\"\n                   >\n                    <div className=\"navbar-item-icon\">\n                        <span className=\"material-symbols-outlined !text-lg\">collections_bookmark</span>\n                    </div>\n                    Library\n                </button>\n    \n                \n                <button id=\"navbar-settings\"\n                    className=\"navbar-item\"\n                   >\n                    <div className=\"navbar-item-icon\">\n                        <span className=\"material-symbols-outlined !text-lg\">settings</span>\n                    </div>\n                    Settings\n                </button>\n    \n            </div>\n        </div>\n    </body>\n    \n    \n    \n    \n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
  ],
