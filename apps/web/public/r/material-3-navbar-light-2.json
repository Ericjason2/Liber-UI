    "rawHtml": "<head>\n    <!-- Roboto Font -->\n    <link href=\"https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;600;700&amp;display=swap\" rel=\"stylesheet\">\n    \n    <!-- Material Icons -->\n    <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\">\n</head>\n\n<body data-theme=\"light\">\n    <!-- Page Content (For demo purposes) -->\n    <div class=\"flex flex-col items-center text-center my-32\">\n        <span id=\"fake-page-heading\" class=\"text-4xl\">Home Page</span>\n    </div>\n\n    <!-- NavBar Background -->\n    <div class=\"navbar fixed bottom-0 z-1\">\n        <!-- NavBar Items Container -->\n        <div class=\"navbar-container\">\n\n            <!-- 'Home' NavBar Item -->\n            <button id=\"navbar-home\"\n                class=\"navbar-item navbar-item-active\"\n                onclick=\"window.fakePageChange('navbar-home','Home Page');\">\n                <div class=\"navbar-item-icon\">\n                    <span class=\"material-symbols-outlined !text-lg\">home</span>\n                </div>\n                Home\n            </button>\n            \n            <!-- 'Search' NavBar Item -->\n            <button id=\"navbar-search\"\n                class=\"navbar-item\"\n                onclick=\"window.fakePageChange('navbar-search','Search Page');\">\n                <div class=\"navbar-item-icon\">\n                    <span class=\"material-symbols-outlined !text-lg\">search</span>\n                </div>\n                Search\n            </button>\n\n            <!-- 'Library' NavBar Item -->\n            <button id=\"navbar-library\"\n                class=\"navbar-item\"\n                onclick=\"window.fakePageChange('navbar-library','Library Page');\">\n                <div class=\"navbar-item-icon\">\n                    <span class=\"material-symbols-outlined !text-lg\">collections_bookmark</span>\n                </div>\n                Library\n            </button>\n\n            <!-- 'Settings' NavBar Item -->\n            <button id=\"navbar-settings\"\n                class=\"navbar-item\"\n                onclick=\"window.fakePageChange('navbar-settings','Settings Page');\">\n                <div class=\"navbar-item-icon\">\n                    <span class=\"material-symbols-outlined !text-lg\">settings</span>\n                </div>\n                Settings\n            </button>\n\n        </div>\n    </div>\n</body>\n\n<!-- Below is For Demo Purposes -->\n<!-- Implement with framework of choice -->\n<script>\n    // Change the fake page (just a demo for the live preview)\n    window.fakePageChange = function(navbarItemId, fakePageHeadingText) {\n        // disable all navbar item indicators\n        const navbarItems = document.querySelectorAll('.navbar-item');\n        for (const item of navbarItems) {\n            if (item.classList.contains('navbar-item-active'))\n                item.classList.remove('navbar-item-active');\n        }\n\n        // enable specified navbar item\n        document.getElementById(navbarItemId).classList.add('navbar-item-active');\n\n        // change fake page heading\n        document.getElementById('fake-page-heading').innerHTML = fakePageHeadingText;\n    }\n</script>"
  }
