      "content": "import * as React from \"react\"\n\nfunction CardsUsersCard({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"cards-users-card\"\n      className={className}\n      {...props}\n    >\n      <style>{\"@keyframes fadeIn {\\n            from { opacity: 0; transform: translateY(-10px); }\\n            to { opacity: 1; transform: translateY(0); }\\n        }\\n        .animate-fade-in {\\n            animation: fadeIn 0.5s ease-out forwards;\\n        }\"}</style>\n      <div className=\"bg-white dark:bg-gray-800 rounded-xl shadow-2xl max-w-md w-full overflow-hidden transition-all duration-300 hover:shadow-3xl animate-fade-in\">\n              <div className=\"p-6\">\n                  <h2 className=\"text-2xl font-bold text-indigo-800 dark:text-white mb-4\">Team Members</h2>\n                  <div className=\"space-y-4\">\n                      <div className=\"flex items-center space-x-4 p-3 bg-indigo-50 dark:bg-gray-700 rounded-lg transition-all duration-300 hover:bg-indigo-100 dark:hover:bg-gray-600\">\n                          <img src=\"https://i.pravatar.cc/100?img=1\" alt=\"Sarah Johnson\" className=\"w-12 h-12 rounded-full border-2 border-indigo-800 dark:border-blue-900\" />\n                          <div>\n                              <h3 className=\"text-lg font-semibold text-indigo-800 dark:text-white\">Sarah Johnson</h3>\n                              <p className=\"text-sm text-gray-600 dark:text-gray-300\">Lead Designer</p>\n                          </div>\n                      </div>\n                      <div className=\"flex items-center space-x-4 p-3 bg-indigo-50 dark:bg-gray-700 rounded-lg transition-all duration-300 hover:bg-indigo-100 dark:hover:bg-gray-600\">\n                          <img src=\"https://i.pravatar.cc/100?img=2\" alt=\"Michael Chen\" className=\"w-12 h-12 rounded-full border-2 border-indigo-800 dark:border-blue-900\" />\n                          <div>\n                              <h3 className=\"text-lg font-semibold text-indigo-800 dark:text-white\">Michael Chen</h3>\n                              <p className=\"text-sm text-gray-600 dark:text-gray-300\">Senior Developer</p>\n                          </div>\n                      </div>\n                      <div className=\"flex items-center space-x-4 p-3 bg-indigo-50 dark:bg-gray-700 rounded-lg transition-all duration-300 hover:bg-indigo-100 dark:hover:bg-gray-600\">\n                          <img src=\"https://i.pravatar.cc/100?img=3\" alt=\"Emily Rodriguez\" className=\"w-12 h-12 rounded-full border-2 border-indigo-800 dark:border-blue-900\" />\n                          <div>\n                              <h3 className=\"text-lg font-semibold text-indigo-800 dark:text-white\">Emily Rodriguez</h3>\n                              <p className=\"text-sm text-gray-600 dark:text-gray-300\">Product Manager</p>\n                          </div>\n                      </div>\n                  </div>\n              </div>\n              <div className=\"px-6 py-4 bg-indigo-100 dark:bg-gray-700 flex justify-between items-center\">\n                  <span className=\"text-sm text-indigo-800 dark:text-gray-300\">3 team members</span>\n                  <button className=\"bg-indigo-800 text-white px-4 py-2 rounded-lg hover:bg-blue-900 transition-colors duration-300 focus:outline-none focus:ring-2 focus:ring-indigo-800 focus:ring-offset-2 dark:focus:ring-offset-gray-800\">\n                      Add Member\n                  </button>\n              </div>\n          </div>\n    </div>\n  )\n}\n\nexport { CardsUsersCard }\n",
      "type": "registry:ui"
    }
  ],
  "meta": {
    "kind": "component",
