ckdrop-blur-3xl backdrop-blur-3xl shadow-gray-900/50\\\">\\n    <div>\\n     <div class=\\\"flex flex-col justify-between gap-3\\\">\\n      <p class=\\\"text-xl font-medium tracking-tight text-white\\\"> Starter Pack </p>\\n      <p class=\\\"text-white\\\"> <span class=\\\"text-2xl tracking-tight\\\"> <span x-show=\\\"!annual\\\">$15</span> <span x-show=\\\"annual\\\" style=\\\"display: none;\\\">$8</span> </span> <span class=\\\"text-base font-medium\\\">\\n        /m\\n        <span x-show=\\\"annual\\\" style=\\\"display: none;\\\">\\n         (billed annually)\\n        </span> </span> </p>\\n     </div>\\n     <p class=\\\"mt-8 text-xs text-white/80\\\">This plan is ideal for individual users and hobbyists who are looking for essential functionalities to support their projects.</p>\\n     <ul class=\\\"flex flex-col order-last mt-8 text-sm text-white gap-y-3\\\">\\n      <li class=\\\"inline-flex items-center gap-2\\\"> <svg xmlns=\\\"http://www.w3.org/2000/svg\\\" class=\\\"icon icon-tabler icon-tabler-circle-check\\\" width=\\\"20\\\" height=\\\"20\\\" viewBox=\\\"0 0 24 24\\\" stroke-width=\\\"2\\\" stroke=\\\"currentColor\\\" fill=\\\"none\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\">\\n        <path stroke=\\\"none\\\" d=\\\"M0 0h24v24H0z\\\" fill=\\\"none\\\"></path>\\n        <path d=\\\"M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0\\\"></path>\\n        <path d=\\\"M9 12l2 2l4 -4\\\"></path>\\n       </svg> 5 mb/PDF </li>\\n      <li class=\\\"inline-flex items-center gap-2\\\"> <svg xmlns=\\\"http://www.w3.org/2000/svg\\\" class=\\\"icon icon-tabler icon-tabler-circle-check\\\" width=\\\"20\\\" height=\\\"20\\\" viewBox=\\\"0 0 24 24\\\" stroke-width=\\\"2\\\" stroke=\\\"currentColor\\\" fill=\\\"none\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\">\\n        <path stroke=\\\"none\\\" d=\\\"M0 0h24v24H0z\\\" fill=\\\"none\\\"></path>\\n        <path d=\\\"M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0\\\"></path>\\n        <