    "rawHtml": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n\n\n\n\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap');\n        body {\n            font-family: 'Inter', sans-serif;\n\n        }\n      \n        .card-background {\n            background-image: linear-gradient(to top, #0f172a 0%, #251e5e 30%, #5d487f 100%);\n            filter: grayscale(10%) contrast(120%);\n        }\n       \n        .neon-planet-effect {\n\n            position: relative;\n            z-index: 10;\n        }\n    </style>\n</head>\n<body class=\"flex items-center justify-center min-h-screen p-4 bg-neutral-950\">\n\n    <div class=\"w-full max-w-sm sm:max-w-md lg:max-w-lg xl:max-w-xl rounded-3xl shadow-2xl overflow-hidden\n                border border-gray-700/50 p-1 md:p-1.5 transform transition-all duration-300 hover:shadow-purple-500/30\">\n\n        <div class=\"card-background h-[700px] md:h-[800px] rounded-[1.2rem] md:rounded-2xl flex flex-col justify-between text-white p-6 md:p-8 relative\">\n\n            <div class=\"absolute inset-0 flex items-center justify-center opacity-80 pointer-events-none bg-[https://pbs.twimg.com/media/G5ZHCMKXQAAhdHo?format=jpg&name=4096x4096]\">\n\n            </div>\n\n            <header class=\"flex justify-between items-center relative z-20\">\n                <span class=\"text-sm font-semibold text-white/90\">rauatodev</span>\n                <button class=\"flex flex-col space-y-1 p-2\">\n                    <span class=\"w-5 h-0.5 bg-white/70 rounded-full\"></span>\n                    <span class=\"w-5 h-0.5 bg-white/70 rounded-full\"></span>\n                </button>\n            </header>\n\n            <main class=\"mt-8 md:mt-12 relative z-20\">\n                <p class=\"text-xs uppercase tracking-widest text-white/70 mb-2\">Worked with 100+ brands around the world</p>\n                <h1 class=\"text-3xl md:text-5xl font-extrabold mb-4 leading-tight shadow-text\" style=\"text-shadow: 0 0 10px rgba(255, 255, 255, 0.3);\">\n                    We build for the curious.\n                </h1>\n                <p class=\"text-sm md:text-base text-white/80 mb-6 max-w-md\">\n                    We're a tight knit team of marketers, designers and developers helping founders and startups secure funding and scale.\n                </p>\n                <button class=\"px-6 py-2 bg-white/10 text-white text-sm font-medium rounded-full border border-white/20\n                               hover:bg-white/20 transition duration-200\">\n                    Start a project\n                </button>\n            </main>\n\n            <!-- Contenido Inferior (Footer) -->\n            <footer class=\"flex justify-between items-end relative z-20 pt-16\">\n                <div class=\"flex space-x-8 md:space-x-12 text-xs md:text-sm text-white/80\">\n                    <!-- Columna de Servicios -->\n                    <div>\n                        <h3 class=\"font-bold text-white mb-2\">Services</h3>\n                        <ul class=\"space-y-1\">\n                            <li>Digital Design</li>\n                            <li>Art Direction</li>\n                            <li>Web Development</li>\n                        </ul>\n                    </div>\n                    <!-- Columna de Ubicación -->\n                    <div>\n                        <h3 class=\"font-bold text-white mb-2\">Location</h3>\n                        <ul class=\"space-y-1\">\n                            <li>rauatodev, Mexico</li>\n                            <li>Tuesday, 14:52</li>\n                            <li>(+52 9936719807)</li>\n                        </ul>\n                    </div>\n                    <!-- Columna de Redes Sociales -->\n                    <div>\n                        <h3 class=\"font-bold text-white mb-2\">Socials</h3>\n                        <ul class=\"space-y-1\">\n                            <li>Instagram</li>\n                            <li>X (Twitter)</li>\n                            <li>Youtube</li>\n                        </ul>\n                    </div>\n                </div>\n\n            </footer>\n        </div>\n    </div>\n\n</body>\n</html>"
