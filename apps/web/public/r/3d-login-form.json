      "content": "/**\n * Component: 3D Login form\n * Author: @sufyan-jutt (https://tailwindflex.com/@sufyan-jutt)\n * Source: https://tailwindflex.com/@sufyan-jutt/3d-login-form\n * Attribution: Créé par @sufyan-jutt sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function Comp3dLoginForm() {\n  return (\n    <div dangerouslySetInnerHTML={{ __html: \"<!DOCTYPE html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"UTF-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\">\\n  <title>3D Login Form</title>\\n  \\n  <style>\\n    body {\\n      perspective: 1200px;\\n    }\\n    .form-inner {\\n      transform-style: preserve-3d;\\n      transition: transform 0.3s ease;\\n    }\\n  </style>\\n</head>\\n<body class=\\\"bg-gradient-to-r from-purple-500 to-pink-500 flex items-center justify-center min-h-screen p-4\\\">\\n\\n  <div class=\\\"card w-full max-w-md bg-white rounded-3xl shadow-2xl overflow-hidden form-inner cursor-pointer\\\">\\n    <div class=\\\"p-8\\\">\\n      <h2 class=\\\"text-3xl font-bold text-gray-800 mb-6 text-center\\\">Login</h2>\\n      <form class=\\\"space-y-4\\\">\\n        <div>\\n          <label class=\\\"block text-gray-600 mb-1\\\">Email</label>\\n          <input type=\\\"email\\\" placeholder=\\\"example@mail.com\\\" class=\\\"w-full px-4 py-3 rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-purple-400 transition\\\"/>\\n        </div>\\n        <div>\\n          <label class=\\\"block text-gray-600 mb-1\\\">Password</label>\\n          <input type=\\\"password\\\" placeholder=\\\"********\\\" class=\\\"w-full px-4 py-3 rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-purple-400 transition\\\"/>\\n        </div>\\n        <button type=\\\"submit\\\" class=\\\"w-full py-3 rounded-xl bg-gradient-to-r from-purple-600 to-pink-500 text-white font-bold mt-4 transition-transform duration-300 hover:scale-105 hover:shadow-xl\\\">\\n          Login\\n        </button>\\n      </form>\\n      <p class=\\\"text-center text-gray-500 mt-4 text-sm\\\">Don't have an account? <a href=\\\"#\\\" class=\\\"text-purple-600 font-semibold hover:underline\\\">Sign Up</a></p>\\n    </div>\\n  </div>\\n\\n  <!-- ===== JS for 3D tilt ===== -->\\n  \\n\\n</body>\\n</html>\" }} />\n  );\n}\n",
