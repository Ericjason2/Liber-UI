      "content": "/**\n * Component: Material 3 Buttons [Light]\n * Author: @nickgirga (https://tailwindflex.com/@nickgirga)\n * Source: https://tailwindflex.com/@nickgirga/material-3-buttons-light\n * Attribution: Créé par @nickgirga sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function Material3ButtonsLight() {\n  return (\n    <div>\n    <head>\n        \n        <link href=\"https://fonts.googleapis.com/css2?family=Roboto@300;400;600;700&amp;display=swap\" rel=\"stylesheet\" />\n        \n        \n        <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" />\n    </head>\n    \n    \n    <body data-theme=\"pink-light\">\n        <div className=\"flex flex-col items-center gap-4 my-16 mb-32\">\n    \n            \n            <h1 className=\"text-xl\">Buttons</h1>\n            <div className=\"flex flex-col items-center gap-2\">\n    \n                \n                <div className=\"flex flex-row items-center gap-2\">\n    \n                    \n                    <button className=\"btn btn-elevated\">Elevated</button>\n    \n                    \n                    <button className=\"btn btn-elevated pl-4\">\n                        <span className=\"material-symbols-outlined\">add</span>\n                        Icon\n                    </button>\n    \n                    \n                    <button className=\"btn btn-elevated pl-4\" disabled>\n                        <span className=\"material-symbols-outlined\">add</span>\n                        Disabled\n                    </button>\n    \n                </div>\n    \n                \n                <div className=\"flex flex-row items-center gap-2\">\n    \n                    \n                    <button className=\"btn\">Filled</button>\n    \n                    \n                    <button className=\"btn pl-4\">\n                        <span className=\"material-symbols-outlined\">add</span>\n                        Icon\n                    </button>\n    \n                    \n                    <button className=\"btn pl-4\" disabled>\n                        <span className=\"material-symbols-outlined\">add</span>\n                        Disabled\n                    </button>\n    \n                </div>\n    \n                \n                <div className=\"flex flex-row items-center gap-2\">\n    \n                    \n                    <button className=\"btn btn-tonal\">Tonal</button>\n    \n                    \n                    <button className=\"btn btn-tonal pl-4\">\n                        <span className=\"material-symbols-outlined\">add</span>\n                        Icon\n                    </button>\n    \n                    \n                    <button className=\"btn btn-tonal pl-4\" disabled>\n                        <span className=\"material-symbols-outlined\">add</span>\n                        Disabled\n                    </button>\n    \n                </div>\n    \n                \n                <div className=\"flex flex-row items-center gap-2\">\n    \n                    \n                    <button className=\"btn btn-outlined\">Outlined</button>\n    \n                    \n                    <button className=\"btn btn-outlined pl-4\">\n                        <span className=\"material-symbols-outlined\">add</span>\n                        Icon\n                    </button>\n    \n                    \n                    <button className=\"btn btn-outlined pl-4\" disabled>\n                        <span className=\"material-symbols-outlined\">add</span>\n                        Disabled\n                    </button>\n    \n                </div>\n    \n                \n                <div className=\"flex flex-row items-center gap-2\">\n    \n                    \n                    <button className=\"btn btn-ghost\">Ghost</button>\n    \n                    \n                    <button className=\"btn btn-ghost pl-4\">\n                        <span className=\"material-symbols-outlined\">add</span>\n                        Icon\n                    </button>\n    \n                    \n                    <button className=\"btn btn-ghost pl-4\" disabled>\n                        <span className=\"material-symbols-outlined\">add</span>\n                        Disabled\n                    </button>\n    \n                </div>\n    \n            </div>\n    \n            \n            <h1 className=\"text-xl mt-4\">Icon Buttons</h1>\n            <div className=\"flex flex-row items-center gap-2\">\n    \n                \n                <button className=\"btn btn-elevated p-3\">\n                    <span className=\"material-symbols-outlined\">settings</span>\n                </button>\n    \n                \n                <button className=\"btn p-3\">\n                    <span className=\"material-symbols-outlined\">settings</span>\n                </button>\n    \n                \n                <button className=\"btn btn-tonal p-3\">\n                    <span className=\"material-symbols-outlined\">settings</span>\n                </button>\n    \n                \n                <button className=\"btn btn-outlined p-3\">\n                    <span className=\"material-symbols-outlined\">settings</span>\n                </button>\n    \n                \n                <button className=\"btn btn-ghost p-3\">\n                    <span className=\"material-symbols-outlined\">settings</span>\n                </button>\n    \n            </div>\n    \n            \n            <h1 className=\"text-xl mt-4\">Floating Action Buttons</h1>\n            <div className=\"flex flex-row items-center gap-2\">\n    \n                \n                <button className=\"fab fab-large\">\n                    <span className=\"material-symbols-outlined  !text-4xl\">edit</span>\n                </button>\n    \n                \n                <button className=\"fab\">\n                    <span className=\"material-symbols-outlined\">edit</span>\n                    Compose\n                </button>\n    \n                \n                <button className=\"fab\">\n                    <span className=\"material-symbols-outlined\">edit</span>\n                </button>\n    \n                \n                <button className=\"fab fab-small\">\n                    <span className=\"material-symbols-outlined  !text-base\">edit</span>\n                </button>\n                \n            </div>\n    \n            \n            <h1 className=\"text-xl mt-4\">Connected Toggle Buttons</h1>\n            <div className=\"flex flex-row items-center gap-2\">\n                \n                <div className=\"flex flex-row\">\n                    <label className=\"toggle-button-label\">\n                        <input type=\"checkbox\" className=\"peer toggle-button rounded-l-full\" />\n                        <span className=\"toggle-button-indicator material-symbols-outlined\">check</span>\n                        Option 1\n                    </label>\n                    <label className=\"toggle-button-label\">\n                        <input type=\"checkbox\" className=\"peer toggle-button\" />\n                        <span className=\"toggle-button-indicator material-symbols-outlined\">check</span>\n                        Option 2\n                    </label>\n                    <label className=\"toggle-button-label\">\n                        <input type=\"checkbox\" className=\"peer toggle-button rounded-r-full\" />\n                        <span className=\"toggle-button-indicator material-symbols-outlined\">check</span>\n                        Option 3\n                    </label>\n                </div>\n    \n            </div>\n    \n            \n            <h1 className=\"text-xl mt-4\">Connected Radio Buttons</h1>\n            <div className=\"flex flex-row items-center gap-2\">\n                \n                <div className=\"flex flex-row\">\n                    <label className=\"toggle-button-label\">\n                        <input type=\"radio\" name=\"radio-group-0\" checked className=\"peer toggle-button rounded-l-full\" />\n                        <span className=\"toggle-button-indicator material-symbols-outlined\">check</span>\n                        Option 1\n                    </label>\n                    <label className=\"toggle-button-label\">\n                        <input type=\"radio\" name=\"radio-group-0\" className=\"peer toggle-button\" />\n                        <span className=\"toggle-button-indicator material-symbols-outlined\">check</span>\n                        Option 2\n                    </label>\n                    <label className=\"toggle-button-label\">\n                        <input type=\"radio\" name=\"radio-group-0\" className=\"peer toggle-button rounded-r-full\" />\n                        <span className=\"toggle-button-indicator material-symbols-outlined\">check</span>\n                        Option 3\n                    </label>\n                </div>\n    \n            </div>\n    \n        </div>\n    </body>\n    </div>\n  );\n}\n",
