    "rawHtml": "<head>\n    <!-- Roboto Font -->\n    <link href=\"https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;600;700&amp;display=swap\" rel=\"stylesheet\">\n    \n    <!-- Material Icons -->\n    <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\">\n</head>\n\n\n<body data-theme=\"pink-light\">\n    <div class=\"flex flex-col items-center gap-4 my-16 mb-32\">\n\n        <!-- Buttons -->\n        <h1 class=\"text-xl\">Buttons</h1>\n        <div class=\"flex flex-col items-center gap-2\">\n\n            <!-- Elevated Buttons -->\n            <div class=\"flex flex-row items-center gap-2\">\n\n                <!-- Elevated Button -->\n                <button class=\"btn btn-elevated\">Elevated</button>\n\n                <!-- Elevated Icon Button -->\n                <button class=\"btn btn-elevated pl-4\">\n                    <span class=\"material-symbols-outlined\">add</span>\n                    Icon\n                </button>\n\n                <!-- Disabled Elevated Icon Button -->\n                <button class=\"btn btn-elevated pl-4\" disabled>\n                    <span class=\"material-symbols-outlined\">add</span>\n                    Disabled\n                </button>\n\n            </div>\n\n            <!-- Filled (Default) Buttons -->\n            <div class=\"flex flex-row items-center gap-2\">\n\n                <!-- Filled (Default) Button -->\n                <button class=\"btn\">Filled</button>\n\n                <!-- Filled (Default) Icon Button -->\n                <button class=\"btn pl-4\">\n                    <span class=\"material-symbols-outlined\">add</span>\n                    Icon\n                </button>\n\n                <!-- Disabled Filled (Default) Icon Button -->\n                <button class=\"btn pl-4\" disabled>\n                    <span class=\"material-symbols-outlined\">add</span>\n                    Disabled\n                </button>\n\n            </div>\n\n            <!-- Tonal Buttons -->\n            <div class=\"flex flex-row items-center gap-2\">\n\n                <!-- Tonal Button -->\n                <button class=\"btn btn-tonal\">Tonal</button>\n\n                <!-- Tonal Icon Button -->\n                <button class=\"btn btn-tonal pl-4\">\n                    <span class=\"material-symbols-outlined\">add</span>\n                    Icon\n                </button>\n\n                <!-- Disabled Tonal Icon Button -->\n                <button class=\"btn btn-tonal pl-4\" disabled>\n                    <span class=\"material-symbols-outlined\">add</span>\n                    Disabled\n                </button>\n\n            </div>\n\n            <!-- Outlined Buttons -->\n            <div class=\"flex flex-row items-center gap-2\">\n\n                <!-- Outlined Buttons -->\n                <button class=\"btn btn-outlined\">Outlined</button>\n\n                <!-- Outlined Icon Button -->\n                <button class=\"btn btn-outlined pl-4\">\n                    <span class=\"material-symbols-outlined\">add</span>\n                    Icon\n                </button>\n\n                <!-- Disabled Outlined Icon Button -->\n                <button class=\"btn btn-outlined pl-4\" disabled>\n                    <span class=\"material-symbols-outlined\">add</span>\n                    Disabled\n                </button>\n\n            </div>\n\n            <!-- Ghost Buttons -->\n            <div class=\"flex flex-row items-center gap-2\">\n\n                <!-- Ghost Button -->\n                <button class=\"btn btn-ghost\">Ghost</button>\n\n                <!-- Ghost Icon Button -->\n                <button class=\"btn btn-ghost pl-4\">\n                    <span class=\"material-symbols-outlined\">add</span>\n                    Icon\n                </button>\n\n                <!-- Disabled Ghost Icon Button -->\n                <button class=\"btn btn-ghost pl-4\" disabled>\n                    <span class=\"material-symbols-outlined\">add</span>\n                    Disabled\n                </button>\n\n            </div>\n\n        </div>\n\n        <!-- Icon-only Buttons -->\n        <h1 class=\"text-xl mt-4\">Icon Buttons</h1>\n        <div class=\"flex flex-row items-center gap-2\">\n\n            <!-- Elevated Icon-only Button -->\n            <button class=\"btn btn-elevated p-3\">\n                <span class=\"material-symbols-outlined\">settings</span>\n            </button>\n\n            <!-- Filled (Default) Icon-only Button -->\n            <button class=\"btn p-3\">\n                <span class=\"material-symbols-outlined\">settings</span>\n            </button>\n\n            <!-- Tonal Icon-only Button -->\n            <button class=\"btn btn-tonal p-3\">\n                <span class=\"material-symbols-outlined\">settings</span>\n            </button>\n\n            <!-- Outlined Icon-only Button -->\n            <button class=\"btn btn-outlined p-3\">\n                <span class=\"material-symbols-outlined\">settings</span>\n            </button>\n\n            <!-- Ghost Icon-only Button -->\n            <button class=\"btn btn-ghost p-3\">\n                <span class=\"material-symbols-outlined\">settings</span>\n            </button>\n\n        </div>\n\n        <!-- Floating Action Buttons | FABs -->\n        <h1 class=\"text-xl mt-4\">Floating Action Buttons</h1>\n        <div class=\"flex flex-row items-center gap-2\">\n\n            <!-- Large FAB -->\n            <button class=\"fab fab-large\">\n                <span class=\"material-symbols-outlined  !text-4xl\">edit</span>\n            </button>\n\n            <!-- FAB with Text -->\n            <button class=\"fab\">\n                <span class=\"material-symbols-outlined\">edit</span>\n                Compose\n            </button>\n\n            <!-- Standard FAB -->\n            <button class=\"fab\">\n                <span class=\"material-symbols-outlined\">edit</span>\n            </button>\n\n            <!-- Small FAB -->\n            <button class=\"fab fab-small\">\n                <span class=\"material-symbols-outlined  !text-base\">edit</span>\n            </button>\n            \n        </div>\n\n        <!-- Connected Toggle Buttons -->\n        <h1 class=\"text-xl mt-4\">Connected Toggle Buttons</h1>\n        <div class=\"flex flex-row items-center gap-2\">\n            \n            <div class=\"flex flex-row\">\n                <label class=\"toggle-button-label\">\n                    <input type=\"checkbox\" class=\"peer toggle-button rounded-l-full\" />\n                    <span class=\"toggle-button-indicator material-symbols-outlined\">check</span>\n                    Option 1\n                </label>\n                <label class=\"toggle-button-label\">\n                    <input type=\"checkbox\" class=\"peer toggle-button\" />\n                    <span class=\"toggle-button-indicator material-symbols-outlined\">check</span>\n                    Option 2\n                </label>\n                <label class=\"toggle-button-label\">\n                    <input type=\"checkbox\" class=\"peer toggle-button rounded-r-full\" />\n                    <span class=\"toggle-button-indicator material-symbols-outlined\">check</span>\n                    Option 3\n                </label>\n            </div>\n\n        </div>\n\n        <!-- Connected Radio Buttons -->\n        <h1 class=\"text-xl mt-4\">Connected Radio Buttons</h1>\n        <div class=\"flex flex-row items-center gap-2\">\n            \n            <div class=\"flex flex-row\">\n                <label class=\"toggle-button-label\">\n                    <input type=\"radio\" name=\"radio-group-0\" checked class=\"peer toggle-button rounded-l-full\" />\n                    <span class=\"toggle-button-indicator material-symbols-outlined\">check</span>\n                    Option 1\n                </label>\n                <label class=\"toggle-button-label\">\n                    <input type=\"radio\" name=\"radio-group-0\" class=\"peer toggle-button\" />\n                    <span class=\"toggle-button-indicator material-symbols-outlined\">check</span>\n                    Option 2\n                </label>\n                <label class=\"toggle-button-label\">\n                    <input type=\"radio\" name=\"radio-group-0\" class=\"peer toggle-button rounded-r-full\" />\n                    <span class=\"toggle-button-indicator material-symbols-outlined\">check</span>\n                    Option 3\n                </label>\n            </div>\n\n        </div>\n\n    </div>\n</body>"
