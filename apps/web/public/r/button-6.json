    "rawHtml": "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Changement de fond moderne</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n  <style>\n    .bg-pattern {\n      background-image: linear-gradient(45deg, #f5f7fa 25%, transparent 25%),\n                        linear-gradient(-45deg, #f5f7fa 25%, transparent 25%),\n                        linear-gradient(45deg, transparent 75%, #f5f7fa 75%),\n                        linear-gradient(-45deg, transparent 75%, #f5f7fa 75%);\n      background-size: 20px 20px;\n      background-position: 0 0, 0 10px, 10px -10px, -10px 0px;\n    }\n    \n    .color-option {\n      transition: transform 0.2s, box-shadow 0.2s;\n    }\n    \n    .color-option:hover {\n      transform: scale(1.1);\n      box-shadow: 0 0 15px rgba(0, 0, 0, 0.2);\n    }\n    \n    .floating-button {\n      animation: float 3s ease-in-out infinite;\n    }\n    \n    @keyframes float {\n      0% { transform: translateY(0px); }\n      50% { transform: translateY(-10px); }\n      100% { transform: translateY(0px); }\n    }\n    \n    .slide-in {\n      animation: slideIn 0.3s ease-out forwards;\n    }\n    \n    @keyframes slideIn {\n      from {\n        transform: translateY(20px);\n        opacity: 0;\n      }\n      to {\n        transform: translateY(0);\n        opacity: 1;\n      }\n    }\n  </style>\n</head>\n<body id=\"mainBody\" class=\"bg-gray-100 min-h-screen transition-all duration-500 relative overflow-x-hidden\">\n\n  <!-- Contenu principal -->\n  <div class=\"container mx-auto px-4 py-8\">\n    <header class=\"text-center mb-12\">\n      <h1 class=\"text-4xl font-bold text-gray-800 mb-4\">Personnalisez votre fond d'écran</h1>\n      <p class=\"text-lg text-gray-600 max-w-2xl mx-auto\">\n        Utilisez le bouton flottant en bas à droite pour changer la couleur de fond ou ajouter une image de fond.\n      </p>\n    </header>\n    \n    <main class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto\">\n      <!-- Cartes d'exemple -->\n      <div class=\"bg-white rounded-xl shadow-lg overflow-hidden transform transition-all duration-300 hover:scale-105\">\n        <div class=\"h-48 bg-gradient-to-r from-purple-400 to-pink-400\"></div>\n        <div class=\"p-6\">\n          <h3 class=\"text-xl font-semibold mb-2\">Carte 1</h3>\n          <p class=\"text-gray-600\">Personnalisez l'arrière-plan pour améliorer l'apparence de cette carte.</p>\n        </div>\n      </div>\n      \n      <div class=\"bg-white rounded-xl shadow-lg overflow-hidden transform transition-all duration-300 hover:scale-105\">\n        <div class=\"h-48 bg-gradient-to-r from-green-400 to-blue-400\"></div>\n        <div class=\"p-6\">\n          <h3 class=\"text-xl font-semibold mb-2\">Carte 2</h3>\n          <p class=\"text-gray-600\">Le fond change l'ambiance de toute la page.</p>\n        </div>\n      </div>\n      \n      <div class=\"bg-white rounded-xl shadow-lg overflow-hidden transform transition-all duration-300 hover:scale-105\">\n        <div class=\"h-48 bg-gradient-to-r from-yellow-400 to-red-400\"></div>\n        <div class=\"p-6\">\n          <h3 class=\"text-xl font-semibold mb-2\">Carte 3</h3>\n          <p class=\"text-gray-600\">Essayez différentes couleurs et images pour voir l'effet.</p>\n        </div>\n      </div>\n    </main>\n  </div>\n\n  <!-- Bouton flottant -->\n  <button \n    id=\"bgToggle\"\n    class=\"floating-button fixed bottom-6 right-6 w-14 h-14 bg-indigo-600 text-white rounded-full shadow-lg hover:bg-indigo-700 transition-all duration-300 z-20 flex items-center justify-center\"\n    aria-label=\"Changer le fond d'écran\"\n  >\n    <i class=\"fas fa-palette text-xl\"></i>\n  </button>\n\n  <!-- Panneau de contrôle du fond -->\n  <div \n    id=\"bgPanel\" \n    class=\"hidden fixed bottom-24 right-6 bg-white rounded-xl shadow-2xl p-6 w-80 z-10\"\n  >\n    <h3 class=\"text-lg font-semibold mb-4 text-gray-800\">Personnaliser le fond</h3>\n    \n    <!-- Options de couleur -->\n    <div class=\"mb-6\">\n      <h4 class=\"text-sm font-medium text-gray-700 mb-3\">Couleurs prédéfinies</h4>\n      <div class=\"grid grid-cols-6 gap-2\">\n        <button class=\"color-option w-10 h-10 rounded-lg bg-gray-200\" data-color=\"#e5e7eb\"></button>\n        <button class=\"color-option w-10 h-10 rounded-lg bg-red-300\" data-color=\"#fca5a5\"></button>\n        <button class=\"color-option w-10 h-10 rounded-lg bg-orange-300\" data-color=\"#fdba74\"></button>\n        <button class=\"color-option w-10 h-10 rounded-lg bg-yellow-300\" data-color=\"#fde047\"></button>\n        <button class=\"color-option w-10 h-10 rounded-lg bg-green-300\" data-color=\"#86efac\"></button>\n        <button class=\"color-option w-10 h-10 rounded-lg bg-blue-300\" data-color=\"#93c5fd\"></button>\n        <button class=\"color-option w-10 h-10 rounded-lg bg-indigo-300\" data-color=\"#a5b4fc\"></button>\n        <button class=\"color-option w-10 h-10 rounded-lg bg-purple-300\" data-color=\"#d8b4fe\"></button>\n        <button class=\"color-option w-10 h-10 rounded-lg bg-pink-300\" data-color=\"#f9a8d4\"></button>\n        <button class=\"color-option w-10 h-10 rounded-lg bg-gradient-to-r from-purple-400 to-pink-400\" data-gradient=\"true\"></button>\n        <button class=\"color-option w-10 h-10 rounded-lg bg-gradient-to-r from-green-400 to-blue-400\" data-gradient=\"true\"></button>\n        <button class=\"color-option w-10 h-10 rounded-lg bg-pattern\" data-pattern=\"true\"></button>\n      </div>\n    </div>\n    \n    <!-- Sélecteur de couleur personnalisée -->\n    <div class=\"mb-6\">\n      <h4 class=\"text-sm font-medium text-gray-700 mb-3\">Couleur personnalisée</h4>\n      <div class=\"flex items-center space-x-2\">\n        <input type=\"color\" id=\"customColor\" class=\"w-12 h-12 rounded cursor-pointer\">\n        <input type=\"text\" id=\"colorHex\" placeholder=\"#000000\" class=\"flex-1 px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500\">\n      </div>\n    </div>\n    \n    <!-- URL d'image -->\n    <div class=\"mb-6\">\n      <h4 class=\"text-sm font-medium text-gray-700 mb-3\">Image de fond</h4>\n      <div class=\"flex flex-col space-y-2\">\n        <input type=\"text\" id=\"imageUrl\" placeholder=\"https://example.com/image.jpg\" class=\"px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500\">\n        <button id=\"applyImage\" class=\"px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors\">\n          Appliquer l'image\n        </button>\n      </div>\n    </div>\n    \n    <!-- Bouton de réinitialisation -->\n    <button id=\"resetBg\" class=\"w-full px-4 py-2 bg-gray-200 text-gray-800 rounded-lg hover:bg-gray-300 transition-colors\">\n      Réinitialiser le fond\n    </button>\n  </div>\n\n  <script>\n    const bgToggle = document.getElementById(\"bgToggle\");\n    const bgPanel = document.getElementById(\"bgPanel\");\n    const mainBody = document.getElementById(\"mainBody\");\n    const colorOptions = document.querySelectorAll(\".color-option\");\n    const customColor = document.getElementById(\"customColor\");\n    const colorHex = document.getElementById(\"colorHex\");\n    const imageUrl = document.getElementById(\"imageUrl\");\n    const applyImage = document.getElementById(\"applyImage\");\n    const resetBg = document.getElementById(\"resetBg\");\n    \n    // Toggle du panneau\n    bgToggle.addEventListener(\"click\", () => {\n      bgPanel.classList.toggle(\"hidden\");\n      if (!bgPanel.classList.contains(\"hidden\")) {\n        bgPanel.classList.add(\"slide-in\");\n      }\n    });\n    \n    // Clic en dehors du panneau pour le fermer\n    document.addEventListener(\"click\", (e) => {\n      if (!bgPanel.contains(e.target) && e.target !== bgToggle) {\n        bgPanel.classList.add(\"hidden\");\n      }\n    });\n    \n    // Appliquer les couleurs prédéfinies\n    colorOptions.forEach(option => {\n      option.addEventListener(\"click\", () => {\n        const color = option.getAttribute(\"data-color\");\n        const isGradient = option.getAttribute(\"data-gradient\");\n        const isPattern = option.getAttribute(\"data-pattern\");\n        \n        // Réinitialiser les classes de fond\n        mainBody.className = \"min-h-screen transition-all duration-500 relative overflow-x-hidden\";\n        \n        if (isGradient) {\n          // Appliquer un dégradé\n          const gradientClass = option.className.match(/bg-gradient-to-r from-\\w+-\\d+ to-\\w+-\\d+/)[0];\n          mainBody.classList.add(gradientClass);\n        } else if (isPattern) {\n          // Appliquer un motif\n          mainBody.classList.add(\"bg-pattern\");\n        } else {\n          // Appliquer une couleur unie\n          mainBody.style.backgroundColor = color;\n        }\n      });\n    });\n    \n    // Synchroniser le sélecteur de couleur et le champ hex\n    customColor.addEventListener(\"input\", (e) => {\n      colorHex.value = e.target.value;\n      mainBody.style.backgroundColor = e.target.value;\n      mainBody.className = \"min-h-screen transition-all duration-500 relative overflow-x-hidden\";\n    });\n    \n    colorHex.addEventListener(\"input\", (e) => {\n      if (/^#[0-9A-F]{6}$/i.test(e.target.value)) {\n        customColor.value = e.target.value;\n        mainBody.style.backgroundColor = e.target.value;\n        mainBody.className = \"min-h-screen transition-all duration-500 relative overflow-x-hidden\";\n      }\n    });\n    \n    // Appliquer une image de fond\n    applyImage.addEventListener(\"click\", () => {\n      if (imageUrl.value) {\n        mainBody.style.backgroundImage = `url(${imageUrl.value})`;\n        mainBody.style.backgroundSize = \"cover\";\n        mainBody.style.backgroundPosition = \"center\";\n        mainBody.style.backgroundRepeat = \"no-repeat\";\n        mainBody.className = \"min-h-screen transition-all duration-500 relative overflow-x-hidden\";\n      }\n    });\n    \n    // Réinitialiser le fond\n    resetBg.addEventListener(\"click\", () => {\n      mainBody.style.backgroundColor = \"\";\n      mainBody.style.backgroundImage = \"\";\n      mainBody.style.backgroundSize = \"\";\n      mainBody.style.backgroundPosition = \"\";\n      mainBody.style.backgroundRepeat = \"\";\n      mainBody.className = \"bg-gray-100 min-h-screen transition-all duration-500 relative overflow-x-hidden\";\n      customColor.value = \"#e5e7eb\";\n      colorHex.value = \"\";\n      imageUrl.value = \"\";\n    });\n  </script>\n</body>\n</html>"
  }
}
