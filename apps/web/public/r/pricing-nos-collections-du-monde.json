    "rawHtml": "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Montserrat:wght@300;400;600&display=swap\" rel=\"stylesheet\">\n    <style>\n        .font-serif { font-family: 'Cormorant Garamond', serif; }\n        .font-sans { font-family: 'Montserrat', sans-serif; }\n        \n        .paper-texture {\n            background-color: #f4f1ea;\n            background-image: url(\"https://www.transparenttextures.com/patterns/natural-paper.png\");\n        }\n\n        .card-craft {\n            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);\n            clip-path: polygon(0% 0%, 100% 0%, 100% 95%, 95% 100%, 5% 100%, 0% 95%);\n        }\n\n        .card-craft:hover {\n            transform: translateY(-10px) rotate(1deg);\n            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);\n        }\n\n        .stamp {\n            opacity: 0;\n            transform: scale(2) rotate(-20deg);\n            transition: all 0.3s ease;\n        }\n\n        .card-craft:hover .stamp {\n            opacity: 0.2;\n            transform: scale(1) rotate(-20deg);\n        }\n    </style>\n</head>\n<body class=\"bg-[#ece7de] py-20 px-4\">\n\n    <div class=\"max-w-6xl mx-auto\">\n        <div class=\"text-center mb-16\">\n            <h2 class=\"font-serif text-5xl text-[#3d332d] mb-4 tracking-wide\">Nos Collections du Monde</h2>\n            <div class=\"w-24 h-px bg-[#8b735b] mx-auto mb-4\"></div>\n            <p class=\"font-sans text-[#7a6d5e] uppercase tracking-[0.3em] text-xs\">Tarifs & Expéditions Artisanales</p>\n        </div>\n\n        <div class=\"grid grid-cols-1 md:grid-cols-3 gap-8\">\n            \n            <div class=\"card-craft paper-texture p-8 border border-[#dcd3c1] relative flex flex-col h-full\">\n                <div class=\"stamp absolute top-4 right-4 text-[#8b4513] font-bold border-4 border-[#8b4513] p-2 rounded-xl text-xl\">APPROVED</div>\n                \n                <span class=\"font-sans text-[10px] font-bold tracking-widest text-[#8b735b] uppercase mb-2\">Petit Format</span>\n                <h3 class=\"font-serif text-3xl text-[#3d332d] mb-6\">L'Explorateur</h3>\n                \n                <div class=\"mb-8\">\n                    <span class=\"text-4xl font-serif font-bold text-[#3d332d]\">29€</span>\n                    <span class=\"text-[#7a6d5e] font-sans text-sm\">/ objet</span>\n                </div>\n\n                <ul class=\"space-y-4 mb-10 flex-grow font-sans text-sm text-[#5a5045]\">\n                    <li class=\"flex items-center gap-3\">\n                        <span class=\"w-1.5 h-1.5 rounded-full bg-[#8b735b]\"></span>\n                        Packaging en fibre de jute\n                    </li>\n                    <li class=\"flex items-center gap-3\">\n                        <span class=\"w-1.5 h-1.5 rounded-full bg-[#8b735b]\"></span>\n                        Certificat d'origine papier recyclé\n                    </li>\n                    <li class=\"flex items-center gap-3\">\n                        <span class=\"w-1.5 h-1.5 rounded-full bg-[#8b735b]\"></span>\n                        Livraison Standard (7-10j)\n                    </li>\n                </ul>\n\n                <button class=\"w-full py-4 bg-[#3d332d] text-[#f4f1ea] font-sans text-xs font-bold tracking-widest uppercase hover:bg-[#5a5045] transition-colors\">\n                    Sélectionner\n                </button>\n            </div>\n\n            <div class=\"card-craft bg-[#3d332d] p-10 relative flex flex-col h-full shadow-2xl scale-105 z-10\">\n                <div class=\"absolute -top-4 left-1/2 -translate-x-1/2 bg-[#8b735b] text-white px-4 py-1 text-[10px] font-bold tracking-tighter uppercase\">Le plus prisé</div>\n                \n                <span class=\"font-sans text-[10px] font-bold tracking-widest text-[#c4b5a4] uppercase mb-2\">Édition Limitée</span>\n                <h3 class=\"font-serif text-3xl text-[#f4f1ea] mb-6 tracking-wide\">Le Nomade</h3>\n                \n                <div class=\"mb-8\">\n                    <span class=\"text-5xl font-serif font-bold text-[#d4af37]\">55€</span>\n                    <span class=\"text-[#c4b5a4] font-sans text-sm\">/ set</span>\n                </div>\n\n                <ul class=\"space-y-4 mb-10 flex-grow font-sans text-sm text-[#c4b5a4]\">\n                    <li class=\"flex items-center gap-3\">\n                        <svg class=\"w-4 h-4 text-[#d4af37]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path></svg>\n                        Coffret en bois de manguier\n                    </li>\n                    <li class=\"flex items-center gap-3\">\n                        <svg class=\"w-4 h-4 text-[#d4af37]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path></svg>\n                        Histoire de l'artisan incluse\n                    </li>\n                    <li class=\"flex items-center gap-3\">\n                        <svg class=\"w-4 h-4 text-[#d4af37]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path></svg>\n                        Livraison Express Prioritaire\n                    </li>\n                    <li class=\"flex items-center gap-3 text-[#f4f1ea]\">\n                        <svg class=\"w-4 h-4 text-[#d4af37]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path></svg>\n                        Personnalisation au fer chaud\n                    </li>\n                </ul>\n\n                <button class=\"w-full py-4 bg-[#d4af37] text-[#3d332d] font-sans text-xs font-bold tracking-widest uppercase hover:bg-white transition-all\">\n                    Commander le Set\n                </button>\n            </div>\n\n            <div class=\"card-craft paper-texture p-8 border border-[#dcd3c1] relative flex flex-col h-full\">\n                <div class=\"stamp absolute top-4 right-4 text-[#2d4a3e] font-bold border-4 border-[#2d4a3e] p-2 rounded-xl text-xl\">AUTHENTIC</div>\n\n                <span class=\"font-sans text-[10px] font-bold tracking-widest text-[#8b735b] uppercase mb-2\">Prestige</span>\n                <h3 class=\"font-serif text-3xl text-[#3d332d] mb-6\">Le Collectionneur</h3>\n                \n                <div class=\"mb-8\">\n                    <span class=\"text-4xl font-serif font-bold text-[#3d332d]\">120€</span>\n                    <span class=\"text-[#7a6d5e] font-sans text-sm\">/ pack</span>\n                </div>\n\n                <ul class=\"space-y-4 mb-10 flex-grow font-sans text-sm text-[#5a5045]\">\n                    <li class=\"flex items-center gap-3\">\n                        <span class=\"w-1.5 h-1.5 rounded-full bg-[#8b735b]\"></span>\n                        Malle de transport vintage\n                    </li>\n                    <li class=\"flex items-center gap-3\">\n                        <span class=\"w-1.5 h-1.5 rounded-full bg-[#8b735b]\"></span>\n                        Assurance casse Monde incluse\n                    </li>\n                    <li class=\"flex items-center gap-3\">\n                        <span class=\"w-1.5 h-1.5 rounded-full bg-[#8b735b]\"></span>\n                        Accès aux ventes privées\n                    </li>\n                </ul>\n\n                <button class=\"w-full py-4 border-2 border-[#3d332d] text-[#3d332d] font-sans text-xs font-bold tracking-widest uppercase hover:bg-[#3d332d] hover:text-white transition-all\">\n                    Découvrir l'Offre\n                </button>\n            </div>\n\n        </div>\n    </div>\n\n</body>\n</html>"
