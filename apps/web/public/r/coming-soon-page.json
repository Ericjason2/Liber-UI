www.facebook.com/\" title=\"Quicktoolz On Facebook\"\n                    className=\"md32 tracking-wide font-bold rounded border-2 border-indigo-500 hover hover600 hover600 shadow-md py-2 px-6 inline-flex items-center transition duration-500\">\n                    <span className=\"mx-auto\">Facebook</span>\n                </a>\n                <a href=\"https://twitter.com\" title=\"Quicktoolz On Twitter\"\n                    className=\"md32 tracking-wide font-bold rounded border-2 border-indigo-500 hover hover500 hover500 shadow-md py-2 px-6 inline-flex items-center transition duration-500\">\n                    <span className=\"mx-auto\">Twitter</span>\n                </a>\n                <a href=\"https://pinterest.com/\" title=\"Quicktoolz On Pinterest\"\n                    className=\"md32 tracking-wide font-bold rounded border-2 border-indigo-500 hover hover600 hover600 shadow-md py-2 px-6 inline-flex items-center transition duration-500\">\n                    <span className=\"mx-auto\">Pintrest</span>\n                </a>\n                <a href=\"https://www.reddit.com/\" title=\"Quicktoolz On Facebook\"\n                    className=\"md32 tracking-wide font-bold rounded border-2 border-indigo-500 hover hover600 hover600 shadow-md py-2 px-6 inline-flex items-center transition duration-500\">\n                    <span className=\"mx-auto\">Reddit</span>\n                </a>\n            </div>\n        </div>\n    </div>\n    </div>\n  );\n}\n",
