assName=\"text-gray-700 hover600 font-medium transition-colors duration-200 relative group\">\n                            About\n                            <span className=\"absolute -bottom-1 left-0 w-0 h-0.5 bg-blue-600 transition-all duration-300 group-hover\"></span>\n                        </a>\n                        <a href=\"#\" className=\"text-gray-700 hover600 font-medium transition-colors duration-200 relative group\">\n                            Services\n                            <span className=\"absolute -bottom-1 left-0 w-0 h-0.5 bg-blue-600 transition-all duration-300 group-hover\"></span>\n                        </a>\n                        <a href=\"#\" className=\"text-gray-700 hover600 font-medium transition-colors duration-200 relative group\">\n                            Contact\n                            <span className=\"absolute -bottom-1 left-0 w-0 h-0.5 bg-blue-600 transition-all duration-300 group-hover\"></span>\n                        </a>\n                    </div>\n    \n                    \n                    <div className=\"flex items-center space-x-4\">\n                        <button className=\"hidden md bg-gradient-to-r from-blue-600 to-purple-600 text-white px-6 py-2 rounded-full font-medium hover700 hover700 transition-all duration-300 shadow-lg hover hover105 transform\">\n                            Get Started\n                        </button>\n                        \n                        \n                        <button id=\"mobile-menu-btn\" className=\"md p-2 rounded-lg text-gray-700 hover100 transition-colors duration-200\">\n                            <svg className=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"M4 6h16M4 12h16M4 18h16\"></path>\n                            </svg>\n                        </button>\n                    </div>\n              