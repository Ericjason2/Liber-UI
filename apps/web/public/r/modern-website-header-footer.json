7m7 7V3\"></path>\n                    </svg>\n                </div>\n            </div>\n        </div>\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"bg-gray-900 text-white relative overflow-hidden\">\n        <!-- Decorative background -->\n        <div class=\"absolute inset-0 bg-gradient-to-br from-blue-900/20 to-purple-900/20\"></div>\n        <div class=\"absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-blue-500 to-transparent\"></div>\n        \n        <div class=\"relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-8\">\n            <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-12\">\n                <!-- Company Info -->\n                <div class=\"lg:col-span-2\">\n                    <div class=\"flex items-center space-x-3 mb-6\">\n                        <div class=\"w-10 h-10 bg-gradient-to-br from-blue-600 to-purple-600 rounded-xl flex items-center justify-center shadow-lg\">\n                            <span class=\"text-white font-bold text-lg\">L</span>\n                        </div>\n                        <span class=\"text-2xl font-bold bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent\">\n                            Logo\n                        </span>\n                    </div>\n                    <p class=\"text-gray-300 mb-6 max-w-md leading-relaxed\">\n                        Building exceptional digital experiences with modern design principles and cutting-edge technology. \n                        Your vision, our expertise.\n                    </p>\n                    <div class=\"flex space-x-4\">\n                        <a href=\"#\" class=\"w-10 h-10 bg-gray-800 hover:bg-blue-600 rounded-lg flex items-center justify-center transition-all duration-300 hover:scale-110 hover:shadow-lg group\">\n                            <svg class=\"w-5 h-5 text-gray-400 group-hover:text-white\" fill=\"currentColor\" viewBox=\"0 0 24 24\">\n             