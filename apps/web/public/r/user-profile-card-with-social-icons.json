      "content": "/**\n * Component: User profile card with social icons\n * Author: @simon-scheffer (https://tailwindflex.com/@simon-scheffer)\n * Source: https://tailwindflex.com/@simon-scheffer/user-profile-card-with-social-icons\n * Attribution: Créé par @simon-scheffer sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function UserProfileCardWithSocialIcons() {\n  return (\n    <div>\n    <div className=\"w-full h-screen bg-gray-100 px-10 pt-10\">\n        <div className=\"relative mt-16 mb-32 max-w-sm mx-auto mt-24\">\n            <div className=\"rounded overflow-hidden shadow-md bg-white\">\n                <div className=\"absolute -mt-20 w-full flex justify-center\">\n                    <div className=\"h-32 w-32\">\n                        <img src=\"https://randomuser.me/api/portraits/women/49.jpg\" className=\"rounded-full object-cover h-full w-full shadow-md\" />\n                    </div>\n                </div>\n                <div className=\"px-6 mt-16\">\n                    <h1 className=\"font-bold text-3xl text-center mb-1\">Carole Steward</h1>\n                    <p className=\"text-gray-800 text-sm text-center\">Chief Executive Officer</p>\n                    <p className=\"text-center text-gray-600 text-base pt-3 font-normal\">\n                        Carole Steward is a visionary CEO known for her exceptional leadership and strategic acumen. With a\n                        wealth of experience in the corporate world, she has a proven track record of driving innovation and\n                        achieving remarkable business growth.\n                    </p>\n                    <div className=\"w-full flex justify-center pt-5 pb-5\">\n                        <a href=\"#\" className=\"mx-5\">\n                            <div aria-label=\"Github\">\n                                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\"\n                                    fill=\"none\" stroke=\"#718096\" strokeWidth=\"1.5\" strokeLinecap=\"round\"\n                                    strokeLinejoin=\"round\" className=\"feather feather-github\">\n                                    <path\n                                        d=\"M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22\">\n                                    </path>\n                                </svg>\n                            </div>\n                        </a>\n                        <a href=\"#\" className=\"mx-5\">\n                            <div aria-label=\"Twitter\">\n                                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\"\n                                    fill=\"none\" stroke=\"#718096\" strokeWidth=\"1.5\" strokeLinecap=\"round\"\n                                    strokeLinejoin=\"round\" className=\"feather feather-twitter\">\n                                    <path\n                                        d=\"M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z\">\n                                    </path>\n                                </svg>\n                            </div>\n                        </a>\n                        <a href=\"#\" className=\"mx-5\">\n                            <div aria-label=\"Instagram\">\n                                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\"\n                                    fill=\"none\" stroke=\"#718096\" strokeWidth=\"1.5\" strokeLinecap=\"round\"\n                                    strokeLinejoin=\"round\" className=\"feather feather-instagram\">\n                                    <rect x=\"2\" y=\"2\" width=\"20\" height=\"20\" rx=\"5\" ry=\"5\"></rect>\n                                    <path d=\"M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z\"></path>\n                                    <line x1=\"17.5\" y1=\"6.5\" x2=\"17.51\" y2=\"6.5\"></line>\n                                </svg>\n                            </div>\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n    </div>\n  );\n}\n",
