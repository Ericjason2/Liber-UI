    "rawHtml": "<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Pricing Plans - Modern & Mewah</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap\" rel=\"stylesheet\">\n    \n    <style>\n        * {\n            font-family: \"Plus Jakarta Sans\", sans-serif;\n        }\n        \n        .font-elegant {\n            font-family: 'Playfair Display', serif;\n        }\n        \n        .gradient-bg {\n            background: linear-gradient(135deg, #f5f7fa 0%, #e4edf5 100%);\n        }\n        \n        .gold-gradient {\n            background: linear-gradient(135deg, #f5e3a9 0%, #d4af37 50%, #b8941f 100%);\n        }\n        \n        .card-shadow {\n            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08), 0 5px 15px rgba(0, 0, 0, 0.06);\n        }\n        \n        .premium-shadow {\n            box-shadow: 0 25px 50px rgba(212, 175, 55, 0.2), 0 10px 20px rgba(212, 175, 55, 0.15);\n        }\n        \n        .border-gold {\n            border: 1px solid rgba(212, 175, 55, 0.3);\n        }\n        \n        .feature-hover:hover {\n            transform: translateY(-3px);\n            transition: transform 0.3s ease;\n        }\n        \n        .pulse-animation {\n            animation: pulse 2s infinite;\n        }\n        \n        @keyframes pulse {\n            0% { box-shadow: 0 0 0 0 rgba(212, 175, 55, 0.5); }\n            70% { box-shadow: 0 0 0 10px rgba(212, 175, 55, 0); }\n            100% { box-shadow: 0 0 0 0 rgba(212, 175, 55, 0); }\n        }\n    </style>\n</head>\n<body class=\"gradient-bg min-h-screen py-12 px-4\">\n    <!-- Header -->\n    <div class=\"max-w-7xl mx-auto text-center mb-16\">\n        <h1 class=\"text-4xl md:text-5xl font-bold text-gray-900 mb-4\">Pilih Paket <span class=\"text-[#d4af37]\">Eksklusif</span> Anda</h1>\n        <p class=\"text-gray-600 text-lg max-w-3xl mx-auto\">Temukan paket premium yang dirancang khusus untuk kebutuhan bisnis Anda. Setiap paket menawarkan pengalaman mewah dengan fitur-fitur eksklusif.</p>\n        \n        <!-- Toggle Tahunan/Bulanan -->\n        <div class=\"mt-10 flex justify-center items-center\">\n            <span class=\"text-gray-700 font-medium mr-3\">Bulanan</span>\n            <div class=\"relative\">\n                <input type=\"checkbox\" id=\"toggle\" class=\"hidden\">\n                <label for=\"toggle\" class=\"cursor-pointer\">\n                    <div class=\"w-14 h-7 bg-gray-300 rounded-full shadow-inner\"></div>\n                    <div class=\"absolute top-0.5 left-0.5 w-6 h-6 bg-white rounded-full transition transform duration-300 flex items-center justify-center\">\n                        <i class=\"fas fa-exchange-alt text-xs text-gray-600\"></i>\n                    </div>\n                </label>\n            </div>\n            <span class=\"text-gray-700 font-medium ml-3\">Tahunan</span>\n            <span class=\"ml-3 px-3 py-1 bg-green-100 text-green-800 text-sm font-medium rounded-full\">Hemat 20%</span>\n        </div>\n    </div>\n    \n    <!-- Pricing Cards -->\n    <div class=\"max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8\">\n        \n        <!-- Paket Dasar -->\n        <div class=\"bg-white rounded-2xl overflow-hidden card-shadow transition-all duration-300 hover:scale-[1.02]\">\n            <div class=\"p-8 border-b border-gray-100\">\n                <div class=\"flex items-center justify-between mb-4\">\n                    <h3 class=\"text-2xl font-bold text-gray-800\">Dasar</h3>\n                    <span class=\"px-4 py-1 bg-blue-100 text-blue-700 font-medium rounded-full text-sm\">Populer</span>\n                </div>\n                <p class=\"text-gray-600 mb-6\">Cocok untuk individu dan bisnis kecil yang baru memulai.</p>\n                <div class=\"mb-6\">\n                    <div class=\"flex items-end\">\n                        <span class=\"text-5xl font-bold text-gray-900\">Rp 299</span>\n                        <span class=\"text-gray-500 ml-2 mb-1\">ribu</span>\n                        <span class=\"text-gray-500 ml-2 mb-1\">/bulan</span>\n                    </div>\n                    <p class=\"text-gray-500 text-sm mt-2\">Rp 3,5 juta/tahun (hemat Rp 88 ribu)</p>\n                </div>\n                <button class=\"w-full py-3 px-6 bg-gray-100 text-gray-800 font-medium rounded-xl hover:bg-gray-200 transition duration-300\">\n                    Mulai Paket Dasar\n                </button>\n            </div>\n            \n            <div class=\"p-8\">\n                <h4 class=\"text-lg font-semibold text-gray-800 mb-6\">Fitur Unggulan</h4>\n                <ul class=\"space-y-4\">\n                    <li class=\"flex items-start\">\n                        <i class=\"fas fa-check text-green-500 mt-1 mr-3\"></i>\n                        <span>5 proyek aktif</span>\n                    </li>\n                    <li class=\"flex items-start\">\n                        <i class=\"fas fa-check text-green-500 mt-1 mr-3\"></i>\n                        <span>10 GB penyimpanan cloud</span>\n                    </li>\n                    <li class=\"flex items-start\">\n                        <i class=\"fas fa-check text-green-500 mt-1 mr-3\"></i>\n                        <span>Dukungan email</span>\n                    </li>\n                    <li class=\"flex items-start\">\n                        <i class=\"fas fa-check text-green-500 mt-1 mr-3\"></i>\n                        <span>Analitik dasar</span>\n                    </li>\n                    <li class=\"flex items-start opacity-50\">\n                        <i class=\"fas fa-times text-gray-400 mt-1 mr