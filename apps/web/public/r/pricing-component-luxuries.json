 <div class=\\\"max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8\\\">\\n        \\n        <!-- Paket Dasar -->\\n        <div class=\\\"bg-white rounded-2xl overflow-hidden card-shadow transition-all duration-300 hover:scale-[1.02]\\\">\\n            <div class=\\\"p-8 border-b border-gray-100\\\">\\n                <div class=\\\"flex items-center justify-between mb-4\\\">\\n                    <h3 class=\\\"text-2xl font-bold text-gray-800\\\">Dasar</h3>\\n                    <span class=\\\"px-4 py-1 bg-blue-100 text-blue-700 font-medium rounded-full text-sm\\\">Populer</span>\\n                </div>\\n                <p class=\\\"text-gray-600 mb-6\\\">Cocok untuk individu dan bisnis kecil yang baru memulai.</p>\\n                <div class=\\\"mb-6\\\">\\n                    <div class=\\\"flex items-end\\\">\\n                        <span class=\\\"text-5xl font-bold text-gray-900\\\">Rp 299</span>\\n                        <span class=\\\"text-gray-500 ml-2 mb-1\\\">ribu</span>\\n                        <span class=\\\"text-gray-500 ml-2 mb-1\\\">/bulan</span>\\n                    </div>\\n                    <p class=\\\"text-gray-500 text-sm mt-2\\\">Rp 3,5 juta/tahun (hemat Rp 88 ribu)</p>\\n                </div>\\n                <button class=\\\"w-full py-3 px-6 bg-gray-100 text-gray-800 font-medium rounded-xl hover:bg-gray-200 transition duration-300\\\">\\n                    Mulai Paket Dasar\\n                </button>\\n            </div>\\n            \\n            <div class=\\\"p-8\\\">\\n                <h4 class=\\\"text-lg font-semibold text-gray-800 mb-6\\\">Fitur Unggulan</h4>\\n                <ul class=\\\"space-y-4\\\">\\n                    <li class=\\\"flex items-start\\\">\\n                        <i class=\\\"fas fa-check text-green-500 mt-1 mr-3\\\"></i>\\n                        <span>5 proyek aktif</span>\\n                    </li>\\n                    <li class=\\\"flex items-start\\\">\\n                        <i class=\\\"fas fa-check text-green-500 mt-1 mr-3\\\"></i>\\n                        <span>10 GB penyimpanan cloud</span>\\n                    </li>\\n                    <li class=\\\"flex items-start\\\">\\n                        <i class=\\\"fas fa-check text-green-500 mt-1 mr-3\\\"></i>\\n                        <span>Dukungan email</span>\\n                    </li>\\n                    <li class=\\\"flex items-start\\\">\\n                        <i class=\\\"fas fa-check text-green-500 mt-1 mr-3\\\"></i>\\n                        <span>Analitik dasar</span>\\n                    </li>\\n                    <li class=\\\"flex items-start opacity-50\\\">\\n                        <i class=\\\"fas fa-times text-gray-400 mt-1 mr-3\\\"></i>\\n                        <span class=\\\"text-gray-400\\\">Konsultasi prioritas</span>\\n                    </li>\\n                    <li class=\\\"flex items-start opacity-50\\\">\\n                        <i class=\\\"fas fa-times text-gray-400 mt-1 mr-3\\\"></i>\\n                        <span class=\\\"text-gray-400\\\">Integrasi API lengkap</span>\\n                    </li>\\n                </ul>\\n            </div>\\n        </div>\\n        \\n        <!-- Paket Premium (Highlighted) -->\\n        <div class=\\\"relative rounded-2xl overflow-hidden premium-shadow\\\">\\n            <!-- Label Rekomendasi -->\\n            <div class=\\\"absolute top-0 right-6 gold-gradient text-white font-bold py-2 px-6 rounded-b-lg z-10\\\">\\n                <i class=\\\"fas fa-crown mr-2\\\"></i>REKOMENDASI\\n            </div>\\n            \\n            <!-- Efek Highlight -->\\n            <div class=\\\"absolute inset-0 gold-gradient opacity-10\\\"></div>\\n            \\n            <div class=\\\"relative bg-white border-gold rounded-2xl overflow-hidden\\\">\\n                <div class=\\\"p-8 border-b border-gray-100\\\">\\n                    <h3 class=\\\"text-2xl font-bold text-gray-800 mb-4\\\">Premium</h3>\\n 