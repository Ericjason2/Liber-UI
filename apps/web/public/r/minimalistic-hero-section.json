      "content": "import * as React from \"react\"\n\nfunction MinimalisticHeroSection({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"minimalistic-hero-section\"\n      className={className}\n      {...props}\n    >\n      <div className=\"max-w-6xl px-4 mx-auto md4xl sm2xl sm6\">\r\n          <div className=\"text-center\">\r\n              <h1\r\n                  className=\"max-w-md mx-auto text-3xl font-extrabold tracking-normal text-gray-900 sm3xl md5xl lg6xl md sm md2xl lg4xl\">\r\n                  <span className=\"block\">The simplest way to preview your Ad campaigns.</span></h1>\r\n              <h2\r\n                  className=\"max-w-md px-12 mx-auto mt-3 font-normal text-gray-500 text-md sm5 sm md5 md sm md\">\r\n                  Sendpreview is a social media advertising tool that lets you quickly create Ad mockups for client approval.\r\n              </h2>\r\n              <div className=\"max-w-md mx-auto mt-5 sm sm md8\">\r\n                  <div className=\"rounded-full shadow\">\r\n                      <button type=\"button\" className=\"flex items-center justify-center w-full px-8 py-3 text-base font-normal text-white bg-teal-400 border border-transparent rounded-full text-md hover300 md4 md2xl md10\">Start for free</button>\r\n                  </div>\r\n              </div>\r\n          </div>\r\n      </div>\n    </div>\n  )\n}\n\nexport { MinimalisticHeroSection }\n",
      "type": "registry:ui"
    }
