      "content": "/**\n * Component: Banner with Form\n * Author: @aitrik-saha (https://tailwindflex.com/@aitrik-saha)\n * Source: https://tailwindflex.com/@aitrik-saha/banner-with-form\n * Attribution: Créé par @aitrik-saha sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function BannerWithForm() {\n  return (\n    <div>\n    <div className=\"relative\">\n      \n    <div className=\"bg-gradient-to-b from-red-500 to-red-800 h-64 flex flex-col items-center justify-center text-white px-4\">\n        <h1 className=\"text-center text-3xl font-extrabold mb-2 font-serif\">\n          Search according to your needs\n        </h1>\n        <p className=\"text-lg text-center\">\n          Discover the best opportunities and make your dream become reality.\n        </p>\n      </div>\n    \n      \n      <div className=\"px-4\">\n        \n        <div className=\"relative w-full sm sm10 sm0\">\n          <div className=\"bg-white border border-gray-300 shadow-2xl rounded-lg mx-auto max-w-full sm4xl p-4\">\n            <div className=\"flex flex-col sm gap-4 sm2 flex-wrap\">\n              <input\n                type=\"text\"\n                placeholder=\"Search...\"\n                className=\"flex-grow p-2 border border-gray-300 rounded-md focus focus2 focus600\"\n              />\n              <select className=\"p-2 border border-gray-300 rounded-md focus focus2 focus600\">\n                <option value=\"\">Category</option>\n                <option value=\"house\">House</option>\n                <option value=\"apartment\">Apartment</option>\n                <option value=\"condo\">Condo</option>\n              </select>\n              <input\n                type=\"number\"\n                placeholder=\"Min Price\"\n                className=\"p-2 border border-gray-300 rounded-md focus focus2 focus600\"\n              />\n              <input\n                type=\"number\"\n                placeholder=\"Max Price\"\n                className=\"p-2 border border-gray-300 rounded-md focus focus2 focus600\"\n              />\n              <button className=\"bg-red-600 text-white p-2 justify-center rounded-md hover700 w-full sm flex-shrink-0 mt-2 sm0\">\n                <svg\n                  xmlns=\"http://www.w3.org/2000/svg\"\n                  fill=\"none\"\n                  viewBox=\"0 0 24 24\"\n                  strokeWidth=\"1.5\"\n                  stroke=\"currentColor\"\n                  className=\"size-6\"\n                >\n                  <path\n                    strokeLinecap=\"round\"\n                    strokeLinejoin=\"round\"\n                    d=\"M21 21l-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607z\"\n                  />\n                </svg>\n              </button>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n    \n    \n    <div className=\"sm items-center sm10 max-w-screen-xl\">\n      <div className=\"sm1/2 p-10\">\n        <div className=\"image object-center text-center\">\n          <img className=\"rounded-lg\" src=\"https://images.unsplash.com/photo-1556745753-b2904692b3cd?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w0NzEyNjZ8MXwxfHNlYXJjaHw4fHx3b3JrfGVufDB8MHx8fDE3MzczNzQwODR8MA&ixlib=rb-4.0.3&q=80&w=1080\" alt=\"About Our Company\" />\n        </div>\n      </div>\n      <div className=\"sm1/2 p-5\">\n        <div className=\"text\">\n          <h2 className=\"my-4 font-bold text-3xl sm4xl\">\n            About <span className=\"text-red-600\">Our Company</span>\n          </h2>\n          <p className=\"text-gray-700\">\n            Lorem ipsum dolor sit amet, consectetur adipisicing elit. Aliquid, commodi\n            doloremque, fugiat illum magni minus nisi nulla numquam obcaecati placeat\n            quia, repellat tempore voluptatum.\n          </p>\n        </div>\n    \n        \n        <button className=\"mt-4 bg-red-600 text-white px-4 py-2 rounded-md text-sm font-medium hover700 hover\">\n          Get Started\n        </button>\n      </div>\n    </div>\n    </div>\n  );\n}\n",
