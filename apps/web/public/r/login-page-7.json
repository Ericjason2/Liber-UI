.2a11.3 11.3 0 0 1 6 0C16.9 4.6 18 5 18 5c.6 1.6.2 2.8.1 3.1a4.6 4.6 0 0 1 1.2 3.2c0 4.6-2.8 5.7-5.5 6 .4.3.8 1 .8 2v3c0 .3.2.7.8.6a11.7 11.7 0 0 0 8.1-11.1C23.5 5.7 18.4.5 12 .5Z\"/>\n              </svg>\n              GitHub\n            </button>\n          </div>\n          <div className=\"my-6 flex items-center\">\n            <div className=\"h-px flex-1 bg-slate-200\"></div>\n            <span className=\"px-3 text-xs uppercase tracking-wider text-slate-400\">or</span>\n            <div className=\"h-px flex-1 bg-slate-200\"></div>\n          </div>\n          <form className=\"space-y-5\">\n            <div>\n              <label className=\"mb-2 block text-sm font-medium text-slate-700\">\n                Email\n              </label>\n              <input\n                type=\"email\"\n                placeholder=\"you.com\"\n                className=\"w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm outline-none transition focus900 focus2 focus200\"\n              />\n            </div>\n            <div>\n              <div className=\"mb-2 flex items-center justify-between\">\n                <label className=\"text-sm font-medium text-slate-700\">\n                  Password\n                </label>\n                <a href=\"#\" className=\"text-xs font-medium text-slate-600 hover900\">\n                  Forgot?\n                </a>\n              </div>\n              <input\n                type=\"password\"\n                placeholder=\"••••••••\"\n                className=\"w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm outline-none transition focus900 focus2 focus200\"\n              />\n            </div>\n            <div className=\"flex items-center justify-between text-sm\">\n              <label className=\"flex items-center gap-2 text-slate-600\">\n                <input type=\"checkbox\" className=\"h-4 w-4 rounded border-slate-300 text-slate-900 focus400\" />\n                Remember me\n              </label>\n            </div>\n            <button className=\"w-full rounded-xl bg-slate-900 py-3 text-sm font-semibold text-white transition hover800\">\n              Sign In\n            </button>\n          </form>\n        </div>\n        <p className=\"mt-6 text-center text-sm text-slate-500\">\n          Don't have an account?\n          <a href=\"#\" className=\"font-semibold text-slate-900 hover\">\n            Create one\n          </a>\n        </p>\n      </div>\n    </body>\n    </div>\n  );\n}\n",
