      "content": "/**\n * Component: Services\n * Author: @ibrahim-sayed (https://tailwindflex.com/@ibrahim-sayed)\n * Source: https://tailwindflex.com/@ibrahim-sayed/services\n * Attribution: Créé par @ibrahim-sayed sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function Services() {\n  return (\n    <div>\n    <div dir=\"rtl\">\n    \n    \n    \n      <div className=\"\">\n    \n    \n        <div className=\"mx-auto h-full px-4 py-10 sm md md24 md36 lg lg8\">\n          <div className=\"flex flex-col items-center justify-between lg md10  gap-5\">\n    \n    \n            <div className=\"relative  lg lg1/2\">\n    \n              <div\n                className=\"relative my-10 flex h-full flex-col overflow-hidden rounded-2xl bg-white text-gray-600 shadow-lg ring-1 ring-gray-200\">\n    \n                <h2 className=\"m-5 bg-teal-500 p-3 rounded-xl text-center  text-xl font-bold\">الخدمات التي نقدمها في خدمة\n                  التوصيات المالية</h2>\n    \n    \n    \n                <div className=\"flex-auto p-6\">\n                  <div className=\"relative flex flex-col justify-center\">\n                    <div className=\"absolute right-4 h-full border-l-2\"></div>\n                    <div className=\"relative mb-4\">\n                      <span className=\"absolute inline-flex h-6 w-6 items-center justify-center rounded-full bg-blue-500 p-4 text-center text-base font-semibold text-white shadow\">1</span>\n                      <div className=\"mr-12 w-auto pt-1\">\n                        <h6 className=\"text-sm font-semibold text-blue-900\">محتوى تعليمي شامل</h6>\n                        <p className=\"mt-1 text-xs text-gray-500\">مكتبة غنية بالمقالات الإرشادية ومقاطع الفيديو التعليمية\n                          والملخصات التفاعلية التي تغطي جميع جوانب التداولونقدم تحليلات مالية دقيقة ومبنية على البيانات\n                          للأسواق المالية والعملات الرقمية.\n                        </p>\n                      </div>\n                    </div>\n    \n    \n                    <div className=\"relative mb-4\">\n                      <span className=\"absolute inline-flex h-6 w-6 items-center justify-center rounded-full bg-blue-500 p-4 text-center text-base font-semibold text-white shadow\">2</span>\n                      <div className=\"mr-12 w-auto pt-1\">\n                        <h6 className=\"text-sm font-semibold text-blue-900\">إدارة محافظ الاستثمار\n    \n    \n                        </h6>\n                        <p className=\"mt-1 text-xs text-gray-500\">استكشف مجموعة واسعة من الدورات التدريبية التي يقدمها خبراء\n                          ماليون معتمدون، مصممة لتطوير مهاراتك ومعرفتك نوفر دعمًا كاملاً لإدارة محافظ الاستثمار بمتابعة\n                          دورية وتحليلات مستمرة لتحسين الأداء وإدارة المخاطر</p>\n                      </div>\n                    </div>\n    \n    \n                    <div className=\"relative mb-4\">\n                      <span className=\"absolute inline-flex h-6 w-6 items-center justify-center rounded-full bg-blue-500 p-4 text-center text-base font-semibold text-white shadow\">3</span>\n                      <div className=\"mr-12 w-auto pt-1\">\n                        <h6 className=\"text-sm font-semibold text-blue-900\">توصيات مبنية على التحليل الفني</h6>\n                        <p className=\"mt-1 text-xs text-gray-500\">نقدم توصيات مبنية على التحليل الفني، مع تحليلات شاملة للمؤشرات\n                          والأنماط الفنية</p>\n                      </div>\n                    </div>\n    \n    \n    \n    \n                    <div className=\"relative mb-4\">\n                      <span className=\"absolute inline-flex h-6 w-6 items-center justify-center rounded-full bg-blue-500 p-4 text-center text-base font-semibold text-white shadow\">4</span>\n                      <div className=\"mr-12 w-auto pt-1\">\n                        <h6 className=\"text-sm font-semibold text-blue-900\">تقييم الأصول والشهادات المالية</h6>\n                        <p className=\"mt-1 text-xs text-gray-500\">\n                          توفير تقييمات دقيقة للأصول المالية المختلفة والشهادات الاستثمارية.\n    \n                        </p>\n                      </div>\n                    </div>\n    \n                    <div className=\"relative mb-4\">\n                      <span className=\"absolute inline-flex h-6 w-6 items-center justify-center rounded-full bg-blue-500 p-4 text-center text-base font-semibold text-white shadow\">5</span>\n                      <div className=\"mr-12 w-auto pt-1\">\n                        <h6 className=\"text-sm font-semibold text-blue-900\">تحسين الاستراتيجيات وإدارة المخاطر</h6>\n                        <p className=\"mt-1 text-xs text-gray-500\">نقدم استشارات لتحسين الاستراتيجيات الاستثمارية وإدارة المخاطر\n                          المالية بشكل فعال. حيث يمكنك طرح الأسئلة والحصول على إجابات مباشرة</p>\n                      </div>\n                    </div>\n    \n                  </div>\n                </div>\n              </div>\n            </div>\n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n            <div className=\"relative  lg lg1/2\">\n    \n    \n    \n              <img src=\"https://res.cloudinary.com/dt9k74vof/image/upload/v1712581499/New_Project_4_jlzbhj.webp\" className=\"w-5/6\" />\n    \n            </div>\n          </div>\n        </div>\n    \n    \n    \n    \n    \n      </div>\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
