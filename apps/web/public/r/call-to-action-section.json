      "content": "/**\n * Component: Call to action section\n * Author: @leon-bachmann (https://tailwindflex.com/@leon-bachmann)\n * Source: https://tailwindflex.com/@leon-bachmann/call-to-action-section\n * Attribution: Créé par @leon-bachmann sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function CallToActionSection() {\n  return (\n    <div>\n    <div className=\"bg-gray-100 dark800 mt-20\">\n        <div className=\"z-20 w-full px-4 py-12 mx-auto text-center sm6 lg16 lg8\">\n            <h2 className=\"text-black dark sm4xl\">\n                <span className=\"text-base font-semibold leading-6 text-indigo-500 uppercase\">\n                    IT ONLY TAKES A FEW EASY STEPS\n                </span>\n                <span className=\"block mt-2 text-2xl font-extrabold leading-8 text-gray-900 dark sm3xl sm9\">\n                    Create your first API in minutes\n                </span>\n            </h2>\n    \n            <div className=\"lg0 lg0\">\n                <div className=\"inline-flex mt-12 rounded-md shadow\">\n                    <a href=\"\"\n                        className=\"w-full px-6 py-4 text-base font-semibold text-center text-white transition duration-200 ease-in bg-indigo-600 rounded-lg shadow-md hover700 focus500 focus200 focus focus2 focus2 \">\n                        Get Started Now - It's free\n                    </a>\n                </div>\n            </div>\n        </div>\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
  ],
