    "rawHtml": "<div class=\"bg-gray-100 dark:bg-gray-800 mt-20\">\n    <div class=\"z-20 w-full px-4 py-12 mx-auto text-center sm:px-6 lg:py-16 lg:px-8\">\n        <h2 class=\"text-black dark:text-white sm:text-4xl\">\n            <span class=\"text-base font-semibold leading-6 text-indigo-500 uppercase\">\n                IT ONLY TAKES A FEW EASY STEPS\n            </span>\n            <span class=\"block mt-2 text-2xl font-extrabold leading-8 text-gray-900 dark:text-white sm:text-3xl sm:leading-9\">\n                Create your first API in minutes\n            </span>\n        </h2>\n\n        <div class=\"lg:mt-0 lg:flex-shrink-0\">\n            <div class=\"inline-flex mt-12 rounded-md shadow\">\n                <a href=\"\"\n                    class=\"w-full px-6 py-4 text-base font-semibold text-center text-white transition duration-200 ease-in bg-indigo-600 rounded-lg shadow-md hover:bg-indigo-700 focus:ring-indigo-500 focus:ring-offset-indigo-200 focus:outline-none focus:ring-2 focus:ring-offset-2 \">\n                    Get Started Now - It's free\n                </a>\n            </div>\n        </div>\n    </div>\n</div>"
