      "content": "/**\n * Component: Responsive Navbar Example\n * Author: @noob_dev (https://tailwindflex.com/@noob_dev)\n * Source: https://tailwindflex.com/@noob_dev/responsive-navbar-example\n * Attribution: Créé par @noob_dev sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function ResponsiveNavbarExample() {\n  return (\n    <div>\n    <nav className=\"flex flex-wrap items-center justify-between p-3 bg-teal-200/20\">\n        <img src=\"https://tailwindflex.com/public/favicon.ico\" className=\"h-10 w-10\" alt=\"\" />\n        <div className=\"flex md\">\n            <button id=\"hamburger\">\n              <img className=\"toggle block\" src=\"https://img.icons8.com/fluent-systems-regular/2x/menu-squared-2.png\" width=\"48\" height=\"48\" />\n              <img className=\"toggle hidden\" src=\"https://img.icons8.com/fluent-systems-regular/2x/close-window.png\" width=\"48\" height=\"48\" />\n            </button>\n        </div>\n        <div\n            className=\"toggle hidden w-full md md text-right text-bold mt-5 md0 border-t-2 border-teal-900 md\">\n            <a href=\"#\"\n                className=\"block md text-teal-900 hover500 px-3 py-3 border-b-2 border-teal-900 md\">Home\n            </a>\n            <a href=\"#\"\n                className=\"block md text-teal-900 hover500 px-3 py-3 border-b-2 border-teal-900 md\">Products\n            </a>\n            <a href=\"#\"\n                className=\"block md text-teal-900 hover500 px-3 py-3 border-b-2 border-teal-900 md\">Pricing\n            </a>\n            <a href=\"#\"\n                className=\"block md text-teal-900 hover500 px-3 py-3 border-b-2 border-teal-900 md\">Contact\n            </a>\n        </div>\n        <a href=\"#\"\n            className=\"toggle hidden md w-full md px-4 py-2 text-right bg-teal-900 hover500 text-white md\">Create\n            Account\n        </a>\n    </nav>\n    \n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
  ],
