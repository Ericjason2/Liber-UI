      "content": "/**\n * Component: Join Our Community Banner\n * Author: @diego-chavez (https://tailwindflex.com/@diego-chavez)\n * Source: https://tailwindflex.com/@diego-chavez/join-our-community-banner\n * Attribution: Créé par @diego-chavez sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function JoinOurCommunityBanner() {\n  return (\n    <div>\n    <div className=\"bg-white\">\n      <div className=\"mx-auto py-16 sm6 lg8\">\n        <div className=\"relative isolate overflow-hidden px-6 py-24 text-center sm3xl sm16\">\n          <h2 className=\"font-nudge-extrabold mx-auto max-w-2xl text-3xl font-bold uppercase tracking-wide sm4xl\">Join our\n            community now</h2>\n          <p className=\"mx-auto mt-6 max-w-xl text-lg leading-8 text-gray-600\">Experience the benefits of our community. No\n            obligations, just join and explore.</p>\n          <div className=\"isolate mt-8 flex items-center justify-center -space-x-2 overflow-hidden\">\n            <img className=\"relative z-30 inline-block h-10 w-10 rounded-full ring-2 ring-white\" src=\"https://randomuser.me/api/portraits/men/34.jpg\" alt=\"\" />\n            <img className=\"relative z-20 inline-block h-10 w-10 rounded-full ring-2 ring-white\" src=\"https://randomuser.me/api/portraits/women/2.jpg\" alt=\"\" />\n            <img className=\"relative z-10 inline-block h-10 w-10 rounded-full ring-2 ring-white\" src=\"https://randomuser.me/api/portraits/women/3.jpg\" alt=\"\" />\n            <img className=\"relative z-0 inline-block h-10 w-10 rounded-full ring-2 ring-white\" src=\"https://randomuser.me/api/portraits/men/4.jpg\" alt=\"\" />\n            <span className=\"!ml-2 font-bold italic text-teal-500\">Join these awesome members</span>\n          </div>\n          <div className=\"mt-12 flex items-center justify-center gap-x-6\">\n            <button type=\"button\" className=\"text-md relative inline-flex items-center gap-x-2 rounded-lg bg-teal-600 px-6 py-4 font-semibold text-white shadow-sm hover500 focus-visible focus-visible2 focus-visible2 focus-visible600\">\n              <span className=\"absolute -top-5 left-0 w-full text-left text-xs italic text-teal-600\">No Obligations</span>Join Now\n              <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\" className=\"-mr-0.5 h-5 w-5\">\n                <path fillRule=\"evenodd\" d=\"M16.72 7.72a.75.75 0 011.06 0l3.75 3.75a.75.75 0 010 1.06l-3.75 3.75a.75.75 0 11-1.06-1.06l2.47-2.47H3a.75.75 0 010-1.5h16.19l-2.47-2.47a.75.75 0 010-1.06z\" clipRule=\"evenodd\"></path>\n              </svg>\n            </button>\n          </div>\n          <svg viewBox=\"0 0 1024 1024\"\n            className=\"absolute left-1/2 top-1/2 -z-10 h-[72rem] w-[72rem] -translate-x-1/2 [mask-image(closest-side,white,transparent)]\"\n            aria-hidden=\"true\">\n            <circle cx=\"512\" cy=\"512\" r=\"512\" fill=\"url(#827591b1-ce8c-4110-b064-7cb85a0b1217)\" fill-opacity=\"0.7\"></circle>\n            <defs>\n              <radialGradient id=\"827591b1-ce8c-4110-b064-7cb85a0b1217\">\n                <stop stopColor=\"#15b8a6\"></stop>\n                <stop offset=\"1\" stopColor=\"#15b8a6\"></stop>\n              </radialGradient>\n            </defs>\n          </svg>\n        </div>\n      </div>\n    </div>\n    </div>\n  );\n}\n",
