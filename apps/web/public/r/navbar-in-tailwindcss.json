      "content": "/**\n * Component: navbar in tailwindcss\n * Author: @aynal7411 (https://tailwindflex.com/@aynal7411)\n * Source: https://tailwindflex.com/@aynal7411/navbar-in-tailwindcss\n * Attribution: Créé par @aynal7411 sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function NavbarInTailwindcss() {\n  return (\n    <div>\n    <body className=\"bg-gray-100\">\n    \n      <nav className=\"relative bg-teal-200/20 p-3 flex items-center justify-between\">\n        \n        <img src=\"https://tailwindflex.com/public/favicon.ico\" className=\"h-10 w-10\" alt=\"Logo\" />\n    \n        \n        <button id=\"hamburger\" className=\"md\">\n          <img className=\"h-12 w-12 block\" src=\"https://img.icons8.com/fluent-systems-regular/2x/menu-squared-2.png\" alt=\"Menu\" />\n          <img className=\"h-12 w-12 hidden\" src=\"https://img.icons8.com/fluent-systems-regular/2x/close-window.png\" alt=\"Close\" />\n        </button>\n    \n        \n        <div id=\"menu\"\n             className=\"absolute top-full left-0 w-full md md flex-col md bg-teal-100 md transform -translate- md0 transition-transform duration-300 ease-in-out\">\n          <a href=\"#\" className=\"block md px-3 py-3 text-teal-900 hover500 border-b-2 border-teal-900 md\">Home</a>\n          <a href=\"#\" className=\"block md px-3 py-3 text-teal-900 hover500 border-b-2 border-teal-900 md\">Products</a>\n          <a href=\"#\" className=\"block md px-3 py-3 text-teal-900 hover500 border-b-2 border-teal-900 md\">Pricing</a>\n          <a href=\"#\" className=\"block md px-3 py-3 text-teal-900 hover500 border-b-2 border-teal-900 md\">Contact</a>\n          <a href=\"#\" className=\"block md w-full md px-4 py-2 mt-2 md0 bg-teal-900 text-white hover500 md text-center\">Create Account</a>\n        </div>\n      </nav>\n    \n      \n      \n    \n    </body>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
