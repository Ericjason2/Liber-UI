    "rawHtml": "<body class=\"bg-gray-100\">\n\n  <nav class=\"relative bg-teal-200/20 p-3 flex items-center justify-between\">\n    <!-- Logo -->\n    <img src=\"https://tailwindflex.com/public/favicon.ico\" class=\"h-10 w-10\" alt=\"Logo\" />\n\n    <!-- Hamburger Button (Small Screens) -->\n    <button id=\"hamburger\" class=\"md:hidden\">\n      <img class=\"h-12 w-12 block\" src=\"https://img.icons8.com/fluent-systems-regular/2x/menu-squared-2.png\" alt=\"Menu\" />\n      <img class=\"h-12 w-12 hidden\" src=\"https://img.icons8.com/fluent-systems-regular/2x/close-window.png\" alt=\"Close\" />\n    </button>\n\n    <!-- Menu Links -->\n    <div id=\"menu\"\n         class=\"absolute top-full left-0 w-full md:static md:flex flex-col md:flex-row bg-teal-100 md:bg-transparent transform -translate-x-full md:translate-x-0 transition-transform duration-300 ease-in-out\">\n      <a href=\"#\" class=\"block md:inline-block px-3 py-3 text-teal-900 hover:text-teal-500 border-b-2 border-teal-900 md:border-none\">Home</a>\n      <a href=\"#\" class=\"block md:inline-block px-3 py-3 text-teal-900 hover:text-teal-500 border-b-2 border-teal-900 md:border-none\">Products</a>\n      <a href=\"#\" class=\"block md:inline-block px-3 py-3 text-teal-900 hover:text-teal-500 border-b-2 border-teal-900 md:border-none\">Pricing</a>\n      <a href=\"#\" class=\"block md:inline-block px-3 py-3 text-teal-900 hover:text-teal-500 border-b-2 border-teal-900 md:border-none\">Contact</a>\n      <a href=\"#\" class=\"block md:inline-block w-full md:w-auto px-4 py-2 mt-2 md:mt-0 bg-teal-900 text-white hover:bg-teal-500 md:rounded text-center\">Create Account</a>\n    </div>\n  </nav>\n\n  <!-- JavaScript for toggle -->\n  <script>\n    const hamburger = document.getElementById('hamburger');\n    const menu = document.getElementById('menu');\n    const icons = hamburger.querySelectorAll('img');\n\n    hamburger.addEventListener('click', () => {\n      menu.classList.toggle('-translate-x-full');\n      icons.forEach(icon => icon.classList.toggle('hidden'));\n    });\n  </script>\n\n</body>"
  }
