2\" cy=\"512\" r=\"512\" fill=\"url(#827591b1-ce8c-4110-b064-7cb85a0b1217)\" fill-opacity=\"0.7\">\n            </circle>\n            <defs>\n                <radialGradient id=\"827591b1-ce8c-4110-b064-7cb85a0b1217\">\n                    <stop stopColor=\"#3b82f6\"></stop>\n                    <stop offset=\"1\" stopColor=\"#1d4ed8\"></stop>\n                </radialGradient>\n            </defs>\n        </svg>\n    </div>\n    </div>\n  );\n}\n",
