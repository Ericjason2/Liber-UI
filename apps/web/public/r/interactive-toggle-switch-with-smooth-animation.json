      "content": "/**\n * Component: Interactive Toggle Switch with Smooth Animation\n * Author: @shariful-islam (https://tailwindflex.com/@shariful-islam)\n * Source: https://tailwindflex.com/@shariful-islam/interactive-toggle-switch-with-smooth-animation\n * Attribution: Créé par @shariful-islam sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function InteractiveToggleSwitchWithSmoothAnimation() {\n  return (\n    <div>\n    <div className=\"flex items-center justify-center h-screen\">\n      <div className=\"flex items-center\">\n        <input\n          type=\"checkbox\"\n          id=\"toggleSwitch\"\n          className=\"hidden\"\n         \n        />\n        <label\n          htmlFor=\"toggleSwitch\"\n          className=\"select-none relative inline-flex h-6 w-14 items-center rounded-full transition-colors duration-200 cursor-pointer bg-[#E6E6E6]\"\n        >\n          <span\n            id=\"toggleText\"\n            className=\"absolute w-full text-xs transition-transform duration-200 text-right pr-1.5 text-black\"\n          >\n            OFF\n          </span>\n          <span\n            id=\"toggleBall\"\n            className=\"inline-block w-[17px] h-[17px] transform rounded-full bg-white transition-transform duration-200 translate-x-1\"\n          ></span>\n        </label>\n      </div>\n    </div>\n    \n    \n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
