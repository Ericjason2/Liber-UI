Avatar\" />\n                    <p className=\"text-sm text-gray-400 dark500 flex-grow\">Add a comment...</p>\n                    <button className=\"text-sm font-semibold text-blue-500 hover700 dark400 opacity-50 cursor-not-allowed\">Post</button>\n                </div>\n            </div>\n    \n        </div>\n    \n    </body>\n    </div>\n  );\n}\n",
