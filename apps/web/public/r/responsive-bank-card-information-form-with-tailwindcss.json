      "content": "/**\n * Component: Responsive Bank Card Information Form with TailwindCSS\n * Author: @shariful-islam (https://tailwindflex.com/@shariful-islam)\n * Source: https://tailwindflex.com/@shariful-islam/responsive-bank-card-information-form-with-tailwindcss\n * Attribution: Créé par @shariful-islam sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function ResponsiveBankCardInformationFormWithTailwindcss() {\n  return (\n    <div>\n    <div className=\"flex items-center justify-center min-h-screen \">\n       <div className=\"bg-white p-6 rounded-2xl shadow-lg max-w-md w-full\">\n        <h1 className=\"text-2xl font-semibold mb-4 text-gray-800\">Enter Card Information</h1>\n        <form action=\"#\" method=\"POST\">\n          \n          <div className=\"mb-4\">\n            <label htmlFor=\"cardholder-name\" className=\"block text-sm font-medium text-gray-700\">Cardholder Name</label>\n            <input\n              type=\"text\"\n              id=\"cardholder-name\"\n              name=\"cardholder-name\"\n              placeholder=\"John Doe\"\n              className=\"mt-1 block w-full p-2 rounded-lg border-gray-300 focus500 focus500 shadow-sm\"\n              required\n            />\n          </div>\n    \n          \n          <div className=\"mb-4\">\n            <label htmlFor=\"card-number\" className=\"block text-sm font-medium text-gray-700\">Card Number</label>\n            <input\n              type=\"text\"\n              id=\"card-number\"\n              name=\"card-number\"\n              placeholder=\"1234 5678 9012 3456\"\n              className=\"mt-1 block w-full p-2 rounded-lg border-gray-300 focus500 focus500 shadow-sm\"\n              required\n              maxlength=\"19\"\n            />\n          </div>\n    \n          \n          <div className=\"flex gap-4\">\n            \n            <div className=\"mb-4 w-1/2\">\n              <label htmlFor=\"expiry-date\" className=\"block text-sm font-medium text-gray-700\">Expiry Date</label>\n              <input\n                type=\"text\"\n                id=\"expiry-date\"\n                name=\"expiry-date\"\n                placeholder=\"MM/YY\"\n                className=\"mt-1 block w-full p-2 rounded-lg border-gray-300 focus500 focus500 shadow-sm\"\n                required\n                maxlength=\"5\"\n              />\n            </div>\n    \n            \n            <div className=\"mb-4 w-1/2\">\n              <label htmlFor=\"cvv\" className=\"block text-sm font-medium text-gray-700\">CVV</label>\n              <input\n                type=\"text\"\n                id=\"cvv\"\n                name=\"cvv\"\n                placeholder=\"123\"\n                className=\"mt-1 block w-full p-2 rounded-lg border-gray-300 focus500 focus500 shadow-sm\"\n                required\n                maxlength=\"3\"\n              />\n            </div>\n          </div>\n    \n          \n          <div>\n            <button\n              type=\"submit\"\n              className=\"w-full bg-blue-600 text-white py-2 px-4 rounded-lg shadow hover700 transition\"\n            >\n              Submit\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n    </div>\n  );\n}\n",
