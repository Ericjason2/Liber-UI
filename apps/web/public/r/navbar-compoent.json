      "content": "/**\n * Component: Navbar compoent\n * Author: @amit (https://tailwindflex.com/@amit)\n * Source: https://tailwindflex.com/@amit/navbar-compoent\n * Attribution: Créé par @amit sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function NavbarCompoent() {\n  return (\n    <div>\n    <nav className=\"relative flex items-center justify-between sm10 md py-6 px-4 mt-2\">\r\n        <div className=\"flex items-center flex-1 md md0 md0\">\r\n            <div className=\"flex items-center justify-between w-full md\">\r\n                <a href=\"\" aria-label=\"Home\">\r\n                    <img src=\"https://www.svgrepo.com/show/491978/gas-costs.svg\" height=\"40\" width=\"40\" />\r\n                </a>\r\n                <div className=\"-mr-2 flex items-center md\">\r\n                    <button type=\"button\" id=\"main-menu\" aria-label=\"Main menu\" aria-haspopup=\"true\" className=\"inline-flex items-center justify-center p-2 rounded-md text-gray-400 hover500 hover100 focus focus100 focus500 transition duration-150 ease-in-out\">\r\n                        <svg stroke=\"currentColor\" fill=\"none\" viewBox=\"0 0 24 24\" className=\"h-6 w-6\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"M4 6h16M4 12h16M4 18h16\"></path></svg>\r\n                    </button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n        <div className=\"hidden md md10\">\r\n            <a href=\"#features\"\r\n                className=\"font-medium text-gray-500 hover900 transition duration-150 ease-in-out\">Features</a>\r\n            <a href=\"#pricing\"\r\n                className=\"font-medium text-gray-500 hover900 transition duration-150 ease-in-out\">Pricing</a>\r\n            <a href=\"/blog\"\r\n                className=\"font-medium text-gray-500 hover900 transition duration-150 ease-in-out\">Blog</a>\r\n            <a href=\"https://docs.pingping.io\" target=\"_blank\"\r\n                className=\"font-medium text-gray-500 hover900 transition duration-150 ease-in-out\">Docs</a>\r\n        </div>\r\n        <div className=\"hidden md md md md md0 md0\">\r\n            <span className=\"inline-flex\">\r\n                <a href=\"/login\" className=\"inline-flex items-center px-4 py-2 border border-transparent text-base leading-6 font-medium text-blue-600 hover500 focus transition duration-150 ease-in-out\">\r\n                  Login\r\n                </a>\r\n            </span>\r\n            <span className=\"inline-flex rounded-md shadow ml-2\">\r\n                <a href=\"/signup\" className=\"inline-flex items-center px-4 py-2 border border-transparent text-base leading-6 font-medium rounded-md text-white bg-blue-600 hover500 focus focus700 transition duration-150 ease-in-out\">\r\n                   Get started\r\n                </a>\r\n            </span>\r\n        </div>\r\n    </nav>\n    </div>\n  );\n}\n",
