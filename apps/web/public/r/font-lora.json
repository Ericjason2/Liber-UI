  "categories": [
    "serif"
  ],
  "dependencies": [
    "@fontsource-variable/lora"
  ],
  "files": [
    {
      "path": "styles/fonts/lora.css",
      "content": "/* Self-hosted font definition for Lora */\n@import \"@fontsource-variable/lora\";\n:root {\n  --font-serif: 'Lora', sans-serif;\n}\n",
      "type": "registry:style"
    }
  ],
  "meta": {
