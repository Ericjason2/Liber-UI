      "content": "import * as React from \"react\"\n\nfunction TotalBalanceOverview({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"total-balance-overview\"\n      className={className}\n      {...props}\n    >\n      <style>{\"@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');\\n        \\n        body {\\n            font-family: 'Inter', sans-serif;\\n            background-color: #f8fafc;\\n        }\\n        \\n        .card {\\n            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);\\n        }\\n        \\n        .gradient-bg {\\n            background: linear-gradient(90deg, #3b82f6 0%, #8b5cf6 100%);\\n        }\\n        \\n        .time-selector {\\n            transition: all 0.2s ease;\\n        }\\n        \\n        .time-selector.active {\\n            background-color: #3b82f6;\\n            color: white;\\n        }\"}</style>\n      <div className=\"card bg-white rounded-2xl p-6 w-full max-w-md\">\n      \n              <div className=\"flex justify-between items-start mb-6\">\n                  <div>\n                      <p className=\"text-gray-500 text-sm font-medium\">Total balance</p>\n                      <h1 className=\"text-3xl font-bold text-gray-800 mt-1\">$11,920</h1>\n                  </div>\n                  <div className=\"bg-green-50 text-green-700 px-3 py-1.5 rounded-full text-sm font-semibold flex items-center\">\n                      <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"h-4 w-4 mr-1\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                          <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"M5 10l7-7m0 0l7 7m-7-7v18\" />\n                      </svg>\n                      14.2%\n                  </div>\n              </div>\n              \n              \n              <div className=\"relative mb-6\">\n                  <canvas id=\"balanceChart\" height=\"180\"></canvas>\n              </div>\n              \n      \n              <div className=\"flex justify-between items-center mb-6\">\n                  <p className=\"text-gray-500 text-sm\">Jun 21</p>\n                  <p className=\"text-gray-800 font-semibold\">$608.21</p>\n              </div>\n              \n              <div className=\"flex justify-between bg-gray-100 p-1 rounded-lg\">\n                  <button className=\"time-selector active py-2 px-4 rounded-md text-sm font-medium\">1M</button>\n                  <button className=\"time-selector py-2 px-4 rounded-md text-sm font-medium\">3M</button>\n                  <button className=\"time-selector py-2 px-4 rounded-md text-sm font-medium\">6M</button>\n                  <button className=\"time-selector py-2 px-4 rounded-md text-sm font-medium\">1Y</button>\n                  <button className=\"time-selector py-2 px-4 rounded-md text-sm font-medium\">ALL</button>\n              </div>\n          </div>\n    </div>\n  )\n}\n\nexport { TotalBalanceOverview }\n",
      "type": "registry:ui"
    }
  ],
  "meta": {
    "kind": "component",
    "tags": [
      "card"
