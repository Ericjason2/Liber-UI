outline outline-1 outline-offset-[-1px] outline-black  overflow-hidden  text-[#898989] text-lg font-normal \" placeholder=\"Message\" cols=\"40\" rows=\"10\"></textarea>\n              </div>\n            </div>\n            <button className=\" px-9 py-5 bg-[#191a23] rounded-2xl  dark text-center dark[#191a23]  text-white text-xl font-normal  leading-7\">Send Message</button>\n          </div>\n        </div>\n      </section>\n    </div>\n  )\n}\n\nexport { ContactUsForm7 }\n",
