      "content": "/**\n * Component: Componentes para mi empresa\n * Author: @psychokillerdd (https://tailwindflex.com/@psychokillerdd)\n * Source: https://tailwindflex.com/@psychokillerdd/componentes-para-mi-empresa\n * Attribution: Créé par @psychokillerdd sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function ComponentesParaMiEmpresa() {\n  return (\n    <div>\n    <button className=\"bg-[#0070F3] text-white font-medium py-2 px-4 rounded hover600 transition\">\n      Cotiza tu sitio\n    </button>\n    <button className=\"bg-black text-white border border-white py-2 px-4 rounded hover hover transition\">\n      Más información\n    </button>\n    \n    <div className=\"bg-white text-black p-6 rounded-xl shadow-md border border-gray-light\">\n      <h3 className=\"text-lg font-semibold mb-2\">Software a medida</h3>\n      <p className=\"text-gray-default text-sm\">Desarrollamos soluciones según tus necesidades.</p>\n    </div>\n    \n    <nav className=\"bg-black text-white flex justify-between items-center px-6 py-4\">\n      <div className=\"text-xl font-bold\">MiMarca</div>\n      <div className=\"space-x-6\">\n        <a href=\"#\" className=\"hover\">Inicio</a>\n        <a href=\"#\" className=\"hover\">Servicios</a>\n        <a href=\"#\" className=\"hover\">Contacto</a>\n      </div>\n    </nav>\n    <input type=\"text\" placeholder=\"Tu correo\" className=\"bg-black border border-gray-light text-white px-4 py-2 rounded-md placeholder-gray-default focus focus transition\" />\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
