.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z\"\n                                clipRule=\"evenodd\"></path>\n                        </svg>\n                        <span><span className=\"font-semibold\">5</span> Custom Features</span>\n                    </li>\n                    \n                </ul>\n                <a href=\"\"\n                    className=\"text-white bg-teal-600 hover700 focus4 focus200 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark  dark900\">Get\n                    started</a>\n            </div>\n    \n            \n            <div\n                className=\"flex flex-col p-6 mx-auto max-w-lg text-center text-gray-900 bg-white rounded-lg border border-gray-100 shadow dark600 xl8 dark800 dark\">\n                <h3 className=\"mb-4 text-2xl font-semibold\">Service C</h3>\n                <p className=\"font-light text-gray-500 sm dark400\">Best for large enterprises seeking\n                    comprehensive solutions</p>\n                <div className=\"flex justify-center items-baseline my-8\">\n                    <span className=\"mr-2 text-5xl font-extrabold\">$199</span>\n                    <span className=\"text-gray-500 dark400\">/month</span>\n                </div>\n                \n                <ul role=\"list\" className=\"mb-8 space-y-4 text-left\">\n                    <li className=\"flex items-center space-x-3\">\n                        \n                        <svg className=\"flex-shrink-0 w-5 h-5 text-green-500 dark400\" fill=\"currentColor\"\n                            viewBox=\"0 0 20 20\" xmlns=\"http://www.w3.org/2000/svg\">\n                            <path fillRule=\"evenodd\"\n                                d=\"M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z\"\n                                clipRule=\"evenodd\"></path>\n                        </svg>\n                        <span><span 