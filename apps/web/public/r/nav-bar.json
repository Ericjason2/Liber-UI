      "content": "/**\n * Component: Nav Bar\n * Author: @sammytg7 (https://tailwindflex.com/@sammytg7)\n * Source: https://tailwindflex.com/@sammytg7/nav-bar\n * Attribution: Créé par @sammytg7 sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function NavBar() {\n  return (\n    <div>\n    <link rel=\"stylesheet\" href=\"https://unicons.iconscout.com/release/v4.0.0/css/line.css\" />\r\n    <div className=\"w-full h-screen dark900\">\r\n        \r\n        <nav className=\"fixed top-0 left-0 w-full h-20 grid place-items-center z-50 transition-all bg-[#003347]\">\r\n            <div className=\"container mx-auto flex justify-between items-center h-full px-6\">\r\n                \r\n                <a href=\"/\" className=\"w-12\">\r\n                    <img src=\"https://tailwindflex.com/images/logo.svg\" alt=\"nav logo\" className=\"object-cover object-center\" />\r\n                </a>\r\n    \r\n                \r\n                <ul className=\"hidden lg gap-16 text-white\">\r\n                    <li><a href=\"\" className=\"hover[#ff7b02] transition-colors\">Home</a></li>\r\n                    <li><a href=\"\" className=\"hover[#ff7b02] transition-colors\">About</a></li>\r\n                    <li><a href=\"\" className=\"hover[#ff7b02] transition-colors\">Services</a></li>\r\n                    <li><a href=\"\" className=\"hover[#ff7b02] transition-colors\">Resources</a></li>\r\n                    <li><a href=\"\" className=\"hover[#ff7b02] transition-colors\">Contact</a></li>\r\n                </ul>\r\n    \r\n                \r\n                <ul className=\"hidden lg gap-4\">\r\n                    <li>\r\n                        <a href=\"https://instagram.com\" target=\"_blank\"\r\n                            className=\"w-8 h-8 grid place-items-center text-[#003347] bg-gradient-to-b from-[#e5a55d] to-[#ff7b02] rounded-lg hover\">\r\n                            <i className=\"uil uil-instagram\"></i>\r\n                        </a>\r\n                    </li>\r\n                    <li>\r\n                        <a href=\"https://twitter.com\" target=\"_blank\"\r\n                            className=\"w-8 h-8 grid place-items-center text-[#003347] bg-gradient-to-b from-[#e5a55d] to-[#ff7b02] rounded-lg hover\">\r\n                            <i className=\"uil uil-twitter\"></i>\r\n                        </a>\r\n                    </li>\r\n                    <li>\r\n                        <a href=\"https://youtube.com\" target=\"_blank\"\r\n                            className=\"w-8 h-8 grid place-items-center text-[#003347] bg-gradient-to-b from-[#e5a55d] to-[#ff7b02] rounded-lg hover\">\r\n                            <i className=\"uil uil-youtube\"></i>\r\n                        </a>\r\n                    </li>\r\n                </ul>\r\n    \r\n                \r\n                <button className=\"block lg text-3xl text-white\" id=\"nav__toggle-open\">\r\n                    <i className=\"uil uil-bars\"></i>\r\n                </button>\r\n                <button className=\"hidden lg text-3xl text-white\" id=\"nav__toggle-close\">\r\n                    <i className=\"uil uil-multiply\"></i>\r\n                </button>\r\n            </div>\r\n        </nav>\r\n    \r\n        \r\n        <ul className=\"absolute top-[4rem] right-0  text-white flex-col hidden lg w-48 shadow-lg\" id=\"mobile-nav\">\r\n            <li\r\n                className=\"h-20 shadow-[-3rem_3rem_3rem_rgba(0,0,0,0.7)] bg-[#003347] hover[#003347]/80 animate-navAnimation [animation-delay:0ms]\">\r\n                <a href=\"\" className=\"flex items-center h-full px-6\">Home</a>\r\n            </li>\r\n            <li\r\n                className=\"h-20 shadow-[-3rem_3rem_3rem_rgba(0,0,0,0.7)] bg-[#003347] hover[#003347]/80 animate-navAnimation [animation-delay:200ms]\">\r\n                <a href=\"\" className=\"flex items-center h-full px-6\">About</a>\r\n            </li>\r\n            <li\r\n                className=\"h-20 shadow-[-3rem_3rem_3rem_rgba(0,0,0,0.7)] bg-[#003347] hover[#003347]/80 animate-navAnimation [animation-delay:400ms]\">\r\n                <a href=\"\" className=\"flex items-center h-full px-6\">Services</a>\r\n            </li>\r\n            <li\r\n                className=\"h-20 shadow-[-3rem_3rem_3rem_rgba(0,0,0,0.7)] bg-[#003347] hover[#003347]/80 animate-navAnimation [animation-delay:600ms]\">\r\n                <a href=\"\" className=\"flex items-center h-full px-6\">Resources</a>\r\n            </li>\r\n            <li\r\n                className=\"h-20 shadow-[-3rem_3rem_3rem_rgba(0,0,0,0.7)] bg-[#003347] hover[#003347]/80 animate-navAnimation [animation-delay:600ms]\">\r\n                <a href=\"\" className=\"flex items-center h-full px-6\">Contact</a>\r\n            </li>\r\n        </ul>\r\n        \r\n    </div>\r\n    \r\n    \r\n    \r\n    \r\n    \n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
  ],
