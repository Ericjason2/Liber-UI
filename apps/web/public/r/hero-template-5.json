 h-5\\\" fill=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\"><path d=\\\"M12 2L2 12l10 10 10-10L12 2zm0 15l-5-5 5-5 5 5-5 5z\\\"/></svg><span class=\\\"font-bold text-xl tracking-tight\\\">exon</span></div>\\n            <div class=\\\"flex items-center gap-1 font-serif-italic\\\"><span class=\\\"text-xl\\\">&lt;elio</span></div>\\n            <div class=\\\"flex items-center gap-1\\\"><span class=\\\"font-bold text-xl tracking-tight\\\">attracts</span><span class=\\\"text-xs border border-white rounded-full w-4 h-4 flex items-center justify-center\\\">c</span></div>\\n            <div class=\\\"font-light text-xl tracking-wide\\\">relax.</div>\\n            <div class=\\\"flex items-center gap-1 font-bold text-xl\\\"><svg class=\\\"w-5 h-5 rotate-45\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\"><path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" stroke-width=\\\"3\\\" d=\\\"M4 6h16M4 12h16M4 18h16\\\"/></svg>olab</div>\\n        </div>\\n    </div>\\n\\n    \\n</body>\\n</html>\" }} />\n  );\n}\n",
