    "rawHtml": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>MetroRide Full Width</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@1,400;1,500&display=swap\" rel=\"stylesheet\">\n    <style>\n        body { font-family: 'Inter', sans-serif; }\n        .font-serif-italic { font-family: 'Playfair Display', serif; font-style: italic; }\n        .text-accent { color: #FF6B35; }\n        .bg-accent { background-color: #FF6B35; }\n        \n        /* Animación para el menú móvil */\n        #mobile-menu {\n            transition: transform 0.3s ease-in-out;\n            transform: translateY(-100%);\n        }\n        #mobile-menu.open {\n            transform: translateY(0);\n        }\n    </style>\n</head>\n<body class=\"bg-white text-[#111] overflow-x-hidden\">\n\n    <header class=\"fixed top-0 left-0 w-full bg-white/90 backdrop-blur-md z-50 border-b border-transparent transition-all duration-300\" id=\"navbar\">\n        <div class=\"max-w-[1400px] mx-auto px-6 h-20 flex justify-between items-center\">\n            \n            <div class=\"flex items-center gap-4 md:gap-8\">\n                <div class=\"text-2xl font-bold tracking-tight z-50 relative\">Metro<span class=\"font-normal italic font-serif-italic\">Ride</span></div>\n                \n                <div class=\"hidden sm:flex items-center gap-2 border border-gray-200 rounded-full px-4 py-1.5 text-xs text-gray-600\">\n                    <span>Local Time</span>\n                    <div class=\"w-1 h-1 bg-black rounded-full\"></div>\n                    <span id=\"clock\">12:32:04 pm</span>\n                </div>\n            </div>\n\n            <nav class=\"hidden md:flex items-center gap-8 text-sm font-medium text-gray-800\">\n                <a href=\"#\" class=\"text-black\">Home</a>\n                <a href=\"#\" class=\"text-accent\">About</a>\n                <a href=\"#\" class=\"hover:text-black transition\">Services</a>\n                <button class=\"flex items-center gap-1 hover:text-black transition\">\n                    Pages <svg class=\"w-3 h-3\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\"></path></svg>\n                </button>\n                <a href=\"#\" class=\"hover:text-black transition\">Contact</a>\n            </nav>\n\n            <div class=\"hidden md:flex items-center\">\n                <a href=\"#\" class=\"bg-black text-white px-6 py-2.5 rounded-full text-sm font-medium hover:bg-gray-800 transition flex items-center gap-2\">\n                    Book a Call \n                    <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17 8l4 4m0 0l-4 4m4-4H3\"></path></svg>\n                </a>\n            </div>\n\n            <button id=\"menu-btn\" class=\"md:hidden z-50 p-2 focus:outline-none\">\n                <svg class=\"w-6 h-6 text-black\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 6h16M4 12h16m-7 6h7\"></path></svg>\n            </button>\n        </div>\n    </header>\n\n    <div id=\"mobile-menu\" class=\"fixed inset-0 bg-white z-40 flex flex-col justify-center items-center text-center space-y-8 pt-20\">\n        <a href=\"#\" class=\"text-2xl font-light hover:text-accent transition\">Home</a>\n        <a href=\"#\" class=\"text-2xl font-light text-accent transition\">About</a>\n        <a href=\"#\" class=\"text-2xl font-light hover:text-accent transition\">Services</a>\n        <a href=\"#\" class=\"text-2xl font-light hover:text-accent transition\">Pages</a>\n        <a href=\"#\" class=\"text-2xl font-light hover:text-accent transition\">Contact</a>\n        <a href=\"#\" class=\"bg-black text-white px-8 py-3 rounded-full text-lg font-medium mt-4 inline-flex items-center gap-2\">\n            Book a Call \n            <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17 8l4 4m0 0l-4 4m4-4H3\"></path></svg>\n        </a>\n    </div>\n\n    <div class=\"pt-28 md:pt-32\"> <main class=\"max-w-[1400px] mx-auto px-6\">\n\n            <div class=\"grid grid-cols-2 md:grid-cols-4 gap-8 mb-20 md:mb-32\">\n                <div class=\"flex flex-col gap-2\">\n                    <span class=\"text-4xl md:text-5xl font-light tracking-tight\">282<span class=\"text-accent text-3xl align-top\">+</span></span>\n                    <div class=\"border-t border-gray-200 pt-2 w-24\">\n                        <p class=\"text-[10px] uppercase tracking-widest text-gray-500 font-medium\">Total Bookings</p>\n                    </div>\n                </div>\n                <div class=\"flex flex-col gap-2\">\n                    <span class=\"text-4xl md:text-5xl font-light tracking-tight\">152<span class=\"text-accent text-3xl align-top\">+</span></span>\n                    <div class=\"border-t border-gray-200 pt-2 w-24\">\n                        <p class=\"text-[10px] uppercase tracking-widest text-gray-500 font-medium\">Cars in Stock</p>\n                    </div>\n                </div>\n                <div class=\"flex flex-col gap-2\">\n                    <span class=\"text-4xl md:text-5xl font-light tracking-tight\">08<span class=\"text-accent text-3xl align-top\">+</span></span>\n                    <div class=\"border-t border-gray-200 pt-2 w-24\">\n                        <p class=\"text-[10px] uppercase tracking-widest text-gray-500 font-medium\">Years of Experience</p>\n                    </div>\n                </div>\n                <div class=\"hidden md:flex flex-col items-end gap-3 text-xs md:col-start-4\">\n                    <a href=\"#\" class=\"underline decoration-gray-300 underline-offset-4 hover:decoration-black transition\">Facebook</a>\n                    <a href=\"#\" class=\"underline decoration-gray-300 underline-offset-4 hover:decoration-black transition\">Instagram</a>\n                    <a href=\"#\" class=\"underline decoration-gray-300 underline-offset-4 hover:decoration-black transition\">Twitter ( X )</a>\n                    <a href=\"#\" class=\"underline decoration-gray-300 underline-offset-4 hover:decoration-black transition\">Linkedin</a>\n                </div>\n            </div>\n\n            <div class=\"relative mb-12 z-10\">\n                <h1 class=\"text-5xl md:text-7xl lg:text-[7rem] leading-[1.1] tracking-tight text-gray-900\">\n                    <span class=\"block\">\n                        Redefining \n                        <span class=\"font-serif-italic font-normal ml-2 md:ml-4\">Car</span>\n                    </span>\n                    <span class=\"block\">\n                        <span class=\"font-serif-italic font-normal mr-2 md:mr-4\">Rentals with</span>\n                        Luxury\n                    </span>\n                </h1>\n\n                <div class=\"absolute right-0 top-1/2 -translate-y-1/2 hidden md:flex flex-col items-center justify-center w-24 h-24 border border-gray-200 rounded-full hover:border-gray-400 transition cursor-pointer bg-white z-20\">\n                    <svg class=\"w-5 h-5 text-accent mb-1\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 14l-7 7m0 0l-7-7m7 7V3\"></path></svg>\n                    <span class=\"text-[10px] uppercase tracking-widest\">Scroll</span>\n                </div>\n            </div>\n\n        </main> <div class=\"w-full h-[50vh] md:h-[80vh] bg-gray-900 overflow-hidden relative group\">\n            <img src=\"https://images.unsplash.com/photo-1617788138017-80ad40651399?q=80&w=2500&auto=format&fit=crop\" \n                 alt=\"Luxury SUV\" \n                 class=\"w-full h-full object-cover opacity-90 transition-transform duration-1000 group-hover:scale-105 origin-center\">\n            \n            <div class=\"absolute bottom-0 left-0 w-full h-1/2 bg-gradient-to-t from-black/40 to-transparent\"></div>\n        </div>\n\n    </div>\n\n    <div class=\"bg-accent py-10\">\n        <div class=\"max-w-[1400px] mx-auto px-6 flex flex-wrap justify-center md:justify-between items-center gap-8 md:gap-12 text-white\">\n            <div class=\"flex items-center gap-1\"><span class=\"font-bold text-xl tracking-tight\">attracts</span><span class=\"text-xs border border-white rounded-full w-4 h-4 flex items-center justify-center\">c</span></div>\n            <div class=\"flex items-center gap-1\"><svg class=\"w-5 h-5\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M12 2L2 12l10 10 10-10L12 2zm0 15l-5-5 5-5 5 5-5 5z\"/></svg><span class=\"font-bold text-xl tracking-tight\">exon</span></div>\n            <div class=\"flex items-center gap-1 font-serif-italic\"><span class=\"text-xl\">&lt;elio</span></div>\n            <div class=\"flex items-center gap-1\"><span class=\"font-bold text-xl tracking-tight\">attracts</span><span class=\"text-xs border border-white rounded-full w-4 h-4 flex items-center justify-center\">c</span></div>\n            <div class=\"font-light text-xl tracking-wide\">relax.</div>\n            <div class=\"flex items-center gap-1 font-bold text-xl\"><svg class=\"w-5 h-5 rotate-45\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"3\" d=\"M4 6h16M4 12h16M4 18h16\"/></svg>olab</div>\n        </div>\n    </div>\n\n    <script>\n        // Reloj\n        function updateClock() {\n            const now = new Date();\n            let hours = now.getHours();\n            const ampm = hours >= 12 ? 'pm' : 'am';\n            hours = hours % 12;\n            hours = hours ? hours : 12; \n            const minutes = now.getMinutes().toString().padStart(2, '0');\n            const seconds = now.getSeconds().toString().padStart(2, '0');\n            document.getElementById('clock').innerText = `${hours}:${minutes}:${seconds} ${ampm}`;\n        }\n        setInterval(updateClock, 1000);\n        updateClock();\n\n        // Lógica del Menú Móvil\n        const menuBtn = document.getElementById('menu-btn');\n        const mobileMenu = document.getElementById('mobile-menu');\n        const menuIcon = menuBtn.querySelector('svg path');\n        let isMenuOpen = false;\n\n        menuBtn.addEventListener('click', () => {\n            isMenuOpen = !isMenuOpen;\n            if(isMenuOpen) {\n                mobileMenu.classList.add('open');\n                // Cambiar icono a X\n                menuIcon.setAttribute('d', 'M6 18L18 6M6 6l12 12');\n            } else {\n                mobileMenu.classList.remove('open');\n                // Cambiar icono a Hamburguesa\n                menuIcon.setAttribute('d', 'M4 6h16M4 12h16m-7 6h7');\n            }\n        });\n\n        // Efecto scroll en Navbar\n        window.addEventListener('scroll', () => {\n            const navbar = document.getElementById('navbar');\n            if (window.scrollY > 50) {\n                navbar.classList.add('shadow-sm');\n            } else {\n                navbar.classList.remove('shadow-sm');\n            }\n        });\n    </script>\n</body>\n</html>"
  }
}
