      "content": "import * as React from \"react\"\n\nfunction LoginTemplate({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"login-template\"\n      className={className}\n      {...props}\n    >\n      \n          <div className=\"h-screen bg-gradient-to-br from-blue-600 to-cyan-300 flex justify-center items-center w-full\">\n              \n              <form method='POST' action='#'>\n                  <div className=\"bg-white px-10 py-8 rounded-xl w-screen shadow-xl max-w-sm\">\n                      <div className=\"space-y-4\">\n                          <h1 className=\"text-center text-2xl font-semibold text-gray-600\">Login</h1>\n                          <hr />\n                      <div className=\"flex items-center border-2 py-2 px-3 rounded-md mb-4\">\n                          <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"h-5 w-5 text-gray-400\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                              <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207\" />\n                          </svg>\n                          <input className=\"pl-2 outline-none border-none w-full\" type=\"email\" name=\"email\" value=\"\" placeholder=\"Email\" required/>\n      \n                      </div>\n                      <div className=\"flex items-center border-2 py-2 px-3 rounded-md\">\n                          <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"h-5 w-5 text-gray-400\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\n                          <path fillRule=\"evenodd\" d=\"M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z\" clipRule=\"evenodd\" />\n                          </svg>\n                          <input className=\"pl-2 outline-none border-none w-full\" type=\"password\" name=\"password\" id=\"\" placeholder=\"Password\" required/>\n                          \n                      </div>\n                      </div>\n                      \n                      <div className=\"flex justify-center items-center mt-4\">\n                          <p className=\"inline-flex items-center text-gray-700 font-medium text-xs text-center\">\n                              <input type=\"checkbox\" id=\"rememberMeCheckbox\" name=\"rememberMe\" className=\"mr-2\" />\n                              <span className=\"text-xs font-semibold\">Remember me?</span>\n                          </p>\n                      </div>\n      \n                      <button type=\"submit\" value=\"login\" id=\"login\" className=\"mt-6 w-full shadow-xl bg-gradient-to-tr from-blue-600 to-red-400 hover:to-red-700 text-indigo-100 py-2 rounded-md text-lg tracking-wide transition duration-1000\">Login</button>\n                      <hr />\n                      <div className=\"flex justify-center items-center mt-4\">\n                          <p className=\"inline-flex items-center text-gray-700 font-medium text-xs text-center\">\n                              <span className=\"ml-2\">You don't have an account?<a href=\"#\" className=\"text-xs ml-2 text-blue-500 font-semibold\">Register now &rarr;</a>\n                              </span>\n                          </p>\n                      </div>\n                  </div>\n                  <div className=\"pt-6 text-base font-semibold leading-7\">\n                      <p className=\"font-sans text-red-500 text-md hover:text-red-800\">\n                      <a href=\"/\" className=\"absolute\">&larr; Home</a>\n                      </p>\n                  </div>\n              </form>\n          </div>\n    </div>\n  )\n}\n\nexport { LoginTemplate }\n",
      "type": "registry:ui"
    }
  ],
  "meta": {
