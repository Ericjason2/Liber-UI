    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <title>Quest Log Full Page</title>\n</head>\n<body class=\"min-h-screen bg-slate-950 text-slate-100 flex items-center justify-center\">\n\n  <!-- Full Page Quest Log -->\n  <section class=\"w-full h-screen rounded-none border border-slate-800 bg-slate-900/70 p-8 overflow-y-auto\">\n    <div class=\"flex items-center justify-between border-b border-slate-800 pb-4\">\n      <h1 class=\"text-2xl font-bold\">Quest Log</h1>\n      <span class=\"text-sm text-slate-400\">3 Active</span>\n    </div>\n\n    <ul class=\"mt-6 space-y-5\">\n      <!-- Quest Item -->\n      <li class=\"rounded-2xl border border-slate-800 bg-slate-900/40 p-5\">\n        <div class=\"flex items-center justify-between\">\n          <h2 class=\"text-lg font-semibold text-indigo-300\">The Lost Shard</h2>\n          <span class=\"text-xs text-emerald-400\">Active</span>\n        </div>\n        <p class=\"text-sm text-slate-400 mt-2\">Find the hidden shard in the Crystal Plains.</p>\n        <div class=\"mt-3 h-2 w-full rounded-full bg-slate-800 overflow-hidden\">\n          <div class=\"h-full w-2/3 bg-gradient-to-r from-indigo-500 to-fuchsia-500\"></div>\n        </div>\n      </li>\n\n      <!-- Quest Item -->\n      <li class=\"rounded-2xl border border-slate-800 bg-slate-900/40 p-5\">\n        <div class=\"flex items-center justify-between\">\n          <h2 class=\"text-lg font-semibold text-fuchsia-300\">Wolves of the East Ridge</h2>\n          <span class=\"text-xs text-yellow-300\">In Progress</span>\n        </div>\n        <p class=\"text-sm text-slate-400 mt-2\">Defeat 5 wolves guarding the ridge path.</p>\n        <div class=\"mt-3 h-2 w-full rounded-full bg-slate-800 overflow-hidden\">\n          <div class=\"h-full w-1/2 bg-gradient-to-r from-rose-500 to-red-500\"></div>\n        </div>\n      </li>\n\n      <!-- Quest Item -->\n      <li class=\"rounded-2xl border border-slate-800 bg-slate-900/40 p-5\">\n        <div class=\"flex items-center justify-between\">\n          <h2 class=\"text-lg font-semibold text-emerald-300\">Echoes of the Ruins</h2>\n          <span class=\"text-xs text-slate-400\">Not Started</span>\n        </div>\n        <p class=\"text-sm text-slate-400 mt-2\">Explore the abandoned ruins and recover relics.</p>\n        <div class=\"mt-3 h-2 w-full rounded-full bg-slate-800\"></div>\n      </li>\n    </ul>\n  </section>\n\n</body>\n</html>"
