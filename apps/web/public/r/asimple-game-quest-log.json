      "content": "import * as React from \"react\"\n\nfunction AsimpleGameQuestLog({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"asimple-game-quest-log\"\n      className={className}\n      {...props}\n    >\n      \n        <section className=\"w-full h-screen rounded-none border border-slate-800 bg-slate-900/70 p-8 overflow-y-auto\">\n          <div className=\"flex items-center justify-between border-b border-slate-800 pb-4\">\n            <h1 className=\"text-2xl font-bold\">Quest Log</h1>\n            <span className=\"text-sm text-slate-400\">3 Active</span>\n          </div>\n      \n          <ul className=\"mt-6 space-y-5\">\n            \n            <li className=\"rounded-2xl border border-slate-800 bg-slate-900/40 p-5\">\n              <div className=\"flex items-center justify-between\">\n                <h2 className=\"text-lg font-semibold text-indigo-300\">The Lost Shard</h2>\n                <span className=\"text-xs text-emerald-400\">Active</span>\n              </div>\n              <p className=\"text-sm text-slate-400 mt-2\">Find the hidden shard in the Crystal Plains.</p>\n              <div className=\"mt-3 h-2 w-full rounded-full bg-slate-800 overflow-hidden\">\n                <div className=\"h-full w-2/3 bg-gradient-to-r from-indigo-500 to-fuchsia-500\"></div>\n              </div>\n            </li>\n      \n            \n            <li className=\"rounded-2xl border border-slate-800 bg-slate-900/40 p-5\">\n              <div className=\"flex items-center justify-between\">\n                <h2 className=\"text-lg font-semibold text-fuchsia-300\">Wolves of the East Ridge</h2>\n                <span className=\"text-xs text-yellow-300\">In Progress</span>\n              </div>\n              <p className=\"text-sm text-slate-400 mt-2\">Defeat 5 wolves guarding the ridge path.</p>\n              <div className=\"mt-3 h-2 w-full rounded-full bg-slate-800 overflow-hidden\">\n                <div className=\"h-full w-1/2 bg-gradient-to-r from-rose-500 to-red-500\"></div>\n              </div>\n            </li>\n      \n            \n            <li className=\"rounded-2xl border border-slate-800 bg-slate-900/40 p-5\">\n              <div className=\"flex items-center justify-between\">\n                <h2 className=\"text-lg font-semibold text-emerald-300\">Echoes of the Ruins</h2>\n                <span className=\"text-xs text-slate-400\">Not Started</span>\n              </div>\n              <p className=\"text-sm text-slate-400 mt-2\">Explore the abandoned ruins and recover relics.</p>\n              <div className=\"mt-3 h-2 w-full rounded-full bg-slate-800\"></div>\n            </li>\n          </ul>\n        </section>\n    </div>\n  )\n}\n\nexport { AsimpleGameQuestLog }\n",
      "type": "registry:ui"
    }
