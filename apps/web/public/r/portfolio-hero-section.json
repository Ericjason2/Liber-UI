    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Kuldeep Prajapati | Full Stack Developer</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css\"/>\n    <script>\n        tailwind.config = {\n            darkMode: 'class',\n            theme: {\n                extend: {\n                    fontFamily: {\n                        inter: ['Inter', 'sans-serif'],\n                    },\n                    colors: {\n                        dark: '#0f172a',\n                        darker: '#020617',\n                        primary: '#6366f1',\n                        secondary: '#8b5cf6',\n                        accent: '#ec4899',\n                    },\n                    animation: {\n                        'float': 'float 6s ease-in-out infinite',\n                        'pulse-slow': 'pulse 4s cubic-bezier(0.4, 0, 0.6, 1) infinite',\n                    },\n                    keyframes: {\n                        float: {\n                            '0%, 100%': { transform: 'translateY(0)' },\n                            '50%': { transform: 'translateY(-15px)' },\n                        }\n                    }\n                }\n            }\n        }\n    </script>\n    <style type=\"text/tailwindcss\">\n        @layer utilities {\n            .text-gradient {\n                @apply bg-clip-text text-transparent bg-gradient-to-r from-primary to-accent;\n            }\n            .shadow-glow {\n                box-shadow: 0 0 25px -5px rgba(99, 102, 241, 0.3);\n            }\n            .shadow-glow-hover:hover {\n                box-shadow: 0 0 30px -5px rgba(99, 102, 241, 0.5);\n            }\n        }\n    </style>\n</head>\n<body class=\"font-inter bg-darker text-gray-200\">\n    <!-- Hero Section -->\n    <section class=\"relative overflow-hidden\">\n        <!-- Animated Background Elements -->\n        <div class=\"absolute inset-0 overflow-hidden -z-10\">\n            <div class=\"absolute top-20 left-20 w-40 h-40 rounded-full bg-primary/10 blur-xl animate-float\"></div>\n            <div class=\"absolute bottom-20 right-20 w-40 h-40 rounded-full bg-secondary/10 blur-xl animate-float\"></div>\n            <div class=\"absolute top-1/3 right-1/4 w-24 h-24 rounded-full bg-accent/10 blur-lg animate-float\"></div>\n        </div>\n\n        <!-- Main Content -->\n        <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-28\">\n            <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-12 items-center\">\n                <!-- Left Content -->\n                <div class=\"text-center lg:text-left\">\n                    <span class=\"inline-block px-3 py-1 text-xs font-semibold tracking-wider text-primary uppercase rounded-full bg-primary/10 mb-4\">\n                        Full Stack Developer\n                    </span>\n                    <h1 class=\"text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight mb-4\">\n                        Hi, I'm <span class=\"text-gradient\">Kuldeep Prajapati</span>\n                    </h1>\n                    <p class=\"text-xl text-gray-400 mb-8 max-w-lg\">\n                        I build <span class=\"font-semibold text-primary\">scalable web apps</span> with modern technologies like <span class=\"font-semibold text-secondary\">React, Node.js & MongoDB</span>.\n                    </p>\n                    <div class=\"flex flex-col sm:flex-row gap-4 justify-center lg:justify-start\">\n                        <a href=\"#\" class=\"px-8 py-3.5 rounded-lg bg-gradient-to-r from-primary to-secondary text-white font-semibold shadow-glow hover:shadow-glow-hover transition-all duration-300\">\n                            View My Work\n                        </a>\n                        <a href=\"#\" class=\"px-8 py-3.5 rounded-lg border-2 border-primary/30 text-gray-300 font-semibold hover:bg-primary/5 hover:border-primary/50 transition-all duration-300\">\n                            Contact Me\n                        </a>\n                    </div>\n\n                    <!-- Tech Stack Badges -->\n                    <div class=\"mt-12 flex flex-wrap justify-center lg:justify-start gap-3\">\n                        <span class=\"px-3 py-1 text-sm rounded-full bg-dark border border-gray-800\">React.js</span>\n                        <span class=\"px-3 py-1 text-sm rounded-full bg-dark border border-gray-800\">Node.js</span>\n                        <span class=\"px-3 py-1 text-sm rounded-full bg-dark border border-gray-800\">MongoDB</span>\n                        <span class=\"px-3 py-1 text-sm rounded-full bg-dark border border-gray-800\">Tailwind CSS</span>\n                        <span class=\"px-3 py-1 text-sm rounded-full bg-dark border border-gray-800\">Python</span>\n                    </div>\n                </div>\n\n                <!-- Right Content - Profile Image -->\n                <div class=\"relative flex justify-center lg:justify-end\">\n                    <div class=\"relative group\">\n                        <!-- Gradient Border Effect -->\n                        <div class=\"absolute -inset-1 bg-gradient-to-r from-primary to-accent rounded-2xl blur-md opacity-75 group-hover:opacity-100 transition-all duration-300\"></div>\n                        <!-- Profile Image -->\n                        <div class=\"relative h-64 w-64 sm:h-80 sm:w-80 rounded-2xl overflow-hidden border-2 border-gray-800 bg-gradient-to-br from-gray-900 to-gray-800\">\n                            <img \n                                src=\"https://avatars.githubusercontent.com/u/124576166?v=4\" \n                                alt=\"Kuldeep Prajapati\" \n                                class=\"w-full h-full object-cover\"\n                            />\n                            <!-- Glow Effect on Hover -->\n                            <div class=\"absolute inset-0 bg-primary/10 opacity-0 group-hover:opacity-100 transition-all duration-300\"></div>\n                        </div>\n                        <!-- Floating Badge -->\n                        <div class=\"absolute -bottom-5 -right-5 bg-dark border border-gray-800 px-4 py-2 rounded-lg shadow-lg\">\n                            <span class=\"text-sm font-medium\">🚀 Open for Work</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n</body>\n</html>"
