    "rawHtml": "<section class=\"text-gray-600 body-font relative\">\n  <div class=\"container px-5 py-24 mx-auto\">\n    <div class=\"flex flex-col text-center w-full mb-12\">\n      <h1 class=\"sm:text-3xl text-2xl font-medium title-font mb-4 text-gray-900\">Contact Us</h1>\n      <p class=\"lg:w-2/3 mx-auto leading-relaxed text-base\">Please get in touch</p>\n    </div>\n    <form action=\"https://fabform.io/f/{form-id}\" method=\"post\">\n    <div class=\"lg:w-1/2 md:w-2/3 mx-auto\">\n      <div class=\"flex flex-wrap -m-2\">\n        <div class=\"p-2 w-1/2\">\n          <div class=\"relative\">\n            <label for=\"name\" class=\"leading-7 text-sm text-gray-600\">Name</label>\n            <input type=\"text\" id=\"name\" name=\"name\" class=\"w-full bg-gray-100 bg-opacity-50 rounded border border-gray-300 focus:border-indigo-500 focus:bg-white focus:ring-2 focus:ring-indigo-200 text-base outline-none text-gray-700 py-1 px-3 leading-8 transition-colors duration-200 ease-in-out\">\n          </div>\n        </div>\n        <div class=\"p-2 w-1/2\">\n          <div class=\"relative\">\n            <label for=\"email\" class=\"leading-7 text-sm text-gray-600\">Email</label>\n            <input type=\"email\" id=\"email\" name=\"email\" class=\"w-full bg-gray-100 bg-opacity-50 rounded border border-gray-300 focus:border-indigo-500 focus:bg-white focus:ring-2 focus:ring-indigo-200 text-base outline-none text-gray-700 py-1 px-3 leading-8 transition-colors duration-200 ease-in-out\">\n          </div>\n        </div>\n        <div class=\"p-2 w-full\">\n          <div class=\"relative\">\n            <label for=\"message\" class=\"leading-7 text-sm text-gray-600\">Message</label>\n            <textarea id=\"message\" name=\"message\" class=\"w-full bg-gray-100 bg-opacity-50 rounded border border-gray-300 focus:border-indigo-500 focus:bg-white focus:ring-2 focus:ring-indigo-200 h-32 text-base outline-none text-gray-700 py-1 px-3 resize-none leading-6 transition-colors duration-200 ease-in-out\"></textarea>\n          </div>\n        </div>\n        <div class=\"p-2 w-full\">\n          <button class=\"flex mx-auto text-white bg-indigo-500 border-0 py-2 px-8 focus:outline-none hover:bg-indigo-600 rounded text-lg\">Send  </button>\n        </div>\n        <div class=\"p-2 w-full pt-8 mt-8 border-t border-gray-200 text-center\">\n          <a class=\"text-indigo-500\" href=\" https://veilmail.io/irish-geoff\"\n>If you don't like forms click to reveal email address https://veilmail.io/irish-geoff</a>\n          <p class=\"leading-normal my-5\">49 Smith St.\n            <br>Saint Cloud, MN 56301\n          </p>\n          <span class=\"inline-flex\">\n            <a class=\"text-gray-500\">\n              <svg fill=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" class=\"w-5 h-5\" viewBox=\"0 0 24 24\">\n                <path d=\"M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z\"></path>\n              </svg>\n            </a>\n            <a class=\"ml-4 text-gray-500\">\n              <svg fill=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" class=\"w-5 h-5\" viewBox=\"0 0 24 24\">\n                <path d=\"M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z\"></path>\n              </svg>\n            </a>\n            <a class=\"ml-4 text-gray-500\">\n              <svg fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" class=\"w-5 h-5\" viewBox=\"0 0 24 24\">\n                <rect width=\"20\" height=\"20\" x=\"2\" y=\"2\" rx=\"5\" ry=\"5\"></rect>\n                <path d=\"M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37zm1.5-4.87h.01\"></path>\n              </svg>\n            </a>\n            <a class=\"ml-4 text-gray-500\">\n              <svg fill=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" class=\"w-5 h-5\" viewBox=\"0 0 24 24\">\n                <path d=\"M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z\"></path>\n              </svg>\n            </a>\n          </span>\n        </div>\n      </div>\n    </div>\n  </div>\n  </form>\n</section>"
