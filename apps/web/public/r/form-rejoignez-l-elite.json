    "rawHtml": "<!DOCTYPE html>\n<html lang=\"fr\" class=\"dark\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Modern Registration | Gold Edition</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        body { font-family: 'Plus Jakarta Sans', sans-serif; }\n        .step-content { display: none; }\n        .step-content.active { display: block; animation: fadeIn 0.5s ease-out; }\n        \n        @keyframes fadeIn {\n            from { opacity: 0; transform: translateX(20px); }\n            to { opacity: 1; transform: translateX(0); }\n        }\n\n        .gold-gradient {\n            background: linear-gradient(135deg, #d4af37 0%, #f2d472 50%, #b8860b 100%);\n        }\n\n        /* Barre de progression personnalisée */\n        .progress-bar { transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1); }\n    </style>\n</head>\n<body class=\"bg-slate-50 dark:bg-slate-950 min-h-screen flex items-center justify-center p-4\">\n\n    <div class=\"w-full max-w-6xl bg-white dark:bg-slate-900 rounded-[2.5rem] shadow-2xl overflow-hidden flex flex-col md:flex-row min-h-[700px]\">\n        \n        <div class=\"md:w-1/2 gold-gradient relative p-12 flex flex-col justify-between text-slate-900\">\n            <div class=\"absolute inset-0 opacity-20 mix-blend-overlay\">\n                <img src=\"https://images.pexels.com/photos/3183150/pexels-photo-3183150.jpeg\" alt=\"Background\" class=\"w-full h-full object-cover\">\n            </div>\n\n            <div class=\"relative z-10\">\n                <div class=\"text-xs font-bold uppercase tracking-[0.3em] mb-4 opacity-80\">Premium Access</div>\n                <h1 class=\"text-4xl md:text-5xl font-black leading-tight mb-8\">Rejoignez l'élite de l'innovation.</h1>\n                \n                <div class=\"space-y-6\">\n                    <div class=\"flex items-center gap-4 step-indicator\" data-step=\"1\">\n                        <div class=\"w-10 h-10 rounded-full border-2 border-slate-900 flex items-center justify-center font-bold\" id=\"dot-1\">1</div>\n                        <span class=\"font-semibold\">Informations Personnelles</span>\n                    </div>\n                    <div class=\"flex items-center gap-4 step-indicator opacity-40\" data-step=\"2\">\n                        <div class=\"w-10 h-10 rounded-full border-2 border-slate-900 flex items-center justify-center font-bold\" id=\"dot-2\">2</div>\n                        <span class=\"font-semibold\">Configuration du Compte</span>\n                    </div>\n                    <div class=\"flex items-center gap-4 step-indicator opacity-40\" data-step=\"3\">\n                        <div class=\"w-10 h-10 rounded-full border-2 border-slate-900 flex items-center justify-center font-bold\" id=\"dot-3\">3</div>\n                        <span class=\"font-semibold\">Finalisation</span>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"relative z-10\">\n                <p class=\"text-sm font-medium italic opacity-70\">\"La simplicité est la sophistication suprême.\"</p>\n            </div>\n        </div>\n\n        <div class=\"md:w-1/2 p-8 md:p-16 flex flex-col\">\n            <div class=\"w-full h-1 bg-slate-100 dark:bg-slate-800 rounded-full mb-12 overflow-hidden\">\n                <div id=\"progressBar\" class=\"progress-bar h-full bg-blue-600 w-1/3\"></div>\n            </div>\n\n            <form id=\"multiStepForm\" class=\"flex-grow flex flex-col justify-center\">\n                \n                <div class=\"step-content active\" id=\"step-1\">\n                    <h2 class=\"text-3xl font-bold mb-2 dark:text-white\">Parlez-nous de vous</h2>\n                    <p class=\"text-slate-500 mb-8\">Commençons par les bases.</p>\n                    \n                    <div class=\"grid grid-cols-2 gap-4 mb-4\">\n                        <div class=\"space-y-2\">\n                            <label class=\"text-xs font-bold uppercase text-slate-400\">Prénom</label>\n                            <input type=\"text\" class=\"w-full p-4 bg-slate-50 dark:bg-slate-800 border-none rounded-2xl focus:ring-2 focus:ring-blue-500 outline-none dark:text-white transition\" placeholder=\"John\">\n                        </div>\n                        <div class=\"space-y-2\">\n                            <label class=\"text-xs font-bold uppercase text-slate-400\">Nom</label>\n                            <input type=\"text\" class=\"w-full p-4 bg-slate-50 dark:bg-slate-800 border-none rounded-2xl focus:ring-2 focus:ring-blue-500 outline-none dark:text-white transition\" placeholder=\"Doe\">\n                        </div>\n                    </div>\n                    <div class=\"space-y-2 mb-6\">\n                        <label class=\"text-xs font-bold uppercase text-slate-400\">Email Professionnel</label>\n                        <input type=\"email\" class=\"w-full p-4 bg-slate-50 dark:bg-slate-800 border-none rounded-2xl focus:ring-2 focus:ring-blue-500 outline-none dark:text-white transition\" placeholder=\"john@company.com\">\n                    </div>\n                </div>\n\n                <div class=\"step-content\" id=\"step-2\">\n                    <h2 class=\"text-3xl font-bold mb-2 dark:text-white\">Sécurisez votre accès</h2>\n                    <p class=\"text-slate-500 mb-8\">Choisissez vos identifiants.</p>\n                    \n                    <div class=\"space-y-4\">\n                        <div class=\"space-y-2\">\n                            <label class=\"text-xs font-bold uppercase text-slate-400\">Nom d'utilisateur</label>\n                            <input type=\"text\" class=\"w-full p-4 bg-slate-50 dark:bg-slate-800 border-none rounded-2xl focus:ring-2 focus:ring-blue-500 outline-none dark:text-white transition\">\n                        </div>\n                        <div class=\"space-y-2\">\n                            <label class=\"text-xs font-bold uppercase text-slate-400\">Mot de passe</label>\n                            <input type=\"password\" class=\"w-full p-4 bg-slate-50 dark:bg-slate-800 border-none rounded-2xl focus:ring-2 focus:ring-blue-500 outline-none dark:text-white transition\">\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"step-content\" id=\"step-3\">\n                    <h2 class=\"text-3xl font-bold mb-2 dark:text-white\">Dernière étape</h2>\n                    <p class=\"text-slate-500 mb-8\">Presque terminé.</p>\n                    \n                    <div class=\"space-y-4\">\n                        <div class=\"space-y-2\">\n                            <label class=\"text-xs font-bold uppercase text-slate-400\">Pays de résidence</label>\n                            <select class=\"w-full p-4 bg-slate-50 dark:bg-slate-800 border-none rounded-2xl focus:ring-2 focus:ring-blue-500 outline-none dark:text-white transition\">\n                                <option>France</option>\n                                <option>Canada</option>\n                                <option>Belgique</option>\n                            </select>\n                        </div>\n                        <div class=\"flex items-start gap-3 py-4\">\n                            <input type=\"checkbox\" id=\"terms\" class=\"mt-1 w-5 h-5 rounded border-slate-300 text-blue-600 focus:ring-blue-500\">\n                            <label for=\"terms\" class=\"text-sm text-slate-500\">J'accepte les conditions d'utilisation et la politique de confidentialité.</label>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"mt-12 flex items-center justify-between\">\n                    <button type=\"button\" id=\"prevBtn\" class=\"hidden text-slate-400 font-bold hover:text-slate-600 transition\">Précédent</button>\n                    <button type=\"button\" id=\"nextBtn\" class=\"ml-auto bg-slate-900 dark:bg-white text-white dark:text-black px-10 py-4 rounded-2xl font-black shadow-xl hover:scale-105 active:scale-95 transition\">\n                        Continuer\n                    </button>\n                </div>\n            </form>\n        </div>\n    </div>\n\n    <script>\n        const steps = document.querySelectorAll('.step-content');\n        const indicators = document.querySelectorAll('.step-indicator');\n        const nextBtn = document.getElementById('nextBtn');\n        const prevBtn = document.getElementById('prevBtn');\n        const progressBar = document.getElementById('progressBar');\n        let currentStep = 1;\n\n        function updateForm() {\n            // Update Visibility\n            steps.forEach((step, idx) => {\n                step.classList.toggle('active', idx + 1 === currentStep);\n            });\n\n            // Update Indicators (Left side)\n            indicators.forEach((indicator, idx) => {\n                if (idx + 1 <= currentStep) {\n                    indicator.classList.remove('opacity-40');\n                    document.getElementById(`dot-${idx+1}`).classList.add('bg-slate-900', 'text-white');\n                } else {\n                    indicator.classList.add('opacity-40');\n                    document.getElementById(`dot-${idx+1}`).classList.remove('bg-slate-900', 'text-white');\n                }\n            });\n\n            // Update Progress Bar\n            progressBar.style.width = `${(currentStep / steps.length) * 100}%`;\n\n            // Update Buttons\n            prevBtn.classList.toggle('hidden', currentStep === 1);\n            nextBtn.innerText = currentStep === steps.length ? 'Finaliser' : 'Continuer';\n        }\n\n        nextBtn.addEventListener('click', () => {\n            if (currentStep < steps.length) {\n                currentStep++;\n                updateForm();\n            } else {\n                alert(\"Formulaire envoyé avec succès ! ✨\");\n            }\n        });\n\n        prevBtn.addEventListener('click', () => {\n            if (currentStep > 1) {\n                currentStep--;\n                updateForm();\n            }\n        });\n    </script>\n</body>\n</html>"
  }
}
