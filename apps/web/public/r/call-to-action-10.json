      "content": "/**\n * Component: Call to action\n * Author: @makecomponents (https://tailwindflex.com/@makecomponents)\n * Source: https://tailwindflex.com/@makecomponents/call-to-action-10\n * Attribution: Créé par @makecomponents sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function CallToAction10() {\n  return (\n    <div>\n    <div className=\" py-[300px] dark\">\n          <section\n            className=\"  relative py-10 bg-[url('https://makecomponents.com/Image/call-to-action/001/001.webp')] h-[300px] bg-no-repeat bg-cover bg-center \"\n          >\n            <div className=\"absolute w-full bottom-0 mx-auto px-4\">\n              <div className=\"  container mx-auto \">\n                <div className=\" grid lg3  lge3 md1 mdsm1 sm1 \">\n                  <div>\n                    <div className=\"lg lge md mdsm sm \">\n                      <img\n                        src=\"https://makecomponents.com/Image/overall/person/person2.webp\"\n                        alt=\"person \"\n                        className=\"  h-[500px] mx-auto \"\n                      />\n                    </div>\n                  </div>\n                  <div className=\" col-span-2 relative \">\n                    <div className=\" absolute bottom-0 py-10\">\n                      <h3 className=\" text-[#c7b130]  relative after[#fff] after[10%] text-4xl font-semibold   pb-4\">\n                        Get a Free Quote\n                      </h3>\n                      <h4 className=\" text-[#fff]  text-[20px] \">\n                        Looking for reliable logistics solutions? Get a free,\n                        no-obligation quote today and discover how we can\n                        streamline your supply chain.\n                        <span className=\" text-[#c7b130]  underline underline-[#fff] underline-offset-2 \">\n                       \n                          Request your quote now!\n                        </span>\n                      </h4>\n                      <button className=\" bg-[#c7b130]  rounded-lg   py-2 px-16 mt-4 hover[#fff] \">\n                        Call Now\n                      </button>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </section>\n        </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
