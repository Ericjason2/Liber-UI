      "content": "import * as React from \"react\"\n\nfunction ButtonsVariations({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"buttons-variations\"\n      className={className}\n      {...props}\n    >\n      <div className=\"flex flex-col gap-4\">\n          <p className=\"font-bold\">Rounded Buttons:</p>\n      \n          <div className=\"flex space-x-4\">\n              <button className=\"bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded\">\n                  Button 1\n              </button>\n              <button className=\"bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4 rounded\">\n                  Button 2\n              </button>\n              <button className=\"bg-green-500 hover:bg-green-700 text-white font-bold py-2 px-4 rounded\">\n                  Button 3\n              </button>\n          </div>\n      \n      \n          <p className=\"font-bold\">Outline Buttons</p>\n          <div className=\"flex space-x-4\">\n      \n              <button className=\"border border-blue-500 text-blue-500 font-bold py-2 px-4 rounded\">\n                  Button\n              </button>\n      \n              <button className=\"border border-red-500 text-red-500 font-bold py-2 px-4 rounded\">\n                  Button\n              </button>\n      \n              <button className=\"border border-green-500 text-green-500 font-bold py-2 px-4 rounded\">\n                  Button\n              </button>\n          </div>\n      \n      \n          <p className=\"font-bold\">Gradient Buttons:</p>\n          <div className=\"flex space-x-4\">\n      \n              <button className=\"bg-gradient-to-r from-red-400 to-yellow-500 text-white font-bold py-2 px-4 rounded\">\n                  Button\n              </button>\n      \n              <button className=\"bg-gradient-to-r from-blue-400 to-indigo-500 text-white font-bold py-2 px-4 rounded\">\n                  Button\n              </button>\n      \n              <button className=\"bg-gradient-to-r from-green-400 to-blue-500 text-white font-bold py-2 px-4 rounded\">\n                  Button\n              </button>\n          </div>\n      </div>\n    </div>\n  )\n}\n\nexport { ButtonsVariations }\n",
      "type": "registry:ui"
    }
  ],
