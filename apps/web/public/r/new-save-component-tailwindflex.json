      "content": "/**\n * Component: new Save Component tailwindflex\n * Author: @omer-fils-elenga (https://tailwindflex.com/@omer-fils-elenga)\n * Source: https://tailwindflex.com/@omer-fils-elenga/new-save-component-tailwindflex\n * Attribution: Créé par @omer-fils-elenga sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function NewSaveComponentTailwindflex() {\n  return (\n    <div>\n    <div className=\"min-h-screen bg-slate-50 dark950 p-8 flex items-center justify-center transition-colors duration-300\">\n      \n      \n      <div className=\"w-full max-w-lg bg-white/80 dark900/80 backdrop-blur-md border border-slate-200 dark800 rounded-2xl p-6 shadow-xl\">\n        \n        \n        <div className=\"mb-6\">\n          <h2 className=\"text-xl font-bold text-slate-900 dark\">Save Component</h2>\n          <p className=\"text-xs text-slate-500 dark400 mt-1\">Enregistrez votre snippet de code proprement pour vos futurs projets.</p>\n        </div>\n    \n        <form className=\"space-y-5\">\n          \n          \n          <div>\n            <label htmlFor=\"title\" className=\"block text-xs font-semibold uppercase tracking-wider text-slate-600 dark400 mb-1.5\">\n              Title <span className=\"text-rose-500\">*</span>\n            </label>\n            <input \n              type=\"text\" \n              id=\"title\" \n              required\n              placeholder=\"Ex: Credit Card 3D Flip\" \n              className=\"w-full px-4 py-2.5 rounded-xl border border-slate-200 dark800 bg-white dark950 text-slate-900 dark100 placeholder-slate-400 dark600 text-sm focus focus2 focus500 focus transition-all\"\n            />\n          </div>\n    \n          \n          <div>\n            <label htmlFor=\"description\" className=\"block text-xs font-semibold uppercase tracking-wider text-slate-600 dark400 mb-1.5\">\n              Description\n            </label>\n            <textarea \n              id=\"description\" \n              rows=\"3\"\n              placeholder=\"Décrivez le fonctionnement ou les dépendances du composant...\" \n              className=\"w-full px-4 py-2.5 rounded-xl border border-slate-200 dark800 bg-white dark950 text-slate-900 dark100 placeholder-slate-400 dark600 text-sm focus focus2 focus500 focus transition-all resize-none\"\n            ></textarea>\n          </div>\n    \n          \n          <div className=\"grid grid-cols-1 sm2 gap-4\">\n            \n            \n            <div>\n              <label htmlFor=\"tags\" className=\"block text-xs font-semibold uppercase tracking-wider text-slate-600 dark400 mb-1.5\">\n                Tags\n              </label>\n              <input \n                type=\"text\" \n                id=\"tags\" \n                placeholder=\"Tailwind, 3D, UI\" \n                className=\"w-full px-4 py-2.5 rounded-xl border border-slate-200 dark800 bg-white dark950 text-slate-900 dark100 placeholder-slate-400 dark600 text-sm focus focus2 focus500 focus transition-all\"\n              />\n            </div>\n    \n            \n            <div>\n              <label htmlFor=\"search-tags\" className=\"block text-xs font-semibold uppercase tracking-wider text-slate-600 dark400 mb-1.5\">\n                Search Tags\n              </label>\n              <input \n                type=\"text\" \n                id=\"search-tags\" \n                placeholder=\"card, flip, animate, js\" \n                className=\"w-full px-4 py-2.5 rounded-xl border border-slate-200 dark800 bg-white dark950 text-slate-900 dark100 placeholder-slate-400 dark600 text-sm focus focus2 focus500 focus transition-all\"\n              />\n            </div>\n    \n          </div>\n    \n          \n          <div className=\"flex justify-end gap-3 pt-2 border-t border-slate-100 dark800/60 mt-6\">\n            <button \n              type=\"button\" \n              className=\"px-4 py-2 text-xs font-medium text-slate-600 dark400 hover100 dark800 rounded-xl transition-all\"\n            >\n              Annuler\n            </button>\n            <button \n              type=\"submit\" \n              className=\"px-5 py-2 text-xs font-semibold text-white bg-indigo-600 hover500 dark500 dark400 rounded-xl shadow-md shadow-indigo-500/10 active95 transition-all\"\n            >\n              Sauvegarder\n            </button>\n          </div>\n    \n        </form>\n      </div>\n    \n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
