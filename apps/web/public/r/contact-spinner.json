    "rawHtml": "<!-- =============ICONSCOUT CDN============ -->\n<link rel=\"stylesheet\" href=\"https://unicons.iconscout.com/release/v4.0.0/css/line.css\">\n\n<div class=\"w-full flex h-screen bg-gray-900 dark:bg-white\">\n    <a href=\"mailto:samuelabera87@gmail.com\" id=\"contact_btn\"\n        class=\"w-[10rem] h-[10rem] rounded-full text-[#000e17] grid place-items-center absolute lg:right-[50%] sm:right-[40%] xs:right-[30%] top-[5%] bg-[linear-gradient(-30deg,_#e5a55d,_#ff7b02,_#e5a55d)] cursor-pointer [transition:all_400ms_ease] hover:shadow-2xl hover:shadow-gray-900 hover:-translate-y-[1rem] hover:text-[#000e17]\">\n        <i class=\"uil uil-arrow-up-right absolute text-[3.5rem]\"></i>\n        <p\n            class=\"text-[#000e17] font-semibold w-[10rem] h-[10rem] flex justify-center animate-spinText\">\n            CONTACT - SEND ME AN EMAIL\n        </p>\n    </a>\n\n    <!--  -->\n\n    <a href=\"mailto:samuelabera87@gmail.com\" id=\"contact_btn\"\n        class=\"w-[10rem] h-[10rem] rounded-full text-gray-400 grid place-items-center absolute lg:right-[50%] sm:right-[40%] xs:right-[30%] bottom-[35%] cursor-pointer [transition:all_400ms_ease] hover:shadow-2xl hover:shadow-gray-900 hover:-translate-y-[1rem] hover:text-gray-300\">\n        <i class=\"uil uil-arrow-up-right absolute text-[3.5rem]\"></i>\n        <p\n            class=\"text-white dark:text-gray-900 font-semibold w-[10rem] h-[10rem] flex justify-center animate-spinText\">\n            CONTACT - SEND ME AN EMAIL\n        </p>\n    </a>\n\n    <a href=\"mailto:samuelabera87@gmail.com\" id=\"contact_btn\"\n        class=\"w-[10rem] h-[10rem] rounded-full text-[#000e17] grid place-items-center absolute lg:right-[50%] sm:right-[40%] xs:right-[30%] bottom-[5%] bg-gradient-to-r from-cyan-500 to-blue-500 cursor-pointer [transition:all_400ms_ease] hover:shadow-2xl hover:shadow-gray-900 hover:-translate-y-[1rem] hover:text-[#000e17]\">\n        <i class=\"uil uil-arrow-up-right absolute text-[3.5rem]\"></i>\n        <p\n            class=\"text-[#000e17] font-semibold w-[10rem] h-[10rem] flex justify-center animate-spinText\">\n            CONTACT - SEND ME AN EMAIL\n        </p>\n    </a>\n</div>\n\n<script>\n    const btnContact = document.querySelectorAll('#contact_btn');\n\nbtnContact.forEach(btnText => {\n    let text = btnText.querySelector('p');\n\n    text.innerHTML = text.innerHTML.split('').map((character, index) => `<span class=\"absolute origin-[0.3rem_5rem]\" style=\"transform: rotate(${index * 12}deg)\">${character}</span>`).join('');\n});\n</script>"
