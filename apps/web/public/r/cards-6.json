ass=\\\"text-gray-700 text-center\\\">\\n                    Passionate about creating beautiful, user-friendly interfaces. \\n                    With 5 years of experience in design and development, \\n                    I bridge the gap between aesthetics and functionality.\\n                </p>\\n            </div>\\n            \\n            <!-- Button -->\\n            <div class=\\\"flex justify-center\\\">\\n                <button class=\\\"bg-purple-500 hover:bg-purple-600 text-white font-medium py-2 px-6 rounded-full transition duration-300\\\">\\n                    Contact Me\\n                </button>\\n            </div>\\n            \\n            <!-- Stats (optional) -->\\n            <div class=\\\"flex justify-between mt-6 pt-6 border-t border-gray-200\\\">\\n                <div class=\\\"text-center\\\">\\n                    <span class=\\\"block font-bold text-gray-800\\\">124</span>\\n                    <span class=\\\"text-sm text-gray-600\\\">Projects</span>\\n                </div>\\n                <div class=\\\"text-center\\\">\\n                    <span class=\\\"block font-bold text-gray-800\\\">5.2k</span>\\n                    <span class=\\\"text-sm text-gray-600\\\">Followers</span>\\n                </div>\\n                <div class=\\\"text-center\\\">\\n                    <span class=\\\"block font-bold text-gray-800\\\">86</span>\\n                    <span class=\\\"text-sm text-gray-600\\\">Following</span>\\n                </div>\\n            </div>\\n        </div>\\n    </div>\\n</body>\\n</html>\" }} />\n  );\n}\n",
