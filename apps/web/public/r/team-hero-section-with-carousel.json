    "rawHtml": "<!-- Tailwind -->\n<script src=\"https://cdn.tailwindcss.com\"></script>\n\n<!-- Alpine -->\n<script defer src=\"https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js\"></script>\n\n<!-- Swiper -->\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css\" />\n<script src=\"https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js\"></script>\n\n<section class=\"relative overflow-hidden bg-slate-50\">\n  <div\n    x-data=\"expertsHero()\"\n    x-init=\"init()\"\n    class=\"max-w-7xl mx-auto px-6 py-20\"\n  >\n    <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-16 items-center\">\n\n      <!-- LEFT – HERO TEXT -->\n      <div class=\"space-y-6\">\n        <h1 class=\"text-4xl md:text-5xl font-extrabold text-slate-900 leading-tight\">\n          Talk to Our Experts\n        </h1>\n\n        <p class=\"text-lg text-slate-600 max-w-xl\">\n          Get in touch with our certified experts. Call directly or schedule a\n          consultation and get answers fast.\n        </p>\n      </div>\n\n      <!-- RIGHT – EXPERTS SLIDER -->\n      <div class=\"relative\">\n        <div class=\"swiper\" x-ref=\"swiperEl\">\n          <div class=\"swiper-wrapper\">\n\n            <template x-for=\"expert in experts\" :key=\"expert.id\">\n              <div class=\"swiper-slide\">\n                <article\n                  class=\"bg-white rounded-2xl p-8 flex flex-col gap-6 shadow-sm h-full\"\n                >\n                  <div class=\"flex items-center gap-5\">\n                    <!-- avatar -->\n                    <img\n                      :src=\"expert.avatar\"\n                      alt=\"\"\n                      class=\"w-20 h-20 rounded-full object-cover\"\n                    />\n\n                    <div>\n                      <h3 class=\"text-xl font-bold text-slate-900\" x-text=\"expert.name\"></h3>\n                      <a\n                        class=\"text-sky-600 font-medium\"\n                        :href=\"`tel:${expert.phone}`\"\n                        x-text=\"expert.phone\"\n                      ></a>\n                    </div>\n                  </div>\n\n                  <a\n                    :href=\"expert.link\"\n                    class=\"mt-auto inline-flex justify-center rounded-xl bg-sky-600 px-6 py-3 font-bold text-white hover:bg-indigo-700 transition\"\n                  >\n                    Talk to an Expert\n                  </a>\n                </article>\n              </div>\n            </template>\n\n          </div>\n        </div>\n\n        <!-- controls -->\n        <div class=\"mt-8 flex justify-center gap-4\">\n  <button\n    @click=\"prev()\"\n    class=\"flex h-12 w-12 items-center justify-center rounded-full\n           border border-slate-200 bg-white\n           text-slate-600\n           hover:border-slate-300 hover:bg-slate-100 hover:text-slate-900\n           transition\"\n    aria-label=\"Previous\"\n  >\n    <svg class=\"h-5 w-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M15 19l-7-7 7-7\" />\n    </svg>\n  </button>\n\n  <button\n    @click=\"next()\"\n    class=\"flex h-12 w-12 items-center justify-center rounded-full\n           border border-slate-200 bg-white\n           text-slate-600\n           hover:border-slate-300 hover:bg-slate-100 hover:text-slate-900\n           transition\"\n    aria-label=\"Next\"\n  >\n    <svg class=\"h-5 w-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 5l7 7-7 7\" />\n    </svg>\n  </button>\n</div>\n\n      </div>\n    </div>\n  </div>\n</section>\n<script>\n  function expertsHero() {\n    return {\n      swiper: null,\n\n      experts: [\n        {\n          id: 1,\n          name: \"John Miller\",\n          phone: \"+421 900 123 456\",\n          link: \"#\",\n          avatar: \"https://i.pravatar.cc/200?img=12\",\n        },\n        {\n          id: 2,\n          name: \"Anna Novak\",\n          phone: \"+421 911 222 333\",\n          link: \"#\",\n          avatar: \"https://i.pravatar.cc/200?img=32\",\n        },\n        {\n          id: 3,\n          name: \"Peter Schmidt\",\n          phone: \"+421 944 555 666\",\n          link: \"#\",\n          avatar: \"https://i.pravatar.cc/200?img=56\",\n        },\n        {\n          id: 4,\n          name: \"Laura White\",\n          phone: \"+421 955 888 999\",\n          link: \"#\",\n          avatar: \"https://i.pravatar.cc/200?img=45\",\n        },\n        \n        {\n          id: 5,\n          name: \"Laura \",\n          phone: \"+421 955 888 999\",\n          link: \"#\",\n          avatar: \"https://i.pravatar.cc/200?img=45\",\n        },\n        \n        {\n          id: 6,\n          name: \" White\",\n          phone: \"+421 955 888 999\",\n          link: \"#\",\n          avatar: \"https://i.pravatar.cc/200?img=45\",\n        },\n      ],\n\n      init() {\n        this.swiper = new Swiper(this.$refs.swiperEl, {\n          loop: true,\n          speed: 400,\n          spaceBetween: 24,\n          autoplay: {\n            delay: 2500,\n            disableOnInteraction: false,\n          },\n          breakpoints: {\n            0: { slidesPerView: 1 },\n            768: { slidesPerView: 2 },\n          },\n        });\n      },\n\n      prev() {\n        this.swiper.slidePrev();\n      },\n\n      next() {\n        this.swiper.slideNext();\n      },\n    };\n  }\n</script>"
  }
