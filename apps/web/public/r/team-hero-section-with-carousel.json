      "content": "/**\n * Component: Team Hero Section with Carousel\n * Author: @perky98 (https://tailwindflex.com/@perky98)\n * Source: https://tailwindflex.com/@perky98/team-hero-section-with-carousel\n * Attribution: Créé par @perky98 sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function TeamHeroSectionWithCarousel() {\n  return (\n    <div dangerouslySetInnerHTML={{ __html: \"<!-- Tailwind -->\\n\\n\\n<!-- Alpine -->\\n\\n\\n<!-- Swiper -->\\n<link rel=\\\"stylesheet\\\" href=\\\"https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css\\\" />\\n\\n\\n<section class=\\\"relative overflow-hidden bg-slate-50\\\">\\n  <div\\n    x-data=\\\"expertsHero()\\\"\\n    x-init=\\\"init()\\\"\\n    class=\\\"max-w-7xl mx-auto px-6 py-20\\\"\\n  >\\n    <div class=\\\"grid grid-cols-1 lg:grid-cols-2 gap-16 items-center\\\">\\n\\n      <!-- LEFT – HERO TEXT -->\\n      <div class=\\\"space-y-6\\\">\\n        <h1 class=\\\"text-4xl md:text-5xl font-extrabold text-slate-900 leading-tight\\\">\\n          Talk to Our Experts\\n        </h1>\\n\\n        <p class=\\\"text-lg text-slate-600 max-w-xl\\\">\\n          Get in touch with our certified experts. Call directly or schedule a\\n          consultation and get answers fast.\\n        </p>\\n      </div>\\n\\n      <!-- RIGHT – EXPERTS SLIDER -->\\n      <div class=\\\"relative\\\">\\n        <div class=\\\"swiper\\\" x-ref=\\\"swiperEl\\\">\\n          <div class=\\\"swiper-wrapper\\\">\\n\\n            <template x-for=\\\"expert in experts\\\" :key=\\\"expert.id\\\">\\n              <div class=\\\"swiper-slide\\\">\\n                <article\\n                  class=\\\"bg-white rounded-2xl p-8 flex flex-col gap-6 shadow-sm h-full\\\"\\n                >\\n                  <div class=\\\"flex items-center gap-5\\\">\\n                    <!-- avatar -->\\n                    <img\\n                      :src=\\\"expert.avatar\\\"\\n                      alt=\\\"\\\"\\n                      class=\\\"w-20 h-20 rounded-full object-cover\\\"\\n                    />\\n\\n                    <div>\\n                      <h3 class=\\\"text-xl font-bold text-slate-900\\\" x-text=\\\"expert.name\\\"></h3>\\n                      <a\\n                        class=\\\"text-sky-600 font-medium\\\"\\n                        :href=\\\"`tel:${expert.phone}`\\\"\\n                        x-text=\\\"expert.phone\\\"\\n                      ></a>\\n                    </div>\\n                  </div>\\n\\n                  <a\\n                    :href=\\\"expert.link\\\"\\n                    class=\\\"mt-auto inline-flex justify-center rounded-xl bg-sky-600 px-6 py-3 font-bold text-white hover:bg-indigo-700 transition\\\"\\n                  >\\n                    Talk to an Expert\\n                  </a>\\n                </article>\\n              </div>\\n            </template>\\n\\n          </div>\\n        </div>\\n\\n        <!-- controls -->\\n        <div class=\\\"mt-8 flex justify-center gap-4\\\">\\n  <button\\n    @click=\\\"prev()\\\"\\n    class=\\\"flex h-12 w-12 items-center justify-center rounded-full\\n           border border-slate-200 bg-white\\n           text-slate-600\\n           hover:border-slate-300 hover:bg-slate-100 hover:text-slate-900\\n           transition\\\"\\n    aria-label=\\\"Previous\\\"\\n  >\\n    <svg class=\\\"h-5 w-5\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" viewBox=\\\"0 0 24 24\\\">\\n      <path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" d=\\\"M15 19l-7-7 7-7\\\" />\\n    </svg>\\n  </button>\\n\\n  <button\\n    @click=\\\"next()\\\"\\n    class=\\\"flex h-12 w-12 items-center justify-center rounded-full\\n           border border-slate-200 bg-white\\n           text-slate-600\\n           hover:border-slate-300 hover:bg-slate-100 hover:text-slate-900\\n           transition\\\"\\n    aria-label=\\\"Next\\\"\\n  >\\n    <svg class=\\\"h-5 w-5\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" viewBox=\\\"0 0 24 24\\\">\\n      <path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" d=\\\"M9 5l7 7-7 7\\\" />\\n    </svg>\\n  </button>\\n</div>\\n\\n      </div>\\n    </div>\\n  </div>\\n</section>\\n\" }} />\n  );\n}\n",
      "type": "registry:ui"
    }
