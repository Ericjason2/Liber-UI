      "content": "/**\n * Component: Navbar with social links\n * Author: @vikram (https://tailwindflex.com/@vikram)\n * Source: https://tailwindflex.com/@vikram/navbar-with-social-links\n * Attribution: Créé par @vikram sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function NavbarWithSocialLinks() {\n  return (\n    <div>\n    <header className=\"flex flex-col items-center justify-between max-w-full md6xl px-2 md6 py-12 mx-auto md\">\r\n        <a href=\"/\" className=\"text-indigo-900 z-10 active\">\r\n            <img src=\"https://www.svgrepo.com/show/489282/brand.svg\" className=\"w-24 py-8 md0 g-image\" />\r\n        </a>\r\n        <nav className=\"z-10\">\r\n            <ul className=\"flex flex-row items-center px-6 py-4 text-indigo-100 bg-indigo-900 rounded-lg\">\r\n                <li className=\"pr-8\">\r\n                    <a href=\"/blog\">Blog</a>\r\n                </li>\r\n                <li className=\"pr-8\">\r\n                    <a href=\"\" target=\"_blank\">LinkedIn</a>\r\n                </li>\r\n                <li className=\"pr-8\">\r\n                    <a href=\"\" target=\"_blank\">Twitter</a>\r\n                </li>\r\n                <li className=\"text-red-200\">\r\n                    <a href=\"\" className=\"ml-2\">Email</a>\r\n                </li>\r\n            </ul>\r\n        </nav>\r\n    </header>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
