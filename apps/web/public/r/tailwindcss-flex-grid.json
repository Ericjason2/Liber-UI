   <p class=\"font-semibold text-gray-800\">Dash Platform</p>\n          <p class=\"text-sm text-gray-500\">Dash Technology Group</p>\n        </div>\n      </div><!-- App Card Example -->\n      <div class=\"bg-white rounded-lg shadow p-6 flex flex-col items-center\">\n        <div class=\"flex gap-2 mb-4 w-full\">\n          <span class=\"bg-green-100 text-green-700 text-xs font-semibold px-2 py-1 rounded\">Subscribed</span>\n          <span class=\"bg-blue-100 text-blue-700 text-xs font-semibold px-2 py-1 rounded\">Free trial</span>\n        </div>\n        <div class=\"w-20 h-20 mb-4 flex items-center justify-center bg-teal-200 rounded-2xl\">\n          <!-- Substitute with app icon -->\n          <span class=\"text-lg font-bold text-white\">Fact Find</span>\n        </div>\n        <div class=\"text-center\">\n          <p class=\"font-semibold text-gray-800\">Client Engagement</p>\n          <p class=\"text-sm text-gray-500\">Dash Technology Group</p>\n        </div>\n      </div>\n\n    </div>\n  </div>\n\n\n  <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n    <div class=\"space-y-4\">\n        <div class=\"\">\n            <!-- search Card 1 -->\n            <div class=\"bg-white rounded-lg shadow-sm border p-6\">\n                Contacts\n            </div>\n        </div>\n    </div>\n    <div class=\"\">\n      <div class=\"bg-white rounded-lg shadow-sm border p-6\">Advanced Search</div>\n    </div>\n  </div>\n\n  <div class=\"grid grid-cols-1 md:grid-cols-5 gap-6\">\n    <!-- Main Container -->\n    <div class=\"space-y-6 md:col-span-4\">\n        \n        <!-- Client Cards Section -->\n        <div class=\"grid grid-cols-1 lg:grid-cols-2  gap-6\">\n            <!-- Client Card 1 -->\n            <div class=\"bg-white rounded-lg shadow-sm border p-6\">\n                asdasd\n            </div>\n            \n            <!-- Client Card 2 -->\n            <div class=\"bg-white rounded-lg shadow-sm border p-6\">\nasdasdas\n            </div>\n        </div>\n        \n        <!-- Risk Profile Section -->\n        <div class=\"bg-white rounded-lg shadow-sm border p-6\">\nasdasd\n        </div>\n    </div>\n    <div class=\"grid grid-rows-2 gap-6\">\n      <div class=\"bg-white rounded-lg shadow-sm border p-6\">wiowieoi</div>\n      <div class=\"bg-white rounded-lg shadow-sm border p-6\">werwerwer</div>\n      <div class=\"flex flex-col h-full items-stretch \">\n        <div class=\"flex-1 bg-blue-200\"> <!-- This child fills parent height -->\n          sdfsdf\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"grid grid-rows-2 grid-cols-2 gap-4 bg-white p-6 rounded shadow\">\n    <!-- First line: spans both columns (full width) -->\n    <div class=\"row-start-1 row-end-2 col-span-2 bg-blue-500 text-white p-4 rounded\">1</div>\n    <!-- Second line: two 50% blocks -->\n    <div class=\"row-start-2 col-span-1 sm:col-span-2 bg-blue-500 text-white p-4 rounded\">2</div>\n    <div class=\"row-start-2 col-span-1 sm:col-span-2 sm:row-start-3 bg-blue-500 text-white p-4 rounded\">3</div>\n  </div>\n\n  <div class=\"flex flex-row flex-wrap justify-center items-center gap-4 bg-white p-6 rounded shadow\">\n    <div class=\"flex-[100%] bg-blue-500 text-white p-4 rounded\">1</div>\n    <div class=\"flex-[100%] shrink sm:flex-[70] bg-blue-500 text-white p-4 rounded\">2</div>\n    <div class=\"flex-[100%] sm:flex-[0_0_48px] bg-blue-500 text-white p-4 rounded\">3</div>\n    <div class=\"flex-[100%] shrink sm:flex-[30] bg-blue-500 text-white p-4 rounded\">3</div>\n    <div class=\"flex-[100%] sm:flex-[0_0_48px] bg-blue-500 text-white p-4 rounded\">3</div>\n  </div>\n\n<!-- 範例一：簡單 Grid + gap -->\n  <div class=\"grid grid-cols-3 gap-4 bg-white p-6 rounded shadow\">\n    <div class=\"bg-blue-500 text-white p-4 rounded\">1</div>\n    <div class=\"bg-green-500 text-white p-4 rounded\">2</div>\n    <div class=\"bg-red-500 text-white p-4 rounded\">3</div>\n    <div class=\"bg-purple-500 text-white p-4 rounded\">4</div>\n    <div class=\"bg-yellow-500 text-white p-4 rounded\">5</div>\n    <div class=\"bg-pink-500 text-white p-4 rounded\">6</div>\n  </div>\n\n  <!-- 範例二：響應式欄數變化 -->\n  <div class=\"w-full grid grid-cols-1 md:grid-cols-2 gap-2\">\n    <div class=\"bg-indigo-500 text-white p-4 rounded\">A</div>\n    <div class=\"bg-teal-500 text-white p-4 rounded\">B</div>\n    <div class=\"bg-emerald-500 text-white p-4 rounded\">C</div>\n    <div class=\"bg-cyan-500 text-white p-4 rounded\">D</div>\n    <div class=\"bg-lime-500 text-white p-4 rounded\">E</div>\n    <div class=\"bg-orange-500 text-white p-4 rounded\">F</div>\n    <div class=\"bg-rose-500 text-white p-4 rounded\">G</div>\n    <div class=\"bg-sky-500 text-white p-4 rounded\">H</div>\n  </div>\n\n  <!-- 範例三：跨欄與跨列 -->\n  <div class=\"grid grid-cols-1 md:grid-cols-3 grid-rows-2 gap-4 bg-white p-6 rounded shadow\">\n    <div class=\"bg-blue-300 text-center p-4 rounded row-span-2\">跨 2 欄</div>\n    <div class=\"bg-green-300 text-center p-4 rounded row-span-2\">跨 2 列</div>\n    <div class=\"bg-red-300 text-center p-4 rounded\">單格</div>\n    <div class=\"bg-yellow-300 text-center p-4 rounded\">單格</div>\n    <div class=\"bg-purple-300 text-center p-4 rounded col-span-2\">這格跨 3 欄</div>\n  </div>\n\n  <!-- 範例四：排列控制 + auto flow -->\n  <div class=\"grid grid-flow-col md:grid-flow-row grid-cols-3 grid-rows-2 gap-4 bg-white p-6 rounded shadow\">\n    <div class=\"bg-blue-400 text-white p-4 rounded\">Box 1</div>\n    <div class=\"bg-green-400 text-white p-4 rounded\">Box 2</div>\n    <div class=\"bg-red-400 text-white p-4 rounded\">Box 3</div>\n    <div class=\"bg-yellow-400 text-white p-4 rounded\">Box 4</div>\n    <div class=\"bg-pink-400 text-white p-4 rounded\">Box 5</div>\n    <div class=\"bg-teal-400 text-white p-4 rounded\">Box 6</div>\n  </div>\n  \n  <!-- 範例一：三個項目，基礎排列 -->\n  <div class=\"flex space-x-4 bg-white p-6 rounded shadow\">\n    <div class=\"p-4 bg-blue-500 text-white rounded\">Item 1</div>\n    <div class=\"p-4 bg-green-500 text-white rounded\">Item 2</div>\n    <div class=\"p-4 bg-red-500 text-white rounded\">Item 3</div>\n  </div>\n\n  <!-- 範例二：方向 + 反向排列 -->\n  <div class=\"flex flex-col md:flex-row md:flex-row-reverse space-y-4 md:space-y-0 md:space-x-4 bg-white p-6 rounded shadow\">\n    <div class=\"p-4 bg-purple-500 text-white rounded\">A</div>\n    <div class=\"p-4 bg-indigo-500 text-white rounded\">B</div>\n    <div class=\"p-4 bg-teal-500 text-white rounded\">C</div>\n  </div>\n\n  <!-- 範例三：Grow / Shrink / Auto -->\n  <div class=\"flex bg-white p-6 rounded shadow space-x-4\">\n    <div class=\"flex-none w-24 p-4 bg-blue-300 text-center rounded\">固定 w-24</div>\n    <div class=\"flex-auto p-4 bg-green-300 text-center rounded\">flex-auto</div>\n    <div class=\"flex-1 p-4 bg-red-300 text-center rounded\">flex-1</div>\n  </div>\n\n  <!-- 範例四：Wrap + 對齊 + 排列控制 -->\n  <div class=\"flex flex-nowrap bg-white p-6 rounded shadow justify-around items-center gap-4\">\n    <div class=\"flex-[100%] flex-[50%] h-20 bg-blue-400 text-white flex items-center justify-center rounded\">Box 1</div>\n    <div class=\"flex-[50%] h-20 bg-green-400 text-white flex items-center justify-center rounded\">Box 2</div>\n    <div class=\"flex-[50%] h-20 bg-red-400 text-white flex items-center justify-center rounded\">Box 3</div>\n    <div class=\"flex-[50%] h-20 bg-yellow-400 text-white flex items-center justify-center rounded\">Box 4</div>\n    <div class=\"flex-[50%] h-20 bg-pink-400 text-white flex items-center justify-center rounded\">Box 5</div>\n  </div>\n\n  <!-- 範例五：Alignment 範例 -->\n  <div class=\"flex bg-white p-6 rounded shadow h-40\">\n    <div class=\"flex-1 bg-blue-200 flex items-start justify-start rounded\">top / left</div>\n    <div class=\"flex-1 bg-green-200 flex items-center justify-center rounded\">center</div>\n    <div class=\"flex-1 bg-red-200 flex items-end justify-end rounded\">bottom / right</div>\n  </div>\n\n</body>\n</html>\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Tailwind Flex Demo</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n</head>\n<body class=\"bg-gray-100 p-8 space-y-12\">\n\n  <!-- 範例一：三個項目，基礎排列 -->\n  <div class=\"flex space-x-4 bg-white p-6 rounded shadow\">\n    <div class=\"p-4 bg-blue-500 text-white rounded\">Item 1</div>\n    <div class=\"p-4 bg-green-500 text-white rounded\">Item 2</div>\n    <div class=\"p-4 bg-red-500 text-white rounded\">Item 3</div>\n  </div>\n\n  <!-- 範例二：方向 + 反向排列 -->\n  <div class=\"flex flex-col md:flex-row md:flex-row-reverse space-y-4 md:space-y-0 md:space-x-4 bg-white p-6 rounded shadow\">\n    <div class=\"p-4 bg-purple-500 text-white rounded\">A</div>\n    <div class=\"p-4 bg-indigo-500 text-white rounded\">B</div>\n    <div class=\"p-4 bg-teal-500 text-white rounded\">C</div>\n  </div>\n\n  <!-- 範例三：Grow / Shrink / Auto -->\n  <div class=\"flex bg-white p-6 rounded shadow space-x-4\">\n    <div class=\"flex-none w-24 p-4 bg-blue-300 text-center rounded\">固定 w-24</div>\n    <div class=\"flex-auto p-4 bg-green-300 text-center rounded\">flex-auto</div>\n    <div class=\"flex-1 p-4 bg-red-300 text-center rounded\">flex-1</div>\n  </div>\n\n  <!-- 範例四：Wrap + 對齊 + 排列控制 -->\n  <div class=\"flex flex-wrap bg-white p-6 rounded shadow justify-around items-center gap-4\">\n    <div class=\"w-40 h-20 bg-blue-400 text-white flex items-center justify-center rounded\">Box 1</div>\n    <div class=\"w-40 h-20 bg-green-400 text-white flex items-center justify-center rounded\">Box 2</div>\n    <div class=\"w-40 h-20 bg-red-400 text-white flex items-center justify-center rounded\">Box 3</div>\n    <div class=\"w-40 h-20 bg-yellow-400 text-white flex items-center justify-center rounded\">Box 4</div>\n    <div class=\"w-40 h-20 bg-pink-400 text-white flex items-center justify-center rounded\">Box 5</div>\n  </div>\n\n  <!-- 範例五：Alignment 範例 -->\n  <div class=\"flex bg-white p-6 rounded shadow h-40\">\n    <div class=\"flex-1 bg-blue-200 flex items-start justify-start rounded\">top / left</div>\n    <div class=\"flex-1 bg-green-200 flex items-center justify-center rounded\">center</div>\n    <div class=\"flex-1 bg-red-200 flex items-end justify-end rounded\">bottom / right</div>\n  </div>\n\n</body>\n</html>"
