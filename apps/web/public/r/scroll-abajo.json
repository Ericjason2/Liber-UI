      "content": "/**\n * Component: SCROLL ABAJO\n * Author: @raulanto (https://tailwindflex.com/@raulanto)\n * Source: https://tailwindflex.com/@raulanto/scroll-abajo\n * Attribution: Créé par @raulanto sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function ScrollAbajo() {\n  return (\n    <div dangerouslySetInnerHTML={{ __html: \"<!DOCTYPE html>\\n<html lang=\\\"en\\\">\\n<head>\\n\\n    \\n    <link href=\\\"https://fonts.googleapis.com/css2?family=Noto+Sans:wght@300;400;500;600&family=Noto+Serif:wght@400;500;600&display=swap\\\" rel=\\\"stylesheet\\\">\\n\\n</head>\\n<body class=\\\"bg-paper text-moss-dark font-sans flex justify-center items-center\\\">\\n        <div class=\\\"absolute bottom-8 left-1/2 transform -translate-x-1/2 z-20\\\">\\n            <div class=\\\"flex flex-col items-center animate-bounce\\\">\\n                <span class=\\\"text-xs font-sans text-moss-dark opacity-80 mb-2\\\">Scroll ABAJO</span>\\n                <div class=\\\"w-6 h-10 rounded-full border-2 border-moss border-opacity-50 flex justify-center p-1\\\">\\n                    <div class=\\\"w-1 h-2 bg-moss rounded-full animate-bounce\\\" style=\\\"animation-delay: 0.2s;\\\"></div>\\n                </div>\\n            </div>\\n        </div>\\n    </section>\\n</body>\\n</html>\" }} />\n  );\n}\n",
