    "rawHtml": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Registro de Miembros</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n    \n    <style>\n        body { font-family: 'Inter', sans-serif; }\n    </style>\n</head>\n<body class=\"h-screen w-full flex overflow-hidden\">\n\n    <div class=\"hidden md:block w-1/2 relative\">\n        \n        <img \n            src=\"https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=80&w=2070&auto=format&fit=crop\" \n            alt=\"El futuro\" \n            class=\"absolute inset-0 w-full h-full object-cover\"\n        >\n        \n        <div class=\"absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent\"></div>\n\n        <div class=\"absolute bottom-0 left-0 p-16 w-full z-10\">\n            <h1 class=\"text-4xl lg:text-5xl font-bold text-white tracking-tight leading-tight drop-shadow-lg\">\n                El futuro espera por nosotros\n            </h1>\n        </div>\n    </div>\n\n    <div class=\"w-full md:w-1/2 bg-[#1a1a1a] flex items-center justify-center p-4\">\n        \n        <div class=\"relative bg-white w-full max-w-md rounded-[2.5rem] p-8 md:p-10 shadow-2xl\">\n            \n            <a href=\"index.html\" class=\"absolute top-6 right-6 p-1 text-black hover:bg-gray-100 rounded-full transition\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"2\" stroke=\"currentColor\" class=\"w-6 h-6\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 18L18 6M6 6l12 12\" />\n                </svg>\n            </a>\n\n            <div class=\"mb-6 mt-2\">\n                <h2 class=\"text-2xl font-bold text-black text-center mb-4\">Registro de miembros</h2>\n                <p class=\"text-xs font-semibold text-black leading-snug text-center px-2\">\n                    Sólo necesitas tu número de cédula y teléfono de contacto para completar el registro\n                </p>\n            </div>\n\n            <form action=\"#\" class=\"space-y-5\">\n                \n                <div>\n                    <label class=\"block text-sm font-bold text-black mb-2 ml-1\">\n                        Cedula de identidad\n                    </label>\n                    <input \n                        type=\"text\" \n                        class=\"w-full bg-white border border-black rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-green-400 focus:border-transparent transition-all\"\n                    >\n                </div>\n\n                <div>\n                    <label class=\"block text-sm font-bold text-black mb-2 ml-1\">\n                        Telefono de contacto\n                    </label>\n                    <input \n                        type=\"tel\" \n                        class=\"w-full bg-white border border-black rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-green-400 focus:border-transparent transition-all\"\n                    >\n                </div>\n\n                <div class=\"space-y-3 pt-4\">\n                    <button type=\"button\" class=\"w-full bg-[#55FF55] hover:bg-[#4ce64c] text-black font-bold py-3.5 rounded-full shadow-md transition-transform transform active:scale-95 text-base\">\n                        Crear registro\n                    </button>\n\n                    <button type=\"button\" class=\"w-full bg-gray-300 hover:bg-gray-400 text-black font-bold py-3.5 rounded-full shadow-sm transition-colors text-base\">\n                        Iniciar sesión\n                    </button>\n                </div>\n\n            </form>\n        </div>\n    </div>\n\n</body>\n</html>"
