    "rawHtml": "<body class=\"flex items-center justify-center min-h-screen p-4\">\n\n  <!-- Card Container & Global Perspective -->\n  <div class=\"card-perspective-container max-w-md w-full p-6 sm:p-8\">\n\n    <!-- Interactive Card - Ready for 3D Tilt -->\n    <div id=\"premiumCard\" class=\"interactive-card rounded-2xl relative overflow-hidden bg-white\">\n\n      <!-- Shine Effect Layer -->\n      <div class=\"shine-effect absolute inset-0 z-10\"></div>\n\n      <!-- Content Block - Pushed forward in Z-space -->\n      <div class=\"content-block p-6 sm:p-8\">\n\n        <!-- Header/Tag -->\n        <div class=\"flex items-center justify-between mb-4 translate-z-10\">\n          <span class=\"text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full text-indigo-700 bg-indigo-100 border border-indigo-300\">\n                        DESIGN SYSTEM V3\n                    </span>\n          <svg class=\"w-6 h-6 text-indigo-600\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"\n            xmlns=\"http://www.w3.org/2000/svg\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"\n              d=\"M5 3v4M3 5h4M6 17v4M17 19h4M16 3h4M18 5h-4M5 13v4M12 11h.01M17 13h.01M12 17h.01M17 17h.01\"></path>\n          </svg>\n        </div>\n\n        <!-- Title - Subtle new gradient -->\n        <h1\n          class=\"text-4xl sm:text-5xl font-extrabold mb-3 text-transparent bg-clip-text bg-gradient-to-r from-gray-900 to-indigo-800 leading-tight translate-z-20\">\n          Velocity Core\n        </h1>\n\n        <!-- Subtitle/Description -->\n        <p class=\"text-lg text-gray-600 mb-6 translate-z-10\">\n          Experience unparalleled interaction with our high-fidelity, responsive data visualization framework.\n        </p>\n\n        <!-- Specs Area (More structure than a simple list) -->\n        <div class=\"grid grid-cols-2 gap-4 text-center border-t border-b border-gray-200 py-4 mb-8\">\n          <div class=\"border-r border-gray-200 pr-4\">\n            <p class=\"text-3xl font-bold text-indigo-600\">99.9<span class=\"text-lg text-gray-500\">%</span></p>\n            <p class=\"text-sm text-gray-500 mt-1\">Uptime SLA</p>\n          </div>\n          <div class=\"pl-4\">\n            <p class=\"text-3xl font-bold text-pink-600\">45<span class=\"text-lg text-gray-500\">ms</span></p>\n            <p class=\"text-sm text-gray-500 mt-1\">Avg. Latency</p>\n          </div>\n        </div>\n\n        <!-- Action Button -->\n        <button class=\"glow-button w-full px-6 py-3 rounded-xl font-bold text-lg text-white uppercase tracking-wider\n                               bg-gradient-to-r from-purple-700 to-pink-600\n                               hover:from-purple-600 hover:to-pink-500 focus:outline-none focus:ring-4 focus:ring-purple-500 focus:ring-opacity-50\">\n                    Deploy Solution\n                </button>\n\n      </div>\n    </div>\n  </div>\n\n  <script>\n    const card = document.getElementById('premiumCard');\n        const container = document.querySelector('.card-perspective-container');\n        const maxRotation = 10; // Max rotation in degrees\n\n        function handleMouseMove(e) {\n            // Get center coordinates of the card\n            const rect = card.getBoundingClientRect();\n            const centerX = rect.left + rect.width / 2;\n            const centerY = rect.top + rect.height / 2;\n\n            // Calculate mouse position relative to the center (-1 to 1)\n            const x = (e.clientX - centerX) / (rect.width / 2); // -1 when on the left, 1 on the right\n            const y = (e.clientY - centerY) / (rect.height / 2); // -1 when on the top, 1 on the bottom\n\n            // Calculate rotation amount (invert Y for natural tilt)\n            const rotateX = -y * maxRotation; // Tilt up/down\n            const rotateY = x * maxRotation;  // Tilt left/right\n\n            // Apply the 3D transform\n            card.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;\n\n            // Subtle background effect adjustment on hover\n            container.style.background = `radial-gradient(circle at ${e.clientX}px ${e.clientY}px, rgba(139, 92, 246, 0.05) 0%, transparent 40%)`;\n        }\n\n        function handleMouseLeave() {\n            // Reset transform smoothly\n            card.style.transform = 'rotateX(0deg) rotateY(0deg)';\n            container.style.background = 'none'; // Clear subtle background\n        }\n\n        // Attach event listeners\n        card.addEventListener('mousemove', handleMouseMove);\n        card.addEventListener('mouseleave', handleMouseLeave);\n        card.addEventListener('mouseenter', handleMouseMove);\n  </script>"
  }
