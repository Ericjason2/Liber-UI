      "content": "/**\n * Component: carte visa black\n * Author: @omer-fils-elenga (https://tailwindflex.com/@omer-fils-elenga)\n * Source: https://tailwindflex.com/@omer-fils-elenga/carte-visa-black\n * Attribution: Créé par @omer-fils-elenga sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function CarteVisaBlack() {\n  return (\n    <div>\n    \n    <div className=\"flex flex-col items-center justify-between min-h-screen p-12 bg-slate-50\">\n      \n      \n      <figure className=\"relative m-24 [perspective:1000px]\">\n        \n        <div id=\"creditCard\" className=\"credit-card w-max h-max relative select-none transition-transform duration-700 [transform-style3d]\">\n          \n          \n          \n          <div className=\"verso absolute overflow-hidden w-96 h-56 rounded-2xl bg-gray-400 shadow-2xl [backface-visibility] [transform(180deg)]\">\n            <div className=\"w-full h-12 bg-gray-200 absolute top-10\">&nbsp;</div>\n          </div>\n    \n          \n          \n          <div className=\"recto z-2 relative overflow-hidden w-96 h-56 rounded-2xl px-8 py-6 bg-black text-white shadow-xl flex flex-col justify-end gap-6 [backface-visibility]\">\n            \n            <div className=\"logo absolute top-6 right-8 w-16 h-8 flex justify-items-center items-center\">\n              <svg viewBox=\"0 0 1000 324.68\">\n                <path d=\"m651.19 0.5c-70.933 0-134.32 36.766-134.32 104.69 0 77.9 112.42 83.281 112.42 122.42 0 16.478-18.884 31.229-51.137 31.229-45.773 0-79.984-20.611-79.984-20.611l-14.638 68.547s39.41 17.41 91.734 17.41c77.552 0 138.58-38.571 138.58-107.66 0-82.316-112.89-87.536-112.89-123.86 0-12.908 15.502-27.052 47.663-27.052 36.287 0 65.892 14.99 65.892 14.99l14.326-66.204s-32.213-13.897-77.642-13.897zm-648.97 4.9966-1.7176 9.9931s29.842 5.4615 56.719 16.356c34.607 12.493 37.072 19.765 42.9 42.354l63.511 244.83h85.137l131.16-313.53h-84.942l-84.278 213.17-34.39-180.7c-3.1539-20.681-19.129-32.478-38.684-32.478h-135.41zm411.87 0-66.634 313.53h80.999l66.4-313.53h-80.765zm451.76 0c-19.532 0-29.88 10.457-37.474 28.73l-118.67 284.8h84.942l16.434-47.467h103.48l9.9931 47.467h74.948l-65.385-313.53h-68.273zm11.047 84.707 25.178 117.65h-67.454l42.276-117.65z\" fill=\"#fff\" />\n              </svg>\n            </div>\n    \n            \n            <div className=\"pin w-11 h-7 rounded bg-yellow-100\">&nbsp;</div>\n    \n            \n            <div className=\"number whitespace-nowrap text-2xl font-semibold\" style=\"font-family new, mono;\">\n              4242&nbsp;4242&nbsp;4242&nbsp;4242\n            </div>\n    \n            \n            <div className=\"credentials flex gap-8\">\n              <div className=\"owner flex flex-col w-max\">\n                <span className=\"text-xs uppercase\">Card holder</span>\n                <span className=\"whitespace-nowrap text-lg\">John DOE</span>\n              </div>\n              <div className=\"expires flex flex-col w-max\">\n                <span className=\"text-xs uppercase\">Expires</span>\n                <span className=\"whitespace-nowrap text-lg\">09/21</span>\n              </div>\n              <div className=\"cvc flex flex-col w-max\">\n                <span className=\"text-xs uppercase\">cvc</span>\n                <span className=\"whitespace-nowrap text-lg\">123</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </figure>\n    \n      \n      <button id=\"switchBtn\" className=\"mt-auto px-6 py-3 bg-black hover800 text-white font-medium rounded-xl shadow-lg transition-all active95 text-sm tracking-wide\">\n        Voir autre face\n      </button>\n    \n    </div>\n    \n    \n    \n    </div>\n  );\n}\n",
