    "rawHtml": "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <title>Slider PlayStore Style</title>\n\n  <!-- Tailwind CDN -->\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n\n  <!-- Alpine JS -->\n  <script defer src=\"https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js\"></script>\n\n  <style>\n    @keyframes float {\n      0% { transform: translateY(0); opacity: 0.8; }\n      50% { transform: translateY(-6px); opacity: 1; }\n      100% { transform: translateY(0); opacity: 0.8; }\n    }\n\n    /* PlayStore-style continuous scrolling */\n    .carousel-container {\n      display: flex;\n      overflow-x: auto;\n      scroll-snap-type: x mandatory;\n      scroll-behavior: smooth;\n      gap: 20px;\n      padding: 20px;\n      scrollbar-width: none; /* Firefox */\n      -ms-overflow-style: none; /* IE/Edge */\n    }\n\n    .carousel-container::-webkit-scrollbar {\n      display: none; /* Chrome/Safari/Opera */\n    }\n\n    .carousel-card {\n      scroll-snap-align: start;\n      flex: 0 0 calc(33.333% - 20px); /* 3 cards per view with gap */\n      height: 400px;\n      border-radius: 24px;\n      transition: transform 0.3s ease, box-shadow 0.3s ease;\n    }\n\n    .carousel-card:hover {\n      transform: scale(1.03);\n      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 10px 10px -5px rgba(0, 0, 0, 0.2);\n    }\n\n    /* Individual card animations */\n    .card-content {\n      animation: fadeInUp 0.6s ease-out;\n    }\n\n    @keyframes fadeInUp {\n      0% {\n        opacity: 0;\n        transform: translateY(20px);\n      }\n      100% {\n        opacity: 1;\n        transform: translateY(0);\n      }\n    }\n\n    /* Floating animation for elements */\n    .floating-element {\n      animation: float 6s ease-in-out infinite;\n    }\n\n    @keyframes float {\n      0% { transform: translateY(0); }\n      50% { transform: translateY(-10px); }\n      100% { transform: translateY(0); }\n    }\n\n    /* Continuous sliding animation */\n    .continuous-slide {\n      animation: continuousSlide 20s linear infinite;\n    }\n\n    @keyframes continuousSlide {\n      0% { transform: translateX(0); }\n      100% { transform: translateX(-100%); }\n    }\n  </style>\n</head>\n\n<body class=\"bg-gray-100 min-h-screen p-8\">\n\n  <div class=\"w-full max-w-7xl mx-auto\">\n    <h1 class=\"text-3xl font-bold text-center text-white mb-8\">PlayStore Style Carousel</h1>\n\n    <!-- Continuous Scrolling Carousel -->\n    <div class=\"relative overflow-hidden bg-gray-900 rounded-3xl p-8\">\n      <div class=\"carousel-container\" id=\"carousel\" x-data=\"{ currentIndex: 0 }\">\n        <!-- Card 1 -->\n        <div class=\"carousel-card bg-black p-8 flex flex-col justify-between\">\n          <div class=\"card-content\">\n            <h2 class=\"text-2xl font-bold text-white mb-4\">Expressive API</h2>\n            <p class=\"text-gray-300 mb-6\">\n              You don't need to be an expert to use our plugin.\n              Our expressive API is readable and well documented.\n            </p>\n            <button class=\"mt-4 bg-white text-black px-6 py-3 rounded-full font-medium flex items-center gap-2 hover:bg-gray-200 transition\">\n              En savoir plus\n              <span class=\"text-xl\">↗</span>\n            </button>\n          </div>\n          <div class=\"flex space-x-2\">\n            <div class=\"h-2 bg-gray-600 rounded-full flex-1\"></div>\n            <div class=\"h-2 bg-gray-600 rounded-full flex-1\"></div>\n            <div class=\"h-2 bg-gray-600 rounded-full flex-1 w-1/3\"></div>\n          </div>\n        </div>\n\n        <!-- Card 2 -->\n        <div class=\"carousel-card bg-gradient-to-br from-blue-900 to-purple-900 p-8 flex flex-col justify-between\">\n          <div class=\"card-content\">\n            <h2 class=\"text-2xl font-bold text-white mb-4\">UI Components</h2>\n            <p class=\"text-gray-300 mb-6\">\n              Beautifully crafted UI components that integrate seamlessly\n              with your existing workflow and enhance user experience.\n            </p>\n            <button class=\"mt-4 bg-white text-purple-900 px-6 py-3 rounded-full font-medium flex items-center gap-2 hover:bg-gray-200 transition\">\n              Découvrir\n              <span class=\"text-xl\">↗</span>\n            </button>\n          </div>\n          <div class=\"flex space-x-2\">\n            <div class=\"h-2 bg-blue-400 rounded-full flex-1\"></div>\n            <div class=\"h-2 bg-purple-400 rounded-full flex-1\"></div>\n            <div class=\"h-2 bg-pink-400 rounded-full flex-1 w-1/3\"></div>\n          </div>\n        </div>\n\n        <!-- Card 3 -->\n        <div class=\"carousel-card bg-gradient-to-br from-green-900 to-teal-900 p-8 flex flex-col justify-between\">\n          <div class=\"card-content\">\n            <h2 class=\"text-2xl font-bold text-white mb-4\">Performance</h2>\n            <p class=\"text-gray-300 mb-6\">\n              Optimized for speed and efficiency, ensuring your applications\n              run smoothly even under heavy loads.\n            </p>\n            <button class=\"mt-4 bg-white text-teal-900 px-6 py-3 rounded-full font-medium flex items-center gap-2 hover:bg-gray-200 transition\">\n              Optimiser\n              <span class=\"text-xl\">↗</span>\n            </button>\n          </div>\n          <div class=\"flex space-x-2\">\n            <div class=\"h-2 bg-green-400 rounded-full flex-1\"></div>\n            <div class=\"h-2 bg-teal-400 rounded-full flex-1\"></div>\n            <div class=\"h-2 bg-emerald-400 rounded-full flex-1 w-1/3\"></div>\n          </div>\n        </div>\n\n        <!-- Card 4 -->\n        <div class=\"carousel-card bg-gradient-to-br from-yellow-900 to-orange-900 p-8 flex flex-col justify-between\">\n          <div class=\"card-content\">\n            <h2 class=\"text-2xl font-bold text-white mb-4\">Security</h2>\n            <p class=\"text-gray-300 mb-6\">\n              Advanced security features to protect your data and ensure\n              privacy across all your applications and services.\n            </p>\n            <button class=\"mt-4 bg-white text-orange-900 px-6 py-3 rounded-full font-medium flex items-center gap-2 hover:bg-gray-200 transition\">\n              Sécuriser\n              <span class=\"text-xl\">↗</span>\n            </button>\n          </div>\n          <div class=\"flex space-x-2\">\n            <div class=\"h-2 bg-yellow-400 rounded-full flex-1\"></div>\n            <div class=\"h-2 bg-orange-400 rounded-full flex-1\"></div>\n            <div class=\"h-2 bg-amber-400 rounded-full flex-1 w-1/3\"></div>\n          </div>\n        </div>\n\n        <!-- Card 5 -->\n        <div class=\"carousel-card bg-gradient-to-br from-indigo-900 to-pink-900 p-8 flex flex-col justify-between\">\n          <div class=\"card-content\">\n            <h2 class=\"text-2xl font-bold text-white mb-4\">Integration</h2>\n            <p class=\"text-gray-300 mb-6\">\n              Seamless integration with popular platforms and services\n              to enhance your workflow and productivity.\n            </p>\n            <button class=\"mt-4 bg-white text-pink-900 px-6 py-3 rounded-full font-medium flex items-center gap-2 hover:bg-gray-200 transition\">\n              Intégrer\n              <span class=\"text-xl\">↗</span>\n            </button>\n          </div>\n          <div class=\"flex space-x-2\">\n            <div class=\"h-2 bg-indigo-400 rounded-full flex-1\"></div>\n            <div class=\"h-2 bg-purple-400 rounded-full flex-1\"></div>\n            <div class=\"h-2 bg-pink-400 rounded-full flex-1 w-1/3\"></div>\n          </div>\n        </div>\n\n        <!-- Card 6 -->\n        <div class=\"carousel-card bg-gradient-to-br from-red-900 to-gray-900 p-8 flex flex-col justify-between\">\n          <div class=\"card-content\">\n            <h2 class=\"text-2xl font-bold text-white mb-4\">Analytics</h2>\n            <p class=\"text-gray-300 mb-6\">\n              Powerful analytics tools to track performance and gain insights\n              to help you make informed decisions.\n            </p>\n            <button class=\"mt-4 bg-white text-gray-900 px-6 py-3 rounded-full font-medium flex items-center gap-2 hover:bg-gray-200 transition\">\n              Analyser\n              <span class=\"text-xl\">↗</span>\n            </button>\n          </div>\n          <div class=\"flex space-x-2\">\n            <div class=\"h-2 bg-red-400 rounded-full flex-1\"></div>\n            <div class=\"h-2 bg-gray-400 rounded-full flex-1\"></div>\n            <div class=\"h-2 bg-slate-400 rounded-full flex-1 w-1/3\"></div>\n          </div>\n        </div>\n\n        <!-- Duplicate first 3 cards to create seamless loop -->\n        <div class=\"carousel-card bg-black p-8 flex flex-col justify-between\">\n          <div class=\"card-content\">\n            <h2 class=\"text-2xl font-bold text-white mb-4\">Expressive API</h2>\n            <p class=\"text-gray-300 mb-6\">\n              You don't need to be an expert to use our plugin.\n              Our expressive API is readable and well documented.\n            </p>\n            <button class=\"mt-4 bg-white text-black px-6 py-3 rounded-full font-medium flex items-center gap-2 hover:bg-gray-200 transition\">\n              En savoir plus\n              <span class=\"text-xl\">↗</span>\n            </button>\n          </div>\n          <div class=\"flex space-x-2\">\n            <div class=\"h-2 bg-gray-600 rounded-full flex-1\"></div>\n            <div class=\"h-2 bg-gray-600 rounded-full flex-1\"></div>\n            <div class=\"h-2 bg-gray-600 rounded-full flex-1 w-1/3\"></div>\n          </div>\n        </div>\n\n        <div class=\"carousel-card bg-gradient-to-br from-blue-900 to-purple-900 p-8 flex flex-col justify-between\">\n          <div class=\"card-content\">\n            <h2 class=\"text-2xl font-bold text-white mb-4\">UI Components</h2>\n            <p class=\"text-gray-300 mb-6\">\n              Beautifully crafted UI components that integrate seamlessly\n              with your existing workflow and enhance user experience.\n            </p>\n            <button class=\"mt-4 bg-white text-purple-900 px-6 py-3 rounded-full font-medium flex items-center gap-2 hover:bg-gray-200 transition\">\n              Découvrir\n              <span class=\"text-xl\">↗</span>\n            </button>\n          </div>\n          <div class=\"flex space-x-2\">\n            <div class=\"h-2 bg-blue-400 rounded-full flex-1\"></div>\n            <div class=\"h-2 bg-purple-400 rounded-full flex-1\"></div>\n            <div class=\"h-2 bg-pink-400 rounded-full flex-1 w-1/3\"></div>\n          </div>\n        </div>\n\n        <div class=\"carousel-card bg-gradient-to-br from-green-900 to-teal-900 p-8 flex flex-col justify-between\">\n          <div class=\"card-content\">\n            <h2 class=\"text-2xl font-bold text-white mb-4\">Performance</h2>\n            <p class=\"text-gray-300 mb-6\">\n              Optimized for speed and efficiency, ensuring your applications\n              run smoothly even under heavy loads.\n            </p>\n            <button class=\"mt-4 bg-white text-teal-900 px-6 py-3 rounded-full font-medium flex items-center gap-2 hover:bg-gray-200 transition\">\n              Optimiser\n              <span class=\"text-xl\">↗</span>\n            </button>\n          </div>\n          <div class=\"flex space-x-2\">\n            <div class=\"h-2 bg-green-400 rounded-full flex-1\"></div>\n            <div class=\"h-2 bg-teal-400 rounded-full flex-1\"></div>\n            <div class=\"h-2 bg-emerald-400 rounded-full flex-1 w-1/3\"></div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Manual Navigation Controls -->\n    <div class=\"flex justify-center mt-6 space-x-4\">\n      <button id=\"prevBtn\" class=\"bg-white text-gray-800 px-4 py-2 rounded-full font-medium hover:bg-gray-200 transition\">\n        ← Précédent\n      </button>\n      <button id=\"nextBtn\" class=\"bg-white text-gray-800 px-4 py-2 rounded-full font-medium hover:bg-gray-200 transition\">\n        Suivant →\n      </button>\n    </div>\n  </div>\n\n  <script>\n    document.addEventListener('DOMContentLoaded', function() {\n      const carousel = document.getElementById('carousel');\n      const prevBtn = document.getElementById('prevBtn');\n      const nextBtn = document.getElementById('nextBtn');\n      const cardWidth = document.querySelector('.carousel-card').offsetWidth + 20; // width + gap\n\n      // Auto-scroll functionality\n      let scrollInterval = setInterval(() => {\n        carousel.scrollBy({\n          left: cardWidth,\n          behavior: 'smooth'\n        });\n\n        // Reset to start when reaching the end of unique cards\n        setTimeout(() => {\n          if (carousel.scrollLeft >= carousel.scrollWidth / 2) {\n            carousel.scrollTo({\n              left: 0,\n              behavior: 'auto'\n            });\n          }\n        }, 800);\n      }, 3000);\n\n      // Pause auto-scroll when hovering over carousel\n      carousel.addEventListener('mouseenter', () => {\n        clearInterval(scrollInterval);\n      });\n\n      carousel.addEventListener('mouseleave', () => {\n        scrollInterval = setInterval(() => {\n          carousel.scrollBy({\n            left: cardWidth,\n            behavior: 'smooth'\n          });\n\n          // Reset to start when reaching the end of unique cards\n          setTimeout(() => {\n            if (carousel.scrollLeft >= carousel.scrollWidth / 2) {\n              carousel.scrollTo({\n                left: 0,\n                behavior: 'auto'\n              });\n            }\n          }, 800);\n        }, 3000);\n      });\n\n      // Manual navigation\n      nextBtn.addEventListener('click', () => {\n        carousel.scrollBy({\n          left: cardWidth,\n          behavior: 'smooth'\n        });\n      });\n\n      prevBtn.addEventListener('click', () => {\n        carousel.scrollBy({\n          left: -cardWidth,\n          behavior: 'smooth'\n        });\n      });\n    });\n  </script>\n</body>\n</html>"
  }
