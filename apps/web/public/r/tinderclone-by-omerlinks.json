    "rawHtml": "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n    <title>Tinder Clone By OmerLinks</title>\n    <!-- Tailwind CSS -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <!-- GSAP pour les animations fluides -->\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js\"></script>\n    <style>\n        body {\n            background-color: #f3f3f3;\n            /* Empêcher le scroll global sur mobile pour mieux swiper */\n            overflow: hidden; \n            touch-action: none;\n            font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n        }\n\n        /* Nom gradient style Tinder */\n        .name-gradient {\n            background: linear-gradient(to right, #fd297b, #ff655b);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n        }\n\n        /* Cache le défilement */\n        .hide-scrollbar::-webkit-scrollbar {\n            display: none;\n        }\n        .hide-scrollbar {\n            -ms-overflow-style: none;\n            scrollbar-width: none;\n        }\n    </style>\n</head>\n<body class=\"h-screen w-screen flex flex-col items-center justify-center relative\">\n\n    <!-- BACKGROUND DECOR -->\n    <div class=\"absolute top-0 w-full h-full pointer-events-none z-0\">\n        <div class=\"absolute top-[-10%] right-[-10%] w-96 h-96 bg-pink-200 rounded-full mix-blend-multiply filter blur-3xl opacity-50\"></div>\n        <div class=\"absolute bottom-[-10%] left-[-10%] w-96 h-96 bg-yellow-200 rounded-full mix-blend-multiply filter blur-3xl opacity-50\"></div>\n    </div>\n\n    <!-- NAVBAR -->\n    <nav class=\"absolute top-0 w-full h-20 flex items-center justify-between px-6 z-50\">\n        <div class=\"text-[#fbb03b] text-2xl font-extrabold tracking-tight\">tinder<span class=\"text-[#fd297b]\">clone BY</span> Omerlinks</div>\n        <div class=\"flex gap-6 text-gray-500\">\n            <svg class=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z\"></path></svg>\n            <svg class=\"w-6 h-6 text-pink-500\" fill=\"currentColor\" viewBox=\"0 0 20 20\"><path fill-rule=\"evenodd\" d=\"M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z\" clip-rule=\"evenodd\"></path></svg>\n            <svg class=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z\"></path></svg>\n        </div>\n    </nav>\n\n    <!-- CARDS CONTAINER -->\n    <div id=\"card-stack\" class=\"relative w-full max-w-sm aspect-[3/4] z-10\">\n        <!-- Les cartes seront injectées ici par JS -->\n    </div>\n\n    <!-- ACTION BUTTONS -->\n    <div class=\"absolute bottom-8 w-full max-w-md flex justify-between items-center  px-8 z-20\">\n        <button id=\"btn-nope\" class=\"w-14 h-14 rounded-full border border-gray-200 bg-white shadow-md flex items-center justify-center hover:scale-110 active:scale-95 transition text-red-500\">\n            <svg class=\"w-8 h-8\" fill=\"currentColor\" viewBox=\"0 0 20 20\"><path fill-rule=\"evenodd\" d=\"M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z\" clip-rule=\"evenodd\"></path></svg>\n        </button>\n        \n        <button id=\"btn-undo\" class=\"w-10 h-10 rounded-full border border-gray-200 bg-white shadow-md flex items-center justify-center hover:scale-110 active:scale-95 transition text-yellow-500\">\n            <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6\"></path></svg>\n        </button>\n\n        <button id=\"btn-like\" class=\"w-14 h-14 rounded-full border border-gray-200 bg-white shadow-md flex items-center justify-center hover:scale-110 active:scale-95 transition text-green-500\">\n            <svg class=\"w-8 h-8\" fill=\"currentColor\" viewBox=\"0 0 20 20\"><path fill-rule=\"evenodd\" d=\"M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z\" clip-rule=\"evenodd\"></path></svg>\n        </button>\n    </div>\n\n    <script>\n        // --- DONNÉES DES CARTES ---\n        const profiles = [\n            { name: \"Emma\", age: 24, bio: \"Photographe amateur. ☕️\", img: \"https://images.unsplash.com/photo-1544005313-94ddf0286df2?q=80&w=800&auto=format&fit=crop\" },\n            { name: \"Sophie\", age: 22, bio: \"Voyageuse 🌍\", img: \"https://images.unsplash.com/photo-1524504388940-b1c1722653e1?q=80&w=800&auto=format&fit=crop\" },\n            { name: \"Lucas\", age: 27, bio: \"Développeur Web & Fitness 💪\", img: \"https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?q=80&w=800&auto=format&fit=crop\" },\n            { name: \"Chloé\", age: 25, bio: \"Chanteuse à ses heures perdues 🎤\", img: \"https://images.unsplash.com/photo-1517841905240-472988babdf9?q=80&w=800&auto=format&fit=crop\" },\n            { name: \"Thomas\", age: 29, bio: \"Entrepreneur en série 🚀\", img: \"https://images.unsplash.com/photo-1500648767791-00dcc994a43e?q=80&w=800&auto=format&fit=crop\" },\n        ];\n\n        // --- VARIABLES GLOBALES ---\n        const cardStack = document.getElementById('card-stack');\n        let cardData = [...profiles]; // Copie des données\n        let swipedCards = []; // Stocke les cartes rejetées pour le bouton Undo\n\n        // --- INITIALISATION ---\n        function init() {\n            renderCards();\n            attachButtonListeners();\n        }\n\n        // --- CRÉATION DES CARTES ---\n        function renderCards() {\n            cardStack.innerHTML = '';\n            // On affiche les 2 dernières cartes (l'une sur l'autre) pour la pile\n            const cardsToShow = cardData.slice(-2).reverse(); \n            \n            cardsToShow.forEach((profile, index) => {\n                const card = createCardElement(profile);\n                cardStack.appendChild(card);\n                \n                // Seule la première carte (celle du dessus) est interactive\n                if (index === 0) {\n                    setupCardInteractions(card);\n                }\n            });\n        }\n\n        // Crée le DOM d'une carte\n        function createCardElement(profile) {\n            const el = document.createElement('div');\n            el.className = 'card absolute top-0 left-0 w-full h-full bg-white rounded-2xl shadow-2xl overflow-hidden select-none touch-none cursor-grab';\n            el.style.willChange = 'transform'; // Optimisation perf\n\n            el.innerHTML = `\n                <div class=\"relative w-full h-full pointer-events-none\">\n                    <img src=\"${profile.img}\" class=\"absolute inset-0 w-full h-full object-cover\">\n                    \n                    <!-- Info Bas de carte -->\n                    <div class=\"absolute bottom-0 left-0 w-full bg-gradient-to-t from-black/80 via-black/40 to-transparent p-6 pt-24 text-white\">\n                        <h2 class=\"text-3xl font-bold mb-1 flex items-center gap-2\">\n                            ${profile.name} <span class=\"text-xl font-normal text-gray-200\">${profile.age}</span>\n                        </h2>\n                        <p class=\"text-sm font-medium text-gray-100\">${profile.bio}</p>\n                    </div>\n\n                    <!-- Stamps Overlays -->\n                    <div class=\"stamp stamp-like absolute top-16 left-8 border-4 border-green-500 text-green-500 text-6xl font-extrabold uppercase tracking-wider px-4 py-2 rounded-lg opacity-0 transform -rotate-12\">\n                        LIKE\n                    </div>\n                    <div class=\"stamp stamp-nope absolute top-16 right-8 border-4 border-red-500 text-red-500 text-6xl font-extrabold uppercase tracking-wider px-4 py-2 rounded-lg opacity-0 transform rotate-12\">\n                        NOPE\n                    </div>\n                </div>\n            `;\n            return el;\n        }\n\n        // --- LOGIQUE DE DRAG / SWIPE (Cœur du système) ---\n        function setupCardInteractions(card) {\n            let isDragging = false;\n            let startPos = { x: 0, y: 0 };\n            let currentPos = { x: 0, y: 0 };\n\n            const likeStamp = card.querySelector('.stamp-like');\n            const nopeStamp = card.querySelector('.stamp-nope');\n\n            // Helpers pour Touch & Mouse unifiés\n            const getPos = (e) => e.touches ? e.touches[0] : e;\n\n            function onStart(e) {\n                isDragging = true;\n                startPos = { x: getPos(e).clientX, y: getPos(e).clientY };\n                gsap.killTweensOf(card); // Stopper les animations en cours\n                card.style.cursor = 'grabbing';\n            }\n\n            function onMove(e) {\n                if (!isDragging) return;\n                // Empêcher le scroll mobile pendant le drag\n                if(e.cancelable) e.preventDefault();\n\n                const x = getPos(e).clientX;\n                const y = getPos(e).clientY;\n                currentPos.x = x - startPos.x;\n                currentPos.y = y - startPos.y;\n\n                // 1. Rotation en fonction du X\n                const rotation = currentPos.x * 0.1; // 10% du déplacement = angle\n\n                // 2. Mise à jour position et rotation via GSAP pour la fluidité (pour le rendu, pas pour l'anim)\n                gsap.set(card, { \n                    x: currentPos.x, \n                    y: currentPos.y, \n                    rotation: rotation \n                });\n\n                // 3. Calcul opacité des Stamps\n                const opacity = Math.min(Math.abs(currentPos.x) / 100, 1); // Max 1\n                if (currentPos.x > 0) {\n                    likeStamp.style.opacity = opacity;\n                    nopeStamp.style.opacity = 0;\n                } else {\n                    nopeStamp.style.opacity = opacity;\n                    likeStamp.style.opacity = 0;\n                }\n            }\n\n            function onEnd() {\n                if (!isDragging) return;\n                isDragging = false;\n                card.style.cursor = 'grab';\n\n                const threshold = 100; // Distance min pour valider le swipe\n\n                if (currentPos.x > threshold) {\n                    swipeCard(card, 'like');\n                } else if (currentPos.x < -threshold) {\n                    swipeCard(card, 'nope');\n                } else {\n                    // Retour au centre (Spring back)\n                    gsap.to(card, { x: 0, y: 0, rotation: 0, duration: 0.3, ease: \"back.out(1.7)\" });\n                    gsap.to('.stamp', { opacity: 0, duration: 0.2 });\n                }\n            }\n\n            // Écouteurs Souris\n            card.addEventListener('mousedown', onStart);\n            window.addEventListener('mousemove', onMove);\n            window.addEventListener('mouseup', onEnd);\n\n            // Écouteurs Tactiles (Mobile)\n            card.addEventListener('touchstart', onStart, {passive: false});\n            window.addEventListener('touchmove', onMove, {passive: false});\n            window.addEventListener('touchend', onEnd);\n        }\n\n        // --- ANIMATION DE SORTIE ---\n        function swipeCard(card, direction) {\n            const xMove = direction === 'like' ? window.innerWidth : -window.innerWidth;\n            const rotation = direction === 'like' ? 45 : -45;\n\n            // Animer la carte hors écran\n            gsap.to(card, {\n                x: xMove,\n                rotation: rotation,\n                duration: 0.5,\n                ease: \"power2.in\",\n                onComplete: () => {\n                    // Supprimer du DOM et des données\n                    card.remove();\n                    const removedProfile = cardData.pop();\n                    swipedCards.push(removedProfile); // Pour le bouton Undo\n                    \n                    // Recharger la carte suivante si dispo\n                    if (cardData.length > 0) renderCards();\n                }\n            });\n        }\n\n        // --- BOUTONS D'ACTIONS ---\n        function attachButtonListeners() {\n            const currentCardSelector = () => document.querySelector('#card-stack > .card:last-child');\n            \n            document.getElementById('btn-like').addEventListener('click', () => {\n                const card = currentCardSelector();\n                if (card) swipeCard(card, 'like');\n            });\n\n            document.getElementById('btn-nope').addEventListener('click', () => {\n                const card = currentCardSelector();\n                if (card) swipeCard(card, 'nope');\n            });\n\n            document.getElementById('btn-undo').addEventListener('click', () => {\n                if (swipedCards.length > 0) {\n                    const lastProfile = swipedCards.pop();\n                    cardData.push(lastProfile);\n                    \n                    // Recréer la pile\n                    renderCards();\n                    \n                    // Animation d'entrée pour la nouvelle carte du dessus\n                    const newCard = document.querySelector('#card-stack > .card:last-child');\n                    gsap.fromTo(newCard, \n                        { x: window.innerWidth, rotation: 45 }, \n                        { x: 0, rotation: 0, duration: 0.5, ease: \"power2.out\" }\n                    );\n                }\n            });\n        }\n\n        // Lancement\n        init();\n\n    </script>\n</body>\n</html>"
  }
}
