      "content": "import * as React from \"react\"\n\nfunction CardKpi({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"card-kpi\"\n      className={className}\n      {...props}\n    >\n      <style>{\"/* Estilo base para el cuerpo */\\n        body {\\n            font-family: 'Inter', sans-serif;\\n        }\"}</style>\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6\">\n      \n          \n          <div\n              className=\"bg-white dark:bg-gray-800 p-6 rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1\">\n              <div className=\"flex justify-between items-start\">\n                  <div className=\"flex flex-col space-y-1\">\n                      <span className=\"text-sm font-medium text-gray-500 dark:text-gray-400\">Ventas Totales</span>\n                      <span className=\"text-3xl font-bold text-gray-900 dark:text-white\">$48,250.00</span>\n                  </div>\n                  \n                  <div className=\"p-2 bg-green-100 dark:bg-green-900 rounded-full\">\n                      <svg className=\"w-6 h-6 text-green-600 dark:text-green-300\" fill=\"none\" stroke=\"currentColor\"\n                          viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                          <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\"\n                              d=\"M13 7h8m0 0v8m0-8l-8 8-4-4-6 6\"></path>\n                      </svg>\n                  </div>\n              </div>\n              <div className=\"mt-4\">\n                  <span className=\"inline-flex items-center text-sm font-semibold text-green-600 dark:text-green-400\">\n                              <svg className=\"w-4 h-4 mr-1\" fill=\"currentColor\" viewBox=\"0 0 20 20\" xmlns=\"http://www.w3.org/2000/svg\"><path fillRule=\"evenodd\" d=\"M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-8.707a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z\" clipRule=\"evenodd\"></path></svg>\n                              +12.5% vs. mes pasado\n                          </span>\n              </div>\n          </div>\n      \n          \n          <div\n              className=\"bg-white dark:bg-gray-800 p-6 rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1\">\n              <div className=\"flex justify-between items-start\">\n                  <div className=\"flex flex-col space-y-1\">\n                      <span className=\"text-sm font-medium text-gray-500 dark:text-gray-400\">Nuevos Usuarios</span>\n                      <span className=\"text-3xl font-bold text-gray-900 dark:text-white\">1,240</span>\n                  </div>\n                  \n                  <div className=\"p-2 bg-red-100 dark:bg-red-900 rounded-full\">\n                      <svg className=\"w-6 h-6 text-red-600 dark:text-red-300\" fill=\"none\" stroke=\"currentColor\"\n                          viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                          <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\"\n                              d=\"M13 17h8m0 0v-8m0 8l-8-8-4 4-6-6\"></path>\n                      </svg>\n                  </div>\n              </div>\n              <div className=\"mt-4\">\n                  <span className=\"inline-flex items-center text-sm font-semibold text-red-600 dark:text-red-400\">\n                              <svg className=\"w-4 h-4 mr-1\" fill=\"currentColor\" viewBox=\"0 0 20 20\" xmlns=\"http://www.w3.org/2000/svg\"><path fillRule=\"evenodd\" d=\"M10 18a8 8 0 100-16 8 8 0 000 16zM7 9a1 1 0 011-1h4a1 1 0 110 2H8a1 1 0 01-1-1z\" clipRule=\"evenodd\"></path></svg>\n                              -3.2% vs. semana pasada\n                          </span>\n              </div>\n          </div>\n      \n          \n          <div\n              className=\"bg-white dark:bg-gray-800 p-6 rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1\">\n              <div className=\"flex flex-col space-y-2\">\n                  <span className=\"text-sm font-medium text-gray-500 dark:text-gray-400\">Tasa de Conversión</span>\n                  <span className=\"text-3xl font-bold text-gray-900 dark:text-white\">25.8%</span>\n                  <div className=\"w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2.5\">\n                      \n                      <div className=\"bg-blue-600 dark:bg-blue-500 h-2.5 rounded-full\" style={{ width: \"25.8%\" }}></div>\n                  </div>\n                  <span className=\"text-sm text-gray-500 dark:text-gray-400 text-right\">Objetivo: 30%</span>\n              </div>\n          </div>\n      \n      \n      \n          \n          <div\n              className=\"bg-white dark:bg-gray-800 p-6 rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1\">\n              <div className=\"flex flex-col items-center justify-center h-full text-center\">\n                  <span className=\"text-sm font-medium text-gray-500 dark:text-gray-400\">Tasa de Rebote</span>\n                  <span className=\"text-4xl font-bold text-gray-900 dark:text-white my-2\">42%</span>\n                  <span className=\"text-sm text-gray-500 dark:text-gray-400\">Últimos 30 días</span>\n              </div>\n          </div>\n      \n      \n      \n      </div> \n    </div>\n  )\n}\n\nexport { CardKpi }\n",
      "type": "registry:ui"
    }
