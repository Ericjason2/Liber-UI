      "content": "/**\n * Component: dreams\n * Author: @baraka-salvator (https://tailwindflex.com/@baraka-salvator)\n * Source: https://tailwindflex.com/@baraka-salvator/dreams\n * Attribution: Créé par @baraka-salvator sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function Dreams() {\n  return (\n    <div dangerouslySetInnerHTML={{ __html: \"<!DOCTYPE html>\\n<html lang=\\\"en\\\">\\n<head>\\n    <meta charset=\\\"UTF-8\\\">\\n    <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\">\\n    <title>Neomorphic Future UI</title>\\n    \\n    \\n    <link href=\\\"https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Space+Mono&display=swap\\\" rel=\\\"stylesheet\\\">\\n    <style>\\n        .neu {\\n            border-radius: 20px;\\n            background: linear-gradient(145deg, #121218, #0f0f15);\\n            box-shadow:  8px 8px 16px #0a0a0f,\\n                        -8px -8px 16px #1a1a22;\\n        }\\n        \\n        .neu-inset {\\n            border-radius: 12px;\\n            background: linear-gradient(145deg, #0f0f15, #121218);\\n            box-shadow: inset 5px 5px 10px #0a0a0f,\\n                        inset -5px -5px 10px #1a1a22;\\n        }\\n        \\n        .glow {\\n            filter: drop-shadow(0 0 8px currentColor);\\n        }\\n        \\n        .gradient-border {\\n            position: relative;\\n            border-radius: 20px;\\n        }\\n        \\n        .gradient-border::before {\\n            content: '';\\n            position: absolute;\\n            top: -2px;\\n            left: -2px;\\n            right: -2px;\\n            bottom: -2px;\\n            border-radius: 22px;\\n            background: linear-gradient(45deg, #00f7ff, #ff00f7, #c400ff);\\n            background-size: 200% 200%;\\n            animation: text-gradient 4s ease infinite;\\n            z-index: -1;\\n        }\\n        \\n        .holographic {\\n            background: linear-gradient(135deg, \\n                rgba(0, 247, 255, 0.1) 0%, \\n                rgba(196, 0, 255, 0.1) 50%, \\n                rgba(255, 0, 247, 0.1) 100%);\\n            position: relative;\\n            overflow: hidden;\\n        }\\n        \\n        .holographic::after {\\n            content: '';\\n            position: absolute;\\n            top: -50%;\\n            left: -50%;\\n            width: 200%;\\n            height: 200%;\\n            background: linear-gradient(\\n                to bottom right,\\n                rgba(255, 255, 255, 0) 0%,\\n                rgba(255, 255, 255, 0) 45%,\\n                rgba(255, 255, 255, 0.03) 50%,\\n                rgba(255, 255, 255, 0) 55%,\\n                rgba(255, 255, 255, 0) 100%\\n            );\\n            transform: rotate(30deg);\\n            animation: shine 6s infinite;\\n        }\\n        \\n        @keyframes shine {\\n            0% { transform: rotate(30deg) translate(-30%, -30%); }\\n            100% { transform: rotate(30deg) translate(30%, 30%); }\\n        }\\n    </style>\\n</head>\\n<body class=\\\"min-h-screen bg-dark-950 text-gray-100 font-sans overflow-x-hidden\\\">\\n    <!-- Interactive background grid -->\\n    <div class=\\\"fixed inset-0 overflow-hidden pointer-events-none z-0 opacity-20\\\">\\n        <div class=\\\"absolute inset-0 grid grid-cols-12 grid-rows-12 gap-px\\\">\\n            <template x-for=\\\"i in 144\\\" :key=\\\"i\\\">\\n                <div class=\\\"bg-dark-800 hover:bg-neon-cyan transition-all duration-1000\\\" \\n                     @mousemove=\\\"document.querySelector(`.bg-cell-${i}`).classList.add('bg-neon-cyan'); setTimeout(() => document.querySelector(`.bg-cell-${i}`).classList.remove('bg-neon-cyan'), 1000)\\\">\\n                </div>\\n            </template>\\n        </div>\\n    </div>\\n\\n    <!-- Navigation with morphing menu -->\\n    <nav class=\\\"relative z-50 py-6 px-6 md:px-12 lg:px-24 flex justify-between items-center\\\">\\n        <div class=\\\"flex items-center space-x-3\\\">\\n            <div class=\\\"w-10 h-10 rounded-xl neu flex items-center justify-center\\\">\\n                <div class=\\\"w-6 h-6 rounded-lg bg-gradient-to-br from-neon-cyan to-neon-purple\\\"></div>\\n            </div>\\n            <span class=\\\"text-xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-neon-cyan to-neon-purple\\\">NOVA</span>\\n        </div>\\n        \\n        <div class=\\\"hidden md:flex items-center space-x-1\\\">\\n            <button class=\\\"px-5 py-2 rounded-xl neu hover:neu-inset transition-all duration-300 text-sm font-medium group relative overflow-hidden\\\">\\n                <span class=\\\"relative z-10\\\">Products</span>\\n                <span class=\\\"absolute inset-0 bg-gradient-to-r from-neon-cyan/20 to-neon-purple/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300\\\"></span>\\n            </button>\\n            <button class=\\\"px-5 py-2 rounded-xl neu hover:neu-inset transition-all duration-300 text-sm font-medium group relative overflow-hidden\\\">\\n                <span class=\\\"relative z-10\\\">Solutions</span>\\n                <span class=\\\"absolute inset-0 bg-gradient-to-r from-neon-purple/20 to-neon-pink/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300\\\"></span>\\n            </button>\\n            <button class=\\\"px-5 py-2 rounded-xl neu hover:neu-inset transition-all duration-300 text-sm font-medium group relative overflow-hidden\\\">\\n                <span class=\\\"relative z-10\\\">Resources</span>\\n                <span class=\\\"absolute inset-0 bg-gradient-to-r from-neon-pink/20 to-neon-cyan/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300\\\"></span>\\n            </button>\\n        </div>\\n        \\n        <button class=\\\"px-6 py-2.5 rounded-xl gradient-border text-sm font-medium group\\\">\\n            <div class=\\\"px-4 py-1.5 rounded-[18px] bg-dark-900 group-hover:bg-dark-800 transition-all duration-300\\\">\\n                Get started\\n            </div>\\n        </button>\\n    </nav>\\n\\n    <!-- Main hero content -->\\n    <main class=\\\"relative z-10 container mx-auto px-6 md:px-12 lg:px-24 py-20 md:py-32\\\">\\n        <div class=\\\"flex flex-col lg:flex-row items-center justify-between gap-16\\\">\\n            <!-- Text content with animated elements -->\\n            <div class=\\\"flex-1 max-w-2xl space-y-8\\\">\\n                <div class=\\\"inline-block px-4 py-2 rounded-full bg-dark-800 border border-dark-700\\\">\\n                    <div class=\\\"flex items-center space-x-2\\\">\\n                        <div class=\\\"relative flex h-2 w-2\\\">\\n                            <span class=\\\"animate-ping absolute inline-flex h-full w-full rounded-full bg-neon-cyan opacity-75\\\"></span>\\n                            <span class=\\\"relative inline-flex rounded-full h-2 w-2 bg-neon-cyan\\\"></span>\\n                        </div>\\n                        <span class=\\\"text-xs font-mono uppercase tracking-widest text-neon-cyan\\\">Beta 2.0 Live</span>\\n                    </div>\\n                </div>\\n                \\n                <h1 class=\\\"text-4xl md:text-5xl lg:text-6xl font-bold leading-tight\\\">\\n                    <span class=\\\"bg-clip-text text-transparent bg-gradient-to-r from-neon-cyan via-neon-purple to-neon-pink animate-text-gradient\\\">\\n                        Reimagining\\n                    </span>\\n                    <br>\\n                    <span class=\\\"text-white\\\">digital experiences</span>\\n                </h1>\\n                \\n                <p class=\\\"text-lg text-gray-400\\\">\\n                    Our quantum-powered platform transforms how you interact with technology. \\n                    Experience the future today with our neural interface technology.\\n                </p>\\n                \\n                <div class=\\\"flex flex-wrap gap-4 pt-6\\\">\\n                    <button class=\\\"px-8 py-3.5 rounded-xl gradient-border font-medium group\\\">\\n                        <div class=\\\"px-6 py-1.5 rounded-[18px] bg-dark-900 group-hover:bg-dark-800 transition-all duration-300 flex items-center\\\">\\n                            <span>Explore demo</span>\\n                            <svg xmlns=\\\"http://www.w3.org/2000/svg\\\" class=\\\"h-5 w-5 ml-2 text-neon-cyan\\\" viewBox=\\\"0 0 20 20\\\" fill=\\\"currentColor\\\">\\n                                <path fill-rule=\\\"evenodd\\\" d=\\\"M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z\\\" clip-rule=\\\"evenodd\\\" />\\n                            </svg>\\n                        </div>\\n                    </button>\\n                    \\n                    <button class=\\\"px-8 py-3.5 rounded-xl neu hover:neu-inset transition-all duration-300 font-medium flex items-center\\\">\\n                        <svg xmlns=\\\"http://www.w3.org/2000/svg\\\" class=\\\"h-5 w-5 mr-2 text-neon-pink\\\" viewBox=\\\"0 0 20 20\\\" fill=\\\"currentColor\\\">\\n                            <path fill-rule=\\\"evenodd\\\" d=\\\"M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z\\\" clip-rule=\\\"evenodd\\\" />\\n                        </svg>\\n                        Watch intro\\n                    </button>\\n                </div>\\n                \\n                <div class=\\\"flex items-center pt-12 space-x-6\\\">\\n                    <div class=\\\"flex items-center space-x-3\\\">\\n                        <div class=\\\"flex -space-x-3\\\">\\n                            <div class=\\\"w-10 h-10 rounded-full neu-inset border-2 border-dark-800 flex items-center justify-center text-xs font-mono font-bold text-neon-cyan\\\">AI</div>\\n                            <div class=\\\"w-10 h-10 rounded-full neu-inset border-2 border-dark-800 flex items-center justify-center text-xs font-mono font-bold text-neon-pink\\\">QT</div>\\n                            <div class=\\\"w-10 h-10 rounded-full neu-inset border-2 border-dark-800 flex items-center justify-center text-xs font-mono font-bold text-neon-purple\\\">ML</div>\\n                        </div>\\n                        <div class=\\\"text-sm text-gray-400\\\">\\n                            <span class=\\\"font-medium text-gray-300\\\">Powered by</span> cutting-edge tech\\n                        </div>\\n                    </div>\\n                </div>\\n            </div>\\n            \\n            <!-- Interactive 3D card element -->\\n            <div class=\\\"flex-1 max-w-xl relative\\\">\\n                <div class=\\\"relative w-full aspect-[1/1.2] neu rounded-3xl overflow-hidden p-1\\\">\\n                    <div class=\\\"h-full w-full rounded-2xl overflow-hidden relative holographic\\\">\\n                        <!-- Floating orb system -->\\n                        <div class=\\\"absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2\\\">\\n                            <div class=\\\"relative w-48 h-48\\\">\\n                                <!-- Central orb -->\\n                                <div class=\\\"absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-16 h-16 rounded-full bg-gradient-to-br from-neon-cyan to-neon-purple glow animate-pulse-slow\\\"></div>\\n                                \\n                                <!-- Orbiting orbs -->\\n                                <div class=\\\"absolute top-0 left-0 w-8 h-8 rounded-full bg-gradient-to-br from-neon-pink to-neon-purple glow animate-orbit\\\" style=\\\"animation-delay: -4s;\\\"></div>\\n                                <div class=\\\"absolute top-0 left-0 w-8 h-8 rounded-full bg-gradient-to-br from-neon-cyan to-neon-pink glow animate-orbit-reverse\\\" style=\\\"animation-delay: -8s;\\\"></div>\\n                                <div class=\\\"absolute top-0 left-0 w-8 h-8 rounded-full bg-gradient-to-br from-neon-purple to-neon-cyan glow animate-orbit\\\" style=\\\"animation-delay: -12s;\\\"></div>\\n                            </div>\\n                        </div>\\n                        \\n                        <!-- UI elements floating in space -->\\n                        <div class=\\\"absolute top-1/4 left-1/4 w-24 h-24 rounded-xl neu-inset border border-dark-700/50 animate-float\\\" style=\\\"animation-delay: 0.5s;\\\"></div>\\n                        <div class=\\\"absolute bottom-1/4 right-1/4 w-20 h-20 rounded-xl neu-inset border border-dark-700/50 animate-float\\\" style=\\\"animation-delay: 1s;\\\"></div>\\n                        <div class=\\\"absolute bottom-1/3 right-1/3 w-16 h-16 rounded-xl neu-inset border border-dark-700/50 animate-float\\\" style=\\\"animation-delay: 1.5s;\\\"></div>\\n                        \\n                        <!-- Connection lines (created with SVG) -->\\n                        <svg class=\\\"absolute inset-0 w-full h-full\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n                            <line x1=\\\"25%\\\" y1=\\\"25%\\\" x2=\\\"50%\\\" y2=\\\"50%\\\" stroke=\\\"url(#gradient)\\\" stroke-width=\\\"1\\\" stroke-dasharray=\\\"4 2\\\" opacity=\\\"0.6\\\" />\\n                            <line x1=\\\"75%\\\" y1=\\\"25%\\\" x2=\\\"50%\\\" y2=\\\"50%\\\" stroke=\\\"url(#gradient)\\\" stroke-width=\\\"1\\\" stroke-dasharray=\\\"4 2\\\" opacity=\\\"0.6\\\" />\\n                            <line x1=\\\"75%\\\" y1=\\\"75%\\\" x2=\\\"50%\\\" y2=\\\"50%\\\" stroke=\\\"url(#gradient)\\\" stroke-width=\\\"1\\\" stroke-dasharray=\\\"4 2\\\" opacity=\\\"0.6\\\" />\\n                            <line x1=\\\"25%\\\" y1=\\\"75%\\\" x2=\\\"50%\\\" y2=\\\"50%\\\" stroke=\\\"url(#gradient)\\\" stroke-width=\\\"1\\\" stroke-dasharray=\\\"4 2\\\" opacity=\\\"0.6\\\" />\\n                            <defs>\\n                                <linearGradient id=\\\"gradient\\\" x1=\\\"0%\\\" y1=\\\"0%\\\" x2=\\\"100%\\\" y2=\\\"100%\\\">\\n                                    <stop offset=\\\"0%\\\" stop-color=\\\"#00f7ff\\\" />\\n                                    <stop offset=\\\"100%\\\" stop-color=\\\"#ff00f7\\\" />\\n                                </linearGradient>\\n                            </defs>\\n                        </svg>\\n                    </div>\\n                </div>\\n                \\n                <!-- Floating badges around the main card -->\\n                <div class=\\\"absolute -bottom-6 -left-6 w-28 h-28 rounded-2xl neu border border-dark-700/30 p-1.5 z-10\\\">\\n                    <div class=\\\"w-full h-full rounded-xl bg-dark-900/80 backdrop-blur-sm flex items-center justify-center\\\">\\n                        <div class=\\\"text-center\\\">\\n                            <div class=\\\"text-2xl font-bold text-neon-cyan\\\">42x</div>\\n                            <div class=\\\"text-xs font-mono text-gray-400\\\">faster</div>\\n                        </div>\\n                    </div>\\n                </div>\\n                \\n                <div class=\\\"absolute -top-6 -right-6 w-24 h-24 rounded-2xl neu border border-dark-700/30 p-1.5 z-10\\\">\\n                    <div class=\\\"w-full h-full rounded-xl bg-dark-900/80 backdrop-blur-sm flex items-center justify-center\\\">\\n                        <div class=\\\"text-center\\\">\\n                            <div class=\\\"text-2xl font-bold text-neon-pink\\\">99.9%</div>\\n                            <div class=\\\"text-xs font-mono text-gray-400\\\">uptime</div>\\n                        </div>\\n                    </div>\\n                </div>\\n            </div>\\n        </div>\\n    </main>\\n\\n    <!-- Tech showcase ribbon -->\\n    <div class=\\\"relative z-20 py-12 bg-dark-900/50 backdrop-blur-md border-t border-b border-dark-800 overflow-hidden\\\">\\n        <div class=\\\"flex items-center space-x-16 animate-marquee whitespace-nowrap\\\">\\n            <span class=\\\"text-xl font-mono text-neon-cyan\\\">Quantum Computing</span>\\n            <span class=\\\"text-xl font-mono text-neon-pink\\\">Neural Networks</span>\\n            <span class=\\\"text-xl font-mono text-neon-purple\\\">Blockchain</span>\\n            <span class=\\\"text-xl font-mono text-neon-cyan\\\">AI/ML</span>\\n            <span class=\\\"text-xl font-mono text-neon-pink\\\">Web3</span>\\n            <span class=\\\"text-xl font-mono text-neon-purple\\\">AR/VR</span>\\n            <span class=\\\"text-xl font-mono text-neon-cyan\\\">IoT</span>\\n            <span class=\\\"text-xl font-mono text-neon-pink\\\">5G</span>\\n            <span class=\\\"text-xl font-mono text-neon-purple\\\">Edge Computing</span>\\n        </div>\\n        <style>\\n            .animate-marquee {\\n                animation: marquee 30s linear infinite;\\n            }\\n            @keyframes marquee {\\n                0% { transform: translateX(0); }\\n                100% { transform: translateX(-50%); }\\n            }\\n        </style>\\n    </div>\\n\\n    \\n</body>\\n</html>\" }} />\n  );\n}\n",
