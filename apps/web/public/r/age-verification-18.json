      "content": "/**\n * Component: Age verification 18+\n * Author: @maximus (https://tailwindflex.com/@maximus)\n * Source: https://tailwindflex.com/@maximus/age-verification-18\n * Attribution: Créé par @maximus sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function AgeVerification18() {\n  return (\n    <div>\n    <div id=\"age\" className=\"fixed z-[9998] top-0 right-0 left-0 bottom-0 w-full h-full bg-black bg-opacity-70 backdrop-blur-lg text-white font-sans p-5 hidden\">\n      <div className=\"max-w-md mx-auto pt-20 text-center\">\n    \t<h2 className=\"text-white font-bold text-2xl mb-4\">Aldersbekræftelse</h2>\n    \t<p className=\"mb-4\">Dette websted er beregnet for personer på 18 år og derover. Bekræft venligst din alder for at få adgang til indholdet, eller forlad webstedet, hvis du ikke er myndig.</p>\n    \t<button className=\"bg-green-600 text-white border-0 py-2 px-4 mt-2 w-full cursor-pointer plausible-event-name=over21\">Ja, jeg er over 18 år</button>\n    \t<br />\n    \t<a href=\"https://www.responsibility.org/\" ref=\"nofollow\" className=\"text-white\">\n    \t  <button className=\"bg-indigo-600 text-white border-0 py-2 px-4 mt-2 w-full\">Afslut</button>\n    \t</a>\n      </div>\n    </div>\n    \n    <div>Hello</div>\n    \n    \n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
  ],
