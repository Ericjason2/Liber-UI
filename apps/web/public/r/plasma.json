      "content": "/**\n * Component: Plasma\n * Author: @raulanto (https://tailwindflex.com/@raulanto)\n * Source: https://tailwindflex.com/@raulanto/plasma\n * Attribution: Créé par @raulanto sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function Plasma() {\n  return (\n    <div dangerouslySetInnerHTML={{ __html: \"<!DOCTYPE html>\\n<html lang=\\\"es\\\">\\n<head>\\n    <meta charset=\\\"UTF-8\\\">\\n    <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\">\\n    <title>Plasma Effect</title>\\n    <style>\\n        * {\\n            margin: 0;\\n            padding: 0;\\n            box-sizing: border-box;\\n        }\\n        body {\\n            width: 100vw;\\n            height: 100vh;\\n            overflow: hidden;\\n            background: #000;\\n        }\\n        #container {\\n            width: 100%;\\n            height: 100%;\\n            position: relative;\\n            overflow: hidden;\\n        }\\n        canvas {\\n            width: 100%;\\n            height: 100%;\\n            display: block;\\n        }\\n    </style>\\n</head>\\n<body>\\n\\n<div id=\\\"container\\\"></div>\\n\\n\\n\\n</body>\\n</html>\" }} />\n  );\n}\n",
