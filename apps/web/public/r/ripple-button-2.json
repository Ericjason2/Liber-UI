      "content": "/**\n * Component: Ripple Button\n * Author: @sachin-senal (https://tailwindflex.com/@sachin-senal)\n * Source: https://tailwindflex.com/@sachin-senal/ripple-button-2\n * Attribution: Créé par @sachin-senal sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function RippleButton2() {\n  return (\n    <div>\n    \n    \n    <div className=\"relative w-screen h-screen flex items-center justify-center bg-gray-800\">\n      <button type=\"button\" id=\"bt\"\n            className=\"rounded px-5 py-3 min-w-max  overflow-hidden shadow relative bg-indigo-500 text-white hover90\">\n            Button text\n        </button>\n    </div>\n    \n    \n    \n    </div>\n  );\n}\n",
