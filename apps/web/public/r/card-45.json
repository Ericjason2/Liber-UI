      "content": "/**\n * Component: card\n * Author: @aditya (https://tailwindflex.com/@aditya)\n * Source: https://tailwindflex.com/@aditya/card-45\n * Attribution: Créé par @aditya sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function Card45() {\n  return (\n    <div dangerouslySetInnerHTML={{ __html: \"<div class=\\\"grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5\\\">\\n        <div\\n          class=\\\"bg-white rounded-2xl border border-gray-200 shadow-sm hover:shadow-md transition-shadow duration-200 overflow-hidden\\\"\\n        >\\n          <!-- Card Header -->\\n          <div class=\\\"px-5 py-4 border-b border-gray-100 flex items-start justify-between gap-3\\\">\\n            <div class=\\\"min-w-0\\\">\\n              <p class=\\\"text-xs font-medium text-gray-500\\\">field 1</p>\\n\\n              <p\\n                class=\\\"mt-1 text-sm font-semibold text-gray-800 truncate\\\"\\n                title=\\\"{{ application.applicationId }}\\\"\\n              >\\n              field1 data\\n              </p>\\n            </div>\\n\\n            <span\\n              class=\\\"shrink-0 inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold\\\"\\n            >\\n            data\\n            </span>\\n          </div>\\n\\n          <!-- Card Body -->\\n          <div class=\\\"p-5 space-y-5\\\">\\n            <div>\\n              <p class=\\\"text-xs font-medium text-gray-500\\\">field2</p>\\n\\n              <h3 class=\\\"mt-1 text-lg font-semibold text-gray-900\\\">\\nfield2 data              </h3>\\n\\n              \\n            </div>\\n\\n            <div class=\\\"bg-gray-50 rounded-xl p-4\\\">\\n              <p class=\\\"text-xs font-medium text-gray-500\\\">field3</p>\\n\\n              <p class=\\\"mt-1 font-semibold text-gray-800\\\">\\nfield 3 data              </p>\\n\\n              <p class=\\\"mt-1 text-sm text-gray-500\\\">\\n                data3\\n              </p>\\n            </div>\\n\\n            <div class=\\\"grid grid-cols-2 gap-4\\\">\\n              <div>\\n                <p class=\\\"text-xs text-gray-500\\\">field 4</p>\\n\\n                <p class=\\\"mt-1 text-sm font-semibold text-gray-800\\\">\\nfield data 4                </p>\\n              </div>\\n\\n              <div>\\n                <p class=\\\"text-xs text-gray-500\\\">field 5</p>\\n\\n                <p class=\\\"mt-1 text-sm font-semibold text-gray-800\\\">\\nfield data 5                </p>\\n              </div>\\n            </div>\\n          </div>\\n\\n          <!-- Card Footer -->\\n          <div class=\\\"px-5 py-4 border-t border-gray-100 flex gap-3\\\">\\n            <button\\n              type=\\\"button\\\"\\n              (click)=\\\"openViewApplicationDetailModal(application)\\\"\\n              class=\\\"cursor-pointer flex-1 px-4 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold transition\\\"\\n            >\\n               Details\\n            </button>\\n\\n            <!--  -->\\n            <button\\n              type=\\\"button\\\"\\n              (click)=\\\"openDeleteApplicationModal(application)\\\"\\n              class=\\\"cursor-pointer flex-1 px-4 py-2.5 rounded-xl border border-red-200 text-white bg-red-500 text-sm font-semibold transition disabled:opacity-40 disabled:cursor-not-allowed\\\"\\n            >\\n              apply\\n            </button>\\n          </div>\\n        </div>\\n    </div>\" }} />\n  );\n}\n",
      "type": "registry:ui"
