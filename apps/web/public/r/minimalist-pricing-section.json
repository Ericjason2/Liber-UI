lan -->\n      <div class=\"border border-gray-200 rounded-lg p-8\">\n        <h3 class=\"text-xl font-semibold mb-4\">Pro</h3>\n        <p class=\"text-4xl font-bold mb-6\">$29<span class=\"text-lg font-normal text-gray-500\">/month</span></p>\n        <ul class=\"mb-8 space-y-2\">\n          <li class=\"flex items-center\">\n            <svg class=\"w-5 h-5 text-green-500 mr-2\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path></svg>\n            <span>5 Users</span>\n          </li>\n          <li class=\"flex items-center\">\n            <svg class=\"w-5 h-5 text-green-500 mr-2\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path></svg>\n            <span>50GB Storage</span>\n          </li>\n          <li class=\"flex items-center\">\n            <svg class=\"w-5 h-5 text-green-500 mr-2\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path></svg>\n            <span>Priority Support</span>\n          </li>\n          <li class=\"flex items-center\">\n            <svg class=\"w-5 h-5 text-green-500 mr-2\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path></svg>\n            <span>Advanced Features</span>\n          </li>\n        </ul>\n        <button class=\"w-full bg-blue-500 text-white py-2 px-4 rounded-lg hover:bg-blue-600 transition duration-200\">Choose Plan</button>\n      </div>\n\n      <!-- Enterprise Plan -->\n      <div class=\"border border-gray-200 rounded-lg p-8\">\n        <h3 class=\"text-xl font-semibold mb-4\">Enterprise</h3>\n        <p class=\"text-4xl font-bold mb-6\">$99<span class=\"text-lg font-normal text-gray-500\">/month</span></p>\n        <ul class=\"mb-8 space-y-2\">\n          <li class=\"flex items-center\">\n            <svg class=\"w-5 h-5 text-green-500 mr-2\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path></svg>\n            <span>Unlimited Users</span>\n          </li>\n          <li class=\"flex items-center\">\n            <svg class=\"w-5 h-5 text-green-500 mr-2\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path></svg>\n            <span>500GB Storage</span>\n          </li>\n          <li class=\"flex items-center\">\n            <svg class=\"w-5 h-5 text-green-500 mr-2\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path></svg>\n            <span>24/7 Dedicated Support</span>\n          </li>\n          <li class=\"flex items-center\">\n            <svg class=\"w-5 h-5 text-green-500 mr-2\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path></svg>\n            <span>Custom Solutions</span>\n          </li>\n        </ul>\n        <button class=\"w-full bg-blue-500 text-white py-2 px-4 rounded-lg hover:bg-blue-600 transition duration-200\">Contact Sales</button>\n      </div>\n    </div>\n  </div>\n</section>\n</body>\n</html>"
