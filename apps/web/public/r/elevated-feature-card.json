      "content": "/**\n * Component: Elevated feature card\n * Author: @magersa (https://tailwindflex.com/@magersa)\n * Source: https://tailwindflex.com/@magersa/elevated-feature-card\n * Attribution: Créé par @magersa sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function ElevatedFeatureCard() {\n  return (\n    <div>\n    <div className=\"relative max-w-sm\">\n        <span className=\"absolute top-0 left-0 w-full h-full mt-1 ml-1 bg-green-500 rounded-lg\"></span>\n        <div className=\"relative h-full p-3 bg-white border-2 border-green-500 rounded-lg\">\n            <div className=\"flex items-center -mt-1\">\n                <svg className=\"w-8 h-8 text-green-500\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\"\n                    fill=\"currentColor\" aria-hidden=\"true\">\n                    <path\n                        d=\"M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z\">\n                    </path>\n                </svg>\n                <h3 className=\"my-2 ml-3 text-lg font-bold text-gray-800\">New content, more engagement</h3>\n            </div>\n    \n            <p className=\"my-2 text-gray-600\">\n                Our AI will help you create engaging content that resonates\n                with your audience.\n            </p>\n        </div>\n    \n    </div>\n    </div>\n  );\n}\n",
