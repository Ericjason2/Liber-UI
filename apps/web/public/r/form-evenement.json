    "rawHtml": "<!DOCTYPE html>\n<html lang=\"fr\" class=\"dark\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Create Event | Premium</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;800&display=swap\" rel=\"stylesheet\">\n    <style>\n        body { font-family: 'Plus Jakarta Sans', sans-serif; }\n        .step-content { display: none; }\n        .step-content.active { display: block; animation: slideIn 0.4s ease-out; }\n        \n        @keyframes slideIn {\n            from { opacity: 0; transform: translateY(10px); }\n            to { opacity: 1; transform: translateY(0); }\n        }\n\n        .gold-text {\n            background: linear-gradient(to right, #d4af37, #f2d472);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n        }\n\n        .bg-gold { background: linear-gradient(135deg, #d4af37 0%, #b8860b 100%); }\n    </style>\n</head>\n<body class=\"bg-slate-50 dark:bg-[#0a0f1a] min-h-screen flex items-center justify-center p-4\">\n\n    <div class=\"w-full max-w-6xl bg-white dark:bg-[#111827] rounded-[2.5rem] shadow-2xl overflow-hidden flex flex-col md:flex-row min-h-[750px] border border-white/5\">\n        \n        <div class=\"md:w-1/2 bg-[#0f172a] relative p-12 flex flex-col justify-between overflow-hidden\">\n            <div class=\"absolute -top-24 -left-24 w-64 h-64 bg-blue-600/10 rounded-full blur-3xl\"></div>\n            <div class=\"absolute -bottom-24 -right-24 w-64 h-64 bg-gold/10 rounded-full blur-3xl\"></div>\n\n            <div class=\"relative z-10\">\n                <h1 class=\"text-4xl md:text-5xl font-black text-white leading-tight mb-4\">\n                    Créez un <br><span class=\"gold-text\">Événement</span> Inoubliable\n                </h1>\n                <p class=\"text-slate-400 mb-12 max-w-xs\">Remplissez les détails pour donner vie à votre vision.</p>\n                \n                <div class=\"space-y-8\">\n                    <div class=\"flex items-center gap-6 step-item\" data-step=\"1\">\n                        <div class=\"w-12 h-12 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center font-bold text-white transition-all\" id=\"dot-1\">01</div>\n                        <div>\n                            <p class=\"text-xs font-bold uppercase tracking-widest text-slate-500\">Étape 1</p>\n                            <p class=\"text-white font-semibold\">Détails Généraux</p>\n                        </div>\n                    </div>\n                    <div class=\"flex items-center gap-6 step-item opacity-30\" data-step=\"2\">\n                        <div class=\"w-12 h-12 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center font-bold text-white transition-all\" id=\"dot-2\">02</div>\n                        <div>\n                            <p class=\"text-xs font-bold uppercase tracking-widest text-slate-500\">Étape 2</p>\n                            <p class=\"text-white font-semibold\">Lieu & Date</p>\n                        </div>\n                    </div>\n                    <div class=\"flex items-center gap-6 step-item opacity-30\" data-step=\"3\">\n                        <div class=\"w-12 h-12 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center font-bold text-white transition-all\" id=\"dot-3\">03</div>\n                        <div>\n                            <p class=\"text-xs font-bold uppercase tracking-widest text-slate-500\">Étape 3</p>\n                            <p class=\"text-white font-semibold\">Organisateur</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"relative z-10 flex items-center gap-2 text-slate-500 text-sm\">\n                <span class=\"w-8 h-px bg-slate-700\"></span>\n                <span>Powered by Futuristic UI</span>\n            </div>\n        </div>\n\n        <div class=\"md:w-1/2 p-8 md:p-14 flex flex-col bg-[#111827]\">\n            \n            <form id=\"eventForm\" class=\"flex-grow flex flex-col\">\n                \n                <div class=\"step-content active\" id=\"step-1\">\n                    <h2 class=\"text-2xl font-bold text-white mb-8 flex items-center gap-3\">\n                        <span class=\"w-2 h-8 bg-gold rounded-full\"></span>\n                        Informations de base\n                    </h2>\n                    \n                    <div class=\"space-y-6\">\n                        <div>\n                            <label class=\"block text-xs font-bold text-slate-500 uppercase mb-2\">Titre de l'événement</label>\n                            <input type=\"text\" placeholder=\"Ex: Festival de Jazz 2026\" class=\"w-full bg-slate-800/50 border border-slate-700 rounded-xl p-4 text-white focus:border-gold outline-none transition\">\n                        </div>\n                        <div>\n                            <label class=\"block text-xs font-bold text-slate-500 uppercase mb-2\">Catégorie</label>\n                            <select class=\"w-full bg-slate-800/50 border border-slate-700 rounded-xl p-4 text-white focus:border-gold outline-none transition\">\n                                <option>Musique</option>\n                                <option>Technologie</option>\n                                <option>Art & Culture</option>\n                            </select>\n                        </div>\n                        <div>\n                            <label class=\"block text-xs font-bold text-slate-500 uppercase mb-2\">Description</label>\n                            <textarea rows=\"4\" placeholder=\"Décrivez votre événement...\" class=\"w-full bg-slate-800/50 border border-slate-700 rounded-xl p-4 text-white focus:border-gold outline-none transition\"></textarea>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"step-content\" id=\"step-2\">\n                    <h2 class=\"text-2xl font-bold text-white mb-8 flex items-center gap-3\">\n                        <span class=\"w-2 h-8 bg-gold rounded-full\"></span>\n                        Lieu & Visuel\n                    </h2>\n                    \n                    <div class=\"space-y-6\">\n                        <div class=\"grid grid-cols-2 gap-4\">\n                            <div>\n                                <label class=\"block text-xs font-bold text-slate-500 uppercase mb-2\">Date Début</label>\n                                <input type=\"datetime-local\" class=\"w-full bg-slate-800/50 border border-slate-700 rounded-xl p-3 text-white focus:border-gold outline-none transition\">\n                            </div>\n                            <div>\n                                <label class=\"block text-xs font-bold text-slate-500 uppercase mb-2\">Date Fin</label>\n                                <input type=\"datetime-local\" class=\"w-full bg-slate-800/50 border border-slate-700 rounded-xl p-3 text-white focus:border-gold outline-none transition\">\n                            </div>\n                        </div>\n                        <div>\n                            <label class=\"block text-xs font-bold text-slate-500 uppercase mb-2\">Localisation</label>\n                            <input type=\"text\" placeholder=\"Adresse ou Ville\" class=\"w-full bg-slate-800/50 border border-slate-700 rounded-xl p-4 text-white focus:border-gold outline-none transition\">\n                        </div>\n                        <div class=\"relative border-2 border-dashed border-slate-700 rounded-2xl p-8 text-center hover:border-gold transition group\">\n                            <input type=\"file\" class=\"absolute inset-0 opacity-0 cursor-pointer\">\n                            <svg class=\"w-10 h-10 text-slate-500 mx-auto mb-4 group-hover:text-gold transition\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12\"/></svg>\n                            <p class=\"text-white font-semibold\">Choisir une affiche</p>\n                            <p class=\"text-xs text-slate-500 mt-1\">PNG, JPG jusqu'à 10MB</p>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"step-content\" id=\"step-3\">\n                    <h2 class=\"text-2xl font-bold text-white mb-8 flex items-center gap-3\">\n                        <span class=\"w-2 h-8 bg-gold rounded-full\"></span>\n                        Organisateur\n                    </h2>\n                    \n                    <div class=\"space-y-6\">\n                        <div>\n                            <label class=\"block text-xs font-bold text-slate-500 uppercase mb-2\">Nom de l'organisation</label>\n                            <input type=\"text\" placeholder=\"Nom complet\" class=\"w-full bg-slate-800/50 border border-slate-700 rounded-xl p-4 text-white focus:border-gold outline-none transition\">\n                        </div>\n                        <div>\n                            <label class=\"block text-xs font-bold text-slate-500 uppercase mb-2\">Email Contact</label>\n                            <input type=\"email\" placeholder=\"contact@event.com\" class=\"w-full bg-slate-800/50 border border-slate-700 rounded-xl p-4 text-white focus:border-gold outline-none transition\">\n                        </div>\n                        <div class=\"flex gap-4\">\n                            <div class=\"flex-1\">\n                                <label class=\"block text-xs font-bold text-slate-500 uppercase mb-2\">Tags</label>\n                                <input type=\"text\" placeholder=\"Jazz, Outdoor...\" class=\"w-full bg-slate-800/50 border border-slate-700 rounded-xl p-4 text-white focus:border-gold outline-none transition\">\n                            </div>\n                            <div class=\"w-1/3\">\n                                <label class=\"block text-xs font-bold text-slate-500 uppercase mb-2\">Statut</label>\n                                <select class=\"w-full bg-slate-800/50 border border-slate-700 rounded-xl p-4 text-white focus:border-gold outline-none transition\">\n                                    <option>Public</option>\n                                    <option>Privé</option>\n                                </select>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"mt-auto pt-10 flex items-center justify-between\">\n                    <button type=\"button\" id=\"prevBtn\" class=\"hidden text-slate-500 font-bold hover:text-white transition uppercase text-xs tracking-widest\">Retour</button>\n                    <button type=\"button\" id=\"nextBtn\" class=\"ml-auto bg-gold text-[#0f172a] px-10 py-4 rounded-2xl font-black shadow-lg shadow-gold/20 hover:scale-105 active:scale-95 transition\">\n                        SUIVANT\n                    </button>\n                </div>\n            </form>\n        </div>\n    </div>\n\n    <script>\n        const steps = document.querySelectorAll('.step-content');\n        const indicators = document.querySelectorAll('.step-item');\n        const nextBtn = document.getElementById('nextBtn');\n        const prevBtn = document.getElementById('prevBtn');\n        let currentStep = 1;\n\n        function updateUI() {\n            // Contenu\n            steps.forEach((step, idx) => {\n                step.classList.toggle('active', idx + 1 === currentStep);\n            });\n\n            // Indicateurs Gauche\n            indicators.forEach((item, idx) => {\n                const stepNum = idx + 1;\n                const dot = document.getElementById(`dot-${stepNum}`);\n                if (stepNum <= currentStep) {\n                    item.classList.remove('opacity-30');\n                    dot.classList.add('bg-gold', 'text-[#0f172a]', 'border-gold');\n                } else {\n                    item.classList.add('opacity-30');\n                    dot.classList.remove('bg-gold', 'text-[#0f172a]', 'border-gold');\n                }\n            });\n\n            // Boutons\n            prevBtn.classList.toggle('hidden', currentStep === 1);\n            nextBtn.innerText = currentStep === steps.length ? 'PUBLIER L\\'ÉVÉNEMENT' : 'SUIVANT';\n            if(currentStep === steps.length) {\n                nextBtn.classList.replace('bg-gold', 'bg-white');\n            } else {\n                nextBtn.classList.replace('bg-white', 'bg-gold');\n            }\n        }\n\n        nextBtn.addEventListener('click', () => {\n            if (currentStep < steps.length) {\n                currentStep++;\n                updateUI();\n            } else {\n                alert(\"🎉 Événement créé avec succès !\");\n            }\n        });\n\n        prevBtn.addEventListener('click', () => {\n            if (currentStep > 1) {\n                currentStep--;\n                updateUI();\n            }\n        });\n    </script>\n</body>\n</html>"
  }
}
