      "content": "import * as React from \"react\"\n\nfunction ResponsiveCardWithImage({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"responsive-card-with-image\"\n      className={className}\n      {...props}\n    >\n      <div className=\"max-w-md mx-auto bg-white rounded-xl shadow-md overflow-hidden md2xl\">\r\n          <div className=\"md\">\r\n              <div className=\"md0\">\r\n                  <img className=\"h-48 w-full object-cover md md48\" src=\"https://loremflickr.com/g/320/240/team\" />\r\n              </div>\r\n              <div className=\"p-8\">\r\n                  <div className=\"uppercase tracking-wide text-sm text-indigo-500 font-semibold\">Company retreats</div>\r\n                  <a href=\"#\" className=\"block mt-1 text-lg leading-tight font-medium text-black hover\">Incredible\r\n                      accommodation for your team\r\n                  </a>\r\n                  <p className=\"mt-2 text-slate-500\">Looking to take your team away on a retreat to enjoy awesome food and take in\r\n                      some sunshine? We have a list of places to do just that.\r\n                  </p>\r\n              </div>\r\n          </div>\r\n      </div>\n    </div>\n  )\n}\n\nexport { ResponsiveCardWithImage }\n",
