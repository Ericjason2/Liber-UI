items-center gap-1 whitespace-nowrap transition\">\r\n            Preview\r\n            <svg viewBox=\"0 0 24 24\" data-icon=\"tabler\" height=\"16\" width=\"16\">\r\n              <symbol id=\"ai\">\r\n                <path d=\"M5 12h14m-6 6l6-6m-6-6l6 6\" fill=\"none\" stroke=\"currentColor\" strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\"></path>\r\n              </symbol>\r\n              <use xlink></use>\r\n            </svg>\r\n          </div>\r\n        </div>\r\n      </a>\r\n    </div>\n    </div>\n  );\n}\n",
