    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Nebula Audio | Immersive Sound Experience</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <script>\n        tailwind.config = {\n            theme: {\n                extend: {\n                    colors: {\n                        'void': '#0a0a0a',\n                        'plasma': '#6d28d9',\n                        'plasma-light': '#8b5cf6',\n                        'plasma-dark': '#4c1d95',\n                        'neon': '#22d3ee',\n                        'carbon': '#1e1e1e',\n                        'steel': '#e5e7eb',\n                    },\n                    fontFamily: {\n                        sans: ['\"Inter\"', 'sans-serif'],\n                        mono: ['\"Roboto Mono\"', 'monospace'],\n                    },\n                    animation: {\n                        'pulse-slow': 'pulse 8s cubic-bezier(0.4, 0, 0.6, 1) infinite',\n                        'float-xy': 'floatXY 6s ease-in-out infinite',\n                        'glow': 'glow 3s ease-in-out infinite alternate',\n                        'wave': 'wave 8s linear infinite',\n                        'underline-expand': 'underlineExpand 0.5s ease-out forwards',\n                        'navbar-slide': 'navbarSlide 0.8s ease-out',\n                    },\n                    keyframes: {\n                        floatXY: {\n                            '0%, 100%': { transform: 'translate(0, 0) rotate(0deg)' },\n                            '25%': { transform: 'translate(5px, -5px) rotate(1deg)' },\n                            '50%': { transform: 'translate(0, -8px) rotate(0deg)' },\n                            '75%': { transform: 'translate(-5px, -5px) rotate(-1deg)' },\n                        },\n                        glow: {\n                            '0%': { 'box-shadow': '0 0 0 0 rgba(34, 211, 238, 0)' },\n                            '100%': { 'box-shadow': '0 0 20px 5px rgba(34, 211, 238, 0.3)' },\n                        },\n                        wave: {\n                            '0%': { transform: 'rotate(0deg)' },\n                            '10%': { transform: 'rotate(-5deg)' },\n                            '20%': { transform: 'rotate(5deg)' },\n                            '30%': { transform: 'rotate(-5deg)' },\n                            '40%': { transform: 'rotate(5deg)' },\n                            '50%': { transform: 'rotate(0deg)' },\n                            '100%': { transform: 'rotate(0deg)' },\n                        },\n                        underlineExpand: {\n                            '0%': { transform: 'scaleX(0)', 'transform-origin': 'left' },\n                            '100%': { transform: 'scaleX(1)', 'transform-origin': 'left' },\n                        },\n                        navbarSlide: {\n                            '0%': { transform: 'translateY(-100%)' },\n                            '100%': { transform: 'translateY(0)' },\n                        }\n                    }\n                }\n            }\n        }\n    </script>\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Roboto+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n</head>\n<body class=\"bg-void text-steel font-sans overflow-x-hidden\">\n    <!-- Animated Navbar -->\n    <nav class=\"fixed w-full z-50 bg-carbon bg-opacity-90 backdrop-blur-md border-b border-steel border-opacity-10 animate-navbar-slide\">\n        <div class=\"container mx-auto px-6 py-4\">\n            <div class=\"flex justify-between items-center\">\n                <!-- Logo with animation -->\n                <div class=\"flex items-center space-x-2\">\n                    <div class=\"w-8 h-8 rounded-full bg-gradient-to-br from-plasma to-neon flex items-center justify-center animate-pulse-slow\">\n                        <svg class=\"w-5 h-5 text-void\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3\"></path>\n                        </svg>\n                    </div>\n                    <span class=\"text-xl font-medium bg-gradient-to-r from-steel to-neon bg-clip-text text-transparent\">NEBULA</span>\n                </div>\n\n                <!-- Desktop Menu -->\n                <div class=\"hidden md:flex items-center space-x-8\">\n                    <a href=\"#\" class=\"relative group text-steel hover:text-neon transition-colors duration-300\">\n                        Products\n                        <span class=\"absolute bottom-0 left-0 w-0 h-0.5 bg-neon group-hover:w-full transition-all duration-300\"></span>\n                    </a>\n                    <a href=\"#\" class=\"relative group text-steel hover:text-neon transition-colors duration-300\">\n                        Technology\n                        <span class=\"absolute bottom-0 left-0 w-0 h-0.5 bg-neon group-hover:w-full transition-all duration-300\"></span>\n                    </a>\n                    <a href=\"#\" class=\"relative group text-steel hover:text-neon transition-colors duration-300\">\n                        Support\n                        <span class=\"absolute bottom-0 left-0 w-0 h-0.5 bg-neon group-hover:w-full transition-all duration-300\"></span>\n                    </a>\n                    <a href=\"#\" class=\"relative group text-steel hover:text-neon transition-colors duration-300\">\n                        Company\n                        <span class=\"absolute bottom-0 left-0 w-0 h-0.5 bg-neon group-hover:w-full transition-all duration-300\"></span>\n                    </a>\n                </div>\n\n                <!-- Mobile menu button -->\n                <div class=\"md:hidden\">\n                    <button class=\"text-steel hover:text-neon focus:outline-none\">\n                        <svg class=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 6h16M4 12h16M4 18h16\"></path>\n                        </svg>\n                    </button>\n                </div>\n            </div>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"relative min-h-screen overflow-hidden pt-24\">\n        <!-- Background elements with enhanced visibility -->\n        <div class=\"absolute inset-0 z-0 overflow-hidden\">\n            <!-- Animated sound wave pattern - more visible -->\n            <div class=\"absolute inset-0 opacity-10\" style=\"\n                background-image: \n                    radial-gradient(circle at 30% 50%, rgba(109, 40, 217, 0.4) 0%, transparent 20%),\n                    radial-gradient(circle at 70% 30%, rgba(34, 211, 238, 0.4) 0%, transparent 25%);\n                background-size: 200% 200%;\n                animation: wave 20s linear infinite alternate;\n            \"></div>\n            \n            <!-- Floating particles - larger and more visible -->\n            <div class=\"absolute top-1/4 left-1/4 w-4 h-4 rounded-full bg-neon opacity-80 animate-float-xy\" style=\"animation-delay: 0.5s; filter: drop-shadow(0 0 5px rgba(34, 211, 238, 0.7));\"></div>\n            <div class=\"absolute top-1/3 right-1/3 w-3 h-3 rounded-full bg-plasma-light opacity-70 animate-float-xy\" style=\"animation-delay: 1.2s; filter: drop-shadow(0 0 5px rgba(139, 92, 246, 0.7));\"></div>\n            <div class=\"absolute bottom-1/4 left-2/3 w-5 h-5 rounded-full bg-neon opacity-60 animate-float-xy\" style=\"animation-delay: 2.3s; filter: drop-shadow(0 0 8px rgba(34, 211, 238, 0.9));\"></div>\n        </div>\n\n        <!-- Main content -->\n        <div class=\"container mx-auto px-6 py-32 relative z-10\">\n            <div class=\"flex flex-col lg:flex-row items-center gap-16\">\n                <!-- Text content -->\n                <div class=\"lg:w-1/2 space-y-8\">\n                    <div class=\"inline-flex items-center gap-3 px-4 py-2 bg-carbon rounded-full border border-opacity-20 border-steel animate-pulse-slow\">\n                        <span class=\"relative flex h-3 w-3\">\n                            <span class=\"animate-ping-slow absolute inline-flex h-full w-full rounded-full bg-neon opacity-75\"></span>\n                            <span class=\"relative inline-flex rounded-full h-3 w-3 bg-neon\"></span>\n                        </span>\n                        <span class=\"text-xs font-mono tracking-widest text-neon\">LATEST GENERATION</span>\n                    </div>\n                    \n                    <h1 class=\"text-5xl md:text-6xl lg:text-7xl font-medium leading-tight\">\n                        <span class=\"text-transparent bg-clip-text bg-gradient-to-r from-steel to-neon\">Holographic</span><br>\n                        <span class=\"text-transparent bg-clip-text bg-gradient-to-r from-plasma-light to-neon\">Sound Experience</span>\n                    </h1>\n                    \n                    <p class=\"text-lg md:text-xl text-steel opacity-80 leading-relaxed max-w-2xl font-light\">\n                        Nebula Pro X9000 redefines audio immersion with quantum-tuned drivers and neural sound adaptation. Hear the difference that 40,000Hz of frequency response makes.\n                    </p>\n                    \n                    <div class=\"flex flex-col sm:flex-row gap-4 pt-4\">\n                        <button class=\"relative overflow-hidden px-8 py-4 bg-gradient-to-r from-plasma to-plasma-dark text-white rounded-lg font-medium transition-all duration-500 hover:shadow-xl hover:shadow-plasma/30 group\">\n                            <span class=\"relative z-10\">Pre-order Now</span>\n                            <span class=\"absolute inset-0 bg-gradient-to-r from-plasma-light to-neon opacity-0 group-hover:opacity-100 transition-opacity duration-300\"></span>\n                        </button>\n                        <button class=\"px-8 py-4 border-2 border-steel hover:border-neon text-steel hover:text-neon rounded-lg font-medium transition-all duration-300 flex items-center gap-2 group\">\n                            <span>Experience Demo</span>\n                            <svg class=\"w-5 h-5 group-hover:translate-x-1 transition-transform\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"></path>\n                            </svg>\n                        </button>\n                    </div>\n                    \n                    <div class=\"pt-8 flex flex-wrap gap-6\">\n                        <div class=\"flex items-center gap-3\">\n                            <div class=\"w-8 h-8 rounded-full bg-plasma-dark flex items-center justify-center animate-pulse-slow\">\n                                <svg class=\"w-5 h-5 text-neon\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"></path>\n                                </svg>\n                            </div>\n                            <span class=\"text-sm font-mono\">360° Spatial Audio</span>\n                        </div>\n                        <div class=\"flex items-center gap-3\">\n                            <div class=\"w-8 h-8 rounded-full bg-plasma-dark flex items-center justify-center animate-pulse-slow\" style=\"animation-delay: 0.5s;\">\n                                <svg class=\"w-5 h-5 text-neon\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z\"></path>\n                                </svg>\n                            </div>\n                            <span class=\"text-sm font-mono\">40hr Playtime</span>\n                        </div>\n                    </div>\n                </div>\n                \n                <!-- Product visual -->\n                <div class=\"lg:w-1/2 relative\">\n                    <div class=\"relative max-w-2xl mx-auto\">\n                        <!-- Main product image with floating elements -->\n                        <div class=\"relative z-10 animate-glow\">\n                            <img src=\"https://images.unsplash.com/photo-1590658268037-6bf12165a8df?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80\" \n                                 alt=\"Nebula Pro X9000 Headphones\" \n                                 class=\"w-full h-auto object-contain\">\n                        </div>\n                        \n                        <!-- Holographic effect circles - more visible -->\n                        <div class=\"absolute -bottom-20 -left-20 w-64 h-64 rounded-full border-2 border-neon border-opacity-40 animate-pulse-slow -z-10\" style=\"filter: drop-shadow(0 0 10px rgba(34, 211, 238, 0.5));\"></div>\n                        <div class=\"absolute -top-20 -right-20 w-80 h-80 rounded-full border-2 border-plasma-light border-opacity-30 animate-pulse-slow -z-10\" style=\"animation-delay: 2s; filter: drop-shadow(0 0 10px rgba(139, 92, 246, 0.5));\"></div>\n                        \n                        <!-- Floating tech specs - enhanced visibility -->\n                        <div class=\"absolute -left-10 top-1/4 bg-carbon bg-opacity-90 backdrop-blur-sm p-4 rounded-lg border border-steel border-opacity-20 shadow-xl animate-float-xy\" style=\"animation-delay: 0.7s;\">\n                            <div class=\"text-xs font-mono text-neon\">FREQUENCY RANGE</div>\n                            <div class=\"text-lg font-medium\">5Hz-40kHz</div>\n                        </div>\n                        \n                        <div class=\"absolute -right-10 bottom-1/4 bg-carbon bg-opacity-90 backdrop-blur-sm p-4 rounded-lg border border-steel border-opacity-20 shadow-xl animate-float-xy\" style=\"animation-delay: 1.4s;\">\n                            <div class=\"text-xs font-mono text-neon\">IMPEDANCE</div>\n                            <div class=\"text-lg font-medium\">32Ω</div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        \n        <!-- Scrolling indicator with enhanced animation -->\n        <div class=\"absolute bottom-10 left-1/2 transform -translate-x-1/2 z-20\">\n            <div class=\"flex flex-col items-center\">\n                <span class=\"text-xs font-mono text-steel opacity-80 mb-2 animate-pulse-slow\">EXPLORE</span>\n                <div class=\"relative w-8 h-12 rounded-full border-2 border-neon border-opacity-50 flex justify-center\">\n                    <div class=\"absolute top-2 w-1 h-4 bg-neon rounded-full animate-bounce\"></div>\n                </div>\n            </div>\n        </div>\n    </section>\n</body>\n</html>"
