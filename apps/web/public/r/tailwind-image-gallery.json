      "content": "/**\n * Component: Tailwind image gallery\n * Author: @alok (https://tailwindflex.com/@alok)\n * Source: https://tailwindflex.com/@alok/tailwind-image-gallery\n * Attribution: Créé par @alok sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function TailwindImageGallery() {\n  return (\n    <div>\n    <div className=\"bg-white dark800 h-screen h-full py-6 sm8 lg12\">\r\n        <div className=\"mx-auto max-w-screen-2xl px-4 md8\">\r\n            <div className=\"mb-4 flex items-center justify-between gap-8 sm8 md12\">\r\n                <div className=\"flex items-center gap-12\">\r\n                    <h2 className=\"text-2xl font-bold text-gray-800 lg3xl dark\">Gallery</h2>\r\n    \r\n                    <p className=\"hidden max-w-screen-sm text-gray-500 dark300 md\">\r\n                        This is a section of some simple filler text,\r\n                        also known as placeholder text. It shares some characteristics of a real written text.\r\n                    </p>\r\n                </div>\r\n    \r\n                <a href=\"#\"\r\n                    className=\"inline-block rounded-lg border bg-white dark700 dark px-4 py-2 text-center text-sm font-semibold text-gray-500 dark200 outline-none ring-indigo-300 transition duration-100 hover100 focus-visible active200 md8 md3 md\">\r\n                    More\r\n                </a>\r\n            </div>\r\n    \r\n            <div className=\"grid grid-cols-2 gap-4 sm3 md6 xl8\">\r\n                \r\n                <a href=\"#\"\r\n                    className=\"group relative flex h-48 items-end overflow-hidden rounded-lg bg-gray-100 shadow-lg md80\">\r\n                    <img src=\"https://images.unsplash.com/photo-1593508512255-86ab42a8e620?auto=format&q=75&fit=crop&w=600\" loading=\"lazy\" alt=\"Photo by Minh Pham\" className=\"absolute inset-0 h-full w-full object-cover object-center transition duration-200 group-hover110\" />\r\n    \r\n                    <div\r\n                        className=\"pointer-events-none absolute inset-0 bg-gradient-to-t from-gray-800 via-transparent to-transparent opacity-50\">\r\n                    </div>\r\n    \r\n                    <span className=\"relative ml-4 mb-3 inline-block text-sm text-white md5 md\">VR</span>\r\n                </a>\r\n                \r\n    \r\n                \r\n                <a href=\"#\"\r\n                    className=\"group relative flex h-48 items-end overflow-hidden rounded-lg bg-gray-100 shadow-lg md2 md80\">\r\n                    <img src=\"https://images.unsplash.com/photo-1542759564-7ccbb6ac450a?auto=format&q=75&fit=crop&w=1000\" loading=\"lazy\" alt=\"Photo by Magicle\" className=\"absolute inset-0 h-full w-full object-cover object-center transition duration-200 group-hover110\" />\r\n    \r\n                    <div\r\n                        className=\"pointer-events-none absolute inset-0 bg-gradient-to-t from-gray-800 via-transparent to-transparent opacity-50\">\r\n                    </div>\r\n    \r\n                    <span className=\"relative ml-4 mb-3 inline-block text-sm text-white md5 md\">Tech</span>\r\n                </a>\r\n                \r\n    \r\n                \r\n                <a href=\"#\"\r\n                    className=\"group relative flex h-48 items-end overflow-hidden rounded-lg bg-gray-100 shadow-lg md2 md80\">\r\n                    <img src=\"https://images.unsplash.com/photo-1610465299996-30f240ac2b1c?auto=format&q=75&fit=crop&w=1000\" loading=\"lazy\" alt=\"Photo by Martin Sanchez\" className=\"absolute inset-0 h-full w-full object-cover object-center transition duration-200 group-hover110\" />\r\n    \r\n                    <div\r\n                        className=\"pointer-events-none absolute inset-0 bg-gradient-to-t from-gray-800 via-transparent to-transparent opacity-50\">\r\n                    </div>\r\n    \r\n                    <span className=\"relative ml-4 mb-3 inline-block text-sm text-white md5 md\">Dev</span>\r\n                </a>\r\n                \r\n    \r\n                \r\n                <a href=\"#\"\r\n                    className=\"group relative flex h-48 items-end overflow-hidden rounded-lg bg-gray-100 shadow-lg md80\">\r\n                    <img src=\"https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&q=75&fit=crop&w=600\" loading=\"lazy\" alt=\"Photo by Lorenzo Herrera\" className=\"absolute inset-0 h-full w-full object-cover object-center transition duration-200 group-hover110\" />\r\n    \r\n                    <div\r\n                        className=\"pointer-events-none absolute inset-0 bg-gradient-to-t from-gray-800 via-transparent to-transparent opacity-50\">\r\n                    </div>\r\n    \r\n                    <span className=\"relative ml-4 mb-3 inline-block text-sm text-white md5 md\">Retro</span>\r\n                </a>\r\n                \r\n            </div>\r\n        </div>\r\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
