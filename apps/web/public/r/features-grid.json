\r\n                                <span className=\"mt-1 font-medium dark400\">Random but Useful websites\r\n                                        collection</span>\r\n    \r\n                            </div>\r\n                        </div>\r\n                    </a>\r\n                </div>\r\n    \r\n                <div className=\"w-full max-w-xs text-center\">\r\n                    <a href=\"\">\r\n                        <div\r\n                            className=\"object-cover object-center w-full h-48 mx-auto rounded-lg bg-blue-100 border-4 border-blue-200 dark900 dark600\">\r\n                            <div className=\"py-16 px-4\">\r\n                                <h5 className=\"text-lg font-bold dark\">Extract URL from text</h5>\r\n                                <span className=\"mt-1 font-medium dark400\">Easily extract URL in Bulk</span>\r\n                            </div>\r\n                        </div>\r\n                    </a>\r\n                </div>\r\n    \r\n    \r\n                <div className=\"w-full max-w-xs text-center\">\r\n                    <a href=\"\">\r\n                        <div\r\n                            className=\"object-cover object-center w-full h-48 mx-auto rounded-lg bg-blue-100 border-4 border-blue-200 dark900 dark600\">\r\n                            <div className=\"py-16 px-4\">\r\n                                <h5 className=\"text-lg font-bold dark\">Auto Reload Websites</h5>\r\n                                <span className=\"mt-1 font-medium dark400\">Useful websites collection</span>\r\n                            </div>\r\n                        </div>\r\n                    </a>\r\n                </div>\r\n    \r\n    \r\n                <div className=\"w-full max-w-xs text-center\">\r\n                    <a href=\"#\">\r\n                        <div\r\n                            className=\"object-cover object-center w-full h-48 mx-auto rounded-lg bg-gray-100 border-4 bor