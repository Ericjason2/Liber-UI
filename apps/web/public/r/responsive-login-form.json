      "content": "/**\n * Component: Responsive login form\n * Author: @Aman300 (https://tailwindflex.com/@Aman300)\n * Source: https://tailwindflex.com/@Aman300/responsive-login-form\n * Attribution: Créé par @Aman300 sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function ResponsiveLoginForm() {\n  return (\n    <div>\n    <div className=\"min-h-screen bg-gray-100 text-gray-900 flex justify-center\">\n        <div className=\"max-w-screen-xl m-0 sm10 bg-white shadow sm flex justify-center flex-1\">\n            <div className=\"lg1/2 xl5/12 p-6 sm12\">\n                <div className=\"mt-12 flex flex-col items-center\">\n                    <h1 className=\"text-2xl xl3xl font-extrabold\">\n                        Sign In\n                    </h1>\n                    \n                    <div className=\"w-full flex-1 mt-8\">\n    \n                       <div className=\"mx-auto max-w-xs\">\n                            <input\n                                className=\"w-full px-8 py-4 rounded-lg font-medium bg-gray-100 border border-gray-200 placeholder-gray-500 text-sm focus focus400 focus\"\n                                type=\"email\" placeholder=\"Email\" />\n                            <input\n                                className=\"w-full px-8 py-4 rounded-lg font-medium bg-gray-100 border border-gray-200 placeholder-gray-500 text-sm focus focus400 focus mt-5\"\n                                type=\"password\" placeholder=\"Password\" />\n                            <button\n                                className=\"mt-5 tracking-wide font-semibold bg-green-500 text-gray-100 w-full py-4 rounded-lg hover700 transition-all duration-300 ease-in-out flex items-center justify-center focus focus\">\n                                <svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" strokeWidth=\"1.5\" stroke=\"currentColor\" className=\"w-6 h-6\">\n                                  <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3\" />\n                                </svg>\n    \n                                <span className=\"ml-3\">\n                                    Sign In\n                                </span>\n                            </button>\n                        </div>\n    \n                        <div className=\"my-12 border-b text-center\">\n                            <div\n                                className=\"leading-none px-2 inline-block text-sm text-gray-600 tracking-wide font-medium bg-white transform translate-y-1/2\">\n                                Or sign In with Google\n                            </div>\n                        </div>\n    \n                        <div className=\"flex flex-col items-center\">\n                            <button\n                                className=\"w-full max-w-xs font-bold shadow-sm rounded-lg py-3 bg-green-100 text-gray-800 flex items-center justify-center transition-all duration-300 ease-in-out focus hover focus focus\">\n                                <div className=\"bg-white p-2 rounded-full\">\n                                    <svg className=\"w-4\" viewBox=\"0 0 533.5 544.3\">\n                                        <path\n                                            d=\"M533.5 278.4c0-18.5-1.5-37.1-4.7-55.3H272.1v104.8h147c-6.1 33.8-25.7 63.7-54.4 82.7v68h87.7c51.5-47.4 81.1-117.4 81.1-200.2z\"\n                                            fill=\"#4285f4\" />\n                                        <path\n                                            d=\"M272.1 544.3c73.4 0 135.3-24.1 180.4-65.7l-87.7-68c-24.4 16.6-55.9 26-92.6 26-71 0-131.2-47.9-152.8-112.3H28.9v70.1c46.2 91.9 140.3 149.9 243.2 149.9z\"\n                                            fill=\"#34a853\" />\n                                        <path\n                                            d=\"M119.3 324.3c-11.4-33.8-11.4-70.4 0-104.2V150H28.9c-38.6 76.9-38.6 167.5 0 244.4l90.4-70.1z\"\n                                            fill=\"#fbbc04\" />\n                                        <path\n                                            d=\"M272.1 107.7c38.8-.6 76.3 14 104.4 40.8l77.7-77.7C405 24.6 339.7-.8 272.1 0 169.2 0 75.1 58 28.9 150l90.4 70.1c21.5-64.5 81.8-112.4 152.8-112.4z\"\n                                            fill=\"#ea4335\" />\n                                    </svg>\n                                </div>\n                                <span className=\"ml-4\">\n                                    Sign In with Google\n                                </span>\n                            </button>\n                        </div>\n    \n                        \n    \n                       \n                    </div>\n                </div>\n            </div>\n           \n        </div>\n    </div>\n    </div>\n  );\n}\n",
