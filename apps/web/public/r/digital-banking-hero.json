      "content": "/**\n * Component: Digital banking hero\n * Author: @shariful-islam (https://tailwindflex.com/@shariful-islam)\n * Source: https://tailwindflex.com/@shariful-islam/digital-banking-hero\n * Attribution: Créé par @shariful-islam sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function DigitalBankingHero() {\n  return (\n    <div>\n    <div className=\"bg-gray-50 min-h-screen\">\n      \n      <header className=\"w-full bg-white shadow-sm\">\n        <div className=\"max-w-7xl mx-auto px-6 flex items-center justify-between py-4\">\n          \n          <div className=\"flex items-center space-x-2\">\n            <div className=\"w-6 h-6 bg-green-500 rounded-full\"></div>\n            <span className=\"text-lg font-semibold text-gray-800\">Acorns</span>\n          </div>\n          \n          <nav className=\"hidden md space-x-6 text-gray-700\">\n            <a href=\"#\" className=\"hover900\">Invest</a>\n            <a href=\"#\" className=\"hover900\">Later</a>\n            <a href=\"#\" className=\"hover900\">Spend</a>\n            <a href=\"#\" className=\"hover900\">Early</a>\n            <a href=\"#\" className=\"hover900\">Earn</a>\n            <a href=\"#\" className=\"hover900\">Grow</a>\n            <a href=\"#\" className=\"hover900\">Pricing</a>\n          </nav>\n          \n          <div className=\"flex items-center space-x-4\">\n            <a href=\"#\" className=\"text-gray-700 hover900\">Log in</a>\n            <a\n              href=\"#\"\n              className=\"px-4 py-2 bg-green-500 text-white rounded-lg font-medium hover600 transition\"\n            >\n              Get started\n            </a>\n          </div>\n        </div>\n      </header>\n    \n      \n      <div className=\"max-w-7xl mx-auto px-6 py-12 grid md2 gap-8 items-center\">\n        \n        <div>\n          <h1 className=\"text-4xl md5xl font-bold text-gray-800 mb-4\">\n            Acorns helps you <br /> grow your money\n          </h1>\n          <p className=\"text-gray-600 mb-6\">\n            Take control with all-in-one investment, retirement, checking, and more.\n          </p>\n          <a\n            href=\"#\"\n            className=\"px-6 py-3 bg-green-500 text-white font-medium text-lg rounded-lg hover600 transition\"\n          >\n            Get started\n          </a>\n        </div>\n    \n        \n        <div className=\"relative\">\n          <div className=\"absolute -left-8 -top-8 w-24 h-24 bg-green-100 rounded-full\"></div>\n          <img\n            src=\"https://via.placeholder.com/300x400\" \n            alt=\"Acorns Card\"\n            className=\"absolute -rotate-12 transform translate-y-6\"\n          />\n          <img\n            src=\"https://static-ssl.businessinsider.com/image/5be0ca3dda27f82a0016f894-1200/acorn.png\" \n            alt=\"Acorns Mobile\"\n            className=\"relative z-10 mx-auto\"\n          />\n        </div>\n      </div>\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
