      "content": "import * as React from \"react\"\n\nfunction PromotionBlock({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"promotion-block\"\n      className={className}\n      {...props}\n    >\n      <div className=\"dark700 p-4 min-h-screen\">\n          <div className=\"relative py-12 overflow-hidden\">\n              <div aria-hidden=\"true\" className=\"absolute inset-0 w-full m-auto grid grid-cols-2 -space-x-52 opacity-20\"></div>\n              <div className=\"max-w-7xl mx-auto px-6 md12 xl6\">\n                  <div className=\"relative\">\n                      <div className=\"flex items-center justify-center h-[50vh] px-2 sm0\">\n                          <div className=\"mt-6 m-auto space-y-6 w-full sm8/12 md7/12\">\n                              <h1\n                                  className=\"text-center text-3xl sm4xl md5xl font-bold text-gray-700 dark\">\n                                  Want to build\n                                  Custom Software?\n                              </h1>\n                              <p className=\"text-center text-sm sm md text-gray-600 dark300\">Launch\n                                  your\n                                  Product in\n                                  15 days</p>\n                              <div className=\"flex flex-wrap justify-center gap-4 sm6\">\n                                  <a href=\"\" target=\"_blank\"\n                                      className=\"relative flex h-9 w-full items-center justify-center px-8 before \n                                        before0 before before400 before before300 \n                                        hover105 active75 active95 sm\">\n                                      <span className=\"relative text-sm font-semibold text-white\">\n                                          Launch your MVP\n                                      </span>\n                                  </a>\n                              </div>\n                          </div>\n                      </div>\n                  </div>\n              </div>\n          </div>\n      </div>\n    </div>\n  )\n}\n\nexport { PromotionBlock }\n",
      "type": "registry:ui"
    }
