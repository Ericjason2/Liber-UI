    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\" class=\"light\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Subscription Details</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <script>\n        tailwind.config = {\n            darkMode: 'class',\n            theme: {\n                extend: {\n                    colors: {\n                        primary: '#3B82F6',\n                        secondary: '#10B981',\n                    }\n                }\n            }\n        }\n    </script>\n</head>\n<body class=\"bg-gray-100 dark:bg-gray-900 text-gray-800 dark:text-gray-200\">\n    <div class=\"container mx-auto px-4 py-8\">\n        <h1 class=\"text-3xl font-bold text-center mb-8\">Subscription Details</h1>\n        \n        <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n            <!-- Basic Plan -->\n            <div class=\"bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 flex flex-col\">\n                <h2 class=\"text-xl font-semibold mb-4\">Basic Plan</h2>\n                <p class=\"text-3xl font-bold mb-4\">₹499<span class=\"text-sm font-normal\">/month</span></p>\n                <ul class=\"mb-6 flex-grow\">\n                    <li class=\"flex items-center mb-2\">\n                        <svg class=\"w-5 h-5 mr-2 text-green-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path>\n                        </svg>\n                        10GB Storage\n                    </li>\n                    <li class=\"flex items-center mb-2\">\n                        <svg class=\"w-5 h-5 mr-2 text-green-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path>\n                        </svg>\n                        2 Users\n                    </li>\n                    <li class=\"flex items-center\">\n                        <svg class=\"w-5 h-5 mr-2 text-green-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path>\n                        </svg>\n                        Email Support\n                    </li>\n                </ul>\n                <button class=\"bg-primary text-white py-2 px-4 rounded-md hover:bg-primary-dark transition duration-300\">Subscribe Now</button>\n            </div>\n\n            <!-- Pro Plan -->\n            <div class=\"bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 flex flex-col border-2 border-primary\">\n                <h2 class=\"text-xl font-semibold mb-4\">Pro Plan</h2>\n                <p class=\"text-3xl font-bold mb-4\">₹999<span class=\"text-sm font-normal\">/month</span></p>\n                <ul class=\"mb-6 flex-grow\">\n                    <li class=\"flex items-center mb-2\">\n                        <svg class=\"w-5 h-5 mr-2 text-green-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path>\n                        </svg>\n                        50GB Storage\n                    </li>\n                    <li class=\"flex items-center mb-2\">\n                        <svg class=\"w-5 h-5 mr-2 text-green-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4