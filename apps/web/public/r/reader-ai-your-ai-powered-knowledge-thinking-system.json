    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\n  <title>Reader AI App</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n</head>\n\n<body class=\"bg-gray-100 text-gray-800\">\n\n<div class=\"flex h-screen overflow-hidden\">\n\n  <!-- ================= SIDEBAR ================= -->\n  <aside class=\"w-72 bg-white border-r flex flex-col\">\n\n    <!-- App Header -->\n    <div class=\"flex items-center justify-between p-4 border-b\">\n      <h1 class=\"font-bold text-lg\">📚 Reader AI</h1>\n      <button class=\"text-sm px-2 py-1 rounded hover:bg-gray-100\">☰</button>\n    </div>\n\n    <!-- Search -->\n    <div class=\"p-3\">\n      <input\n        type=\"text\"\n        placeholder=\"Search books...\"\n        class=\"w-full px-3 py-2 border rounded-lg text-sm focus:outline-none focus:ring\"\n      />\n    </div>\n\n    <!-- Navigation -->\n    <div class=\"px-3 space-y-1\">\n      <button class=\"w-full text-left px-3 py-2 rounded-lg bg-gray-100 font-medium\">\n        🏠 Dashboard\n      </button>\n      <button class=\"w-full text-left px-3 py-2 rounded-lg hover:bg-gray-100\">\n        📖 My Library\n      </button>\n      <button class=\"w-full text-left px-3 py-2 rounded-lg hover:bg-gray-100\">\n        🔖 Bookmarks\n      </button>\n      <button class=\"w-full text-left px-3 py-2 rounded-lg hover:bg-gray-100\">\n        💬 AI Chats\n      </button>\n    </div>\n\n    <!-- Divider -->\n    <div class=\"border-t my-3\"></div>\n\n    <!-- Book List -->\n    <div class=\"px-3 text-xs text-gray-500 mb-2\">Books</div>\n    <div class=\"flex-1 overflow-y-auto px-2 space-y-1\">\n\n      <button class=\"w-full text-left px-3 py-2 rounded-lg hover:bg-gray-100 truncate\">\n        Atomic Habits\n      </button>\n      <button class=\"w-full text-left px-3 py-2 rounded-lg hover:bg-gray-100 truncate\">\n        Deep Work\n      </button>\n      <button class=\"w-full text-left px-3 py-2 rounded-lg hover:bg-gray-100 truncate\">\n        Clean Code\n      </button>\n\n      <!-- Simulate many -->\n      <button class=\"w-full text-left px-3 py-2 rounded-lg hover:bg-gray-100 truncate\">\n        Thinking Fast and Slow\n      </button>\n      <button class=\"w-full text-left px-3 py-2 rounded-lg hover:bg-gray-100 truncate\">\n        The Pragmatic Programmer\n      </button>\n\n    </div>\n\n    <!-- Footer -->\n    <div class=\"p-3 border-t\">\n      <button class=\"w-full bg-black text-white py-2 rounded-lg\">\n        + Add Book\n      </button>\n    </div>\n\n  </aside>\n\n\n  <!-- ================= MAIN CONTENT ================= -->\n  <main class=\"flex-1 flex flex-col\">\n\n    <!-- Top Bar -->\n    <header class=\"bg-white border-b p-4 flex justify-between items-center\">\n      <h2 class=\"font-semibold\">📖 Clean Code</h2>\n      <div class=\"flex gap-2\">\n        <button class=\"px-3 py-1 border rounded\">Bookmark</button>\n        <button class=\"px-3 py-1 border rounded\">Highlight</button>\n      </div>\n    </header>\n\n    <!-- Content Area -->\n    <div class=\"flex flex-1 overflow-hidden\">\n\n      <!-- Reading Panel -->\n      <section class=\"flex-1 overflow-y-auto p-6\">\n\n        <h3 class=\"text-xl font-bold mb-4\">Chapter 1: Clean Code</h3>\n\n        <p class=\"mb-4 leading-relaxed text-gray-700\">\n          Clean code is not just about formatting. It is about creating code that is easy to understand, maintain, and extend...\n        </p>\n\n        <p class=\"mb-4 leading-relaxed text-gray-700\">\n          When writing code, always think about the next developer who will read it. That developer might be you in 6 months...\n        </p>\n\n        <!-- Highlight Example -->\n        <div class=\"bg-yellow-100 border-l-4 border-yellow-400 p-3 my-4\">\n          \"Any fool can write code that a computer can understand. Good programmers write code that humans can understand.\"\n        </div>\n\n      </section>\n\n      <!-- ================= RIGHT PANEL (CHAT + BOOKMARKS) ================= -->\n      <aside class=\"w-80 border-l bg-white flex flex-col\">\n\n        <!-- Tabs -->\n        <div class=\"flex border-b\">\n          <button class=\"flex-1 py-2 text-sm font-medium border-b-2 border-black\">\n            Chat\n          </button>\n          <button class=\"flex-1 py-2 text-sm hover:bg-gray-50\">\n            Bookmarks\n          </button>\n        </div>\n\n        <!-- Chat History -->\n        <div class=\"flex-1 overflow-y-auto p-3 space-y-3\">\n\n          <!-- Chat Bubble -->\n          <div class=\"text-sm bg-gray-100 p-3 rounded-lg\">\n            What is clean code?\n          </div>\n\n          <div class=\"text-sm bg-black text-white p-3 rounded-lg self-end\">\n            Clean code is readable, maintainable, and simple.\n          </div>\n\n          <div class=\"text-sm bg-gray-100 p-3 rounded-lg\">\n            Give example?\n          </div>\n\n        </div>\n\n        <!-- Chat Input -->\n        <div class=\"p-3 border-t\">\n          <div class=\"flex gap-2\">\n            <input\n              type=\"text\"\n              placeholder=\"Ask AI...\"\n              class=\"flex-1 px-3 py-2 border rounded-lg text-sm\"\n            />\n            <button class=\"px-3 py-2 bg-black text-white rounded-lg\">\n              ➤\n            </button>\n          </div>\n        </div>\n\n      </aside>\n\n    </div>\n\n  </main>\n\n</div>\n\n</body>\n</html>"
