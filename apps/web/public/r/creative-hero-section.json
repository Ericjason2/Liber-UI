>\n    \n        \n        <div className=\"relative min-h-screen flex items-center justify-center px-4 py-16 md24\">\n          <div className=\"max-w-6xl w-full mx-auto grid grid-cols-1 md2 gap-8 items-center\">\n            \n            \n            <div className=\"text-center md space-y-6 z-10\">\n              <div className=\"inline-block mb-4\">\n                <div className=\"flex items-center gap-2 bg-white bg-opacity-20 backdrop-blur-sm rounded-full px-4 py-2 text-white font-medium\">\n                  <svg className=\"w-4 h-4 text-yellow-300\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                    <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z\"></path>\n                  </svg>\n                  <span>Something awesome is coming</span>\n                </div>\n              </div>\n              \n              <h1 className=\"text-4xl md6xl font-bold text-white leading-tight\">\n                <span className=\"bg-clip-text text-transparent bg-gradient-to-r from-white to-purple-200\">\n                  Unlock Your\n                </span>\n                <br />\n                <span className=\"inline-block bg-clip-text text-transparent bg-gradient-to-r from-yellow-300 to-pink-300 animate-float\">\n                  Creative Superpower\n                </span>\n              </h1>\n              \n              <p className=\"text-lg md text-white text-opacity-90\">\n                Break through the ordinary with our extraordinary platform that empowers your wildest ideas.\n              </p>\n              \n              <div className=\"flex flex-col sm gap-4 justify-center md pt-4\">\n                <button className=\"group px-8 py-3 bg-white rounded-full font-medium text-purple-700 hover90 transform transition-all duration-300 hover105 shadow-lg hover\">\n                  <span className=\"relative z-10\">Get Started Now</span>\n                </button>\n                \n                <button className=\"group px-8 py-3 border-2 border-white border-opacity-50 rounded-full font-medium text-white hover hover10 transition-all duration-300\">\n                  <span className=\"flex items-center justify-center gap-2\">\n                    <span>Watch Demo</span>\n                    <svg className=\"w-4 h-4 text-white group-hover\" fill=\"currentColor\" viewBox=\"0 0 24 24\">\n                      <circle cx=\"12\" cy=\"12\" r=\"10\"></circle>\n                    </svg>\n                  </span>  \n                </button>\n              </div>\n            </div>\n            \n            \n            <div className=\"relative h-64 md flex items-center justify-center\">\n              \n              <div className=\"absolute w-64 h-64 md80 md80 bg-gradient-to-br from-pink-500 to-purple-600 rounded-full animate-pulse-slow\"></div>\n              \n              \n              <div className=\"absolute w-64 h-64 md80 md80 border-4 border-white border-opacity-20 rounded-full transform rotate-45 animate-spin-slow\"></div>\n              \n              \n              <div className=\"absolute w-32 h-32 md40 md40 bg-gradient-to-br from-yellow-400 to-orange-500 rounded-full animate-float\"></div>\n              \n              \n              <div className=\"absolute w-16 h-16 bg-gradient-to-br from-blue-400 to-teal-300 rounded-full top-1/4 right-1/4 animate-float-delay\"></div>\n            </div>\n          </div>\n        </div>\n    \n        \n        <div className=\"absolute bottom-0 left-0 w-full overflow-hidden\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1200 120\" preserveAspectRatio=\"none\" className=\"w-full h-16 md24\">\n            <path fill=\"rgba(255, 255, 255, 0.1)\" d=\"M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c