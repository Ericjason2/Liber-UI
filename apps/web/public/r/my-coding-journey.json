    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Monster Interactive Story Timeline | by Code Master</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <script>\n        tailwind.config = {\n            darkMode: 'class',\n        }\n    </script>\n    <style type=\"text/css\">\n        /* Custom animation for the fade-in-up effect */\n        .animate-fade-in-up {\n            opacity: 0;\n            transform: translateY(20px);\n            transition: opacity 0.8s ease-out, transform 0.8s ease-out;\n        }\n        .animate-fade-in-up.visible {\n            opacity: 1;\n            transform: translateY(0);\n        }\n    </style>\n</head>\n<body class=\"bg-gray-50 dark:bg-gray-900 transition-colors duration-300\">\n\n    <!-- Timeline Container -->\n    <section class=\"container mx-auto px-4 py-16 md:py-24\">\n        <h2 class=\"text-4xl md:text-5xl font-bold text-center text-gray-800 dark:text-white mb-4\">My Coding Journey</h2>\n        <p class=\"text-lg text-center text-gray-600 dark:text-gray-300 mb-12 max-w-2xl mx-auto\">A scroll-through story of key moments that shaped my development career. Watch the cards animate into view as you explore.</p>\n\n        <div class=\"relative\">\n            <!-- Central Vertical Line -->\n            <div class=\"absolute left-1/2 transform -translate-x-1/2 h-full w-1 bg-blue-200 dark:bg-blue-900/50\"></div>\n\n            <!-- Timeline Items Container -->\n            <div class=\"space-y-12 md:space-y-24\">\n                <!-- Item 1 -->\n                <div class=\"timeline-item flex flex-col md:flex-row items-center\">\n                    <!-- Left Side Content (Desktop) -->\n                    <div class=\"hidden md:block md:w-1/2 pr-12\"></div>\n\n                    <!-- Icon on Central Line -->\n                    <div class=\"absolute left-1/2 transform -translate-x-1/2 z-10\">\n                        <div class=\"flex items-center justify-center w-12 h-12 rounded-full bg-blue-500 text-white border-4 border-white dark:border-gray-900 shadow-lg\">\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-6 w-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z\" />\n                            </svg>\n                        </div>\n                    </div>\n\n                    <!-- Right Side Card -->\n                    <div class=\"ml-0 md:ml-12 md:w-1/2\">\n                        <div class=\"timeline-card bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-6 border-l-4 border-blue-500 transform transition-all duration-500 hover:scale-[1.02]\">\n                            <p class=\"text-sm font-semibold text-blue-600 dark:text-blue-400\">January 2018</p>\n                            <h3 class=\"text-xl font-bold text-gray-800 dark:text-white mt-2\">First \"Hello, World!\"</h3>\n                            <p class=\"text-gray-600 dark:text-gray-300 mt-4\">The spark that started it all. Wrote my first line of HTML and felt the magic of creating something from nothing.</p>\n                            <div class=\"mt-4\">\n                                <img src=\"https://images.unsplash.com/photo-1542831371-29b0f74f9713?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=crop&w=500&q=80\" alt=\"Code screenshot\" class=\"rounded-lg shadow-md\">\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Item 2 (Alternates on Desktop) -->\n                <div class=\"timeline-item flex flex-col md:flex-row items-center\">\n                    <!-- Left Side Card -->\n                    <div class=\"md:w-1/2 md:pr-12\">\n                        <div class=\"timeline-card bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-6 border-l-4 border-green-500 transform transition-all duration-500 hover:scale-[1.02]\">\n                            <p class=\"text-sm font-semibold text-green-600 dark:text-green-400\">June 2019</p>\n                            <h3 class=\"text-xl font-bold text-gray-800 dark:text-white mt-2\">Discovered React.js</h3>\n                            <p class=\"text-gray-600 dark:text-gray-300 mt-4\">The \"Aha!\" moment. Building component-based interfaces changed my entire perspective on frontend development.</p>\n                            <div class=\"mt-4 bg-gray-100 dark:bg-gray-700 p-3 rounded-lg\">\n                                <pre class=\"text-xs text-gray-800 dark:text-gray-200\"><code>function MyComponent() { return &lt;h1&gt;Wow!&lt;/h1&gt;; }</code></pre>\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- Icon on Central Line -->\n                    <div class=\"absolute left-1/2 transform -translate-x-1/2 z-10\">\n                        <div class=\"flex items-center justify-center w-12 h-12 rounded-full bg-green-500 text-white border-4 border-white dark:border-gray-900 shadow-lg\">\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-6 w-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 10V3L4 14h7v7l9-11h-7z\" />\n                            </svg>\n                        </div>\n                    </div>\n\n                    <!-- Empty Spacer (Right Side for Desktop) -->\n                    <div class=\"hidden md:block md:w-1/2\"></div>\n                </div>\n\n                <!-- Item 3 (Add more items following the alternating pattern) -->\n                <div class=\"timeline-item flex flex-col md:flex-row items-center\">\n                    <div class=\"hidden md:block md:w-1/2 pr-12\"></div>\n                    <div class=\"absolute left-1/2 transform -translate-x-1/2 z-10\">\n                        <div class=\"flex items-center justify-center w-12 h-12 rounded-full bg-purple-500 text-white border-4 border-white dark:border-gray-900 shadow-lg\">\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-6 w-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z\" />\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M21 12a9 9 0 11-18 0 9 9 0 0118 0z\" />\n                            </svg>\n                        </div>\n                    </div>\n                    <div class=\"ml-0 md:ml-12 md:w-1/2\">\n                        <div class=\"timeline-card bg-white dark:bg-gray-800 rounded-2xl shadow-lg p-6 border-l-4 border-purple-500 transform transition-all duration-500 hover:scale-[1.02]\">\n                            <p class=\"text-sm font-semibold text-purple-600 dark:text-purple-400\">December 2020</p>\n                            <h3 class=\"text-xl font-bold text-gray-800 dark:text-white mt-2\">Released First Music App</h3>\n                            <p class=\"text-gray-600 dark:text-gray-300 mt-4\">Merged my two passions: code and music (HAMZY). Built a full-stack application for artists to share their tracks.</p>\n                            <button class=\"mt-4 bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-300 text-sm font-medium px-4 py-2 rounded-lg hover:bg-purple-200 dark:hover:bg-purple-900/50 transition-colors\">View Project →</button>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <script>\n        // Intersection Observer to trigger animations on scroll\n        document.addEventListener('DOMContentLoaded', function() {\n            const observerOptions = {\n                root: null,\n                rootMargin: '0px',\n                threshold: 0.2 // Trigger when 20% of the item is visible\n            };\n\n            const observer = new IntersectionObserver((entries) => {\n                entries.forEach(entry => {\n                    if (entry.isIntersecting) {\n                        // Add the 'visible' class to the timeline item\n                        entry.target.classList.add('visible');\n                        // Also find the card inside and make it visible\n                        const card = entry.target.querySelector('.timeline-card');\n                        if (card) {\n                            card.classList.add('visible');\n                        }\n                        // Stop observing after animation triggers\n                        observer.unobserve(entry.target);\n                    }\n                });\n            }, observerOptions);\n\n            // Observe all timeline items\n            document.querySelectorAll('.timeline-item').forEach(item => {\n                item.classList.add('animate-fade-in-up'); // Add the initial hidden state\n                observer.observe(item);\n            });\n        });\n    </script>\n</body>\n</html>"
  }
