      "content": "/**\n * Component: gaming profile.\n * Author: @bonheur-developer1 (https://tailwindflex.com/@bonheur-developer1)\n * Source: https://tailwindflex.com/@bonheur-developer1/gaming-profile\n * Attribution: Créé par @bonheur-developer1 sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function GamingProfile() {\n  return (\n    <div dangerouslySetInnerHTML={{ __html: \"<!DOCTYPE html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"UTF-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\">\\n  <title>Game Avatar Component</title>\\n  \\n</head>\\n<body class=\\\"bg-gray-900 flex items-center justify-center min-h-screen\\\">\\n\\n  <!-- Avatar Card -->\\n  <div class=\\\"max-w-xs bg-gray-800 rounded-2xl shadow-lg overflow-hidden border border-gray-700\\\">\\n    <!-- Avatar Image -->\\n    <img class=\\\"w-full h-48 object-cover\\\" src=\\\"https://i.pravatar.cc/300?img=12\\\" alt=\\\"Player Avatar\\\">\\n\\n    <!-- Player Info -->\\n    <div class=\\\"p-5 text-center\\\">\\n      <h2 class=\\\"text-xl font-bold text-white\\\">BONIMATER</h2>\\n      <p class=\\\"text-sm text-gray-400\\\">Level 45 | Warrior</p>\\n      \\n      <!-- Buttons -->\\n      <div class=\\\"mt-4 flex gap-2 justify-center\\\">\\n        <button class=\\\"px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-sm\\\">Add Friend</button>\\n        <button class=\\\"px-4 py-2 bg-gray-700 hover:bg-gray-600 text-white rounded-lg text-sm\\\">Message</button>\\n      </div>\\n    </div>\\n  </div>\\n\\n</body>\\n</html>\" }} />\n  );\n}\n",
