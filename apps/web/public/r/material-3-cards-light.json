    "rawHtml": "<head>\n    <!-- Roboto Font -->\n    <link href=\"https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;600;700&amp;display=swap\" rel=\"stylesheet\">\n    \n    <!-- Material Icons -->\n    <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\">\n</head>\n\n<body data-theme=\"light\">\n    \n    <!-- Demo Container -->\n    <div class=\"flex flex-col items-center gap-4 py-16 h-screen\">\n\n        <!-- Filled (Default) Card -->\n        <div class=\"card max-w-[64mm] w-full max-h-[32mm] h-full\">\n            <span class=\"text-2xl font-bold\">Filled Card</span>\n        </div>\n\n        <!-- Elevated Card -->\n        <div class=\"card card-elevated max-w-[64mm] w-full max-h-[32mm] h-full\">\n            <span class=\"text-2xl font-bold\">Elevated Card</span>\n        </div>\n\n        <!-- Outlined Card -->\n        <div class=\"card card-outlined max-w-[64mm] w-full max-h-[32mm] h-full\">\n            <span class=\"text-2xl font-bold\">Outlined Card</span>\n        </div>\n\n    </div>\n\n</body>"
