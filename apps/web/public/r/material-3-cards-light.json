      "content": "/**\n * Component: Material 3 Cards [Light]\n * Author: @nickgirga (https://tailwindflex.com/@nickgirga)\n * Source: https://tailwindflex.com/@nickgirga/material-3-cards-light\n * Attribution: Créé par @nickgirga sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function Material3CardsLight() {\n  return (\n    <div>\n    <head>\n        \n        <link href=\"https://fonts.googleapis.com/css2?family=Roboto@300;400;600;700&amp;display=swap\" rel=\"stylesheet\" />\n        \n        \n        <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\" />\n    </head>\n    \n    <body data-theme=\"light\">\n        \n        \n        <div className=\"flex flex-col items-center gap-4 py-16 h-screen\">\n    \n            \n            <div className=\"card max-w-[64mm] w-full max-h-[32mm] h-full\">\n                <span className=\"text-2xl font-bold\">Filled Card</span>\n            </div>\n    \n            \n            <div className=\"card card-elevated max-w-[64mm] w-full max-h-[32mm] h-full\">\n                <span className=\"text-2xl font-bold\">Elevated Card</span>\n            </div>\n    \n            \n            <div className=\"card card-outlined max-w-[64mm] w-full max-h-[32mm] h-full\">\n                <span className=\"text-2xl font-bold\">Outlined Card</span>\n            </div>\n    \n        </div>\n    \n    </body>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
