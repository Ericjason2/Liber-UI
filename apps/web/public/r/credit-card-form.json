      "content": "import * as React from \"react\"\n\nfunction CreditCardForm({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"credit-card-form\"\n      className={className}\n      {...props}\n    >\n      <div className=\"max-w-sm mx-auto mt-20 bg-white rounded-md shadow-md overflow-hidden\">\r\n          <div className=\"px-6 py-4 bg-gray-900 text-white\">\r\n              <h1 className=\"text-lg font-bold\">Credit Card</h1>\r\n          </div>\r\n          <div className=\"px-6 py-4\">\r\n      \r\n              <div className=\"mb-4\">\r\n                  <label className=\"block text-gray-700 font-bold mb-2\" htmlFor=\"card-number\">\r\n                      Card Number\r\n                  </label>\r\n                  <input\r\n                      className=\"appearance-none border border-gray-400 rounded w-full py-2 px-3 text-gray-700 leading-tight focus focus\"\r\n                      id=\"card-number\" type=\"text\" placeholder=\"**** **** **** ****\" />\r\n              </div>\r\n      \r\n              <div className=\"mb-4\">\r\n                  <label className=\"block text-gray-700 font-bold mb-2\" htmlFor=\"expiration-date\">\r\n                      Expiration Date\r\n                  </label>\r\n                  <input\r\n                      className=\"appearance-none border border-gray-400 rounded w-full py-2 px-3 text-gray-700 leading-tight focus focus\"\r\n                      id=\"expiration-date\" type=\"text\" placeholder=\"MM/YY\" />\r\n              </div>\r\n      \r\n              <div className=\"mb-4\">\r\n                  <label className=\"block text-gray-700 font-bold mb-2\" htmlFor=\"cvv\">\r\n                      CVV\r\n                  </label>\r\n                  <input\r\n                      className=\"appearance-none border border-gray-400 rounded w-full py-2 px-3 text-gray-700 leading-tight focus focus\"\r\n                      id=\"cvv\" type=\"text\" placeholder=\"***\" />\r\n              </div>\r\n      \r\n              <div className=\"mb-4\">\r\n                  <label className=\"block text-gray-700 font-bold mb-2\" htmlFor=\"cvv\">\r\n                      Cardholder Name\r\n                  </label>\r\n                  <input\r\n                      className=\"appearance-none border border-gray-400 rounded w-full py-2 px-3 text-gray-700 leading-tight focus focus\"\r\n                      type=\"text\" placeholder=\"Full Name\" />\r\n              </div>\r\n      \r\n              <button className=\"bg-blue-500 hover600 text-white font-bold py-2 px-4 rounded-full\">\r\n                  Pay Now\r\n              </button>\r\n          </div>\r\n      </div>\n    </div>\n  )\n}\n\nexport { CreditCardForm }\n",
      "type": "registry:ui"
    }
