      "content": "/**\n * Component: Register form\n * Author: @maximus (https://tailwindflex.com/@maximus)\n * Source: https://tailwindflex.com/@maximus/register-form-2\n * Attribution: Créé par @maximus sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function RegisterForm2() {\n  return (\n    <div dangerouslySetInnerHTML={{ __html: \"<!DOCTYPE html>\\n<html>\\n    <head>\\n        <meta charset=\\\"UTF-8\\\" name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\" />\\n        \\n        \\n        \\n    </head>\\n    <body class=\\\"bg-[#1C2532]\\\">\\n        <div class=\\\"min-h-screen flex items-center justify-center p-4\\\">\\n            <div class=\\\"max-w-[440px] w-full bg-white rounded px-8 py-10\\\" x-data=\\\"signUpForm()\\\">\\n                <!-- Logo -->\\n                <div class=\\\"text-center mb-6\\\">\\n                    <h1 class=\\\"text-2xl font-normal tracking-wide text-bold\\\">LQRS.com</h1>\\n                </div>\\n\\n                <!-- Header -->\\n                <h2 class=\\\"text-xl font-normal text-center mb-2 font-bold\\\">Register</h2>\\n                <p class=\\\"text-gray-500 text-center text-lg mb-8\\\">\\n                    Join LQRS.com to discover our premium spirits collection\\n                </p>\\n\\n                <!-- Form -->\\n                <form class=\\\"space-y-5\\\" @submit.prevent=\\\"handleSubmit\\\">\\n                    <div>\\n                        <input type=\\\"email\\\" x-model=\\\"form.email\\\" placeholder=\\\"Email*\\\" class=\\\"w-full px-4 py-3.5 text-lg border border-2 border-gray-200 rounded focus:outline-none focus:border-rose-500 placeholder-gray-400\\\" />\\n                    </div>\\n\\n                    <div class=\\\"relative\\\">\\n                        <input\\n                            :type=\\\"showPwd ? 'text' : 'password'\\\"\\n                            x-model=\\\"form.password\\\"\\n                            placeholder=\\\"Password*\\\"\\n                            class=\\\"w-full px-4 py-3.5 text-lg border border-2 border-gray-200 rounded focus:outline-none focus:border-rose-500 placeholder-gray-400\\\"\\n                        />\\n                        <button type=\\\"button\\\" @click=\\\"showPwd = !showPwd\\\" class=\\\"absolute right-3 top-1/2 -translate-y-1/2\\\">\\n                            <svg class=\\\"w-6 h-6 text-gray-400\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\">\\n                                <path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" stroke-width=\\\"2\\\" d=\\\"M15 12a3 3 0 11-6 0 3 3 0 016 0z\\\" />\\n                                <path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" stroke-width=\\\"2\\\" d=\\\"M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z\\\" />\\n                            </svg>\\n                        </button>\\n                    </div>\\n\\n                    <div class=\\\"grid grid-cols-2 gap-4\\\">\\n                        <input type=\\\"text\\\" x-model=\\\"form.firstName\\\" placeholder=\\\"First name*\\\" class=\\\"w-full px-4 py-3.5 text-lg border border-2 border-gray-200 rounded focus:outline-none focus:border-rose-500 placeholder-gray-400\\\" />\\n                        <input type=\\\"text\\\" x-model=\\\"form.lastName\\\" placeholder=\\\"Last name*\\\" class=\\\"w-full px-4 py-3.5 text-lg border border-2 border-gray-200 rounded focus:outline-none focus:border-rose-500 placeholder-gray-400\\\" />\\n                    </div>\\n\\n                    <select x-model=\\\"form.country\\\" class=\\\"w-full px-4 py-3.5 text-lg border border-2 border-gray-200 rounded focus:outline-none focus:border-rose-500 text-gray-500 appearance-none bg-white\\\">\\n                        <option value=\\\"\\\">Select country*</option>\\n                        <option value=\\\"UK\\\">United Kingdom</option>\\n                        <option value=\\\"US\\\">United States</option>\\n                        <option value=\\\"CA\\\">Canada</option>\\n                        <option value=\\\"FR\\\">France</option>\\n                        <option value=\\\"DE\\\">Germany</option>\\n                    </select>\\n\\n                    <input\\n                        type=\\\"text\\\"\\n                        x-model=\\\"form.dob\\\"\\n                        x-ref=\\\"dobInput\\\"\\n                        placeholder=\\\"Date of birth* (DD/MM/YYYY)\\\"\\n                        class=\\\"w-full px-4 py-3.5 text-lg border border-2 border-gray-200 rounded focus:outline-none focus:border-rose-500 placeholder-gray-400\\\"\\n                    />\\n\\n                    <label class=\\\"flex items-start gap-3 cursor-pointer\\\">\\n                        <input type=\\\"checkbox\\\" x-model=\\\"form.marketing\\\" class=\\\"mt-1.5 w-4 h-4 border-gray-300 rounded\\\" />\\n                        <span class=\\\"text-gray-500 text-base\\\">\\n                            Keep me updated about premium spirits, exclusive offers and special events from LQRS.com\\n                        </span>\\n                    </label>\\n\\n                    <button type=\\\"submit\\\" class=\\\"w-full bg-rose-700 text-white py-4 px-6 rounded text-lg hover:bg-rose-800 transition-colors mt-6\\\" :disabled=\\\"isLoading\\\">\\n                        Register\\n                    </button>\\n                </form>\\n            </div>\\n        </div>\\n\\n        \\n    </body>\\n</html>\" }} />\n  );\n}\n",
