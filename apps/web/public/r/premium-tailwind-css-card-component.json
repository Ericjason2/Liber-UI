    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Premium Card | Tailwind CSS</title>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap\"\n    rel=\"stylesheet\">\n  <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n</head>\n\n<body class=\"font-poppins p-6\">\n  <a href=\"https://www.codewithfaraz.com/\" class=\"absolute top-[30px] right-[30px] block z-[100] transition-all duration-250 ease-linear\" target=\"_blank\">\n      <img src=\"https://www.codewithfaraz.com/InstaPic.png\" class=\"h-[30px] w-auto block\">\n</a>\n  <div class=\"max-w-4xl mx-auto\">\n    <div class=\"premium-border rounded-2xl\">\n      <div class=\"premium-card rounded-2xl p-8 card-hover relative overflow-hidden\">\n        <!-- Shiny corner accent -->\n        <div\n          class=\"absolute -top-24 -right-24 w-48 h-48 bg-gradient-to-br from-premium-accent/20 to-transparent rounded-full\">\n        </div>\n\n        <!-- Card Header -->\n        <div class=\"flex flex-col md:flex-row items-start md:items-center justify-between mb-8 relative z-10\">\n          <div>\n            <span class=\"premium-tag text-xs font-semibold px-4 py-2 rounded-full uppercase tracking-wider\">\n                            <i class=\"fas fa-crown mr-2\"></i>Premium\n                        </span>\n            <h1 class=\"text-4xl font-bold text-premium-dark mt-4\">Executive Pro Suite</h1>\n            <p class=\"text-slate-600 mt-2\">Everything you need for your business in one powerful package</p>\n          </div>\n          <div class=\"mt-6 md:mt-0\">\n            <div class=\"text-5xl font-extrabold text-premium-accent\">$149</div>\n            <span class=\"text-slate-500\">/month</span>\n          </div>\n        </div>\n\n        <!-- Card Content -->\n        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-8 mb-8\">\n          <!-- Features List -->\n          <div>\n            <h2 class=\"text-xl font-semibold text-premium-dark mb-6 flex items-center\">\n              <div class=\"feature-icon w-10 h-10 rounded-lg flex items-center justify-center text-white mr-3\">\n                <i class=\"fas fa-star\"></i>\n              </div>\n              Premium Features\n            </h2>\n            <ul class=\"space-y-4\">\n              <li class=\"flex items-center\">\n                <div class=\"w-8 h-8 bg-green-100 rounded-full flex items-center justify-center text-green-600 mr-3\">\n                  <i class=\"fas fa-check\"></i>\n                </div>\n                <span class=\"text-slate-700\">Unlimited Projects & Teams</span>\n              </li>\n              <li class=\"flex items-center\">\n                <div class=\"w-8 h-8 bg-green-100 rounded-full flex items-center justify-center text-green-600 mr-3\">\n                  <i class=\"fas fa-check\"></i>\n                </div>\n                <span class=\"text-slate-700\">Advanced Analytics Dashboard</span>\n              </li>\n              <li class=\"flex items-center\">\n                <div class=\"w-8 h-8 bg-green-100 rounded-full flex items-center justify-center text-green-600 mr-3\">\n                  <i class=\"fas fa-check\"></i>\n                </div>\n                <span class=\"text-slate-700\">24/7 Priority Support</span>\n              </li>\n              <li class=\"flex items-center\">\n                <div class=\"w-8 h-8 bg-green-100 rounded-full flex items-center justify-center text-green-600 mr-3\">\n                  <i class=\"fas fa-check\"></i>\n                </div>\n                <span class=\"text-slate-700\">Custom Branding & White Label</span>\n              </li>\n              <li class=\"flex items-center\">\n                <div class=\"w-8 h-8 bg-green-100 rounded-full flex items-center justify-center text-green-600 mr-3\">\n                  <i class=\"fas fa-check\"></i>\n                </div>\n                <span class=\"text-slate-700\">Team Collaboration Tools</span>\n              </li>\n              <li class=\"flex items-center\">\n                <div class=\"w-8 h-8 bg-green-100 rounded-full flex items-center justify-center text-green-600 mr-3\">\n                  <i class=\"fas fa-check\"></i>\n                </div>\n                <span class=\"text-slate-700\">Exclusive Premium Resources</span>\n              </li>\n            </ul>\n          </div>\n\n          <!-- Stats -->\n          <div>\n            <h2 class=\"text-xl font-semibold text-premium-dark mb-6 flex items-center\">\n              <div class=\"feature-icon w-10 h-10 rounded-lg flex items-center justify-center text-white mr-3\">\n                <i class=\"fas fa-chart-line\"></i>\n              </div>\n              Performance Metrics\n            </h2>\n            <div class=\"grid grid-cols-2 gap-4\">\n              <div class=\"stat-card rounded-xl p-4 text-center\">\n                <div class=\"text-2xl font-bold text-premium-accent\">99.9%</div>\n                <div class=\"text-sm text-slate-600 mt-1\">Uptime</div>\n              </div>\n              <div class=\"stat-card rounded-xl p-4 text-center\">\n                <div class=\"text-2xl font-bold text-premium-accent\">2.4s</div>\n                <div class=\"text-sm text-slate-600 mt-1\">Load Time</div>\n              </div>\n              <div class=\"stat-card rounded-xl p-4 text-center\">\n                <div class=\"text-2xl font-bold text-premium-accent\">24/7</div>\n                <div class=\"text-sm text-slate-600 mt-1\">Support</div>\n              </div>\n              <div class=\"stat-card rounded-xl p-4 text-center\">\n                <div class=\"text-2xl font-bold text-premium-accent\">100ms</div>\n                <div class=\"text-sm text-slate-600 mt-1\">Response Time</div>\n              </div>\n            </div>\n\n            <!-- Progress bars -->\n            <div class=\"mt-6\">\n              <div class=\"flex items-center justify-between mb-2\">\n                <span class=\"text-slate-700 text-sm\">Storage</span>\n                <span class=\"text-premium-accent font-semibold\">500GB / 1TB</span>\n              </div>\n              <div class=\"w-full bg-slate-200 rounded-full h-2.5\">\n                <div class=\"bg-gradient-to-r from-premium-accent to-purple-600 h-2.5 rounded-full\" style=\"width: 50%\">\n                </div>\n              </div>\n\n              <div class=\"flex items-center justify-between mb-2 mt-4\">\n                <span class=\"text-slate-700 text-sm\">Bandwidth</span>\n                <span class=\"text-premium-accent font-semibold\">Unlimited</span>\n              </div>\n              <div class=\"w-full bg-slate-200 rounded-full h-2.5\">\n                <div class=\"bg-gradient-to-r from-premium-accent to-purple-600 h-2.5 rounded-full\" style=\"width: 100%\">\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <!-- CTA Button -->\n        <div class=\"text-center\">\n          <button class=\"btn-primary text-white font-bold py-4 px-10 rounded-xl transition-all duration-300 flex items-center justify-center mx-auto\">\n                        <i class=\"fas fa-rocket mr-3\"></i>\n                        Get Started Now\n                    </button>\n          <p class=\"text-slate-600 text-sm mt-4\">\n            <i class=\"fas fa-shield-alt mr-2\"></i>30-day money-back guarantee •\n            <i class=\"fas fa-credit-card ml-3 mr-2\"></i>No credit card required\n          </p>\n        </div>\n\n        <!-- Decorative Elements -->\n        <div\n          class=\"absolute bottom-0 left-0 w-32 h-32 bg-gradient-to-br from-premium-accent/20 to-transparent rounded-full -translate-x-12 translate-y-8\">\n        </div>\n        <div\n          class=\"absolute top-1/2 right-0 w-24 h-24 bg-gradient-to-br from-premium-accent/20 to-transparent rounded-full translate-x-8\">\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <script>\n    // Add some interactive elements\n        document.addEventListener('DOMContentLoaded', function() {\n            const ctaButton = document.querySelector('.btn-primary');\n            \n            ctaButton.addEventListener('mouseenter', function() {\n                this.innerHTML = '<i class=\"fas fa-arrow-right mr-3\"></i>Get Started Now';\n            });\n            \n            ctaButton.addEventListener('mouseleave', function() {\n                this.innerHTML = '<i class=\"fas fa-rocket mr-3\"></i>Get Started Now';\n            });\n            \n            // Add animation to stat cards\n            const statCards = document.querySelectorAll('.stat-card');\n            statCards.forEach(card => {\n                card.addEventListener('mouseenter', function() {\n                    this.classList.add('shadow-md');\n                });\n                card.addEventListener('mouseleave', function() {\n                    this.classList.remove('shadow-md');\n                });\n            });\n        });\n  </script>\n</body>\n\n</html>"
  }
}
