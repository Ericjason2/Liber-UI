      "content": "import * as React from \"react\"\n\nfunction PricingCard({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"pricing-card\"\n      className={className}\n      {...props}\n    >\n      <div className=\"mt-4 max-w-sm mx-auto px-4 mt-16\">\r\n          <div className=\"bg-white border rounded text-center px-4 pt-6 pb-8 shadow\">\r\n              <h3 className=\"text-2xl\">\r\n                  Starter\r\n              </h3>\r\n              <div className=\"mt-4\">\r\n                  <span className=\"text-red-500 text-2xl line-through\">19 €</span>\r\n              </div>\r\n              <div className=\"mt-1\">\r\n                  <span className=\"font-bold text-3xl\">9 €</span>\r\n                  <span className=\"text-gray-600\">/ month</span>\r\n              </div>\r\n              <div className=\"mt-6\">\r\n                  <div className=\"font-bold text-lg\">2.000 translation keys</div>\r\n                  <div className=\"mt-3\">Unlimited projects</div>\r\n                  <div className=\"mt-3\">Unlimited languages</div>\r\n                  <div className=\"mt-3\">Unlimited seats</div>\r\n              </div>\r\n              <div className=\"mt-8\">\r\n                  <a href=\"\" className=\"bg-blue-500 hover700 text-white font-bold py-2 px-4 rounded\">\r\n                      Start my 14-day trial\r\n                  </a>\r\n              </div>\r\n          </div>\r\n      </div>\n    </div>\n  )\n}\n\nexport { PricingCard }\n",
      "type": "registry:ui"
    }
