 <label class=\\\"text-gray-700\\\">CVV<label>\\n              <input type=\\\"text\\\" name=\\\"cvv\\\" class=\\\"w-full p-2 shadow-sm rounded-md border border-gray-300 focus:outline-none focus:ring focus:ring-indigo-200 focus:border-indigo-300 focus:ring-opacity-20\\\" placeholder=\\\"123\\\" />\\n            </div>\\n          </div>\\n\\n          <div>\\n            <button class=\\\"w-full bg-green-500 p-3 text-gray-100 font-bold\\\">Pay $500</button>\\n          </div>\\n        </form>\\n      </div>\\n    <div>\\n    </div>\\n<div>\" }} />\n  );\n}\n",
