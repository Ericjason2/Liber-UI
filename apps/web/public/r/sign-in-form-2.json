      "content": "/**\n * Component: Sign in form\n * Author: @simon-scheffer (https://tailwindflex.com/@simon-scheffer)\n * Source: https://tailwindflex.com/@simon-scheffer/sign-in-form-2\n * Attribution: Créé par @simon-scheffer sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function SignInForm2() {\n  return (\n    <div>\n    <div\n        className=\"relative mx-auto w-full max-w-md bg-white px-6 pt-10 pb-8 shadow-xl ring-1 ring-gray-900/5 sm sm10\">\n        <div className=\"w-full\">\n            <div className=\"text-center\">\n                <h1 className=\"text-3xl font-semibold text-gray-900\">Sign in</h1>\n                <p className=\"mt-2 text-gray-500\">Sign in below to access your account</p>\n            </div>\n            <div className=\"mt-5\">\n                <form action=\"\">\n                    <div className=\"relative mt-6\">\n                        <input type=\"email\" name=\"email\" id=\"email\" placeholder=\"Email Address\" className=\"peer mt-1 w-full border-b-2 border-gray-300 px-0 py-1 placeholder focus500 focus\" autoComplete=\"NA\" />\n                        <label htmlFor=\"email\" className=\"pointer-events-none absolute top-0 left-0 origin-left -translate-y-1/2 transform text-sm text-gray-800 opacity-75 transition-all duration-100 ease-in-out peer-placeholder-shown1/2 peer-placeholder-shown peer-placeholder-shown500 peer-focus0 peer-focus0 peer-focus peer-focus800\">Email Address</label>\n                    </div>\n                    <div className=\"relative mt-6\">\n                        <input type=\"password\" name=\"password\" id=\"password\" placeholder=\"Password\" className=\"peer peer mt-1 w-full border-b-2 border-gray-300 px-0 py-1 placeholder focus500 focus\" />\n                        <label htmlFor=\"password\" className=\"pointer-events-none absolute top-0 left-0 origin-left -translate-y-1/2 transform text-sm text-gray-800 opacity-75 transition-all duration-100 ease-in-out peer-placeholder-shown1/2 peer-placeholder-shown peer-placeholder-shown500 peer-focus0 peer-focus0 peer-focus peer-focus800\">Password</label>\n                    </div>\n                    <div className=\"my-6\">\n                        <button type=\"submit\" className=\"w-full rounded-md bg-black px-3 py-4 text-white focus600 focus\">Sign in</button>\n                    </div>\n                    <p className=\"text-center text-sm text-gray-500\">Don&#x27;t have an account yet?\n                        <a href=\"#!\"\n                            className=\"font-semibold text-gray-600 hover focus800 focus\">Sign\n                            up\n                        </a>.\n                    </p>\n                </form>\n            </div>\n        </div>\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
