      "content": "/**\n * Component: Twitter Post (Tweet) UI Mockup\n * Author: @hamza-atig (https://tailwindflex.com/@hamza-atig)\n * Source: https://tailwindflex.com/@hamza-atig/twitter-post-tweet-ui-mockup\n * Attribution: Créé par @hamza-atig sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function TwitterPostTweetUiMockup() {\n  return (\n    <div>\n    <body className=\"bg-white dark min-h-screen flex items-center justify-center p-4\">\n    \n      <div\n        className=\"bg-white dark border tweet-border max-w-xl w-full rounded-lg sm overflow-hidden shadow-sm\">\n        <article className=\"p-4 flex space-x-3\">\n          \n          <div className=\"flex-shrink-0\">\n            <img className=\"w-10 h-10 sm12 sm12 rounded-full object-cover\"\n                   src=\"https://images.unsplash.com/photo-1494790108377-be9c29b29330?ixlib=rb-1.2.1&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=crop&w=100&q=80\"\n                   alt=\"User Avatar\" />\n          </div>\n    \n          \n          <div className=\"flex-1 min-w-0\">\n            \n            <div className=\"flex justify-between items-center mb-1\">\n              <div className=\"flex items-baseline space-x-1 text-sm min-w-0\">\n                <span className=\"font-bold text-gray-900 dark100 truncate hover cursor-pointer\">\n                    Full Name\n                  </span>\n                <span className=\"text-gray-500 dark400 truncate\">\n                    @username\n                  </span>\n                <span className=\"text-gray-500 dark400\">·</span>\n                <span className=\"text-gray-500 dark400 hover cursor-pointer whitespace-nowrap\">\n                    3h\n                  </span>\n              </div>\n              <button aria-label=\"More options\" className=\"text-gray-500 dark400 hover100 hover500 dark900 dark50 rounded-full p-1.5 -mr-1.5\">\n                  <svg className=\"w-5 h-5\" fill=\"currentColor\" viewBox=\"0 0 20 20\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M6 10a2 2 0 11-4 0 2 2 0 014 0zM12 10a2 2 0 11-4 0 2 2 0 014 0zM16 12a2 2 0 100-4 2 2 0 000 4z\"></path></svg>\n                </button>\n            </div>\n    \n            \n            <p className=\"text-gray-800 dark100 text-sm sm leading-normal mb-2\">\n              Just launched a new project using Tailwind CSS! 🎉 So much faster to build UIs this way. Check it out! <a\n                href=\"#\" className=\"text-blue-500 hover\">#webdev</a> <a href=\"#\"\n                className=\"text-blue-500 hover\">#tailwindcss</a> <a href=\"#\"\n                className=\"text-blue-500 hover\">@tailwindcss</a>\n            </p>\n    \n            \n            <div className=\"mt-3 rounded-xl border tweet-border overflow-hidden\">\n              <img src=\"https://images.unsplash.com/photo-1605379399642-870262d3d051?ixlib=rb-1.2.1&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=crop&w=870&q=80\"\n                     alt=\"Tweet media content\" className=\"w-full object-cover aspect-video\" />\n            </div>\n    \n            \n            <div className=\"flex justify-between items-center mt-4 text-gray-500 dark400 text-xs sm -ml-2\">\n              <button aria-label=\"Reply\" className=\"flex items-center space-x-1 group hover500 dark400 p-2 rounded-full hover100 dark900 dark50\">\n                    <svg className=\"w-4 h-4 sm5 sm5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"M16 15v-1a4 4 0 00-4-4H8m0 0l3 3m-3-3l3-3m9 14l-3-3m3 3l-3 3\"></path></svg>\n                    <span>15</span>\n                </button>\n              <button aria-label=\"Retweet\" className=\"flex items-center space-x-1 group hover500 dark400 p-2 rounded-full hover100 dark900 dark50\">\n                    <svg className=\"w-4 h-4 sm5 sm5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m-15.357-2A8.001 8.001 0 0019.418 15m0 0H15\"></path></svg>\n                    <span>88</span>\n                </button>\n              <button aria-label=\"Like\" className=\"flex items-center space-x-1 group hover500 dark400 p-2 rounded-full hover100 dark900 dark50\">\n                    <svg className=\"w-4 h-4 sm5 sm5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z\"></path></svg>\n                    <span>312</span>\n                </button>\n              <button aria-label=\"View tweet analytics\" className=\"flex items-center space-x-1 group hover500 dark400 p-2 rounded-full hover100 dark900 dark50\">\n                    <svg className=\"w-4 h-4 sm5 sm5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z\"></path></svg>\n                     <span>21.5K</span>\n                </button>\n              <button aria-label=\"Share or Bookmark\" className=\"flex items-center space-x-1 group hover500 dark400 p-2 rounded-full hover100 dark900 dark50\">\n                     <svg className=\"w-4 h-4 sm5 sm5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12\"></path></svg>\n                 </button>\n            </div>\n          </div>\n        </article>\n      </div>\n    \n    </body>\n    </div>\n  );\n}\n",
