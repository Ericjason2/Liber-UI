      "content": "/**\n * Component: Contact us Form with Responsive\n * Author: @kuldeep541 (https://tailwindflex.com/@kuldeep541)\n * Source: https://tailwindflex.com/@kuldeep541/contact-us-form-with-responsive\n * Attribution: Créé par @kuldeep541 sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function ContactUsFormWithResponsive() {\n  return (\n    <div>\n    \n        <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" />\n    <section className=\"contact-section\">\n      <div className=\"container mx-auto px-4 py-8\">\n        <div className=\"grid md2 gap-8 bg-white rounded-lg shadow-lg overflow-hidden\">\n          \n          \n          <div className=\"p-8 bg-gray-800 text-white\">\n            <h2 className=\"text-2xl text-blue-400 mb-8 relative pb-4\">\n              Contact Information\n              <span className=\"absolute bottom-0 left-0 w-12 h-0.5 bg-blue-500\"></span>\n            </h2>\n            \n            \n            <div className=\"flex items-start gap-4 mb-8\">\n              <div className=\"w-12 h-12 bg-blue-500 flex items-center justify-center rounded-full text-xl\">\n                <i className=\"fas fa-map-marker-alt\"></i>\n              </div>\n              <div>\n                <h3 className=\"text-lg mb-1\">Our Location</h3>\n                <p className=\"text-gray-300 leading-relaxed\">\n                  Lucknow\n                </p>\n              </div>\n            </div>\n            \n            \n            <div className=\"flex items-start gap-4 mb-8\">\n              <div className=\"w-12 h-12 bg-blue-500 flex items-center justify-center rounded-full text-xl\">\n                <i className=\"fas fa-phone-alt\"></i>\n              </div>\n              <div>\n                <h3 className=\"text-lg mb-1\">Phone Numbers</h3>\n                <p className=\"text-gray-300 leading-relaxed\">\n                  <a href=\"tel:+978589658\" className=\"hover400\">+91 748598658</a><br />\n                  <a href=\"tel:+748596255\" className=\"hover400\">+91 789456123</a>\n                </p>\n              </div>\n            </div>\n            \n            \n            <div className=\"flex items-start gap-4 mb-8\">\n              <div className=\"w-12 h-12 bg-blue-500 flex items-center justify-center rounded-full text-xl\">\n                <i className=\"fas fa-envelope\"></i>\n              </div>\n              <div>\n                <h3 className=\"text-lg mb-1\">Email Address</h3>\n                <p className=\"text-gray-300 leading-relaxed\">\n                  <a href=\"mailto2111.com\" className=\"hover400\">kuldeepprajapati2111.com</a><br />\n                 \n                </p>\n              </div>\n            </div>\n            \n            \n            <div className=\"flex gap-4 mt-8\">\n              <a href=\"#\" className=\"w-10 h-10 bg-gray-700 flex items-center justify-center rounded-full text-white transition duration-300 hover500 transform hover1\">\n                <i className=\"fab fa-facebook-f\"></i>\n              </a>\n              <a href=\"#\" className=\"w-10 h-10 bg-gray-700 flex items-center justify-center rounded-full text-white transition duration-300 hover500 transform hover1\">\n                <i className=\"fab fa-instagram\"></i>\n              </a>\n              <a href=\"#\" className=\"w-10 h-10 bg-gray-700 flex items-center justify-center rounded-full text-white transition duration-300 hover400 transform hover1\">\n                <i className=\"fab fa-twitter\"></i>\n              </a>\n              <a href=\"#\" className=\"w-10 h-10 bg-gray-700 flex items-center justify-center rounded-full text-white transition duration-300 hover700 transform hover1\">\n                <i className=\"fab fa-linkedin-in\"></i>\n              </a>\n            </div>\n          </div>\n          \n          \n          <div className=\"p-8\">\n            <h2 className=\"text-2xl text-blue-500 mb-8 relative pb-4\">\n              Send Us a Message\n              <span className=\"absolute bottom-0 left-0 w-12 h-0.5 bg-blue-500\"></span>\n            </h2>\n            <form className=\"space-y-6\">\n              \n              <div>\n                <label htmlFor=\"name\" className=\"block mb-2 font-medium\">Your Name</label>\n                <input type=\"text\" id=\"name\" className=\"w-full p-3 border border-gray-300 rounded-md focus focus2 focus300 transition\" required />\n              </div>\n              \n              <div>\n                <label htmlFor=\"email\" className=\"block mb-2 font-medium\">Email Address</label>\n                <input type=\"email\" id=\"email\" className=\"w-full p-3 border border-gray-300 rounded-md focus focus2 focus300 transition\" required />\n              </div>\n              \n              <div>\n                <label htmlFor=\"phone\" className=\"block mb-2 font-medium\">Phone Number</label>\n                <input type=\"tel\" id=\"phone\" className=\"w-full p-3 border border-gray-300 rounded-md focus focus2 focus300 transition\" />\n              </div>\n              \n              <div>\n                <label htmlFor=\"subject\" className=\"block mb-2 font-medium\">Subject</label>\n                <input type=\"text\" id=\"subject\" className=\"w-full p-3 border border-gray-300 rounded-md focus focus2 focus300 transition\" />\n              </div>\n              \n              <div>\n                <label htmlFor=\"message\" className=\"block mb-2 font-medium\">Your Message</label>\n                <textarea id=\"message\" className=\"w-full p-3 border border-gray-300 rounded-md min-h-[150px] resize-y focus focus2 focus300 transition\" required></textarea>\n              </div>\n              \n              \n              <button type=\"submit\" className=\"flex items-center gap-2 bg-gradient-to-br from-blue-500 to-blue-400 text-white font-semibold py-3 px-6 rounded-full hover105 hover transition duration-300\">\n                <i className=\"fas fa-paper-plane\"></i> Send Message\n              </button>\n            </form>\n          </div>\n        </div>\n      </div>\n    </section>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
