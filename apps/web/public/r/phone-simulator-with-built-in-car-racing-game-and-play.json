    "rawHtml": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n  <meta charset=\"UTF-8\">\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=yes\">\r\n  <title>Phone Simulator with Car Racing Game</title>\r\n  <script src=\"https://cdn.tailwindcss.com\"></script>\r\n  <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\r\n </head>\r\n<body>\r\n  <div class=\"phone-container\">\r\n    <div class=\"phone-screen\">\r\n      <div class=\"notch\"></div>\r\n      <div class=\"status-bar\">\r\n        <span>9:41</span>\r\n        <span>\r\n          <i class=\"fas fa-signal\"></i>\r\n          <i class=\"fas fa-wifi\"></i>\r\n          <i class=\"fas fa-battery-full\"></i> 85%\r\n        </span>\r\n      </div>\r\n\r\n      <div class=\"home-screen\" id=\"homeScreen\">\r\n        <div style=\"color:white; font-size: 26px; font-weight: 700; text-align: center; margin-top: 8px; letter-spacing: 1px;\">\r\n          My Phone\r\n        </div>\r\n        <div class=\"app-grid\">\r\n          <div class=\"app-icon\">\r\n            <div class=\"app-icon-box\" style=\"background: linear-gradient(135deg, #34c759, #28a745);\">\r\n              <i class=\"fas fa-phone\"></i>\r\n            </div>\r\n            <span class=\"app-label\">Phone</span>\r\n          </div>\r\n          <div class=\"app-icon\">\r\n            <div class=\"app-icon-box\" style=\"background: linear-gradient(135deg, #007aff, #0056cc);\">\r\n              <i class=\"fas fa-comment-dots\"></i>\r\n            </div>\r\n            <span class=\"app-label\">Messages</span>\r\n          </div>\r\n          <div class=\"app-icon\">\r\n            <div class=\"app-icon-box\" style=\"background: linear-gradient(135deg, #ff9500, #e68600);\">\r\n              <i class=\"fas fa-music\"></i>\r\n            </div>\r\n            <span class=\"app-label\">Music</span>\r\n          </div>\r\n          <div class=\"app-icon\" id=\"gameAppIcon\" onclick=\"openGame()\">\r\n            <div class=\"app-icon-box game-app\">\r\n              <i class=\"fas fa-car\"></i>\r\n            </div>\r\n            <span class=\"app-label\">Car Race</span>\r\n          </div>\r\n          <div class=\"app-icon\">\r\n            <div class=\"app-icon-box\" style=\"background: linear-gradient(135deg, #5856d6, #4844aa);\">\r\n              <i class=\"fas fa-camera\"></i>\r\n            </div>\r\n            <span class=\"app-label\">Camera</span>\r\n          </div>\r\n          <div class=\"app-icon\">\r\n            <div class=\"app-icon-box\" style=\"background: linear-gradient(135deg, #ff3b30, #d63029);\">\r\n              <i class=\"fas fa-envelope\"></i>\r\n            </div>\r\n            <span class=\"app-label\">Mail</span>\r\n          </div>\r\n          <div class=\"app-icon\">\r\n            <div class=\"app-icon-box\" style=\"background: linear-gradient(135deg, #0a84ff, #0066cc);\">\r\n              <i class=\"fas fa-globe\"></i>\r\n            </div>\r\n            <span class=\"app-label\">Browser</span>\r\n          </div>\r\n          <div class=\"app-icon\">\r\n            <div class=\"app-icon-box\" style=\"background: linear-gradient(135deg, #af52de, #8e44ad);\">\r\n              <i class=\"fas fa-gear\"></i>\r\n            </div>\r\n            <span class=\"app-label\">Settings</span>\r\n          </div>\r\n        </div>\r\n        <div class=\"dock\">\r\n          <div class=\"app-icon-box\" style=\"width:42px; height:42px; background:linear-gradient(135deg, #34c759, #28a745); font-size:18px; border-radius:13px;\">\r\n            <i class=\"fas fa-phone\"></i>\r\n          </div>\r\n          <div class=\"app-icon-box\" style=\"width:42px; height:42px; background:linear-gradient(135deg, #007aff, #0056cc); font-size:18px; border-radius:13px;\">\r\n            <i class=\"fas fa-comment-dots\"></i>\r\n          </div>\r\n          <div class=\"app-icon-box game-app\" style=\"width:42px; height:42px; font-size:18px; border-radius:13px; cursor:pointer;\" onclick=\"openGame()\">\r\n            <i class=\"fas fa-car\"></i>\r\n          </div>\r\n          <div class=\"app-icon-box\" style=\"width:42px; height:42px; background:linear-gradient(135deg, #ff9500, #e68600); font-size:18px; border-radius:13px;\">\r\n            <i class=\"fas fa-music\"></i>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"game-screen\" id=\"gameScreen\">\r\n        <div class=\"game-header\">\r\n          <button class=\"back-btn\" onclick=\"closeGame()\">\r\n            <i class=\"fas fa-arrow-left\"></i> Home\r\n          </button>\r\n          <span class=\"score\">\r\n            <i class=\"fas fa-trophy\"></i> <span id=\"scoreDisplay\">0</span>\r\n          </span>\r\n        </div>\r\n        <div class=\"game-area\">\r\n          <canvas id=\"gameCanvas\"></canvas>\r\n        </div>\r\n        <div class=\"game-controls\">\r\n          <button class=\"ctrl-btn\" id=\"leftBtn\" onmousedown=\"moveLeft=true\" onmouseup=\"moveLeft=false\" onmouseleave=\"moveLeft=false\" ontouchstart=\"moveLeft=true\" ontouchend=\"moveLeft=false\">\r\n            <i class=\"fas fa-chevron-left\"></i>\r\n          </button>\r\n          <button class=\"ctrl-btn up-down\" id=\"upBtn\" onmousedown=\"moveUp=true\" onmouseup=\"moveUp=false\" onmouseleave=\"moveUp=false\" ontouchstart=\"moveUp=true\" ontouchend=\"moveUp=false\">\r\n            <i class=\"fas fa-chevron-up\"></i>\r\n          </button>\r\n          <button class=\"ctrl-btn up-down\" id=\"downBtn\" onmousedown=\"moveDown=true\" onmouseup=\"moveDown=false\" onmouseleave=\"moveDown=false\" ontouchstart=\"moveDown=true\" ontouchend=\"moveDown=false\">\r\n            <i class=\"fas fa-chevron-down\"></i>\r\n          </button>\r\n          <button class=\"ctrl-btn\" id=\"rightBtn\" onmousedown=\"moveRight=true\" onmouseup=\"moveRight=false\" onmouseleave=\"moveRight=false\" ontouchstart=\"moveRight=true\" ontouchend=\"moveRight=false\">\r\n            <i class=\"fas fa-chevron-right\"></i>\r\n          </button>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"home-indicator\"></div>\r\n    </div>\r\n  </div>\r\n\r\n  <script>\r\n    const canvas = document.getElementById('gameCanvas');\r\n    const ctx = canvas.getContext('2d');\r\n    const scoreDisplay = document.getElementById('scoreDisplay');\r\n\r\n    let gameRunning = false;\r\n    let animationId;\r\n\r\n    const player = {\r\n      x: 0,\r\n      y: 0,\r\n      width: 45,\r\n      height: 72,\r\n      speed: 5\r\n    };\r\n\r\n    let obstacles = [];\r\n    let score = 0;\r\n    let gameSpeed = 4;\r\n    let frameCount = 0;\r\n    let roadMarkings = [];\r\n    let moveLeft = false;\r\n    let moveRight = false;\r\n    let moveUp = false;\r\n    let moveDown = false;\r\n\r\n    function resizeCanvas() {\r\n      const gameArea = canvas.parentElement;\r\n      canvas.width = gameArea.clientWidth;\r\n      canvas.height = gameArea.clientHeight;\r\n      player.x = canvas.width / 2 - player.width / 2;\r\n      player.y = canvas.height - player.height - 15;\r\n      initRoadMarkings();\r\n    }\r\n\r\n    function initRoadMarkings() {\r\n      roadMarkings = [];\r\n      for (let i = 0; i < 25; i++) {\r\n        roadMarkings.push({\r\n          x: canvas.width / 2 - 2.5,\r\n          y: i * 42 - 42,\r\n          width: 5,\r\n          height: 25\r\n        });\r\n      }\r\n    }\r\n\r\n    function spawnObstacle() {\r\n      const laneWidth = canvas.width / 3;\r\n      const lane = Math.floor(Math.random() * 3);\r\n      const x = lane * laneWidth + laneWidth / 2 - 22;\r\n      obstacles.push({\r\n        x: x,\r\n        y: -90,\r\n        width: 40,\r\n        height: 65,\r\n        speed: gameSpeed + Math.random() * 2.5\r\n      });\r\n    }\r\n\r\n    function resetGame() {\r\n      obstacles = [];\r\n      score = 0;\r\n      gameSpeed = 4;\r\n      frameCount = 0;\r\n      scoreDisplay.textContent = '0';\r\n      player.x = canvas.width / 2 - player.width / 2;\r\n      player.y = canvas.height - player.height - 15;\r\n      initRoadMarkings();\r\n      const restartBtn = document.getElementById('restartBtn');\r\n      if (restartBtn) restartBtn.style.display = 'none';\r\n    }\r\n\r\n    function drawPlayer() {\r\n      ctx.fillStyle = '#ff3333';\r\n      ctx.beginPath();\r\n      ctx.roundRect(player.x, player.y, player.width, player.height, 8);\r\n      ctx.fill();\r\n\r\n      ctx.fillStyle = '#1a1a2e';\r\n      ctx.beginPath();\r\n      ctx.roundRect(player.x + 6, player.y + 9, player.width - 12, 22, 6);\r\n      ctx.fill();\r\n\r\n      ctx.fillStyle = 'rgba(100,150,255,0.35)';\r\n      ctx.beginPath();\r\n      ctx.roundRect(player.x + 8, player.y + 11, 12, 9, 3);\r\n      ctx.fill();\r\n\r\n      ctx.fillStyle = '#ffff88';\r\n      ctx.shadowColor = '#ffcc00';\r\n      ctx.shadowBlur = 16;\r\n      ctx.fillRect(player.x + 3, player.y + 52, 9, 8);\r\n      ctx.fillRect(player.x + player.width - 12, player.y + 52, 9, 8);\r\n      ctx.shadowBlur = 0;\r\n\r\n      ctx.fillStyle = '#111';\r\n      ctx.fillRect(player.x - 4, player.y + 7, 8, 18);\r\n      ctx.fillRect(player.x + player.width - 4, player.y + 7, 8, 18);\r\n      ctx.fillRect(player.x - 4, player.y + 45, 8, 18);\r\n      ctx.fillRect(player.x + player.width - 4, player.y + 45, 8, 18);\r\n\r\n      ctx.fillStyle = '#ff0000';\r\n      ctx.shadowColor = '#ff0000';\r\n      ctx.shadowBlur = 10;\r\n      ctx.fillRect(player.x + 3, player.y + 2, 9, 6);\r\n      ctx.fillRect(player.x + player.width - 12, player.y + 2, 9, 6);\r\n      ctx.shadowBlur = 0;\r\n\r\n      ctx.fillStyle = '#ffcc00';\r\n      ctx.shadowColor = '#ffaa00';\r\n      ctx.shadowBlur = 7;\r\n      ctx.fillRect(player.x + player.width / 2 - 7, player.y - 5, 14, 5);\r\n      ctx.shadowBlur = 0;\r\n    }\r\n\r\n    function drawObstacle(obs) {\r\n      ctx.fillStyle = '#ff6600';\r\n      ctx.beginPath();\r\n      ctx.roundRect(obs.x, obs.y, obs.width, obs.height, 7);\r\n      ctx.fill();\r\n\r\n      ctx.fillStyle = '#1a1a2e';\r\n      ctx.beginPath();\r\n      ctx.roundRect(obs.x + 5, obs.y + 8, obs.width - 10, 18, 5);\r\n      ctx.fill();\r\n\r\n      ctx.fillStyle = '#ffff88';\r\n      ctx.shadowColor = '#ffcc00';\r\n      ctx.shadowBlur = 12;\r\n      ctx.fillRect(obs.x + 2, obs.y + obs.height - 13, 8, 7);\r\n      ctx.fillRect(obs.x + obs.width - 10, obs.y + obs.height - 13, 8, 7);\r\n      ctx.shadowBlur = 0;\r\n\r\n      ctx.fillStyle = '#111';\r\n      ctx.fillRect(obs.x - 3, obs.y + 6, 7, 16);\r\n      ctx.fillRect(obs.x + obs.width - 4, obs.y + 6, 7, 16);\r\n      ctx.fillRect(obs.x - 3, obs.y + 42, 7, 16);\r\n      ctx.fillRect(obs.x + obs.width - 4, obs.y + 42, 7, 16);\r\n    }\r\n\r\n    function drawRoad() {\r\n      ctx.fillStyle = '#2a2a2a';\r\n      ctx.fillRect(0, 0, canvas.width, canvas.height);\r\n\r\n      ctx.fillStyle = '#3a3a3a';\r\n      ctx.fillRect(0, 0, 10, canvas.height);\r\n      ctx.fillRect(canvas.width - 10, 0, 10, canvas.height);\r\n\r\n      ctx.fillStyle = '#444';\r\n      ctx.setLineDash([25, 16]);\r\n      ctx.lineWidth = 2;\r\n      ctx.beginPath();\r\n      ctx.moveTo(canvas.width / 3, 0);\r\n      ctx.lineTo(canvas.width / 3, canvas.height);\r\n      ctx.strokeStyle = '#444';\r\n      ctx.stroke();\r\n\r\n      ctx.beginPath();\r\n      ctx.moveTo((canvas.width / 3) * 2, 0);\r\n      ctx.lineTo((canvas.width / 3) * 2, canvas.height);\r\n      ctx.stroke();\r\n      ctx.setLineDash([]);\r\n\r\n      ctx.fillStyle = '#ffcc00';\r\n      roadMarkings.forEach(marking => {\r\n        ctx.fillRect(marking.x, marking.y, marking.width, marking.height);\r\n      });\r\n    }\r\n\r\n    function update() {\r\n      if (!gameRunning) return;\r\n\r\n      if (moveLeft) {\r\n        player.x -= player.speed;\r\n        if (player.x < 16) player.x = 16;\r\n      }\r\n      if (moveRight) {\r\n        player.x += player.speed;\r\n        if (player.x > canvas.width - player.width - 16) player.x = canvas.width - player.width - 16;\r\n      }\r\n      if (moveUp) {\r\n        player.y -= player.speed;\r\n        if (player.y < 8) player.y = 8;\r\n      }\r\n      if (moveDown) {\r\n        player.y += player.speed;\r\n        if (player.y > canvas.height - player.height - 8) player.y = canvas.height - player.height - 8;\r\n      }\r\n\r\n      roadMarkings.forEach(marking => {\r\n        marking.y += gameSpeed;\r\n        if (marking.y > canvas.height) {\r\n          marking.y = -25;\r\n        }\r\n      });\r\n\r\n      obstacles.forEach(obs => {\r\n        obs.y += obs.speed;\r\n      });\r\n\r\n      obstacles = obstacles.filter(obs => {\r\n        if (obs.y > canvas.height + 100) {\r\n          score += 10;\r\n          scoreDisplay.textContent = score;\r\n          return false;\r\n        }\r\n        return true;\r\n      });\r\n\r\n      frameCount++;\r\n      if (frameCount % 42 === 0) {\r\n        spawnObstacle();\r\n      }\r\n\r\n      if (frameCount % 220 === 0 && gameSpeed < 12) {\r\n        gameSpeed += 0.6;\r\n      }\r\n\r\n      for (let obs of obstacles) {\r\n        if (\r\n          player.x < obs.x + obs.width &&\r\n          player.x + player.width > obs.x &&\r\n          player.y < obs.y + obs.height &&\r\n          player.y + player.height > obs.y\r\n        ) {\r\n          gameOver();\r\n          return;\r\n        }\r\n      }\r\n    }\r\n\r\n    function draw() {\r\n      ctx.clearRect(0, 0, canvas.width, canvas.height);\r\n      drawRoad();\r\n      obstacles.forEach(obs => drawObstacle(obs));\r\n      drawPlayer();\r\n\r\n      if (!gameRunning && frameCount > 0) {\r\n        ctx.fillStyle = 'rgba(0,0,0,0.75)';\r\n        ctx.fillRect(0, 0, canvas.width, canvas.height);\r\n        ctx.fillStyle = 'white';\r\n        ctx.font = 'bold 22px \"Segoe UI\", sans-serif';\r\n        ctx.textAlign = 'center';\r\n        ctx.fillText('GAME OVER', canvas.width / 2, canvas.height / 2 - 22);\r\n        ctx.font = '15px \"Segoe UI\", sans-serif';\r\n        ctx.fillText('Score: ' + score, canvas.width / 2, canvas.height / 2 + 16);\r\n        ctx.font = '13px \"Segoe UI\", sans-serif';\r\n        ctx.fillText('Tap screen to restart', canvas.width / 2, canvas.height / 2 + 44);\r\n      }\r\n    }\r\n\r\n    function gameLoop() {\r\n      update();\r\n      draw();\r\n      animationId = requestAnimationFrame(gameLoop);\r\n    }\r\n\r\n    function gameOver() {\r\n      gameRunning = false;\r\n      let restartBtn = document.getElementById('restartBtn');\r\n      if (!restartBtn) {\r\n        restartBtn = document.createElement('button');\r\n        restartBtn.id = 'restartBtn';\r\n        restartBtn.innerHTML = '<i class=\"fas fa-rotate-right\"></i> Restart';\r\n        restartBtn.style.cssText = `\r\n          position: absolute;\r\n          bottom: 18px;\r\n          left: 50%;\r\n          transform: translateX(-50%);\r\n          background: #ff4444;\r\n          color: white;\r\n          border: none;\r\n          padding: 12px 26px;\r\n          border-radius: 25px;\r\n          font-size: 14px;\r\n          font-weight: bold;\r\n          cursor: pointer;\r\n          z-index: 10;\r\n          box-shadow: 0 5px 18px rgba(255,0,0,0.5);\r\n          display: flex;\r\n          align-items: center;\r\n          gap: 7px;\r\n        `;\r\n        restartBtn.addEventListener('click', restartGame);\r\n        document.querySelector('.game-area').appendChild(restartBtn);\r\n      }\r\n      restartBtn.style.display = 'flex';\r\n    }\r\n\r\n    function restartGame() {\r\n      const restartBtn = document.getElementById('restartBtn');\r\n      if (restartBtn) restartBtn.style.display = 'none';\r\n      resetGame();\r\n      gameRunning = true;\r\n    }\r\n\r\n    function startGame() {\r\n      resizeCanvas();\r\n      resetGame();\r\n      gameRunning = true;\r\n      gameLoop();\r\n    }\r\n\r\n    function stopGame() {\r\n      gameRunning = false;\r\n      if (animationId) {\r\n        cancelAnimationFrame(animationId);\r\n      }\r\n      const restartBtn = document.getElementById('restartBtn');\r\n      if (restartBtn) restartBtn.style.display = 'none';\r\n    }\r\n\r\n    function openGame() {\r\n      document.getElementById('homeScreen').style.display = 'none';\r\n      document.getElementById('gameScreen').classList.add('active');\r\n      startGame();\r\n    }\r\n\r\n    function closeGame() {\r\n      stopGame();\r\n      document.getElementById('gameScreen').classList.remove('active');\r\n      document.getElementById('homeScreen').style.display = 'flex';\r\n    }\r\n\r\n    document.addEventListener('keydown', (e) => {\r\n      if (e.key === 'ArrowLeft' || e.key === 'a') moveLeft = true;\r\n      if (e.key === 'ArrowRight' || e.key === 'd') moveRight = true;\r\n      if (e.key === 'ArrowUp' || e.key === 'w') moveUp = true;\r\n      if (e.key === 'ArrowDown' || e.key === 's') moveDown = true;\r\n    });\r\n\r\n    document.addEventListener('keyup', (e) => {\r\n      if (e.key === 'ArrowLeft' || e.key === 'a') moveLeft = false;\r\n      if (e.key === 'ArrowRight' || e.key === 'd') moveRight = false;\r\n      if (e.key === 'ArrowUp' || e.key === 'w') moveUp = false;\r\n      if (e.key === 'ArrowDown' || e.key === 's') moveDown = false;\r\n    });\r\n\r\n    canvas.addEventListener('click', () => {\r\n      if (!gameRunning && frameCount > 0) {\r\n        restartGame();\r\n      }\r\n    });\r\n\r\n    window.addEventListener('resize', () => {\r\n      if (gameRunning) {\r\n        resizeCanvas();\r\n      }\r\n    });\r\n\r\n    resizeCanvas();\r\n\r\n    if (!ctx.roundRect) {\r\n      ctx.roundRect = function (x, y, w, h, r) {\r\n        if (typeof r === 'number') r = { tl: r, tr: r, br: r, bl: r };\r\n        ctx.beginPath();\r\n        ctx.moveTo(x + r.tl, y);\r\n        ctx.lineTo(x + w - r.tr, y);\r\n        ctx.quadraticCurveTo(x + w, y, x + w, y + r.tr);\r\n        ctx.lineTo(x + w, y + h - r.br);\r\n        ctx.quadraticCurveTo(x + w, y + h, x + w - r.br, y + h);\r\n        ctx.lineTo(x + r.bl, y + h);\r\n        ctx.quadraticCurveTo(x, y + h, x, y + h - r.bl);\r\n        ctx.lineTo(x, y + r.tl);\r\n        ctx.quadraticCurveTo(x, y, x + r.tl, y);\r\n        ctx.closePath();\r\n      };\r\n    }\r\n  </script>\r\n</body>\r\n</html>"
  }
