{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "sign-in-box",
  "type": "registry:ui",
  "title": "Simple Sign-In Box",
  "description": "Simple Sign-In Box — Comprehensive form layout with input fields, visual validation, and integrated action triggers.",
  "author": "Liber UI",
  "categories": [
    "form"
  ],
  "dependencies": [],
  "files": [
    {
      "path": "components/ui/sign-in-box.tsx",
      "content": "import * as React from \"react\"\n\nfunction SignInBox({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"sign-in-box\"\n      className={className}\n      {...props}\n    >\n      <div className=\"flex justify-center\">\n        <div className=\"w-96 backdrop-blur-lg bg-opacity-80 rounded-lg shadow-lg p-5 bg-gray-900 text-white\">\n          <h2 className=\"text-2xl font-bold pb-5\">Sign In</h2>\n          <form>\n            <div className=\"mb-4\">\n              <label htmlFor=\"email\" className=\"block mb-2 text-sm font-medium\">Your email</label>\n              <input\n                type=\"email\"\n                id=\"email\"\n                className=\"bg-gray-100 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 w-full py-2.5 px-4\"\n                placeholder=\"andrew@mail.com\"\n                required\n                value=\"\"\n               />\n            </div>\n            <div className=\"mb-4\">\n              <label htmlFor=\"password\" className=\"block mb-2 text-sm font-medium\">Your password</label>\n              <input\n                type=\"password\"\n                id=\"password\"\n                className=\"bg-gray-100 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 w-full py-2.5 px-4\"\n                placeholder=\"*********\"\n                required\n                value=\"\"\n               />\n            </div>\n            <div className=\"flex items-center justify-between mb-4\">\n              <button\n                type=\"submit\"\n                className=\"text-white bg-purple-600 hover:bg-purple-700 focus:ring-2 focus:ring-blue-300 font-medium rounded-lg text-sm py-2.5 px-5 w-full sm:w-auto\"\n              >\n                Submit\n              </button>\n              <div className=\"flex items-center text-sm\">\n                <p>New here?</p>\n                <p className=\"underline cursor-pointer ml-1\">Register</p>\n              </div>\n            </div>\n          </form>\n        </div>\n      </div>\n    </div>\n  )\n}\n\nexport { SignInBox }\n",
      "type": "registry:ui"
    }
  ],
  "meta": {
    "kind": "component",
    "tags": [
      "form"
    ],
    "rawHtml": "<div class=\"flex justify-center\">\n  <div class=\"w-96 backdrop-blur-lg bg-opacity-80 rounded-lg shadow-lg p-5 bg-gray-900 text-white\">\n    <h2 class=\"text-2xl font-bold pb-5\">Sign In</h2>\n    <form>\n      <div class=\"mb-4\">\n        <label for=\"email\" class=\"block mb-2 text-sm font-medium\">Your email</label>\n        <input\n          type=\"email\"\n          id=\"email\"\n          class=\"bg-gray-100 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 w-full py-2.5 px-4\"\n          placeholder=\"andrew@mail.com\"\n          required\n          value=\"\"\n        >\n      </div>\n      <div class=\"mb-4\">\n        <label for=\"password\" class=\"block mb-2 text-sm font-medium\">Your password</label>\n        <input\n          type=\"password\"\n          id=\"password\"\n          class=\"bg-gray-100 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 w-full py-2.5 px-4\"\n          placeholder=\"*********\"\n          required\n          value=\"\"\n        >\n      </div>\n      <div class=\"flex items-center justify-between mb-4\">\n        <button\n          type=\"submit\"\n          class=\"text-white bg-purple-600 hover:bg-purple-700 focus:ring-2 focus:ring-blue-300 font-medium rounded-lg text-sm py-2.5 px-5 w-full sm:w-auto\"\n        >\n          Submit\n        </button>\n        <div class=\"flex items-center text-sm\">\n          <p>New here?</p>\n          <p class=\"underline cursor-pointer ml-1\">Register</p>\n        </div>\n      </div>\n    </form>\n  </div>\n</div>"
  }
