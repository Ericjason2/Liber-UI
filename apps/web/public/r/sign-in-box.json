      "content": "/**\n * Component: Simple Sign-In Box\n * Author: @anja (https://tailwindflex.com/@anja)\n * Source: https://tailwindflex.com/@anja/sign-in-box\n * Attribution: Créé par @anja sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function SignInBox() {\n  return (\n    <div>\n    <div className=\"flex justify-center\">\n      <div className=\"w-96 backdrop-blur-lg bg-opacity-80 rounded-lg shadow-lg p-5 bg-gray-900 text-white\">\n        <h2 className=\"text-2xl font-bold pb-5\">Sign In</h2>\n        <form>\n          <div className=\"mb-4\">\n            <label htmlFor=\"email\" className=\"block mb-2 text-sm font-medium\">Your email</label>\n            <input\n              type=\"email\"\n              id=\"email\"\n              className=\"bg-gray-100 border border-gray-300 text-gray-900 text-sm rounded-lg focus2 focus500 focus500 w-full py-2.5 px-4\"\n              placeholder=\"andrew.com\"\n              required\n              value=\"\"\n             />\n          </div>\n          <div className=\"mb-4\">\n            <label htmlFor=\"password\" className=\"block mb-2 text-sm font-medium\">Your password</label>\n            <input\n              type=\"password\"\n              id=\"password\"\n              className=\"bg-gray-100 border border-gray-300 text-gray-900 text-sm rounded-lg focus2 focus500 focus500 w-full py-2.5 px-4\"\n              placeholder=\"*********\"\n              required\n              value=\"\"\n             />\n          </div>\n          <div className=\"flex items-center justify-between mb-4\">\n            <button\n              type=\"submit\"\n              className=\"text-white bg-purple-600 hover700 focus2 focus300 font-medium rounded-lg text-sm py-2.5 px-5 w-full sm\"\n            >\n              Submit\n            </button>\n            <div className=\"flex items-center text-sm\">\n              <p>New here?</p>\n              <p className=\"underline cursor-pointer ml-1\">Register</p>\n            </div>\n          </div>\n        </form>\n      </div>\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
  ],
