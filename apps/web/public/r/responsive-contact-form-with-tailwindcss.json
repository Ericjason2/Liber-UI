    "rawHtml": "<body class=\"flex justify-center items-center min-h-screen bg-gray-100\">\n\n    <div class=\"relative p-10 bg-white rounded-2xl shadow-lg max-w-lg w-full\">\n        <!-- Decorative Background -->\n        <div class=\"absolute inset-0 -z-10 transform rotate-6 bg-green-500 rounded-2xl\"></div>\n\n        <h2 class=\"text-xl font-semibold text-gray-800\">\n            <span class=\"text-green-600 font-bold\">Get Help?</span> Please Write Your Subject, Message & Notify Your Email.\n        </h2>\n\n        <form class=\"mt-5 space-y-4\">\n            <div>\n                <label class=\"block font-medium text-gray-700\">Full Name*</label>\n                <input type=\"text\" placeholder=\"Type Name\" class=\"w-full mt-1 p-3 border rounded-md focus:ring-2 focus:ring-green-500 outline-none\">\n            </div>\n            \n            <div>\n                <label class=\"block font-medium text-gray-700\">Email*</label>\n                <input type=\"email\" placeholder=\"Type Your Email\" class=\"w-full mt-1 p-3 border rounded-md focus:ring-2 focus:ring-green-500 outline-none\">\n            </div>\n\n            <div>\n                <label class=\"block font-medium text-gray-700\">Subject*</label>\n                <input type=\"text\" placeholder=\"Type Here\" class=\"w-full mt-1 p-3 border rounded-md focus:ring-2 focus:ring-green-500 outline-none\">\n            </div>\n\n            <div>\n                <label class=\"block font-medium text-gray-700\">Your Message*</label>\n                <textarea placeholder=\"Type Here\" rows=\"4\" class=\"w-full mt-1 p-3 border rounded-md focus:ring-2 focus:ring-green-500 outline-none\"></textarea>\n            </div>\n\n            <button type=\"submit\" class=\"w-full py-3 text-white bg-green-600 rounded-md hover:bg-green-700 transition\">\n                Send Message\n            </button>\n        </form>\n    </div>\n\n</body>"
  }
