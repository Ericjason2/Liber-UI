    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Aura Devs - Digital Products</title>\n    \n    <!-- Google Fonts: Bodoni Moda (Serif) & Inter (Sans-serif) -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,700;1,6..96,400&family=Inter:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n    \n    <!-- Tailwind CSS -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    \n    <!-- Tailwind Config for Custom Fonts and Colors -->\n    <script>\n        tailwind.config = {\n            theme: {\n                extend: {\n                    fontFamily: {\n                        sans: ['Inter', 'sans-serif'],\n                        serif: ['\"Bodoni Moda\"', 'serif'],\n                    },\n                    colors: {\n                        brand: {\n                            orange: '#FF3B00',\n                            green: '#00D47E',\n                            bg: '#FDFDFD',\n                            dark: '#0A0A0A'\n                        }\n                    }\n                }\n            }\n        }\n    </script>\n</head>\n<body class=\"bg-brand-bg text-brand-dark font-sans min-h-screen flex flex-col overflow-x-hidden selection:bg-brand-orange selection:text-white relative\">\n\n    <!-- Main Wrapper with reduced padding to create a very thin frame effect around the image -->\n    <main class=\"w-full max-w-[1920px] mx-auto p-1.5 md:p-2 lg:p-3 flex-grow flex flex-col\">\n        \n        <!-- Hero Image Container (Rounded Corners & Background) -->\n        <div class=\"relative w-full h-[65vh] md:h-[75vh] lg:h-[80vh] rounded-[1.5rem] md:rounded-[2.5rem] overflow-hidden bg-gray-200 bg-cover bg-center shadow-sm\" \n             style=\"background-image: url('https://pbs.twimg.com/media/G4Ytmb-a4AAcm6r?format=jpg&name=large');\">\n            \n            <!-- Header Bar (Positioned absolutely inside the image container) -->\n            <header class=\"absolute top-0 left-0 w-full px-6 md:px-10 py-6 md:py-8 flex justify-between items-center z-20\">\n                \n                <!-- Logo -->\n                <div class=\"text-brand-orange flex-shrink-0 cursor-pointer hover:scale-105 transition-transform\">\n                    <!-- Custom SVG mimicking the logo in the image -->\n                    <svg width=\"32\" height=\"32\" viewBox=\"0 0 40 40\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                        <path d=\"M12 28L20 12L25 22L19 32H12Z\" fill=\"currentColor\"/>\n                        <path d=\"M26 24L31 32H23L26 24Z\" fill=\"currentColor\"/>\n                    </svg>\n                </div>\n\n                <!-- Glassmorphism Navigation (Hidden on mobile, visible on lg) -->\n                <nav class=\"hidden lg:flex absolute left-1/2 -translate-x-1/2 items-center gap-8 bg-white/30 backdrop-blur-md border border-white/20 rounded-full px-10 py-3.5 text-[13px] font-medium text-gray-900 shadow-sm\">\n                    <a href=\"#\" class=\"flex items-center gap-1.5 hover:text-black transition-colors\">\n                        Services \n                        <svg class=\"w-3.5 h-3.5 mt-0.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\"></path></svg>\n                    </a>\n                    <a href=\"#\" class=\"hover:text-black transition-colors\">Projects</a>\n                    <a href=\"#\" class=\"hover:text-black transition-colors\">Testimonials</a>\n                    <a href=\"#\" class=\"hover:text-black transition-colors\">Team</a>\n                    <a href=\"#\" class=\"hover:text-black transition-colors\">Contact</a>\n                    <a href=\"#\" class=\"hover:text-black transition-colors\">Blogs</a>\n                </nav>\n\n                <!-- CTA Button -->\n                <button class=\"bg-brand-orange text-white px-7 py-3 rounded-full text-[13px] font-medium hover:bg-[#e03400] transition-colors shadow-lg flex-shrink-0\">\n                    Schedule call\n                </button>\n            </header>\n            \n            <!-- Subtle gradient overlay to ensure nav readability at the top -->\n            <div class=\"absolute inset-0 bg-gradient-to-b from-black/5 to-transparent pointer-events-none h-32\"></div>\n        </div>\n\n        <!-- Bottom Typography Section -->\n        <div class=\"relative flex-grow flex justify-between items-end md:items-center mt-6 md:mt-10 px-2 md:px-6 w-full pb-4\">\n            \n            <!-- Left Text: AURA -->\n            <h1 class=\"font-serif text-[5.5rem] md:text-[10rem] lg:text-[13rem] xl:text-[15rem] leading-[0.8] tracking-[-0.03em] uppercase text-brand-dark z-10\">\n                Aura\n            </h1>\n\n            <!-- Center Description (Absolutely positioned to stay dead center) -->\n            <div class=\"absolute left-1/2 -translate-x-1/2 bottom-6 md:bottom-auto w-full max-w-[280px] lg:max-w-[360px] text-center z-0 hidden sm:block\">\n                <p class=\"text-[0.6rem] lg:text-[0.65rem] tracking-[0.2em] lg:tracking-[0.25em] text-gray-500 uppercase leading-[1.8] font-medium\">\n                    We build digital products that reshape industries. From seed to scale, we are the architects of your growth.\n                </p>\n            </div>\n\n            <!-- Right Text: DEVS. -->\n            <h1 class=\"font-serif text-[5.5rem] md:text-[10rem] lg:text-[13rem] xl:text-[15rem] leading-[0.8] tracking-[-0.03em] uppercase text-brand-dark z-10\">\n                Devs.\n            </h1>\n\n        </div>\n    </main>\n\n    <!-- Floating Chat Widget (Bottom Right) -->\n    <button class=\"fixed bottom-6 right-6 md:bottom-8 md:right-8 bg-brand-green text-white w-14 h-14 md:w-16 md:h-16 rounded-full flex items-center justify-center shadow-2xl hover:scale-110 hover:shadow-brand-green/30 transition-all duration-300 z-50 group\">\n        <!-- Message Icon -->\n        <svg class=\"w-6 h-6 md:w-7 md:h-7 group-hover:animate-pulse\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.2\" d=\"M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z\"></path>\n        </svg>\n    </button>\n\n</body>\n</html>"
