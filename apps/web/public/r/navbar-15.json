p>\n                  <p class=\"text-[10px] text-slate-400\">Beli saldo kirim instan</p>\n                </div>\n              </a>\n              <a href=\"#\" class=\"flex items-center gap-3 p-2.5 rounded-xl hover:bg-emerald-50/70\">\n                <div class=\"w-8 h-8 rounded-lg bg-emerald-100 text-emerald-600 flex items-center justify-center text-xs font-black\">↓</div>\n                <div>\n                  <p class=\"text-xs font-bold text-slate-800\">Convert Saldo</p>\n                  <p class=\"text-[10px] text-slate-400\">Cairkan saldo ke Rupiah</p>\n                </div>\n              </a>\n              <a href=\"#\" class=\"flex items-center gap-3 p-2.5 rounded-xl hover:bg-purple-50/70\">\n                <div class=\"w-8 h-8 rounded-lg bg-purple-100 text-purple-600 flex items-center justify-center text-xs font-black\">💳</div>\n                <div>\n                  <p class=\"text-xs font-bold text-slate-800\">Jasa Bayar</p>\n                  <p class=\"text-[10px] text-slate-400\">Bayar belanja online luar</p>\n                </div>\n              </a>\n            </div>\n          </div>\n\n          <a href=\"#\" class=\"hover:text-blue-600 transition-colors\">Testimonial</a>\n          <a href=\"#\" class=\"hover:text-blue-600 transition-colors\">Blog</a>\n          <a href=\"#\" class=\"hover:text-blue-600 transition-colors\">Cek Invoice</a>\n        </nav>\n\n\n        <div class=\"hidden md:flex items-center\">\n          <a href=\"#\" class=\"px-5 py-2.5 rounded-xl bg-green-600 hover:bg-blue-700 text-white text-sm font-bold shadow-md shadow-green-500/25 active:scale-95 transition-all\">WhatsApp CS</a>\n        </div>\n\n        <!-- mobile -->\n        <div class=\"flex items-center md:hidden\">\n          <button type=\"button\" id=\"hamburgerBtn\" aria-label=\"Buka menu navigasi\" aria-expanded=\"false\" class=\"p-2 rounded-xl text-slate-600 hover:text-slate-900 hover:bg-slate-100 active:bg-slate-200 focus:outline-none transition-colors\">\n            <svg id=\"iconOpen\" class=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 6h16M4 12h16M4 18h16\"/></svg>\n            <svg id=\"iconClose\" class=\"w-6 h-6 hidden\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M6 18L18 6M6 6l12 12\"/></svg>\n          </button>\n        </div>\n\n      </div>\n    </div>\n\n    <div id=\"mobileDrawer\" class=\"hidden md:hidden border-t border-slate-200 bg-white px-4 pt-3 pb-6 shadow-2xl\">\n      <nav class=\"space-y-1 text-sm font-semibold text-slate-700\">\n\n        <a href=\"#\" class=\"flex items-center justify-between px-3 py-2.5 rounded-xl bg-blue-50 text-blue-600 font-bold\">\n          <span>Home</span>\n          <span class=\"w-2 h-2 rounded-full bg-blue-600\"></span>\n        </a>\n\n        <div>\n          <button type=\"button\" id=\"layananBtn\" class=\"w-full flex items-center justify-between px-3 py-2.5 rounded-xl hover:bg-slate-50 text-slate-700 transition-colors\">\n            <span>Layanan Kami</span>\n            <svg id=\"arrowLayanan\" class=\"w-4 h-4 text-slate-400 transition-transform duration-200\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\"/></svg>\n          </button>\n\n          <div id=\"submenuLayanan\" class=\"hidden pl-3 pr-1 py-1 space-y-1 bg-slate-50 rounded-xl my-1 border border-slate-100\">\n            <a href=\"#\" class=\"flex items-center gap-3 p-2 rounded-lg hover:bg-white text-xs font-bold text-slate-700\">\n              <span class=\"w-6 h-6 rounded-md bg-blue-100 text-blue-600 flex items-center justify-center text-[10px]\">↑</span>\n              <span>Top Up Saldo PayPal</span>\n            </a>\n            <a href=\"#\" class=\"flex items-center gap-3 p-2 rounded-lg hover:bg-white text-xs font-bold text-slate-700\">\n              <span class=\"w-6 h-6 rounded-md bg-emerald-100 text-emerald-600 flex items-center justify-center text-[10px]\">↓</span>\n              <span>Convert Saldo PayPal</span>\n            </a>\n            <a href=\"#\" class=\"flex items-center gap-3 p-2 rounded-lg hover:bg-white text-xs font-bold text-slate-700\">\n              <span class=\"w-6 h-6 rounded-md bg-purple-100 text-purple-600 flex items-center justify-center text-[10px]\">💳</span>\n              <span>Jasa Pembayaran Online</span>\n            </a>\n          </div>\n        </div>\n\n        <a href=\"#\" class=\"block px-3 py-2.5 rounded-xl hover:bg-slate-50 transition-colors\">Testimonial</a>\n        <a href=\"#\" class=\"block px-3 py-2.5 rounded-xl hover:bg-slate-50 transition-colors\">Blog</a>\n        <a href=\"#\" class=\"block px-3 py-2.5 rounded-xl hover:bg-slate-50 transition-colors\">Cek Status Invoice</a>\n\n        <div class=\"pt-4 mt-2 border-t border-slate-100\">\n          <a href=\"#\" class=\"w-full flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-green-600 hover:bg-green-700 text-white font-extrabold text-sm shadow-md shadow-blue-500/25 active:scale-95 transition\">\n            <span>Hubungi WhatsApp CS</span>\n          </a>\n        </div>\n\n      </nav>\n    </div>\n  </header>\n</div>\n\n<script>\n  const $ = (id) => document.getElementById(id);\n\n  const drawer = $('mobileDrawer');\n  const hamburger = $('hamburgerBtn');\n  const iconOpen = $('iconOpen');\n  const iconClose = $('iconClose');\n  const layananBtn = $('layananBtn');\n  const submenu = $('submenuLayanan');\n  const arrow = $('arrowLayanan');\n\n  hamburger.addEventListener('click', () => {\n    const opening = drawer.classList.contains('hidden');\n    drawer.classList.toggle('hidden', !opening);\n    iconOpen.classList.toggle('hidden', opening);\n    iconClose.classList.toggle('hidden', !opening);\n    hamburger.setAttribute('aria-expanded', String(opening));\n  });\n\n  layananBtn.addEventListener('click', () => {\n    const opening = submenu.classList.contains('hidden');\n    submenu.classList.toggle('hidden', !opening);\n    arrow.classList.toggle('rotate-180', opening);\n  });\n</script>"
