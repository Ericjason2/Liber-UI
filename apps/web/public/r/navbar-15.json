keWidth=\"2\" d=\"M19 9l-7 7-7-7\"/></svg>\n              </button>\n    \n              <div id=\"submenuLayanan\" className=\"hidden pl-3 pr-1 py-1 space-y-1 bg-slate-50 rounded-xl my-1 border border-slate-100\">\n                <a href=\"#\" className=\"flex items-center gap-3 p-2 rounded-lg hover text-xs font-bold text-slate-700\">\n                  <span className=\"w-6 h-6 rounded-md bg-blue-100 text-blue-600 flex items-center justify-center text-[10px]\">↑</span>\n                  <span>Top Up Saldo PayPal</span>\n                </a>\n                <a href=\"#\" className=\"flex items-center gap-3 p-2 rounded-lg hover text-xs font-bold text-slate-700\">\n                  <span className=\"w-6 h-6 rounded-md bg-emerald-100 text-emerald-600 flex items-center justify-center text-[10px]\">↓</span>\n                  <span>Convert Saldo PayPal</span>\n                </a>\n                <a href=\"#\" className=\"flex items-center gap-3 p-2 rounded-lg hover text-xs font-bold text-slate-700\">\n                  <span className=\"w-6 h-6 rounded-md bg-purple-100 text-purple-600 flex items-center justify-center text-[10px]\">💳</span>\n                  <span>Jasa Pembayaran Online</span>\n                </a>\n              </div>\n            </div>\n    \n            <a href=\"#\" className=\"block px-3 py-2.5 rounded-xl hover50 transition-colors\">Testimonial</a>\n            <a href=\"#\" className=\"block px-3 py-2.5 rounded-xl hover50 transition-colors\">Blog</a>\n            <a href=\"#\" className=\"block px-3 py-2.5 rounded-xl hover50 transition-colors\">Cek Status Invoice</a>\n    \n            <div className=\"pt-4 mt-2 border-t border-slate-100\">\n              <a href=\"#\" className=\"w-full flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-green-600 hover700 text-white font-extrabold text-sm shadow-md shadow-blue-500/25 active95 transition\">\n                <span>Hubungi WhatsApp CS</span>\n              </a>\n            </div>\n    \n          </nav>\n        </div>\n      </header>\n    </div>\n    \n    \n    </div>\n  );\n}\n",
