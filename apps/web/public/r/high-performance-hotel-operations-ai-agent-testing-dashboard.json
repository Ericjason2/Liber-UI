    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>AI Hotel Agent - Testing Dashboard</title>\n    <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n    <script src=\"https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4\"></script>\n    <script src=\"https://unpkg.com/lucide@latest/dist/umd/lucide.js\"></script>\n    <script src=\"https://cdn.jsdelivr.net/npm/chart.js\"></script>\n    <style type=\"text/tailwindcss\">\n        @theme inline {\n            --color-ai-primary: #8B5CF6;\n            --color-ai-secondary: #06B6D4;\n            --color-room-booked: #10B981;\n            --color-room-pending: #F59E0B;\n            --radius-neon: 24px;\n        }\n        body { font-family: 'Plus Jakarta Sans', sans-serif; background: #0F172A; color: #F8FAFC; }\n        .glass-card { background: rgba(30, 41, 59, 0.7); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.1); transition: all 0.3s ease; }\n        .glass-card:hover { border-color: var(--color-ai-primary); transform: translateY(-2px); }\n        .pulse-ai { animation: pulse 2s infinite; }\n        @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(139, 92, 246, 0.4); } 70% { box-shadow: 0 0 0 10px rgba(139, 92, 246, 0); } 100% { box-shadow: 0 0 0 0 rgba(139, 92, 246, 0); } }\n    </style>\n</head>\n<body class=\"min-h-screen overflow-x-hidden\">\n\n<div class=\"flex min-h-screen\">\n    <aside class=\"w-72 bg-slate-900 border-r border-slate-800 hidden lg:flex flex-col fixed h-full z-50\">\n        <div class=\"p-8\">\n            <a href=\"https://www.ayyamperumal.online/\" target=\"_blank\" class=\"flex items-center gap-3 group\">\n                <div class=\"w-12 h-12 bg-ai-primary rounded-xl flex items-center justify-center pulse-ai\">\n                    <i data-lucide=\"bot\" class=\"text-white\"></i>\n                </div>\n                <div>\n                    <h1 class=\"font-extrabold text-xl tracking-tight bg-gradient-to-r from-ai-primary to-ai-secondary bg-clip-text text-transparent\">AI-Inn Test</h1>\n                    <p class=\"text-[10px] text-slate-500 uppercase font-bold\">V 2.0.4 Stable</p>\n                </div>\n            </a>\n        </div>\n\n        <nav class=\"flex-1 px-6 space-y-2\">\n            <p class=\"text-slate-500 text-[10px] font-bold uppercase mb-4 px-4\">Management</p>\n            <a href=\"#\" class=\"flex items-center gap-3 px-4 py-3 bg-ai-primary/10 text-ai-primary rounded-neon font-semibold\">\n                <i data-lucide=\"layout-dashboard\" class=\"w-5 h-5\"></i> Dashboard\n            </a>\n            <a href=\"https://www.ayyamperumal.online/\" target=\"_blank\" class=\"flex items-center gap-3 px-4 py-3 text-slate-400 hover:text-white transition-all group\">\n                <i data-lucide=\"cpu\" class=\"w-5 h-5 group-hover:rotate-12 transition-transform\"></i> Agent Training\n            </a>\n            <a href=\"#\" class=\"flex items-center gap-3 px-4 py-3 text-slate-400 hover:text-white transition-all\">\n                <i data-lucide=\"bed\" class=\"w-5 h-5\"></i> Live Occupancy\n            </a>\n            <div class=\"pt-8\">\n                <p class=\"text-slate-500 text-[10px] font-bold uppercase mb-4 px-4\">Diagnostics</p>\n                <a href=\"#\" class=\"flex items-center gap-3 px-4 py-3 text-slate-400 hover:text-white transition-all\">\n                    <i data-lucide=\"terminal\" class=\"w-5 h-5\"></i> Raw Logs\n                </a>\n            </div>\n        </nav>\n\n        <div class=\"p-6 border-t border-slate-800\">\n            <a href=\"https://www.ayyamperumal.online/\" target=\"_blank\" class=\"flex items-center gap-3 p-3 rounded-2xl hover:bg-slate-800 transition-colors\">\n                <img src=\"https://images.unsplash.com/photo-1568602471122-7832951cc4c5?w=100&h=100&fit=crop\" class=\"w-10 h-10 rounded-full border-2 border-ai-primary p-0.5\">\n                <div class=\"overflow-hidden\">\n                    <p class=\"text-sm font-bold truncate\">Ayyamperumal</p>\n                    <p class=\"text-xs text-slate-500 truncate\">Lead Engineer</p>\n                </div>\n            </a>\n        </div>\n    </aside>\n\n    <main class=\"flex-1 lg:ml-72 p-6 md:p-10\">\n        <header class=\"flex flex-col md:flex-row justify-between items-start md:items-center gap-6 mb-12\">\n            <div>\n                <h2 class=\"text-4xl font-black text-white mb-2\">System <span class=\"text-ai-primary\">Overview</span></h2>\n                <div class=\"flex items-center gap-2 text-slate-400\">\n                    <span class=\"w-2 h-2 rounded-full bg-room-booked animate-ping\"></span>\n                    <p id=\"live-status\">AI Agents: 12 Active | Region: Bengaluru</p>\n                </div>\n            </div>\n            <div class=\"flex gap-3\">\n                <button onclick=\"window.open('https://www.ayyamperumal.online/', '_blank')\" class=\"px-6 py-3 bg-white text-slate-900 font-bold rounded-neon hover:scale-105 transition-transform flex items-center gap-2 shadow-lg shadow-white/10\">\n                    <i data-lucide=\"external-link\" class=\"w-4 h-4\"></i> View Portfolio\n                </button>\n                <button onclick=\"refreshData()\" class=\"p-3 glass-card rounded-neon hover:text-ai-primary\">\n                    <i data-lucide=\"refresh-cw\" class=\"w-5 h-5\"></i>\n                </button>\n            </div>\n        </header>\n\n        <div id=\"stats-container\" class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-10\">\n            </div>\n\n        <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-8 mb-10\">\n            <div class=\"lg:col-span-2 glass-card p-8 rounded-neon\">\n                <div class=\"flex justify-between items-center mb-8\">\n                    <h3 class=\"text-xl font-bold flex items-center gap-2\">\n                        <i data-lucide=\"activity\" class=\"text-ai-secondary\"></i> Agent Accuracy vs Load\n                    </h3>\n                    <select class=\"bg-slate-800 border-none rounded-lg px-3 py-1 text-xs outline-none\">\n                        <option>Last 24 Hours</option>\n                        <option>Real-time</option>\n                    </select>\n                </div>\n                <div class=\"h-80\">\n                    <canvas id=\"agentAccuracyChart\"></canvas>\n                </div>\n            </div>\n\n            <div class=\"glass-card p-6 rounded-neon flex flex-col\">\n                <h3 class=\"text-xl font-bold mb-6 flex items-center gap-2\">\n                    <i data-lucide=\"message-square\" class=\"text-ai-primary\"></i> Live Test Feed\n                </h3>\n                <div id=\"terminal-feed\" class=\"flex-1 space-y-4 font-mono text-xs overflow-y-auto max-h-80 scrollbar-hide\">\n                    </div>\n            </div>\n        </div>\n\n        <div class=\"glass-card rounded-neon overflow-hidden\">\n            <div class=\"p-8 border-b border-slate-800 flex justify-between items-center\">\n                <h3 class=\"text-xl font-bold italic\">Hotel Inventory & Agent Handling</h3>\n                <span class=\"px-4 py-1 bg-ai-secondary/20 text-ai-secondary text-xs rounded-full font-bold\">Auto-Syncing</span>\n            </div>\n            <div class=\"overflow-x-auto\">\n                <table class=\"w-full text-left\">\n                    <thead class=\"bg-slate-800/50 text-slate-400 text-xs uppercase\">\n                        <tr>\n                            <th class=\"px-8 py-4\">Room Type</th>\n                            <th class=\"px-8 py-4\">Occupancy</th>\n                            <th class=\"px-8 py-4\">Agent Assigned</th>\n                            <th class=\"px-8 py-4\">Revenue</th>\n                            <th class=\"px-8 py-4\">Action</th>\n                        </tr>\n                    </thead>\n                    <tbody id=\"inventory-body\" class=\"text-sm\">\n                        </tbody>\n                </table>\n            </div>\n        </div>\n\n        <footer class=\"mt-12 text-center text-slate-600\">\n            <p>© 2026 Core Intelligence Layer. Developed by <a href=\"https://www.ayyamperumal.online/\" target=\"_blank\" class=\"text-ai-primary hover:underline\">Ayyamperumal</a></p>\n        </footer>\n    </main>\n</div>\n\n<script>\n    // Centralized JSON-like Data Structure\n    const DASHBOARD_DATA = {\n        metrics: [\n            { label: 'Room Occupancy', value: '84%', icon: 'bed', color: 'bg-indigo-500', trend: '+4% vs yesterday' },\n            { label: 'AI Resolution', value: '98.2%', icon: 'shield-check', color: 'bg-ai-primary', trend: 'Optimal Range' },\n            { label: 'Avg Latency', value: '1.2s', icon: 'zap', color: 'bg-ai-secondary', trend: '-200ms improvement' },\n            { label: 'Net Revenue', value: '₹1.2M', icon: 'indian-rupee', color: 'bg-room-booked', trend: 'On track' }\n        ],\n        inventory: [\n            { type: 'Luxury Suite', booked: 12, total: 15, agent: 'Artemis-7', revenue: '₹45,000' },\n            { type: 'Deluxe Queen', booked: 45, total: 50, agent: 'Zeus-1', revenue: '₹82,000' },\n            { type: 'Executive Hub', booked: 8, total: 10, agent: 'Athena-X', revenue: '₹31,500' },\n            { type: 'Standard Solo', booked: 102, total: 120, agent: 'Atlas-Beta', revenue: '₹95,000' }\n        ],\n        logs: [\n            { time: '23:14:02', user: 'Guest_291', msg: 'Requested room service via AI', status: 'SUCCESS' },\n            { time: '23:15:45', user: 'Bot_Delta', msg: 'Adjusting HVAC in Room 402', status: 'ACTIVE' },\n            { time: '23:16:10', user: 'Guest_112', msg: 'Extended checkout query', status: 'PENDING' },\n            { time: '23:16:55', user: 'Admin', msg: 'Updated agent temperature threshold', status: 'SYS_UPDATE' }\n        ]\n    };\n\n    function initializeUI() {\n        lucide.createIcons();\n        renderStats();\n        renderInventory();\n        renderLogs();\n        initChart();\n    }\n\n    function renderStats() {\n        const container = document.getElementById('stats-container');\n        container.innerHTML = DASHBOARD_DATA.metrics.map(stat => `\n            <div class=\"glass-card p-6 rounded-neon\">\n                <div class=\"flex justify-between items-start mb-4\">\n                    <div class=\"p-3 rounded-2xl ${stat.color} shadow-lg\">\n                        <i data-lucide=\"${stat.icon}\" class=\"text-white w-6 h-6\"></i>\n                    </div>\n                    <span class=\"text-[10px] font-black text-slate-500 uppercase tracking-widest\">Live Data</span>\n                </div>\n                <h4 class=\"text-slate-400 text-sm font-medium\">${stat.label}</h4>\n                <div class=\"flex items-baseline gap-2\">\n                    <p class=\"text-3xl font-black text-white\">${stat.value}</p>\n                    <span class=\"text-xs text-room-booked font-bold\">${stat.trend}</span>\n                </div>\n            </div>\n        `).join('');\n        lucide.createIcons();\n    }\n\n    function renderInventory() {\n        const body = document.getElementById('inventory-body');\n        body.innerHTML = DASHBOARD_DATA.inventory.map(item => {\n            const perc = (item.booked / item.total) * 100;\n            return `\n                <tr class=\"border-t border-slate-800/50 hover:bg-slate-800/20 transition-colors\">\n                    <td class=\"px-8 py-5 font-bold\">${item.type}</td>\n                    <td class=\"px-8 py-5\">\n                        <div class=\"w-full bg-slate-700 h-1.5 rounded-full mt-2 overflow-hidden\">\n                            <div class=\"bg-ai-secondary h-full\" style=\"width: ${perc}%\"></div>\n                        </div>\n                        <p class=\"text-[10px] text-slate-500 mt-1\">${item.booked}/${item.total} Rooms Filled</p>\n                    </td>\n                    <td class=\"px-8 py-5\">\n                        <span class=\"px-3 py-1 bg-slate-800 rounded-lg text-xs font-mono text-ai-primary border border-ai-primary/20\">${item.agent}</span>\n                    </td>\n                    <td class=\"px-8 py-5 font-bold text-white\">${item.revenue}</td>\n                    <td class=\"px-8 py-5\">\n                        <button onclick=\"window.location.href='https://www.ayyamperumal.online/'\" class=\"text-slate-500 hover:text-white transition-colors cursor-pointer\">\n                            <i data-lucide=\"settings-2\" class=\"w-4 h-4\"></i>\n                        </button>\n                    </td>\n                </tr>\n            `;\n        }).join('');\n        lucide.createIcons();\n    }\n\n    function renderLogs() {\n        const feed = document.getElementById('terminal-feed');\n        feed.innerHTML = DASHBOARD_DATA.logs.map(log => `\n            <div class=\"flex gap-3\">\n                <span class=\"text-slate-600 shrink-0\">[${log.time}]</span>\n                <span class=\"text-ai-secondary shrink-0\">${log.user}:</span>\n                <span class=\"text-slate-300 italic\">${log.msg}</span>\n                <span class=\"ml-auto text-[10px] ${log.status === 'SUCCESS' ? 'text-room-booked' : 'text-ai-primary'}\">${log.status}</span>\n            </div>\n        `).join('');\n    }\n\n    function initChart() {\n        const ctx = document.getElementById('agentAccuracyChart').getContext('2d');\n        const gradient = ctx.createLinearGradient(0, 0, 0, 400);\n        gradient.addColorStop(0, 'rgba(139, 92, 246, 0.5)');\n        gradient.addColorStop(1, 'rgba(139, 92, 246, 0)');\n\n        new Chart(ctx, {\n            type: 'line',\n            data: {\n                labels: ['10:00', '12:00', '14:00', '16:00', '18:00', '20:00', '22:00'],\n                datasets: [{\n                    label: 'Success Rate (%)',\n                    data: [94, 98, 97, 99, 95, 98, 99],\n                    borderColor: '#8B5CF6',\n                    backgroundColor: gradient,\n                    fill: true,\n                    tension: 0.4,\n                    pointRadius: 6,\n                    pointBackgroundColor: '#fff',\n                    pointBorderColor: '#8B5CF6',\n                    pointBorderWidth: 3\n                }]\n            },\n            options: {\n                responsive: true,\n                maintainAspectRatio: false,\n                plugins: { legend: { display: false } },\n                scales: {\n                    y: { grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { color: '#64748b' } },\n                    x: { grid: { display: false }, ticks: { color: '#64748b' } }\n                }\n            }\n        });\n    }\n\n    function refreshData() {\n        const btn = document.querySelector('button i[data-lucide=\"refresh-cw\"]');\n        btn.classList.add('animate-spin');\n        setTimeout(() => {\n            btn.classList.remove('animate-spin');\n            renderLogs();\n        }, 800);\n    }\n\n    document.addEventListener('DOMContentLoaded', initializeUI);\n</script>\n</body>\n</html>"
  }
}
