iv>\\n                \\n                <!-- Mobile menu button -->\\n                <div class=\\\"md:hidden\\\">\\n                    <button class=\\\"text-white focus:outline-none\\\">\\n                        <svg class=\\\"w-6 h-6\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n                            <path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" stroke-width=\\\"2\\\" d=\\\"M4 6h16M4 12h16M4 18h16\\\"></path>\\n                        </svg>\\n                    </button>\\n                </div>\\n            </div>\\n        </div>\\n    </nav>\\n\\n    <!-- Hero Section -->\\n    <section class=\\\"relative hero-pattern h-screen flex items-center justify-center overflow-hidden pt-16\\\">\\n        <!-- Decorative elements -->\\n        <div class=\\\"absolute inset-0 overflow-hidden\\\">\\n            <!-- Musical note decorations -->\\n            <div class=\\\"absolute top-1/4 left-1/6 text-white opacity-20 transform -rotate-12 animate-float\\\">\\n                <svg xmlns=\\\"http://www.w3.org/2000/svg\\\" class=\\\"h-16 w-16\\\" fill=\\\"currentColor\\\" viewBox=\\\"0 0 20 20\\\">\\n                    <path d=\\\"M18 3a1 1 0 00-1.447-.894L8.763 6H5a5 5 0 000 10h6.8l7.553 3.894A1 1 0 0020 17V3z\\\"/>\\n                </svg>\\n            </div>\\n            <div class=\\\"absolute top-1/3 right-1/5 text-white opacity-30 transform rotate-6 animate-float\\\" style=\\\"animation-delay: 1s;\\\">\\n                <svg xmlns=\\\"http://www.w3.org/2000/svg\\\" class=\\\"h-20 w-20\\\" fill=\\\"currentColor\\\" viewBox=\\\"0 0 20 20\\\">\\n                    <path d=\\\"M18 3a1 1 0 00-1.447-.894L8.763 6H5a5 5 0 000 10h6.8l7.553 3.894A1 1 0 0020 17V3z\\\"/>\\n                </svg>\\n            </div>\\n            <div class=\\\"absolute bottom-1/4 right-1/6 text-white opacity-25 transform rotate-45 animate-float\\\" style=\\\"animation-delay: 2s;\\\">\\n                <svg xmlns=\\\"http://www.w3.org/2000/svg\\\" class=\\\"h-12 w-12\\\" fill=\\\"currentColor\\\" viewBox=\\\"0 0 20 20\\\">\\n                    <path d=\\\"M18 3a1 1 0 00-1.447-.894L8.763 6H5a5 5 0 000 10h6.8l7.553 3.894A1 1 0 0020 17V3z\\\"/>\\n                </svg>\\n            </div>\\n            \\n            <!-- Subtle grid pattern -->\\n            <div class=\\\"absolute inset-0 opacity-10\\\" style=\\\"background-image: linear-gradient(to right, rgba(255,255,255,0.3) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,0.3) 1px, transparent 1px); background-size: 40px 40px;\\\"></div>\\n        </div>\\n        \\n        <!-- Main content container -->\\n        <div class=\\\"relative z-10 container mx-auto px-6 py-16 md:py-24 lg:py-32 xl:py-40\\\">\\n            <div class=\\\"flex flex-col lg:flex-row items-center justify-between\\\">\\n                <!-- Text content -->\\n                <div class=\\\"w-full lg:w-1/2 mb-12 lg:mb-0 lg:pr-12\\\">\\n                    <h1 class=\\\"text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-serif font-bold leading-tight mb-6 text-white\\\">\\n                        <span class=\\\"text-gradient animate-text-shine\\\">Preserving the Soul</span>\\n                        <span class=\\\"block\\\">of Our Ancestors</span>\\n                    </h1>\\n                    <p class=\\\"text-lg md:text-xl text-gray-200 mb-8 max-w-lg font-sans leading-relaxed\\\">\\n                        Explore the rich tapestry of traditional music from around the globe. Each note carries centuries of history, culture, and the unbreakable spirit of humanity.\\n                    </p>\\n                    <div class=\\\"flex flex-col sm:flex-row space-y-4 sm:space-y-0 sm:space-x-4\\\">\\n                        <button class=\\\"px-8 py-3 bg-white text-red-800 font-bold rounded-full transform hover:scale-105 transition-all duration-300 hover:shadow-lg hover:shadow-red-900/30 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-red-900\\\">\\n                            Discover Sounds\\n                        </button>\\n                        <button class=\\\"px-8 py-3 border-2 border-white text-white font-bold rounded-full transform hover:scale-105 transition-all duration-300 hover:bg-white hover:bg-opacity-10 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-red-900\\\">\\n                            Learn History\\n                        </button>\\n                    </div>\\n                </div>\\n                \\n                <!-- Instrument image -->\\n                <div class=\\\"w-full lg:w-1/2 mt-12 lg:mt-0 relative\\\">\\n                    <div class=\\\"relative instrument-shadow\\\">\\n                        <!-- Image container with red background -->\\n                        <div class=\\\"relative overflow-hidden rounded-2xl  h-80 md:h-96 lg:h-[32rem] xl:h-[36rem] flex items-center justify-center\\\">\\n                            <!-- The specified image from MidJourney -->\\n                            <img src=\\\"https://cdn.midjourney.com/94f9a257-505f-4196-92cf-8875a0783393/0_2.png\\\" \\n                                 alt=\\\"Traditional musical instruments\\\" \\n                                 class=\\\"absolute inset-0 w-full h-full object-cover object-center opacity-100 mix-blend-multiply\\\">\\n                            \\n                            \\n                            \\n                            <!-- Floating instrument images -->\\n                            <div class=\\\"absolute top-1/4 left-1/4 w-16 h-16 bg-red-800 rounded-full animate-pulse-slow opacity-70\\\"></div>\\n                            <div class=\\\"absolute bottom-1/3 right-1/4 w-12 h-12 bg-red-700 rounded-full animate-pulse-slow opacity-80\\\" style=\\\"animation-delay: 1s;\\\"></div>\\n                            <div class=\\\"absolute top-1/3 right-1/3 w-10 h-10 bg-red-600 rounded-full animate-pulse-slow\\\" style=\\\"animation-delay: 2s;\\\"></div>\\n                            \\n                            <!-- Overlay text -->\\n                            <div class=\\\"absolute bottom-8 left-0 right-0 text-center\\\">\\n                                <span class=\\\"inline-block px-4 py-2 bg-black bg-opacity-50 text-white text-sm font-mono tracking-widest rounded-full\\\">\\n                                    WORLD MUSIC HERITAGE\\n                                </span>\\n                            </div>\\n                        </div>\\n                        \\n                        <!-- Decorative border elements -->\\n                        <div class=\\\"absolute -top-4 -left-4 w-16 h-16 border-t-4 border-l-4 border-red-300 opacity-80\\\"></div>\\n                        <div class=\\\"absolute -bottom-4 -right-4 w-16 h-16 border-b-4 border-r-4 border-red-300 opacity-80\\\"></div>\\n                    </div>\\n                </div>\\n            </div>\\n        </div>\\n        \\n        <!-- Scrolling indicator -->\\n        <div class=\\\"absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce\\\">\\n            <svg class=\\\"w-8 h-8 text-white opacity-70\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\">\\n                <path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" stroke-width=\\\"2\\\" d=\\\"M19 14l-7 7m0 0l-7-7m7 7V3\\\"></path>\\n            </svg>\\n        </div>\\n    </section>\\n    \\n    <!-- Additional sections would go here -->\\n</body>\\n</html>\" }} />\n  );\n}\n",
