nded-l border text-gray-600 hover100 active200 disabled50 inline-flex items-center px-2 py-1 border-r border-gray-200\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"h-6 w-4\" fill=\"none\" viewBox=\"0 0 24 24\"\n                        stroke=\"currentColor\">\n                        <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"M20 12H4\" />\n                    </svg>\n                </button>\n                <div\n                    className=\"bg-gray-100 border-t border-b border-gray-100 text-gray-600 hover100 inline-flex items-center px-4 py-1 select-none\">\n                    2\n                </div>\n                <button\n                    className=\"bg-white rounded-r border text-gray-600 hover100 active200 disabled50 inline-flex items-center px-2 py-1 border-r border-gray-200\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"h-6 w-4\" fill=\"none\" viewBox=\"0 0 24 24\"\n                        stroke=\"currentColor\">\n                        <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"M12 4v16m8-8H4\" />\n                    </svg>\n                </button>\n            </div>\n    \n            <button\n                className=\"py-2 px-4 bg-blue-500 text-white rounded hover600 active700 disabled50 mt-4 w-full flex items-center justify-center\">\n                Add to order\n                <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"h-6 w-6 ml-2\" fill=\"none\" viewBox=\"0 0 24 24\"\n                    stroke=\"currentColor\">\n                    <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\"\n                        d=\"M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z\" />\n                </svg>\n            </button>\n        </div>\n    </div>\n    </div>\n  );\n}\n",
