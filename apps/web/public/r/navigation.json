-medium text-sm rounded-md\\\" aria-current=\\\"page\\\"\\n            x-state-description=\\\"undefined: &quot;bg-gray-100 text-gray-700&quot;, undefined: &quot;text-gray-500 hover:text-gray-700&quot;\\\">Team\\n            Members</a>\\n\\n          <a href=\\\"#\\\" class=\\\"text-gray-500 hover:bg-gray-100 text-gray-700 px-3 py-2 font-medium text-sm rounded-md\\\"\\n            x-state-description=\\\"undefined: &quot;bg-gray-100 text-gray-700&quot;, undefined: &quot;text-gray-500 hover:text-gray-700&quot;\\\">Billing</a>\\n\\n        </nav>\\n      </div>\\n    </div>\\n\\n  </div>\\n</div>\" }} />\n  );\n}\n",
