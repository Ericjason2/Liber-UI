y&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w0NzEyNjZ8MHwxfHNlYXJjaHwxMnx8c2VydmljZXxlbnwwfDB8fHwxNzEyMjIyNjQ3fDA&ixlib=rb-4.0.3&q=80&w=1080\"\n                alt=\"\" />\n        </div>\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
