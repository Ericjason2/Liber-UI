      "path": "ui/hero-with-button.tsx",
      "content": "/**\n * Component: Hero with button\n * Author: @laurits (https://tailwindflex.com/@laurits)\n * Source: https://tailwindflex.com/@laurits/hero-with-button\n * Attribution: Créé par @laurits sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function HeroWithButton() {\n  return (\n    <div>\n    <section className=\"py-8 sm16 md24 flex items-center justify-center\">\r\n        <div className=\"mx-auto max-w-[43rem]\">\r\n            <div className=\"text-center\">\r\n                <p className=\"text-lg font-medium leading-8 text-gray-500\">Get your tasks done</p>\r\n                <h1\r\n                    className=\"my-3 sm4 md8 text-3xl sm4xl md5xl lg6xl font-bold leading-10 tracking-tight text-black\">\r\n                    Productivity tool for\r\n                    <span className=\"text-blue-700\">Devs</span>\r\n                </h1>\r\n                <p className=\"text-lg leading-relaxed text-slate-500\">We help you streamline your workflow by planning,\r\n                    time-boxing and executing one task at a time.\r\n                </p>\r\n            </div>\r\n            <div className=\"mt-6 flex items-center justify-center gap-4\">\r\n                <button\r\n                    className=\"inline-block px-6 py-2.5 bg-blue-500 text-white font-medium text-xl leading-tight hover600 cursor-pointer hover focus600 focus focus focus0 active700 active disabled25 transition duration-150 disabled ease-in-out\">\r\n                    Get started!\r\n                </button>\r\n            </div>\r\n        </div>\r\n    </section>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
  ],
