      "content": "/**\n * Component: Futuristic 3D Tilt Card\n * Author: @anonymous (https://tailwindflex.com/@anonymous)\n * Source: https://tailwindflex.com/@anonymous/futuristic-3d-tilt-card-2\n * Attribution: Créé par @anonymous sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function Futuristic3dTiltCard2() {\n  return (\n    <div>\n    <div className=\"bg-gray-900 h-screen flex items-center justify-center overflow-hidden\">\n        <div\n            className=\"tilt-card w-80 h-96 bg-gradient-to-br from-purple-700 to-pink-500 rounded-2xl shadow-2xl relative cursor-pointer transition-all duration-300 ease-out hover100\">\n            <div className=\"glow opacity-0 transition-opacity duration-300\"></div>\n            <div className=\"p-6 flex flex-col h-full justify-between relative z-10\">\n                <div>\n                    <h2 className=\"text-3xl font-bold text-white mb-2\">Quantum Leap</h2>\n                    <p className=\"text-gray-200\">Experience the future of technology with our revolutionary quantum computing\n                        solution.</p>\n                </div>\n                <div className=\"space-y-4\">\n                    <div className=\"bg-white bg-opacity-20 rounded-lg p-3\">\n                        <div className=\"text-xs text-gray-300 uppercase\">Processing Power</div>\n                        <div className=\"text-2xl font-bold text-white\">100 Qubits</div>\n                    </div>\n                    <button className=\"w-full py-2 bg-white text-purple-700 rounded-lg font-semibold transform transition hover100 active100\">\n                        Explore Now\n                    </button>\n                </div>\n            </div>\n        </div>\n    \n        \n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
  ],
