      "content": "/**\n * Component: Multi-Step Form Wizard\n * Author: @quentin (https://tailwindflex.com/@quentin)\n * Source: https://tailwindflex.com/@quentin/multi-step-form-wizard\n * Attribution: Créé par @quentin sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function MultiStepFormWizard() {\n  return (\n    <div>\n    <div className=\"bg-gray-100 min-h-screen flex items-center justify-center\">\n      <div className=\"container mx-auto p-4\">\n        <div className=\"bg-white rounded-lg shadow-lg p-6 md10 max-w-3xl mx-auto\">\n          <h1 className=\"text-3xl font-bold text-center mb-8\">Account Setup Wizard</h1>\n    \n          \n          <div className=\"mb-8\">\n            <div className=\"flex justify-between mb-2\">\n              <span className=\"text-xs font-semibold inline-block py-1 px-2 uppercase rounded-full text-green-600 bg-green-200\" id=\"step1\">\n                            Personal Info\n                        </span>\n              <span className=\"text-xs font-semibold inline-block py-1 px-2 uppercase rounded-full text-green-600 bg-green-200 opacity-50\" id=\"step2\">\n                            Account Details\n                        </span>\n              <span className=\"text-xs font-semibold inline-block py-1 px-2 uppercase rounded-full text-green-600 bg-green-200 opacity-50\" id=\"step3\">\n                            Preferences\n                        </span>\n            </div>\n            <div className=\"overflow-hidden h-2 mb-4 text-xs flex rounded bg-green-200\">\n              <div id=\"progress-bar\"\n                className=\"shadow-none flex flex-col text-center whitespace-nowrap text-white justify-center bg-green-500 w-1/3 transition-all duration-500 ease-in-out\">\n              </div>\n            </div>\n          </div>\n    \n          \n          <form id=\"multi-step-form\">\n            \n            <div id=\"step-1\" className=\"step\">\n              <div className=\"mb-6\">\n                <label htmlFor=\"fullName\" className=\"block mb-2 text-sm font-medium text-gray-900\">Full Name</label>\n                <input type=\"text\" id=\"fullName\" className=\"bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus500 focus500 block w-full p-2.5\" required />\n              </div>\n              <div className=\"mb-6\">\n                <label htmlFor=\"email\" className=\"block mb-2 text-sm font-medium text-gray-900\">Email Address</label>\n                <input type=\"email\" id=\"email\" className=\"bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus500 focus500 block w-full p-2.5\" required />\n              </div>\n              <div className=\"mb-6\">\n                <label htmlFor=\"phone\" className=\"block mb-2 text-sm font-medium text-gray-900\">Phone Number</label>\n                <input type=\"tel\" id=\"phone\" className=\"bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus500 focus500 block w-full p-2.5\" required />\n              </div>\n            </div>\n    \n            \n            <div id=\"step-2\" className=\"step hidden\">\n              <div className=\"mb-6\">\n                <label htmlFor=\"username\" className=\"block mb-2 text-sm font-medium text-gray-900\">Username</label>\n                <input type=\"text\" id=\"username\" className=\"bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus500 focus500 block w-full p-2.5\" required />\n              </div>\n              <div className=\"mb-6\">\n                <label htmlFor=\"password\" className=\"block mb-2 text-sm font-medium text-gray-900\">Password</label>\n                <input type=\"password\" id=\"password\" className=\"bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus500 focus500 block w-full p-2.5\" required />\n              </div>\n              <div className=\"mb-6\">\n                <label htmlFor=\"confirmPassword\" className=\"block mb-2 text-sm font-medium text-gray-900\">Confirm Password</label>\n                <input type=\"password\" id=\"confirmPassword\" className=\"bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus500 focus500 block w-full p-2.5\" required />\n              </div>\n            </div>\n    \n            \n            <div id=\"step-3\" className=\"step hidden\">\n              <div className=\"mb-6\">\n                <label className=\"block mb-2 text-sm font-medium text-gray-900\">Preferred Contact Method</label>\n                <div className=\"flex items-center mb-4\">\n                  <input id=\"contact-email\" type=\"radio\" name=\"contact\" value=\"email\" className=\"w-4 h-4 text-green-600 bg-gray-100 border-gray-300 focus500 focus2\" />\n                  <label htmlFor=\"contact-email\" className=\"ml-2 text-sm font-medium text-gray-900\">Email</label>\n                </div>\n                <div className=\"flex items-center\">\n                  <input id=\"contact-phone\" type=\"radio\" name=\"contact\" value=\"phone\" className=\"w-4 h-4 text-green-600 bg-gray-100 border-gray-300 focus500 focus2\" />\n                  <label htmlFor=\"contact-phone\" className=\"ml-2 text-sm font-medium text-gray-900\">Phone</label>\n                </div>\n              </div>\n              <div className=\"mb-6\">\n                <label htmlFor=\"interests\" className=\"block mb-2 text-sm font-medium text-gray-900\">Interests (select all that apply)</label>\n                <select id=\"interests\" multiple className=\"bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus500 focus500 block w-full p-2.5\">\n                                <option value=\"technology\">Technology</option>\n                                <option value=\"finance\">Finance</option>\n                                <option value=\"health\">Health & Wellness</option>\n                                <option value=\"travel\">Travel</option>\n                                <option value=\"food\">Food & Cooking</option>\n                            </select>\n              </div>\n              <div className=\"flex items-center mb-6\">\n                <input id=\"newsletter\" type=\"checkbox\" className=\"w-4 h-4 text-green-600 bg-gray-100 border-gray-300 rounded focus500\" />\n                <label htmlFor=\"newsletter\" className=\"ml-2 text-sm font-medium text-gray-900\">Subscribe to newsletter</label>\n              </div>\n            </div>\n    \n            \n            <div className=\"flex justify-between mt-8\">\n              <button type=\"button\" id=\"prevBtn\" className=\"px-4 py-2 bg-gray-300 text-gray-800 rounded-lg hover400 focus focus hidden\">Previous</button>\n              <button type=\"button\" id=\"nextBtn\" className=\"px-4 py-2 bg-green-500 text-white rounded-lg hover600 focus focus\">Next</button>\n              <button type=\"submit\" id=\"submitBtn\" className=\"px-4 py-2 bg-green-500 text-white rounded-lg hover600 focus focus hidden\">Submit</button>\n            </div>\n          </form>\n        </div>\n      </div>\n    </div>\n    \n    \n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
  ],
