t-xs font-semibold text-white\">UI/UX</span>\n                  <span className=\"rounded-full bg-purple-600 px-3 py-1 text-xs font-semibold text-white\">Figma</span>\n                </div>\n                <a href=\"#\" className=\"mt-4 inline-flex items-center text-white transition-colors hover300\">\n                  View Project\n                  <i className=\"fas fa-arrow-right ml-2\"></i>\n                </a>\n              </div>\n            </div>\n          </div>\n    \n          \n          <div className=\"group relative overflow-hidden rounded-xl shadow-lg transition-all duration-300 hover\">\n            <div className=\"h-64 overflow-hidden\">\n              <img src=\"https://placehold.co/600x400\" alt=\"Mobile App Project\" className=\"h-full w-full object-cover transition-transform duration-500 group-hover110\" />\n            </div>\n            <div className=\"absolute inset-0 flex items-end bg-gradient-to-t from-gray-900 to-transparent p-6 opacity-0 transition-opacity duration-300 group-hover90\">\n              <div className=\"translate-y-8 transform transition-transform duration-300 group-hover0\">\n                <h3 className=\"text-2xl font-bold text-white\">Fitness Mobile App</h3>\n                <p className=\"mt-2 text-gray-300\">Cross-platform fitness tracking application with social features.</p>\n                <div className=\"mt-4 flex space-x-2\">\n                  <span className=\"rounded-full bg-green-600 px-3 py-1 text-xs font-semibold text-white\">React Native</span>\n                  <span className=\"rounded-full bg-red-600 px-3 py-1 text-xs font-semibold text-white\">Health</span>\n                </div>\n                <a href=\"#\" className=\"mt-4 inline-flex items-center text-white transition-colors hover300\">\n                  View Project\n                  <i className=\"fas fa-arrow-right ml-2\"></i>\n                </a>\n              </div>\n            </div>\n          </div>\n    \n          \n          <div className=\"group relative overflow-hidden rounded-xl shadow-lg transition-all duration-300 hover\">\n            <div className=\"h-64 overflow-hidden\">\n              <img src=\"https://placehold.co/600x400\" alt=\"E-commerce Project\" className=\"h-full w-full object-cover transition-transform duration-500 group-hover110\" />\n            </div>\n            <div className=\"absolute inset-0 flex items-end bg-gradient-to-t from-gray-900 to-transparent p-6 opacity-0 transition-opacity duration-300 group-hover90\">\n              <div className=\"translate-y-8 transform transition-transform duration-300 group-hover0\">\n                <h3 className=\"text-2xl font-bold text-white\">E-commerce Platform</h3>\n                <p className=\"mt-2 text-gray-300\">Custom online store with integrated payment processing.</p>\n                <div className=\"mt-4 flex space-x-2\">\n                  <span className=\"rounded-full bg-yellow-600 px-3 py-1 text-xs font-semibold text-white\">Shopify</span>\n                  <span className=\"rounded-full bg-indigo-600 px-3 py-1 text-xs font-semibold text-white\">Payment</span>\n                </div>\n                <a href=\"#\" className=\"mt-4 inline-flex items-center text-white transition-colors hover300\">\n                  View Project\n                  <i className=\"fas fa-arrow-right ml-2\"></i>\n                </a>\n              </div>\n            </div>\n          </div>\n        </div>\n    \n        \n        <div className=\"mt-16 text-center\">\n          <a href=\"#\" className=\"inline-flex items-center rounded-full border border-blue-600 px-8 py-3 text-base font-medium text-blue-600 transition-colors duration-300 hover600 hover\">\n            Explore All Projects\n            <i className=\"fas fa-long-arrow-alt-right ml-3\"></i>\n          </a>\n        </div>\n      </div>\n    </section>\n    </div>\n  );\n}\n",
