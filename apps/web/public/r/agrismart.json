               </button>\\n                <button class=\\\"md:hidden\\\">\\n                    <i class=\\\"fas fa-bars text-xl\\\"></i>\\n                </button>\\n            </div>\\n        </div>\\n    </nav>\\n\\n    <!-- Main Content -->\\n    <div class=\\\"container mx-auto p-4\\\">\\n        <!-- Header -->\\n        <div class=\\\"mb-8\\\">\\n            <h2 class=\\\"text-2xl font-bold text-gray-800\\\">Farm Dashboard</h2>\\n            <p class=\\\"text-gray-600\\\">Welcome to your smart agriculture monitoring system</p>\\n        </div>\\n\\n        <!-- Stats Overview -->\\n        <div class=\\\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8\\\">\\n            <div class=\\\"bg-white rounded-xl shadow p-6 border-l-4 border-agri-green\\\">\\n                <div class=\\\"flex justify-between items-start\\\">\\n                    <div>\\n                        <p class=\\\"text-gray-500\\\">Soil Moisture</p>\\n                        <h3 class=\\\"text-2xl font-bold text-gray-800\\\">68%</h3>\\n                    </div>\\n                    <i class=\\\"fas fa-tint text-water-blue text-2xl\\\"></i>\\n                </div>\\n                <p class=\\\"text-sm text-gray-500 mt-2\\\">Optimal level</p>\\n            </div>\\n\\n            <div class=\\\"bg-white rounded-xl shadow p-6 border-l-4 border-yellow-500\\\">\\n                <div class=\\\"flex justify-between items-start\\\">\\n                    <div>\\n                        <p class=\\\"text-gray-500\\\">Temperature</p>\\n                        <h3 class=\\\"text-2xl font-bold text-gray-800\\\">24°C</h3>\\n                    </div>\\n                    <i class=\\\"fas fa-thermometer-half text-yellow-500 text-2xl\\\"></i>\\n                </div>\\n                <p class=\\\"text-sm text-gray-500 mt-2\\\">Ideal for growth</p>\\n            </div>\\n\\n            <div class=\\\"bg-white rounded-xl shadow p-6 border-l-4 border-blue-500\\\">\\n                <div class=\\\"flex justify-between items-start\\\">\\n                    <div>\\n                        <p class=\\\"text-gray-500\\\">Humidity</p>\\n                        <h3 class=\\\"text-2xl font-bold text-gray-800\\\">45%</h3>\\n                    </div>\\n                    <i class=\\\"fas fa-cloud text-blue-500 text-2xl\\\"></i>\\n                </div>\\n                <p class=\\\"text-sm text-gray-500 mt-2\\\">Within range</p>\\n            </div>\\n\\n            <div class=\\\"bg-white rounded-xl shadow p-6 border-l-4 border-red-500\\\">\\n                <div class=\\\"flex justify-between items-start\\\">\\n                    <div>\\n                        <p class=\\\"text-gray-500\\\">Crop Health</p>\\n                        <h3 class=\\\"text-2xl font-bold text-gray-800\\\">92%</h3>\\n                    </div>\\n                    <i class=\\\"fas fa-leaf text-agri-green text-2xl\\\"></i>\\n                </div>\\n                <p class=\\\"text-sm text-gray-500 mt-2\\\">Excellent condition</p>\\n            </div>\\n        </div>\\n\\n        <!-- Charts and Data -->\\n        <div class=\\\"grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8\\\">\\n            <!-- Field Status -->\\n            <div class=\\\"lg:col-span-2 bg-white rounded-xl shadow p-6\\\">\\n                <h3 class=\\\"text-lg font-bold text-gray-800 mb-4\\\">Field Status</h3>\\n                <div class=\\\"grid grid-cols-1 md:grid-cols-2 gap-4\\\">\\n                    <div class=\\\"border rounded-lg p-4\\\">\\n                        <div class=\\\"flex justify-between mb-2\\\">\\n                            <span class=\\\"font-medium\\\">North Field</span>\\n                            <span class=\\\"text-agri-green\\\">Ready</span>\\n                        </div>\\n                        <div class=\\\"w-full bg-gray-200 rounded-full h-2.5\\\">\\n                            <div class=\\\"bg-agri-green h-2.5 rounded-full\\\" style=\\\"width: 85%\\\"></div>\\n                        </div>\\n                        <p class=\\\"text-sm text-gray-500 mt-1\\\">Corn - 85% growth</p>\\n                    </div>\\n                    \\n                    <div class=\\\"border rounded-lg p-4\\\">\\n                        <div class=\\\"flex justify-between mb-2\\\">\\n                            <span class=\\\"font-medium\\\">South Field</span>\\n                            <span class=\\\"text-yellow-500\\\">Needs Water</span>\\n                        </div>\\n                        <div class=\\\"w-full bg-gray-200 rounded-full h-2.5\\\">\\n                            <div class=\\\"bg-yellow-500 h-2.5 rounded-full\\\" style=\\\"width: 65%\\\"></div>\\n                        </div>\\n                        <p class=\\\"text-sm text-gray-500 mt-1\\\">Wheat - 65% growth</p>\\n                    </div>\\n                    \\n                    <div class=\\\"border rounded-lg p-4\\\">\\n                        <div class=\\\"flex justify-between mb-2\\\">\\n                            <span class=\\\"font-medium\\\">East Field</span>\\n                            <span class=\\\"text-agri-green\\\">Optimal</span>\\n                        </div>\\n                        <div class=\\\"w-full bg-gray-200 rounded-full h-2.5\\\">\\n                            <div class=\\\"bg-agri-green h-2.5 rounded-full\\\" style=\\\"width: 92%\\\"></div>\\n                        </div>\\n                        <p class=\\\"text-sm text-gray-500 mt-1\\\">Soybean - 92% growth</p>\\n                    </div>\\n                    \\n                    <div class=\\\"border rounded-lg p-4\\\">\\n                        <div class=\\\"flex justify-between mb-2\\\">\\n                            <span class=\\\"font-medium\\\">West Field</span>\\n                            <span class=\\\"text-red-500\\\">Alert</span>\\n                        </div>\\n                        <div class=\\\"w-full bg-gray-200 rounded-full h-2.5\\\">\\n                            <div class=\\\"bg-red-500 h-2.5 rounded-full\\\" style=\\\"width: 45%\\\"></div>\\n                        </div>\\n                        <p class=\\\"text-sm text-gray-500 mt-1\\\">Tomatoes - 45% growth</p>\\n                    </div>\\n                </div>\\n            </div>\\n\\n            <!-- Irrigation Control -->\\n            <div class=\\\"bg-white rounded-xl shadow p-6\\\">\\n                <h3 class=\\\"text-lg font-bold text-gray-800 mb-4\\\">Irrigation Control</h3>\\n                <div class=\\\"space-y-4\\\">\\n                    <div class=\\\"flex justify-between items-center p-3 bg-blue-50 rounded-lg\\\">\\n                        <div>\\n                            <p class=\\\"font-medium\\\">North Field</p>\\n                            <p class=\\\"text-sm text-gray-500\\\">Last watered: 2 hours ago</p>\\n                        </div>\\n                        <button class=\\\"bg-water-blue text-white px-4 py-2 rounded-lg hover:bg-blue-600 transition\\\">\\n                            Water Now\\n                        </button>\\n                    </div>\\n                    \\n                    <div class=\\\"flex justify-between items-center p-3 bg-yellow-50 rounded-lg\\\">\\n                        <div>\\n                            <p class=\\\"font-medium\\\">South Field</p>\\n                            <p class=\\\"text-sm text-gray-500\\\">Last watered: 8 hours ago</p>\\n                        </div>\\n                        <button class=\\\"bg-yellow-500 text-white px-4 py-2 rounded-lg hover:bg-yellow-600 transition\\\">\\n                            Water Now\\n                        </button>\\n                    </div>\\n                    \\n                    <div class=\\\"flex justify-between items-center p-3 bg-green-50 rounded-lg\\\">\\n                        <div>\\n                            <p class=\\\"font-medium\\\">East Field</p>\\n                            <p class=\\\"text-sm text-gray-500\\\">Last watered: 4 hours ago</p>\\n                        </div>\\n                        <button class=\\\"bg-agri-green text-white px-4 py-2 rounded-lg hover:bg-agri-dark transition\\\">\\n                            Water Now\\n                        </button>\\n                    </div>\\n                    \\n                    <div class=\\\"flex justify-between items-center p-3 bg-red-50 rounded-lg\\\">\\n                        <div>\\n                            <p class=\\\"font-medium\\\">West Field</p>\\n                            <p class=\\\"text-sm text-gray-500\\\">Last watered: 12 hours ago</p>\\n                        </div>\\n                        <button class=\\\"bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-600 transition\\\">\\n                            Water Now\\n                        </button>\\n                    </div>\\n                </div>\\n            </div>\\n        </div>\\n\\n        <!-- Weather and Alerts -->\\n        <div class=\\\"grid grid-cols-1 lg:grid-cols-3 gap-6\\\">\\n            <!-- Weather Forecast -->\\n            <div class=\\\"bg-white rounded-xl shadow p-6\\\">\\n                <h3 class=\\\"text-lg font-bold text-gray-800 mb-4\\\">Weather Forecast</h3>\\n                <div class=\\\"space-y-4\\\">\\n                    <div class=\\\"flex justify-between items-center border-b pb-3\\\">\\n                        <div class=\\\"flex items-center\\\">\\n                            <i class=\\\"fas fa-sun text-yellow-500 text-xl mr-3\\\"></i>\\n                            <span>Today</span>\\n                        </div>\\n                        <div class=\\\"text-right\\\">\\n                            <p class=\\\"font-medium\\\">Sunny</p>\\n                            <p class=\\\"text-sm text-gray-500\\\">24°C / 15°C</p>\\n                        </div>\\n                    </div>\\n                    \\n                    <div class=\\\"flex justify-between items-center border-b pb-3\\\">\\n                        <div class=\\\"flex items-center\\\">\\n                            <i class=\\\"fas fa-cloud-sun text-gray-500 text-xl mr-3\\\"></i>\\n                            <span>Tomorrow</span>\\n                        </div>\\n                        <div class=\\\"text-right\\\">\\n                            <p class=\\\"font-medium\\\">Partly Cloudy</p>\\n                            <p class=\\\"text-sm text-gray-500\\\">22°C / 14°C</p>\\n                        </div>\\n                    </div>\\n                    \\n                    <div class=\\\"flex justify-between items-center\\\">\\n                        <div class=\\\"flex items-center\\\">\\n                            <i class=\\\"fas fa-cloud-rain text-blue-500 text-xl mr-3\\\"></i>\\n                            <span>Day After</span>\\n                        </div>\\n                        <div class=\\\"text-right\\\">\\n                            <p class=\\\"font-medium\\\">Light Rain</p>\\n                            <p class=\\\"text-sm text-gray-500\\\">19°C / 13°C</p>\\n                        </div>\\n                    </div>\\n                </div>\\n            </div>\\n\\n            <!-- System Alerts -->\\n            <div class=\\\"bg-white rounded-xl shadow p-6\\\">\\n                <h3 class=\\\"text-lg font-bold text-gray-800 mb-4\\\">System Alerts</h3>\\n                <div class=\\\"space-y-4\\\">\\n                    <div class=\\\"flex items-start p-3 bg-yellow-50 rounded-lg border-l-4 border-yellow-500\\\">\\n                        <i class=\\\"fas fa-exclamation-triangle text-yellow-500 mt-1 mr-3\\\"></i>\\n                        <div>\\n                            <p class=\\\"font-medium\\\">Low Soil Moisture</p>\\n                            <p class=\\\"text-sm text-gray-500\\\">South Field moisture level is at 32%</p>\\n                        </div>\\n                    </div>\\n                    \\n                    <div class=\\\"flex items-start p-3 bg-blue-50 rounded-lg border-l-4 border-blue-500\\\">\\n                        <i class=\\\"fas fa-info-circle text-blue-500 mt-1 mr-3\\\"></i>\\n                        <div>\\n                            <p class=\\\"font-medium\\\">Irrigation Complete</p>\\n                            <p class=\\\"text-sm text-gray-500\\\">North Field watering finished</p>\\n                        </div>\\n                    </div>\\n                    \\n                    <div class=\\\"flex items-start p-3 bg-red-50 rounded-lg border-l-4 border-red-500\\\">\\n                        <i class=\\\"fas fa-bug text-red-500 mt-1 mr-3\\\"></i>\\n                        <div>\\n                            <p class=\\\"font-medium\\\">Pest Detected</p>\\n                            <p class=\\\"text-sm text-gray-500\\\">Potential pest activity in West Field</p>\\n                        </div>\\n                    </div>\\n                </div>\\n            </div>\\n\\n            <!-- Quick Actions -->\\n            <div class=\\\"bg-white rounded-xl shadow p-6\\\">\\n                <h3 class=\\\"text-lg font-bold text-gray-800 mb-4\\\">Quick Actions</h3>\\n                <div class=\\\"grid grid-cols-2 gap-4\\\">\\n                    <button class=\\\"bg-agri-green text-white p-4 rounded-lg flex flex-col items-center justify-center hover:bg-agri-dark transition\\\">\\n                        <i class=\\\"fas fa-tint text-2xl mb-2\\\"></i>\\n                        <span>Irrigation</span>\\n                    </button>\\n                    \\n                    <button class=\\\"bg-blue-500 text-white p-4 rounded-lg flex flex-col items-center justify-center hover:bg-blue-600 transition\\\">\\n                        <i class=\\\"fas fa-chart-line text-2xl mb-2\\\"></i>\\n                        <span>Analytics</span>\\n                    </button>\\n                    \\n                    <button class=\\\"bg-yellow-500 text-white p-4 rounded-lg flex flex-col items-center justify-center hover:bg-yellow-600 transition\\\">\\n                        <i class=\\\"fas fa-robot text-2xl mb-2\\\"></i>\\n                        <span>Automation</span>\\n                    </button>\\n                    \\n                    <button class=\\\"bg-purple-500 text-white p-4 rounded-lg flex flex-col items-center justify-center hover:bg-purple-600 transition\\\">\\n                        <i class=\\\"fas fa-cog text-2xl mb-2\\\"></i>\\n                        <span>Settings</span>\\n                    </button>\\n                </div>\\n            </div>\\n        </div>\\n    </div>\\n\\n    <!-- Footer -->\\n    <footer class=\\\"bg-agri-dark text-white mt-12 py-8\\\">\\n        <div class=\\\"container mx-auto px-4\\\">\\n            <div class=\\\"grid grid-cols-1 md:grid-cols-4 gap-8\\\">\\n                <div>\\n                    <h4 class=\\\"text-lg font-bold mb-4\\\">AgriSmart</h4>\\n                    <p class=\\\"text-gray-300\\\">Smart agriculture solutions for modern farming.</p>\\n                </div>\\n                \\n                <div>\\n                    <h4 class=\\\"text-lg font-bold mb-4\\\">Quick Links</h4>\\n                    <ul class=\\\"space-y-2 text-gray-300\\\">\\n                        <li><a href=\\\"#\\\" class=\\\"hover:text-white transition\\\">Dashboard</a></li>\\n                        <li><a href=\\\"#\\\" class=\\\"hover:text-white transition\\\">Fields</a></li>\\n                        <li><a href=\\\"#\\\" class=\\\"hover:text-white transition\\\">Sensors</a></li>\\n                        <li><a href=\\\"#\\\" class=\\\"hover:text-white transition\\\">Reports</a></li>\\n                    </ul>\\n                </div>\\n                \\n                <div>\\n                    <h4 class=\\\"text-lg font-bold mb-4\\\">Contact</h4>\\n                    <ul class=\\\"space-y-2 text-gray-300\\\">\\n                        <li><i class=\\\"fas fa-envelope mr-2\\\"></i> info@agrismart.com</li>\\n                        <li><i class=\\\"fas fa-phone mr-2\\\"></i> +250 796684607</li>\\n                        <li><i class=\\\"fas fa-map-marker-alt mr-2\\\"></i> 123 Farm Rd,Rwanda/Rubavu/Gisenyi</li>\\n                    </ul>\\n                </div>\\n                \\n                <div>\\n                    <h4 class=\\\"text-lg font-bold mb-4\\\">Subscribe</h4>\\n                    <p class=\\\"text-gray-300 mb-2\\\">Get the latest updates</p>\\n                    <div class=\\\"flex\\\">\\n                        <input type=\\\"email\\\" placeholder=\\\"Your email\\\" class=\\\"px-3 py-2 rounded-l-lg text-gray-800 w-full\\\">\\n                        <button class=\\\"bg-agri-green px-4 py-2 rounded-r-lg hover:bg-agri-light transition\\\">\\n                            <i class=\\\"fas fa-paper-plane\\\"></i>\\n                        </button>\\n                    </div>\\n                </div>\\n            </div>\\n            \\n            <div class=\\\"border-t border-gray-700 mt-8 pt-6 text-center text-gray-400\\\">\\n                <p>&copy; 2025-2026 AgriSmart. All rights reserved.</p>\\n            </div>\\n        </div>\\n    </footer>\\n\\n    \\n</body>\\n</html>\" }} />\n  );\n}\n",
