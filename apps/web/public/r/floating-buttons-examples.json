      "content": "/**\n * Component: Floating buttons examples\n * Author: @livia-flores (https://tailwindflex.com/@livia-flores)\n * Source: https://tailwindflex.com/@livia-flores/floating-buttons-examples\n * Attribution: Créé par @livia-flores sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function FloatingButtonsExamples() {\n  return (\n    <div>\n    \n    <div className=\"fixed bottom-4 right-4\">\n        <button className=\"bg-blue-500 hover600 text-white font-bold py-2 px-4 rounded-full shadow-lg\">\n        Feedback\n      </button>\n    </div>\n    \n    \n    \n    <div className=\"fixed bottom-4 left-4\">\n        <button className=\"bg-blue-500 hover600 text-white font-bold py-2 px-4 rounded-full shadow-lg\">\n        Feedback\n      </button>\n    </div>\n    \n    \n    \n    <div className=\"fixed top-4 right-4\">\n        <button className=\"bg-blue-500 hover600 text-white font-bold py-2 px-4 rounded-full shadow-lg\">\n        Feedback\n      </button>\n    </div>\n    \n    \n    \n    <div className=\"fixed top-4 left-4\">\n        <button className=\"bg-blue-500 hover600 text-white font-bold py-2 px-4 rounded-full shadow-lg\">\n        Feedback\n      </button>\n    </div>\n    \n    \n    \n    <div className=\"fixed top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2\">\n        <button className=\"bg-blue-500 hover600 text-white font-bold py-2 px-4 rounded-full shadow-lg\">\n        Feedback\n      </button>\n    </div>\n    \n    \n    \n    <div className=\"fixed bottom-4 left-1/2 transform -translate-x-1/2\">\n        <button className=\"bg-blue-500 hover600 text-white font-bold py-2 px-4 rounded-full shadow-lg\">\n        Feedback\n      </button>\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
