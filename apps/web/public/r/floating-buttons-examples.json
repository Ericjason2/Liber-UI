      "content": "import * as React from \"react\"\n\nfunction FloatingButtonsExamples({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"floating-buttons-examples\"\n      className={className}\n      {...props}\n    >\n      \n      <div className=\"fixed bottom-4 right-4\">\n          <button className=\"bg-blue-500 hover600 text-white font-bold py-2 px-4 rounded-full shadow-lg\">\n          Feedback\n        </button>\n      </div>\n      \n      \n      \n      <div className=\"fixed bottom-4 left-4\">\n          <button className=\"bg-blue-500 hover600 text-white font-bold py-2 px-4 rounded-full shadow-lg\">\n          Feedback\n        </button>\n      </div>\n      \n      \n      \n      <div className=\"fixed top-4 right-4\">\n          <button className=\"bg-blue-500 hover600 text-white font-bold py-2 px-4 rounded-full shadow-lg\">\n          Feedback\n        </button>\n      </div>\n      \n      \n      \n      <div className=\"fixed top-4 left-4\">\n          <button className=\"bg-blue-500 hover600 text-white font-bold py-2 px-4 rounded-full shadow-lg\">\n          Feedback\n        </button>\n      </div>\n      \n      \n      \n      <div className=\"fixed top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2\">\n          <button className=\"bg-blue-500 hover600 text-white font-bold py-2 px-4 rounded-full shadow-lg\">\n          Feedback\n        </button>\n      </div>\n      \n      \n      \n      <div className=\"fixed bottom-4 left-1/2 transform -translate-x-1/2\">\n          <button className=\"bg-blue-500 hover600 text-white font-bold py-2 px-4 rounded-full shadow-lg\">\n          Feedback\n        </button>\n      </div>\n    </div>\n  )\n}\n\nexport { FloatingButtonsExamples }\n",
      "type": "registry:ui"
    }
