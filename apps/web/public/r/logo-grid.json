    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\" dir=\"ltr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Logo grid</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        body {\n            font-family: 'Inter', sans-serif;\n        }\n        .logo-img {\n            filter: grayscale(100%) brightness(70%);\n            transition: all 0.3s ease;\n        }\n        .logo-card:hover .logo-img {\n            filter: grayscale(0%) brightness(100%);\n        }\n    </style>\n</head>\n<body>\n    <section class=\"bg-[#f9f9f9]\">\n        <div class=\"max-w-7xl mx-auto px-6 py-20\">\n            <div class=\"flex flex-col lg:flex-row gap-16\">\n                <!-- Left Content -->\n                <div class=\"flex flex-col justify-center lg:w-1/2\">\n                    <p class=\"text-gray-500 text-sm mb-2 font-medium\">Trusted by industry leaders</p>\n                    <h2 class=\"text-3xl md:text-4xl lg:text-5xl font-bold mb-6 text-gray-900\">Our References</h2>\n                    <p class=\"text-gray-600 text-lg mb-8 leading-relaxed\">\n                        We've had the privilege of working with some of the most innovative companies in the world. \n                        Our partnerships span across various industries, helping businesses achieve their goals \n                        through cutting-edge solutions and exceptional service.\n                    </p>\n                    <button class=\"bg-black text-white rounded-lg py-3 px-6 w-fit transition hover:bg-gray-800 font-medium\">\n                        View All Clients\n                    </button>\n                </div>\n                \n                <!-- Right Content - Logo Grid -->\n                <div class=\"lg:w-1/2\">\n                    <div class=\"grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-3 gap-6\">\n                        <!-- Card 1 - Stripe -->\n                        <div class=\"logo-card bg-white rounded-2xl py-8 px-10 shadow-sm flex items-center justify-center\">\n                            <img src=\"https://upload.wikimedia.org/wikipedia/commons/b/ba/Stripe_Logo%2C_revised_2016.svg\" alt=\"Stripe\" class=\"logo-img h-8\">\n                        </div>\n                        <!-- Card 2 - Slack -->\n                        <div class=\"logo-card bg-white rounded-2xl py-8 px-10 shadow-sm flex items-center justify-center\">\n                            <img src=\"https://upload.wikimedia.org/wikipedia/commons/d/d5/Slack_icon_2019.svg\" alt=\"Slack\" class=\"logo-img h-8\">\n                        </div>\n                        <!-- Card 3 - Youtube Music -->\n                        <div class=\"logo-card bg-white rounded-2xl py-8 px-10 shadow-sm flex items-center justify-center\">\n                            <img src=\"https://upload.wikimedia.org/wikipedia/commons/1/1c/YouTube_Music_2024.svg\" alt=\"Youtube Music\" class=\"logo-img h-10\">\n                        </div>\n                        <!-- Card 4 - SoundCloud -->\n                        <div class=\"logo-card bg-white rounded-2xl py-8 px-10 shadow-sm flex items-center justify-center\">\n                            <img src=\"https://upload.wikimedia.org/wikipedia/commons/7/78/Soundcloud_logo.svg\" alt=\"SoundCloud\" class=\"logo-img h-8\">\n                        </div>\n                        <!-- Card 5 - HubSpot -->\n                        <div class=\"logo-card bg-white rounded-2xl py-8 px-10 shadow-sm flex items-center justify-center\">\n                            <img src=\"https://upload.wikimedia.org/wikipedia/commons/thumb/3/3f/HubSpot_Logo.svg/1920px-HubSpot_Logo.svg.png\" alt=\"HubSpot\" class=\"logo-img h-7\">\n                        </div>\n                        <!-- Card 6 - Medium -->\n                        <div class=\"logo-card bg-white rounded-2xl py-8 px-10 shadow-sm flex items-center justify-center\">\n                            <img src=\"https://upload.wikimedia.org/wikipedia/commons/e/ec/Medium_logo_Monogram.svg\" alt=\"Medium\" class=\"logo-img h-8\">\n                        </div>\n                        <!-- Card 7 - Spotify -->\n                        <div class=\"logo-card bg-white rounded-2xl py-8 px-10 shadow-sm flex items-center justify-center\">\n                            <img src=\"https://upload.wikimedia.org/wikipedia/commons/b/bd/2024_Spotify_Logo.svg\" alt=\"Spotify\" class=\"logo-img h-10\">\n                        </div>\n                        <!-- Card 8 - Airbnb -->\n                        <div class=\"logo-card bg-white rounded-2xl py-8 px-10 shadow-sm flex items-center justify-center\">\n                            <img src=\"https://upload.wikimedia.org/wikipedia/commons/6/69/Airbnb_Logo_B%C3%A9lo.svg\" alt=\"Airbnb\" class=\"logo-img h-7\">\n                        </div>\n                        <!-- Card 9 - Netflix -->\n                        <div class=\"logo-card bg-white rounded-2xl py-8 px-10 shadow-sm flex items-center justify-center\">\n                            <img src=\"https://upload.wikimedia.org/wikipedia/commons/0/08/Netflix_2015_logo.svg\" alt=\"Netflix\" class=\"logo-img h-6\">\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n</body>\n</html>"
