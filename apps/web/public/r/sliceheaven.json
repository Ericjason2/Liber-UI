    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Slice Heaven - Pizza Delivery</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap\" rel=\"stylesheet\">\n    <script>\n        tailwind.config = {\n            theme: {\n                extend: {\n                    fontFamily: {\n                        poppins: ['Poppins', 'sans-serif'],\n                    },\n                    colors: {\n                        primary: '#f97316',\n                        secondary: '#ea580c',\n                    }\n                }\n            }\n        }\n    </script>\n</head>\n<body class=\"font-poppins bg-gray-50\">\n    <!-- Navigation -->\n    <nav class=\"bg-white shadow-lg sticky top-0 z-50\">\n        <div class=\"max-w-6xl mx-auto px-4\">\n            <div class=\"flex justify-between\">\n                <div class=\"flex space-x-7\">\n                    <div>\n                        <!-- Logo -->\n                        <a href=\"#\" class=\"flex items-center py-4 px-2\">\n                            <span class=\"text-primary text-2xl font-bold\">Slice<span class=\"text-secondary\">Heaven</span></span>\n                        </a>\n                    </div>\n                    <!-- Primary Nav -->\n                    <div class=\"hidden md:flex items-center space-x-1\">\n                        <a href=\"#\" class=\"py-4 px-2 text-primary border-b-4 border-primary font-semibold\">Home</a>\n                        <a href=\"#menu\" class=\"py-4 px-2 text-gray-500 hover:text-primary transition duration-300\">Menu</a>\n                        <a href=\"#about\" class=\"py-4 px-2 text-gray-500 hover:text-primary transition duration-300\">About</a>\n                        <a href=\"#order\" class=\"py-4 px-2 text-gray-500 hover:text-primary transition duration-300\">Order</a>\n                    </div>\n                </div>\n                <!-- Secondary Nav -->\n                <div class=\"hidden md:flex items-center space-x-3\">\n                    <a href=\"tel:+1234567890\" class=\"py-2 px-2 bg-primary text-white rounded hover:bg-secondary transition duration-300\">\n                        Call Now\n                    </a>\n                </div>\n                <!-- Mobile menu button -->\n                <div class=\"md:hidden flex items-center\">\n                    <button class=\"outline-none mobile-menu-button\">\n                        <svg class=\"w-6 h-6 text-gray-500\" \n                            x-show=\"!showMenu\"\n                            fill=\"none\" \n                            stroke-linecap=\"round\" \n                            stroke-linejoin=\"round\" \n                            stroke-width=\"2\" \n                            viewBox=\"0 0 24 24\" \n                            stroke=\"currentColor\"\n                        >\n                            <path d=\"M4 6h16M4 12h16M4 18h16\"></path>\n                        </svg>\n                    </button>\n                </div>\n            </div>\n        </div>\n        <!-- Mobile Menu -->\n        <div class=\"hidden mobile-menu\">\n            <ul>\n                <li><a href=\"#\" class=\"block text-sm px-2 py-4 text-white bg-primary font-semibold\">Home</a></li>\n                <li><a href=\"#menu\" class=\"block text-sm px-2 py-4 hover:bg-gray-100 transition duration-300\">Menu</a></li>\n                <li><a href=\"#about\" class=\"block text-sm px-2 py-4 hover:bg-gray-100 transition duration-300\">About</a></li>\n                <li><a href=\"#order\" class=\"block text-sm px-2 py-4 hover:bg-gray-100 transition duration-300\">Order</a></li>\n            </ul>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"bg-gradient-to-r from-primary to-secondary text-white py-20\">\n        <div class=\"container mx-auto px-6 text-center\">\n            <h1 class=\"text-4xl md:text-6xl font-bold mb-6\">Delicious Pizza Delivered to Your Door</h1>\n            <p class=\"text-xl mb-8\">Fresh ingredients, authentic recipes, and fast delivery - just the way you like it!</p>\n            <a href=\"#order\" class=\"bg-white text-primary font-bold py-3 px-8 rounded-full hover:bg-gray-100 transition duration-300\">Order Now</a>\n        </div>\n    </section>\n\n    <!-- Menu Section -->\n    <section id=\"menu\" class=\"py-16 bg-white\">\n        <div class=\"container mx-auto px-6\">\n            <h2 class=\"text-3xl font-bold text-center text-gray-800 mb-12\">Our Menu</h2>\n            <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8\">\n                <!-- Pizza 1 -->\n                <div class=\"bg-gray-50 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition duration-300\">\n                    <img src=\"https://images.unsplash.com/photo-1513104890138-7c749659a591?ixlib=rb-1.2.1&auto=format&fit=crop&w=500&q=60\" alt=\"Margherita Pizza\" class=\"w-full h-48 object-cover\">\n                    <div class=\"p-6\">\n                        <h3 class=\"text-xl font-semibold text-gray-800\">Margherita</h3>\n                        <p class=\"text-gray-600 mt-2\">Classic pizza with tomato sauce, mozzarella, and basil.</p>\n                        <div class=\"mt-4 flex justify-between items-center\">\n                            <span class=\"text-primary font-bold text-lg\">$12.99</span>\n                            <button class=\"bg-primary text-white px-4 py-2 rounded hover:bg-secondary transition duration-300\">Add to Cart</button>\n                        </div>\n                    </div>\n                </div>\n                \n                <!-- Pizza 2 -->\n                <div class=\"bg-gray-50 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition duration-300\">\n                    <img src=\"https://images.unsplash.com/photo-1552539618-7eec9b4d1796?ixlib=rb-1.2.1&auto=format&fit=crop&w=500&q=60\" alt=\"Pepperoni Pizza\" class=\"w-full h-48 object-cover\">\n                    <div class=\"p-6\">\n                        <h3 class=\"text-xl font-semibold text-gray-800\">Pepperoni</h3>\n                        <p class=\"text-gray-600 mt-2\">Tomato sauce, mozzarella, and lots of pepperoni.</p>\n                        <div class=\"mt-4 flex justify-between items-center\">\n                            <span class=\"text-primary font-bold text-lg\">$14.99</span>\n                            <button class=\"bg-primary text-white px-4 py-2 rounded hover:bg-secondary transition duration-300\">Add to Cart</button>\n                        </div>\n                    </div>\n                </div>\n                \n                <!-- Pizza 3 -->\n                <div class=\"bg-gray-50 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition duration-300\">\n                    <img src=\"https://images.unsplash.com/photo-1604382354936-07c5d9983bd3?ixlib=rb-1.2.1&auto=format&fit=crop&w=500&q=60\" alt=\"Vegetarian Pizza\" class=\"w-full h-48 object-cover\">\n                    <div class=\"p-6\">\n                        <h3 class=\"text-xl font-semibold text-gray-800\">Vegetarian</h3>\n                        <p class=\"text-gray-600 mt-2\">Tomato sauce, mozzarella, bell peppers, mushrooms, and olives.</p>\n                        <div class=\"mt-4 flex justify-between items-center\">\n                            <span class=\"text-primary font-bold text-lg\">$13.99</span>\n                            <button class=\"bg-primary text-white px-4 py-2 rounded hover:bg-secondary transition duration-300\">Add to Cart</button>\n                        </div>\n                    </div>\n                </div>\n                \n                <!-- Pizza 4 -->\n                <div class=\"bg-gray-50 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition duration-300\">\n                    <img src=\"https://images.unsplash.com/photo-1620374645498-af6bd681a0bd?ixlib=rb-1.2.1&auto=format&fit=crop&w=500&q=60\" alt=\"Hawaiian Pizza\" class=\"w-full h-48 object-cover\">\n                    <div class=\"p-6\">\n                        <h3 class=\"text-xl font-semibold text-gray-800\">Hawaiian</h3>\n                        <p class=\"text-gray-600 mt-2\">Tomato sauce, mozzarella, ham, and pineapple.</p>\n                        <div class=\"mt-4 flex justify-between items-center\">\n                            <span class=\"text-primary font-bold text-lg\">$15.99</span>\n                            <button class=\"bg-primary text-white px-4 py-2 rounded hover:bg-secondary transition duration-300\">Add to Cart</button>\n                        </div>\n                    </div>\n                </div>\n                \n                <!-- Pizza 5 -->\n                <div class=\"bg-gray-50 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition duration-300\">\n                    <img src=\"https://images.unsplash.com/photo-1593504049359-74330189a345?ixlib=rb-1.2.1&auto=format&fit=crop&w=500&q=60\" alt=\"BBQ Chicken Pizza\" class=\"w-full h-48 object-cover\">\n                    <div class=\"p-6\">\n                        <h3 class=\"text-xl font-semibold text-gray-800\">BBQ Chicken</h3>\n                        <p class=\"text-gray-600 mt-2\">BBQ sauce, mozzarella, chicken, red onions, and cilantro.</p>\n                        <div class=\"mt-4 flex justify-between items-center\">\n                            <span class=\"text-primary font-bold text-lg\">$16.99</span>\n                            <button class=\"bg-primary text-white px-4 py-2 rounded hover:bg-secondary transition duration-300\">Add to Cart</button>\n                        </div>\n                    </div>\n                </div>\n                \n                <!-- Pizza 6 -->\n                <div class=\"bg-gray-50 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition duration-300\">\n                    <img src=\"https://images.unsplash.com/photo-1574071318508-1cdbab80d002?ixlib=rb-1.2.1&auto=format&fit=crop&w=500&q=60\" alt=\"Meat Lovers Pizza\" class=\"w-full h-48 object-cover\">\n                    <div class=\"p-6\">\n                        <h3 class=\"text-xl font-semibold text-gray-800\">Meat Lovers</h3>\n                        <p class=\"text-gray-600 mt-2\">Tomato sauce, mozzarella, pepperoni, sausage, bacon, and ham.</p>\n                        <div class=\"mt-4 flex justify-between items-center\">\n                            <span class=\"text-primary font-bold text-lg\">$17.99</span>\n                            <button class=\"bg-primary text-white px-4 py-2 rounded hover:bg-secondary transition duration-300\">Add to Cart</button>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- About Section -->\n    <section id=\"about\" class=\"py-16 bg-gray-100\">\n        <div class=\"container mx-auto px-6\">\n            <div class=\"flex flex-col md:flex-row items-center\">\n                <div class=\"md:w-1/2 mb-8 md:mb-0\">\n                    <img src=\"https://images.unsplash.com/photo-1590947132387-155cc02f3212?ixlib=rb-1.2.1&auto=format&fit=crop&w=500&q=60\" alt=\"Pizza Chef\" class=\"rounded-lg shadow-lg w-full\">\n                </div>\n                <div class=\"md:w-1/2 md:pl-12\">\n                    <h2 class=\"text-3xl font-bold text-gray-800 mb-6\">About Slice Heaven</h2>\n                    <p class=\"text-gray-600 mb-4\">Founded in 2010, Slice Heaven has been serving the community with authentic Italian-style pizzas made from the freshest ingredients. Our secret family recipe dough is made fresh daily and hand-tossed by our skilled chefs.</p>\n                    <p class=\"text-gray-600 mb-4\">We source our ingredients locally whenever possible, including our vine-ripened tomatoes for sauce and fresh mozzarella cheese. Our meats are all-natural and free from artificial preservatives.</p>\n                    <p class=\"text-gray-600 mb-6\">Whether you're dining in, taking out, or having it delivered, we guarantee you'll taste the difference that quality ingredients and passion for pizza can make.</p>\n                    <div class=\"flex space-x-4\">\n                        <div class=\"bg-white p-4 rounded-lg shadow text-center\">\n                            <span class=\"text-primary text-2xl font-bold\">12+</span>\n                            <p class=\"text-gray-600\">Years Experience</p>\n                        </div>\n                        <div class=\"bg-white p-4 rounded-lg shadow text-center\">\n                            <span class=\"text-primary text-2xl font-bold\">50+</span>\n                            <p class=\"text-gray-600\">Pizza Varieties</p>\n                        </div>\n                        <div class=\"bg-white p-4 rounded-lg shadow text-center\">\n                            <span class=\"text-primary text-2xl font-bold\">10k+</span>\n                            <p class=\"text-gray-600\">Happy Customers</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Order Section -->\n    <section id=\"order\" class=\"py-16 bg-white\">\n        <div class=\"container mx-auto px-6 max-w-4xl\">\n            <h2 class=\"text-3xl font-bold text-center text-gray-800 mb-12\">Place Your Order</h2>\n            <form class=\"bg-gray-50 p-8 rounded-lg shadow-lg\">\n                <div class=\"mb-6\">\n                    <label for=\"name\" class=\"block text-gray-700 font-medium mb-2\">Full Name</label>\n                    <input type=\"text\" id=\"name\" class=\"w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-primary\" required>\n                </div>\n                \n                <div class=\"mb-6\">\n                    <label for=\"phone\" class=\"block text-gray-700 font-medium mb-2\">Phone Number</label>\n                    <input type=\"tel\" id=\"phone\" class=\"w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-primary\" required>\n                </div>\n                \n                <div class=\"mb-6\">\n                    <label for=\"address\" class=\"block text-gray-700 font-medium mb-2\">Delivery Address</label>\n                    <textarea id=\"address\" rows=\"3\" class=\"w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-primary\" required></textarea>\n                </div>\n                \n                <div class=\"mb-6\">\n                    <label class=\"block text-gray-700 font-medium mb-2\">Pizza Selection</label>\n                    <div class=\"space-y-2\">\n                        <div class=\"flex items-center\">\n                            <input type=\"checkbox\" id=\"margherita\" class=\"h-5 w-5 text-primary focus:ring-primary\">\n                            <label for=\"margherita\" class=\"ml-2 text-gray-700\">Margherita - $12.99</label>\n                        </div>\n                        <div class=\"flex items-center\">\n                            <input type=\"checkbox\" id=\"pepperoni\" class=\"h-5 w-5 text-primary focus:ring-primary\">\n                            <label for=\"pepperoni\" class=\"ml-2 text-gray-700\">Pepperoni - $14.99</label>\n                        </div>\n                        <div class=\"flex items-center\">\n                            <input type=\"checkbox\" id=\"vegetarian\" class=\"h-5 w-5 text-primary focus:ring-primary\">\n                            <label for=\"vegetarian\" class=\"ml-2 text-gray-700\">Vegetarian - $13.99</label>\n                        </div>\n                        <div class=\"flex items-center\">\n                            <input type=\"checkbox\" id=\"hawaiian\" class=\"h-5 w-5 text-primary focus:ring-primary\">\n                            <label for=\"hawaiian\" class=\"ml-2 text-gray-700\">Hawaiian - $15.99</label>\n                        </div>\n                        <div class=\"flex items-center\">\n                            <input type=\"checkbox\" id=\"bbq-chicken\" class=\"h-5 w-5 text-primary focus:ring-primary\">\n                            <label for=\"bbq-chicken\" class=\"ml-2 text-gray-700\">BBQ Chicken - $16.99</label>\n                        </div>\n                        <div class=\"flex items-center\">\n                            <input type=\"checkbox\" id=\"meat-lovers\" class=\"h-5 w-5 text-primary focus:ring-primary\">\n                            <label for=\"meat-lovers\" class=\"ml-2 text-gray-700\">Meat Lovers - $17.99</label>\n                        </div>\n                    </div>\n                </div>\n                \n                <div class=\"mb-6\">\n                    <label for=\"size\" class=\"block text-gray-700 font-medium mb-2\">Pizza Size</label>\n                    <select id=\"size\" class=\"w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-primary\">\n                        <option value=\"small\">Small (10\")</option>\n                        <option value=\"medium\" selected>Medium (12\")</option>\n                        <option value=\"large\">Large (14\")</option>\n                        <option value=\"xlarge\">Extra Large (16\")</option>\n                    </select>\n                </div>\n                \n                <div class=\"mb-6\">\n                    <label for=\"instructions\" class=\"block text-gray-700 font-medium mb-2\">Special Instructions</label>\n                    <textarea id=\"instructions\" rows=\"3\" class=\"w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-primary\"></textarea>\n                </div>\n                \n                <div class=\"mb-6\">\n                    <label for=\"payment\" class=\"block text-gray-700 font-medium mb-2\">Payment Method</label>\n                    <div class=\"space-y-2\">\n                        <div class=\"flex items-center\">\n                            <input type=\"radio\" id=\"cash\" name=\"payment\" value=\"cash\" class=\"h-5 w-5 text-primary focus:ring-primary\" checked>\n                            <label for=\"cash\" class=\"ml-2 text-gray-700\">Cash on Delivery</label>\n                        </div>\n                        <div class=\"flex items-center\">\n                            <input type=\"radio\" id=\"card\" name=\"payment\" value=\"card\" class=\"h-5 w-5 text-primary focus:ring-primary\">\n                            <label for=\"card\" class=\"ml-2 text-gray-700\">Credit/Debit Card</label>\n                        </div>\n                    </div>\n                </div>\n                \n                <button type=\"submit\" class=\"w-full bg-primary text-white py-3 px-4 rounded-lg font-bold hover:bg-secondary transition duration-300\">Place Order</button>\n            </form>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"bg-gray-800 text-white py-12\">\n        <div class=\"container mx-auto px-6\">\n            <div class=\"grid grid-cols-1 md:grid-cols-3 gap-8\">\n                <div>\n                    <h3 class=\"text-xl font-bold mb-4\">Slice Heaven</h3>\n                    <p class=\"text-gray-400\">Delivering delicious pizzas since 2010. Fresh ingredients, authentic recipes, and fast delivery.</p>\n                </div>\n                <div>\n                    <h3 class=\"text-xl font-bold mb-4\">Quick Links</h3>\n                    <ul class=\"space-y-2\">\n                        <li><a href=\"#\" class=\"text-gray-400 hover:text-white transition duration-300\">Home</a></li>\n                        <li><a href=\"#menu\" class=\"text-gray-400 hover:text-white transition duration-300\">Menu</a></li>\n                        <li><a href=\"#about\" class=\"text-gray-400 hover:text-white transition duration-300\">About Us</a></li>\n                        <li><a href=\"#order\" class=\"text-gray-400 hover:text-white transition duration-300\">Order Online</a></li>\n                    </ul>\n                </div>\n                <div>\n                    <h3 class=\"text-xl font-bold mb-4\">Contact Us</h3>\n                    <ul class=\"space-y-2\">\n                        <li class=\"flex items-center\">\n                            <svg class=\"w-5 h-5 mr-2\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z\"></path>\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M15 11a3 3 0 11-6 0 3 3 0 016 0z\"></path>\n                            </svg>\n                            <span class=\"text-gray-400\">123 Pizza Street, Foodville</span>\n                        </li>\n                        <li class=\"flex items-center\">\n                            <svg class=\"w-5 h-5 mr-2\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z\"></path>\n                            </svg>\n                            <span class=\"text-gray-400\">(123) 456-7890</span>\n                        </li>\n                        <li class=\"flex items-center\">\n                            <svg class=\"w-5 h-5 mr-2\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z\"></path>\n                            </svg>\n                            <span class=\"text-gray-400\">info@sliceheaven.com</span>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"border-t border-gray-700 mt-8 pt-8 text-center text-gray-400\">\n                <p>&copy; 2023 Slice Heaven. All rights reserved.</p>\n            </div>\n        </div>\n    </footer>\n\n    <!-- Mobile Menu Toggle Script -->\n    <script>\n        const btn = document.querySelector(\"button.mobile-menu-button\");\n        const menu = document.querySelector(\".mobile-menu\");\n\n        btn.addEventListener(\"click\", () => {\n            menu.classList.toggle(\"hidden\");\n        });\n    </script>\n</body>\n</html>"
  }
}
