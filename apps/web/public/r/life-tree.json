m-1/4 left-2/3 w-10 h-10 text-moss opacity-60 animate-float leaf-rustle\\\" style=\\\"--delay: 2.5;\\\">\\n                <svg viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"1\\\">\\n                    <path d=\\\"M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5 3.87M12 2v8m0-8a10 10 0 0 0-10 10 4 4 0 0 0 5 3.87\\\"/>\\n                </svg>\\n            </div>\\n            \\n            <!-- Decorative circles - more visible -->\\n            <div class=\\\"absolute top-1/4 left-1/4 w-64 h-64 rounded-full bg-moss-light opacity-15 mix-blend-multiply filter blur-xl animate-pulse-slow\\\"></div>\\n            <div class=\\\"absolute bottom-1/3 right-1/4 w-96 h-96 rounded-full bg-clay-light opacity-15 mix-blend-multiply filter blur-xl animate-pulse-slow\\\" style=\\\"animation-delay: 2s;\\\"></div>\\n            \\n            <!-- Subtle grid pattern - enhanced -->\\n            <div class=\\\"absolute inset-0 opacity-10\\\" style=\\\"background-image: radial-gradient(#5a7247 1px, transparent 1px); background-size: 25px 25px;\\\"></div>\\n        </div>\\n        \\n        <!-- Content container -->\\n        <div class=\\\"container mx-auto px-6 py-24 relative z-10\\\">\\n            <div class=\\\"flex flex-col lg:flex-row items-center gap-12\\\">\\n                <!-- Text content -->\\n                <div class=\\\"lg:w-1/2 space-y-8\\\">\\n                    <span class=\\\"inline-block px-4 py-2 bg-moss bg-opacity-15 text-moss rounded-full text-sm font-medium tracking-wide animate-pulse-slow\\\">\\n                        The Art of Patience\\n                    </span>\\n                    \\n                    <h1 class=\\\"text-5xl md:text-6xl lg:text-7xl font-serif font-semibold leading-tight\\\">\\n                        Cultivate <span class=\\\"text-moss underline decoration-clay decoration-4 underline-offset-8\\\">Serenity</span> with Ancient Bonsai\\n                    </h1>\\n                    \\n                    <p class=\\\"text-lg md:text-xl text-moss-dark opacity-90 leading-relaxed max-w-2xl\\\">\\n                        Discover the meditative practice of bonsai cultivation with our curated collection of miniature masterpieces. Each tree tells a story of time, care, and harmony with nature.\\n                    </p>\\n                    \\n                    <div class=\\\"flex flex-col sm:flex-row gap-4 pt-4\\\">\\n                        <button class=\\\"px-8 py-4 bg-moss hover:bg-moss-light text-white rounded-lg font-medium transition-all duration-300 transform hover:-translate-y-1 shadow-lg hover:shadow-xl active:scale-95\\\">\\n                            Explore Collection\\n                        </button>\\n                        <button class=\\\"px-8 py-4 border-2 border-moss text-moss hover:bg-moss hover:text-white rounded-lg font-medium transition-all duration-300 active:scale-95\\\">\\n                            Learn the Art\\n                        </button>\\n                    </div>\\n                </div>\\n                \\n                <!-- Image/content -->\\n                <div class=\\\"lg:w-1/2 relative\\\">\\n                    <div class=\\\"relative max-w-lg mx-auto\\\">\\n                        <!-- Main image container with decorative elements -->\\n                        <div class=\\\"relative z-10 rounded-2xl overflow-hidden shadow-2xl transform rotate-1 hover:rotate-0 transition-transform duration-500\\\">\\n                            <img src=\\\"https://images.unsplash.com/photo-1526397751294-331021109fbd?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80\\\" \\n                                 alt=\\\"Beautiful bonsai tree\\\" \\n                                 class=\\\"w-full h-auto object-cover\\\">\\n                        </div>\\n                        \\n                        <!-- Decorative elements - more visible -->\\n                        <div class=\\\"absolute -bottom-6 -left-6 w-32 h-32 bg-clay-light rounded-lg opacity-80 -z-10 animate-float\\\" style=\\\"animation-delay: 0.3s;\\\"></div>\\n                        <div class=\\\"absolute -top-6 -right-6 w-24 h-24 bg-moss rounded-full opacity-25 -z-10 animate-float\\\" style=\\\"animation-delay: 0.7s;\\\"></div>\\n                        \\n                        <!-- Floating bonsai tool icons - enhanced -->\\n                        <div class=\\\"absolute -top-12 left-1/4 w-16 h-16 bg-white p-3 rounded-full shadow-md animate-float hover:animate-none hover:scale-110 transition-transform duration-300\\\">\\n                            <img src=\\\"https://cdn-icons-png.flaticon.com/512/2972/2972104.png\\\" alt=\\\"Pruning shears\\\" class=\\\"w-full h-full object-contain\\\">\\n                        </div>\\n                        <div class=\\\"absolute -bottom-8 right-8 w-14 h-14 bg-white p-2 rounded-full shadow-md animate-float hover:animate-none hover:scale-110 transition-transform duration-300\\\" style=\\\"animation-delay: 1.5s;\\\">\\n                            <img src=\\\"https://cdn-icons-png.flaticon.com/512/2972/2972132.png\\\" alt=\\\"Watering can\\\" class=\\\"w-full h-full object-contain\\\">\\n                        </div>\\n                    </div>\\n                </div>\\n            </div>\\n        </div>\\n        \\n        <!-- Scrolling indicator - enhanced -->\\n        <div class=\\\"absolute bottom-8 left-1/2 transform -translate-x-1/2 z-20\\\">\\n            <div class=\\\"flex flex-col items-center animate-bounce\\\">\\n                <span class=\\\"text-xs font-sans text-moss-dark opacity-80 mb-2\\\">Scroll Down</span>\\n                <div class=\\\"w-6 h-10 rounded-full border-2 border-moss border-opacity-50 flex justify-center p-1\\\">\\n                    <div class=\\\"w-1 h-2 bg-moss rounded-full animate-bounce\\\" style=\\\"animation-delay: 0.2s;\\\"></div>\\n                </div>\\n            </div>\\n        </div>\\n    </section>\\n</body>\\n