      "content": "import * as React from \"react\"\n\nfunction UserFeedbackCard({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"user-feedback-card\"\n      className={className}\n      {...props}\n    >\n      <div className=\"w-full h-screen bg-gray-200 px-10 pt-10\">\n          <div className=\"relative mt-16 mb-32 max-w-sm mx-auto mt-24\">\n              <div className=\"rounded-lg overflow-hidden shadow-lg bg-gray-50\">\n                  <div className=\"absolute -mt-16 w-full flex justify-center\">\n                      <div className=\"h-36 w-36 border-4 border-gray-200 rounded-md\">\n                          <img src=\"https://img.freepik.com/free-photo/handsome-bearded-guy-posing-against-white-wall_273609-20597.jpg?size=626&ext=jpg&ga=GA1.1.1369675164.1715299200&semt=sph\" className=\"rounded-md object-cover h-full w-full shadow-lg\" alt=\"Hamza ali\" />\n                      </div>\n                  </div>\n                  <div className=\"px-6 mt-20\">\n                      <h1 className=\"font-semibold text-4xl text-center mb-1 text-blue-600\">Hamza Ali</h1>\n                      <p className=\"text-gray-700 text-sm text-center italic\">Frontend Developer</p>\n                      <p className=\"text-center text-gray-500 text-base pt-4 font-light\">\n                          Working with Anum has been an absolute pleasure. Her dedication\n                          to her craft is unmatched, and her attention to detail is\n                          commendable.\n                      </p>\n                      <div className=\"flex justify-center mt-4\">\n                          <button className=\"px-4 py-2 bg-blue-500 text-white rounded hover600\">Connect</button>\n                      </div>\n                  </div>\n              </div>\n          </div>\n      </div>\n    </div>\n  )\n}\n\nexport { UserFeedbackCard }\n",
      "type": "registry:ui"
    }
