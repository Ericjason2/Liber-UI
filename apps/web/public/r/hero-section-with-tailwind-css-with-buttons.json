er md[400px] lg[500px]\" \n            src=\"https://plus.unsplash.com/premium_photo-1689568126014-06fea9d5d341?fm=jpg&q=60&w=3000&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MXx8cHJvZmlsZXxlbnwwfHwwfHx8MA%3D%3D\" \n            alt=\"Any Image Here\" \n          />\n        </div>\n      </div>\n    </section>\n    </div>\n  );\n}\n",
