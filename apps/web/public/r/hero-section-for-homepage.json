-5 md:w-1/2 md:pb-20 md:pt-10 md:pl-10\">\r\n        <div class=\"relative w-full p-3 rounded  md:p-8\">\r\n            <div class=\"rounded-lg bg-white text-black w-full\">\r\n                <img src=\"https://picsum.photos/400/300\" />\r\n            </div>\r\n        </div>\r\n    </div>\r\n</div>"
