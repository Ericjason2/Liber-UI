0 ease-in-out bg-white border border-transparent rounded-md hover600 focus focus md4 md md10\">\r\n                            Contribute\r\n                        </a>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n        <div className=\"flex items-center py-5 md1/2 md20 md10 md10\">\r\n            <div className=\"relative w-full p-3 rounded  md8\">\r\n                <div className=\"rounded-lg bg-white text-black w-full\">\r\n                    <img src=\"https://picsum.photos/400/300\" />\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\n    </div>\n  );\n}\n",
