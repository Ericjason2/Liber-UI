      "content": "/**\n * Component: Records Form - HPower\n * Author: @anonymous (https://tailwindflex.com/@anonymous)\n * Source: https://tailwindflex.com/@anonymous/records-form-hpower\n * Attribution: Créé par @anonymous sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function RecordsFormHpower() {\n  return (\n    <div>\n    <div className=\"bg-white border rounded-lg px-8 py-6 mx-auto my-8 max-w-3x3\">\n        <h2 className=\"text-2xl font-large font-bold mb-4\">Records Survey</h2>\n        <form>\n            <div className=\"mb-4\">\n                <label htmlFor=\"doverNumber\" className=\"block text-gray-700 font-medium mb-2\">Existing Dover Job Number</label>\n                <input type=\"text\" id=\"doverNumber\" name=\"doverNumber\"\n                    className=\"border border-gray-400 p-2 w-full rounded-lg focus focus400\" required />\n            </div>\n            <div className=\"mb-4\">\n                <label htmlFor=\"jobNumber\" className=\"block text-gray-700 font-medium mb-2\">Job Number</label>\n                <input type=\"text\" id=\"jobNumber\" name=\"jobNumber\"\n                    className=\"border border-gray-400 p-2 w-full rounded-lg focus focus400\" required />\n            </div>\n            <div className=\"mb-4\">\n                <label htmlFor=\"elevatorClass\" className=\"block text-gray-700 font-medium mb-2\">Elevator Class</label>\n                <select id=\"elevatorClass\" name=\"elevatorClass\"\n                    className=\"border border-gray-400 p-2 w-full rounded-lg focus focus400\" required>\n                    <option value=\"\"></option>\n                    <option value=\"passenger\">Passenger</option>\n                    <option value=\"freight\">Freight</option>\n                </select>\n            </div>\n            <h4 className=\"text-2xl font-medium mb-4\">Capacity | Up & Down Speed | Motor HP</h4>\n            <div className=\"mb-4\">\n                <label htmlFor=\"capacity\" className=\"block text-gray-700 font-medium mb-2\">Capacity</label>\n                <input type=\"number\" id=\"capacity\" name=\"capacity\"\n                    className=\"border border-gray-400 p-2 w-full rounded-lg focus focus400\" required />\n            </div>\n            <div className=\"mb-4\">\n                <label htmlFor=\"upSpeed\" className=\"block text-gray-700 font-medium mb-2\">Up Speed</label>\n                <input type=\"number\" id=\"upSpeed\" name=\"upSpeed\"\n                    className=\"border border-gray-400 p-2 w-full rounded-lg focus focus400\" required />\n            </div>\n            <div className=\"mb-4\">\n                <label htmlFor=\"downSpeed\" className=\"block text-gray-700 font-medium mb-2\">Down Speed</label>\n                <input type=\"number\" id=\"downSpeed\" name=\"downSpeed\"\n                    className=\"border border-gray-400 p-2 w-full rounded-lg focus focus400\" required />\n            </div>\n            <div className=\"mb-4\">\n                <label htmlFor=\"motorHP\" className=\"block text-gray-700 font-medium mb-2\">Motor HP</label>\n                <input type=\"number\" id=\"motorHP\" name=\"motorHP\"\n                    className=\"border border-gray-400 p-2 w-full rounded-lg focus focus400\" required />\n            </div>\n            <h4 className=\"text-2xl font-medium mb-4\">Landings / Openings</h4>\n            <div className=\"mb-4\">\n                <label htmlFor=\"landings\" className=\"block text-gray-700 font-medium mb-2\">Landings</label>\n                <input type=\"number\" id=\"landings\" name=\"landings\"\n                    className=\"border border-gray-400 p-2 w-full rounded-lg focus focus400\" required />\n            </div>\n            <div className=\"mb-4\">\n                <label htmlFor=\"fopenings\" className=\"block text-gray-700 font-medium mb-2\">Front Openings</label>\n                <input type=\"number\" id=\"fopenings\" name=\"fopenings\"\n                    className=\"border border-gray-400 p-2 w-full rounded-lg focus focus400\" required />\n            </div>\n            <div className=\"mb-4\">\n                <label htmlFor=\"ropenings\" className=\"block text-gray-700 font-medium mb-2\">Rear Openings</label>\n                <input type=\"number\" id=\"ropenings\" name=\"ropenings\"\n                    className=\"border border-gray-400 p-2 w-full rounded-lg focus focus400\" required />\n            </div>\n            <h4 className=\"text-2xl font-medium mb-4\">Jack - Plunger Diameter</h4>\n            <div className=\"mb-4\">\n                <label htmlFor=\"plungerDiameter\" className=\"block text-gray-700 font-medium mb-2\">Plunger Diameter</label>\n                <select id=\"plungerDiameter\" name=\"plungerDiameter\"\n                    className=\"border border-gray-400 p-2 w-full rounded-lg focus focus400\" required>\n                    <option value=\"\"></option>\n                    <option value=\"2-s\">2-S</option>\n                    <option value=\"3-s\">3-S</option>\n                    <option value=\"4-s\">4-S</option>\n                    <option value=\"5-s\">5-S</option>\n                    <option value=\"6-s\">6-S</option>\n                </select>\n            </div>\n            <div className=\"mb-4\">\n                <label htmlFor=\"notes\" className=\"block text-gray-700 font-medium mb-2\">Notes</label>\n                <textarea id=\"notes\" name=\"notes\"\n                    className=\"border border-gray-400 p-2 w-full rounded-lg focus focus400\" rows=\"5\"></textarea>\n            </div>\n            <div>\n                <button type=\"submit\" className=\"bg-blue-500 text-white px-4 py-2 rounded-lg hover600\">Submit</button>\n            </div>\n    \n        </form>\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
