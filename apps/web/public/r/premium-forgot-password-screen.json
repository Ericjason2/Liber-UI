troke-width=\"1.8\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M3 7l9 6 9-6\"/>\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M21 7v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7\"/>\n              </svg>\n            </span>\n            <input\n              type=\"email\"\n              placeholder=\"john@example.com\"\n              class=\"w-full rounded-xl border border-slate-200 bg-white py-3 pl-11 pr-4 text-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100\"\n            >\n          </div>\n        </div>\n        <button class=\"w-full rounded-xl bg-slate-900 py-3.5 text-sm font-semibold text-white shadow-lg shadow-slate-900/20 transition hover:bg-slate-800\">\n          Send Reset Link\n        </button>\n      </form>\n      <div class=\"mt-6 rounded-2xl border border-emerald-100 bg-emerald-50 p-4\">\n        <div class=\"flex items-start gap-3\">\n          <div class=\"flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-100\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-emerald-600\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"1.8\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M12 3l8 4v5c0 5-3.5 9.5-8 11-4.5-1.5-8-6-8-11V7l8-4z\"/>\n            </svg>\n          </div>\n          <div>\n            <h3 class=\"text-sm font-semibold text-emerald-900\">Your account is protected</h3>\n            <p class=\"mt-1 text-xs leading-5 text-emerald-700\">\n              We only send password reset links to verified email addresses.\n            </p>\n          </div>\n        </div>\n      </div>\n      <p class=\"mt-8 text-center text-sm text-slate-500\">\n        Remember your password?\n        <a href=\"#\" class=\"font-semibold text-slate-900 hover:underline\">\n          Sign in\n        </a>\n      </p>\n    </div>\n  </div>\n</div>"
