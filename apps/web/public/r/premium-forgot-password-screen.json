      "content": "/**\n * Component: Forgot Password Screen\n * Author: @jugendra-gangwar (https://tailwindflex.com/@jugendra-gangwar)\n * Source: https://tailwindflex.com/@jugendra-gangwar/premium-forgot-password-screen\n * Attribution: Créé par @jugendra-gangwar sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function PremiumForgotPasswordScreen() {\n  return (\n    <div>\n    <div className=\"min-h-screen bg-gradient-to-br from-slate-100 via-white to-indigo-100 flex items-center justify-center p-6\">\n      <div className=\"w-full max-w-md\">\n        <a href=\"#\" className=\"mb-6 inline-flex items-center gap-2 text-sm font-medium text-slate-600 transition hover900\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"h-4 w-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" strokeWidth=\"2\">\n            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M15 19l-7-7 7-7\"/>\n          </svg>\n          Back to login\n        </a>\n        <div className=\"rounded-[28px] border border-white/70 bg-white/80 p-8 shadow-2xl backdrop-blur-xl\">\n          <div className=\"mx-auto flex h-20 w-20 items-center justify-center rounded-3xl bg-indigo-50\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"h-10 w-10 text-indigo-600\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" strokeWidth=\"1.8\">\n              <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M21 12.5V7a2 2 0 0 0-2-2h-3.5L12 2 8.5 5H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h6\"/>\n              <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M16 19l2 2 4-4\"/>\n            </svg>\n          </div>\n          <div className=\"mt-6 text-center\">\n            <h1 className=\"text-3xl font-bold text-slate-900\">Forgot Password?</h1>\n            <p className=\"mt-3 text-sm leading-6 text-slate-500\">\n              No worries. Enter your email address and we'll send you a secure password reset link.\n            </p>\n          </div>\n          <form className=\"mt-8 space-y-5\">\n            <div>\n              <label className=\"mb-2 block text-sm font-medium text-slate-700\">\n                Email Address\n              </label>\n              <div className=\"relative\">\n                <span className=\"pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4\">\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"h-5 w-5 text-slate-400\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" strokeWidth=\"1.8\">\n                    <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M3 7l9 6 9-6\"/>\n                    <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M21 7v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7\"/>\n                  </svg>\n                </span>\n                <input\n                  type=\"email\"\n                  placeholder=\"john.com\"\n                  className=\"w-full rounded-xl border border-slate-200 bg-white py-3 pl-11 pr-4 text-sm outline-none transition focus500 focus4 focus100\"\n                 />\n              </div>\n            </div>\n            <button className=\"w-full rounded-xl bg-slate-900 py-3.5 text-sm font-semibold text-white shadow-lg shadow-slate-900/20 transition hover800\">\n              Send Reset Link\n            </button>\n          </form>\n          <div className=\"mt-6 rounded-2xl border border-emerald-100 bg-emerald-50 p-4\">\n            <div className=\"flex items-start gap-3\">\n              <div className=\"flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-100\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"h-5 w-5 text-emerald-600\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" strokeWidth=\"1.8\">\n                  <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M12 3l8 4v5c0 5-3.5 9.5-8 11-4.5-1.5-8-6-8-11V7l8-4z\"/>\n                </svg>\n              </div>\n              <div>\n                <h3 className=\"text-sm font-semibold text-emerald-900\">Your account is protected</h3>\n                <p className=\"mt-1 text-xs leading-5 text-emerald-700\">\n                  We only send password reset links to verified email addresses.\n                </p>\n              </div>\n            </div>\n          </div>\n          <p className=\"mt-8 text-center text-sm text-slate-500\">\n            Remember your password?\n            <a href=\"#\" className=\"font-semibold text-slate-900 hover\">\n              Sign in\n            </a>\n          </p>\n        </div>\n      </div>\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
