und\"\r\n                    strokeLinejoin=\"round\"\r\n                    d=\"M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5\"\r\n                  />\r\n                </svg>\r\n              </label>\r\n              <label htmlFor=\"nav-toggle\" className=\"hidden fixed group-has-[:checked]:block top-0 left-0 right-0 bottom-0 bg-black/10 z-0\"></label>\r\n            </section>\r\n          </header>\n    </div>\n  )\n}\n\nexport { ResponsiveNavbarUsingCssOnly }\n",
