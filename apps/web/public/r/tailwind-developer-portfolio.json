    "mention": "Créé par @irahoza-daniel sur TailwindFlex",
    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Irahoza Daniel- Professional Portfolio</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <script>\n        tailwind.config = {\n            theme: {\n                extend: {\n                    colors: {\n                        primary: '#0f172a',\n                        secondary: '#1e293b',\n                        accent: '#3b82f6',\n                        light: '#f8fafc'\n                    }\n                }\n            }\n        }\n    </script>\n</head>\n<body class=\"bg-gradient-to-br from-slate-50 to-blue-50\">\n    <!-- Navigation -->\n    <nav class=\"fixed top-0 w-full bg-white/90 backdrop-blur-md shadow-sm z-50\">\n        <div class=\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8\">\n            <div class=\"flex justify-between items-center py-4\">\n                <div class=\"text-2xl font-bold text-slate-800\">Irahoza Daniel</div>\n                <div class=\"hidden md:flex space-x-8\">\n                    <a href=\"#home\" class=\"text-slate-600 hover:text-blue-600 transition-colors\">Home</a>\n                    <a href=\"#about\" class=\"text-slate-600 hover:text-blue-600 transition-colors\">About</a>\n                    <a href=\"#services\" class=\"text-slate-600 hover:text-blue-600 transition-colors\">Services</a>\n                    <a href=\"#portfolio\" class=\"text-slate-600 hover:text-blue-600 transition-colors\">Portfolio</a>\n                    <a href=\"#contact\" class=\"text-slate-600 hover:text-blue-600 transition-colors\">Contact</a>\n                </div>\n                <button class=\"md:hidden\">\n                    <svg class=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 6h16M4 12h16M4 18h16\"></path>\n                    </svg>\n                </button>\n            </div>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section id=\"home\" class=\"pt-20 pb-16 px-4 sm:px-6 lg:px-8\">\n        <div class=\"max-w-6xl mx-auto\">\n            <div class=\"grid lg:grid-cols-2 gap-12 items-center min-h-screen\">\n                <div class=\"space-y-8\">\n                    <div>\n                        <p class=\"text-blue-600 font-medium text-lg mb-2\">Hello, I'm</p>\n                        <h1 class=\"text-5xl lg:text-6xl font-bold text-slate-800 leading-tight\">\n                          Irahoza Daniel\n                        </h1>\n                        <h2 class=\"text-2xl lg:text-3xl text-slate-600 mt-4\">\n                            Full Stack Developer & UI/UX Designer\n                        </h2>\n                    </div>\n                    <p class=\"text-lg text-slate-600 leading-relaxed\">\n                        I create beautiful, functional websites and applications that deliver exceptional user experiences. \n                        With expertise in modern web technologies and design principles, I bring ideas to life.\n                    </p>\n                    <div class=\"flex flex-col sm:flex-row gap-4\">\n                        <button class=\"bg-blue-600 text-white px-8 py-3 rounded-lg hover:bg-blue-700 transition-colors font-medium\">\n                            View My Work\n                        </button>\n                        <button class=\"border-2 border-slate-300 text-slate-700 px-8 py-3 rounded-lg hover:border-blue-600 hover:text-blue-600 transition-colors font-medium\">\n                            Download CV\n                        </button>\n                    </div>\n                    <div class=\"flex space-x-6\">\n                        <a href=\"#\" class=\"text-slate-600 hover:text-blue-600 transition-colors\">\n                            <svg class=\"w-6 h-6\" fill=\"currentColor\" viewBox=\"0 0 24 24\">\n                                <path d=\"M22.46 6c-.77.35-1.6.58-2.46.69.88-.53 1.56-1.37 1.88-2.38-.83.5-1.75.85-2.72 1.05C18.37 4.5 17.26 4 16 4c-2.35 0-4.27 1.92-4.27 4.29 0 .34.04.67.11.98C8.28 9.09 5.11 7.38 3 4.79c-.37.63-.58 1.37-.58 2.15 0 1.49.75 2.81 1.91 3.56-.71 0-1.37-.2-1.95-.5v.03c0 2.08 1.48 3.82 3.44 4.21a4.22 4.22 0 0 1-1.93.07 4.28 4.28 0 0 0 4 2.98 8.521 8.521 0 0 1-5.33 1.84c-.34 0-.68-.02-1.02-.06C3.44 20.29 5.7 21 8.12 21 16 21 20.33 14.46 20.33 8.79c0-.19 0-.37-.01-.56.84-.6 1.56-1.36 2.14-2.23z\"/>\n                            </svg>\n                        </a>\n                        <a href=\"#\" class=\"text-slate-600 hover:text-blue-600 transition-colors\">\n                            <svg class=\"w-6 h-6\" fill=\"currentColor\" viewBox=\"0 0 24 24\">\n                                <path d=\"M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z\"/>\n                            </svg>\n                        </a>\n                        <a href=\"#\" class=\"text-slate-600 hover:text-blue-600 transition-colors\">\n                            <svg class=\"w-6 h-6\" fill=\"currentColor\" viewBox=\"0 0 24 24\">\n                                <path d=\"M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z\"/>\n                            </svg>\n                        </a>\n                    </div>\n                </div>\n                <div class=\"relative\">\n                    <div class=\"w-80 h-80 mx-auto relative\">\n                        <div class=\"absolute inset-0 bg-gradient-to-r from-blue-400 to-purple-500 rounded-full blur-2xl opacity-30\"></div>\n                        <img src=\"https://images.unsplash.com/photo-1602992708529-c9fdb12905c9?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w0NzEyNjZ8MHwxfHNlYXJjaHw1fHxkZXZlbG9wZXJ8ZW58MHwwfHx8MTc0Nzg5MDUyNXww&ixlib=rb-4.1.0&q=80&w=1080\" alt=\"Profile\" class=\"relative z-10 w-full h-full object-cover rounded-full border-8 border-white shadow-2xl\">\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- About Section -->\n    <section id=\"about\" class=\"py-20 bg-white\">\n        <div class=\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8\">\n            <div class=\"text-center mb-16\">\n                <h2 class=\"text-4xl font-bold text-slate-800 mb-4\">About Me</h2>\n                <p class=\"text-xl text-slate-600\">Get to know more about my background and expertise</p>\n            </div>\n            <div class=\"grid lg:grid-cols-2 gap-12 items-center\">\n                <div>\n                    <img src=\"https://images.unsplash.com/photo-1602992708529-c9fdb12905c9?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w0NzEyNjZ8MHwxfHNlYXJjaHw1fHxkZXZlbG9wZXJ8ZW58MHwwfHx8MTc0Nzg5MDUyNXww&ixlib=rb-4.1.0&q=80&w=1080\" alt=\"About\" class=\"rounded-2xl shadow-xl\">\n                </div>\n                <div class=\"space-y-6\">\n                    <p class=\"text-lg text-slate-600 leading-relaxed\">\n                        With over 5 years of experience in web development and design, I specialize in creating \n                        digital experiences that combine beautiful aesthetics with seamless functionality.\n                    </p>\n                    <p class=\"text-lg text-slate-600 leading-relaxed\">\n                        My passion lies in solving complex problems through innovative solutions, always keeping \n                        the user at the center of every decision. I believe great design is invisible – it just works.\n                    </p>\n                    <div class=\"grid grid-cols-2 gap-4 pt-4\">\n                        <div class=\"bg-blue-50 p-4 rounded-lg\">\n                            <h3 class=\"font-semibold text-slate-800 mb-2\">Frontend</h3>\n                            <p class=\"text-slate-600 text-sm\">React, Vue, Angular, TypeScript</p>\n                        </div>\n                        <div class=\"bg-blue-50 p-4 rounded-lg\">\n                            <h3 class=\"font-semibold text-slate-800 mb-2\">Backend</h3>\n                            <p class=\"text-slate-600 text-sm\">Node.js, Python, PHP, APIs</p>\n                        </div>\n                        <div class=\"bg-blue-50 p-4 rounded-lg\">\n                            <h3 class=\"font-semibold text-slate-800 mb-2\">Design</h3>\n                            <p class=\"text-slate-600 text-sm\">Figma, Adobe XD, UI/UX</p>\n                        </div>\n                        <div class=\"bg-blue-50 p-4 rounded-lg\">\n                            <h3 class=\"font-semibold text-slate-800 mb-2\">Tools</h3>\n                            <p class=\"text-slate-600 text-sm\">Git, Docker, AWS, Vercel</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Services Section -->\n    <section id=\"services\" class=\"py-20 bg-slate-50\">\n        <div class=\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8\">\n            <div class=\"text-center mb-16\">\n                <h2 class=\"text-4xl font-bold text-slate-800 mb-4\">My Services</h2>\n                <p class=\"text-xl text-slate-600\">What I can do for you</p>\n            </div>\n            <div class=\"grid md:grid-cols-2 lg:grid-cols-3 gap-8\">\n                <div class=\"bg-white p-8 rounded-2xl shadow-lg hover:shadow-xl transition-shadow\">\n                    <div class=\"w-16 h-16 bg-blue-100 rounded-xl flex items-center justify-center mb-6\">\n                        <svg class=\"w-8 h-8 text-blue-600\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4\"/>\n                        </svg>\n                    </div>\n                    <h3 class=\"text-xl font-semibold text-slate-800 mb-4\">Web Development</h3>\n                    <p class=\"text-slate-600\">Custom websites and web applications built with modern technologies and best practices.</p>\n                </div>\n                <div class=\"bg-white p-8 rounded-2xl shadow-lg hover:shadow-xl transition-shadow\">\n                    <div class=\"w-16 h-16 bg-purple-100 rounded-xl flex items-center justify-center mb-6\">\n                        <svg class=\"w-8 h-8 text-purple-600\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zM21 5a2 2 0 00-2-2h-4a2 2 0 00-2 2v12a4 4 0 004 4h4a2 2 0 002-2V5z\"/>\n                        </svg>\n                    </div>\n                    <h3 class=\"text-xl font-semibold text-slate-800 mb-4\">UI/UX Design</h3>\n                    <p class=\"text-slate-600\">Beautiful, user-centered designs that create memorable experiences and drive results.</p>\n                </div>\n                <div class=\"bg-white p-8 rounded-2xl shadow-lg hover:shadow-xl transition-shadow\">\n                    <div class=\"w-16 h-16 bg-green-100 rounded-xl flex items-center justify-center mb-6\">\n                        <svg class=\"w-8 h-8 text-green-600\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z\"/>\n                        </svg>\n                    </div>\n                    <h3 class=\"text-xl font-semibold text-slate-800 mb-4\">Mobile Apps</h3>\n                    <p class=\"text-slate-600\">Native and cross-platform mobile applications for iOS and Android devices.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Portfolio Section -->\n    <section id=\"portfolio\" class=\"py-20 bg-white\">\n        <div class=\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8\">\n            <div class=\"text-center mb-16\">\n                <h2 class=\"text-4xl font-bold text-slate-800 mb-4\">Featured Work</h2>\n                <p class=\"text-xl text-slate-600\">Some of my recent projects</p>\n            </div>\n            <div class=\"grid md:grid-cols-2 lg:grid-cols-3 gap-8\">\n                <div class=\"group cursor-pointer\">\n                    <div class=\"relative overflow-hidden rounded-2xl\">\n                        <img src=\"https://images.unsplash.com/photo-1602992708529-c9fdb12905c9?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w0NzEyNjZ8MHwxfHNlYXJjaHw1fHxkZXZlbG9wZXJ8ZW58MHwwfHx8MTc0Nzg5MDUyNXww&ixlib=rb-4.1.0&q=80&w=1080\" alt=\"Project 1\" class=\"w-full h-64 object-cover group-hover:scale-110 transition-transform duration-500\">\n                        <div class=\"absolute inset-0 bg-blue-600/90 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center\">\n                            <div class=\"text-center text-white\">\n                                <h3 class=\"text-xl font-semibold mb-2\">E-commerce Platform</h3>\n                                <p class=\"text-sm\">React • Node.js • MongoDB</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"group cursor-pointer\">\n                    <div class=\"relative overflow-hidden rounded-2xl\">\n                        <img src=\"https://images.unsplash.com/photo-1602992708529-c9fdb12905c9?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w0NzEyNjZ8MHwxfHNlYXJjaHw1fHxkZXZlbG9wZXJ8ZW58MHwwfHx8MTc0Nzg5MDUyNXww&ixlib=rb-4.1.0&q=80&w=1080\" alt=\"Project 2\" class=\"w-full h-64 object-cover group-hover:scale-110 transition-transform duration-500\">\n                        <div class=\"absolute inset-0 bg-purple-600/90 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center\">\n                            <div class=\"text-center text-white\">\n                                <h3 class=\"text-xl font-semibold mb-2\">Mobile Banking App</h3>\n                                <p class=\"text-sm\">React Native • Firebase</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"group cursor-pointer\">\n                    <div class=\"relative overflow-hidden rounded-2xl\">\n                        <img src=\"https://images.unsplash.com/photo-1602992708529-c9fdb12905c9?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w0NzEyNjZ8MHwxfHNlYXJjaHw1fHxkZXZlbG9wZXJ8ZW58MHwwfHx8MTc0Nzg5MDUyNXww&ixlib=rb-4.1.0&q=80&w=1080\" alt=\"Project 3\" class=\"w-full h-64 object-cover group-hover:scale-110 transition-transform duration-500\">\n                        <div class=\"absolute inset-0 bg-green-600/90 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center\">\n                            <div class=\"text-center text-white\">\n                                <h3 class=\"text-xl font-semibold mb-2\">SaaS Dashboard</h3>\n                                <p class=\"text-sm\">Vue.js • Python • PostgreSQL</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Contact Section -->\n    <section id=\"contact\" class=\"py-20 bg-slate-900\">\n        <div class=\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8\">\n            <div class=\"text-center mb-16\">\n                <h2 class=\"text-4xl font-bold text-white mb-4\">Let's Work Together</h2>\n                <p class=\"text-xl text-slate-300\">Ready to bring your ideas to life?</p>\n            </div>\n            <div class=\"grid lg:grid-cols-2 gap-12\">\n                <div class=\"space-y-8\">\n                    <div class=\"flex items-center space-x-4\">\n                        <div class=\"w-12 h-12 bg-blue-600 rounded-lg flex items-center justify-center\">\n                            <svg class=\"w-6 h-6 text-white\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z\"/>\n                            </svg>\n                        </div>\n                        <div>\n                            <h3 class=\"text-white font-semibold\">Email</h3>\n                            <p class=\"text-slate-300\">john.doe@example.com</p>\n                        </div>\n                    </div>\n                    <div class=\"flex items-center space-x-4\">\n                        <div class=\"w-12 h-12 bg-blue-600 rounded-lg flex items-center justify-center\">\n                            <svg class=\"w-6 h-6 text-white\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z\"/>\n                            </svg>\n                        </div>\n                        <div>\n                            <h3 class=\"text-white font-semibold\">Phone</h3>\n                            <p class=\"text-slate-300\">+1 (555) 123-4567</p>\n                        </div>\n                    </div>\n                    <div class=\"flex items-center space-x-4\">\n                        <div class=\"w-12 h-12 bg-blue-600 rounded-lg flex items-center justify-center\">\n                            <svg class=\"w-6 h-6 text-white\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z\"/>\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M15 11a3 3 0 11-6 0 3 3 0 016 0z\"/>\n                            </svg>\n                        </div>\n                        <div>\n                            <h3 class=\"text-white font-semibold\">Location</h3>\n                            <p class=\"text-slate-300\">San Francisco, CA</p>\n                        </div>\n                    </div>\n                </div>\n                <form class=\"space-y-6\">\n                    <div class=\"grid md:grid-cols-2 gap-6\">\n                        <input type=\"text\" placeholder=\"Your Name\" class=\"bg-slate-800 text-white p-4 rounded-lg border border-slate-700 focus:border-blue-500 focus:outline-none\">\n                        <input type=\"email\" placeholder=\"Your Email\" class=\"bg-slate-800 text-white p-4 rounded-lg border border-slate-700 focus:border-blue-500 focus:outline-none\">\n                    </div>\n                    <input type=\"text\" placeholder=\"Subject\" class=\"w-full bg-slate-800 text-white p-4 rounded-lg border border-slate-700 focus:border-blue-500 focus:outline-none\">\n                    <textarea placeholder=\"Your Message\" rows=\"6\" class=\"w-full bg-slate-800 text-white p-4 rounded-lg border border-slate-700 focus:border-blue-500 focus:outline-none\"></textarea>\n                    <button type=\"submit\" class=\"w-full bg-blue-600 text-white py-4 rounded-lg hover:bg-blue-700 transition-colors font-medium\">\n                        Send Message\n                    </button>\n                </form>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"bg-slate-800 py-8\">\n        <div class=\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8\">\n            <div class=\"text-center text-slate-400\">\n                <p>&copy; 2024 John Doe. All rights reserved.</p>\n            </div>\n        </div>\n    </footer>\n\n    <script>\n        // Smooth scrolling for navigation links\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function (e) {\n                e.preventDefault();\n                document.querySelector(this.getAttribute('href')).scrollIntoView({\n                    behavior: 'smooth'\n                });\n            });\n        });\n\n        // Mobile menu toggle (basic implementation)\n        const mobileMenuButton = document.querySelector('button');\n        const navigation = document.querySelector('nav div div:last-child');\n        \n        mobileMenuButton.addEventListener('click', () => {\n            navigation.classList.toggle('hidden');\n        });\n    </script>\n</body>\n</html>"
  }
}
