      "content": "import * as React from \"react\"\n\nfunction ArticlePostPreviewCard({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"article-post-preview-card\"\n      className={className}\n      {...props}\n    >\n      <div className=\"px-4 py-4 mx-5 font-normal bg-gray-300 rounded-lg\">\n          <div className=\"flex flex-col justify-between md\">\n              <h3 className=\"mb-2 text-2xl font-semibold leading-snug\">\n                  Use TailwindCSS with Gatsby (with Emotion or styled-components)\n              </h3>\n              <div className=\"flex items-center mb-2 space-x-2\">\n                  <p className=\"px-2 text-gray-200 bg-blue-600 rounded\">#gatsby</p>\n                  <p className=\"px-2 text-gray-800 bg-teal-400 rounded\">#tailwindcss</p>\n                  <p className=\"px-2 text-gray-200 bg-purple-600 rounded\">#css</p>\n              </div>\n          </div>\n          <p className=\"text-gray-700\">\n              Learn how to use TailwindCSS with Gatsby along with Emotion or\n              styled-components perfectly.\n          </p>\n      </div>\n    </div>\n  )\n}\n\nexport { ArticlePostPreviewCard }\n",
      "type": "registry:ui"
    }
