      "content": "/**\n * Component: Elegant Buttons\n * Author: @nickgirga (https://tailwindflex.com/@nickgirga)\n * Source: https://tailwindflex.com/@nickgirga/elegant-buttons\n * Attribution: Créé par @nickgirga sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function ElegantButtons() {\n  return (\n    <div>\n    \r\n    <div className=\"flex flex-row items-center justify-center gap-4 my-8\">\r\n    \r\n        \r\n        <div className=\"flex flex-col gap-4 w-[32mm]\">\r\n    \r\n            \r\n            <button\r\n                className=\"btn\">\r\n                Default\r\n            </button>\r\n    \r\n            \r\n            <button\r\n                className=\"btn btn-primary\">\r\n                Primary\r\n            </button>\r\n    \r\n            \r\n            <button\r\n                className=\"btn btn-secondary\">\r\n                Secondary\r\n            </button>\r\n    \r\n            \r\n            <button\r\n                className=\"btn btn-info\">\r\n                Info\r\n            </button>\r\n    \r\n        </div>\r\n    \r\n        \r\n        <div className=\"flex flex-col gap-4 w-[32mm]\">\r\n    \r\n            \r\n            <button\r\n                className=\"btn btn-success\">\r\n                Success\r\n            </button>\r\n    \r\n            \r\n            <button\r\n                className=\"btn btn-warn\">\r\n                Warn\r\n            </button>\r\n    \r\n            \r\n            <button\r\n                className=\"btn btn-error\">\r\n                Error\r\n            </button>\r\n    \r\n            \r\n            <button\r\n                className=\"btn bg-blue-600 hover700 active800 text-blue-200 hover400 active500\">\r\n                Custom\r\n            </button>\r\n    \r\n        </div>\r\n    \r\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
