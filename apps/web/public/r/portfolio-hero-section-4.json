      "content": "import * as React from \"react\"\n\nfunction PortfolioHeroSection4({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"portfolio-hero-section-4\"\n      className={className}\n      {...props}\n    >\n      <div className=\"w-full h-screen bg-black overflow-\">\n      \n        <div\n          className=\"w-full mx-auto relative bg-[url('https://grenadarevo.com/wp-content/uploads/2018/12/alekzan-powell-507928-unsplash.jpg')] bg-cover bg-no-repeat sm py-20\">\n          <div className=\"absolute md24 md32 sm[7rem] -right-[1rem] top-0 opacity-30 w-[15%] h-[20%] gradiant rounded-full blur-3xl\"></div>\n          <div className=\"absolute md[45%] sm[42%] -left-[40%] opacity-10 w-[50%] h-full my-auto bg-gradient-to-r from-cyan-500 to-blue-500 rounded-full blur-3xl\"></div>\n      \n          <div className=\"w-[80%] mx-auto h-full flex justify-between items-center\">\n            <div className=\"h-full xl[50%] md[60%] sm[70%] w-full text-white flex flex-col gap-2 justify-center\">\n              <h1 className=\"xl7xl lg6xl md5xl text-4xl font-semibold\">Hi there, I am</h1>\n              <h1 className=\"xl7xl lg6xl md5xl text-4xl font-semibold bg-text\">Samuel Abera!</h1>\n              \n              <p className=\"lg3xl sm text-lg lg6 my-2\">I am Experienced full-stack developer with 4+ years of\n                expertise in Laravel, NestJS, Nuxt.js, Next.js, Android, and some Flutter experience.</p>\n      \n              \n              <div className=\"flex sm flex-col gap-4 lg4 mt-2\">\n                <button className=\"md8 px-4 md4 py-2 md text-lg font-semibold rounded-md gradiant cursor-pointer\">Click For Hire Me</button>\n                <button className=\"md8 px-4 md4 py-2 md text-lg font-semibold outline outline-2  rounded-md cursor\">About Me</button>\n              </div>\n            </div>\n            <div></div>\n          </div>\n        </div>\n      </div>\n    </div>\n  )\n}\n\nexport { PortfolioHeroSection4 }\n",
