      "content": "/**\n * Component: Forgot password form (fullscreen)\n * Author: @prajwal (https://tailwindflex.com/@prajwal)\n * Source: https://tailwindflex.com/@prajwal/forgot-password-form-fullscreen\n * Attribution: Créé par @prajwal sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function ForgotPasswordFormFullscreen() {\n  return (\n    <div>\n    <div className=\"min-h-screen bg-gray-100 flex items-center justify-center\">\r\n        <div className=\"bg-white shadow-md rounded px-8 pt-6 pb-8 mb-4 max-w-md w-full\">\r\n            <h1 className=\"text-center text-2xl font-bold mb-6\">Forgot Password</h1>\r\n            <form>\r\n                <div className=\"mb-4\">\r\n                    <label className=\"block text-gray-700 font-bold mb-2\" htmlFor=\"email\">\r\n                        Email Address\r\n                    </label>\r\n                    <input className=\"appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus focus\" id=\"email\" type=\"email\" placeholder=\"Enter your email address\" />\r\n                </div>\r\n                <button className=\"bg-blue-500 hover700 text-white font-bold py-2 px-4 rounded focus focus w-full\" type=\"submit\">\r\n                    Reset Password\r\n                </button>\r\n            </form>\r\n        </div>\r\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
