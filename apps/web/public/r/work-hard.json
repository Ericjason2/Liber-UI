0, 0, 0.03) 1px, transparent 1px);\n            background-size: 40px 40px;\n        }\n        \n        .image-mask {\n            -webkit-mask-image: linear-gradient(to bottom, black 70%, transparent 98%);\n            mask-image: linear-gradient(to bottom, black 70%, transparent 98%);\n        }\n        \n        .nav-blur {\n            backdrop-filter: blur(8px);\n            -webkit-backdrop-filter: blur(8px);\n        }\n        \n        .text-gradient {\n            background-image: linear-gradient(90deg, #000000, #333333, #000000);\n            background-size: 200% auto;\n            color: transparent;\n            -webkit-background-clip: text;\n            background-clip: text;\n        }\n    </style>\n</head>\n<body class=\"min-h-screen bg-white font-sans overflow-x-hidden bg-grid\">\n    <!-- Navigation -->\n    <nav class=\"fixed w-full z-50 nav-blur bg-white/80 border-b border-black/10\">\n        <div class=\"max-w-7xl mx-auto px-6\">\n            <div class=\"relative flex items-center justify-between h-16\">\n                <!-- Logo -->\n                <div class=\"flex-shrink-0 flex items-center\">\n                    <span class=\"text-black font-mono font-bold tracking-tighter text-xl\">FROST</span>\n                    <span class=\"h-6 w-px bg-black/20 mx-4\"></span>\n                    <span class=\"text-sm font-medium text-black/60\">COLD POWER</span>\n                </div>\n                \n                <!-- Desktop Menu -->\n                <div class=\"hidden md:block\">\n                    <div class=\"flex space-x-8\">\n                        <a href=\"#\" class=\"text-black/70 hover:text-black px-1 py-2 text-sm font-medium relative group\">\n                            Home\n                            <span class=\"absolute bottom-0 left-0 w-0 h-px bg-black group-hover:w-full transition-all duration-300\"></span>\n                        </a>\n                        <a href=\"#\" class=\"text-black/70 hover:text-black px-1 py-2 text-sm font-medium relative group\">\n                            Philosophy\n                            <span class=\"absolute bottom-0 left-0 w-0 h-px bg-black group-hover:w-full transition-all duration-300\"></span>\n                        </a>\n                        <a href=\"#\" class=\"text-black/70 hover:text-black px-1 py-2 text-sm font-medium relative group\">\n                            Manifesto\n                            <span class=\"absolute bottom-0 left-0 w-0 h-px bg-black group-hover:w-full transition-all duration-300\"></span>\n                        </a>\n                        <a href=\"#\" class=\"text-black/70 hover:text-black px-1 py-2 text-sm font-medium relative group\">\n                            Contact\n                            <span class=\"absolute bottom-0 left-0 w-0 h-px bg-black group-hover:w-full transition-all duration-300\"></span>\n                        </a>\n                    </div>\n                </div>\n                \n                <!-- Mobile menu button -->\n                <div class=\"md:hidden flex items-center\">\n                    <button class=\"inline-flex items-center justify-center p-2 text-black focus:outline-none\">\n                        <svg class=\"h-6 w-6\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 6h16M4 12h16M4 18h16\" />\n                        </svg>\n                    </button>\n                </div>\n            </div>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"relative pt-24 pb-12 md:pt-32 md:pb-24 h-screen flex items-center\">\n        <!-- Background elements -->\n        <div class=\"absolute inset-0 overflow-hidden\">\n            <div class=\"absolute top-1/4 left-1/4 w-64 h-64 rounded-full bg-black opacity-5 mix-blend-multiply blur-xl\"></div>\n            <div class=\"absolute bottom-1/3 right-1/4 w-96 h-96 rounded-full bg-black opacity-5 mix-blend-multiply blur-xl\"></div>\n            \n            <!-- Grid lines -->\n            <div class=\"absolute inset-0 border-l border-r border-black border-opacity-5\" style=\"width: calc(100% - 4rem); height: calc(100% - 4rem); margin: 2rem;\"></div>\n        </div>\n        \n        <!-- Main content container -->\n        <div class=\"relative z-10 w-full max-w-7xl mx-auto px-6 flex flex-col lg:flex-row items-center justify-between gap-12\">\n            <!-- Text content -->\n            <div class=\"lg:w-1/2 text-center lg:text-left\">\n                <div class=\"mb-8\">\n                    <span class=\"inline-block px-3 py-1 text-xs font-mono bg-black text-white uppercase tracking-widest\">EST. 2024</span>\n                </div>\n                \n                <h1 class=\"text-5xl md:text-7xl font-black uppercase tracking-tighter mb-6 text-black\">\n                    <span class=\"inline-block transform -translate-y-2 opacity-90\">COLD</span>\n                    <span class=\"inline-block transform translate-y-2 opacity-95\">POWER</span>\n                </h1>\n                \n                <p class=\"text-lg md:text-xl text-black/70 mb-8 max-w-lg mx-auto lg:mx-0\">\n                    In a world of noise, we embrace the silence. In a world of heat, we find strength in the cold.\n                </p>\n                \n                <div class=\"relative inline-block mt-8 mb-12\">\n                    <div class=\"absolute -inset-4 border border-black opacity-10\"></div>\n                    <div class=\"absolute -inset-6 border border-black opacity-5\"></div>\n                    \n                    <blockquote class=\"relative text-xl md:text-2xl font-light leading-tight px-8 py-6 bg-white bg-opacity-80 backdrop-blur-sm\">\n                        <p class=\"relative z-10 italic\">\n                            \"The world will not be destroyed by those who do evil,<br>\n                            but by those who watch them without doing anything.\"\n                        </p>\n                        <div class=\"absolute bottom-0 right-0 w-16 h-16 border-b border-r border-black opacity-20\"></div>\n                        <div class=\"absolute top-0 left-0 w-16 h-16 border-t border-l border-black opacity-20\"></div>\n                    </blockquote>\n                </div>\n                \n                <div class=\"flex flex-col sm:flex-row gap-4 mt-12\">\n                    <button class=\"relative px-8 py-3.5 border-2 border-black font-medium uppercase tracking-wider group overflow-hidden\">\n                        <span class=\"relative z-10\">Join Movement</span>\n                        <span class=\"absolute inset-0 bg-black transform -translate-x-full group-hover:translate-x-0 transition-transform duration-500 ease-in-out\"></span>\n                    </button>\n                    <button class=\"relative px-8 py-3.5 border-2 border-black/30 font-medium uppercase tracking-wider group overflow-hidden\">\n                        <span class=\"relative z-10 text-black/70 group-hover:text-black\">Learn More</span>\n                        <span class=\"absolute inset-0 bg-black/5 transform -translate-x-full group-hover:translate-x-0 transition-transform duration-500 ease-in-out\"></span>\n                    </button>\n                </div>\n            </div>\n            \n            <!-- Image aside -->\n            <div class=\"lg:w-1/2 relative mt-12 lg:mt-0 image-mask\">\n                <div class=\"relative w-full h-96 lg:h-[500px] overflow-hidden shadow-2xl\">\n                    <!-- Image with gradient overlay -->\n                    <img \n                        src=\"https://images.unsplash.com/photo-1517649763962-0c623066013b?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1470&q=80\" \n                        alt=\"Cold mountain landscape\"\n                        class=\"w-full h-full object-cover object-center grayscale contrast-125 brightness-90 animate-float\"\n                    />\n                    <!-- Decorative frame elements -->\n                    <div class=\"absolute inset-0 border border-black opacity-10\"></div>\n                    <div class=\"absolute top-4 left-4 right-4 bottom-4 border border-black opacity-5\"></div>\n                    <div class=\"absolute top-0 left-0 w-16 h-16 border-t border-l border-black opacity-20\"></div>\n                    <div class=\"absolute bottom-0 right-0 w-16 h-16 border-b border-r border-black opacity-20\"></div>\n                </div>\n                <div class=\"absolute -bottom-8 -right-8 w-32 h-32 bg-black opacity-5 -z-10\"></div>\n            </div>\n        </div>\n        \n        <!-- Scrolling indicator -->\n        <div class=\"absolute bottom-8 left-1/2 transform -translate-x-1/2\">\n            <div class=\"animate-bounce w-6 h-10 border-2 border-black rounded-full flex justify-center\">\n                <div class=\"w-1 h-2 bg-black rounded-full mt-2\"></div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Decorative corner elements -->\n    <div class=\"fixed top-0 left-0 w-16 h-16 border-t border-l border-black opacity-10 pointer-events-none\"></div>\n    <div class=\"fixed top-0 right-0 w-16 h-16 border-t border-r border-black opacity-10 pointer-events-none\"></div>\n    <div class=\"fixed bottom-0 left-0 w-16 h-16 border-b border-l border-black opacity-10 pointer-events-none\"></div>\n    <div class=\"fixed bottom-0 right-0 w-16 h-16 border-b border-r border-black opacity-10 pointer-events-none\"></div>\n</body>\n</html>"
