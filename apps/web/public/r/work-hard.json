ase tracking-wider group overflow-hidden\\\">\\n                        <span class=\\\"relative z-10\\\">Join Movement</span>\\n                        <span class=\\\"absolute inset-0 bg-black transform -translate-x-full group-hover:translate-x-0 transition-transform duration-500 ease-in-out\\\"></span>\\n                    </button>\\n                    <button class=\\\"relative px-8 py-3.5 border-2 border-black/30 font-medium uppercase tracking-wider group overflow-hidden\\\">\\n                        <span class=\\\"relative z-10 text-black/70 group-hover:text-black\\\">Learn More</span>\\n                        <span class=\\\"absolute inset-0 bg-black/5 transform -translate-x-full group-hover:translate-x-0 transition-transform duration-500 ease-in-out\\\"></span>\\n                    </button>\\n                </div>\\n            </div>\\n            \\n            <!-- Image aside -->\\n            <div class=\\\"lg:w-1/2 relative mt-12 lg:mt-0 image-mask\\\">\\n                <div class=\\\"relative w-full h-96 lg:h-[500px] overflow-hidden shadow-2xl\\\">\\n                    <!-- Image with gradient overlay -->\\n                    <img \\n                        src=\\\"https://images.unsplash.com/photo-1517649763962-0c623066013b?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1470&q=80\\\" \\n                        alt=\\\"Cold mountain landscape\\\"\\n                        class=\\\"w-full h-full object-cover object-center grayscale contrast-125 brightness-90 animate-float\\\"\\n                    />\\n                    <!-- Decorative frame elements -->\\n                    <div class=\\\"absolute inset-0 border border-black opacity-10\\\"></div>\\n                    <div class=\\\"absolute top-4 left-4 right-4 bottom-4 border border-black opacity-5\\\"></div>\\n                    <div class=\\\"absolute top-0 left-0 w-16 h-16 border-t border-l border-black opacity-20\\\"></div>\\n    