ight text-gray-900 sm6xl\">\r\n                    Refreshingly Sustainable:\r\n                    <span className=\"text-blue-600\">Boxed Water\r\n               </span>\r\n                </h1>\r\n                <h2 className=\"mt-6 text-lg leading-8 text-gray-600\">\r\n                    Choose a more eco-friendly way to hydrate with our 100% recyclable cartons.\r\n                </h2>\r\n                <div className=\"mt-10 flex items-center justify-center gap-x-6\">\r\n                    <a className=\"isomorphic-link isomorphic-link--internal inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-4 py-3 text-sm font-semibold text-white shadow-sm transition-all duration-150 hover500 focus-visible focus-visible2 focus-visible2 focus-visible600\"\r\n                        href=\"/login\">Shop Now\r\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"h-4 w-4\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\r\n                            <path fillRule=\"evenodd\"\r\n                                d=\"M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z\"\r\n                                clipRule=\"evenodd\"></path>\r\n                        </svg>\r\n                    </a>\r\n                </div>\r\n            </div>\r\n            <div className=\"relative mx-auto mt-10 max-w-lg\">\r\n                <img className=\"w-full rounded-2xl border border-gray-100 shadow\" src=\"https://images.unsplash.com/photo-1587502536575-6dfba0a6e017\" alt=\"\" />\r\n            </div>\r\n        </div>\r\n    </section>\n    </div>\n  );\n}\n",
