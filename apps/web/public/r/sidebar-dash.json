e-linejoin=\"round\" stroke-width=\"2\" d=\"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z\"></path>\n                        </svg>\n                    </div>\n                </div>\n                        <button id=\"action-button\" class=\"flex items-center gap-2 bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-full transition-colors\">\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" fill=\"#ffffff\" viewBox=\"0 0 24 24\" transform=\"scale(-1,1)\">\n                                <path d=\"m20,9h-8V2c0-.45-.3-.85-.74-.97-.44-.12-.9.07-1.12.46L3.14,13.5c-.18.31-.18.69,0,1s.51.5.87.5h8v7c0,.45.3.85.74.97.09.02.17.03.26.03.35,0,.68-.18.86-.5l7-12c.18-.31.18-.69,0-1s-.51-.5-.87-.5Zm-6,9.3v-4.3c0-.55-.45-1-1-1h-7.26l4.26-7.3v4.3c0,.55.45,1,1,1h7.26l-4.26,7.3Z\"></path>\n                            </svg>\n                            <span class=\"font-medium\">Action</span>\n                        </button>\n\n                        <button id=\"open-sidebar\" class=\"p-2 rounded-lg transition-colors\" aria-label=\"Open menu\">\n                            <svg class=\"w-6 h-6 text-gray-700\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 6h16M4 12h16M4 18h16\"></path>\n                            </svg>\n                        </button>\n\n                        <button class=\"p-2 rounded-full hover:bg-gray-100 transition-colors\" aria-label=\"Notifications\">\n                            <svg class=\"w-6 h-6 text-gray-700\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9\"></path>\n                            </svg>\n                        </button>\n                    \n                    </div>\n                 </div>\n            </div>\n        </header>\n        \n        <!-- Page Content -->\n        <main class=\"flex-1 p-6 overflow-y-auto\">\n            <div class=\"max-w-6xl mx-auto\">\n                <h1 class=\"text-3xl font-bold text-gray-800 mb-2\">Welcome back!</h1>\n                <p class=\"text-gray-600 mb-8\">Here's what's happening with your projects today.</p>\n                \n                <!-- Cards Grid -->\n                <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8\">\n                    <div class=\"bg-white rounded-xl shadow-sm p-6 border border-gray-200\">\n                        <div class=\"flex items-center justify-between mb-4\">\n                            <h3 class=\"font-semibold text-gray-700\">Total Revenue</h3>\n                            <div class=\"w-10 h-10 flex items-center justify-center bg-blue-100 rounded-lg\">\n                                <svg class=\"w-6 h-6 text-blue-600\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"></path>\n                                </svg>\n                            </div>\n                        </div>\n                        <p class=\"text-2xl font-bold text-gray-800\">$24,580</p>\n                        <p class=\"text-sm text-green-600 mt-2\">↑ 12.5% from last month</p>\n                    </div>\n                    \n                    <div class=\"bg-white rounded-xl shadow-sm p-6 border border-gray-200\">\n                        <div class=\"flex items-center justify-between mb-4\">\n                            <h3 class=\"font-semibold text-gray-700\">Active Users</h3>\n                            <div class=\"w-10 h-10 flex items-center justify-center bg-green-100 rounded-lg\">\n                                <svg class=\"w-6 h-6 text-green-600\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13 1h-6\"></path>\n                                </svg>\n                            </div>\n                        </div>\n                        <p class=\"text-2xl font-bold text-gray-800\">1,425</p>\n                        <p class=\"text-sm text-green-600 mt-2\">↑ 8.2% from last month</p>\n                    </div>\n                    \n                    <div class=\"bg-white rounded-xl shadow-sm p-6 border border-gray-200\">\n                        <div class=\"flex items-center justify-between mb-4\">\n                            <h3 class=\"font-semibold text-gray-700\">Tasks Completed</h3>\n                            <div class=\"w-10 h-10 flex items-center justify-center bg-purple-100 rounded-lg\">\n                                <svg class=\"w-6 h-6 text-purple-600\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z\"></path>\n                                </svg>\n                            </div>\n                        </div>\n                        <p class=\"text-2xl font-bold text-gray-800\">84%</p>\n                        <p class=\"text-sm text-green-600 mt-2\">↑ 3.1% from last month</p>\n                    </div>\n                </div>\n                \n                <!-- Sample Content -->\n                <div class=\"bg-white rounded-xl shadow-sm p-6 border border-gray-200\">\n                    <h2 class=\"text-xl font-bold text-gray-800 mb-4\">Recent Activity</h2>\n                    <div class=\"space-y-4\">\n                        <div class=\"flex items-center gap-4 p-3 hover:bg-gray-50 rounded-lg transition-colors\">\n                            <div class=\"w-10 h-10 rounded-full bg-gradient-to-r from-blue-400 to-blue-600\"></div>\n                            <div class=\"flex-1\">\n                                <p class=\"text-gray-800 font-medium\">John Doe completed a task</p>\n                                <p class=\"text-sm text-gray-500\">2 hours ago</p>\n                            </div>\n                        </div>\n                        <div class=\"flex items-center gap-4 p-3 hover:bg-gray-50 rounded-lg transition-colors\">\n                            <div class=\"w-10 h-10 rounded-full bg-gradient-to-r from-green-400 to-green-600\"></div>\n                            <div class=\"flex-1\">\n                                <p class=\"text-gray-800 font-medium\">New project created</p>\n                                <p class=\"text-sm text-gray-500\">4 hours ago</p>\n                            </div>\n                        </div>\n                        <div class=\"flex items-center gap-4 p-3 hover:bg-gray-50 rounded-lg transition-colors\">\n                            <div class=\"w-10 h-10 rounded-full bg-gradient-to-r from-purple-400 to-purple-600\"></div>\n                            <div class=\"flex-1\">\n                                <p class=\"text-gray-800 font-medium\">Monthly report generated</p>\n                                <p class=\"text-sm text-gray-500\">1 day ago</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </main>\n    </div>\n</div>\n\n<script>\n    const sidebar = document.getElementById('sidebar');\n    const overlay = document.getElementById('overlay');\n    const openSidebarButton = document.getElementById('open-sidebar');\n    const actionButton = document.getElementById('action-button');\n    \n    function openSidebar() {\n        sidebar.classList.remove('-translate-x-full');\n        overlay.classList.remove('opacity-0', 'pointer-events-none');\n        overlay.classList.add('opacity-100', 'pointer-events-auto');\n        document.body.style.overflow = 'hidden';\n    }\n    \n    function closeSidebar() {\n        sidebar.classList.add('-translate-x-full');\n        overlay.classList.remove('opacity-100', 'pointer-events-auto');\n        overlay.classList.add('opacity-0', 'pointer-events-none');\n        document.body.style.overflow = 'auto';\n    }\n    \n    openSidebarButton.addEventListener('click', (e) => {\n        e.stopPropagation();\n        openSidebar();\n    });\n    \n    actionButton.addEventListener('click', (e) => {\n        e.stopPropagation();\n        alert('Action button clicked!');\n    });\n    \n    overlay.addEventListener('click', closeSidebar);\n    \n    // Close sidebar with Escape key\n    document.addEventListener('keydown', (e) => {\n        if (e.key === 'Escape') {\n            closeSidebar();\n        }\n    });\n    \n    // Close sidebar when clicking outside on mobile\n    window.addEventListener('resize', () => {\n        if (window.innerWidth >= 768) {\n            closeSidebar();\n        }\n    });\n</script>"
  }
