      "content": "import * as React from \"react\"\n\nfunction CleanCta({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"clean-cta\"\n      className={className}\n      {...props}\n    >\n      <div className=\"bg-red-500 py-12\">\n          <div className=\"max-w-5xl mx-auto px-4 sm6 lg8\">\n              <h2 className=\"text-4xl font-extrabold tracking-tight text-white sm5xl lg6xl\">\n                  Are you panicking yet?\n              </h2>\n              <p className=\"mt-6 text-xl text-white max-w-3xl\">\n                  Don't worry, we're here to help. Contact us now to get the support and guidance you need to get through this\n                  crisis.\n              </p>\n              <div className=\"mt-10\">\n                  <a href=\"#\"\n                      className=\"inline-block bg-white py-3 px-8 border border-transparent rounded-md text-base font-medium text-red-500 hover100 hover600\">\n                      Contact Us\n                  </a>\n              </div>\n          </div>\n      </div>\n    </div>\n  )\n}\n\nexport { CleanCta }\n",
      "type": "registry:ui"
    }
  ],
