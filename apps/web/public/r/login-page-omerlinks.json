 bottom-4 right-2\\\"></div>\\n                    \\n                    <!-- Presse-papier principal -->\\n                    <div class=\\\"relative bg-white text-slate-800 rounded-xl p-4 w-44 shadow-xl border-4 border-blue-400 transform -rotate-3\\\">\\n                        <div class=\\\"w-12 h-3 bg-blue-400 rounded-t-md mx-auto -mt-6 mb-3\\\"></div>\\n                        <div class=\\\"space-y-3\\\">\\n                            <div class=\\\"flex items-center space-x-2\\\">\\n                                <i class=\\\"fa-solid fa-check text-blue-500 text-xs\\\"></i>\\n                                <div class=\\\"h-2 bg-blue-100 rounded w-full\\\"></div>\\n                            </div>\\n                            <div class=\\\"flex items-center space-x-2\\\">\\n                                <i class=\\\"fa-solid fa-xmark text-blue-500 text-xs\\\"></i>\\n                                <div class=\\\"h-2 bg-blue-100 rounded w-full\\\"></div>\\n                            </div>\\n                            <div class=\\\"flex items-center space-x-2\\\">\\n                                <i class=\\\"fa-solid fa-check text-blue-500 text-xs\\\"></i>\\n                                <div class=\\\"h-2 bg-blue-200 rounded w-3/4\\\"></div>\\n                            </div>\\n                        </div>\\n                    </div>\\n\\n                    <!-- Stylo d'illustration -->\\n                    <div class=\\\"absolute bottom-2 left-4 w-28 h-6 bg-cyan-400 rounded-full transform -rotate-45 shadow-md flex items-center justify-end pr-2 border-2 border-blue-600\\\">\\n                        <div class=\\\"w-2 h-2 bg-slate-800 rounded-full\\\"></div>\\n                    </div>\\n                </div>\\n            </div>\\n\\n            <!-- Contenu texte & Puces active / inactive -->\\n            <div x-data=\\\"{ activeSlide: 0 }\\\" class=\\\"z-10\\\">\\n                <h2 class=\\\"text-2xl md:text-3xl font-medium mb-2\\\">Welcome!</h2>\\n                <p class=\\\"text-blue-100 text-sm leading-relaxed max-w-xs mb-6\\\">\\n                    Get a real intranet on top of your Office 365 environment, with Upteamist.\\n                </p>\\n                \\n                <!-- Indicators du carousel -->\\n                <div class=\\\"flex space-x-2\\\">\\n                    <template x-for=\\\"i in [0, 1, 2]\\\" :key=\\\"i\\\">\\n                        <button \\n                            @click=\\\"activeSlide = i\\\" \\n                            :class=\\\"activeSlide === i ? 'bg-white w-3' : 'border border-white bg-transparent w-2.5'\\\"\\n                            class=\\\"h-2.5 rounded-full transition-all duration-300\\\">\\n                        </button>\\n                    </template>\\n                </div>\\n            </div>\\n\\n        </div>\\n\\n        <!-- Section Droite (Formulaire de Connexion) -->\\n        <div class=\\\"p-8 md:p-12 flex flex-col justify-center bg-white\\\" \\n             x-data=\\\"{ \\n                username: '', \\n                password: '', \\n                rememberMe: true,\\n                submitForm() {\\n                    alert('Connexion en cours pour : ' + this.username);\\n                }\\n             }\\\">\\n            \\n            <h1 class=\\\"text-3xl font-normal text-blue-600 mb-2\\\">Log In</h1>\\n            \\n            <p class=\\\"text-xs text-gray-500 mb-8\\\">\\n                Don't have an account? \\n                <a href=\\\"#\\\" class=\\\"text-blue-600 font-medium hover:underline\\\">Create an account</a>\\n                <br>\\n                <span class=\\\"text-gray-400\\\">It will take less than a minute.</span>\\n            </p>\\n\\n            <form @submit.prevent=\\\"submitForm()\\\" class=\\\"space-y-6\\\">\\n                <!-- Champ Username -->\\n                <div class=\\\"relative border-b border-gray-200 focus-within:border-blue-600 transition-colors pb-1\\\">\\n                    <input \\n                        type=\\\"text\\\" \\n                        x-model=\\\"username\\\"\\n                        placeholder=\\\"Username\\\" \\n                        required\\n                        class=\\\"w-full pr-8 py-1 text-sm text-gray-700 placeholder-gray-400 focus:outline-none bg-transparent\\\"\\n                    />\\n                    <i class=\\\"fa-regular fa-user absolute right-1 top-2 text-gray-400 text-sm\\\"></i>\\n                </div>\\n\\n                <!-- Champ Password -->\\n                <div class=\\\"relative border-b border-gray-200 focus-within:border-blue-600 transition-colors pb-1\\\">\\n                    <input \\n                        type=\\\"password\\\" \\n                        x-model=\\\"password\\\"\\n                        placeholder=\\\"Password\\\" \\n                        required\\n                        class=\\\"w-full pr-8 py-1 text-sm text-gray-700 placeholder-gray-400 focus:outline-none bg-transparent\\\"\\n                    />\\n                    <i class=\\\"fa-solid fa-lock absolute right-1 top-2 text-gray-400 text-sm\\\"></i>\\n                </div>\\n\\n                <!-- Bouton & Option Remember Me -->\\n                <div class=\\\"flex items-center justify-between pt-2\\\">\\n                    <button \\n                        type=\\\"submit\\\" \\n                        class=\\\"bg-blue-600 hover:bg-blue-700 text-white font-medium text-sm px-6 py-2 rounded-md shadow-sm transition-all duration-200 active:scale-95\\\">\\n                        Sign in\\n                    </button>\\n\\n                    <label class=\\\"flex items-center space-x-2 cursor-pointer text-xs text-gray-500 select-none\\\">\\n                        <input \\n                            type=\\\"checkbox\\\" \\n                            x-model=\\\"rememberMe\\\"\\n                            class=\\\"rounded border-gray-300 text-blue-600 focus:ring-blue-500 h-3.5 w-3.5\\\"\\n                        />\\n                        <span>Remeber password</span>\\n                    </label>\\n                </div>\\n\\n                <!-- Mot de passe oublié -->\\n                <div class=\\\"pt-4 text-center\\\">\\n                    <a href=\\\"#\\\" class=\\\"text-xs text-blue-600 hover:underline\\\">\\n                        Forget your password?\\n                    </a>\\n                </div>\\n            </form>\\n\\n        </div>\\n\\n    </div>\\n\\n</div>\" }} />\n  );\n}\n",
