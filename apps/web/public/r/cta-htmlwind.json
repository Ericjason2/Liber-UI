      "content": "/**\n * Component: CTA - Htmlwind\n * Author: @htmlwind (https://tailwindflex.com/@htmlwind)\n * Source: https://tailwindflex.com/@htmlwind/cta-htmlwind\n * Attribution: Créé par @htmlwind sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function CtaHtmlwind() {\n  return (\n    <div>\n    <div className=\"bg-white py-24 sm32\">\n      <div className=\"mx-auto max-w-7xl sm6 lg8\">\n        <div className=\"relative isolate overflow-clip bg-gray-900 px-6 pt-16 shadow-2xl sm3xl sm16 md24 lg lg20 lg24 lg0\">\n          <div aria-hidden=\"true\" className=\"absolute right-0 top-0 -z-10 aspect-square w-full max-w-3xl translate-x-3/4 rounded-full bg-pink-500/60 blur-[10rem] lg[40rem] lg1/2 lg1/2\"></div>\n          <div className=\"mx-auto max-w-md text-center lg0 lg lg24 lg\">\n            <h2 className=\"text-3xl font-semibold tracking-tight text-white sm4xl\">Want to partner with design experts in SaaS?</h2>\n            <p className=\"mt-6 text-base text-gray-300\">We're excited to talk to you about your project requirements and business goals.</p>\n            <div className=\"mt-10 flex items-center justify-center gap-x-6 lg\">\n              <a href=\"#\" className=\"rounded-md bg-white px-3.5 py-2.5 text-sm font-semibold text-gray-900 hover100 focus-visible focus-visible2 focus-visible2 focus-visible\">Schedule a call</a>\n              <a href=\"#\" className=\"text-sm font-semibold leading-6 text-white\">Send an email</a>\n            </div>\n          </div>\n          <div className=\"relative mt-16 h-80 lg8 lg\">\n            <img width=\"1920\" height=\"1139\" className=\"absolute left-0 top-0 w-[58rem] max-w-none rounded-2xl bg-white/5 ring-1 ring-white/10 lg14\" src=\"https://htmlwind.com/assets/images/dark-dashboard-screenshot.webp\" alt=\"dashboard screenshot\" />\n          </div>\n        </div>\n      </div>\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
  ],
