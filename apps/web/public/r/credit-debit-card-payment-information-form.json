      "content": "/**\n * Component: Credit / Debit card payment information form\n * Author: @santos78 (https://tailwindflex.com/@santos78)\n * Source: https://tailwindflex.com/@santos78/credit-debit-card-payment-information-form\n * Attribution: Créé par @santos78 sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function CreditDebitCardPaymentInformationForm() {\n  return (\n    <div>\n    <div className=\"w-full max-w-lg mx-auto p-8\">\n        <div className=\"bg-white rounded-lg shadow-lg p-6\">\n            <h2 className=\"text-lg font-medium mb-6\">Payment Information</h2>\n            <form>\n                <div className=\"grid grid-cols-2 gap-6\">\n                    <div className=\"col-span-2 sm1\">\n                        <label htmlFor=\"card-number\" className=\"block text-sm font-medium text-gray-700 mb-2\">Card Number</label>\n                        <input type=\"text\" name=\"card-number\" id=\"card-number\" placeholder=\"0000 0000 0000 0000\" className=\"w-full py-3 px-4 border border-gray-400 rounded-lg focus focus500\" />\n                    </div>\n                    <div className=\"col-span-2 sm1\">\n                        <label htmlFor=\"expiration-date\" className=\"block text-sm font-medium text-gray-700 mb-2\">Expiration Date</label>\n                        <input type=\"text\" name=\"expiration-date\" id=\"expiration-date\" placeholder=\"MM / YY\" className=\"w-full py-3 px-4 border border-gray-400 rounded-lg focus focus500\" />\n                    </div>\n                    <div className=\"col-span-2 sm1\">\n                        <label htmlFor=\"cvv\" className=\"block text-sm font-medium text-gray-700 mb-2\">CVV</label>\n                        <input type=\"text\" name=\"cvv\" id=\"cvv\" placeholder=\"000\" className=\"w-full py-3 px-4 border border-gray-400 rounded-lg focus focus500\" />\n                    </div>\n                    <div className=\"col-span-2 sm1\">\n                        <label htmlFor=\"card-holder\" className=\"block text-sm font-medium text-gray-700 mb-2\">Card Holder</label>\n                        <input type=\"text\" name=\"card-holder\" id=\"card-holder\" placeholder=\"Full Name\" className=\"w-full py-3 px-4 border border-gray-400 rounded-lg focus focus500\" />\n                    </div>\n                </div>\n                <div className=\"mt-8\">\n                    <button type=\"submit\" className=\"w-full bg-green-500 hover600 text-white font-medium py-3 rounded-lg focus\">Submit</button>\n                </div>\n            </form>\n        </div>\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
