    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\" class=\"dark\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\"/>\n  <meta name=\"theme-color\" content=\"#000000\"/>\n  <title>iOS 26 Slider — 3D Perspective</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <script defer src=\"https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js\"></script>\n  <script src=\"https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js\"></script>\n  <script>\n    tailwind.config = {\n      darkMode: 'class',\n      theme: {\n        extend: {\n          fontFamily: {\n            sans: ['-apple-system', 'BlinkMacSystemFont', 'SF Pro Display', 'Inter', 'sans-serif']\n          },\n          colors: {\n            'ios-bg': '#111111',\n            'ios-card': 'rgba(255, 255, 255, 0.08)',\n            'ios-border': 'rgba(255, 255, 255, 0.15)'\n          }\n        }\n      }\n    }\n  </script>\n  <style>\n    * {\n      margin: 0;\n      padding: 0;\n      box-sizing: border-box;\n      -webkit-tap-highlight-color: transparent;\n      -webkit-touch-callout: none;\n    }\n\n    body {\n      background: #000;\n      color: white;\n      min-height: 100vh;\n      overflow: hidden;\n      font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', sans-serif;\n      touch-action: pan-y;\n    }\n\n    /* Fond animé iOS 26 */\n    #three-canvas {\n      position: fixed;\n      top: 0;\n      left: 0;\n      width: 100%;\n      height: 100%;\n      z-index: -1;\n    }\n\n    /* Slider container */\n    .ios-slider {\n      position: relative;\n      height: 100vh;\n      overflow: hidden;\n      perspective: 1000px;\n      perspective-origin: 50% 50%;\n    }\n\n    /* Slides */\n    .slide {\n      position: absolute;\n      top: 0;\n      left: 0;\n      width: 100%;\n      height: 100%;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      padding: 2rem;\n      transform-style: preserve-3d;\n      transition: transform 0.8s cubic-bezier(0.34, 1.56, 0.64, 1),\n                  opacity 0.5s ease;\n      opacity: 0;\n      pointer-events: none;\n    }\n\n    .slide.active {\n      opacity: 1;\n      pointer-events: auto;\n      transform: translateZ(0) rotateX(0) rotateY(0);\n    }\n\n    .slide.prev {\n      transform: translateX(-100%) rotateY(-15deg);\n      opacity: 0.6;\n    }\n\n    .slide.next {\n      transform: translateX(100%) rotateY(15deg);\n      opacity: 0.6;\n    }\n\n    /* Card iOS 26 */\n    .ios-card {\n      background: rgba(255, 255, 255, 0.08);\n      backdrop-filter: blur(40px);\n      -webkit-backdrop-filter: blur(40px);\n      border: 1px solid rgba(255, 255, 255, 0.15);\n      border-radius: 32px;\n      width: 90%;\n      max-width: 360px;\n      padding: 2.5rem 2rem;\n      text-align: center;\n      transform-style: preserve-3d;\n      transition: transform 0.3s ease, box-shadow 0.3s ease;\n      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);\n    }\n\n    .ios-card:hover {\n      transform: translateZ(20px) rotateX(2deg) rotateY(2deg);\n      box-shadow: 0 30px 70px rgba(0, 0, 0, 0.4);\n    }\n\n    /* Typography iOS */\n    .slide-title {\n      font-size: 2.2rem;\n      font-weight: 600;\n      line-height: 1.2;\n      background: linear-gradient(135deg, #a855f7, #ec4899);\n      -webkit-background-clip: text;\n      background-clip: text;\n      color: transparent;\n      margin-bottom: 1.5rem;\n    }\n\n    .slide-text {\n      font-size: 1.1rem;\n      color: rgba(255, 255, 255, 0.85);\n      line-height: 1.6;\n      margin-bottom: 2rem;\n      max-width: 300px;\n    }\n\n    /* Pagination */\n    .slider-pagination {\n      position: absolute;\n      bottom: 2rem;\n      left: 0;\n      right: 0;\n      display: flex;\n      justify-content: center;\n      gap: 0.75rem;\n      z-index: 10;\n    }\n\n    .pagination-dot {\n      width: 8px;\n      height: 8px;\n      border-radius: 50%;\n      background: rgba(255, 255, 255, 0.3);\n      transition: all 0.3s ease;\n    }\n\n    .pagination-dot.active {\n      background: white;\n      transform: scale(1.4);\n    }\n\n    /* Instruction */\n    .instruction {\n      position: absolute;\n      bottom: 1rem;\n      left: 0;\n      right: 0;\n      text-align: center;\n      color: rgba(255, 255, 255, 0.7);\n      font-size: 0.85rem;\n      opacity: 0;\n      transition: opacity 0.5s ease;\n    }\n\n    .instruction.show {\n      opacity: 1;\n    }\n\n    /* Responsive */\n    @media (max-width: 640px) {\n      .slide-title {\n        font-size: 1.8rem;\n      }\n      \n      .ios-card {\n        width: 95%;\n        padding: 2rem 1.5rem;\n      }\n    }\n  </style>\n</head>\n<body x-data=\"sliderComponent()\">\n  <!-- Three.js background -->\n  <canvas id=\"three-canvas\"></canvas>\n\n  <!-- iOS Slider -->\n  <div class=\"ios-slider\" @touchstart=\"touchStart\" @touchmove=\"touchMove\" @touchend=\"touchEnd\">\n    <!-- Slide 1 -->\n    <div class=\"slide\" :class=\"{ 'active': currentIndex === 0, 'prev': currentIndex === 1, 'next': currentIndex === 2 }\">\n      <div class=\"ios-card\" x-ref=\"card1\">\n        <h2 class=\"slide-title\">Perspective 3D</h2>\n        <p class=\"slide-text\">Laissez votre téléphone bouger naturellement. Les cartes réagissent à chaque inclinaison pour une expérience immersive.</p>\n        <div class=\"w-16 h-1 mx-auto bg-gradient-to-r from-purple-500 to-pink-500 rounded-full\"></div>\n      </div>\n    </div>\n\n    <!-- Slide 2 -->\n    <div class=\"slide\" :class=\"{ 'active': currentIndex === 1, 'prev': currentIndex === 2, 'next': currentIndex === 0 }\">\n      <div class=\"ios-card\" x-ref=\"card2\">\n        <h2 class=\"slide-title\">Glass Morphism</h2>\n        <p class=\"slide-text\">Design épuré inspiré d'iOS 26 avec transparence et flou dynamique. Chaque élément respire avec élégance.</p>\n        <div class=\"w-16 h-1 mx-auto bg-gradient-to-r from-blue-500 to-cyan-500 rounded-full\"></div>\n      </div>\n    </div>\n\n    <!-- Slide 3 -->\n    <div class=\"slide\" :class=\"{ 'active': currentIndex === 2, 'prev': currentIndex === 0, 'next': currentIndex === 1 }\">\n      <div class=\"ios-card\" x-ref=\"card3\">\n        <h2 class=\"slide-title\">Mouvement Naturel</h2>\n        <p class=\"slide-text\">Les animations suivent les lois physiques d'iOS : fluides, précises et toujours dans le bon timing.</p>\n        <div class=\"w-16 h-1 mx-auto bg-gradient-to-r from-amber-500 to-orange-500 rounded-full\"></div>\n      </div>\n    </div>\n\n    <!-- Pagination -->\n    <div class=\"slider-pagination\">\n      <template x-for=\"i in slidesCount\" :key=\"i\">\n        <div class=\"pagination-dot\" :class=\"{ 'active': currentIndex === i }\"></div>\n      </template>\n    </div>\n\n    <!-- Instruction -->\n    <div class=\"instruction\" :class=\"{ 'show': showInstruction }\">\n      Déplacez votre téléphone ou glissez pour naviguer\n    </div>\n  </div>\n\n  <script>\n    function sliderComponent() {\n      return {\n        currentIndex: 0,\n        slidesCount: 2, // 0, 1, 2 = 3 slides\n        touchStartX: 0,\n        touchEndX: 0,\n        showInstruction: true,\n        lastDeviceMotion: 0,\n        deviceTilt: { x: 0, y: 0 },\n        \n        init() {\n          this.initThreeJS();\n          this.setupDeviceOrientation();\n          \n          // Cacher l'instruction après 3 secondes\n          setTimeout(() => {\n            this.showInstruction = false;\n          }, 3000);\n          \n          // Rafraîchir les cartes périodiquement\n          setInterval(() => {\n            this.animateCards();\n          }, 100);\n        },\n        \n        setupDeviceOrientation() {\n          if (window.DeviceOrientationEvent) {\n            window.addEventListener('deviceorientation', (event) => {\n              const now = Date.now();\n              if (now - this.lastDeviceMotion > 100) { // Limiter les updates\n                this.lastDeviceMotion = now;\n                \n                // Normaliser les valeurs\n                const beta = event.beta || 0; // Rotation X (-180° à 180°)\n                const gamma = event.gamma || 0; // Rotation Y (-90° à 90°)\n                \n                // Convertir en degrés utilisables (-15° à 15°)\n                this.deviceTilt.x = Math.max(-15, Math.min(15, beta * 0.2));\n                this.deviceTilt.y = Math.max(-15, Math.min(15, gamma * 0.3));\n              }\n            });\n            \n            // Demander la permission pour iOS\n            if (typeof DeviceOrientationEvent.requestPermission === 'function') {\n              window.addEventListener('click', () => {\n                DeviceOrientationEvent.requestPermission()\n                  .then(permissionState => {\n                    if (permissionState === 'granted') {\n                      window.addEventListener('deviceorientation', this.handleDeviceOrientation);\n                    }\n                  })\n                  .catch(console.error);\n              }, { once: true });\n            }\n          }\n        },\n        \n        handleDeviceOrientation(event) {\n          if (!event.gamma) return;\n          \n          const beta = event.beta || 0;\n          const gamma = event.gamma || 0;\n          \n          this.deviceTilt.x = Math.max(-15, Math.min(15, beta * 0.2));\n          this.deviceTilt.y = Math.max(-15, Math.min(15, gamma * 0.3));\n        },\n        \n        animateCards() {\n          if (!this.$refs.card1 || !this.$refs.card2 || !this.$refs.card3) return;\n          \n          // Appliquer la perspective 3D basée sur l'inclinaison du device\n          const cards = [this.$refs.card1, this.$refs.card2, this.$refs.card3];\n          const activeCard = cards[this.currentIndex];\n          \n          // Appliquer l'effet 3D seulement sur la carte active\n          if (activeCard) {\n            activeCard.style.transform = `\n              translateZ(30px) \n              rotateX(${this.deviceTilt.x}deg) \n              rotateY(${this.deviceTilt.y}deg)\n            `;\n          }\n          \n          // Effet subtil sur les autres cartes\n          cards.forEach((card, index) => {\n            if (index !== this.currentIndex) {\n              card.style.transform = `\n                translateZ(10px) \n                rotateX(${this.deviceTilt.x * 0.3}deg) \n                rotateY(${this.deviceTilt.y * 0.3}deg)\n              `;\n            }\n          });\n        },\n        \n        nextSlide() {\n          this.currentIndex = (this.currentIndex + 1) % (this.slidesCount + 1);\n          this.showInstruction = false;\n        },\n        \n        prevSlide() {\n          this.currentIndex = (this.currentIndex - 1 + (this.slidesCount + 1)) % (this.slidesCount + 1);\n          this.showInstruction = false;\n        },\n        \n        touchStart(event) {\n          this.touchStartX = event.touches[0].clientX;\n        },\n        \n        touchMove(event) {\n          if (!this.touchStartX) return;\n          \n          this.touchEndX = event.touches[0].clientX;\n          const diff = this.touchStartX - this.touchEndX;\n          \n          // Appliquer une rotation subtile pendant le glissement\n          if (Math.abs(diff) > 10) {\n            const rotateY = -diff * 0.1;\n            const cards = [this.$refs.card1, this.$refs.card2, this.$refs.card3];\n            const activeCard = cards[this.currentIndex];\n            \n            if (activeCard) {\n              activeCard.style.transform = `\n                translateZ(30px) \n                rotateX(0deg) \n                rotateY(${rotateY}deg)\n              `;\n            }\n          }\n        },\n        \n        touchEnd(event) {\n          if (!this.touchStartX || !this.touchEndX) return;\n          \n          const diff = this.touchStartX - this.touchEndX;\n          \n          if (diff > 50 && this.currentIndex < this.slidesCount) {\n            this.nextSlide();\n          } else if (diff < -50 && this.currentIndex > 0) {\n            this.prevSlide();\n          }\n          \n          // Réinitialiser les valeurs\n          this.touchStartX = null;\n          this.touchEndX = null;\n          \n          // Réinitialiser la transformation après le geste\n          setTimeout(() => {\n            this.animateCards();\n          }, 100);\n        },\n        \n        initThreeJS() {\n          // Scène Three.js pour le fond\n          const scene = new THREE.Scene();\n          const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);\n          const renderer = new THREE.WebGLRenderer({ \n            canvas: document.getElementById('three-canvas'),\n            alpha: true,\n            antialias: true\n          });\n          \n          renderer.setSize(window.innerWidth, window.innerHeight);\n          renderer.setPixelRatio(window.devicePixelRatio);\n          \n          // Particules\n          const particlesGeometry = new THREE.BufferGeometry();\n          const particlesCount = 1000;\n          \n          const posArray = new Float32Array(particlesCount * 3);\n          for (let i = 0; i < particlesCount * 3; i++) {\n            posArray[i] = (Math.random() - 0.5) * 15;\n          }\n          \n          particlesGeometry.setAttribute('position', new THREE.BufferAttribute(posArray, 3));\n          \n          const particlesMaterial = new THREE.PointsMaterial({\n            color: 0x8b5cf6,\n            size: 0.03,\n            transparent: true,\n            opacity: 0.7,\n            sizeAttenuation: true\n          });\n          \n          const particlesMesh = new THREE.Points(particlesGeometry, particlesMaterial);\n          scene.add(particlesMesh);\n          \n          camera.position.z = 3;\n          \n          // Lumières\n          const ambientLight = new THREE.AmbientLight(0xffffff, 0.3);\n          scene.add(ambientLight);\n          \n          const directionalLight = new THREE.DirectionalLight(0xffffff, 0.8);\n          directionalLight.position.set(1, 1, 1);\n          scene.add(directionalLight);\n          \n          // Animation\n          const animate = () => {\n            requestAnimationFrame(animate);\n            \n            const time = Date.now() * 0.0005;\n            \n            // Rotation douce des particules\n            particlesMesh.rotation.x = time * 0.1;\n            particlesMesh.rotation.y = time * 0.15;\n            \n            // Effet de vague\n            const positions = particlesGeometry.attributes.position.array;\n            for (let i = 0; i < particlesCount; i++) {\n              const i3 = i * 3;\n              positions[i3 + 2] = Math.sin(positions[i3] + time) * 0.5;\n            }\n            particlesGeometry.attributes.position.needsUpdate = true;\n            \n            renderer.render(scene, camera);\n          };\n          \n          // Gestion du resize\n          window.addEventListener('resize', () => {\n            camera.aspect = window.innerWidth / window.innerHeight;\n            camera.updateProjectionMatrix();\n            renderer.setSize(window.innerWidth, window.innerHeight);\n          });\n          \n          animate();\n        }\n      }\n    }\n  </script>\n</body>\n</html>"
  }
}
