      "content": "import * as React from \"react\"\n\nfunction ButtonDropdown({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"button-dropdown\"\n      className={className}\n      {...props}\n    >\n      <div className=\"relative\">\n        \n        <button className=\"peer relative z-10 block p-2 transition-colors duration-300 transform rounded-lg focus border-2 border-blue-500\">\n          <svg className=\"w-6 h-6 text-blue-500 rotate-90\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"M5 12h.01M12 12h.01M19 12h.01M6 12a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0z\" />\n          </svg>\n        </button>\n      \n        \n        <div\n          className=\"hidden peer-focus absolute right-0 z-20 w-48 mt-2 overflow-hidden bg-white rounded-lg shadow-xl dark800 border\">\n          <a href=\"#\"\n            className=\"block px-4 py-2 text-sm text-gray-800 transition-colors duration-300 transform border-b dark200 dark500 hover100 dark700\">small\n            <span className=\"text-gray-600 dark400\">(640x426)</span></a>\n          <a href=\"#\"\n            className=\"block px-4 py-2 text-sm text-gray-800 transition-colors duration-300 transform border-b dark200 dark500 hover100 dark700\">medium\n            <span className=\"text-gray-600 dark400\">(1920x1280)</span></a>\n          <a href=\"#\"\n            className=\"block px-4 py-2 text-sm text-gray-800 transition-colors duration-300 transform dark200 hover100 dark700\">large\n            <span className=\"text-gray-600 dark400\">(2400x1600)</span></a>\n        </div>\n      </div>\n    </div>\n  )\n}\n\nexport { ButtonDropdown }\n",
      "type": "registry:ui"
    }
  ],
