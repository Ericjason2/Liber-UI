    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\n  <title>Arto | Modern Art Inspirations</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <script>\n    tailwind.config = {\n      theme: {\n        extend: {\n          animation: {\n            float: 'float 6s ease-in-out infinite',\n            'slide-up': 'slideUp 0.8s ease-out forwards',\n            pulse: 'pulse 2s infinite'\n          },\n          keyframes: {\n            float: {\n              '0%, 100%': { transform: 'translateY(0)' },\n              '50%': { transform: 'translateY(-20px)' }\n            },\n            slideUp: {\n              '0%': { transform: 'translateY(40px)', opacity: '0' },\n              '100%': { transform: 'translateY(0)', opacity: '1' }\n            }\n          },\n          colors: {\n            art: {\n              cream: '#FFF8F0',\n              coral: '#FF6B6B',\n              gold: '#FFD93D',\n              deep: '#1E1E2F'\n            }\n          }\n        }\n      }\n    }\n    \n  </script>\n</head>\n<body class=\"bg-art-cream text-art-deep overflow-x-hidden\">\n  <!-- Background Shapes -->\n  <div class=\"fixed inset-0 -z-10 opacity-10\">\n    <div class=\"absolute w-72 h-72 bg-art-coral rounded-full top-1/4 -left-24 animate-float\"></div>\n    <div class=\"absolute w-56 h-56 bg-art-gold rounded-full bottom-1/4 -right-16 animate-float delay-200\"></div>\n  </div>\n\n  <!-- Navbar -->\n  <nav class=\"fixed top-0 w-full z-50 py-6 px-6 md:px-12 bg-art-cream/80 backdrop-blur-md shadow\">\n    <div class=\"max-w-7xl mx-auto flex justify-between items-center\">\n      <div class=\"text-2xl font-serif font-bold\">\n        Arto<span class=\"text-art-coral\">Gallery</span>\n      </div>\n      <div class=\"hidden md:flex space-x-8\">\n        <a href=\"#\" class=\"hover:text-art-coral transition\">Gallery</a>\n        <a href=\"#\" class=\"hover:text-art-coral transition\">Artists</a>\n        <a href=\"#\" class=\"hover:text-art-coral transition\">Events</a>\n        <a href=\"#\" class=\"hover:text-art-coral transition\">About</a>\n      </div>\n    </div>\n  </nav>\n\n  <!-- Hero Section -->\n  <section class=\"min-h-screen pt-24 pb-16 px-6 md:px-12 flex flex-col lg:flex-row items-center justify-between max-w-7xl mx-auto\">\n    <div class=\"lg:w-1/2 animate-slide-up\">\n      <h1 class=\"text-5xl md:text-6xl font-bold font-serif leading-tight mb-6\">\n        <span class=\"block\">Ignite Your</span>\n        <span class=\"block text-art-coral\">Artistic Soul</span>\n      </h1>\n      <p class=\"text-lg text-gray-700 mb-8 max-w-lg\">\n        Explore a curated selection of contemporary and classic artwork, connecting collectors and creators in an inspiring online space.\n      </p>\n      <div class=\"flex flex-col sm:flex-row space-y-4 sm:space-y-0 sm:space-x-4\">\n        <button class=\"px-8 py-4 bg-art-coral text-white rounded-lg hover:bg-red-500 transition hover:-translate-y-1\">\n          Browse Gallery\n        </button>\n        <button class=\"px-8 py-4 border border-gray-300 text-art-deep rounded-lg hover:bg-white transition\">\n          Meet Artists\n        </button>\n      </div>\n\n      <div class=\"mt-12 flex space-x-8\">\n        <div class=\"flex flex-col\">\n          <span class=\"text-2xl font-bold text-art-coral\">150+</span>\n          <span class=\"text-gray-600\">Artworks</span>\n        </div>\n        <div class=\"flex flex-col\">\n          <span class=\"text-2xl font-bold text-art-coral\">30</span>\n          <span class=\"text-gray-600\">Exhibitions</span>\n        </div>\n        <div class=\"flex flex-col\">\n          <span class=\"text-2xl font-bold text-art-coral\">24/7</span>\n          <span class=\"text-gray-600\">Online Viewing</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- Hero Image -->\n    <div class=\"lg:w-1/2 relative animate-slide-up delay-200\">\n      <div class=\"relative rounded-2xl overflow-hidden shadow-xl transform rotate-1 hover:rotate-0 transition-transform duration-500\">\n        <img src=\"https://images.unsplash.com/photo-1549880338-65ddcdfd017b\" alt=\"Abstract Art\" class=\"w-full object-cover\"/>\n        <div class=\"absolute inset-0 bg-gradient-to-t from-black/20 to-transparent\"></div>\n      </div>\n\n      <!-- Floating Tags -->\n      <div class=\"absolute -top-6 -left-6 bg-white p-4 rounded-lg shadow w-40 animate-slide-up delay-300\">\n        <h4 class=\"font-bold text-art-deep\">Original Work</h4>\n        <p class=\"text-sm text-gray-600\">Signed by Artist</p>\n      </div>\n      <div class=\"absolute -bottom-6 -right-6 bg-white p-4 rounded-lg shadow w-40 animate-slide-up delay-400\">\n        <h4 class=\"font-bold text-art-deep\">Limited Editions</h4>\n        <p class=\"text-sm text-gray-600\">Only 50 Prints</p>\n      </div>\n      <div class=\"absolute top-8 right-8 bg-art-gold text-art-deep px-4 py-2 rounded-full animate-pulse\">\n        <span class=\"font-bold\">$499</span>\n      </div>\n    </div>\n  </section>\n<section class=\"min-h-screen pt-24 pb-12 px-6 md:px-12 flex flex-col lg:flex-row items-center justify-between max-w-7xl mx-auto\">\n    <div class=\"lg:w-1/2 mb-16 lg:mb-0 lg:pr-12 animate-slide-up\">\n      <h1 class=\"text-4xl md:text-5xl lg:text-6xl font-serif font-bold leading-tight mb-6\">\n        <span class=\"block\">Live With</span>\n        <span class=\"block text-art-plum\">Creative Soul</span>\n      </h1>\n      <p class=\"text-lg text-gray-700 mb-8 max-w-lg\">\n        ArtistryHaus curates a collection of evocative art pieces, decor, and furniture that transform your home into a personal gallery.\n      </p>\n      <div class=\"flex flex-col sm:flex-row space-y-4 sm:space-y-0 sm:space-x-4\">\n        <button class=\"px-8 py-4 bg-art-plum text-white rounded-lg hover:bg-art-plum/90 transition-all duration-300 transform hover:-translate-y-1\">\n          Shop Artworks\n        </button>\n        <button class=\"px-8 py-4 border border-gray-300 text-gray-700 rounded-lg hover:bg-white transition-all duration-300\">\n          Browse Styles\n        </button>\n      </div>\n      <div class=\"mt-12 flex items-center space-x-8\">\n        <div class=\"flex flex-col\">\n          <span class=\"text-2xl font-bold text-art-plum\">30+</span>\n          <span class=\"text-gray-700\">Featured Artists</span>\n        </div>\n        <div class=\"flex flex-col\">\n          <span class=\"text-2xl font-bold text-art-plum\">200+</span>\n          <span class=\"text-gray-700\">Curated Pieces</span>\n        </div>\n        <div class=\"flex flex-col\">\n          <span class=\"text-2xl font-bold text-art-plum\">Global</span>\n          <span class=\"text-gray-700\">Artist Network</span>\n        </div>\n      </div>\n    </div>\n    <div class=\"lg:w-1/2 relative animate-slide-up delay-200\">\n      <div class=\"relative rounded-2xl overflow-hidden shadow-xl transform rotate-1 hover:rotate-0 transition-transform duration-500\">\n        <img class=\"w-full h-auto object-cover\" src=\"https://images.unsplash.com/photo-1497032205916-ac775f0649ae\" alt=\"Modern artwork display\">\n        <div class=\"absolute inset-0 bg-gradient-to-t from-black/10 to-transparent\"></div>\n      </div>\n      <div class=\"absolute -top-6 -left-6 bg-white p-4 rounded-lg shadow-md w-40 animate-slide-up delay-300\">\n        <h4 class=\"font-bold text-art-ink\">Original</h4>\n        <p class=\"text-sm text-gray-600\">One-of-a-kind pieces</p>\n      </div>\n      <div class=\"absolute -bottom-6 -right-6 bg-white p-4 rounded-lg shadow-md w-40 animate-slide-up delay-400\">\n        <h4 class=\"font-bold text-art-ink\">Expressive</h4>\n        <p class=\"text-sm text-gray-600\">Curated for emotion</p>\n      </div>\n    </div>\n  </section>\n\n  <!-- Featured Artists Section -->\n  <section class=\"py-20 px-6 md:px-12 bg-art-blush text-art-ink\">\n    <div class=\"max-w-7xl mx-auto text-center mb-12\">\n      <h2 class=\"text-4xl font-serif font-bold mb-4\">Featured Artists</h2>\n      <p class=\"text-lg text-art-ink/80\">Celebrating global talent through inspiring creations</p>\n    </div>\n    <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-12 max-w-6xl mx-auto\">\n      <div class=\"bg-white rounded-xl shadow-lg overflow-hidden\">\n        <img src=\"https://images.unsplash.com/photo-1515378791036-0648a3ef77b2\" alt=\"Artist portrait\" class=\"w-full h-64 object-cover\">\n        <div class=\"p-6\">\n          <h3 class=\"text-xl font-bold mb-2\">Elena Mirov</h3>\n          <p class=\"text-sm text-gray-600\">Known for her abstract watercolor dreamscapes, Elena’s work evokes deep introspection.</p>\n        </div>\n      </div>\n      <div class=\"bg-white rounded-xl shadow-lg overflow-hidden\">\n        <img src=\"https://images.unsplash.com/photo-1515378791036-0648a3ef77b2\" alt=\"Artist portrait\" class=\"w-full h-64 object-cover\">\n        <div class=\"p-6\">\n          <h3 class=\"text-xl font-bold mb-2\">Raj Patel</h3>\n          <p class=\"text-sm text-gray-600\">Raj blends digital minimalism with traditional Indian motifs to create visual harmony.</p>\n        </div>\n      </div>\n      <div class=\"bg-white rounded-xl shadow-lg overflow-hidden\">\n        <img src=\"https://images.unsplash.com/photo-1515378791036-0648a3ef77b2\" alt=\"Artist portrait\" class=\"w-full h-64 object-cover\">\n        <div class=\"p-6\">\n          <h3 class=\"text-xl font-bold mb-2\">Ava Thompson</h3>\n          <p class=\"text-sm text-gray-600\">With roots in street art, Ava’s canvas works vibrate with energy, identity, and narrative.</p>\n        </div>\n      </div>\n    </div>\n  </section>\n  <!-- Press Mentions -->\n  <div class=\"py-12 px-6 md:px-12 max-w-7xl mx-auto\">\n    <p class=\"text-center text-gray-500 mb-8\">As Seen In</p>\n    <div class=\"flex flex-wrap justify-center gap-10 text-xl font-serif italic text-art-deep\">\n      <div>ArtForum</div>\n      <div>Creative Boom</div>\n      <div>Design Milk</div>\n      <div>Juxtapoz</div>\n    </div>\n  </div>\n</body>\n</html>"
