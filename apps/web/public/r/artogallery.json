ter mb-12\\\">\\n      <h2 class=\\\"text-4xl font-serif font-bold mb-4\\\">Featured Artists</h2>\\n      <p class=\\\"text-lg text-art-ink/80\\\">Celebrating global talent through inspiring creations</p>\\n    </div>\\n    <div class=\\\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-12 max-w-6xl mx-auto\\\">\\n      <div class=\\\"bg-white rounded-xl shadow-lg overflow-hidden\\\">\\n        <img src=\\\"https://images.unsplash.com/photo-1515378791036-0648a3ef77b2\\\" alt=\\\"Artist portrait\\\" class=\\\"w-full h-64 object-cover\\\">\\n        <div class=\\\"p-6\\\">\\n          <h3 class=\\\"text-xl font-bold mb-2\\\">Elena Mirov</h3>\\n          <p class=\\\"text-sm text-gray-600\\\">Known for her abstract watercolor dreamscapes, Elena’s work evokes deep introspection.</p>\\n        </div>\\n      </div>\\n      <div class=\\\"bg-white rounded-xl shadow-lg overflow-hidden\\\">\\n        <img src=\\\"https://images.unsplash.com/photo-1515378791036-0648a3ef77b2\\\" alt=\\\"Artist portrait\\\" class=\\\"w-full h-64 object-cover\\\">\\n        <div class=\\\"p-6\\\">\\n          <h3 class=\\\"text-xl font-bold mb-2\\\">Raj Patel</h3>\\n          <p class=\\\"text-sm text-gray-600\\\">Raj blends digital minimalism with traditional Indian motifs to create visual harmony.</p>\\n        </div>\\n      </div>\\n      <div class=\\\"bg-white rounded-xl shadow-lg overflow-hidden\\\">\\n        <img src=\\\"https://images.unsplash.com/photo-1515378791036-0648a3ef77b2\\\" alt=\\\"Artist portrait\\\" class=\\\"w-full h-64 object-cover\\\">\\n        <div class=\\\"p-6\\\">\\n          <h3 class=\\\"text-xl font-bold mb-2\\\">Ava Thompson</h3>\\n          <p class=\\\"text-sm text-gray-600\\\">With roots in street art, Ava’s canvas works vibrate with energy, identity, and narrative.</p>\\n        </div>\\n      </div>\\n    </div>\\n  </section>\\n  <!-- Press Mentions -->\\n  <div class=\\\"py-12 px-6 md:px-12 max-w-7xl mx-auto\\\">\\n    <p class=\\\"text-center text-gra