      "content": "/**\n * Component: Login form\n * Author: @leon-bachmann (https://tailwindflex.com/@leon-bachmann)\n * Source: https://tailwindflex.com/@leon-bachmann/login-form-5\n * Attribution: Créé par @leon-bachmann sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function LoginForm5() {\n  return (\n    <div>\n    <main className=\"mx-auto flex min-h-screen w-full items-center justify-center bg-gray-900 text-white\">\n        <section className=\"flex w-[30rem] flex-col space-y-10\">\n            <div className=\"text-center text-4xl font-medium\">Log In</div>\n    \n            <div className=\"w-full transform border-b-2 bg-transparent text-lg duration-300 focus-within500\">\n                <input type=\"text\" placeholder=\"Email or Username\" className=\"w-full border-none bg-transparent outline-none placeholder focus\"/>\n            </div>\n    \n            <div className=\"w-full transform border-b-2 bg-transparent text-lg duration-300 focus-within500\">\n                <input type=\"password\" placeholder=\"Password\" className=\"w-full border-none bg-transparent outline-none placeholder focus\"/>\n            </div>\n    \n            <button className=\"transform rounded-sm bg-indigo-600 py-2 font-bold duration-300 hover400\">LOG IN</button>\n    \n            <a href=\"#\" className=\"transform text-center font-semibold text-gray-500 duration-300 hover300\">FORGOT PASSWORD?</a>\n    \n            <p className=\"text-center text-lg\">\n                No account?\n                <a href=\"#\" className=\"font-medium text-indigo-500 underline-offset-4 hover\">Create One</a>\n            </p>\n        </section>\n    </main>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
