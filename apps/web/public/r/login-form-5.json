      "content": "import * as React from \"react\"\n\nfunction LoginForm5({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"login-form-5\"\n      className={className}\n      {...props}\n    >\n      <main className=\"mx-auto flex min-h-screen w-full items-center justify-center bg-gray-900 text-white\">\n          <section className=\"flex w-[30rem] flex-col space-y-10\">\n              <div className=\"text-center text-4xl font-medium\">Log In</div>\n      \n              <div className=\"w-full transform border-b-2 bg-transparent text-lg duration-300 focus-within500\">\n                  <input type=\"text\" placeholder=\"Email or Username\" className=\"w-full border-none bg-transparent outline-none placeholder focus\"/>\n              </div>\n      \n              <div className=\"w-full transform border-b-2 bg-transparent text-lg duration-300 focus-within500\">\n                  <input type=\"password\" placeholder=\"Password\" className=\"w-full border-none bg-transparent outline-none placeholder focus\"/>\n              </div>\n      \n              <button className=\"transform rounded-sm bg-indigo-600 py-2 font-bold duration-300 hover400\">LOG IN</button>\n      \n              <a href=\"#\" className=\"transform text-center font-semibold text-gray-500 duration-300 hover300\">FORGOT PASSWORD?</a>\n      \n              <p className=\"text-center text-lg\">\n                  No account?\n                  <a href=\"#\" className=\"font-medium text-indigo-500 underline-offset-4 hover\">Create One</a>\n              </p>\n          </section>\n      </main>\n    </div>\n  )\n}\n\nexport { LoginForm5 }\n",
      "type": "registry:ui"
    }
  ],
