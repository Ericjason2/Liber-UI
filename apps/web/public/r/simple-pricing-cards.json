ay-800 mb-2\">25 sites</p>\n                    </div>\n                    <div>\n                        <p className=\"text-xl lg2xl font-bold text-gray-800 mb-2\">€20 p/m</p>\n                        <p className=\"text-lg\">€0.80 per site</p>\n                    </div>\n                </li>\n            </ul>\n        </a>\n        <a href=\"#\" className=\"shadow hover duration-500 mb-6 bg-yellow-100 py-4 lg6 px-8 rounded-lg\">\n            <ul>\n                <li className=\"grid grid-cols-2 gap-4\">\n                    <div>\n                        <p className=\"text-xl lg2xl font-bold text-gray-800 mb-2\">50 sites</p>\n                    </div>\n                    <div>\n                        <p className=\"text-xl lg2xl font-bold text-gray-800 mb-2\">€35 p/m</p>\n                        <p className=\"text-lg\">€0.70 per site</p>\n                    </div>\n                </li>\n            </ul>\n        </a>\n        <a href=\"#\" className=\"shadow hover duration-500 mb-6 bg-yellow-100 py-4 lg6 px-8 rounded-lg\">\n            <ul>\n                <li className=\"grid grid-cols-2 gap-4\">\n                    <div>\n                        <p className=\"text-xl lg2xl font-bold text-gray-800 mb-2\">100 sites</p>\n                    </div>\n                    <div>\n                        <p className=\"text-xl lg2xl font-bold text-gray-800 mb-2\">€65 p/m</p>\n                        <p className=\"text-lg\">€0.65 per site</p>\n                    </div>\n                </li>\n            </ul>\n        </a>\n        <a href=\"#\" className=\"shadow hover duration-500 mb-6 bg-yellow-100 py-4 lg6 px-8 rounded-lg\">\n            <ul>\n                <li className=\"grid grid-cols-2 gap-4\">\n                    <div>\n                        <p className=\"text-xl lg2xl font-bold text-gray-800 mb-2\">200 sites</p>\n                    </div>\n                    <div>\n                        <p className=\"text-xl lg2xl font-bold text-gray-800 mb-2\">€100 p/m</p>\n                        <p className=\"text-lg\">€0.50 per site</p>\n                    </div>\n                </li>\n            </ul>\n        </a>\n    </div>\n    </div>\n  );\n}\n",
