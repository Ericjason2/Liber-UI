ame=\"font-medium underline text-purple-600 dark400\">Read More</a>\n            </div>\n          </div>\n    \n          <div className=\"relative\">\n            <a href=\"#_\" className=\"block overflow-hidden group rounded-xl shadow-lg\">\n              <img src=\"https://images.unsplash.com/photo-1523905330026-b8bd1f5f320e?ixlib=rb-1.2.1&auto=format&fit=crop&w=1500&q=80\" className=\"object-cover w-full h-56 transition-all duration-300 ease-out sm64 group-hover110\" alt=\"Ocean\" />\n            </a>\n            <div className=\"relative mt-5\">\n              <p className=\"uppercase font-semibold text-xs mb-2.5 text-purple-600\">September 15th 2023</p>\n              <a href=\"#\" className=\"block mb-3 hover\">\n                <h2 className=\"text-2xl font-bold leading-5 text-black dark transition-colors duration-200 hover700 dark400\">\n                  Explore the Deep Oceans\n                </h2>\n              </a>\n              <p className=\"mb-4 text-gray-700 dark300\">Dive into the deep oceans and explore the beauty and mystery of the underwater world. A truly unforgettable experience.</p>\n              <a href=\"#_\" className=\"font-medium underline text-purple-600 dark400\">Read More</a>\n            </div>\n          </div>\n    \n          <div className=\"relative\">\n            <a href=\"#_\" className=\"block overflow-hidden group rounded-xl shadow-lg\">\n              <img src=\"https://images.unsplash.com/photo-1629112250823-3f091e001783?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w0NzEyNjZ8MHwxfHNlYXJjaHw4fHxEZXNlcnQlMjBTYWZhcml8ZW58MHwwfHx8MTcyNjkxODcwOHww&ixlib=rb-4.0.3&q=80&w=1080\" className=\"object-cover w-full h-56 transition-all duration-300 ease-out sm64 group-hover110\" alt=\"Desert Adventure\" />\n            </a>\n            <div className=\"relative mt-5\">\n              <p className=\"uppercase font-semibold text-xs mb-2.5 text-purple-600\">October 5th 2023</p>\n              <a href=\"#\" className=\"block mb-3 hover\">\n                <h2 className=\"text-2xl font-bold leading-5 text-black dark transition-colors duration-200 hover700 dark400\">\n                  Desert Safari\n                </h2>\n              </a>\n              <p className=\"mb-4 text-gray-700 dark300\">Venture into the heart of the desert and experience the thrill of a safari amidst the dunes.</p>\n              <a href=\"#_\" className=\"font-medium underline text-purple-600 dark400\">Read More</a>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n    </div>\n  );\n}\n",
