edin.\n      </p>\n      \n      <div class=\"flex flex-col sm:flex-row space-y-4 sm:space-y-0 sm:space-x-4 justify-center md:justify-start\">\n        <a href=\"#\" class=\"px-8 py-4 text-white bg-gradient-to-r from-indigo-600 to-purple-600 rounded-xl hover:from-indigo-500 hover:to-purple-500 shadow-lg shadow-indigo-600/30 transition-all duration-300 transform hover:-translate-y-1 flex items-center justify-center space-x-2\">\n          <span>Hemen Başla</span>\n          <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17 8l4 4m0 0l-4 4m4-4H3\"></path>\n          </svg>\n        </a>\n        \n        <a href=\"#\" class=\"px-8 py-4 text-white bg-transparent border border-indigo-400/30 rounded-xl hover:bg-indigo-500/10 transition-all duration-300 transform hover:-translate-y-1 flex items-center justify-center space-x-2\">\n          <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z\"></path>\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"></path>\n          </svg>\n          <span>Demo İzle</span>\n        </a>\n      </div>\n      \n      <div class=\"pt-8\">\n        <p class=\"text-gray-400 text-sm mb-4\">Güvendikleri için teşekkürler</p>\n        <div class=\"flex flex-wrap items-center justify-center md:justify-start gap-6\">\n          <img src=\"https://tailwindui.com/img/logos/tuple-logo-gray-300.svg\" alt=\"Tuple\" class=\"h-8 opacity-50 hover:opacity-100 transition-opacity duration-300\">\n          <img src=\"https://tailwindui.com/img/logos/mirage-logo-gray-300.svg\" alt=\"Mirage\" class=\"h-8 opacity-50 hover:opacity-100 transition-opacity duration-300\">\n          <img src=\"https://tailwindui.com/img/logos/statickit-logo-gray-300.svg\" alt=\"StaticKit\" class=\"h-8 opacity-50 hover:opacity-100 transition-opacity duration-300\">\n          <img src=\"https://tailwindui.com/img/logos/transistor-logo-gray-300.svg\" alt=\"Transistor\" class=\"h-8 opacity-50 hover:opacity-100 transition-opacity duration-300\">\n        </div>\n      </div>\n    </div>\n    \n    <!-- Sağ Taraf - Görsel İçerik -->\n    <div class=\"md:w-1/2 mt-12 md:mt-0 flex justify-center\">\n      <div class=\"relative\">\n        <!-- Ana Görsel -->\n        <div class=\"relative z-10 bg-gradient-to-br from-indigo-500/10 to-purple-500/10 backdrop-blur-xl border border-indigo-500/10 rounded-2xl p-1 shadow-2xl shadow-indigo-500/20\">\n          <img src=\"https://images.unsplash.com/photo-1620712943543-bcc4688e7485?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=crop&w=1965&q=80\" alt=\"Dashboard\" class=\"rounded-xl w-full max-w-lg\">\n        </div>\n        \n        <!-- Dekoratif Elementler -->\n        <div class=\"absolute -top-6 -right-6 w-20 h-20 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-full filter blur-xl opacity-50 animate-pulse\"></div>\n        <div class=\"absolute -bottom-6 -left-6 w-20 h-20 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-full filter blur-xl opacity-50 animate-pulse animation-delay-2000\"></div>\n        \n        <!-- Öne Çıkan Özellik Kartları -->\n        <div class=\"absolute -left-16 top-1/4 bg-gradient-to-br from-gray-900 to-gray-800 border border-indigo-500/20 rounded-lg p-4 shadow-lg shadow-indigo-500/10 backdrop-blur-xl w-48 transform -rotate-6 hover:rotate-0 transition-all duration-300\">\n          <div class=\"flex items-center space-x-3\">\n            <div class=\"w-10 h-10 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 flex items-cen