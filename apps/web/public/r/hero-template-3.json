    "rawHtml": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Black Lake Outdoors Clone</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        body { font-family: 'Inter', sans-serif; }\n    </style>\n</head>\n<body class=\"bg-white text-gray-900\">\n\n    <nav class=\"border-b border-gray-100\">\n        <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n            <div class=\"flex justify-between items-center h-20\">\n                <div class=\"flex-shrink-0 flex items-center\">\n                    <span class=\"font-semibold text-xl tracking-tight\">Black Lake Outdoors</span>\n                </div>\n\n                <div class=\"hidden md:flex space-x-8 text-sm font-medium text-gray-600\">\n                    <a href=\"#\" class=\"text-black hover:text-gray-900\">Home</a>\n                    <a href=\"#\" class=\"hover:text-black transition\">On The Lot</a>\n                    <a href=\"#\" class=\"flex items-center gap-1 hover:text-black transition\">\n                        Products \n                        <svg class=\"w-3 h-3\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\"></path></svg>\n                    </a>\n                    <a href=\"#\" class=\"hover:text-black transition\">Video</a>\n                </div>\n\n                <div>\n                    <a href=\"#\" class=\"bg-black text-white px-6 py-2.5 text-sm font-medium hover:bg-gray-800 transition\">\n                        Contact Us\n                    </a>\n                </div>\n            </div>\n        </div>\n    </nav>\n\n    <main class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-20\">\n        <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center\">\n            \n            <div>\n                <h1 class=\"text-5xl lg:text-7xl font-medium tracking-tight leading-tight uppercase\">\n                    Durable Portable\n                    <span class=\"inline-block align-middle ml-2\">\n                         <div class=\"h-10 w-24 lg:h-14 lg:w-32 rounded-full overflow-hidden border border-gray-200 relative\">\n                             <img src=\"https://images.unsplash.com/photo-1600596542815-e32870110029?q=80&w=300&auto=format&fit=crop\" class=\"object-cover w-full h-full\" alt=\"House\">\n                         </div>\n                    </span>\n                    <br>\n                    <span class=\"flex items-center gap-2 lg:gap-4 mt-2 lg:mt-4 flex-wrap\">\n                        <span>- &</span>\n                        <div class=\"h-10 w-24 lg:h-14 lg:w-32 rounded-full overflow-hidden border border-gray-200\">\n                             <img src=\"https://images.unsplash.com/photo-1523755231516-e43fd2e8dca5?q=80&w=300&auto=format&fit=crop\" class=\"object-cover w-full h-full\" alt=\"Carport\">\n                        </div>\n                        <span>In Laurel, MS</span>\n                    </span>\n                </h1>\n\n                <p class=\"mt-8 text-gray-500 text-lg max-w-md leading-relaxed\">\n                    Local inventory available for fast delivery. Stormor authorized for trusted quality. Fully customizable buildings designed in 3D.\n                </p>\n\n                <div class=\"mt-8\">\n                    <button class=\"group bg-black text-white pl-2 pr-6 py-2 rounded-full inline-flex items-center gap-4 transition-transform hover:scale-105\">\n                        <span class=\"bg-white text-black rounded-full p-2 group-hover:bg-gray-200 transition\">\n                            <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 19L19 5M19 5H9M19 5V15\"></path></svg>\n                        </span>\n                        <span class=\"font-medium\">View Project</span>\n                    </button>\n                </div>\n            </div>\n\n            <div class=\"relative w-full h-[400px] lg:h-[600px] rounded-3xl overflow-hidden shadow-2xl\">\n                <img src=\"https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?q=80&w=1000&auto=format&fit=crop\" \n                     class=\"absolute inset-0 w-full h-full object-cover\" \n                     alt=\"Modern House\">\n                \n                <div class=\"absolute inset-0 bg-gradient-to-t from-black/40 to-transparent pointer-events-none\"></div>\n\n                <div class=\"absolute bottom-6 left-1/2 transform -translate-x-1/2 flex space-x-2\">\n                    <button class=\"w-2 h-2 rounded-full bg-white opacity-100\"></button>\n                    <button class=\"w-2 h-2 rounded-full bg-white opacity-50 hover:opacity-100 transition\"></button>\n                    <button class=\"w-2 h-2 rounded-full bg-white opacity-50 hover:opacity-100 transition\"></button>\n                    <button class=\"w-2 h-2 rounded-full bg-white opacity-50 hover:opacity-100 transition\"></button>\n                </div>\n            </div>\n\n        </div>\n    </main>\n\n</body>\n</html>"
