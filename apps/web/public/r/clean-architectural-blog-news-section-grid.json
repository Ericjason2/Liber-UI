    "rawHtml": "<section class=\"bg-gray-100 py-16 sm:py-20\">\n  <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n\n    <!-- Section Header -->\n    <div class=\"max-w-2xl mx-auto text-center mb-10\">\n      <h2 class=\"text-3xl font-bold tracking-tight text-gray-900 mb-3\">\n        Latest Insights & Stories\n      </h2>\n      <p class=\"text-gray-600\">\n        Explore architectural trends, project highlights, and updates from FIND Design.\n      </p>\n    </div>\n\n    <!-- Post Grid -->\n    <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2\">\n\n      <!-- Card Item 1 -->\n      <a href=\"#\" class=\"group relative h-72 sm:h-80 overflow-hidden bg-gray-900 shadow-sm hover:shadow-lg transition\">\n        <!-- Background Image -->\n        <img \n          src=\"https://images.unsplash.com/photo-1600585154340-be6161a56a0c?q=80&w=800\" \n          alt=\"Tropical Architecture Trends in Bali 2026\"\n          loading=\"lazy\" \n          class=\"absolute inset-0 w-full h-full object-cover opacity-80 group-hover:scale-105 transition duration-300\"\n        />\n\n        <!-- Gradient Overlay -->\n        <div class=\"absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent\"></div>\n\n        <!-- Content Area -->\n        <div class=\"absolute bottom-0 inset-x-0 p-5 flex flex-col justify-end\">\n          <!-- Badge -->\n          <span class=\"self-start text-[10px] font-semibold tracking-wider uppercase px-2.5 py-1 mb-2.5 bg-white/20 backdrop-blur-md text-white\">\n            Article\n          </span>\n\n          <!-- Title Wrapper (Baris pertama selalu sejajar) -->\n          <div class=\"h-14 mb-1\">\n            <h3 class=\"text-lg font-bold text-white leading-snug line-clamp-2 group-hover:text-gray-200 transition\">\n              Tropical Architecture Trends in Bali 2026\n            </h3>\n          </div>\n\n          <!-- Short Description dengan Titik Tiga -->\n          <p class=\"text-xs text-gray-300 line-clamp-2 mb-2 leading-relaxed\">\n            Discover how sustainable materials and open-plan concepts are reshaping modern luxury villas across Bali...\n          </p>\n\n          <!-- Divider Line & Calendar Icon -->\n          <div class=\"border-t border-white/20 pt-1.5 flex items-center gap-1.5\">\n            <svg class=\"w-3.5 h-3.5 text-gray-300 shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z\" />\n            </svg>\n            <time class=\"text-xs text-gray-300\" datetime=\"2026-10-11\">\n              Oct 11, 2026\n            </time>\n          </div>\n        </div>\n      </a>\n\n      <!-- Card Item 2 -->\n      <a href=\"#\" class=\"group relative h-72 sm:h-80 overflow-hidden bg-gray-900 shadow-sm hover:shadow-lg transition\">\n        <img \n          src=\"https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?q=80&w=800\" \n          alt=\"FIND Design Wins Best Architectural Excellence Award\"\n          loading=\"lazy\" \n          class=\"absolute inset-0 w-full h-full object-cover opacity-80 group-hover:scale-105 transition duration-300\"\n        />\n\n        <div class=\"absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent\"></div>\n\n        <div class=\"absolute bottom-0 inset-x-0 p-5 flex flex-col justify-end\">\n          <span class=\"self-start text-[10px] font-semibold tracking-wider uppercase px-2.5 py-1 mb-2.5 bg-white/20 backdrop-blur-md text-white\">\n            News\n          </span>\n\n          <div class=\"h-14 mb-1\">\n            <h3 class=\"text-lg font-bold text-white leading-snug line-clamp-2 group-hover:text-gray-200 transition\">\n              FIND Design Wins Best Architectural Excellence Award\n            </h3>\n          </div>\n\n          <p class=\"text-xs text-gray-300 line-clamp-2 mb-2 leading-relaxed\">\n            Our firm has been recognized nationally for pushing the boundaries of tropical contemporary architecture...\n          </p>\n\n          <div class=\"border-t border-white/20 pt-1.5 flex items-center gap-1.5\">\n            <svg class=\"w-3.5 h-3.5 text-gray-300 shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z\" />\n            </svg>\n            <time class=\"text-xs text-gray-300\" datetime=\"2026-09-25\">\n              Sep 25, 2026\n            </time>\n          </div>\n        </div>\n      </a>\n\n      <!-- Card Item 3 -->\n      <a href=\"#\" class=\"group relative h-72 sm:h-80 overflow-hidden bg-gray-900 shadow-sm hover:shadow-lg transition\">\n        <img \n          src=\"https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?q=80&w=800\" \n          alt=\"Behind the Scenes: Site Visit to Gianyar Project\"\n          loading=\"lazy\" \n          class=\"absolute inset-0 w-full h-full object-cover opacity-80 group-hover:scale-105 transition duration-300\"\n        />\n\n        <div class=\"absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent\"></div>\n\n        <div class=\"absolute bottom-0 inset-x-0 p-5 flex flex-col justify-end\">\n          <span class=\"self-start text-[10px] font-semibold tracking-wider uppercase px-2.5 py-1 mb-2.5 bg-white/20 backdrop-blur-md text-white\">\n            Event\n          </span>\n\n          <div class=\"h-14 mb-1\">\n            <h3 class=\"text-lg font-bold text-white leading-snug line-clamp-2 group-hover:text-gray-200 transition\">\n              Behind the Scenes: Site Visit to Gianyar Project\n            </h3>\n          </div>\n\n          <p class=\"text-xs text-gray-300 line-clamp-2 mb-2 leading-relaxed\">\n            Take an exclusive look at the structural progress and material selection for our ongoing cliffside retreat...\n          </p>\n\n          <div class=\"border-t border-white/20 pt-1.5 flex items-center gap-1.5\">\n            <svg class=\"w-3.5 h-3.5 text-gray-300 shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z\" />\n            </svg>\n            <time class=\"text-xs text-gray-300\" datetime=\"2026-09-24\">\n              Sep 24, 2026\n            </time>\n          </div>\n        </div>\n      </a>\n\n    </div>\n\n    <!-- Action Button (Capsule Outlined) -->\n    <div class=\"flex justify-center mt-12\">\n      <a href=\"#\" class=\"inline-flex items-center gap-2 rounded-full border border-gray-400 bg-transparent px-7 py-3 text-sm font-semibold text-gray-900 hover:bg-gray-900 hover:border-gray-900 hover:text-white transition duration-200\">\n        View All Articles\n        <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17 8l4 4m0 0l-4 4m4-4H3\" />\n        </svg>\n      </a>\n    </div>\n\n  </div>\n</section>"
