    "rawHtml": "<div class=\"flex flex-col space-y-4 p-4 dark:bg-gray-800\">\n        <!-- Primary Button -->\n        <button class=\"bg-blue-600 text-white font-bold py-2 px-4 rounded hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-opacity-50 dark:bg-blue-500 dark:hover:bg-blue-600\">\n            Primary Button\n        </button>\n\n        <!-- Outlined Button -->\n        <button class=\"border border-blue-600 text-blue-600 font-bold py-2 px-4 rounded hover:bg-blue-600 hover:text-white focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-opacity-50 dark:border-blue-500 dark:text-blue-500 dark:hover:bg-blue-500 dark:hover:text-white\">\n            Outlined Button\n        </button>\n\n        <!-- Text Button -->\n        <button class=\"text-blue-600 font-bold py-2 px-4 rounded hover:bg-blue-600 hover:text-white focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-opacity-50 dark:text-blue-500 dark:hover:bg-blue-500 dark:hover:text-white\">\n            Text Button\n        </button>\n\n        <!-- Link Button -->\n        <button href=\"#\" class=\"text-blue-600 font-bold hover:underline dark:text-blue-500 dark:hover:text-blue-400\">\n            Link Button\n        </button>\n    </div>"
