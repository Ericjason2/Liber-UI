      "content": "/**\n * Component: Buttons set\n * Author: @akram6t (https://tailwindflex.com/@akram6t)\n * Source: https://tailwindflex.com/@akram6t/buttons-set\n * Attribution: Créé par @akram6t sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function ButtonsSet() {\n  return (\n    <div>\n    <div className=\"flex flex-col space-y-4 p-4 dark800\">\n            \n            <button className=\"bg-blue-600 text-white font-bold py-2 px-4 rounded hover700 focus focus2 focus400 focus50 dark500 dark600\">\n                Primary Button\n            </button>\n    \n            \n            <button className=\"border border-blue-600 text-blue-600 font-bold py-2 px-4 rounded hover600 hover focus focus2 focus400 focus50 dark500 dark500 dark500 dark\">\n                Outlined Button\n            </button>\n    \n            \n            <button className=\"text-blue-600 font-bold py-2 px-4 rounded hover600 hover focus focus2 focus400 focus50 dark500 dark500 dark\">\n                Text Button\n            </button>\n    \n            \n            <button href=\"#\" className=\"text-blue-600 font-bold hover dark500 dark400\">\n                Link Button\n            </button>\n        </div>\n    </div>\n  );\n}\n",
