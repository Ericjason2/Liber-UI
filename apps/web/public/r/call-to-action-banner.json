      "content": "import * as React from \"react\"\n\nfunction CallToActionBanner({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"call-to-action-banner\"\n      className={className}\n      {...props}\n    >\n      <div className=\"relative flex-1 bg-blue-600 px-5 py-24 lg8\">\n        <div className=\"mx-auto max-w-3xl text-center\">\n          <h2 className=\"text-center text-4xl font-bold leading-tight text-white md5xl\">Automate customer support in under\n            2 weeks</h2>\n          <div className=\"mt-10 flex flex-col items-center justify-center space-y-5 sm sm6 sm0\">\n            <a href=\"/\" target=\"_blank\" rel=\"nofollow noreferrer\"\n              className=\"w-full rounded-3xl border border-gray-900 bg-gray-900 px-7 py-3 text-center text-base font-bold text-white transition-colors duration-150 ease-in-out hover800 hover800 sm sm2\">Get\n              a demo</a>\n            <a className=\"relative inline-flex w-full items-center justify-center rounded-3xl border border-white px-7 py-3 sm sm2\"\n              href=\"/pricing\">\n              <p className=\"text-base font-bold text-white\">Get started</p>\n              <span className=\"absolute inset-0 z-0 overflow-hidden rounded-3xl opacity-0 transition-colors duration-150 ease-in-out hover[#f5f7fc] hover5\"></span>\n            </a>\n          </div>\n        </div>\n      </div>\n    </div>\n  )\n}\n\nexport { CallToActionBanner }\n",
      "type": "registry:ui"
    }
  ],
