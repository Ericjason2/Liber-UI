ded-md text-gray-800 bg-indigo-100 hover200 md4 md md10\">\n                            Live demo\n                        </a>\n                    </div>\n                </div>\n                \n            </div>\n    \n            \n            <div className=\"lg0 lg0 lg1/2 my-4\">\n                <img className=\"h-56 w-full object-cover sm72 md96 lg lg\" src=\"https://images.unsplash.com/photo-1551434678-e076c223a692?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=crop&w=2850&q=80\" alt=\"\" />\n            </div>\n            \n        </div>\n    \n    </section>\n    </div>\n  );\n}\n",
