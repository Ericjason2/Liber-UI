      "content": "/**\n * Component: Forgot password form\n * Author: @steven-kuhn (https://tailwindflex.com/@steven-kuhn)\n * Source: https://tailwindflex.com/@steven-kuhn/forgot-password-form\n * Attribution: Créé par @steven-kuhn sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function ForgotPasswordForm() {\n  return (\n    <div>\n    <main id=\"content\" role=\"main\" className=\"w-full  max-w-md mx-auto p-6\">\n        <div className=\"mt-7 bg-white  rounded-xl shadow-lg dark800 dark700 border-2 border-indigo-300\">\n          <div className=\"p-4 sm7\">\n            <div className=\"text-center\">\n              <h1 className=\"block text-2xl font-bold text-gray-800 dark\">Forgot password?</h1>\n              <p className=\"mt-2 text-sm text-gray-600 dark400\">\n                Remember your password?\n                <a className=\"text-blue-600 decoration-2 hover font-medium\" href=\"#\">\n                  Login here\n                </a>\n              </p>\n            </div>\n    \n            <div className=\"mt-5\">\n              <form>\n                <div className=\"grid gap-y-4\">\n                  <div>\n                    <label htmlFor=\"email\" className=\"block text-sm font-bold ml-1 mb-2 dark\">Email address</label>\n                    <div className=\"relative\">\n                      <input type=\"email\" id=\"email\" name=\"email\" className=\"py-3 px-4 block w-full border-2 border-gray-200 rounded-md text-sm focus500 focus500 shadow-sm\" required aria-describedby=\"email-error\" />\n                    </div>\n                    <p className=\"hidden text-xs text-red-600 mt-2\" id=\"email-error\">Please include a valid email address so we can get back to you</p>\n                  </div>\n                  <button type=\"submit\" className=\"py-3 px-4 inline-flex justify-center items-center gap-2 rounded-md border border-transparent font-semibold bg-blue-500 text-white hover600 focus focus2 focus500 focus2 transition-all text-sm dark800\">Reset password</button>\n                </div>\n              </form>\n            </div>\n          </div>\n        </div>\n    \n        <p className=\"mt-3 flex justify-center items-center text-center divide-x divide-gray-300 dark700\">\n          <a className=\"pr-3.5 inline-flex items-center gap-x-2 text-sm text-gray-600 decoration-2 hover hover600 dark500 dark200\" href=\"#\" target=\"_blank\">\n            <svg className=\"w-3.5 h-3.5\" xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" fill=\"currentColor\" viewBox=\"0 0 16 16\">\n              <path d=\"M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z\" />\n            </svg>\n            View Github\n          </a>\n          <a className=\"pl-3 inline-flex items-center gap-x-2 text-sm text-gray-600 decoration-2 hover hover600 dark500 dark200\" href=\"#\">\n            \n            Contact us!\n          </a>\n        </p>\n      </main>\n    </div>\n  );\n}\n",
