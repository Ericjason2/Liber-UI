    "rawHtml": "<body class=\"flex items-center justify-center min-h-screen p-4 bg-black\">\n  <div class=\"max-w-md w-full bg-white rounded-2xl overflow-hidden shadow-lg transition-all duration-300 hover:shadow-xl\">\n    <!-- Cover Image -->\n    <div class=\"h-32 bg-gradient-to-r from-purple-500 to-indigo-600 relative\">\n      <div class=\"absolute -bottom-12 left-1/2 transform -translate-x-1/2\">\n        <img class=\"h-24 w-24 rounded-full border-4 border-white object-cover\" src=\"https://images.unsplash.com/photo-1494790108377-be9c29b29330?ixlib=rb-1.2.1&auto=format&fit=crop&w=256&q=80\" alt=\"Profile picture\">\n      </div>\n    </div>\n    \n    <!-- Profile Info -->\n    <div class=\"pt-16 pb-8 px-6 text-center\">\n      <h3 class=\"text-xl font-bold text-gray-800\">Sarah Johnson</h3>\n      <p class=\"text-indigo-600 font-medium\">Senior Product Designer</p>\n      <p class=\"text-gray-500 mt-2\">Creating user-centered designs that solve real problems. Passionate about accessibility and inclusive design.</p>\n      \n      <!-- Stats -->\n      <div class=\"flex justify-center space-x-6 mt-6\">\n        <div class=\"text-center\">\n          <p class=\"text-2xl font-bold text-gray-800\">142</p>\n          <p class=\"text-sm text-gray-500\">Projects</p>\n        </div>\n        <div class=\"text-center\">\n          <p class=\"text-2xl font-bold text-gray-800\">24.5K</p>\n          <p class=\"text-sm text-gray-500\">Followers</p>\n        </div>\n        <div class=\"text-center\">\n          <p class=\"text-2xl font-bold text-gray-800\">562</p>\n          <p class=\"text-sm text-gray-500\">Following</p>\n        </div>\n      </div>\n      \n      <!-- Contact Buttons -->\n      <div class=\"mt-8 flex justify-center space-x-3\">\n        <button class=\"flex-1 bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2 px-4 rounded-lg transition duration-150 ease-in-out\">\n          Follow\n        </button>\n        <button class=\"flex-1 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 font-medium py-2 px-4 rounded-lg transition duration-150 ease-in-out\">\n          Message\n        </button>\n      </div>\n      \n      <!-- Social Links -->\n      <div class=\"mt-8 flex justify-center space-x-5\">\n        <a href=\"#\" class=\"text-gray-400 hover:text-indigo-500 transition-colors duration-200\">\n          <i class=\"fab fa-twitter text-xl\"></i>\n        </a>\n        <a href=\"#\" class=\"text-gray-400 hover:text-indigo-500 transition-colors duration-200\">\n          <i class=\"fab fa-linkedin-in text-xl\"></i>\n        </a>\n        <a href=\"#\" class=\"text-gray-400 hover:text-indigo-500 transition-colors duration-200\">\n          <i class=\"fab fa-dribbble text-xl\"></i>\n        </a>\n        <a href=\"#\" class=\"text-gray-400 hover:text-indigo-500 transition-colors duration-200\">\n          <i class=\"fab fa-github text-xl\"></i>\n        </a>\n        <a href=\"#\" class=\"text-gray-400 hover:text-indigo-500 transition-colors duration-200\">\n          <i class=\"fab fa-instagram text-xl\"></i>\n        </a>\n      </div>\n    </div>\n    \n    <!-- Skills -->\n    <div class=\"px-6 pb-8\">\n      <div class=\"flex flex-wrap gap-2\">\n        <span class=\"px-3 py-1 bg-indigo-100 text-indigo-600 text-sm font-medium rounded-full\">UI/UX</span>\n        <span class=\"px-3 py-1 bg-indigo-100 text-indigo-600 text-sm font-medium rounded-full\">Figma</span>\n        <span class=\"px-3 py-1 bg-indigo-100 text-indigo-600 text-sm font-medium rounded-full\">Prototyping</span>\n        <span class=\"px-3 py-1 bg-indigo-100 text-indigo-600 text-sm font-medium rounded-full\">Wireframing</span>\n        <span class=\"px-3 py-1 bg-indigo-100 text-indigo-600 text-sm font-medium rounded-full\">User Research</span>\n      </div>\n    </div>\n  </div>\n</body>"
