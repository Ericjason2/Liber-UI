ont-bold text-gray-800\">David Wilson</h3>\n                <p className=\"text-indigo-600 font-medium\">Lead Developer</p>\n                <p className=\"text-gray-600 mt-2\">Full-stack developer with a knack for solving complex problems.</p>\n              </div>\n            </div>\n            \n            \n            <div className=\"group\">\n              <div className=\"relative overflow-hidden rounded-xl mb-4\">\n                <img src=\"https://images.unsplash.com/photo-1534751516642-a1af1ef26a56?ixlib=rb-1.2.1&auto=format&fit=crop&w=500&q=80\" alt=\"Team member\" className=\"w-full aspect-[3/4] object-cover object-center transform group-hover105 transition duration-300 ease-in-out\" />\n                <div className=\"absolute inset-0 bg-gradient-to-t from-black/70 to-transparent opacity-0 group-hover100 transition-opacity duration-300 flex items-end justify-center p-6\">\n                  <div className=\"flex space-x-4\">\n                    <a href=\"#\" className=\"bg-white text-indigo-600 p-2 rounded-full hover600 hover transition-colors duration-200\">\n                      <i className=\"fab fa-linkedin-in\"></i>\n                    </a>\n                    <a href=\"#\" className=\"bg-white text-indigo-600 p-2 rounded-full hover600 hover transition-colors duration-200\">\n                      <i className=\"fab fa-twitter\"></i>\n                    </a>\n                    <a href=\"#\" className=\"bg-white text-indigo-600 p-2 rounded-full hover600 hover transition-colors duration-200\">\n                      <i className=\"fas fa-envelope\"></i>\n                    </a>\n                  </div>\n                </div>\n              </div>\n              <div className=\"text-center\">\n                <h3 className=\"text-xl font-bold text-gray-800\">Sophia Lee</h3>\n                <p className=\"text-indigo-600 font-medium\">UX Researcher</p>\n                <p className=\"text-gray-600 mt-2\">Human-centered designer focuse