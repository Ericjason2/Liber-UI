0 hover:text-white transition-colors duration-200\">\n                  <i class=\"fas fa-envelope\"></i>\n                </a>\n              </div>\n            </div>\n          </div>\n          <div class=\"text-center\">\n            <h3 class=\"text-xl font-bold text-gray-800\">Alex Morgan</h3>\n            <p class=\"text-indigo-600 font-medium\">CEO & Founder</p>\n            <p class=\"text-gray-600 mt-2\">Visionary leader with 15+ years of experience in tech innovation.</p>\n          </div>\n        </div>\n        \n        <!-- Team Member 2 -->\n        <div class=\"group\">\n          <div class=\"relative overflow-hidden rounded-xl mb-4\">\n            <img src=\"https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?ixlib=rb-1.2.1&auto=format&fit=crop&w=500&q=80\" alt=\"Team member\" class=\"w-full aspect-[3/4] object-cover object-center transform group-hover:scale-105 transition duration-300 ease-in-out\">\n            <div class=\"absolute inset-0 bg-gradient-to-t from-black/70 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end justify-center p-6\">\n              <div class=\"flex space-x-4\">\n                <a href=\"#\" class=\"bg-white text-indigo-600 p-2 rounded-full hover:bg-indigo-600 hover:text-white transition-colors duration-200\">\n                  <i class=\"fab fa-linkedin-in\"></i>\n                </a>\n                <a href=\"#\" class=\"bg-white text-indigo-600 p-2 rounded-full hover:bg-indigo-600 hover:text-white transition-colors duration-200\">\n                  <i class=\"fab fa-twitter\"></i>\n                </a>\n                <a href=\"#\" class=\"bg-white text-indigo-600 p-2 rounded-full hover:bg-indigo-600 hover:text-white transition-colors duration-200\">\n                  <i class=\"fas fa-envelope\"></i>\n                </a>\n              </div>\n            </div>\n          </div>\n          <div class=\"text-center\">\n            <h3 class=\"text-xl fo