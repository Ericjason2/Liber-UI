lex items-center\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"h-5 w-5 mr-2 text-green-500\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"M5 13l4 4L19 7\"></path>\n              </svg>\n              Secure data storage\n            </li>\n          </ul>\n          <button className=\"mt-6 bg-green-500 hover600 text-white font-semibold py-2 px-4 rounded-full transition duration-300 ease-in-out transform hover105\">\n            Get Started\n          </button>\n        </div>\n      </div>\n    </div>\n  )\n}\n\nexport { MinimalPricingCardDesign }\n",
