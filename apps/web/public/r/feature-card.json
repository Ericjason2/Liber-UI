      "content": "/**\n * Component: Feature Card\n * Author: @prajwal (https://tailwindflex.com/@prajwal)\n * Source: https://tailwindflex.com/@prajwal/feature-card\n * Attribution: Créé par @prajwal sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function FeatureCard() {\n  return (\n    <div>\n    <div className=\"flex justify-center items-center dark800 h-screen w-full\">\n        <div className=\"relative cursor-pointer dark\">\n            <span className=\"absolute top-0 left-0 w-full h-full mt-1 ml-1 bg-indigo-500 rounded-lg dark200\"></span>\n            <div\n                className=\"relative p-6 bg-white dark800 border-2 border-indigo-500 dark300 rounded-lg hover105 transition duration-500\">\n                <div className=\"flex items-center\">\n                    <span className=\"text-xl\">😎</span>\n                    <h3 className=\"my-2 ml-3 text-lg font-bold text-gray-800 dark\">Cool Feature</h3>\n                </div>\n                <p className=\"text-gray-600 dark300\">\n                    This is the short description of your feature.\n                </p>\n            </div>\n        </div>\n    \n    </div>\n    </div>\n  );\n}\n",
