    "rawHtml": "<script src=\"//unpkg.com/alpinejs\" defer></script>\n\n<section class=\"relative flex justify-center items-center min-h-screen dark:bg-teal-800 bg-gray-100 p-8\"\n  x-data=\"{ isExpanded: false }\">\n  <div x-bind:class=\"isExpanded ? 'w-[600px]' : 'w-[280px]'\"\n    class=\"\n        relative bg-gradient-to-br from-teal-600 to-teal-700 rounded-3xl shadow-2xl overflow-hidden transition-all duration-500 ease-in-out h-[400px]\">\n    <!-- Plus/X Button -->\n    <button x-on:click=\"isExpanded = ! isExpanded\" class=\"absolute top-4 right-4 w-10 h-10 bg-gray-800 rounded-full flex items-center justify-center transition-transform duration-300 hover:scale-110 z-10\">\n      <div class=\"w-5 h-0.5 bg-orange-500 absolute transition-transform duration-300\" :class=\"\n            isExpanded ? 'rotate-45' : ''\"></div>\n      <div class=\"w-0.5 h-5 bg-orange-500 absolute transition-transform duration-300\" :class=\"isExpanded ? 'rotate-45' : ''\"></div>\n    </button>\n\n    <div class=\"flex h-full\">\n      <div class=\"flex-shrink-0 w-[280px] flex flex-col items-center justify-center p-6 text-white\">\n        <div class=\"w-32 h-32 rounded-full overflow-hidden mb-6 border-4 border-white/20\">\n          <img src=\"https://placecats.com/250/250\" alt=\"Cart in place\" class=\"w-full h-full object-cover\">\n        </div>\n        <h2 class=\"text-2xl font-bold text-center mb-2\">Cat in place</h2>\n        <p class=\"text-lg text-teal-100 text-center\">Showing its wellbeing</p>\n      </div>\n\n      <!-- Expanded Content -->\n      <div\n        class=\"flex-1 bg-white/95 dark:bg-gray-700 backdrop-blur-sm transition-all duration-500 ease-in-out overflow-hidden\">\n        <div class=\"transition-opacity p-6 h-full flex flex-col justify-center\"\n          :class=\"isExpanded ? 'opacity-100 translate-x-0 delay-300' : 'opacity-0 translate-x-full'\">\n          <h3 class=\"text-xl font-bold text-gray-800 dark:text-gray-100 mb-4\"> Aditional Information</h3>\n\n          <div class=\"space-y-4\">\n            <div>\n              <h4 class=\"font-semibold text-gray-700 dark:text-gray-200 mb-1\">Position at work</h4>\n              <p class=\"text-gray-600 dark:text-gray-300\">Personal Coach</p>\n            </div>\n\n            <div>\n              <h4 class=\"font-semibold text-gray-700 dark:text-gray-200 mb-1\">Contact</h4>\n              <p class=\"text-gray-600 dark:text-gray-300\">your.cat@company.com</p>\n              <p class=\"text-gray-600  dark:text-gray-300\">+1 (555) 123-4567</p>\n            </div>\n\n            <div>\n              <h4 class=\"font-semibold text-gray-700 dark:text-gray-200 mb-1\">Experience</h4>\n              <p class=\"text-gray-600 dark:text-gray-300\">Top selling author</p>\n            </div>\n\n            <div>\n              <h4 class=\"font-semibold text-gray-700 dark:text-gray-200 mb-1\">Specialties</h4>\n              <div class=\"flex flex-wrap gap-2 mt-2\">\n                <span class=\"px-3 py-1 bg-teal-100 dark:bg-teal-600 text-teal-700 dark:text-gray-200 rounded-full text-sm\">Wellbeing</span>\n                <span class=\"px-3 py-1 bg-teal-100 dark:bg-teal-600 text-teal-700 dark:text-gray-200 rounded-full text-sm\">Meditation</span>\n                <span class=\"px-3 py-1 bg-teal-100 dark:bg-teal-600 text-teal-700 dark:text-gray-200 rounded-full text-sm\">Self Defense</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>"
