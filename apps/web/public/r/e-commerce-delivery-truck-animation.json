    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Delivery Bus Animation with Notification</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        @keyframes moveBus {\n            0% { transform: translateX(-100%); }\n            70% { transform: translateX(80%); }\n            100% { transform: translateX(80%); }\n        }\n        @keyframes movePackage {\n            0% { opacity: 0; transform: translateY(0); }\n            20% { opacity: 1; transform: translateY(0); }\n            70% { opacity: 1; transform: translateY(0); }\n            80% { opacity: 1; transform: translateY(-100px); }\n            100% { opacity: 0; transform: translateY(-100px); }\n        }\n        @keyframes showNotification {\n            0% { opacity: 0; transform: translateY(20px); }\n            80% { opacity: 0; transform: translateY(20px); }\n            90% { opacity: 1; transform: translateY(0); }\n            100% { opacity: 1; transform: translateY(0); }\n        }\n        .bus-animation {\n            animation: moveBus 8s linear infinite;\n        }\n        .package-animation {\n            animation: movePackage 8s linear infinite;\n        }\n        .notification-animation {\n            animation: showNotification 8s linear infinite;\n        }\n    </style>\n</head>\n<body class=\"bg-blue-50 min-h-screen flex items-center overflow-hidden\">\n    <div class=\"container mx-auto px-4 relative h-64\">\n        <!-- Road -->\n        <div class=\"absolute bottom-0 left-0 right-0 h-16 bg-gray-700 flex items-center\">\n            <div class=\"w-full h-1 bg-yellow-300 relative overflow-hidden\">\n                <div class=\"absolute top-0 left-0 w-64 h-full bg-yellow-300 transform -translate-x-full road-line\"></div>\n            </div>\n        </div>\n        \n        <!-- Bus -->\n        <div class=\"bus-animation absolute bottom-16 left-0 w-48 md:w-64\">\n            <div class=\"relative\">\n                <!-- Bus body -->\n                <div class=\"bg-yellow-400 h-24 rounded-lg p-2\">\n                    <!-- Windows -->\n                    <div class=\"flex space-x-1 mb-1\">\n                        <div class=\"w-6 h-6 bg-blue-300 rounded\"></div>\n                        <div class=\"w-6 h-6 bg-blue-300 rounded\"></div>\n                        <div class=\"w-6 h-6 bg-blue-300 rounded\"></div>\n                    </div>\n                    <!-- Package inside bus (visible at start) -->\n                    <div class=\"package-animation absolute top-4 left-1/2 transform -translate-x-1/2\">\n                        <div class=\"w-12 h-8 bg-red-500 relative\">\n                            <div class=\"absolute top-0 left-0 right-0 h-2 bg-white opacity-50\"></div>\n                            <div class=\"absolute bottom-0 left-0 right-0 h-2 bg-white opacity-50\"></div>\n                        </div>\n                    </div>\n                </div>\n                <!-- Bus front -->\n                <div class=\"absolute top-4 -right-4 w-8 h-12 bg-yellow-500 rounded-r-lg\"></div>\n                <!-- Wheels -->\n                <div class=\"absolute -bottom-2 left-4 w-8 h-8 bg-gray-800 rounded-full border-2 border-gray-600\"></div>\n                <div class=\"absolute -bottom-2 right-8 w-8 h-8 bg-gray-800 rounded-full border-2 border-gray-600\"></div>\n                <!-- Headlight -->\n                <div class=\"absolute top-8 -right-4 w-2 h-4 bg-yellow-200 rounded-r\"></div>\n            </div>\n        </div>\n        \n        <!-- Delivery destination -->\n        <div class=\"absolute bottom-16 right-8 md:right-16 w-16 h-24 bg-green-500 flex flex-col items-center justify-end pb-2\">\n            <div class=\"w-12 h-8 bg-red-500 relative\">\n                <div class=\"absolute top-0 left-0 right-0 h-2 bg-white opacity-50\"></div>\n                <div class=\"absolute bottom-0 left-0 right-0 h-2 bg-white opacity-50\"></div>\n            </div>\n            <div class=\"text-white text-xs mt-1\">Delivery</div>\n        </div>\n        \n        <!-- Package being delivered (flies up at end) -->\n        <div class=\"package-animation absolute bottom-16 right-24 md:right-32\">\n            <div class=\"w-12 h-8 bg-red-500 relative\">\n                <div class=\"absolute top-0 left-0 right-0 h-2 bg-white opacity-50\"></div>\n                <div class=\"absolute bottom-0 left-0 right-0 h-2 bg-white opacity-50\"></div>\n            </div>\n        </div>\n        \n        <!-- Delivery Notification -->\n        <div class=\"notification-animation absolute top-8 left-1/2 transform -translate-x-1/2 bg-white p-4 rounded-lg shadow-lg border border-green-300 max-w-xs\">\n            <div class=\"flex items-center\">\n                <div class=\"bg-green-100 p-2 rounded-full mr-3\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-6 w-6 text-green-600\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\" />\n                    </svg>\n                </div>\n                <div>\n                    <h3 class=\"font-bold text-gray-800\">Delivery Successful!</h3>\n                    <p class=\"text-sm text-gray-600\">Your package has been delivered.</p>\n                </div>\n            </div>\n        </div>\n    </div>\n    \n    <!-- Road line animation -->\n    <style>\n        .road-line {\n            animation: moveLine 1s linear infinite;\n        }\n        @keyframes moveLine {\n            0% { transform: translateX(0); }\n            100% { transform: translateX(100%); }\n        }\n    </style>\n</body>\n</html>"
  }
}
