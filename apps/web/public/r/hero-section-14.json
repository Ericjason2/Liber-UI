      "content": "/**\n * Component: hero section\n * Author: @anonymous (https://tailwindflex.com/@anonymous)\n * Source: https://tailwindflex.com/@anonymous/hero-section-14\n * Attribution: Créé par @anonymous sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function HeroSection14() {\n  return (\n    <div>\n    <div className=\"items-center w-10/12 grid-cols-2 mx-auto overflow- lg md14 lg24 xl14 lg3 xl5\" data-aos=\"fade-right\" data-aos-duration=\"800\">\n              <div className=\"pr-2 md14 py-14 md0\">\n                <h1 className=\"text-3xl font-semibold text-blue-900 xl5xl lg3xl\"><span className=\"block w-full\">Get a financial experience</span> for growing your business!</h1>\n                <p className=\"py-4 text-lg text-gray-500 2xl8 md6 2xl5\">\n                  Empowering you to make better financial decisions, We truly are professional money planners...\n                </p>\n                <div className=\"mt-4\">\n                  <a href=\"#contact\" className=\"px-5 py-3 text-lg tracking-wider text-white bg-blue-500 rounded-lg md8 hover600 group\"><span>Explore More</span> </a>\n                </div>\n              </div>\n      \n              <div className=\"pb-10 overflow-hidden md10 lg0 sm0\">\n                <img id=\"heroImg1\" className=\"transition-all duration-300 ease-in-out hover105 lg sm sm4/6 sm12 lg0\" src=\"https://bootstrapmade.com/demo/templates/FlexStart/assets/img/hero-img.png\" alt=\"Awesome hero page image\" width=\"500\" height=\"488\"/>\n              </div>\n            </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
