iv>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <!-- Right Section -->\n        <div class=\"w-full md:w-1/2 p-6 md:p-12\">\n            <div class=\"max-w-md mx-auto\">\n                <h1 class=\"text-white text-2xl md:text-4xl font-semibold mb-2\">Create an account</h1>\n                <p class=\"text-gray-400 mb-8\">\n                    Already have an account?\n                    <a href=\"https://abhirajk.vercel.app/\" class=\"text-white hover:underline\">Log in</a>\n                </p>\n\n                <form class=\"space-y-4\">\n                    <div class=\"flex flex-col md:flex-row gap-4\">\n                        <input type=\"text\" placeholder=\"First name\" class=\"w-full md:w-1/2 bg-[#1c1c24] text-white rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-purple-600\">\n                        <input type=\"text\" placeholder=\"Last name\" class=\"w-full md:w-1/2 bg-[#1c1c24] text-white rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-purple-600\">\n                    </div>\n                    <input type=\"email\" placeholder=\"Email\" class=\"w-full bg-[#1c1c24] text-white rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-purple-600\">\n                    <div class=\"relative\">\n                        <input type=\"password\" placeholder=\"Enter your password\" class=\"w-full bg-[#1c1c24] text-white rounded-lg p-3 pr-10 focus:outline-none focus:ring-2 focus:ring-purple-600\">\n                        <button type=\"button\" class=\"absolute right-3 top-1/2 -translate-y-1/2\">\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-5 w-5 text-gray-400\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M15 12a3 3 0 11-6 0 3 3 0 016 0z\" />\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z\" />\n                            </svg>\n                        </button>\n                    </div>\n\n                    <label class=\"flex items-center space-x-2 cursor-pointer\">\n                        <input type=\"checkbox\" class=\"rounded bg-[#1c1c24] border-gray-600 text-purple-600 focus:ring-purple-600\">\n                        <span class=\"text-gray-400\">I agree to the <a href=\"#\" class=\"text-white hover:underline\">Terms & Conditions</a></span>\n                    </label>\n\n                    <button type=\"submit\" class=\"w-full bg-purple-600 text-white rounded-lg p-3 hover:bg-purple-700 transition-colors\">\n                        Create account\n                    </button>\n\n                    <div class=\"relative my-8\">\n                        <div class=\"absolute inset-0 flex items-center\">\n                            <div class=\"w-full border-t border-gray-700\"></div>\n                        </div>\n                        <div class=\"relative flex justify-center text-sm\">\n                            <span class=\"px-2 bg-[#13131a] text-gray-400\">Or register with</span>\n                        </div>\n                    </div>\n\n                    <div class=\"flex flex-col md:flex-row gap-4\">\n                        <button type=\"button\" class=\"w-full md:w-1/2 flex items-center justify-center gap-2 bg-[#1c1c24] text-white rounded-lg p-3 hover:bg-[#25252e] transition-colors\">\n                            <svg class=\"w-5 h-5\" viewBox=\"0 0 24 24\">\n                                <path fill=\"currentColor\" d=\"M12.545,10.239v3.821h5.445c-0.712,2.315-2.647,3.972-5.445,3.972c-3.332,0-6.033-2.701-6.033-6.032s2.701-6.032,6.033-6.032c1.498,0,2.866,0.549,3.921,1.453l2.814-2.814C17.503,2.988,15.139,2,12.545,2C7.021,2,2.543,6.477,2.543,12s4.478,10,1