      "content": "/**\n * Component: products, show, items\n * Author: @Sugam24-Services (https://tailwindflex.com/@Sugam24-Services)\n * Source: https://tailwindflex.com/@Sugam24-Services/products-show-items\n * Attribution: Créé par @Sugam24-Services sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function ProductsShowItems() {\n  return (\n    <div>\n    <div className=\"flex flex-col items-center space-y-4\">\n            <div className=\"w-full max-w-3xl\">\n                <img id=\"main-image\" src=\"https://raw.githubusercontent.com/prebuiltui/prebuiltui/main/assets/gallery/slide1.png\" className=\"w-full rounded-lg\" alt=\"Main Image\" />\n            </div>\n    \n            <div className=\"grid grid-cols-4 max-w-3xl gap-4\" id=\"thumbnail-container\">\n    \n                <img src=\"https://raw.githubusercontent.com/prebuiltui/prebuiltui/main/assets/gallery/slide1.png\" className=\"thumb rounded-lg md24 h-14 object-cover cursor-pointer hover80\" alt=\"Thumb 1\" \n                 />\n    \n                <img src=\"https://raw.githubusercontent.com/prebuiltui/prebuiltui/main/assets/gallery/slide2.png\" className=\"thumb rounded-lg md24 h-14 object-cover cursor-pointer hover80\" alt=\"Thumb 2\"\n                 />\n    \n                <img src=\"https://raw.githubusercontent.com/prebuiltui/prebuiltui/main/assets/gallery/slide3.png\" className=\"thumb rounded-lg md24 h-14 object-cover cursor-pointer hover80\" alt=\"Thumb 3\"\n                 />\n    \n                <img src=\"https://raw.githubusercontent.com/prebuiltui/prebuiltui/main/assets/gallery/slide4.png\" className=\"thumb rounded-lg md24 h-14 object-cover cursor-pointer hover80\" alt=\"Thumb 4\"\n                 />\n    \n            </div>\n        </div>\n    </div>\n  );\n}\n",
