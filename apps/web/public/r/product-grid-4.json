\"lazy\\\"\\n                        />\\n                        <div class=\\\"absolute inset-0 bg-gradient-to-t from-black/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500\\\"></div>\\n                    </div>\\n                    \\n                    <div class=\\\"space-y-4\\\">\\n                        <div class=\\\"flex items-start justify-between\\\">\\n                            <div>\\n                                <span class=\\\"text-gray-400 text-sm font-medium tracking-wider uppercase\\\">PREMIUM</span>\\n                                <h3 class=\\\"text-2xl font-light mt-2\\\">Urban Explorer</h3>\\n                            </div>\\n                            <div class=\\\"text-right\\\">\\n                                <span class=\\\"text-xl font-normal\\\">$49</span>\\n                                <div class=\\\"flex items-center space-x-1 mt-2 justify-end\\\">\\n                                    <i data-lucide=\\\"star\\\" class=\\\"w-4 h-4 fill-white text-white\\\"></i>\\n                                    <i data-lucide=\\\"star\\\" class=\\\"w-4 h-4 fill-white text-white\\\"></i>\\n                                    <i data-lucide=\\\"star\\\" class=\\\"w-4 h-4 fill-white text-white\\\"></i>\\n                                    <i data-lucide=\\\"star\\\" class=\\\"w-4 h-4 fill-white text-white\\\"></i>\\n                                    <i data-lucide=\\\"star\\\" class=\\\"w-4 h-4 fill-white text-white\\\"></i>\\n                                </div>\\n                            </div>\\n                        </div>\\n                        \\n                        <button class=\\\"w-full bg-white/10 hover:bg-white/20 border border-white/20 rounded-xl py-4 px-6 text-white font-medium transition-all duration-300 flex items-center justify-center space-x-3 group/btn\\\">\\n                            <span>Add to Cart</span>\\n                            <i data-lucide=\\\"ar