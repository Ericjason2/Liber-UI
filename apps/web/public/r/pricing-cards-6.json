ow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl md:col-span-2 lg:col-span-1\">\n      <div>\n        <div class=\"flex items-center justify-between\">\n          <h3 class=\"text-lg font-bold text-slate-900\">Enterprise</h3>\n          <span class=\"rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-700\">Advanced</span>\n        </div>\n        <p class=\"mt-2 text-sm leading-6 text-slate-500\">Complete flexibility for larger businesses.</p>\n        <div class=\"mt-7 flex items-baseline gap-1\">\n          <span class=\"text-2xl font-semibold text-slate-900\">$</span>\n          <span data-price data-price-monthly=\"99\" data-price-yearly=\"79\" class=\"text-5xl font-bold tracking-tight text-slate-900\">99</span>\n          <span class=\"text-sm text-slate-400\">/month</span>\n        </div>\n        <p data-billing-copy data-billing-monthly=\"Billed monthly\" data-billing-yearly=\"$948 billed annually\" class=\"mt-2 text-xs text-slate-400\">Billed monthly</p>\n      </div>\n      <a href=\"#enterprise\" class=\"mt-8 flex w-full items-center justify-center rounded-xl border border-slate-200 px-5 py-3.5 text-sm font-semibold text-slate-700 transition hover:border-indigo-600 hover:text-indigo-600\">Contact Sales</a>\n      <div class=\"my-7 border-t border-slate-100\"></div>\n      <p class=\"text-xs font-bold uppercase tracking-wider text-slate-400\">Everything in Professional, plus</p>\n      <ul class=\"mt-5 space-y-4 text-sm text-slate-600\">\n        <li class=\"flex items-center gap-3\"><span class=\"text-emerald-500\">✓</span> Unlimited team members</li>\n        <li class=\"flex items-center gap-3\"><span class=\"text-emerald-500\">✓</span> Unlimited storage</li>\n        <li class=\"flex items-center gap-3\"><span class=\"text-emerald-500\">✓</span> Advanced security</li>\n        <li class=\"flex items-center gap-3\"><span class=\"text-emerald-500\">✓</span> Dedicated account manager</li>\n        <li class=\"flex items-center gap-3\"><span class=\"text-emerald-500\">✓</span> Custom integrations</li>\n      </ul>\n    </article>\n  </div>\n\n  <p class=\"mt-8 text-center text-xs text-slate-400\">All plans include secure access and regular product updates.</p>\n</section>\n\n<script>\n  document.querySelectorAll(\"[data-pricing-component]\").forEach(component=>{\n  const toggle=component.querySelector(\"[data-billing-toggle]\");\n  const prices=component.querySelectorAll(\"[data-price]\");\n  const billingCopies=component.querySelectorAll(\"[data-billing-copy]\");\n  let yearly=false;\n  function updatePricing(){\n    component.classList.toggle(\"is-yearly\",yearly);\n    toggle.setAttribute(\"aria-pressed\",String(yearly));\n    toggle.setAttribute(\"aria-label\",yearly?\"Switch to monthly billing\":\"Switch to yearly billing\");\n    prices.forEach(price=>{\n      price.textContent=yearly?price.dataset.priceYearly:price.dataset.priceMonthly;\n    });\n    billingCopies.forEach(copy=>{\n      copy.textContent=yearly?copy.dataset.billingYearly:copy.dataset.billingMonthly;\n    });\n  }\n  toggle.addEventListener(\"click\",()=>{\n    yearly=!yearly;\n    updatePricing();\n  });\n  updatePricing();\n});\n</script>"
