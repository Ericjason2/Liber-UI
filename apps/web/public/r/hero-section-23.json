    "rawHtml": "<section class=\"px-6 py-20 md:py-32 bg-white dark:bg-gray-900\">\n    <div class=\"max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between space-y-10 md:space-y-0\">\n      \n      <!-- Text Content -->\n      <div class=\"md:w-1/2\">\n        <h1 class=\"text-4xl md:text-6xl font-bold mb-6 leading-tight\">\n          Step Into Style <br class=\"hidden md:block\" />\n          with <span class=\"text-orange-500\">Classic Sneakers</span>\n        </h1>\n        <p class=\"text-lg mb-8 text-gray-600 dark:text-gray-300\">\n          Discover comfort, quality, and elegance in every step. Perfect for every occasion.\n        </p>\n        <a href=\"#\" class=\"bg-orange-500 hover:bg-orange-600 text-white font-semibold px-6 py-3 rounded-lg transition duration-200\">\n          Shop Now\n        </a>\n      </div>\n\n      <!-- Hero Image -->\n      <div class=\"md:w-1/2\">\n        <img src=\"https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSzJOBc888horStIw5v_cpA6OOGG39NMeDgEg&s\" alt=\"Hero Image\" class=\"rounded-lg shadow-lg w-full\" />\n      </div>\n    </div>\n  </section>"
