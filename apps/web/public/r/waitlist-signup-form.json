    "rawHtml": "<div class=\"flex flex-col\" id=\"waitlist\">\n  <div class=\"text-4xl font-semibold max-w-xl text-center px-4\">\n    <span>Unlock <span class=\"text-green-500\">innovation</span> and <span class=\"text-blue-500\">progress</span> with\n    <span class=\"text-yellow-500\">small teams</span> for\n    <span class=\"text-purple-500\">exceptional outcomes</span>.</span>\n  </div>\n  <div>\n    <div class=\"flex justify-center\">\n      <div class=\"flex mt-6 flex-col md:flex-row\">\n        <div class=\"sm:col-span-4 mt-4\">\n          <div class=\"flex rounded-xl shadow-sm ring-1 ring-inset ring-gray-300 focus:none sm:max-w-md mr-2\">\n            <input type=\"email\" name=\"email\" id=\"email\" autocomplete=\"email\" value=\"\" class=\"w-72 h-14 rounded-xl block flex-1 bg-transparent py-4 pl-4 text-gray-900 placeholder:text-gray-400 focus:none sm:text-md sm:leading-6 text-lg\" placeholder=\"Enter your e-mail\">\n          </div>\n        </div>\n        <button class=\"mx-auto bg-blue-700 text-white px-6 py-2 rounded-xl shadow border font-medium mt-4 text-xl hover:brightness-90\"> Get Early Access </button>\n      </div>\n    </div>\n  </div>\n</div>"
