      "content": "/**\n * Component: Waitlist signup form\n * Author: @anonymous (https://tailwindflex.com/@anonymous)\n * Source: https://tailwindflex.com/@anonymous/waitlist-signup-form\n * Attribution: Créé par @anonymous sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function WaitlistSignupForm() {\n  return (\n    <div>\n    <div className=\"flex flex-col\" id=\"waitlist\">\n      <div className=\"text-4xl font-semibold max-w-xl text-center px-4\">\n        <span>Unlock <span className=\"text-green-500\">innovation</span> and <span className=\"text-blue-500\">progress</span> with\n        <span className=\"text-yellow-500\">small teams</span> for\n        <span className=\"text-purple-500\">exceptional outcomes</span>.</span>\n      </div>\n      <div>\n        <div className=\"flex justify-center\">\n          <div className=\"flex mt-6 flex-col md\">\n            <div className=\"sm4 mt-4\">\n              <div className=\"flex rounded-xl shadow-sm ring-1 ring-inset ring-gray-300 focus sm mr-2\">\n                <input type=\"email\" name=\"email\" id=\"email\" autoComplete=\"email\" value=\"\" className=\"w-72 h-14 rounded-xl block flex-1 bg-transparent py-4 pl-4 text-gray-900 placeholder400 focus sm sm6 text-lg\" placeholder=\"Enter your e-mail\" />\n              </div>\n            </div>\n            <button className=\"mx-auto bg-blue-700 text-white px-6 py-2 rounded-xl shadow border font-medium mt-4 text-xl hover90\"> Get Early Access </button>\n          </div>\n        </div>\n      </div>\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
