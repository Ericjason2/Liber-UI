d-cols-2 md:grid-cols-3 gap-8\">\n      <div class=\"bg-white rounded shadow hover:shadow-lg transition\">\n        <img src=\"https://images.unsplash.com/photo-1626379616459-b2ce1d9decbc?q=80&w=1974&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D\" alt=\"Nike Air Force 1\" class=\"w-full h-64 object-cover rounded-t\" />\n        <div class=\"p-4\">\n          <h4 class=\"font-semibold text-lg\">Nike Air Force 1</h4>\n          <p class=\"text-gray-500 text-sm\">Men's Shoe</p>\n          <p class=\"mt-2 font-bold\">$90</p>\n        </div>\n      </div>\n      <div class=\"bg-white rounded shadow hover:shadow-lg transition\">\n        <img src=\"https://images.unsplash.com/photo-1640016713197-76fe85053279?q=80&w=1974&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D\" alt=\"Nike Air Max 90\" class=\"w-full h-64 object-cover rounded-t\" />\n        <div class=\"p-4\">\n          <h4 class=\"font-semibold text-lg\">Nike Air Max 90</h4>\n          <p class=\"text-gray-500 text-sm\">Men's Shoe</p>\n          <p class=\"mt-2 font-bold\">$120</p>\n        </div>\n      </div>\n      <div class=\"bg-white rounded shadow hover:shadow-lg transition\">\n        <img src=\"https://images.unsplash.com/photo-1713649931645-acc95f0bc6c9?q=80&w=1989&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D\" alt=\"Nike Pegasus 37\" class=\"w-full h-64 object-cover rounded-t\" />\n        <div class=\"p-4\">\n          <h4 class=\"font-semibold text-lg\">Nike Pegasus 37</h4>\n          <p class=\"text-gray-500 text-sm\">Men's Running Shoe</p>\n          <p class=\"mt-2 font-bold\">$130</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Footer -->\n  <footer class=\"bg-gray-100 py-8\">\n    <div class=\"max-w-7xl mx-auto px-4 flex flex-col md:flex-row justify-between text-sm text-gray-600\">\n      <div class=\"mb-4 md:mb-0\">\n        <h5 cl