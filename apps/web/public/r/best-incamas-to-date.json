w-7xl mx-auto px-4 py-16\">\n          <h3 className=\"text-2xl font-bold mb-8\">Featured Products</h3>\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8\">\n            <div className=\"bg-white rounded shadow hover:shadow-lg transition\">\n              <img src=\"https://images.unsplash.com/photo-1626379616459-b2ce1d9decbc?q=80&w=1974&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D\" alt=\"Nike Air Force 1\" className=\"w-full h-64 object-cover rounded-t\" />\n              <div className=\"p-4\">\n                <h4 className=\"font-semibold text-lg\">Nike Air Force 1</h4>\n                <p className=\"text-gray-500 text-sm\">Men's Shoe</p>\n                <p className=\"mt-2 font-bold\">$90</p>\n              </div>\n            </div>\n            <div className=\"bg-white rounded shadow hover:shadow-lg transition\">\n              <img src=\"https://images.unsplash.com/photo-1640016713197-76fe85053279?q=80&w=1974&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D\" alt=\"Nike Air Max 90\" className=\"w-full h-64 object-cover rounded-t\" />\n              <div className=\"p-4\">\n                <h4 className=\"font-semibold text-lg\">Nike Air Max 90</h4>\n                <p className=\"text-gray-500 text-sm\">Men's Shoe</p>\n                <p className=\"mt-2 font-bold\">$120</p>\n              </div>\n            </div>\n            <div className=\"bg-white rounded shadow hover:shadow-lg transition\">\n              <img src=\"https://images.unsplash.com/photo-1713649931645-acc95f0bc6c9?q=80&w=1989&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D\" alt=\"Nike Pegasus 37\" className=\"w-full h-64 object-cover rounded-t\" />\n              <div className=\"p-4\">\n                <h4 className=\"font-semibold text-lg\">Nike Pegasus 37</h4>\n                <p className=\"text-gray-500 text-sm\">Men's Running Shoe</p>\n                <p className=\"mt-2 font-bold\">$130</p>\n              </div>\n            </div>\n          </div>\n        </section>\n      \n        \n        <footer className=\"bg-gray-100 py-8\">\n          <div className=\"max-w-7xl mx-auto px-4 flex flex-col md:flex-row justify-between text-sm text-gray-600\">\n            <div className=\"mb-4 md:mb-0\">\n              <h5 className=\"font-bold mb-2\">Help</h5>\n              <ul className=\"space-y-1\">\n                <li><a href=\"#\" className=\"hover:text-gray-800\">Order Status</a></li>\n                <li><a href=\"#\" className=\"hover:text-gray-800\">Shipping & Delivery</a></li>\n                <li><a href=\"#\" className=\"hover:text-gray-800\">Returns</a></li>\n                <li><a href=\"#\" className=\"hover:text-gray-800\">Contact Us</a></li>\n              </ul>\n            </div>\n            <div className=\"mb-4 md:mb-0\">\n              <h5 className=\"font-bold mb-2\">About Nike</h5>\n              <ul className=\"space-y-1\">\n                <li><a href=\"#\" className=\"hover:text-gray-800\">News</a></li>\n                <li><a href=\"#\" className=\"hover:text-gray-800\">Careers</a></li>\n                <li><a href=\"#\" className=\"hover:text-gray-800\">Investors</a></li>\n                <li><a href=\"#\" className=\"hover:text-gray-800\">Sustainability</a></li>\n              </ul>\n            </div>\n            <div>\n              <h5 className=\"font-bold mb-2\">Follow Us</h5>\n              <ul className=\"space-y-1\">\n                <li><a href=\"#\" className=\"hover:text-gray-800\">Instagram</a></li>\n                <li><a href=\"#\" className=\"hover:text-gray-800\">Twitter</a></li>\n                <li><a href=\"#\" className=\"hover:text-gray-800\">Facebook</a></li>\n                <li><a href=\"#\" className=\"hover:text-gray-800\">YouTube</a></li>\n              </ul>\n            </div>\n          </div>\n          <div class