-blue-100 transition transform hover:translate-y-[-2px] hover:shadow-md\">\n                    <i class=\"fas fa-check mr-2\"></i> Primary\n                </button>\n                <button class=\"inline-flex items-center justify-center text-green-500 px-4 py-2 rounded hover:bg-green-100 transition transform hover:translate-y-[-2px] hover:shadow-md\">\n                    <i class=\"fas fa-plus mr-2\"></i> Success\n                </button>\n                <button class=\"inline-flex items-center justify-center text-red-500 px-4 py-2 rounded hover:bg-red-100 transition transform hover:translate-y-[-2px] hover:shadow-md\">\n                    <i class=\"fas fa-times mr-2\"></i> Danger\n                </button>\n                <button class=\"inline-flex items-center justify-center text-yellow-500 px-4 py-2 rounded hover:bg-yellow-100 transition transform hover:translate-y-[-2px] hover:shadow-md\">\n                    <i class=\"fas fa-exclamation-triangle mr-2\"></i> Warning\n                </button>\n                <button class=\"inline-flex items-center justify-center text-gray-500 px-4 py-2 rounded hover:bg-gray-100 transition transform hover:translate-y-[-2px] hover:shadow-md\">\n                    <i class=\"fas fa-info mr-2\"></i> Info\n                </button>\n            </div>\n        </div>\n\n    </div>"
