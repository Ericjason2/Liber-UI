      "content": "/**\n * Component: beautiful buttons set\n * Author: @akram6t (https://tailwindflex.com/@akram6t)\n * Source: https://tailwindflex.com/@akram6t/beautiful-buttons-set\n * Attribution: Créé par @akram6t sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function BeautifulButtonsSet() {\n  return (\n    <div>\n    <div className=\"max-w-md mx-auto bg-white p-6 rounded-lg shadow-lg\">\n            <h1 className=\"text-3xl font-bold mb-6 text-center text-gray-800\">Beautiful Buttons</h1>\n    \n            \n            <div className=\"mb-8\">\n                <h2 className=\"text-xl font-semibold mb-4\">Solid Buttons</h2>\n                <div className=\"flex flex-wrap gap-4\">\n                    <button className=\"inline-flex items-center justify-center bg-blue-500 text-white px-4 py-2 rounded hover600 transition transform hover[-2px] hover\">\n                        <i className=\"fas fa-check mr-2\"></i> Primary\n                    </button>\n                    <button className=\"inline-flex items-center justify-center bg-green-500 text-white px-4 py-2 rounded hover600 transition transform hover[-2px] hover\">\n                        <i className=\"fas fa-plus mr-2\"></i> Success\n                    </button>\n                    <button className=\"inline-flex items-center justify-center bg-red-500 text-white px-4 py-2 rounded hover600 transition transform hover[-2px] hover\">\n                        <i className=\"fas fa-times mr-2\"></i> Danger\n                    </button>\n                    <button className=\"inline-flex items-center justify-center bg-yellow-500 text-white px-4 py-2 rounded hover600 transition transform hover[-2px] hover\">\n                        <i className=\"fas fa-exclamation-triangle mr-2\"></i> Warning\n                    </button>\n                    <button className=\"inline-flex items-center justify-center bg-gray-500 text-white px-4 py-2 rounded hover600 transition transform hover[-2px] hover\">\n                        <i className=\"fas fa-info mr-2\"></i> Info\n                    </button>\n                </div>\n            </div>\n    \n            \n            <div className=\"mb-8\">\n                <h2 className=\"text-xl font-semibold mb-4\">Outline Buttons</h2>\n                <div className=\"flex flex-wrap gap-4\">\n                    <button className=\"inline-flex items-center justify-center border border-blue-500 text-blue-500 px-4 py-2 rounded hover500 hover transition transform hover[-2px] hover\">\n                        <i className=\"fas fa-check mr-2\"></i> Primary\n                    </button>\n                    <button className=\"inline-flex items-center justify-center border border-green-500 text-green-500 px-4 py-2 rounded hover500 hover transition transform hover[-2px] hover\">\n                        <i className=\"fas fa-plus mr-2\"></i> Success\n                    </button>\n                    <button className=\"inline-flex items-center justify-center border border-red-500 text-red-500 px-4 py-2 rounded hover500 hover transition transform hover[-2px] hover\">\n                        <i className=\"fas fa-times mr-2\"></i> Danger\n                    </button>\n                    <button className=\"inline-flex items-center justify-center border border-yellow-500 text-yellow-500 px-4 py-2 rounded hover500 hover transition transform hover[-2px] hover\">\n                        <i className=\"fas fa-exclamation-triangle mr-2\"></i> Warning\n                    </button>\n                    <button className=\"inline-flex items-center justify-center border border-gray-500 text-gray-500 px-4 py-2 rounded hover500 hover transition transform hover[-2px] hover\">\n                        <i className=\"fas fa-info mr-2\"></i> Info\n                    </button>\n                </div>\n            </div>\n    \n            \n            <div className=\"mb-8\">\n                <h2 className=\"text-xl font-semibold mb-4\">Text Buttons</h2>\n                <div className=\"flex flex-wrap gap-4\">\n                    <button className=\"inline-flex items-center justify-center text-blue-500 px-4 py-2 rounded hover100 transition transform hover[-2px] hover\">\n                        <i className=\"fas fa-check mr-2\"></i> Primary\n                    </button>\n                    <button className=\"inline-flex items-center justify-center text-green-500 px-4 py-2 rounded hover100 transition transform hover[-2px] hover\">\n                        <i className=\"fas fa-plus mr-2\"></i> Success\n                    </button>\n                    <button className=\"inline-flex items-center justify-center text-red-500 px-4 py-2 rounded hover100 transition transform hover[-2px] hover\">\n                        <i className=\"fas fa-times mr-2\"></i> Danger\n                    </button>\n                    <button className=\"inline-flex items-center justify-center text-yellow-500 px-4 py-2 rounded hover100 transition transform hover[-2px] hover\">\n                        <i className=\"fas fa-exclamation-triangle mr-2\"></i> Warning\n                    </button>\n                    <button className=\"inline-flex items-center justify-center text-gray-500 px-4 py-2 rounded hover100 transition transform hover[-2px] hover\">\n                        <i className=\"fas fa-info mr-2\"></i> Info\n                    </button>\n                </div>\n            </div>\n    \n        </div>\n    </div>\n  );\n}\n",
