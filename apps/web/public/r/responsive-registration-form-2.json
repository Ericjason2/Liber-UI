ssword\" placeholder=\"Password\" />\n                            <button\n                                className=\"mt-5 tracking-wide font-semibold bg-green-400 text-white-500 w-full py-4 rounded-lg hover700 transition-all duration-300 ease-in-out flex items-center justify-center focus focus\">\n                                <svg className=\"w-6 h-6 -ml-2\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"\n                                    strokeLinecap=\"round\" strokeLinejoin=\"round\">\n                                    <path d=\"M16 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2\" />\n                                    <circle cx=\"8.5\" cy=\"7\" r=\"4\" />\n                                    <path d=\"M20 8v6M23 11h-6\" />\n                                </svg>\n                                <span className=\"ml-\">\n                                    Sign In\n                                </span>\n                            </button>\n                            <p className=\"mt-6 text-xs text-gray-600 text-center\">\n                                I agree to abide by Cartesian Kinetics\n                                <a href=\"#\" className=\"border-b border-gray-500 border-dotted\">\n                                    Terms of Service\n                                </a>\n                                and its\n                                <a href=\"#\" className=\"border-b border-gray-500 border-dotted\">\n                                    Privacy Policy\n                                </a>\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div className=\"flex-1 bg-green-100 text-center hidden lg\">\n                <div className=\"m-12 xl16 w-full bg-contain bg-center bg-no-repeat\"\n                    style=\"background-image: url('https://drive.google.com/uc?export=view&id=1KZ_Ub_2lZ0dHbKV0fAIhxVhiQA183RCz');\">\n            