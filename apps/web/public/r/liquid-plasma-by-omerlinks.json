    "rawHtml": "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Fond Liquide Plasma 3D</title>\n    \n    <!-- Tailwind CSS pour l'UI -->\n    <!-- <script src=\"https://cdn.tailwindcss.com\"></script> -->\n    \n    <!-- Three.js -->\n\n     <script src=\"https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js\"></script>\n\n    <style>\n        body, html {\n            margin: 0;\n            padding: 0;\n            width: 100%;\n            height: 100%;\n            overflow: hidden;\n            background-color: #0f172a; /* Fond sombre de base */\n            font-family: 'Inter', sans-serif;\n        }\n\n        #canvas-container {\n            position: fixed;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            z-index: 0;\n        }\n\n        /* Overlay pour le texte */\n        .ui-overlay {\n            position: relative;\n            z-index: 10;\n            pointer-events: none; /* Laisse passer la souris vers le 3D */\n            height: 100%;\n            display: flex;\n            flex-direction: column;\n            justify-content: center;\n            align-items: center;\n        }\n\n        /* Réactive les clics sur les boutons */\n        .ui-overlay button, .ui-overlay a {\n            pointer-events: auto;\n        }\n    </style>\n     -->\n</head>\n<body>\n\n    <!-- Conteneur 3D -->\n    <div id=\"canvas-container\"></div>\n\n    <!-- UI Moderne par-dessus -->\n    <div class=\"ui-overlay px-4\">\n        <div class=\"max-w-3xl w-full text-center\">\n            <span class=\"inline-block py-1 px-3 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-cyan-300 text-sm font-semibold tracking-wider mb-4 animate-pulse\">\n                EXPÉRIENCE IMMERSIVE\n            </span>\n            <h1 class=\"text-6xl md:text-8xl font-black text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-purple-400 to-pink-400 drop-shadow-2xl mb-6\">\n                LIQUID<br>PLASMA\n            </h1>\n            <p class=\"text-xl md:text-2xl text-gray-200 font-light mb-10 max-w-2xl mx-auto leading-relaxed drop-shadow-md\">\n                Explorez un univers fluide. Déplacez votre souris pour interagir avec la vague numérique.\n            </p>\n            \n            <div class=\"flex flex-col sm:flex-row gap-4 justify-center\">\n                <button class=\"px-8 py-4 rounded-full bg-gradient-to-r from-purple-600 to-pink-600 text-white font-bold text-lg hover:shadow-[0_0_30px_rgba(236,72,153,0.6)] transition-all transform hover:-translate-y-1\">\n                    Commencer\n                </button>\n                <button class=\"px-8 py-4 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-white font-bold text-lg hover:bg-white/20 transition-all\">\n                    En savoir plus\n                </button>\n            </div>\n        </div>\n    </div>\n\n    <script>\n        // --- 1. CONFIGURATION DE LA SCÈNE ---\n        const container = document.getElementById('canvas-container');\n        \n        const scene = new THREE.Scene();\n        // Ajout d'un brouillard pour fondre l'horizon dans la couleur de fond\n        scene.fog = new THREE.FogExp2(0x0f172a, 0.035);\n\n        const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);\n        // Positionner la caméra en hauteur et penchée\n        camera.position.set(0, -15, 12); \n        camera.lookAt(0, 0, 0);\n\n        const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });\n        renderer.setSize(window.innerWidth, window.innerHeight);\n        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));\n        container.appendChild(renderer.domElement);\n\n        // --- 2. CRÉATION DE LA GÉOMÉTRIE (LA NAPPE D'EAU) ---\n        \n        // On crée un plan avec beaucoup de segments pour avoir une forme fluide\n        // Largeur, Hauteur, Segments X, Segments Y\n        const geometry = new THREE.PlaneGeometry(40, 40, 64, 64);\n\n        // Activer les couleurs par sommet (Vertex Colors) pour l'effet Plasma\n        const count = geometry.attributes.position.count;\n        geometry.setAttribute('color', new THREE.BufferAttribute(new Float32Array(count * 3), 3));\n\n        // --- 3. MATÉRIAU LIQUIDE ---\n        \n        const material = new THREE.MeshPhysicalMaterial({\n            color: 0xffffff,        // Couleur de base blanche (car on utilise les vertex colors)\n            metalness: 0.1,         // Peu métallique\n            roughness: 0.2,         // Assez lisse\n            reflectivity: 0.5,      // Un peu de réflexion\n            clearcoat: 0.8,         // Effet verni / mouillé\n            clearcoatRoughness: 0.1,\n            flatShading: false,     // Lissage pour effet liquide (true = low poly)\n            side: THREE.DoubleSide,\n            vertexColors: true      // IMPORTANT : active les couleurs calculées sommet par sommet\n        });\n\n        const plane = new THREE.Mesh(geometry, material);\n        scene.add(plane);\n\n        // --- 4. LUMIÈRES ---\n        \n        const ambientLight = new THREE.AmbientLight(0xffffff, 0.4);\n        scene.add(ambientLight);\n\n        // Lumières colorées pour accentuer l'effet fluo\n        const light1 = new THREE.PointLight(0x00ffff, 1, 50); // Cyan\n        light1.position.set(10, 10, 10);\n        scene.add(light1);\n\n        const light2 = new THREE.PointLight(0xff00ff, 1, 50); // Magenta\n        light2.position.set(-10, -10, 5);\n        scene.add(light2);\n\n        // --- 5. ANIMATION ET PHYSIQUE ---\n\n        // Variables pour l'interaction souris\n        let mouseX = 0;\n        let mouseY = 0;\n        let targetRotationX = 0;\n        let targetRotationY = 0;\n\n        document.addEventListener('mousemove', (event) => {\n            // Normaliser les coordonnées de la souris (-1 à 1)\n            mouseX = (event.clientX / window.innerWidth) * 2 - 1;\n            mouseY = -(event.clientY / window.innerHeight) * 2 + 1;\n        });\n\n        const clock = new THREE.Clock();\n        \n        // Stockage des positions originales pour le calcul des vagues\n        const originalPositions = geometry.attributes.position.array.slice();\n\n        function animate() {\n            requestAnimationFrame(animate);\n\n            const time = clock.getElapsedTime();\n\n            // 1. ANIMATION DES VAGUES (Vertex Displacement)\n            const positions = geometry.attributes.position.array;\n            const colors = geometry.attributes.color.array;\n\n            // Définition des couleurs de l'arc-en-ciel fluo\n            const color1 = new THREE.Color(0x06b6d4); // Cyan (Bas)\n            const color2 = new THREE.Color(0x8b5cf6); // Violet (Milieu)\n            const color3 = new THREE.Color(0xec4899); // Rose (Haut)\n\n            for (let i = 0; i < count; i++) {\n                // Récupérer la position originale (x, y, 0)\n                const px = originalPositions[i * 3];\n                const py = originalPositions[i * 3 + 1];\n\n                // CALCUL DE LA HAUTEUR (Z)\n                // Combinaison de plusieurs ondes sinus pour un effet \"aléatoire\" naturel\n                // Plus on s'éloigne du centre, plus les vagues sont calmes (facteur * distance)\n                const distance = Math.sqrt(px*px + py*py);\n                \n                const wave1 = Math.sin(px * 0.3 + time * 1.5);\n                const wave2 = Math.cos(py * 0.4 + time * 1.2);\n                const wave3 = Math.sin(distance * 0.5 - time); // Onde radiale\n\n                // Amplitude de la vague\n                const z = (wave1 + wave2 + wave3) * 1.5;\n\n                // Appliquer la nouvelle hauteur\n                positions[i * 3 + 2] = z;\n\n                // 2. CALCUL DE LA COULEUR (EFFET PLASMA)\n                // La couleur dépend de la hauteur (z)\n                const mixedColor = new THREE.Color();\n                \n                // Si z est bas -> Cyan, Moyen -> Violet, Haut -> Rose\n                if (z < -1) {\n                    mixedColor.copy(color1);\n                } else if (z > 1) {\n                    mixedColor.copy(color3);\n                } else {\n                    // Interpolation entre violet et les extrêmes\n                    mixedColor.lerpColors(color1, color2, (z + 1) / 2);\n                    mixedColor.lerpColors(mixedColor, color3, Math.max(0, z - 0.5));\n                }\n\n                colors[i * 3] = mixedColor.r;\n                colors[i * 3 + 1] = mixedColor.g;\n                colors[i * 3 + 2] = mixedColor.b;\n            }\n\n            // Nécessaire pour dire à Three.js de mettre à jour la géométrie\n            geometry.attributes.position.needsUpdate = true;\n            geometry.attributes.color.needsUpdate = true;\n            geometry.computeVertexNormals(); // Recalculer les ombres/lumières pour le brillant\n\n            // 3. INTERACTION SOURIS (INCLINAISON DU PLAN)\n            // On lisse le mouvement avec une interpolation (Lerp)\n            targetRotationX = mouseY * 0.5; // Inclinaison haut/bas\n            targetRotationY = mouseX * 0.5; // Inclinaison gauche/droite\n\n            plane.rotation.x += 0.05 * (targetRotationX - plane.rotation.x);\n            plane.rotation.y += 0.05 * (targetRotationY - plane.rotation.y);\n\n            // Légère rotation automatique constante\n            plane.rotation.z = time * 0.05;\n\n            renderer.render(scene, camera);\n        }\n\n        // --- 6. GESTION DU REDIMENSIONNEMENT ---\n        window.addEventListener('resize', () => {\n            camera.aspect = window.innerWidth / window.innerHeight;\n            camera.updateProjectionMatrix();\n            renderer.setSize(window.innerWidth, window.innerHeight);\n        });\n\n        animate();\n    </script>\n</body>\n</html>"
  }
