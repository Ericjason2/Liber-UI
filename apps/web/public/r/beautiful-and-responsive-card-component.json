    "rawHtml": "<body class=\"bg-gray-100 py-12 px-8\">\n\n  <!--Card -->\n  <div class=\"max-w-sm mx-auto bg-white rounded-2xl shadow-2xl overflow-hidden transform transition-all \">\n\n    <!-- Card Image Section  -->\n    <div class=\"relative\">\n      <!-- Image URL -->\n      <div class=\"card-image h-72 bg-cover bg-center\"\n        style=\"background-image: url('https://images.unsplash.com/photo-1494438639946-1ebd1d20bf85?q=80&w=2067&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D');\">\n        <!-- Gradient Overlay for better text visibility -->\n        <div class=\"absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent opacity-50\"></div>\n        <div class=\"absolute inset-0 p-6 flex flex-col justify-end\">\n          <h2 class=\"text-3xl font-bold text-white leading-tight\">Innovating Tomorrow</h2>\n          <p class=\"text-lg text-white opacity-80\">Shaping the future of technology with creativity.</p>\n        </div>\n      </div>\n    </div>\n\n    <!-- Card Body Section -->\n    <div class=\"p-6 bg-white space-y-4\">\n      <h3 class=\"text-2xl font-semibold text-gray-800\">Design Beyond Imagination</h3>\n      <p class=\"text-gray-600 text-sm leading-relaxed\">\n        Our design philosophy revolves around simplicity and functionality. By blending creativity with cutting-edge\n        technology, we bring ideas to life that leave a lasting impact. Explore the future of design with us.\n      </p>\n\n      <!-- CTA Button -->\n      <div class=\"flex justify-between items-center\">\n        <button class=\"bg-green-800 text-white py-2 px-6 rounded-full text-sm font-medium shadow-md hover:bg-green-900 hover:shadow-xl transition-all transform flex items-center\">\n          Learn More\n        </button>\n        <span class=\"text-sm text-gray-500\">Last updated: 2 mins ago</span>\n      </div>\n    </div>\n  </div>\n\n</body>"
  }
