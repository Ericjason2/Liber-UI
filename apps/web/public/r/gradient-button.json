      "content": "/**\n * Component: Gradient Button\n * Author: @tofayel-islam (https://tailwindflex.com/@tofayel-islam)\n * Source: https://tailwindflex.com/@tofayel-islam/gradient-button\n * Attribution: Créé par @tofayel-islam sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function GradientButton() {\n  return (\n    <div>\n    <div className=\"h-screen flex justify-center items-center dark800\">\n        <div className=\"flex gap-2 flex-wrap justify-center p-4 md12 max-w-3xl\">\n            <button type=\"button\" className=\"text-white bg-gradient-to-br from-purple-600 to-blue-500 hover focus4 focus focus300 dark800 font-medium rounded-lg text-sm px-5 py-2.5 text-center me-2 mb-2\">Purple to Blue</button>\n            <button type=\"button\" className=\"text-white bg-gradient-to-r from-cyan-500 to-blue-500 hover focus4 focus focus300 dark800 font-medium rounded-lg text-sm px-5 py-2.5 text-center me-2 mb-2\">Cyan to Blue</button>\n            <button type=\"button\" className=\"text-white bg-gradient-to-br from-green-400 to-blue-600 hover focus4 focus focus200 dark800 font-medium rounded-lg text-sm px-5 py-2.5 text-center me-2 mb-2\">Green to Blue</button>\n            <button type=\"button\" className=\"text-white bg-gradient-to-r from-purple-500 to-pink-500 hover focus4 focus focus200 dark800 font-medium rounded-lg text-sm px-5 py-2.5 text-center me-2 mb-2\">Purple to Pink</button>\n            <button type=\"button\" className=\"text-white bg-gradient-to-br from-pink-500 to-orange-400 hover focus4 focus focus200 dark800 font-medium rounded-lg text-sm px-5 py-2.5 text-center me-2 mb-2\">Pink to Orange</button>\n            <button type=\"button\" className=\"text-gray-900 bg-gradient-to-r from-teal-200 to-lime-200 hover hover200 hover200 focus4 focus focus200 dark700 font-medium rounded-lg text-sm px-5 py-2.5 text-center me-2 mb-2\">Teal to Lime</button>\n            <button type=\"button\" className=\"text-gray-900 bg-gradient-to-r from-red-200 via-red-300 to-yellow-200 hover focus4 focus focus100 dark400 font-medium rounded-lg text-sm px-5 py-2.5 text-center me-2 mb-2\">Red to Yellow</button>\n        </div>\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
  ],
