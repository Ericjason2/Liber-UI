 class=\"md:w-1/2\"><img src=\"https://images.unsplash.com/photo-1533105079780-92b9be482077?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=crop&w=334&q=80\" alt=\"Travel\" class=\"w-full rounded shadow-2xl h-auto max-h-full sm:max-h-screen md:max-h-full lg:max-h-screen xl:max-h-full\">\n        </div>\n    </div>\n    <!-- features -->\n    <div class=\"flex py-16 px-10 bg-blue-500 text-blue-200 text-center\">\n        <div class=\"mr-3 mb-4 text-center\">\n            <img src=\"https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=crop&w=1008&q=80\" alt=\"Travelling image\" class=\"w-full rounded border-solid border-2 border-blue-200\">\n            <p>Places!!</p>\n        </div>\n        <div class=\"mr-3 mb-4 text-center\">\n            <img src=\"https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=crop&w=1008&q=80\" alt=\"Travelling image\" class=\"w-full rounded border-solid border-2 border-blue-200\">\n            <p>Places!!</p>\n        </div>\n        <div class=\"mr-3 mb-4 text-center\">\n            <img src=\"https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=crop&w=1008&q=80\" alt=\"Travelling image\" class=\"w-full rounded border-solid border-2 border-blue-200\">\n            <p>Places!!</p>\n        </div>\n        <div class=\"mr-3 mb-4 text-center\">\n            <img src=\"https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=crop&w=1008&q=80\" alt=\"Travelling image\" class=\"w-full rounded border-solid border-2 border-blue-200\">\n            <p>Places!!</p>\n        </div>\n    </div>\n\n    <!-- footer+newsletter -->\n    <div class=\"p-10 bg-blue-900  text-blue-400 flex justify-between\">\n        <div class=\"md:w-1/2\">\n            <h3 class=\"text-lg mb-2\">Join the newsletter!</h3>\n            <form action=\"\" class=\"flex\">\n                <input type=\"email\" class=\"rounded w-full mr-2 py-3 px-4 outline-none focus:bg-blue-100\">\n                <button class=\"bg-red-400 rounded px-4 hover:bg-red-600\">Join</button>\n            </form>\n        </div>\n        <div class=\"flex items-center\">Copyright &copy; Geet 2020</div>\n    </div>\n</div>"
