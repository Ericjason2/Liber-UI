iv>\n        </div>\n      </a>\n    </div>\n\n    <div class=\"group relative\">\n\n      <a href=\"#\" class=\"absolute -top-24 left-1/2 -translate-x-1/2 w-[calc(100%-3rem)] z-10\"\n        aria-label=\"Leer artículo sobre Principios de Diseño UI\">\n        <img src=\"https://placehold.co/600x400/7C3AED/FFFFFF?text=Diseño\"\n                         alt=\"\"\n                         class=\"w-full h-48 object-cover rounded-2xl shadow-xl transition-all duration-300 ease-in-out group-hover:scale-105 group-hover:-translate-y-2\"/>\n      </a>\n\n      <a href=\"#\"\n        class=\"block bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 transition-shadow duration-300 shadow-md group-hover:shadow-2xl\">\n        <div class=\"p-6 pt-32 text-center\">\n          <span class=\"text-xs font-semibold uppercase text-purple-600 dark:text-purple-400 mb-2 block\">\n                            Diseño\n                        </span>\n\n          <h3\n            class=\"text-xl font-bold text-gray-900 dark:text-white mb-3 transition-colors duration-300 group-hover:text-purple-600 dark:group-hover:text-purple-400\">\n            Los 5 Principios del Diseño UI que No Puedes Ignorar\n          </h3>\n\n          <p class=\"text-gray-600 dark:text-gray-400 text-sm line-clamp-3 mb-4\">\n            Descubre los pilares fundamentales del diseño de interfaces que separan una app buena de una genial.\n          </p>\n\n          <div class=\"flex items-center justify-center space-x-2 mt-4\">\n            <img class=\"w-8 h-8 rounded-full object-cover\" src=\"https://placehold.co/40x40/E2E8F0/333333?text=M2\" alt=\"Avatar del autor\">\n            <div>\n              <p class=\"text-sm font-medium text-gray-800 dark:text-gray-200\">Marcos Reyes</p>\n              <p class=\"text-xs text-gray-500 dark:text-gray-400\">Hace 1 semana</p>\n            </div>\n          </div>\n        </div>\n      </a>\n    </div>\n\n    <div class=\"group relative\">\n\n 