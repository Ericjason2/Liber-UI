    "rawHtml": "<section class=\"relative py-12 lg:py-16 bg-white dark:bg-gray-950 transition-colors duration-300\">\n  <div class=\"mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8\">\n    <div class=\"flex flex-col items-center gap-12 lg:flex-row lg:gap-16\">\n      \n      <!-- Decorative background -->\n      <div class=\"absolute inset-0 -z-10\">\n        <span class=\"absolute left-0 top-20 h-24 w-24 rounded-3xl bg-green-400 opacity-50 blur-2xl dark:opacity-30\"></span>\n        <span class=\"absolute bottom-12 right-8 h-24 w-24 rounded-3xl bg-blue-600 opacity-70 blur-2xl dark:opacity-40\"></span>\n        <span class=\"absolute -top-10 left-1/3 aspect-square w-1/3 rounded-full bg-gradient-to-tr from-blue-600 to-green-400 opacity-30 blur-3xl lg:w-1/5 dark:opacity-20\"></span>\n      </div>\n\n      <!-- Text content -->\n      <div class=\"relative flex max-w-3xl flex-col items-center text-center lg:items-start lg:text-left\">\n        <h1 class=\"text-4xl font-bold leading-tight sm:text-5xl md:text-6xl xl:text-7xl text-gray-900 dark:text-gray-100\">\n          Lorem ipsum dolor\n          <span class=\"relative inline-block bg-gradient-to-br from-blue-500 via-purple-500 to-cyan-500 bg-clip-text text-transparent\">\n            sit amet\n            <span class=\"absolute -bottom-2 left-0 h-1 w-full rounded-full bg-gradient-to-r from-blue-500 via-purple-500 to-cyan-500\"></span>\n          </span>\n          consectetur.\n        </h1>\n        <p class=\"mt-6 text-lg text-gray-600 dark:text-gray-300 sm:text-xl\">\n          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.\n        </p>\n      </div>\n\n      <!-- Hero Image -->\n      <div class=\"relative flex-1 max-w-3xl lg:max-w-none group\">\n        <!-- Accent top-right -->\n        <div class=\"absolute -top-8 -right-8 h-16 w-16 rounded-2xl bg-gradient-to-br from-blue-500 to-purple-500 opacity-80 backdrop-blur-sm shadow-2xl shadow-blue-500/40 dark:opacity-60\"></div>\n\n        <img\n          src=\"https://images.unsplash.com/photo-1543269664-56d93c1b41a6?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w0NzEyNjZ8MHwxfHNlYXJjaHwxMXx8V29ya2luZ3xlbnwwfDB8fHwxNzU5MDc2MTUyfDA&ixlib=rb-4.1.0&q=80&w=1080\"\n          alt=\"Lorem ipsum dolor sit amet\"\n          width=\"600\"\n          height=\"533\"\n          loading=\"lazy\"\n          class=\"relative z-10 max-h-96 w-full rounded-3xl bg-slate-200 dark:bg-slate-800 object-cover lg:h-full lg:max-h-none\"\n        />\n\n        <!-- Hover overlay gradient -->\n        <div class=\"absolute inset-0 z-20 rounded-3xl bg-gradient-to-br from-blue-500/10 to-purple-500/10 opacity-0 transition-opacity duration-300 group-hover:opacity-100\"></div>\n\n        <!-- Accent bottom-left -->\n        <div class=\"absolute -bottom-6 -left-6 h-12 w-12 rounded-full bg-gradient-to-br from-emerald-500 to-teal-500 opacity-90 backdrop-blur-sm shadow-2xl shadow-emerald-500/40 dark:opacity-70\"></div>\n      </div>\n    </div>\n  </div>\n</section>"
