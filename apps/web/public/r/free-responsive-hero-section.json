      "content": "/**\n * Component: Responsive Hero Section\n * Author: @homayunmmdy (https://tailwindflex.com/@homayunmmdy)\n * Source: https://tailwindflex.com/@homayunmmdy/free-responsive-hero-section\n * Attribution: Créé par @homayunmmdy sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function FreeResponsiveHeroSection() {\n  return (\n    <div>\n    <section className=\"relative py-12 lg16 bg-white dark950 transition-colors duration-300\">\n      <div className=\"mx-auto w-full max-w-7xl px-4 sm6 lg8\">\n        <div className=\"flex flex-col items-center gap-12 lg lg16\">\n          \n          \n          <div className=\"absolute inset-0 -z-10\">\n            <span className=\"absolute left-0 top-20 h-24 w-24 rounded-3xl bg-green-400 opacity-50 blur-2xl dark30\"></span>\n            <span className=\"absolute bottom-12 right-8 h-24 w-24 rounded-3xl bg-blue-600 opacity-70 blur-2xl dark40\"></span>\n            <span className=\"absolute -top-10 left-1/3 aspect-square w-1/3 rounded-full bg-gradient-to-tr from-blue-600 to-green-400 opacity-30 blur-3xl lg1/5 dark20\"></span>\n          </div>\n    \n          \n          <div className=\"relative flex max-w-3xl flex-col items-center text-center lg lg\">\n            <h1 className=\"text-4xl font-bold leading-tight sm5xl md6xl xl7xl text-gray-900 dark100\">\n              Lorem ipsum dolor\n              <span className=\"relative inline-block bg-gradient-to-br from-blue-500 via-purple-500 to-cyan-500 bg-clip-text text-transparent\">\n                sit amet\n                <span className=\"absolute -bottom-2 left-0 h-1 w-full rounded-full bg-gradient-to-r from-blue-500 via-purple-500 to-cyan-500\"></span>\n              </span>\n              consectetur.\n            </h1>\n            <p className=\"mt-6 text-lg text-gray-600 dark300 sm\">\n              Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.\n            </p>\n          </div>\n    \n          \n          <div className=\"relative flex-1 max-w-3xl lg group\">\n            \n            <div className=\"absolute -top-8 -right-8 h-16 w-16 rounded-2xl bg-gradient-to-br from-blue-500 to-purple-500 opacity-80 backdrop-blur-sm shadow-2xl shadow-blue-500/40 dark60\"></div>\n    \n            <img\n              src=\"https://images.unsplash.com/photo-1543269664-56d93c1b41a6?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w0NzEyNjZ8MHwxfHNlYXJjaHwxMXx8V29ya2luZ3xlbnwwfDB8fHwxNzU5MDc2MTUyfDA&ixlib=rb-4.1.0&q=80&w=1080\"\n              alt=\"Lorem ipsum dolor sit amet\"\n              width=\"600\"\n              height=\"533\"\n              loading=\"lazy\"\n              className=\"relative z-10 max-h-96 w-full rounded-3xl bg-slate-200 dark800 object-cover lg lg\"\n            />\n    \n            \n            <div className=\"absolute inset-0 z-20 rounded-3xl bg-gradient-to-br from-blue-500/10 to-purple-500/10 opacity-0 transition-opacity duration-300 group-hover100\"></div>\n    \n            \n            <div className=\"absolute -bottom-6 -left-6 h-12 w-12 rounded-full bg-gradient-to-br from-emerald-500 to-teal-500 opacity-90 backdrop-blur-sm shadow-2xl shadow-emerald-500/40 dark70\"></div>\n          </div>\n        </div>\n      </div>\n    </section>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
