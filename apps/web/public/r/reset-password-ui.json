      "content": "/**\n * Component: Reset Password UI\n * Author: @jugendra-gangwar (https://tailwindflex.com/@jugendra-gangwar)\n * Source: https://tailwindflex.com/@jugendra-gangwar/reset-password-ui\n * Attribution: Créé par @jugendra-gangwar sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function ResetPasswordUi() {\n  return (\n    <div>\n    <div className=\"min-h-screen bg-gradient-to-br from-slate-100 via-white to-indigo-100 flex items-center justify-center p-6\">\n      <div className=\"w-full max-w-md\">\n        <a href=\"#\" className=\"mb-6 inline-flex items-center gap-2 text-sm font-medium text-slate-600 transition hover900\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"h-4 w-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" strokeWidth=\"2\">\n            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M15 19l-7-7 7-7\"/>\n          </svg>\n          Back\n        </a>\n        <div className=\"rounded-[28px] border border-white/70 bg-white/80 p-8 shadow-2xl backdrop-blur-xl\">\n          <div className=\"mt-6 text-center\">\n            <h1 className=\"text-3xl font-bold text-slate-900\">Create New Password</h1>\n            <p className=\"mt-3 text-sm leading-6 text-slate-500\">\n              Your new password must be different from previously used passwords.\n            </p>\n          </div>\n          <form className=\"mt-8 space-y-5\">\n            <div>\n              <label className=\"mb-2 block text-sm font-medium text-slate-700\">\n                New Password\n              </label>\n              <div className=\"relative\">\n                <span className=\"pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4\">\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"h-5 w-5 text-slate-400\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" strokeWidth=\"1.8\">\n                    <rect x=\"5\" y=\"11\" width=\"14\" height=\"9\" rx=\"2\"/>\n                    <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M8 11V8a4 4 0 118 0v3\"/>\n                  </svg>\n                </span>\n                <input type=\"password\" placeholder=\"Enter new password\" className=\"w-full rounded-xl border border-slate-200 bg-white py-3 pl-11 pr-12 text-sm outline-none transition focus500 focus4 focus100\" />\n                <button type=\"button\" className=\"absolute inset-y-0 right-0 flex items-center pr-4 text-slate-400 hover600\">\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" strokeWidth=\"1.8\">\n                    <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z\"/>\n                    <circle cx=\"12\" cy=\"12\" r=\"3\"/>\n                  </svg>\n                </button>\n              </div>\n            </div>\n            <div>\n              <label className=\"mb-2 block text-sm font-medium text-slate-700\">\n                Confirm Password\n              </label>\n              <div className=\"relative\">\n                <span className=\"pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4\">\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"h-5 w-5 text-slate-400\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" strokeWidth=\"1.8\">\n                    <rect x=\"5\" y=\"11\" width=\"14\" height=\"9\" rx=\"2\"/>\n                    <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M8 11V8a4 4 0 118 0v3\"/>\n                  </svg>\n                </span>\n                <input type=\"password\" placeholder=\"Re-enter password\" className=\"w-full rounded-xl border border-slate-200 bg-white py-3 pl-11 pr-12 text-sm outline-none transition focus500 focus4 focus100\" />\n                <button type=\"button\" className=\"absolute inset-y-0 right-0 flex items-center pr-4 text-slate-400 hover600\">\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"h-5 w-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" strokeWidth=\"1.8\">\n                    <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z\"/>\n                    <circle cx=\"12\" cy=\"12\" r=\"3\"/>\n                  </svg>\n                </button>\n              </div>\n            </div>\n            <div>\n              <div className=\"mb-2 flex items-center justify-between\">\n                <span className=\"text-xs font-medium text-slate-600\">Password Strength</span>\n                <span className=\"text-xs font-semibold text-emerald-600\">Strong</span>\n              </div>\n              <div className=\"flex gap-2\">\n                <div className=\"h-2 flex-1 rounded-full bg-emerald-500\"></div>\n                <div className=\"h-2 flex-1 rounded-full bg-emerald-500\"></div>\n                <div className=\"h-2 flex-1 rounded-full bg-emerald-500\"></div>\n                <div className=\"h-2 flex-1 rounded-full bg-emerald-500\"></div>\n              </div>\n            </div>\n            <div className=\"rounded-2xl border border-slate-200 bg-slate-50 p-4\">\n              <p className=\"mb-3 text-sm font-semibold text-slate-800\">Password Requirements</p>\n              <div className=\"space-y-2 text-sm text-slate-600\">\n                <div className=\"flex items-center gap-2\">\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"h-4 w-4 text-emerald-500\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" strokeWidth=\"2\">\n                    <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M5 13l4 4L19 7\"/>\n                  </svg>\n                  At least 8 characters\n                </div>\n                <div className=\"flex items-center gap-2\">\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"h-4 w-4 text-emerald-500\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" strokeWidth=\"2\">\n                    <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M5 13l4 4L19 7\"/>\n                  </svg>\n                  One uppercase letter\n                </div>\n                <div className=\"flex items-center gap-2\">\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"h-4 w-4 text-emerald-500\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" strokeWidth=\"2\">\n                    <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M5 13l4 4L19 7\"/>\n                  </svg>\n                  One number & special character\n                </div>\n              </div>\n            </div>\n            <button className=\"w-full rounded-xl bg-slate-900 py-3.5 text-sm font-semibold text-white shadow-lg shadow-slate-900/20 transition hover800\">\n              Update Password\n            </button>\n          </form>\n          <p className=\"mt-8 text-center text-sm text-slate-500\">\n            Remember your password?\n            <a href=\"#\" className=\"font-semibold text-slate-900 hover\">\n              Sign in\n            </a>\n          </p>\n        </div>\n      </div>\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
