\">\\n          <svg xmlns=\\\"http://www.w3.org/2000/svg\\\" class=\\\"h-6 w-6 text-white\\\" fill=\\\"none\\\" viewBox=\\\"0 0 24 24\\\" stroke=\\\"currentColor\\\">\\n            <path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" stroke-width=\\\"2\\\" d=\\\"M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z\\\" />\\n          </svg>\\n        </div>\\n        <h3 class=\\\"text-xl font-bold mb-3\\\">Custom Dashboards</h3>\\n        <p class=\\\"text-slate-400 mb-4\\\">Create personalized dashboards to monitor the metrics that matter most to your business.</p>\\n        <a href=\\\"#\\\" class=\\\"text-indigo-400 hover:text-indigo-300 flex items-center space-x-1\\\">\\n          <span>Learn more</span>\\n          <svg xmlns=\\\"http://www.w3.org/2000/svg\\\" class=\\\"h-4 w-4\\\" viewBox=\\\"0 0 20 20\\\" fill=\\\"currentColor\\\">\\n            <path fill-rule=\\\"evenodd\\\" d=\\\"M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H5a1 1 0 110-2h7.586l-2.293-2.293a1 1 0 010-1.414z\\\" clip-rule=\\\"evenodd\\\" />\\n          </svg>\\n        </a>\\n      </div>\\n    </div>\\n  </section>\\n\\n  <!-- Solutions Section -->\\n  <section id=\\\"solutions\\\" class=\\\"py-20 px-4 md:px-12 bg-slate-900/50\\\">\\n    <div class=\\\"max-w-7xl mx-auto\\\">\\n      <div class=\\\"flex flex-col lg:flex-row items-center\\\">\\n        <div class=\\\"lg:w-1/2 mb-16 lg:mb-0 lg:pr-12\\\">\\n          <div class=\\\"inline-block px-4 py-1 rounded-full bg-slate-800 text-sm font-medium mb-6\\\">\\n            <span class=\\\"gradient-text\\\">Tailored Solutions</span>\\n          </div>\\n          <h2 class=\\\"text-3xl md:text-5xl font-bold mb-6 title-font\\\">\\n            Built for your <span class=\\\"gradient-text\\\">industry</span>\\n          </h2>\\n          <p class=\\\"tex