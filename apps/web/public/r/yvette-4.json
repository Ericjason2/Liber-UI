    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Big Zero Matrix Rain</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            background: #000;\n            overflow: hidden;\n            font-family: 'Courier New', monospace;\n            font-weight: bold;\n        }\n\n        canvas {\n            display: block;\n            background: radial-gradient(circle at center, #001100 0%, #000000 100%);\n        }\n\n        .controls {\n            position: fixed;\n            top: 20px;\n            left: 20px;\n            z-index: 1000;\n            background: rgba(0, 0, 0, 0.9);\n            padding: 20px;\n            border-radius: 15px;\n            color: #00ff00;\n            font-family: 'Courier New', monospace;\n            border: 2px solid #00ff00;\n            box-shadow: 0 0 20px rgba(0, 255, 0, 0.3);\n        }\n\n        .control-group {\n            margin-bottom: 15px;\n        }\n\n        .control-group label {\n            display: block;\n            margin-bottom: 8px;\n            font-size: 14px;\n            font-weight: bold;\n        }\n\n        .control-group input[type=\"range\"] {\n            background: rgba(0, 255, 0, 0.1);\n            border: 1px solid #00ff00;\n            height: 25px;\n            width: 150px;\n            border-radius: 5px;\n        }\n\n        .size-display {\n            color: #00ffff;\n            font-size: 12px;\n            margin-top: 5px;\n        }\n\n        .toggle-btn {\n            background: linear-gradient(45deg, rgba(0, 255, 0, 0.2), rgba(0, 255, 255, 0.2));\n            border: 2px solid #00ff00;\n            color: #00ff00;\n            padding: 12px 20px;\n            border-radius: 8px;\n            cursor: pointer;\n            font-family: 'Courier New', monospace;\n            font-size: 14px;\n            font-weight: bold;\n            margin: 5px;\n            transition: all 0.3s ease;\n            text-transform: uppercase;\n        }\n\n        .toggle-btn:hover {\n            background: linear-gradient(45deg, rgba(0, 255, 0, 0.4), rgba(0, 255, 255, 0.4));\n            box-shadow: 0 0 15px rgba(0, 255, 0, 0.5);\n            transform: scale(1.05);\n        }\n\n        .info {\n            position: fixed;\n            bottom: 20px;\n            right: 20px;\n            background: rgba(0, 0, 0, 0.9);\n            padding: 15px;\n            border-radius: 10px;\n            color: #00ff00;\n            font-family: 'Courier New', monospace;\n            font-size: 13px;\n            border: 2px solid #00ff00;\n            box-shadow: 0 0 20px rgba(0, 255, 0, 0.3);\n        }\n\n        .title {\n            position: fixed;\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            font-size: 4rem;\n            color: rgba(0, 255, 0, 0.1);\n            font-family: 'Courier New', monospace;\n            font-weight: bold;\n            text-align: center;\n            pointer-events: none;\n            z-index: 1;\n            text-shadow: 0 0 50px rgba(0, 255, 0, 0.3);\n        }\n    </style>\n</head>\n<body>\n    <div class=\"title\">BIG ZERO MATRIX</div>\n    <canvas id=\"matrixCanvas\"></canvas>\n    \n    <div class=\"controls\">\n        <div class=\"control-group\">\n            <label>Zero Size:</label>\n            <input type=\"range\" id=\"sizeControl\" min=\"20\" max=\"120\" value=\"60\">\n            <div class=\"size-display\" id=\"sizeDisplay\">60px</div>\n        </div>\n        <div class=\"control-group\">\n            <label>Fall Speed:</label>\n            <input type=\"range\" id=\"speedControl\" min=\"1\" max=\"15\" value=\"8\">\n        </div>\n        <div class=\"control-group\">\n            <label>Zero Density:</label>\n            <input type=\"range\" id=\"densityControl\" min=\"5\" max=\"50\" value=\"25\">\n        </div>\n        <div class=\"control-group\">\n            <label>Color Change Speed:</label>\n            <input type=\"range\" id=\"colorSpeedControl\" min=\"1\" max=\"30\" value=\"15\">\n        </div>\n        <button class=\"toggle-btn\" onclick=\"togglePause()\">Pause</button>\n        <button class=\"toggle-btn\" onclick=\"resetMatrix()\">Reset</button>\n        <button class=\"toggle-btn\" onclick=\"randomBurst()\">Burst!</button>\n    </div>\n\n    <div class=\"info\">\n        🎮 CONTROLS:<br>\n        • Click = Color Explosion<br>\n        • SPACE = Pause/Resume<br>\n        • F = Fullscreen<br>\n        • R = Reset Matrix<br>\n        • B = Random Burst\n    </div>\n\n    <script>\n        const canvas = document.getElementById('matrixCanvas');\n        const ctx = canvas.getContext('2d');\n\n        function resizeCanvas() {\n            canvas.width = window.innerWidth;\n            canvas.height = window.innerHeight;\n            initMatrix();\n        }\n        resizeCanvas();\n        window.addEventListener('resize', resizeCanvas);\n\n        // Big Zero Matrix variables\n        let columns;\n        let bigZeros = [];\n        let isPaused = false;\n        let animationId;\n        let colorChangeCounter = 0;\n\n        // Vibrant color palettes for big zeros\n        const colorPalettes = [\n            // Classic Matrix Green\n            ['#00ff00', '#00ff41', '#41ff00', '#00ff82', '#82ff00', '#00ffaa', '#aaff00'],\n            // Electric Blue\n            ['#0080ff', '#00aaff', '#40bfff', '#0066ff', '#66aaff', '#0099ff', '#99ccff'],\n            // Hot Pink/Magenta\n            ['#ff0080', '#ff4080', '#ff0040', '#ff8080', '#ff40aa', '#ff80aa', '#ffaacc'],\n            // Cyber Orange\n            ['#ff8000', '#ff9900', '#ffaa00', '#ff6600', '#ffbb33', '#ff7733', '#ffcc66'],\n            // Purple Neon\n            ['#8000ff', '#9933ff', '#aa00ff', '#6600cc', '#bb66ff', '#7733cc', '#cc99ff'],\n            // Acid Green\n            ['#ccff00', '#aaff33', '#88ff00', '#99ff33', '#77ff00', '#bbff66', '#ddff99'],\n            // Electric Red\n            ['#ff3300', '#ff6600', '#ff4400', '#ff5500', '#ff7733', '#ff8844', '#ffaa66']\n        ];\n\n        let currentPalette = 0;\n\n        class BigZero {\n            constructor(x) {\n                this.x = x;\n                this.y = -100;\n                this.size = 60;\n                this.speed = Math.random() * 3 + 2;\n                this.color = this.getRandomColor();\n                this.glowIntensity = Math.random() * 20 + 10;\n                this.rotation = 0;\n                this.rotationSpeed = (Math.random() - 0.5) * 0.02;\n                this.pulsePhase = Math.random() * Math.PI * 2;\n                this.trail = [];\n                this.maxTrailLength = 8;\n                this.opacity = 1;\n            }\n\n            getRandomColor() {\n                const palette = colorPalettes[currentPalette];\n                return palette[Math.floor(Math.random() * palette.length)];\n            }\n\n            update() {\n                const speed = document.getElementById('speedControl').value / 3;\n                const size = parseInt(document.getElementById('sizeControl').value);\n                const colorSpeed = parseInt(document.getElementById('colorSpeedControl').value);\n                \n                this.size = size;\n                this.y += this.speed * speed;\n                this.rotation += this.rotationSpeed;\n                this.pulsePhase += 0.1;\n\n                // Add current position to trail\n                this.trail.unshift({\n                    x: this.x,\n                    y: this.y,\n                    size: this.size,\n                    color: this.color,\n                    opacity: 1\n                });\n\n                // Limit trail length\n                if (this.trail.length > this.maxTrailLength) {\n                    this.trail.pop();\n                }\n\n                // Update trail opacity\n                this.trail.forEach((point, index) => {\n                    point.opacity = 1 - (index / this.maxTrailLength);\n                });\n\n                // Change color periodically\n                if (colorChangeCounter % (40 - colorSpeed) === 0) {\n                    this.color = this.getRandomColor();\n                }\n\n                // Reset when off screen\n                if (this.y > canvas.height + 100) {\n                    this.y = -100 - Math.random() * 500;\n                    this.color = this.getRandomColor();\n                    this.speed = Math.random() * 3 + 2;\n                    this.trail = [];\n                }\n            }\n\n            draw() {\n                // Draw trail\n                this.trail.forEach((point, index) => {\n                    if (index > 0) {\n                        ctx.save();\n                        ctx.globalAlpha = point.opacity * 0.6;\n                        ctx.fillStyle = point.color;\n                        ctx.shadowColor = point.color;\n                        ctx.shadowBlur = this.glowIntensity * point.opacity;\n                        \n                        ctx.font = `bold ${point.size * 0.8}px Courier New`;\n                        ctx.textAlign = 'center';\n                        ctx.textBaseline = 'middle';\n                        \n                        ctx.fillText('0', point.x, point.y);\n                        ctx.restore();\n                    }\n                });\n\n                // Draw main zero\n                ctx.save();\n                \n                // Translate to zero position\n                ctx.translate(this.x, this.y);\n                ctx.rotate(this.rotation);\n                \n                // Pulsing effect\n                const pulse = Math.sin(this.pulsePhase) * 0.1 + 1;\n                const currentSize = this.size * pulse;\n                \n                // Glow effect\n                ctx.shadowColor = this.color;\n                ctx.shadowBlur = this.glowIntensity + Math.sin(this.pulsePhase) * 5;\n                \n                // Main zero\n                ctx.fillStyle = this.color;\n                ctx.font = `bold ${currentSize}px Courier New`;\n                ctx.textAlign = 'center';\n                ctx.textBaseline = 'middle';\n                \n                // Draw multiple layers for extra glow\n                for (let i = 0; i < 3; i++) {\n                    ctx.globalAlpha = 0.3 + (i * 0.2);\n                    ctx.fillText('0', 0, 0);\n                }\n                \n                ctx.globalAlpha = 1;\n                ctx.restore();\n            }\n        }\n\n        function initMatrix() {\n            const density = parseInt(document.getElementById('densityControl').value);\n            const spacing = canvas.width / density;\n            \n            bigZeros = [];\n            columns = density;\n            \n            for (let i = 0; i < columns; i++) {\n                const x = (i * spacing) + (spacing / 2);\n                const zero = new BigZero(x);\n                zero.y = -Math.random() * canvas.height;\n                bigZeros.push(zero);\n            }\n        }\n\n        function draw() {\n            if (isPaused) return;\n\n            // Clear with fade effect\n            ctx.fillStyle = 'rgba(0, 0, 0, 0.15)';\n            ctx.fillRect(0, 0, canvas.width, canvas.height);\n\n            colorChangeCounter++;\n\n            // Update and draw all big zeros\n            bigZeros.forEach(zero => {\n                zero.update();\n                zero.draw();\n            });\n\n            // Change color palette occasionally\n            if (colorChangeCounter % 800 === 0) {\n                currentPalette = (currentPalette + 1) % colorPalettes.length;\n            }\n\n            animationId = requestAnimationFrame(draw);\n        }\n\n        function togglePause() {\n            isPaused = !isPaused;\n            const btn = document.querySelector('.toggle-btn');\n            btn.textContent = isPaused ? 'Resume' : 'Pause';\n            if (!isPaused) {\n                draw();\n            }\n        }\n\n        function resetMatrix() {\n            cancelAnimationFrame(animationId);\n            colorChangeCounter = 0;\n            currentPalette = 0;\n            initMatrix();\n            draw();\n        }\n\n        function randomBurst() {\n            // Create temporary burst zeros\n            for (let i = 0; i < 15; i++) {\n                setTimeout(() => {\n                    const burstZero = new BigZero(Math.random() * canvas.width);\n                    burstZero.y = Math.random() * canvas.height;\n                    burstZero.size = Math.random() * 80 + 40;\n                    burstZero.color = colorPalettes[Math.floor(Math.random() * colorPalettes.length)][0];\n                    burstZero.glowIntensity = 30;\n                    \n                    // Draw burst zero\n                    burstZero.draw();\n                }, i * 100);\n            }\n        }\n\n        // Click effect\n        canvas.addEventListener('click', function(e) {\n            const rect = canvas.getBoundingClientRect();\n            const clickX = e.clientX - rect.left;\n            const clickY = e.clientY - rect.top;\n\n            // Create explosion of big zeros\n            for (let i = 0; i < 10; i++) {\n                setTimeout(() => {\n                    ctx.save();\n                    ctx.translate(clickX, clickY);\n                    \n                    const angle = (i / 10) * Math.PI * 2;\n                    const distance = Math.random() * 150 + 50;\n                    const x = Math.cos(angle) * distance;\n                    const y = Math.sin(angle) * distance;\n                    \n                    ctx.fillStyle = colorPalettes[Math.floor(Math.random() * colorPalettes.length)][0];\n                    ctx.shadowColor = ctx.fillStyle;\n                    ctx.shadowBlur = 25;\n                    ctx.font = `bold ${Math.random() * 60 + 40}px Courier New`;\n                    ctx.textAlign = 'center';\n                    ctx.fillText('0', x, y);\n                    \n                    ctx.restore();\n                }, i * 80);\n            }\n        });\n\n        // Keyboard controls\n        document.addEventListener('keydown', function(e) {\n            switch(e.key.toLowerCase()) {\n                case 'f':\n                    if (document.fullscreenElement) {\n                        document.exitFullscreen();\n                    } else {\n                        document.documentElement.requestFullscreen();\n                    }\n                    break;\n                case ' ':\n                    e.preventDefault();\n                    togglePause();\n                    break;\n                case 'r':\n                    resetMatrix();\n                    break;\n                case 'b':\n                    randomBurst();\n                    break;\n                case 'c':\n                    currentPalette = (currentPalette + 1) % colorPalettes.length;\n                    break;\n            }\n        });\n\n        // Control updates\n        document.getElementById('sizeControl').addEventListener('input', function() {\n            document.getElementById('sizeDisplay').textContent = this.value + 'px';\n        });\n\n        document.getElementById('densityControl').addEventListener('input', function() {\n            initMatrix();\n        });\n\n        // Automatic color palette cycling\n        setInterval(() => {\n            if (!isPaused && Math.random() < 0.3) {\n                // Random color burst effect\n                const randomZero = bigZeros[Math.floor(Math.random() * bigZeros.length)];\n                if (randomZero) {\n                    randomZero.color = randomZero.getRandomColor();\n                    randomZero.glowIntensity = 35;\n                }\n            }\n        }, 3000);\n\n        // Initialize and start\n        initMatrix();\n        draw();\n    </script>\n</body>\n</html>"
  }
}
