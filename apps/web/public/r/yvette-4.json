      "content": "/**\n * Component: Yvette\n * Author: @umutoniwase-yvette (https://tailwindflex.com/@umutoniwase-yvette)\n * Source: https://tailwindflex.com/@umutoniwase-yvette/yvette-4\n * Attribution: Créé par @umutoniwase-yvette sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function Yvette4() {\n  return (\n    <div dangerouslySetInnerHTML={{ __html: \"<!DOCTYPE html>\\n<html lang=\\\"en\\\">\\n<head>\\n    <meta charset=\\\"UTF-8\\\">\\n    <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\">\\n    <title>Big Zero Matrix Rain</title>\\n    <style>\\n        * {\\n            margin: 0;\\n            padding: 0;\\n            box-sizing: border-box;\\n        }\\n\\n        body {\\n            background: #000;\\n            overflow: hidden;\\n            font-family: 'Courier New', monospace;\\n            font-weight: bold;\\n        }\\n\\n        canvas {\\n            display: block;\\n            background: radial-gradient(circle at center, #001100 0%, #000000 100%);\\n        }\\n\\n        .controls {\\n            position: fixed;\\n            top: 20px;\\n            left: 20px;\\n            z-index: 1000;\\n            background: rgba(0, 0, 0, 0.9);\\n            padding: 20px;\\n            border-radius: 15px;\\n            color: #00ff00;\\n            font-family: 'Courier New', monospace;\\n            border: 2px solid #00ff00;\\n            box-shadow: 0 0 20px rgba(0, 255, 0, 0.3);\\n        }\\n\\n        .control-group {\\n            margin-bottom: 15px;\\n        }\\n\\n        .control-group label {\\n            display: block;\\n            margin-bottom: 8px;\\n            font-size: 14px;\\n            font-weight: bold;\\n        }\\n\\n        .control-group input[type=\\\"range\\\"] {\\n            background: rgba(0, 255, 0, 0.1);\\n            border: 1px solid #00ff00;\\n            height: 25px;\\n            width: 150px;\\n            border-radius: 5px;\\n        }\\n\\n        .size-display {\\n            color: #00ffff;\\n            font-size: 12px;\\n            margin-top: 5px;\\n        }\\n\\n        .toggle-btn {\\n            background: linear-gradient(45deg, rgba(0, 255, 0, 0.2), rgba(0, 255, 255, 0.2));\\n            border: 2px solid #00ff00;\\n            color: #00ff00;\\n            padding: 12px 20px;\\n            border-radius: 8px;\\n            cursor: pointer;\\n            font-family: 'Courier New', monospace;\\n            font-size: 14px;\\n            font-weight: bold;\\n            margin: 5px;\\n            transition: all 0.3s ease;\\n            text-transform: uppercase;\\n        }\\n\\n        .toggle-btn:hover {\\n            background: linear-gradient(45deg, rgba(0, 255, 0, 0.4), rgba(0, 255, 255, 0.4));\\n            box-shadow: 0 0 15px rgba(0, 255, 0, 0.5);\\n            transform: scale(1.05);\\n        }\\n\\n        .info {\\n            position: fixed;\\n            bottom: 20px;\\n            right: 20px;\\n            background: rgba(0, 0, 0, 0.9);\\n            padding: 15px;\\n            border-radius: 10px;\\n            color: #00ff00;\\n            font-family: 'Courier New', monospace;\\n            font-size: 13px;\\n            border: 2px solid #00ff00;\\n            box-shadow: 0 0 20px rgba(0, 255, 0, 0.3);\\n        }\\n\\n        .title {\\n            position: fixed;\\n            top: 50%;\\n            left: 50%;\\n            transform: translate(-50%, -50%);\\n            font-size: 4rem;\\n            color: rgba(0, 255, 0, 0.1);\\n            font-family: 'Courier New', monospace;\\n            font-weight: bold;\\n            text-align: center;\\n            pointer-events: none;\\n            z-index: 1;\\n            text-shadow: 0 0 50px rgba(0, 255, 0, 0.3);\\n        }\\n    </style>\\n</head>\\n<body>\\n    <div class=\\\"title\\\">BIG ZERO MATRIX</div>\\n    <canvas id=\\\"matrixCanvas\\\"></canvas>\\n    \\n    <div class=\\\"controls\\\">\\n        <div class=\\\"control-group\\\">\\n            <label>Zero Size:</label>\\n            <input type=\\\"range\\\" id=\\\"sizeControl\\\" min=\\\"20\\\" max=\\\"120\\\" value=\\\"60\\\">\\n            <div class=\\\"size-display\\\" id=\\\"sizeDisplay\\\">60px</div>\\n        </div>\\n        <div class=\\\"control-group\\\">\\n            <label>Fall Speed:</label>\\n            <input type=\\\"range\\\" id=\\\"speedControl\\\" min=\\\"1\\\" max=\\\"15\\\" value=\\\"8\\\">\\n        </div>\\n        <div class=\\\"control-group\\\">\\n            <label>Zero Density:</label>\\n            <input type=\\\"range\\\" id=\\\"densityControl\\\" min=\\\"5\\\" max=\\\"50\\\" value=\\\"25\\\">\\n        </div>\\n        <div class=\\\"control-group\\\">\\n            <label>Color Change Speed:</label>\\n            <input type=\\\"range\\\" id=\\\"colorSpeedControl\\\" min=\\\"1\\\" max=\\\"30\\\" value=\\\"15\\\">\\n        </div>\\n        <button class=\\\"toggle-btn\\\">Pause</button>\\n        <button class=\\\"toggle-btn\\\">Reset</button>\\n        <button class=\\\"toggle-btn\\\">Burst!</button>\\n    </div>\\n\\n    <div class=\\\"info\\\">\\n        🎮 CONTROLS:<br>\\n        • Click = Color Explosion<br>\\n        • SPACE = Pause/Resume<br>\\n        • F = Fullscreen<br>\\n        • R = Reset Matrix<br>\\n        • B = Random Burst\\n    </div>\\n\\n    \\n</body>\\n</html>\" }} />\n  );\n}\n",
