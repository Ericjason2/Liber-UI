    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Enhanced Testimonials Section</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link\n        href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@300;400;500;600&display=swap\"\n        rel=\"stylesheet\">\n    <script>\n        tailwind.config = {\n            theme: {\n                extend: {\n                    colors: {\n                        'tab-purple': '#7C3AED',\n                        'tab-teal': '#06B6D4',\n                    },\n                    fontFamily: {\n                        'playfair': ['Playfair Display', 'serif'],\n                        'inter': ['Inter', 'sans-serif'],\n                    }\n                }\n            }\n        }\n    </script>\n    <style>\n        @keyframes float {\n\n            0%,\n            100% {\n                transform: translateY(0px);\n            }\n\n            50% {\n                transform: translateY(-10px);\n            }\n        }\n\n        @keyframes glow {\n\n            0%,\n            100% {\n                box-shadow: 0 0 20px rgba(124, 58, 237, 0.3);\n            }\n\n            50% {\n                box-shadow: 0 0 30px rgba(124, 58, 237, 0.5);\n            }\n        }\n\n        @keyframes slideInUp {\n            from {\n                opacity: 0;\n                transform: translateY(50px);\n            }\n\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        .floating {\n            animation: float 6s ease-in-out infinite;\n        }\n\n        .glow-effect {\n            animation: glow 3s ease-in-out infinite alternate;\n        }\n\n        .animate-slide-in {\n            animation: slideInUp 0.6s ease-out forwards;\n        }\n\n        .testimonial-card {\n            backdrop-filter: blur(20px);\n            background: rgba(255, 255, 255, 0.95);\n            border: 1px solid rgba(255, 255, 255, 0.2);\n        }\n\n        .gradient-text {\n            background: linear-gradient(135deg, #7C3AED, #06B6D4);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n\n        .star-rating {\n            filter: drop-shadow(0 0 8px rgba(255, 193, 7, 0.6));\n        }\n\n        .quote-mark {\n            background: linear-gradient(135deg, #7C3AED, #06B6D4);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n            font-size: 4rem;\n            line-height: 1;\n            opacity: 0.3;\n        }\n    </style>\n</head>\n\n<body class=\"bg-gradient-to-br from-indigo-50 via-purple-50 to-teal-50 min-h-screen overflow-x-hidden\">\n\n    <!-- Testimonials Section -->\n    <section class=\"pt-16 pb-20 relative min-h-screen flex flex-col justify-center\">\n        <!-- Background Elements -->\n        <div class=\"absolute inset-0 overflow-hidden -z-10\">\n            <div\n                class=\"absolute top-10 left-10 w-72 h-72 bg-purple-200 rounded-full mix-blend-multiply filter blur-xl opacity-30 floating\">\n            </div>\n            <div class=\"absolute top-0 right-10 w-72 h-72 bg-teal-200 rounded-full mix-blend-multiply filter blur-xl opacity-30 floating\"\n                style=\"animation-delay: -2s;\"></div>\n            <div class=\"absolute bottom-10 left-1/2 w-72 h-72 bg-indigo-200 rounded-full mix-blend-multiply filter blur-xl opacity-30 floating\"\n                style=\"animation-delay: -4s;\"></div>\n        </div>\n\n        <div class=\"max-w-7xl mx-auto px-6 relative z-10\">\n            <!-- Header -->\n            <div class=\"text-center mb-12 px-4\">\n                <div class=\"inline-block p-2 rounded-full bg-gradient-to-r from-purple-100 to-teal-100 mb-4\">\n                    <div class=\"bg-white rounded-full px-4 py-1\">\n                        <span class=\"text-xs sm:text-sm font-semibold gradient-text\">SUCCESS STORIES</span>\n                    </div>\n                </div>\n\n                <h1\n                    class=\"text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 font-playfair leading-tight mb-4\">\n                    What Our <span class=\"gradient-text block sm:inline\">Students Say</span>\n                </h1>\n\n                <p class=\"text-base sm:text-lg md:text-xl text-gray-600 max-w-2xl mx-auto leading-relaxed\">\n                    Don't just take our word for it. Here's what our incredible students have to say about their\n                    transformative learning experience.\n                </p>\n            </div>\n\n            <!-- Testimonials Grid -->\n            <div class=\"grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-8\">\n\n                <!-- Testimonial Card 1 -->\n                <div\n                    class=\"testimonial-card relative rounded-2xl shadow-xl overflow-hidden group hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-2 glow-effect\">\n                    <div class=\"absolute top-4 left-4 quote-mark\">\"</div>\n                    <div class=\"p-8 pt-16\">\n                        <div class=\"flex mb-6 star-rating\">\n                            <span class=\"text-yellow-400 text-xl\">★★★★★</span>\n                        </div>\n                        <p class=\"text-gray-700 mb-6 leading-relaxed italic\">\n                            \"This platform completely transformed my musical journey. The instructors are\n                            world-class and the personalized approach made all the difference.\"\n                        </p>\n                        <div class=\"flex items-center\">\n                            <div class=\"relative\">\n                                <img\n                                    src=\"https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?ixlib=rb-4.0.3&auto=format&fit=crop&w=100&q=80\"\n                                    alt=\"Rajesh Kumar\"\n                                    class=\"w-12 h-12 rounded-full object-cover border-2 border-purple-200\" />\n                                <div\n                                    class=\"absolute -bottom-1 -right-1 w-6 h-6 bg-green-400 rounded-full border-2 border-white\">\n                                </div>\n                            </div>\n                            <div class=\"ml-4\">\n                                <h4 class=\"font-semibold text-gray-900\">Rajesh Kumar</h4>\n                                <p class=\"text-sm text-gray-500\">Music Student</p>\n                            </div>\n                        </div>\n                        <div\n                            class=\"absolute top-4 right-4 bg-gradient-to-r from-purple-500 to-teal-500 text-white px-3 py-1 rounded-full text-xs font-semibold\">\n                            Classical Music\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Testimonial Card 2 -->\n                <div class=\"testimonial-card relative rounded-2xl shadow-xl overflow-hidden group hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-2\"\n                    style=\"animation-delay: 0.2s;\">\n                    <div class=\"absolute top-4 left-4 quote-mark\">\"</div>\n                    <div class=\"p-8 pt-16\">\n                        <div class=\"flex mb-6 star-rating\">\n                            <span class=\"text-yellow-400 text-xl\">★★★★★</span>\n                        </div>\n                        <p class=\"text-gray-700 mb-6 leading-relaxed italic\">\n                            \"The dance classes here are incredible! I've grown so much as a perf