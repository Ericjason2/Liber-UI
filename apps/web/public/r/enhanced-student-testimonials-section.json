      "content": "/**\n * Component: Enhanced Student Testimonials Section\n * Author: @umairarshad-dev (https://tailwindflex.com/@umairarshad-dev)\n * Source: https://tailwindflex.com/@umairarshad-dev/enhanced-student-testimonials-section\n * Attribution: Créé par @umairarshad-dev sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function EnhancedStudentTestimonialsSection() {\n  return (\n    <div dangerouslySetInnerHTML={{ __html: \"<!DOCTYPE html>\\n<html lang=\\\"en\\\">\\n\\n<head>\\n    <meta charset=\\\"UTF-8\\\">\\n    <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\">\\n    <title>Enhanced Testimonials Section</title>\\n    \\n    <link\\n        href=\\\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@300;400;500;600&display=swap\\\"\\n        rel=\\\"stylesheet\\\">\\n    \\n    <style>\\n        @keyframes float {\\n\\n            0%,\\n            100% {\\n                transform: translateY(0px);\\n            }\\n\\n            50% {\\n                transform: translateY(-10px);\\n            }\\n        }\\n\\n        @keyframes glow {\\n\\n            0%,\\n            100% {\\n                box-shadow: 0 0 20px rgba(124, 58, 237, 0.3);\\n            }\\n\\n            50% {\\n                box-shadow: 0 0 30px rgba(124, 58, 237, 0.5);\\n            }\\n        }\\n\\n        @keyframes slideInUp {\\n            from {\\n                opacity: 0;\\n                transform: translateY(50px);\\n            }\\n\\n            to {\\n                opacity: 1;\\n                transform: translateY(0);\\n            }\\n        }\\n\\n        .floating {\\n            animation: float 6s ease-in-out infinite;\\n        }\\n\\n        .glow-effect {\\n            animation: glow 3s ease-in-out infinite alternate;\\n        }\\n\\n        .animate-slide-in {\\n            animation: slideInUp 0.6s ease-out forwards;\\n        }\\n\\n        .testimonial-card {\\n            backdrop-filter: blur(20px);\\n            background: rgba(255, 255, 255, 0.95);\\n            border: 1px solid rgba(255, 255, 255, 0.2);\\n        }\\n\\n        .gradient-text {\\n            background: linear-gradient(135deg, #7C3AED, #06B6D4);\\n            -webkit-background-clip: text;\\n            -webkit-text-fill-color: transparent;\\n            background-clip: text;\\n        }\\n\\n        .star-rating {\\n            filter: drop-shadow(0 0 8px rgba(255, 193, 7, 0.6));\\n        }\\n\\n        .quote-mark {\\n            background: linear-gradient(135deg, #7C3AED, #06B6D4);\\n            -webkit-background-clip: text;\\n            -webkit-text-fill-color: transparent;\\n            background-clip: text;\\n            font-size: 4rem;\\n            line-height: 1;\\n            opacity: 0.3;\\n        }\\n    </style>\\n</head>\\n\\n<body class=\\\"bg-gradient-to-br from-indigo-50 via-purple-50 to-teal-50 min-h-screen overflow-x-hidden\\\">\\n\\n    <!-- Testimonials Section -->\\n    <section class=\\\"pt-16 pb-20 relative min-h-screen flex flex-col justify-center\\\">\\n        <!-- Background Elements -->\\n        <div class=\\\"absolute inset-0 overflow-hidden -z-10\\\">\\n            <div\\n                class=\\\"absolute top-10 left-10 w-72 h-72 bg-purple-200 rounded-full mix-blend-multiply filter blur-xl opacity-30 floating\\\">\\n            </div>\\n            <div class=\\\"absolute top-0 right-10 w-72 h-72 bg-teal-200 rounded-full mix-blend-multiply filter blur-xl opacity-30 floating\\\"\\n                style=\\\"animation-delay: -2s;\\\"></div>\\n            <div class=\\\"absolute bottom-10 left-1/2 w-72 h-72 bg-indigo-200 rounded-full mix-blend-multiply filter blur-xl opacity-30 floating\\\"\\n                style=\\\"animation-delay: -4s;\\\"></div>\\n        </div>\\n\\n        <div class=\\\"max-w-7xl mx-auto px-6 relative z-10\\\">\\n            <!-- Header -->\\n            <div class=\\\"text-center mb-12 px-4\\\">\\n                <div class=\\\"inline-block p-2 rounded-full bg-gradient-to-r from-purple-100 to-teal-100 mb-4\\\">\\n                    <div class=\\\"bg-white rounded-full px-4 py-1\\\">\\n                        <span class=\\\"text-xs sm:text-sm font-semibold gradient-text\\\">SUCCESS STORIES</span>\\n                    </div>\\n                </div>\\n\\n                <h1\\n                    class=\\\"text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 font-playfair leading-tight mb-4\\\">\\n                    What Our <span class=\\\"gradient-text block sm:inline\\\">Students Say</span>\\n                </h1>\\n\\n                <p class=\\\"text-base sm:text-lg md:text-xl text-gray-600 max-w-2xl mx-auto leading-relaxed\\\">\\n                    Don't just take our word for it. Here's what our incredible students have to say about their\\n                    transformative learning experience.\\n                </p>\\n            </div>\\n\\n            <!-- Testimonials Grid -->\\n            <div class=\\\"grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-8\\\">\\n\\n                <!-- Testimonial Card 1 -->\\n                <div\\n                    class=\\\"testimonial-card relative rounded-2xl shadow-xl overflow-hidden group hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-2 glow-effect\\\">\\n                    <div class=\\\"absolute top-4 left-4 quote-mark\\\">\\\"</div>\\n                    <div class=\\\"p-8 pt-16\\\">\\n                        <div class=\\\"flex mb-6 star-rating\\\">\\n                            <span class=\\\"text-yellow-400 text-xl\\\">★★★★★</span>\\n                        </div>\\n                        <p class=\\\"text-gray-700 mb-6 leading-relaxed italic\\\">\\n                            \\\"This platform completely transformed my musical journey. The instructors are\\n                            world-class and the personalized approach made all the difference.\\\"\\n                        </p>\\n                        <div class=\\\"flex items-center\\\">\\n                            <div class=\\\"relative\\\">\\n                                <img\\n                                    src=\\\"https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?ixlib=rb-4.0.3&auto=format&fit=crop&w=100&q=80\\\"\\n                                    alt=\\\"Rajesh Kumar\\\"\\n                                    class=\\\"w-12 h-12 rounded-full object-cover border-2 border-purple-200\\\" />\\n                                <div\\n                                    class=\\\"absolute -bottom-1 -right-1 w-6 h-6 bg-green-400 rounded-full border-2 border-white\\\">\\n                                </div>\\n                            </div>\\n                            <div class=\\\"ml-4\\\">\\n                                <h4 class=\\\"font-semibold text-gray-900\\\">Rajesh Kumar</h4>\\n                                <p class=\\\"text-sm text-gray-500\\\">Music Student</p>\\n                            </div>\\n                        </div>\\n                        <div\\n                            class=\\\"absolute top-4 right-4 bg-gradient-to-r from-purple-500 to-teal-500 text-white px-3 py-1 rounded-full text-xs font-semibold\\\">\\n                            Classical Music\\n                        </div>\\n                    </div>\\n                </div>\\n\\n                <!-- Testimonial Card 2 -->\\n                <div class=\\\"testimonial-card relative rounded-2xl shadow-xl overflow-hidden group hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-2\\\"\\n                    style=\\\"animation-delay: 0.2s;\\\">\\n                    <div class=\\\"absolute top-4 left-4 quote-mark\\\">\\\"</div>\\n                    <div class=\\\"p-8 pt-16\\\">\\n                        <div class=\\\"flex mb-6 star-rating\\\">\\n                            <span class=\\\"text-yellow-400 text-xl\\\">★★★★★</span>\\n                        </div>\\n                        <p class=\\\"text-gray-700 mb-6 leading-relaxed italic\\\">\\n                            \\\"The dance classes here are incredible! I've grown so much as a performer and gained\\n                            confidence I never knew I had.\\\"\\n                        </p>\\n                        <div class=\\\"flex items-center\\\">\\n                            <div class=\\\"relative\\\">\\n                                <img\\n                                    src=\\\"https://images.unsplash.com/photo-1494790108377-be9c29b29330?ixlib=rb-4.0.3&auto=format&fit=crop&w=100&q=80\\\"\\n                                    alt=\\\"Priya Singh\\\"\\n                                    class=\\\"w-12 h-12 rounded-full object-cover border-2 border-purple-200\\\" />\\n                                <div\\n                                    class=\\\"absolute -bottom-1 -right-1 w-6 h-6 bg-green-400 rounded-full border-2 border-white\\\">\\n                                </div>\\n                            </div>\\n                            <div class=\\\"ml-4\\\">\\n                                <h4 class=\\\"font-semibold text-gray-900\\\">Priya Singh</h4>\\n                                <p class=\\\"text-sm text-gray-500\\\">Dance Student</p>\\n                            </div>\\n                        </div>\\n                        <div\\n                            class=\\\"absolute top-4 right-4 bg-gradient-to-r from-pink-500 to-purple-500 text-white px-3 py-1 rounded-full text-xs font-semibold\\\">\\n                            Dance\\n                        </div>\\n                    </div>\\n                </div>\\n\\n                <!-- Testimonial Card 3 -->\\n                <div class=\\\"testimonial-card relative rounded-2xl shadow-xl overflow-hidden group hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-2\\\"\\n                    style=\\\"animation-delay: 0.4s;\\\">\\n                    <div class=\\\"absolute top-4 left-4 quote-mark\\\">\\\"</div>\\n                    <div class=\\\"p-8 pt-16\\\">\\n                        <div class=\\\"flex mb-6 star-rating\\\">\\n                            <span class=\\\"text-yellow-400 text-xl\\\">★★★★★</span>\\n                        </div>\\n                        <p class=\\\"text-gray-700 mb-6 leading-relaxed italic\\\">\\n                            \\\"The acting workshops are phenomenal. The techniques I learned here landed me my first\\n                            professional role!\\\"\\n                        </p>\\n                        <div class=\\\"flex items-center\\\">\\n                            <div class=\\\"relative\\\">\\n                                <img\\n                                    src=\\\"https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?ixlib=rb-4.0.3&auto=format&fit=crop&w=100&q=80\\\"\\n                                    alt=\\\"Vikram Mehta\\\"\\n                                    class=\\\"w-12 h-12 rounded-full object-cover border-2 border-purple-200\\\" />\\n                                <div\\n                                    class=\\\"absolute -bottom-1 -right-1 w-6 h-6 bg-green-400 rounded-full border-2 border-white\\\">\\n                                </div>\\n                            </div>\\n                            <div class=\\\"ml-4\\\">\\n                                <h4 class=\\\"font-semibold text-gray-900\\\">Vikram Mehta</h4>\\n                                <p class=\\\"text-sm text-gray-500\\\">Acting Student</p>\\n                            </div>\\n                        </div>\\n                        <div\\n                            class=\\\"absolute top-4 right-4 bg-gradient-to-r from-teal-500 to-blue-500 text-white px-3 py-1 rounded-full text-xs font-semibold\\\">\\n                            Acting\\n                        </div>\\n                    </div>\\n                </div>\\n\\n                <!-- Testimonial Card 4 -->\\n                <div class=\\\"testimonial-card relative rounded-2xl shadow-xl overflow-hidden group hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-2\\\"\\n                    style=\\\"animation-delay: 0.6s;\\\">\\n                    <div class=\\\"absolute top-4 left-4 quote-mark\\\">\\\"</div>\\n                    <div class=\\\"p-8 pt-16\\\">\\n                        <div class=\\\"flex mb-6 star-rating\\\">\\n                            <span class=\\\"text-yellow-400 text-xl\\\">★★★★★</span>\\n                        </div>\\n                        <p class=\\\"text-gray-700 mb-6 leading-relaxed italic\\\">\\n                            \\\"My photography skills improved dramatically! The mentorship program is worth every\\n                            penny. Highly recommend!\\\"\\n                        </p>\\n                        <div class=\\\"flex items-center\\\">\\n                            <div class=\\\"relative\\\">\\n                                <img\\n                                    src=\\\"https://images.unsplash.com/photo-1544005313-94ddf0286df2?ixlib=rb-4.0.3&auto=format&fit=crop&w=100&q=80\\\"\\n                                    alt=\\\"Aisha Kapoor\\\"\\n                                    class=\\\"w-12 h-12 rounded-full object-cover border-2 border-purple-200\\\" />\\n                                <div\\n                                    class=\\\"absolute -bottom-1 -right-1 w-6 h-6 bg-green-400 rounded-full border-2 border-white\\\">\\n                                </div>\\n                            </div>\\n                            <div class=\\\"ml-4\\\">\\n                                <h4 class=\\\"font-semibold text-gray-900\\\">Aisha Kapoor</h4>\\n                                <p class=\\\"text-sm text-gray-500\\\">Photography Student</p>\\n                            </div>\\n                        </div>\\n                        <div\\n                            class=\\\"absolute top-4 right-4 bg-gradient-to-r from-orange-500 to-red-500 text-white px-3 py-1 rounded-full text-xs font-semibold\\\">\\n                            Photography\\n                        </div>\\n                    </div>\\n                </div>\\n            </div>\\n\\n            <!-- Stats Section -->\\n            <div\\n                class=\\\"grid grid-cols-2 md:grid-cols-4 gap-8 mt-16 p-8 bg-white/60 backdrop-blur-sm rounded-2xl shadow-lg\\\">\\n                <div class=\\\"text-center\\\">\\n                    <div class=\\\"text-3xl font-bold gradient-text mb-2\\\">500+</div>\\n                    <div class=\\\"text-gray-600 text-sm\\\">Happy Students</div>\\n                </div>\\n                <div class=\\\"text-center\\\">\\n                    <div class=\\\"text-3xl font-bold gradient-text mb-2\\\">4.9★</div>\\n                    <div class=\\\"text-gray-600 text-sm\\\">Average Rating</div>\\n                </div>\\n                <div class=\\\"text-center\\\">\\n                    <div class=\\\"text-3xl font-bold gradient-text mb-2\\\">15+</div>\\n                    <div class=\\\"text-gray-600 text-sm\\\">Expert Instructors</div>\\n                </div>\\n                <div class=\\\"text-center\\\">\\n                    <div class=\\\"text-3xl font-bold gradient-text mb-2\\\">98%</div>\\n                    <div class=\\\"text-gray-600 text-sm\\\">Success Rate</div>\\n                </div>\\n            </div>\\n\\n            <!-- Call to Action -->\\n            <div class=\\\"text-center mt-16\\\">\\n                <a href=\\\"/testimonials\\\"\\n                    class=\\\"group relative inline-flex items-center px-8 py-4 bg-gradient-to-r from-purple-600 to-teal-600 text-white font-semibold rounded-full shadow-2xl transform transition-all duration-300 hover:scale-105 hover:shadow-3xl\\\">\\n                    <span class=\\\"relative z-10\\\">Read All Success Stories</span>\\n                    <svg class=\\\"ml-3 w-5 h-5 group-hover:translate-x-1 transition-transform duration-300\\\" fill=\\\"none\\\"\\n                        stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\">\\n                        <path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" stroke-width=\\\"2\\\"\\n                            d=\\\"M17 8l4 4m0 0l-4 4m4-4H3\\\"></path>\\n                    </svg>\\n                    <div\\n                        class=\\\"absolute inset-0 bg-gradient-to-r from-purple-700 to-teal-700 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-300\\\">\\n                    </div>\\n                </a>\\n            </div>\\n        </div>\\n    </section>\\n\\n</body>\\n\\n</html>\" }} />\n  );\n}\n",
      "type": "registry:ui"
    }
