    "rawHtml": "<main id=\"content\" role=\"main\" class=\"w-full  max-w-md mx-auto p-6\">\n    <div class=\"mt-7 bg-white  rounded-xl shadow-lg dark:bg-gray-800 dark:border-[#d39430] border-2 border-[#d39430]\">\n      <div class=\"p-4 sm:p-7\">\n        <div class=\"text-center\">\n          <h1 class=\"block text-2xl font-bold text-gray-800 dark:text-white\">Esqueceu sua senha?</h1>\n          <p class=\"mt-2 text-sm text-gray-600 dark:text-gray-400\">\n            Lembra da sua senha?\n            <a class=\"text-blue-600 decoration-2 hover:underline font-medium\" href=\"#\">\n              Faça login aqui\n            </a>\n          </p>\n        </div>\n\n        <div class=\"mt-5\">\n          <form>\n            <div class=\"grid gap-y-4\">\n              <div>\n                <label for=\"email\" class=\"block text-sm font-bold ml-1 mb-2 dark:text-white\">Endereço de email</label>\n                <div class=\"relative\">\n                  <input type=\"email\" id=\"email\" name=\"email\" class=\"py-3 px-4 block w-full border-2 border-gray-200 rounded-md text-sm focus:border-[#d39430] focus:ring-[#d39430] shadow-sm\" required aria-describedby=\"email-error\">\n                </div>\n                <p class=\"hidden text-xs text-red-600 mt-2\" id=\"email-error\">Inclua um endereço de e-mail válido para que possamos entrar em contato com você</p>\n              </div>\n              <button type=\"submit\" class=\"py-3 px-4 inline-flex justify-center items-center gap-2 rounded-md border border-transparent font-semibold bg-[#d39430] text-white hover:bg-[#b07827] focus:outline-none focus:ring-2 focus:ring-[#d39430] focus:ring-offset-2 transition-all text-sm dark:focus:ring-offset-gray-800\">Redefinir senha</button>\n            </div>\n          </form>\n        </div>\n      </div>\n    </div>\n  </main>"
  }
