      "content": "/**\n * Component: Forgot password form\n * Author: @anonymous (https://tailwindflex.com/@anonymous)\n * Source: https://tailwindflex.com/@anonymous/forgot-password-form-3\n * Attribution: Créé par @anonymous sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function ForgotPasswordForm3() {\n  return (\n    <div>\n    <main id=\"content\" role=\"main\" className=\"w-full  max-w-md mx-auto p-6\">\n        <div className=\"mt-7 bg-white  rounded-xl shadow-lg dark800 dark[#d39430] border-2 border-[#d39430]\">\n          <div className=\"p-4 sm7\">\n            <div className=\"text-center\">\n              <h1 className=\"block text-2xl font-bold text-gray-800 dark\">Esqueceu sua senha?</h1>\n              <p className=\"mt-2 text-sm text-gray-600 dark400\">\n                Lembra da sua senha?\n                <a className=\"text-blue-600 decoration-2 hover font-medium\" href=\"#\">\n                  Faça login aqui\n                </a>\n              </p>\n            </div>\n    \n            <div className=\"mt-5\">\n              <form>\n                <div className=\"grid gap-y-4\">\n                  <div>\n                    <label htmlFor=\"email\" className=\"block text-sm font-bold ml-1 mb-2 dark\">Endereço de email</label>\n                    <div className=\"relative\">\n                      <input type=\"email\" id=\"email\" name=\"email\" className=\"py-3 px-4 block w-full border-2 border-gray-200 rounded-md text-sm focus[#d39430] focus[#d39430] shadow-sm\" required aria-describedby=\"email-error\" />\n                    </div>\n                    <p className=\"hidden text-xs text-red-600 mt-2\" id=\"email-error\">Inclua um endereço de e-mail válido para que possamos entrar em contato com você</p>\n                  </div>\n                  <button type=\"submit\" className=\"py-3 px-4 inline-flex justify-center items-center gap-2 rounded-md border border-transparent font-semibold bg-[#d39430] text-white hover[#b07827] focus focus2 focus[#d39430] focus2 transition-all text-sm dark800\">Redefinir senha</button>\n                </div>\n              </form>\n            </div>\n          </div>\n        </div>\n      </main>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
  ],
