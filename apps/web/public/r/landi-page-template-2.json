\n            <a href=\"#\" class=\"hover:text-black transition\">Design</a>\n            <a href=\"#\" class=\"hover:text-black transition\">Branding</a>\n            <a href=\"#\" class=\"hover:text-black transition\">Development</a>\n            <a href=\"#\" class=\"hover:text-black transition\">Blog</a>\n            <a href=\"#\" class=\"hover:text-black transition\">Contact</a>\n        </div>\n\n        <button class=\"bg-white px-6 py-2 rounded-lg text-sm font-bold shadow-sm hover:shadow-md transition text-gray-800\">\n            Hire us!\n        </button>\n    </nav>\n\n    <main class=\"relative z-10 w-full h-[85vh] flex flex-col justify-center\">\n        \n        <div class=\"container mx-auto px-8 relative h-full\">\n\n            <div class=\"absolute top-1/3 left-0 lg:left-10 max-w-xs text-center lg:text-left\">\n                <h2 class=\"text-5xl lg:text-6xl font-medium tracking-tight mb-2\">\n                    +1 Billion\n                </h2>\n                <p class=\"text-sm lg:text-base text-gray-500 font-medium leading-relaxed\">\n                    Average ROAS On Meta On <br> Ads In Nov 2022\n                </p>\n            </div>\n\n            <div class=\"absolute top-[20%] left-[38%] lg:left-[42%] text-center transform -translate-x-1/2\">\n                <h2 class=\"text-4xl font-medium tracking-tight mb-1\">\n                    34x ROI\n                </h2>\n                <p class=\"text-xs text-gray-600 font-medium w-32 mx-auto leading-tight\">\n                    Average SMS ROI Using Youpo SMS\n                </p>\n            </div>\n\n            <div class=\"absolute bottom-1/4 right-4 lg:right-20 text-center lg:text-right max-w-xs\">\n                <h2 class=\"text-6xl lg:text-7xl font-medium tracking-tight mb-2\">\n                    +142K\n                </h2>\n                <p class=\"text-base lg:text-lg text-gray-800 font-medium leading-tight\">\n                    Average SMS ROI Using <br> Youpo SMS\n                </p>\n            </div>\n\n            <div class=\"absolute bottom-16 left-4 lg:left-10\">\n                <button class=\"bg-white pl-6 pr-4 py-3 rounded-xl shadow-lg flex items-center gap-2 text-sm font-bold hover:-translate-y-1 transition-transform\">\n                    Get in touch \n                    <span class=\"text-lg\">👋</span>\n                </button>\n            </div>\n\n            <div class=\"absolute top-1/2 right-4 lg:right-8 h-24 w-[2px] bg-gray-300 rounded-full hidden md:block\">\n                <div class=\"h-8 w-full bg-white shadow-md rounded-full animate-bounce\"></div>\n            </div>\n\n        </div>\n    </main>\n\n</body>\n</html>"
