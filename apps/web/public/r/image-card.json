      "content": "/**\n * Component: Image card\n * Author: @laurits (https://tailwindflex.com/@laurits)\n * Source: https://tailwindflex.com/@laurits/image-card\n * Attribution: Créé par @laurits sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function ImageCard() {\n  return (\n    <div>\n    <a className=\"p-8 max-w-lg border border-indigo-300 rounded-2xl hover hover50 flex flex-col items-center\"\r\n        href=\"#\">\r\n        <img src=\"https://loremflickr.com/800/600/girl\" className=\"shadow rounded-lg overflow-hidden border\"  />\r\n        <div className=\"mt-8\">\r\n            <h4 className=\"font-bold text-xl\">Exercises</h4>\r\n            <p className=\"mt-2 text-gray-600\">Create Exercises for any subject with the topics you and your students care about.\r\n            </p>\r\n            <div className=\"mt-5\">\r\n                <button type=\"button\" className=\"inline-flex items-center rounded-md border border-transparent bg-gray-800 px-3 py-2 text-sm font-medium leading-4 text-white shadow-sm hover900\">Start Creating</button>\r\n            </div>\r\n        </div>\r\n    </a>\n    </div>\n  );\n}\n",
