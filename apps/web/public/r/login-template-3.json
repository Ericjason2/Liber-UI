      "content": "/**\n * Component: Login Template\n * Author: @ezze191 (https://tailwindflex.com/@ezze191)\n * Source: https://tailwindflex.com/@ezze191/login-template-3\n * Attribution: Créé par @ezze191 sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function LoginTemplate3() {\n  return (\n    <div>\n    <div className=\"min-h-screen flex items-center justify-center\">\r\n      <div className=\"bg-white rounded-3xl shadow-xl flex flex-col md overflow-hidden max-w-screen-xl w-full mx-4 min-h-[600px]\">\r\n        \r\n        \r\n        <div className=\"md1/2 w-full\">\r\n          <img\r\n            src=\"https://media.istockphoto.com/id/1588289977/es/foto/feliz-estudiante-negra-durante-una-clase-en-la-sala-de-conferencias-mirando-a-la-c%C3%A1mara.jpg?s=612x612&w=0&k=20&c=uYsHI--vkn0-X6gkHMTZnJMyR8396cM85GJcnsCdduU=\"\r\n            alt=\"Welcome\"\r\n            className=\"object-cover h-full w-full\"\r\n          />\r\n        </div>\r\n    \r\n        \r\n        <div className=\"md1/2 w-full flex flex-col justify-center p-12 bg-white\">\r\n          <h2 className=\"text-4xl font-extrabold text-blue-600 mb-10 text-center\">Welcome Back</h2>\r\n    \r\n          <form className=\"space-y-6\">\r\n            <div className=\"relative\">\r\n              <img\r\n                src=\"https://cdn-icons-png.flaticon.com/512/561/561127.png\"\r\n                alt=\"Email\"\r\n                className=\"w-5 h-5 absolute left-4 top-1/2 transform -translate-y-1/2 opacity-70\"\r\n              />\r\n              <input\r\n                type=\"email\"\r\n                placeholder=\"Email\"\r\n                className=\"pl-12 pr-4 py-3 w-full rounded-lg bg-gray-100 focus focus2 focus500 text-gray-700 text-base shadow-sm transition duration-200\"\r\n              />\r\n            </div>\r\n    \r\n            <div className=\"relative\">\r\n              <img\r\n                src=\"https://cdn-icons-png.flaticon.com/512/3064/3064155.png\"\r\n                alt=\"Password\"\r\n                className=\"w-5 h-5 absolute left-4 top-1/2 transform -translate-y-1/2 opacity-70\"\r\n              />\r\n              <input\r\n                type=\"password\"\r\n                placeholder=\"Password\"\r\n                className=\"pl-12 pr-4 py-3 w-full rounded-lg bg-gray-100 focus focus2 focus500 text-gray-700 text-base shadow-sm transition duration-200\"\r\n              />\r\n            </div>\r\n    \r\n            <button\r\n              type=\"submit\"\r\n              className=\"w-full py-3 bg-blue-500 text-white font-semibold text-lg rounded-lg hover600 transition duration-300 shadow-md\"\r\n            >\r\n              Log In\r\n            </button>\r\n          </form>\r\n    \r\n          <div className=\"text-center mt-6\">\r\n            <p className=\"text-gray-600 text-sm\">\r\n              Don't have an account?\r\n              <a href=\"#\" className=\"text-blue-600 font-semibold hover ml-1\">Register</a>\r\n            </p>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
