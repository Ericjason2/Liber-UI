\n                    <h3 class=\"font-bold mb-2\">Couleurs</h3>\n                    <ul class=\"space-y-1 text-gray-400\">\n                        <li>Primaires</li>\n                        <li>Secondaires</li>\n                    </ul>\n                </div>\n            </div>\n        </section>\n\n        <section>\n            <div class=\"flex items-center justify-between border-b border-yellow-500/50 pb-2 mb-4\">\n                <h2 class=\"text-sm uppercase tracking-widest text-yellow-500 font-semibold\">Usage digital</h2>\n                <span class=\"text-2xl font-light text-gray-500\">04</span>\n            </div>\n            <div class=\"space-y-4\">\n                <div>\n                    <h3 class=\"font-bold mb-2\">Web</h3>\n                    <ul class=\"space-y-1 text-gray-400\">\n                        <li>Signature mail</li>\n                        <li>Template de présentation</li>\n                    </ul>\n                </div>\n            </div>\n        </section>\n\n        <section>\n            <div class=\"space-y-4\">\n                <h2 class=\"text-sm uppercase tracking-widest text-gray-300 border-b border-gray-800 pb-2 mb-4\">Typographie</h2>\n                <ul class=\"space-y-1 text-gray-400\">\n                    <li class=\"text-white font-medium\">Titres</li>\n                    <li>Textes</li>\n                    <li>Iconographie</li>\n                </ul>\n            </div>\n        </section>\n\n        <section>\n            <div class=\"flex items-center justify-between border-b border-yellow-500/50 pb-2 mb-4\">\n                <h2 class=\"text-sm uppercase tracking-widest text-yellow-500 font-semibold\">Mise en page</h2>\n                <span class=\"text-2xl font-light text-gray-500\">03</span>\n            </div>\n            <div class=\"space-y-2\">\n                <h3 class=\"font-bold\">Grilles</h3>\n                <ul class=\"space-y-1 text-gray-400\">\n                    <li>Marges</li>