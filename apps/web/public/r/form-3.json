th>\n    </svg>\n                </div>\n              </div>\n    \n              <div className=\"col-span-full\">\n                <label htmlFor=\"street-address\" className=\"block text-sm/6 font-medium text-gray-900\">Street address</label>\n                <div className=\"mt-2\">\n                  <input type=\"text\" name=\"street-address\" id=\"street-address\" autoComplete=\"street-address\" className=\"block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder400 focus2 focus2 focus600 sm/6\" />\n                </div>\n              </div>\n    \n              <div className=\"sm2 sm1\">\n                <label htmlFor=\"city\" className=\"block text-sm/6 font-medium text-gray-900\">City</label>\n                <div className=\"mt-2\">\n                  <input type=\"text\" name=\"city\" id=\"city\" autoComplete=\"address-level2\" className=\"block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder400 focus2 focus2 focus600 sm/6\" />\n                </div>\n              </div>\n    \n              <div className=\"sm2\">\n                <label htmlFor=\"region\" className=\"block text-sm/6 font-medium text-gray-900\">State / Province</label>\n                <div className=\"mt-2\">\n                  <input type=\"text\" name=\"region\" id=\"region\" autoComplete=\"address-level1\" className=\"block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder400 focus2 focus2 focus600 sm/6\" />\n                </div>\n              </div>\n    \n              <div className=\"sm2\">\n                <label htmlFor=\"postal-code\" className=\"block text-sm/6 font-medium text-gray-900\">ZIP / Postal code</label>\n                <div className=\"mt-2\">\n                  <input type=\"text\" name=\"postal-code\" id=\"postal-code\" autoComplete=\"postal-code\" className=\"block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder400 focus2 focus2 focus600 sm/6\" />\n                </div>\n              </div>\n            </div>\n          </div>\n    \n          <div className=\"border-b border-gray-900/10 pb-12\">\n            <h2 className=\"text-base/7 font-semibold text-gray-900\">Notifications</h2>\n            <p className=\"mt-1 text-sm/6 text-gray-600\">We'll always let you know about important changes, but you pick what else you want to hear about.</p>\n    \n            <div className=\"mt-10 space-y-10\">\n              <fieldset>\n                <legend className=\"text-sm/6 font-semibold text-gray-900\">By email</legend>\n                <div className=\"mt-6 space-y-6\">\n                  <div className=\"flex gap-3\">\n                    <div className=\"flex h-6 shrink-0 items-center\">\n                      <div className=\"group grid size-4 grid-cols-1\">\n                        <input id=\"comments\" aria-describedby=\"comments-description\" name=\"comments\" type=\"checkbox\" checked=\"\" className=\"col-start-1 row-start-1 appearance-none rounded-sm border border-gray-300 bg-white checked600 checked600 indeterminate600 indeterminate600 focus-visible2 focus-visible2 focus-visible600 disabled300 disabled100 disabled100 forced-colors\" />\n                        <svg className=\"pointer-events-none col-start-1 row-start-1 size-3.5 self-center justify-self-center stroke-white group-has-disabled950/25\" viewBox=\"0 0 14 14\" fill=\"none\">\n                          <path className=\"opacity-0 group-has-checked100\" d=\"M3 8L6 11L11 3.5\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\"></path>\n                          <path className=\"opacity-0 group-has-indeterminate100\" d=\"M3 7H11\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\"></path>\n                        </svg>\n                      </div>\n                    </div>\n                    <div className=\"text-sm/6\">\n                      <label htmlFor=\"comments\" className=\"font-medium text-gray-900\">Comments</label>\n                      <p id=\"comments-description\" className=\"text-gray-500\">Get notified when someones posts a comment on a posting.</p>\n                    </div>\n                  </div>\n                  <div className=\"flex gap-3\">\n                    <div className=\"flex h-6 shrink-0 items-center\">\n                      <div className=\"group grid size-4 grid-cols-1\">\n                        <input id=\"candidates\" aria-describedby=\"candidates-description\" name=\"candidates\" type=\"checkbox\" className=\"col-start-1 row-start-1 appearance-none rounded-sm border border-gray-300 bg-white checked600 checked600 indeterminate600 indeterminate600 focus-visible2 focus-visible2 focus-visible600 disabled300 disabled100 disabled100 forced-colors\" />\n                        <svg className=\"pointer-events-none col-start-1 row-start-1 size-3.5 self-center justify-self-center stroke-white group-has-disabled950/25\" viewBox=\"0 0 14 14\" fill=\"none\">\n                          <path className=\"opacity-0 group-has-checked100\" d=\"M3 8L6 11L11 3.5\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\"></path>\n                          <path className=\"opacity-0 group-has-indeterminate100\" d=\"M3 7H11\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\"></path>\n                        </svg>\n                      </div>\n                    </div>\n                    <div className=\"text-sm/6\">\n                      <label htmlFor=\"candidates\" className=\"font-medium text-gray-900\">Candidates</label>\n                      <p id=\"candidates-description\" className=\"text-gray-500\">Get notified when a candidate applies for a job.</p>\n                    </div>\n                  </div>\n                  <div className=\"flex gap-3\">\n                    <div className=\"flex h-6 shrink-0 items-center\">\n                      <div className=\"group grid size-4 grid-cols-1\">\n                        <input id=\"offers\" aria-describedby=\"offers-description\" name=\"offers\" type=\"checkbox\" className=\"col-start-1 row-start-1 appearance-none rounded-sm border border-gray-300 bg-white checked600 checked600 indeterminate600 indeterminate600 focus-visible2 focus-visible2 focus-visible600 disabled300 disabled100 disabled100 forced-colors\" />\n                        <svg className=\"pointer-events-none col-start-1 row-start-1 size-3.5 self-center justify-self-center stroke-white group-has-disabled950/25\" viewBox=\"0 0 14 14\" fill=\"none\">\n                          <path className=\"opacity-0 group-has-checked100\" d=\"M3 8L6 11L11 3.5\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\"></path>\n                          <path className=\"opacity-0 group-has-indeterminate100\" d=\"M3 7H11\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\"></path>\n                        </svg>\n                      </div>\n                    </div>\n                    <div className=\"text-sm/6\">\n                      <label htmlFor=\"offers\" className=\"font-medium text-gray-900\">Offers</label>\n                      <p id=\"offers-description\" className=\"text-gray-500\">Get notified when a candidate accepts or rejects an offer.</p>\n                    </div>\n                  </div>\n                </div>\n              </fieldset>\n    \n              <fieldset>\n                <legend className=\"text-sm/6 font-semibold text-gray-900\">Push notifications</legend>\n                <p className=\"mt-1 text-sm/6 text-gray-600\">These are delivered via SMS to your mobile phone.</p>\n                <div className=\"mt-6 space-y-6\">\n                  <div className=\"flex items-center gap-x-3\">\n                    <input id=\"push-everything\" name=\"push-notifications\" type=\"radio\" checked=\"\" className=\"relative size-4 appearance-none rounded-full border border-gray-300 bg-white before before1 before before not-checked checked600 checked600 focus-visible2 focus-visible2 focus-visible600 disabled300 disabled100 disabled400 forced-colors forced-colors\" />\n                    <label htmlFor=\"push-everything\" className=\"block text-sm/6 font-medium text-gray-900\">Everything</label>\n                  </div>\n                  <div className=\"flex items-center gap-x-3\">\n                    <input id=\"push-email\" name=\"push-notifications\" type=\"radio\" className=\"relative size-4 appearance-none rounded-full border border-gray-300 bg-white before before1 before before not-checked checked600 checked600 focus-visible2 focus-visible2 focus-visible600 disabled300 disabled100 disabled400 forced-colors forced-colors\" />\n                    <label htmlFor=\"push-email\" className=\"block text-sm/6 font-medium text-gray-900\">Same as email</label>\n                  </div>\n                  <div className=\"flex items-center gap-x-3\">\n                    <input id=\"push-nothing\" name=\"push-notifications\" type=\"radio\" className=\"relative size-4 appearance-none rounded-full border border-gray-300 bg-white before before1 before before not-checked checked600 checked600 focus-visible2 focus-visible2 focus-visible600 disabled300 disabled100 disabled400 forced-colors forced-colors\" />\n                    <label htmlFor=\"push-nothing\" className=\"block text-sm/6 font-medium text-gray-900\">No push notifications</label>\n                  </div>\n                </div>\n              </fieldset>\n            </div>\n          </div>\n        </div>\n    \n        <div className=\"mt-6 flex items-center justify-end gap-x-6\">\n          <button type=\"button\" className=\"text-sm/6 font-semibold text-gray-900\">Cancel</button>\n          <button type=\"submit\" className=\"rounded