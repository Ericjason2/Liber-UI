us600 sm/6\"></textarea>\n                </div>\n                <p className=\"mt-3 text-sm/6 text-gray-600\">Write a few sentences about yourself.</p>\n              </div>\n    \n              <div className=\"col-span-full\">\n                <label htmlFor=\"photo\" className=\"block text-sm/6 font-medium text-gray-900\">Photo</label>\n                <div className=\"mt-2 flex items-center gap-x-3\">\n                  <svg className=\"size-12 text-gray-300\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\" data-slot=\"icon\">\n      <path fillRule=\"evenodd\" d=\"M18.685 19.097A9.723 9.723 0 0 0 21.75 12c0-5.385-4.365-9.75-9.75-9.75S2.25 6.615 2.25 12a9.723 9.723 0 0 0 3.065 7.097A9.716 9.716 0 0 0 12 21.75a9.716 9.716 0 0 0 6.685-2.653Zm-12.54-1.285A7.486 7.486 0 0 1 12 15a7.486 7.486 0 0 1 5.855 2.812A8.224 8.224 0 0 1 12 20.25a8.224 8.224 0 0 1-5.855-2.438ZM15.75 9a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z\" clipRule=\"evenodd\"></path>\n    </svg>\n                  <button type=\"button\" className=\"rounded-md bg-white px-2.5 py-1.5 text-sm font-semibold text-gray-900 ring-1 shadow-xs ring-gray-300 ring-inset hover50\">Change</button>\n                </div>\n              </div>\n    \n              <div className=\"col-span-full\">\n                <label htmlFor=\"cover-photo\" className=\"block text-sm/6 font-medium text-gray-900\">Cover photo</label>\n                <div className=\"mt-2 flex justify-center rounded-lg border border-dashed border-gray-900/25 px-6 py-10\">\n                  <div className=\"text-center\">\n                    <svg className=\"mx-auto size-12 text-gray-300\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\" data-slot=\"icon\">\n      <path fillRule=\"evenodd\" d=\"M1.5 6a2.25 2.25 0 0 1 2.25-2.25h16.5A2.25 2.25 0 0 1 22.5 6v12a2.25 2.25 0 0 1-2.25 2.25H3.75A2.25 2.25 0 0 1 1.5 18V6ZM3 16.06V18c0 .414.336.75.75.75h16.5A.75.75 0 0 0 21 18v-1.94l-2.69-2.689a1.5 1.5 0 0 0-2.12 0l-.88.8