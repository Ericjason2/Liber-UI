ame=\"h-[420px] md:h-[520px] relative\">\n              <div className=\"absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-indigo-800 via-slate-900 to-slate-950\"></div>\n              <div className=\"absolute inset-0 opacity-20 bg-[linear-gradient(90deg,transparent_24px,rgba(255,255,255,.07)_25px),linear-gradient(transparent_24px,rgba(255,255,255,.07)_25px)] bg-[size:25px_25px]\"></div>\n      \n              \n              <div className=\"absolute inset-0 grid place-content-center text-center px-6\">\n                <h2 className=\"text-2xl md:text-3xl font-bold\">Welcome to Crystal Plains</h2>\n                <p className=\"mt-2 text-slate-300 max-w-md\">Move, explore, and collect shards to unlock the portal. This is a placeholder scene for your game canvas.</p>\n                <div className=\"mt-5 flex items-center justify-center gap-3\">\n                  <button className=\"rounded-xl bg-indigo-600 px-4 py-2 text-sm font-semibold hover:bg-indigo-500\">Start</button>\n                  <button className=\"rounded-xl border border-slate-700 px-4 py-2 text-sm hover:border-indigo-500/50\">Tutorial</button>\n                </div>\n              </div>\n            </div>\n      \n            \n            <div className=\"border-t border-slate-800 bg-slate-900/70 px-4 py-3 flex items-center justify-between\">\n              <div className=\"flex items-center gap-2 text-xs text-slate-400\">\n                <span className=\"rounded-lg border border-slate-800 px-2 py-1\">W</span>\n                <span className=\"rounded-lg border border-slate-800 px-2 py-1\">A</span>\n                <span className=\"rounded-lg border border-slate-800 px-2 py-1\">S</span>\n                <span className=\"rounded-lg border border-slate-800 px-2 py-1\">D</span>\n                <span className=\"ml-2\">Move</span>\n              </div>\n              <div className=\"flex items-center gap-2\">\n                <button className=\"rounded-xl bg-emerald-600 px-3 py-2 text-xs font-semibold hover:bg-emerald-500\">Interact (E)</button>\n                <button className=\"rounded-xl bg-rose-600 px-3 py-2 text-xs font-semibold hover:bg-rose-500\">Attack (Q)</button>\n              </div>\n            </div>\n          </section>\n      \n          \n          <aside className=\"md:col-span-3 space-y-6\">\n            \n            <section className=\"rounded-2xl border border-slate-800 bg-slate-900/60 p-4\">\n              <div className=\"flex items-center justify-between\">\n                <h3 className=\"font-semibold\">Party</h3>\n                <button className=\"text-xs rounded-lg border border-slate-800 px-2 py-1 hover:border-indigo-500/50\">Invite</button>\n              </div>\n              <ul className=\"mt-3 space-y-2 text-sm\">\n                <li className=\"flex items-center justify-between rounded-xl border border-slate-800 bg-slate-900/40 px-3 py-2\">\n                  <span>❖ Nova</span><span className=\"text-emerald-400\">Online</span>\n                </li>\n                <li className=\"flex items-center justify-between rounded-xl border border-slate-800 bg-slate-900/40 px-3 py-2\">\n                  <span>❖ Kiro</span><span className=\"text-yellow-300\">Idle</span>\n                </li>\n                <li className=\"flex items-center justify-between rounded-xl border border-slate-800 bg-slate-900/40 px-3 py-2\">\n                  <span>❖ Sera</span><span className=\"text-slate-400\">Offline</span>\n                </li>\n              </ul>\n            </section>\n      \n            \n            <section className=\"rounded-2xl border border-slate-800 bg-slate-900/60 p-4\">\n              <h3 className=\"font-semibold\">Chat</h3>\n              <div className=\"mt-3 h-44 overflow-y-auto rounded-xl border border-slate-800 bg-slate-950/40 p-3 text-sm space-y-2\">\n                <p><span className=\"text-indigo-300\">Nova:</span> Meet at the portal ruins.</p>\n    