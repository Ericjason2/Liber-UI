t-indigo-300\\\">Crystal Plains</span>\\n        </div>\\n        <div class=\\\"rounded-xl bg-black/40 backdrop-blur px-3 py-2 text-xs\\\">\\n          Quest: <span class=\\\"text-emerald-300\\\">Find the Shard</span>\\n        </div>\\n      </div>\\n\\n      <!-- “Game world” placeholder -->\\n      <div class=\\\"h-[420px] md:h-[520px] relative\\\">\\n        <div class=\\\"absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-indigo-800 via-slate-900 to-slate-950\\\"></div>\\n        <div class=\\\"absolute inset-0 opacity-20 bg-[linear-gradient(90deg,transparent_24px,rgba(255,255,255,.07)_25px),linear-gradient(transparent_24px,rgba(255,255,255,.07)_25px)] bg-[size:25px_25px]\\\"></div>\\n\\n        <!-- Center prompt -->\\n        <div class=\\\"absolute inset-0 grid place-content-center text-center px-6\\\">\\n          <h2 class=\\\"text-2xl md:text-3xl font-bold\\\">Welcome to Crystal Plains</h2>\\n          <p class=\\\"mt-2 text-slate-300 max-w-md\\\">Move, explore, and collect shards to unlock the portal. This is a placeholder scene for your game canvas.</p>\\n          <div class=\\\"mt-5 flex items-center justify-center gap-3\\\">\\n            <button class=\\\"rounded-xl bg-indigo-600 px-4 py-2 text-sm font-semibold hover:bg-indigo-500\\\">Start</button>\\n            <button class=\\\"rounded-xl border border-slate-700 px-4 py-2 text-sm hover:border-indigo-500/50\\\">Tutorial</button>\\n          </div>\\n        </div>\\n      </div>\\n\\n      <!-- Footer controls inside center card -->\\n      <div class=\\\"border-t border-slate-800 bg-slate-900/70 px-4 py-3 flex items-center justify-between\\\">\\n        <div class=\\\"flex items-center gap-2 text-xs text-slate-400\\\">\\n          <span class=\\\"rounded-lg border border-slate-800 px-2 py-1\\\">W</span>\\n          <span class=\\\"rounded-lg border border-slate-800 px-2 py-1\\\">A</span>\\n          <span class=\\\"rounded-lg border border-slate-800 px-2 py-1\\\">S</span>\\n          <span class=\\\"rounded-lg border border-slate-800 px-2 py-1\\\">D</span>\\n          <span class=\\\"ml-2\\\">Move</span>\\n        </div>\\n        <div class=\\\"flex items-center gap-2\\\">\\n          <button class=\\\"rounded-xl bg-emerald-600 px-3 py-2 text-xs font-semibold hover:bg-emerald-500\\\">Interact (E)</button>\\n          <button class=\\\"rounded-xl bg-rose-600 px-3 py-2 text-xs font-semibold hover:bg-rose-500\\\">Attack (Q)</button>\\n        </div>\\n      </div>\\n    </section>\\n\\n    <!-- Right Sidebar: Chat / Party -->\\n    <aside class=\\\"md:col-span-3 space-y-6\\\">\\n      <!-- Party -->\\n      <section class=\\\"rounded-2xl border border-slate-800 bg-slate-900/60 p-4\\\">\\n        <div class=\\\"flex items-center justify-between\\\">\\n          <h3 class=\\\"font-semibold\\\">Party</h3>\\n          <button class=\\\"text-xs rounded-lg border border-slate-800 px-2 py-1 hover:border-indigo-500/50\\\">Invite</button>\\n        </div>\\n        <ul class=\\\"mt-3 space-y-2 text-sm\\\">\\n          <li class=\\\"flex items-center justify-between rounded-xl border border-slate-800 bg-slate-900/40 px-3 py-2\\\">\\n            <span>❖ Nova</span><span class=\\\"text-emerald-400\\\">Online</span>\\n          </li>\\n          <li class=\\\"flex items-center justify-between rounded-xl border border-slate-800 bg-slate-900/40 px-3 py-2\\\">\\n            <span>❖ Kiro</span><span class=\\\"text-yellow-300\\\">Idle</span>\\n          </li>\\n          <li class=\\\"flex items-center justify-between rounded-xl border border-slate-800 bg-slate-900/40 px-3 py-2\\\">\\n            <span>❖ Sera</span><span class=\\\"text-slate-400\\\">Offline</span>\\n          </li>\\n        </ul>\\n      </section>\\n\\n      <!-- Chat -->\\n      <section class=\\\"rounded-2xl border border-slate-800 bg-slate-900/60 p-4\\\">\\n        <h3 class=\\\"font-semibold\\\">Chat</h3>\\n        <div class=\\\"mt-3 h-44 overflow-y-auto rounded-xl border border-slate-800 bg-slate-950/40 p-3 text-sm space-y-2\\\">\\n          <p><span class=\\\"text-indigo-300\\\">Nova:</span> Meet at the portal ruins.</p>\\n          <p><span class=\\\"text-emerald-300\\\">You:</span> On my way! Grabbing shards.</p>\\n          <p><span class=\\\"text-fuchsia-300\\\">Kiro:</span> Watch the east ridge—wolves.</p>\\n        </div>\\n        <div class=\\\"mt-3 flex items-center gap-2\\\">\\n          <input type=\\\"text\\\" placeholder=\\\"Type a message...\\\" class=\\\"w-full rounded-xl border border-slate-800 bg-slate-950 px-3 py-2 text-sm placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/40\\\" />\\n          <button class=\\\"rounded-xl bg-indigo-600 px-3 py-2 text-sm font-semibold hover:bg-indigo-500\\\">Send</button>\\n        </div>\\n      </section>\\n    </aside>\\n\\n  </main>\\n\\n  <!-- Bottom Action Bar -->\\n  <footer class=\\\"sticky bottom-0 z-40 border-t border-slate-800 bg-slate-950/80 backdrop-blur\\\">\\n    <div class=\\\"mx-auto max-w-7xl px-4 py-3 flex items-center justify-between\\\">\\n      <div class=\\\"flex items-center gap-2 text-xs text-slate-400\\\">\\n        <span class=\\\"rounded-lg border border-slate-800 px-2 py-1\\\">1</span>\\n        <span class=\\\"rounded-lg border border-slate-800 px-2 py-1\\\">2</span>\\n        <span class=\\\"rounded-lg border border-slate-800 px-2 py-1\\\">3</span>\\n        <span class=\\\"rounded-lg border border-slate-800 px-2 py-1\\\">4</span>\\n        <span class=\\\"ml-2\\\">Quick Slots</span>\\n      </div>\\n      <div class=\\\"flex items-center gap-2\\\">\\n        <button class=\\\"rounded-xl border border-slate-800 px-3 py-2 text-xs hover:border-indigo-500/50\\\">Bag (B)</button>\\n        <button class=\\\"rounded-xl border border-slate-800 px-3 py-2 text-xs hover:border-indigo-500/50\\\">Map (M)</button>\\n        <button class=\\\"rounded-xl bg-indigo-600 px-3 py-2 text-xs font-semibold hover:bg-indigo-500\\\">Pause</button>\\n      </div>\\n    </div>\\n  </footer>\\n\\n</body>\\n</html>\" }} />\n  );\n}\n",
