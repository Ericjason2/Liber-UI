    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <title>Virtual Game UI</title>\n</head>\n<body class=\"min-h-screen bg-slate-950 text-slate-100 selection:bg-indigo-400/30\">\n\n  <!-- Header / Top Bar -->\n  <header class=\"sticky top-0 z-40 border-b border-slate-800 bg-slate-950/70 backdrop-blur\">\n    <div class=\"mx-auto max-w-7xl px-4 py-3 flex items-center justify-between\">\n      <div class=\"flex items-center gap-3\">\n        <div class=\"h-9 w-9 rounded-xl bg-gradient-to-br from-indigo-500 to-fuchsia-500 grid place-content-center font-black\">VG</div>\n        <h1 class=\"text-lg md:text-xl font-bold tracking-wide\">Virtual Game</h1>\n      </div>\n      <nav class=\"hidden md:flex items-center gap-6 text-sm\">\n        <a href=\"#\" class=\"hover:text-indigo-300\">Home</a>\n        <a href=\"#\" class=\"hover:text-indigo-300\">Inventory</a>\n        <a href=\"#\" class=\"hover:text-indigo-300\">Map</a>\n        <a href=\"#\" class=\"hover:text-indigo-300\">Settings</a>\n      </nav>\n      <button class=\"md:hidden rounded-lg border border-slate-800 px-3 py-1 text-sm hover:border-indigo-500/50\">Menu</button>\n    </div>\n  </header>\n\n  <!-- Main Layout -->\n  <main class=\"mx-auto max-w-7xl px-4 py-6 grid gap-6 md:grid-cols-12\">\n\n    <!-- Left Sidebar: Player & Inventory -->\n    <aside class=\"md:col-span-3 space-y-6\">\n      <!-- Player Card -->\n      <section class=\"rounded-2xl border border-slate-800 bg-slate-900/60 p-4\">\n        <div class=\"flex items-center gap-3\">\n          <img src=\"https://picsum.photos/seed/hero/80/80\" alt=\"Avatar\" class=\"h-14 w-14 rounded-xl object-cover ring-2 ring-slate-800\" />\n          <div>\n            <h2 class=\"font-semibold\">Ari the Voyager</h2>\n            <p class=\"text-xs text-slate-400\">Level 12 • Explorer</p>\n          </div>\n        </div>\n\n        <!-- Bars -->\n        <div class=\"mt-4 space-y-2\">\n          <div class=\"text-xs text-slate-400\">Health</div>\n          <div class=\"h-3 w-full rounded-full bg-slate-800 overflow-hidden\">\n            <div class=\"h-full w-4/5 bg-gradient-to-r from-rose-500 to-red-500\"></div>\n          </div>\n          <div class=\"text-xs text-slate-400 mt-3\">Energy</div>\n          <div class=\"h-3 w-full rounded-full bg-slate-800 overflow-hidden\">\n            <div class=\"h-full w-2/3 bg-gradient-to-r from-emerald-500 to-teal-500\"></div>\n          </div>\n        </div>\n\n        <!-- Stats -->\n        <div class=\"mt-4 grid grid-cols-3 gap-3 text-center text-sm\">\n          <div class=\"rounded-xl border border-slate-800 bg-slate-900/40 p-2\">\n            <div class=\"text-xs text-slate-400\">ATK</div>\n            <div class=\"font-semibold\">42</div>\n          </div>\n          <div class=\"rounded-xl border border-slate-800 bg-slate-900/40 p-2\">\n            <div class=\"text-xs text-slate-400\">DEF</div>\n            <div class=\"font-semibold\">36</div>\n          </div>\n          <div class=\"rounded-xl border border-slate-800 bg-slate-900/40 p-2\">\n            <div class=\"text-xs text-slate-400\">SPD</div>\n            <div class=\"font-semibold\">28</div>\n          </div>\n        </div>\n      </section>\n\n      <!-- Inventory -->\n      <section class=\"rounded-2xl border border-slate-800 bg-slate-900/60 p-4\">\n        <div class=\"flex items-center justify-between\">\n          <h3 class=\"font-semibold\">Inventory</h3>\n          <span class=\"text-xs text-slate-400\">12/24</span>\n        </div>\n        <div class=\"mt-3 grid grid-cols-4 gap-3\">\n          <!-- Item cells -->\n          <div class=\"aspect-square rounded-xl border border-slate-800 bg-slate-900/40 grid place-content-center text-xs\">⚔️</div>\n          <div class=\"aspect-square rounded-xl border border-slate-800 bg-slate-900/40 grid place-content-center text-xs\">🛡️</div>\n          <div class=\"aspect-square rounded-xl border border-slate-800 bg-slate-900/40 grid place-content-center text-xs\">💊</div>\n          <div class=\"aspect-square rounded-xl border border-slate-800 bg-slate-900/40 grid place-content-center text-xs\">🧭</div>\n          <div class=\"aspect-square rounded-xl border border-slate-800 bg-slate-900/40 grid place-content-center text-xs\">🧪</div>\n          <div class=\"aspect-square rounded-xl border border-slate-800 bg-slate-900/40 grid place-content-center text-xs\">🪙</div>\n          <div class=\"aspect-square rounded-xl border border-slate-800 bg-slate-900/40 grid place-content-center text-xs\">📜</div>\n          <div class=\"aspect-square rounded-xl border border-slate-800 bg-slate-900/40 grid place-content-center text-xs\">🗝️</div>\n        </div>\n      </section>\n    </aside>\n\n    <!-- Center: Game Area -->\n    <section class=\"md:col-span-6 rounded-2xl border border-slate-800 bg-slate-900/60 overflow-hidden relative\">\n      <!-- HUD overlay -->\n      <div class=\"absolute left-4 top-4 z-10 flex items-center gap-3\">\n        <div class=\"rounded-xl bg-black/40 backdrop-blur px-3 py-2 text-xs\">\n          Zone: <span class=\"text-indigo-300\">Crystal Plains</span>\n        </div>\n        <div class=\"rounded-xl bg-black/40 backdrop-blur px-3 py-2 text-xs\">\n          Quest: <span class=\"text-emerald-300\">Find the Shard</span>\n        </div>\n      </div>\n\n      <!-- “Game world” placeholder -->\n      <div class=\"h-[420px] md:h-[520px] relative\">\n        <div class=\"absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-indigo-800 via-slate-900 to-slate-950\"></div>\n        <div class=\"absolute inset-0 opacity-20 bg-[linear-gradient(90deg,transparent_24px,rgba(255,255,255,.07)_25px),linear-gradient(transparent_24px,rgba(255,255,255,.07)_25px)] bg-[size:25px_25px]\"></div>\n\n        <!-- Center prompt -->\n     