t-xs rounded-lg border border-slate-800 px-2 py-1 hover:border-indigo-500/50\">Invite</button>\n        </div>\n        <ul class=\"mt-3 space-y-2 text-sm\">\n          <li class=\"flex items-center justify-between rounded-xl border border-slate-800 bg-slate-900/40 px-3 py-2\">\n            <span>❖ Nova</span><span class=\"text-emerald-400\">Online</span>\n          </li>\n          <li class=\"flex items-center justify-between rounded-xl border border-slate-800 bg-slate-900/40 px-3 py-2\">\n            <span>❖ Kiro</span><span class=\"text-yellow-300\">Idle</span>\n          </li>\n          <li class=\"flex items-center justify-between rounded-xl border border-slate-800 bg-slate-900/40 px-3 py-2\">\n            <span>❖ Sera</span><span class=\"text-slate-400\">Offline</span>\n          </li>\n        </ul>\n      </section>\n\n      <!-- Chat -->\n      <section class=\"rounded-2xl border border-slate-800 bg-slate-900/60 p-4\">\n        <h3 class=\"font-semibold\">Chat</h3>\n        <div class=\"mt-3 h-44 overflow-y-auto rounded-xl border border-slate-800 bg-slate-950/40 p-3 text-sm space-y-2\">\n          <p><span class=\"text-indigo-300\">Nova:</span> Meet at the portal ruins.</p>\n          <p><span class=\"text-emerald-300\">You:</span> On my way! Grabbing shards.</p>\n          <p><span class=\"text-fuchsia-300\">Kiro:</span> Watch the east ridge—wolves.</p>\n        </div>\n        <div class=\"mt-3 flex items-center gap-2\">\n          <input type=\"text\" placeholder=\"Type a message...\" class=\"w-full rounded-xl border border-slate-800 bg-slate-950 px-3 py-2 text-sm placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/40\" />\n          <button class=\"rounded-xl bg-indigo-600 px-3 py-2 text-sm font-semibold hover:bg-indigo-500\">Send</button>\n        </div>\n      </section>\n    </aside>\n\n  </main>\n\n  <!-- Bottom Action Bar -->\n  <footer class=\"sticky bottom-0 z-40 border-t border-slate-800 bg-slate-950/80 backdrop-blur\">\n    <div class=\"mx-auto max-w-7xl px-4 py-3 flex items-center justify-between\">\n      <div class=\"flex items-center gap-2 text-xs text-slate-400\">\n        <span class=\"rounded-lg border border-slate-800 px-2 py-1\">1</span>\n        <span class=\"rounded-lg border border-slate-800 px-2 py-1\">2</span>\n        <span class=\"rounded-lg border border-slate-800 px-2 py-1\">3</span>\n        <span class=\"rounded-lg border border-slate-800 px-2 py-1\">4</span>\n        <span class=\"ml-2\">Quick Slots</span>\n      </div>\n      <div class=\"flex items-center gap-2\">\n        <button class=\"rounded-xl border border-slate-800 px-3 py-2 text-xs hover:border-indigo-500/50\">Bag (B)</button>\n        <button class=\"rounded-xl border border-slate-800 px-3 py-2 text-xs hover:border-indigo-500/50\">Map (M)</button>\n        <button class=\"rounded-xl bg-indigo-600 px-3 py-2 text-xs font-semibold hover:bg-indigo-500\">Pause</button>\n      </div>\n    </div>\n  </footer>\n\n</body>\n</html>"
