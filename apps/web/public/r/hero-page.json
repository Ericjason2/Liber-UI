gray-500\\\" viewBox=\\\"0 0 20 20\\\" fill=\\\"currentColor\\\">\\n                            <path fill-rule=\\\"evenodd\\\" d=\\\"M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z\\\" clip-rule=\\\"evenodd\\\" />\\n                        </svg>\\n                        Watch demo\\n                    </button>\\n                </div>\\n                \\n                <div class=\\\"flex items-center pt-8 space-x-4\\\">\\n                    <div class=\\\"flex -space-x-2\\\">\\n                        <img class=\\\"w-10 h-10 rounded-full border-2 border-white\\\" src=\\\"https://randomuser.me/api/portraits/women/12.jpg\\\" alt=\\\"User\\\">\\n                        <img class=\\\"w-10 h-10 rounded-full border-2 border-white\\\" src=\\\"https://randomuser.me/api/portraits/men/32.jpg\\\" alt=\\\"User\\\">\\n                        <img class=\\\"w-10 h-10 rounded-full border-2 border-white\\\" src=\\\"https://randomuser.me/api/portraits/women/45.jpg\\\" alt=\\\"User\\\">\\n                        <img class=\\\"w-10 h-10 rounded-full border-2 border-white\\\" src=\\\"https://randomuser.me/api/portraits/men/76.jpg\\\" alt=\\\"User\\\">\\n                    </div>\\n                    <div class=\\\"text-sm text-gray-500\\\">\\n                        <span class=\\\"font-medium text-gray-700\\\">10,000+</span> businesses trust us worldwide\\n                    </div>\\n                </div>\\n            </div>\\n            \\n            <div class=\\\"relative\\\">\\n                <div class=\\\"relative aspect-square w-full h-auto rounded-3xl overflow-hidden shadow-2xl bg-white border border-gray-100\\\">\\n                    <div class=\\\"absolute inset-0 bg-gradient-to-br from-primary-light/10 to-secondary-light/10\\\"></div>\\n                    <div class=\\\"absolute inset-4 rounded-2xl bg-white/80 backdrop-blur-sm border border-gray-100 shadow-sm p-6 flex flex-col\\\">\\n                        <div class=\\\"flex items-center space-x-3\\\">\\n                            <div class=\\\"w-3 h-3 rounded-full bg-red-500\\\"></div>\\n                            <div class=\\\"w-3 h-3 rounded-full bg-yellow-500\\\"></div>\\n                            <div class=\\\"w-3 h-3 rounded-full bg-green-500\\\"></div>\\n                            <div class=\\\"flex-1 h-4 rounded bg-gray-100\\\"></div>\\n                        </div>\\n                        \\n                        <div class=\\\"mt-6 grid grid-cols-3 gap-4\\\">\\n                            <div class=\\\"col-span-2 h-8 rounded-lg bg-primary-dark/5\\\"></div>\\n                            <div class=\\\"h-8 rounded-lg bg-primary-dark/10\\\"></div>\\n                            <div class=\\\"h-32 rounded-lg bg-gradient-to-br from-primary-light/20 to-primary-dark/20\\\"></div>\\n                            <div class=\\\"h-32 rounded-lg bg-gray-100\\\"></div>\\n                            <div class=\\\"h-32 rounded-lg bg-gradient-to-br from-secondary-light/20 to-secondary-dark/20\\\"></div>\\n                        </div>\\n                        \\n                        <div class=\\\"mt-6 flex-1 rounded-lg bg-gradient-to-br from-gray-50 to-gray-100 border border-gray-200 p-4\\\">\\n                            <div class=\\\"h-4 w-1/2 rounded bg-gray-200 mb-3\\\"></div>\\n                            <div class=\\\"h-3 w-3/4 rounded bg-gray-200/80 mb-2\\\"></div>\\n                            <div class=\\\"h-3 w-2/3 rounded bg-gray-200/80\\\"></div>\\n                        </div>\\n                    </div>\\n                </div>\\n                \\n                <div class=\\\"absolute -bottom-6 -left-6 w-32 h-32 rounded-2xl bg-secondary-dark/10 backdrop-blur-sm border border-secondary-light/20 shadow-lg\\\"></div>\\n                <div class=\\\"absolute -top-6 -right-6 w-40 h-40 rounded-2xl bg-primary-dark/10 backdrop-blur-sm border border-primary-light/20 shadow-lg\\\"></div>\\n            </div>\\n        </div>\\n    </section>\\n\\n    <!-- Trust badges -->\\n    <div class=\\\"relative z-20 py-12 px-6 md:px-12 lg:px-24 bg-white/50 backdrop-blur-sm border-t border-gray-100\\\">\\n        <div class=\\\"max-w-7xl mx-auto\\\">\\n            <p class=\\\"text-center text-sm uppercase tracking-wider text-gray-500 font-medium mb-8\\\">Trusted by industry leaders</p>\\n            <div class=\\\"grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-8 items-center justify-center\\\">\\n                <div class=\\\"flex justify-center\\\">\\n                    <svg class=\\\"h-8 text-gray-400\\\" fill=\\\"currentColor\\\" viewBox=\\\"0 0 100 30\\\"><path d=\\\"M...\\\"/></svg>\\n                </div>\\n                <div class=\\\"flex justify-center\\\">\\n                    <svg class=\\\"h-10 text-gray-400\\\" fill=\\\"currentColor\\\" viewBox=\\\"0 0 100 30\\\"><path d=\\\"M...\\\"/></svg>\\n                </div>\\n                <div class=\\\"flex justify-center\\\">\\n                    <svg class=\\\"h-6 text-gray-400\\\" fill=\\\"currentColor\\\" viewBox=\\\"0 0 100 30\\\"><path d=\\\"M...\\\"/></svg>\\n                </div>\\n                <div class=\\\"flex justify-center\\\">\\n                    <svg class=\\\"h-8 text-gray-400\\\" fill=\\\"currentColor\\\" viewBox=\\\"0 0 100 30\\\"><path d=\\\"M...\\\"/></svg>\\n                </div>\\n                <div class=\\\"flex justify-center\\\">\\n                    <svg class=\\\"h-7 text-gray-400\\\" fill=\\\"currentColor\\\" viewBox=\\\"0 0 100 30\\\"><path d=\\\"M...\\\"/></svg>\\n                </div>\\n                <div class=\\\"flex justify-center\\\">\\n                    <svg class=\\\"h-9 text-gray-400\\\" fill=\\\"currentColor\\\" viewBox=\\\"0 0 100 30\\\"><path d=\\\"M...\\\"/></svg>\\n                </div>\\n            </div>\\n        </div>\\n    </div>\\n</body>\\n</html>\" }} />\n  );\n}\n",
