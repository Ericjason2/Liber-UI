    "rawHtml": "<div class=\"bg-white font-sans font-light text-black w-screen\">\n  <div class=\"bg-indigo-950 text-white text-sm\">\n    <div class=\"w-full mx-auto xl:mx-auto max-w-7xl flex xl:gap-4 justify-between relative [&:has(>details[open])]:min-h-screen xl:[&:has(>details[open])]:min-h-px\">\n      <details open aria-expanded=\"true\" id=\"nav1\" class=\"group peer relative bg-inherit open:min-h-screen inline-block open:w-full open:absolute open:top:100 open:left:0 xl:open:static xl:open:min-h-px\">\n        <summary class=\"flex xl:inline xl:hidden relative group-open:bg-indigo-950\">\n          <span class=\"block px-3 py-3 flex items-center gap-2 w-full  xl:hidden\">Company Navigation          \n            <span class=\"xl:hidden transition-transform duration-200 group-open:rotate-[-180deg] top-50 w-0 h-0 border-solid border-b-0 border-x-[5px] border-t-[6px] border-l-transparent border-r-transparent border-b-transparent border-t-sky-400\">\n            </span>\n          </span>\n        </summary>\n        <div class=\"w-full bg-indigo-950\">\n          <ul class=\"bg-inherit divide-y divide-white/50 divide-solid xl:divide-none xl:flex xl-space-x-4 w-full xl:justify-end xl:mx-4\">\n            <li class=\"\">\n              <a href=\"#\"  class=\"block px-5 py-3\">\n                First Link\n              </a>\n            </li>\n            <li class=\"relative\">\n              <details class=\"group/subnav\">\n                <summary class=\"flex px-5 py-3 flex items-center flex place-content-between w-full gap-2 relative\">\n                  Second Link              \n                    <span class=\"xl-hidden transition-transform duration-200 group-open/subnav:rotate-[-180deg] top-50 w-0 h-0 border-solid border-b-0 border-x-[5px] border-t-[6px] border-l-transparent border-r-transparent border-b-transparent border-t-sky-400\">\n                    </span>\n                </summary>\n                <div class=\"xl:absolute xl:top-100 xl:-left-[1rem] xl:min-w-[18rem]\">\n                  <ul class=\" pl-1 divide-y divide-white/50 divide-solid bg-black/20 xl:bg-indigo-950 xl:w-sm\">\n                    <li class=\"px-3\">\n                      <a href=\"#\" class=\"block px-5 py-3\">Sublink 1</a>\n                    </li>\n                    <li class=\"px-3\">\n                      <a href=\"#\" class=\"block px-5 py-3\">Sublink 2</a>\n                    </li>\n                    <li class=\"px-3\">\n                      <a href=\"#\" class=\"block px-5 py-3\">Sublink 3</a>\n                    </li>\n                  </ul>\n                </div>\n              </details>\n            </li>\n            <li>\n              <a href=\"#\"  class=\"block px-5 py-3\">\n                Third Link\n              </a>\n            </li>\n            <li class=\"relative\">\n              <details class=\"group/subnav\">\n                <summary class=\" flex px-5 py-3 flex items-center flex place-content-between w-full gap-2 relative\">\n                  Fourth link              \n                  <span class=\"xl-hidden transition-transform duration-200 group-open/subnav:rotate-[-180deg] top-50 w-0 h-0 border-solid border-b-0 border-x-[5px] border-t-[6px] border-l-transparent border-r-transparent border-b-transparent border-t-sky-400\">\n                  </span>\n                </summary>\n                <div class=\"xl:absolute xl:top-100 xl:-right-[1rem] xl:min-w-[18rem]\">\n                  <ul class=\" pl-1 divide-y divide-white/50 divide-solid bg-black/20 xl:bg-indigo-950 xl:w-sm\">\n                    <li class=\"px-3\">\n                      <a href=\"#\" class=\"block px-5 py-3\">Sublink 1</a>\n                    </li>\n                    <li class=\"px-3\">\n                      <a href=\"#\" class=\"block px-5 py-3\">Sublink 2</a>\n                    </li>\n                    <li class=\"px-3\">\n                      <a href=\"#\" class=\"block px-5 py-3\">Sublink 3</a>\n                    </li>\n                  </ul>\n                </div>\n              </details>\n            </li>\n          </ul>\n        </div>\n      </details>\n      <div class=\"translation-wrapper inline-block peer-open:hidden xl:peer-open:inline-block pl-4\">\n        <a href=\"#\" class=\"relative google-translator-switch notranslate py-3 pr-3 pl-4 block before:content-['']\n          before:w-4 before:h-4 before:block before:absolute before:-left-2 before:top-3\" \n          data-once=\"google-translate-disclaimer-init\">Translate</a>\n      </div>\n    </div>\n  </div>\n  <div class=\"p-5\">\n    <h1 class=\"text-4xl lg:text-5xl xl:text-6xl font-light font-extralight\">Simple Responsive Nav w/Translate link</h1>\n    <p>Minimal javascript used, mainly to toggle between desktop and mobile views on resize.</p>\n  </div>\n</div>\n<script>\nfunction checkNav() {\n  const detailsEl = document.getElementById('nav1');\n  const expanded = detailsEl.getAttribute('aria-expanded');  \n  const width = window.innerWidth;\n  if (detailsEl.open && width < 1280) {\n    detailsEl.open = !detailsEl.open;\n    detailsEl.setAttribute('aria-expanded', 'false');\n  }\n  else if (!detailsEl.open && width >= 1280) {\n    detailsEl.open = !detailsEl.open;\n    detailsEl.setAttribute('aria-expanded', 'true');\n  } \n}\n\n// Listen for resize event (handles both desktop resizing and mobile orientation change)\nwindow.addEventListener('resize', checkNav);\n// Run once initially to check the width on page load.\ncheckNav();\n// Could add additional javascript to close open subnavs when a new one is opened.\n</script>"
