      "content": "/**\n * Component: Simple Responsive Navigation Bar w/Translation link\n * Author: @slycreations (https://tailwindflex.com/@slycreations)\n * Source: https://tailwindflex.com/@slycreations/simple-responsive-navigation-bar-w-translation-link\n * Attribution: Créé par @slycreations sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function SimpleResponsiveNavigationBarWTranslationLink() {\n  return (\n    <div>\n    <div className=\"bg-white font-sans font-light text-black w-screen\">\n      <div className=\"bg-indigo-950 text-white text-sm\">\n        <div className=\"w-full mx-auto xl max-w-7xl flex xl4 justify-between relative [&:has(>details[open])]:min-h-screen xl:[&:has(>details[open])]:min-h-px\">\n          <details open aria-expanded=\"true\" id=\"nav1\" className=\"group peer relative bg-inherit open inline-block open open open:100 open:0 xl xl\">\n            <summary className=\"flex xl xl relative group-open950\">\n              <span className=\"block px-3 py-3 flex items-center gap-2 w-full  xl\">Company Navigation          \n                <span className=\"xl transition-transform duration-200 group-open[-180deg] top-50 w-0 h-0 border-solid border-b-0 border-x-[5px] border-t-[6px] border-l-transparent border-r-transparent border-b-transparent border-t-sky-400\">\n                </span>\n              </span>\n            </summary>\n            <div className=\"w-full bg-indigo-950\">\n              <ul className=\"bg-inherit divide-y divide-white/50 divide-solid xl xl xl-space-x-4 w-full xl xl4\">\n                <li className=\"\">\n                  <a href=\"#\"  className=\"block px-5 py-3\">\n                    First Link\n                  </a>\n                </li>\n                <li className=\"relative\">\n                  <details className=\"group/subnav\">\n                    <summary className=\"flex px-5 py-3 flex items-center flex place-content-between w-full gap-2 relative\">\n                      Second Link              \n                        <span className=\"xl-hidden transition-transform duration-200 group-open/subnav[-180deg] top-50 w-0 h-0 border-solid border-b-0 border-x-[5px] border-t-[6px] border-l-transparent border-r-transparent border-b-transparent border-t-sky-400\">\n                        </span>\n                    </summary>\n                    <div className=\"xl xl100 xl[1rem] xl[18rem]\">\n                      <ul className=\" pl-1 divide-y divide-white/50 divide-solid bg-black/20 xl950 xl\">\n                        <li className=\"px-3\">\n                          <a href=\"#\" className=\"block px-5 py-3\">Sublink 1</a>\n                        </li>\n                        <li className=\"px-3\">\n                          <a href=\"#\" className=\"block px-5 py-3\">Sublink 2</a>\n                        </li>\n                        <li className=\"px-3\">\n                          <a href=\"#\" className=\"block px-5 py-3\">Sublink 3</a>\n                        </li>\n                      </ul>\n                    </div>\n                  </details>\n                </li>\n                <li>\n                  <a href=\"#\"  className=\"block px-5 py-3\">\n                    Third Link\n                  </a>\n                </li>\n                <li className=\"relative\">\n                  <details className=\"group/subnav\">\n                    <summary className=\" flex px-5 py-3 flex items-center flex place-content-between w-full gap-2 relative\">\n                      Fourth link              \n                      <span className=\"xl-hidden transition-transform duration-200 group-open/subnav[-180deg] top-50 w-0 h-0 border-solid border-b-0 border-x-[5px] border-t-[6px] border-l-transparent border-r-transparent border-b-transparent border-t-sky-400\">\n                      </span>\n                    </summary>\n                    <div className=\"xl xl100 xl[1rem] xl[18rem]\">\n                      <ul className=\" pl-1 divide-y divide-white/50 divide-solid bg-black/20 xl950 xl\">\n                        <li className=\"px-3\">\n                          <a href=\"#\" className=\"block px-5 py-3\">Sublink 1</a>\n                        </li>\n                        <li className=\"px-3\">\n                          <a href=\"#\" className=\"block px-5 py-3\">Sublink 2</a>\n                        </li>\n                        <li className=\"px-3\">\n                          <a href=\"#\" className=\"block px-5 py-3\">Sublink 3</a>\n                        </li>\n                      </ul>\n                    </div>\n                  </details>\n                </li>\n              </ul>\n            </div>\n          </details>\n          <div className=\"translation-wrapper inline-block peer-open xl pl-4\">\n            <a href=\"#\" className=\"relative google-translator-switch notranslate py-3 pr-3 pl-4 block before['']\n              before4 before4 before before before2 before3\" \n              data-once=\"google-translate-disclaimer-init\">Translate</a>\n          </div>\n        </div>\n      </div>\n      <div className=\"p-5\">\n        <h1 className=\"text-4xl lg5xl xl6xl font-light font-extralight\">Simple Responsive Nav w/Translate link</h1>\n        <p>Minimal javascript used, mainly to toggle between desktop and mobile views on resize.</p>\n      </div>\n    </div>\n    \n    </div>\n  );\n}\n",
