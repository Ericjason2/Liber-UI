m font-semibold text-violet-600 hover:text-violet-700\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"1.8\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M4 4v6h6\"/>\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M20 20v-6h-6\"/>\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M20 8A8 8 0 0 0 6.3 5.3L4 8m0 8a8 8 0 0 0 13.7 2.7L20 16\"/>\n          </svg>\n          Resend Code\n        </button>\n      </div>\n    </div>\n  </div>\n</div>"
