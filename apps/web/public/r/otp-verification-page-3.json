      "content": "/**\n * Component: OTP Verification Page\n * Author: @jugendra-gangwar (https://tailwindflex.com/@jugendra-gangwar)\n * Source: https://tailwindflex.com/@jugendra-gangwar/otp-verification-page-3\n * Attribution: Créé par @jugendra-gangwar sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function OtpVerificationPage3() {\n  return (\n    <div>\n    <div className=\"min-h-screen bg-gradient-to-br from-slate-100 via-white to-violet-100 flex items-center justify-center p-6\">\n      <div className=\"w-full max-w-md\">\n        <a href=\"#\" className=\"mb-6 inline-flex items-center gap-2 text-sm font-medium text-slate-600 hover900 transition\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"h-4 w-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" strokeWidth=\"2\">\n            <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M15 19l-7-7 7-7\"/>\n          </svg>\n          Back\n        </a>\n        <div className=\"rounded-[28px] border border-white/70 bg-white/80 p-8 shadow-2xl backdrop-blur-xl\">\n          <div className=\"mt-6 text-center\">\n            <h1 className=\"text-3xl font-bold text-slate-900\">Verify Your Email</h1>\n            <p className=\"mt-3 text-sm leading-6 text-slate-500\">\n              We've sent a 6-digit verification code to\n            </p>\n            <p className=\"mt-1 text-sm font-semibold text-slate-800\">\n              john.com\n            </p>\n          </div>\n          <form className=\"mt-8 space-y-6\">\n            <div>\n              <label className=\"mb-3 block text-center text-sm font-medium text-slate-700\">\n                Enter Verification Code\n              </label>\n              <div className=\"grid grid-cols-6 gap-2\">\n                <input maxlength=\"1\" type=\"text\" className=\"h-14 w-full rounded-xl border border-violet-200 bg-violet-50 text-center text-xl font-bold text-slate-900 outline-none transition focus500 focus focus4 focus100\" />\n                <input maxlength=\"1\" type=\"text\" className=\"h-14 w-full rounded-xl border border-slate-200 bg-white text-center text-xl font-bold text-slate-900 outline-none transition focus500 focus4 focus100\" />\n                <input maxlength=\"1\" type=\"text\" className=\"h-14 w-full rounded-xl border border-slate-200 bg-white text-center text-xl font-bold text-slate-900 outline-none transition focus500 focus4 focus100\" />\n                <input maxlength=\"1\" type=\"text\" className=\"h-14 w-full rounded-xl border border-slate-200 bg-white text-center text-xl font-bold text-slate-900 outline-none transition focus500 focus4 focus100\" />\n                <input maxlength=\"1\" type=\"text\" className=\"h-14 w-full rounded-xl border border-slate-200 bg-white text-center text-xl font-bold text-slate-900 outline-none transition focus500 focus4 focus100\" />\n                <input maxlength=\"1\" type=\"text\" className=\"h-14 w-full rounded-xl border border-slate-200 bg-white text-center text-xl font-bold text-slate-900 outline-none transition focus500 focus4 focus100\" />\n              </div>\n            </div>\n            <div className=\"rounded-2xl border border-slate-200 bg-slate-50 p-4\">\n              <div className=\"flex items-center justify-between\">\n                <div className=\"flex items-center gap-2\">\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"h-5 w-5 text-violet-600\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" strokeWidth=\"1.8\">\n                    <circle cx=\"12\" cy=\"12\" r=\"9\"/>\n                    <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M12 7v5l3 2\"/>\n                  </svg>\n                  <span className=\"text-sm font-medium text-slate-700\">Code expires in</span>\n                </div>\n                <span className=\"text-sm font-bold text-violet-600\">01:29</span>\n              </div>\n            </div>\n            <button className=\"w-full rounded-xl bg-slate-900 py-3.5 text-sm font-semibold text-white shadow-lg shadow-slate-900/20 transition hover800\">\n              Verify Account\n            </button>\n          </form>\n          <div className=\"mt-8 text-center\">\n            <p className=\"text-sm text-slate-500\">\n              Didn't receive the code?\n            </p>\n            <button className=\"mt-2 inline-flex items-center gap-2 text-sm font-semibold text-violet-600 hover700\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"h-4 w-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" strokeWidth=\"1.8\">\n                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M4 4v6h6\"/>\n                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M20 20v-6h-6\"/>\n                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M20 8A8 8 0 0 0 6.3 5.3L4 8m0 8a8 8 0 0 0 13.7 2.7L20 16\"/>\n              </svg>\n              Resend Code\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
