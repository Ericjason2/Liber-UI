    "rawHtml": "<!DOCTYPE html>\n<html lang=\"es\" class=\"\">\n\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Tarjetas KPI Modernas</title>\n\n\n    <script src=\"https://cdn.jsdelivr.net/npm/chart.js\"></script>\n    <script>\n\n    </script>\n\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n\n    <style>\n        body {\n            font-family: 'Inter', sans-serif;\n        }\n    </style>\n</head>\n\n<body class=\"\">\n\n\n    <div class=\"max-w-7xl mx-auto\">\n\n\n        <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6\">\n\n\n            <div\n                class=\"bg-white dark:bg-gray-800 p-6 rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 \">\n                <div class=\"flex justify-between items-start\">\n                    <div class=\"flex flex-col space-y-1\">\n                        <span class=\"text-sm font-medium text-gray-500 dark:text-gray-400\">Ventas Totales</span>\n                        <span class=\"text-3xl font-bold text-gray-900 dark:text-white\">$48,250.00</span>\n                    </div>\n\n                    <div class=\"p-2 bg-green-100 dark:bg-green-900 rounded-full\">\n                        <svg class=\"w-6 h-6 text-green-600 dark:text-green-300\" fill=\"none\" stroke=\"currentColor\"\n                            viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"\n                                d=\"M13 7h8m0 0v8m0-8l-8 8-4-4-6 6\"></path>\n                        </svg>\n                    </div>\n                </div>\n                <div class=\"mt-4\">\n                    <span class=\"inline-flex items-center text-sm font-semibold text-green-600 dark:text-green-400\">\n                        <svg class=\"w-4 h-4 mr-1\" fill=\"currentColor\" viewBox=\"0 0 20 20\" xmlns=\"http://www.w3.org/2000/svg\"><path fill-rule=\"evenodd\" d=\"M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-8.707a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z\" clip-rule=\"evenodd\"></path></svg>\n                        +12.5% vs. mes pasado\n                    </span>\n                </div>\n            </div>\n\n\n            <div\n                class=\"bg-white dark:bg-gray-800 p-6 rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 transform \">\n                <div class=\"flex justify-between items-start\">\n                    <div class=\"flex flex-col space-y-1\">\n                        <span class=\"text-sm font-medium text-gray-500 dark:text-gray-400\">Nuevos Usuarios</span>\n                        <span class=\"text-3xl font-bold text-gray-900 dark:text-white\">1,240</span>\n                    </div>\n\n                    <div class=\"p-2 bg-red-100 dark:bg-red-900 rounded-full\">\n                        <svg class=\"w-6 h-6 text-red-600 dark:text-red-300\" fill=\"none\" stroke=\"currentColor\"\n                            viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"\n                                d=\"M13 17h8m0 0v-8m0 8l-8-8-4 4-6-6\"></path>\n                        </svg>\n                    </div>\n                </div>\n                <div class=\"mt-4\">\n                    <span class=\"inline-flex items-center text-sm font-semibold text-red-600 dark:text-red-400\">\n                        <svg class=\"w-4 h-4 mr-1\" fill=\"currentColor\" viewBox=\"0 0 20 20\" xmlns=\"http://www.w3.org/2000/svg\"><path fill-rule=\"evenodd\" d=\"M10 18a8 8 0 100-16 8 8 0 000 16zM7 9a1 1 0 011-1h4a1 1 0 110 2H8a1 1 0 01-1-1z\" clip-rule=\"evenodd\"></path></svg>\n                        -3.2% vs. semana pasada\n                    </span>\n                </div>\n            </div>\n\n            <div\n                class=\"bg-white dark:bg-gray-800 p-6 rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 transform \">\n                \n                <div class=\"flex flex-col space-y-2\">\n                    <span class=\"text-sm font-medium text-gray-500 dark:text-gray-400\">Tasa de Conversión</span>\n                    <span class=\"text-3xl font-bold text-gray-900 dark:text-white\">25.8%</span>\n                    <div class=\"w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2.5\">\n\n                        <div class=\"bg-blue-600 dark:bg-blue-500 h-2.5 rounded-full\" style=\"width: 25.8%\"></div>\n                    </div>\n                    <span class=\"text-sm text-gray-500 dark:text-gray-400 text-right\">Objetivo: 30%</span>\n                </div>\n            </div>\n\n\n            <div\n                class=\"bg-white dark:bg-gray-800 p-6 rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 transform \">\n                \n                <div class=\"flex justify-between items-start\">\n                    <div class=\"flex flex-col space-y-1\">\n                        <span class=\"text-sm font-medium text-gray-500 dark:text-gray-400\">Visitantes Únicos</span>\n                        <span class=\"text-3xl font-bold text-gray-900 dark:text-white\">12,890</span>\n                    </div>\n\n                    <div class=\"p-2 bg-blue-100 dark:bg-blue-900 rounded-full\">\n                        <svg class=\"w-6 h-6 text-blue-600 dark:text-blue-300\" fill=\"none\" stroke=\"currentColor\"\n                            viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"\n                                d=\"M16 8v8m-4-5v5m-4-2v2M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z\">\n                            </path>\n                        </svg>\n                    </div>\n                </div>\n\n                <div class=\" h-14 w-full\">\n                    <canvas id=\"sparkline-chart\"></canvas>\n                </div>\n            </div>\n\n\n        </div>\n\n    </div> <!-- Fin del contenedor principal -->\n\n    <script>\n        // --- Lógica de Chart.js ---\n        // Variable global para la instancia del gráfico\n        let sparklineChart = null;\n\n        // Funciones para obtener colores basados en el modo oscuro\n        function getChartLineColor() {\n            // Devuelve un color de línea basado en si la clase 'dark' está presente\n            return document.documentElement.classList.contains('dark') ? '#60a5fa' : '#2563eb'; // Azul claro (dark) / Azul oscuro (light)\n        }\n        \n        function getChartBgColor() {\n            // Devuelve un color de fondo translúcido basado en el modo oscuro\n            return document.documentElement.classList.contains('dark') ? 'rgba(96, 165, 250, 0.1)' : 'rgba(37, 99, 235, 0.1)';\n        }\n\n        // Función para inicializar el gráfico\n        function initSparklineChart() {\n            const ctx = document.getElementById('sparkline-chart');\n            if (!ctx) return; // Salir si el canvas no se encuentra\n\n            const sparklineData = {\n                labels: ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul'],\n                datasets: [{\n                    label: 'Visitantes',\n                    data: [120, 150, 130, 180, 160, 200, 190], // Datos de ejemplo\n                    borderColor: getChartLineColor(), // Color de línea dinámico\n                    borderWidth: 2,\n                    fill: true, // Rellenar área bajo la línea\n                    backgroundColor: getChartBgColor(), // Color de fondo dinámico\n                    tension: 0.4, // Suavizar la curva\n                    pointRadius: 0, // Ocultar puntos en la línea\n                }]\n            };\n\n            const sparklineConfig = {\n                type: 'line',\n                data: sparklineData,\n                options: {\n                    responsive: true,\n                    maintainAspectRatio: false, // Permitir que el gráfico llene el contenedor\n                    plugins: {\n                        legend: { display: false }, // Ocultar leyenda\n                        tooltip: { enabled: false } // Ocultar tooltips al pasar el mouse\n                    },\n                    scales: {\n                        x: { display: false }, // Ocultar eje X\n                        y: { display: false }  // Ocultar eje Y\n                    }\n                }\n            };\n            \n            // Destruir gráfico anterior si existe (útil para recargas en caliente)\n            if (sparklineChart) {\n                sparklineChart.destroy();\n            }\n            // Crear el nuevo gráfico\n            sparklineChart = new Chart(ctx.getContext('2d'), sparklineConfig);\n        }\n\n        // Función para actualizar los colores del gráfico (llamada al cambiar de tema)\n        function updateChartColors() {\n            if (sparklineChart) {\n                sparklineChart.data.datasets[0].borderColor = getChartLineColor();\n                sparklineChart.data.datasets[0].backgroundColor = getChartBgColor();\n                sparklineChart.update('none'); // Actualizar sin animación\n            }\n        }\n\n                document.addEventListener('DOMContentLoaded', initSparklineChart);\n    </script>\n\n</body>\n\n</html>"
  }
