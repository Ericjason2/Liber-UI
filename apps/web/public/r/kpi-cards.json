      "content": "/**\n * Component: KPI Cards\n * Author: @raulanto (https://tailwindflex.com/@raulanto)\n * Source: https://tailwindflex.com/@raulanto/kpi-cards\n * Attribution: Créé par @raulanto sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function KpiCards() {\n  return (\n    <div dangerouslySetInnerHTML={{ __html: \"<!DOCTYPE html>\\n<html lang=\\\"es\\\">\\n\\n<head>\\n    <meta charset=\\\"UTF-8\\\">\\n    <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\">\\n    <title>KPI Cards estilo Shopify / Stripe</title>\\n\\n    \\n    <style>\\n        .sparkline-canvas {\\n            height: 80px !important;\\n        }\\n    </style>\\n</head>\\n\\n<body class=\\\"bg-gray-50 min-h-screen p-6 md:p-12\\\">\\n\\n    <div class=\\\"grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto\\\">\\n\\n        <!-- Total Orders -->\\n        <div class=\\\"bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden\\\">\\n            <div class=\\\"p-6\\\">\\n                <div class=\\\"flex justify-between items-start mb-8\\\">\\n                    <p class=\\\"text-sm text-gray-600 font-medium\\\">Total orders</p>\\n                    <div class=\\\"flex items-center text-green-600 text-sm font-medium\\\">\\n                        <svg class=\\\"w-4 h-4 mr-1\\\" fill=\\\"currentColor\\\" viewBox=\\\"0 0 20 20\\\">\\n                            <path fill-rule=\\\"evenodd\\\"\\n                                d=\\\"M5.293 9.707a1 1 0 010-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 01-1.414 1.414L11 7.414V15a1 1 0 11-2 0V7.414L6.707 9.707a1 1 0 01-1.414 0z\\\" />\\n                        </svg>\\n                        56.4%\\n                        <span class=\\\"text-gray-500 ml-1\\\">Past 30 days</span>\\n                    </div>\\n                </div>\\n\\n                <div class=\\\"mb-2\\\">\\n                    <span class=\\\"text-4xl font-bold text-gray-900\\\">1,054</span>\\n                    <span class=\\\"text-green-600 text-sm font-medium ml-3\\\">+330 today</span>\\n                </div>\\n            </div>\\n\\n            <div class=\\\"relative\\\">\\n                <canvas id=\\\"chart-orders\\\" class=\\\"sparkline-canvas\\\"></canvas>\\n                <div class=\\\"absolute bottom-4 right-6 text-xs text-gray-400\\\">\\n                    <span class=\\\"inline-block w-2 h-2 bg-green-500 rounded-full mr-1\\\"></span>\\n                    20 total • 04 Apr, 2025\\n                </div>\\n            </div>\\n        </div>\\n\\n        <!-- Unfulfilled Orders -->\\n        <div class=\\\"bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden\\\">\\n            <div class=\\\"p-6\\\">\\n                <div class=\\\"flex justify-between items-start mb-8\\\">\\n                    <p class=\\\"text-sm text-gray-600 font-medium\\\">Unfulfilled</p>\\n                    <div class=\\\"flex items-center text-red-600 text-sm font-medium\\\">\\n                        <svg class=\\\"w-4 h-4 mr-1 rotate-180\\\" fill=\\\"currentColor\\\" viewBox=\\\"0 0 20 20\\\">\\n                            <path fill-rule=\\\"evenodd\\\"\\n                                d=\\\"M5.293 9.707a1 1 0 010-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 01-1.414 1.414L11 7.414V15a1 1 0 11-2 0V7.414L6.707 9.707a1 1 0 01-1.414 0z\\\" />\\n                        </svg>\\n                        21.8%\\n                        <span class=\\\"text-gray-500 ml-1\\\">Past 30 days</span>\\n                    </div>\\n                </div>\\n\\n                <div class=\\\"mb-2\\\">\\n                    <span class=\\\"text-4xl font-bold text-gray-900\\\">233</span>\\n                    <span class=\\\"text-red-600 text-sm font-medium ml-3\\\">18 today</span>\\n                </div>\\n            </div>\\n\\n            <div class=\\\"relative\\\">\\n                <canvas id=\\\"chart-unfulfilled\\\" class=\\\"sparkline-canvas\\\"></canvas>\\n                <div class=\\\"absolute bottom-4 right-6 text-xs text-gray-400\\\">\\n                    <span class=\\\"inline-block w-2 h-2 bg-red-500 rounded-full mr-1\\\"></span>\\n                    12 total • 20 Apr, 2025\\n                </div>\\n            </div>\\n        </div>\\n\\n    </div>\\n\\n    \\n</body>\\n\\n</html>\" }} />\n  );\n}\n",
      "type": "registry:ui"
    }
