r>\\n\\n<tr class=\\\"hover:bg-indigo-50 transition\\\">\\n\\n<td class=\\\"px-8 py-6 flex items-center gap-4\\\">\\n<div class=\\\"w-10 h-10 rounded-full bg-pink-100 flex items-center justify-center font-semibold text-pink-600\\\">RJ</div>\\n<div>\\n<p class=\\\"font-medium text-slate-800\\\">Rohan Joseph</p>\\n<p class=\\\"text-xs text-slate-500\\\">Mobile Architect</p>\\n</div>\\n</td>\\n\\n<td class=\\\"px-8 py-6 text-slate-600\\\">Enterprise Banking App</td>\\n<td class=\\\"px-8 py-6 text-slate-600\\\">Flutter · Microservices</td>\\n<td class=\\\"px-8 py-6 text-slate-600\\\">10 Oct 2026</td>\\n\\n<td class=\\\"px-8 py-6\\\">\\n<span class=\\\"px-3 py-1 text-xs rounded-full bg-indigo-100 text-indigo-600 font-medium\\\">Architecture</span>\\n</td>\\n\\n<td class=\\\"px-8 py-6 text-right\\\">\\n<a href=\\\"https://www.ayyamperumal.online/\\\" target=\\\"_blank\\\" class=\\\"px-3 py-1 text-xs bg-indigo-100 text-indigo-600 rounded-md hover:bg-indigo-200\\\">Portfolio</a>\\n</td>\\n\\n</tr>\\n\\n<tr class=\\\"hover:bg-indigo-50 transition\\\">\\n\\n<td class=\\\"px-8 py-6 flex items-center gap-4\\\">\\n<div class=\\\"w-10 h-10 rounded-full bg-sky-100 flex items-center justify-center font-semibold text-sky-600\\\">AN</div>\\n<div>\\n<p class=\\\"font-medium text-slate-800\\\">Anjali Nair</p>\\n<p class=\\\"text-xs text-slate-500\\\">DevOps Engineer</p>\\n</div>\\n</td>\\n\\n<td class=\\\"px-8 py-6 text-slate-600\\\">Cloud Infrastructure</td>\\n<td class=\\\"px-8 py-6 text-slate-600\\\">AWS · Kubernetes</td>\\n<td class=\\\"px-8 py-6 text-slate-600\\\">22 Aug 2026</td>\\n\\n<td class=\\\"px-8 py-6\\\">\\n<span class=\\\"px-3 py-1 text-xs rounded-full bg-blue-100 text-blue-600 font-medium\\\">Deployment</span>\\n</td>\\n\\n<td class=\\\"px-8 py-6 text-right\\\">\\n<a href=\\\"https://www.ayyamperumal.online/\\\" target=\\\"_blank\\\" class=\\\"px-3 py-1 text-xs bg-indigo-100 text-indigo-600 rounded-md hover:bg-indigo-200\\\">Portfolio</a>\\n</td>\\n\\n</tr>\\n\\n</tbody