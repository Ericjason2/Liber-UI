    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Engineering Project Assignment Dashboard</title>\n<script src=\"https://cdn.tailwindcss.com\"></script>\n</head>\n\n<body class=\"bg-gradient-to-br from-slate-50 via-indigo-50 to-purple-100 min-h-screen\">\n\n<div class=\"max-w-7xl mx-auto px-6 py-12\">\n\n<div class=\"flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6 mb-10\">\n\n<div>\n<h1 class=\"text-4xl font-bold text-slate-800 tracking-tight\">Project Resource Dashboard</h1>\n<p class=\"text-slate-500 mt-2 text-sm\">Live overview of engineering assignments, delivery status and workload distribution</p>\n</div>\n\n<div class=\"flex flex-col sm:flex-row gap-4\">\n\n<div class=\"relative\">\n<input id=\"searchInput\" type=\"text\" placeholder=\"Search engineer, project or stack\"\nclass=\"w-full sm:w-80 pl-11 pr-4 py-3 rounded-xl border border-slate-200 bg-white shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm\">\n<svg class=\"absolute left-3 top-3.5 w-5 h-5 text-slate-400\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n<path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"\nd=\"M21 21l-4.3-4.3m1.8-5.2a7 7 0 11-14 0 7 7 0 0114 0z\"/>\n</svg>\n</div>\n\n<a href=\"https://www.ayyamperumal.online/\" target=\"_blank\">\n<button class=\"px-6 py-3 rounded-xl bg-indigo-600 text-white text-sm font-medium shadow-md hover:bg-indigo-700 transition\">\nVisit Portfolio\n</button>\n</a>\n\n</div>\n</div>\n\n<div class=\"grid grid-cols-1 md:grid-cols-3 gap-6 mb-10\">\n\n<div class=\"bg-white rounded-xl shadow-sm border p-6\">\n<p class=\"text-xs text-slate-500\">Active Projects</p>\n<p class=\"text-3xl font-semibold text-slate-800 mt-2\">12</p>\n</div>\n\n<div class=\"bg-white rounded-xl shadow-sm border p-6\">\n<p class=\"text-xs text-slate-500\">Engineers Allocated</p>\n<p class=\"text-3xl font-semibold text-slate-800 mt-2\">37</p>\n</div>\n\n<div class=\"bg-white rounded-xl shadow-sm border p-6\">\n<p class=\"text-xs text-slate-500\">Pending Deliverables</p>\n<p class=\"text-3xl font-semibold text-slate-800 mt-2\">8</p>\n</div>\n\n</div>\n\n<div class=\"bg-white rounded-2xl shadow-xl border border-slate-100 overflow-hidden\">\n\n<div class=\"px-8 py-6 border-b bg-slate-50 flex justify-between items-center\">\n<p class=\"text-sm text-slate-600\">Engineering Assignment Matrix</p>\n<span id=\"entryCount\" class=\"text-xs text-slate-500\"></span>\n</div>\n\n<div class=\"overflow-x-auto\">\n\n<table class=\"w-full text-sm\">\n\n<thead class=\"bg-slate-100 text-slate-600 uppercase text-xs tracking-wider\">\n\n<tr>\n<th class=\"px-8 py-4 text-left\">Engineer</th>\n<th class=\"px-8 py-4 text-left\">Project</th>\n<th class=\"px-8 py-4 text-left\">Technology</th>\n<th class=\"px-8 py-4 text-left\">Delivery Date</th>\n<th class=\"px-8 py-4 text-left\">Status</th>\n<th class=\"px-8 py-4 text-right\">Links</th>\n</tr>\n\n</thead>\n\n<tbody id=\"tableBody\" class=\"divide-y divide-slate-100\">\n\n<tr class=\"hover:bg-indigo-50 transition\">\n\n<td class=\"px-8 py-6 flex items-center gap-4\">\n<div class=\"w-10 h-10 rounded-full bg-indigo-100 flex items-center justify-center font-semibold text-indigo-600\">AP</div>\n<div>\n<p class=\"font-medium text-slate-800\">Ayyam Perumal</p>\n<p class=\"text-xs text-slate-500\">Senior Mobile Architect</p>\n</div>\n</td>\n\n<td class=\"px-8 py-6 text-slate-600\">Ride Sharing Platform</td>\n<td class=\"px-8 py-6 text-slate-600\">React Native · FastAPI</td>\n<td class=\"px-8 py-6 text-slate-600\">15 Aug 2026</td>\n\n<td class=\"px-8 py-6\">\n<span class=\"px-3 py-1 text-xs rounded-full bg-emerald-100 text-emerald-600 font-medium\">In Progress</span>\n</td>\n\n<td class=\"px-8 py-6 text-right flex justify-end gap-3\">\n\n<a href=\"https://www.ayyamperumal.online/\" target=\"_blank\" class=\"px-3 py-1 text-xs bg-indigo-100 text-indigo-600 rounded-md hover:bg-indigo-200\">Portfolio</a>\n\n<a href=\"https://games.ayyamperumal.online/\" target=\"_blank\" class=\"px-3 py-1 text-xs bg-purple-100 text-purple-600 rounded-md hover:bg-purple-200\">Games</a>\n\n</td>\n\n</tr>\n\n<tr class=\"hover:bg-indigo-50 transition\">\n\n<td class=\"px-8 py-6 flex items-center gap-4\">\n<div class=\"w-10 h-10 rounded-full bg-purple-100 flex items-center justify-center font-semibold text-purple-600\">MS</div>\n<div>\n<p class=\"font-medium text-slate-800\">Megha Suresh</p>\n<p class=\"text-xs text-slate-500\">Backend Engineer</p>\n</div>\n</td>\n\n<td class=\"px-8 py-6 text-slate-600\">AI Medical Assistant</td>\n<td class=\"px-8 py-6 text-slate-600\">Python · FastAPI · OpenAI</td>\n<td class=\"px-8 py-6 text-slate-600\">02 Sep 2026</td>\n\n<td class=\"px-8 py-6\">\n<span class=\"px-3 py-1 text-xs rounded-full bg-amber-100 text-amber-600 font-medium\">Planning</span>\n</td>\n\n<td class=\"px-8 py-6 text-right\">\n<a href=\"https://www.ayyamperumal.online/\" target=\"_blank\" class=\"px-3 py-1 text-xs bg-indigo-100 text-indigo-600 rounded-md hover:bg-indigo-200\">Portfolio</a>\n</td>\n\n</tr>\n\n<tr class=\"hover:bg-indigo-50 transition\">\n\n<td class=\"px-8 py-6 flex items-center gap-4\">\n<div class=\"w-10 h-10 rounded-full bg-pink-100 flex items-center justify-center font-semibold text-pink-600\">RJ</div>\n<div>\n<p class=\"font-medium text-slate-800\">Rohan Joseph</p>\n<p class=\"text-xs text-slate-500\">Mobile Architect</p>\n</div>\n</td>\n\n<td class=\"px-8 py-6 text-slate-600\">Enterprise Banking App</td>\n<td class=\"px-8 py-6 text-slate-600\">Flutter · Microservices</td>\n<td class=\"px-8 py-6 text-slate-600\">10 Oct 2026</td>\n\n<td class=\"px-8 py-6\">\n<span class=\"px-3 py-1 text-xs rounded-full bg-indigo-100 text-indigo-600 font-medium\">Architecture</span>\n</td>\n\n<td class=\"px-8 py-6 text-right\">\n<a href=\"https://www.ayyamperumal.online/\" target=\"_blank\" class=\"px-3 py-1 text-xs bg-indigo-100 text-indigo-600 rounded-md hover:bg-indigo-200\">Portfolio</a>\n</td>\n\n</tr>\n\n<tr class=\"hover:bg-indigo-50 transition\">\n\n<td class=\"px-8 py-6 flex items-center gap-4\">\n<div class=\"w-10 h-10 rounded-full bg-sky-100 flex items-center justify-center font-semibold text-sky-600\">AN</div>\n<div>\n<p class=\"font-medium text-slate-800\">Anjali Nair</p>\n<p class=\"text-xs text-slate-500\">DevOps Engineer</p>\n</div>\n</td>\n\n<td class=\"px-8 py-6 text-slate-600\">Cloud Infrastructure</td>\n<td class=\"px-8 py-6 text-slate-600\">AWS · Kubernetes</td>\n<td class=\"px-8 py-6 text-slate-600\">22 Aug 2026</td>\n\n<td class=\"px-8 py-6\">\n<span class=\"px-3 py-1 text-xs rounded-full bg-blue-100 text-blue-600 font-medium\">Deployment</span>\n</td>\n\n<td class=\"px-8 py-6 text-right\">\n<a href=\"https://www.ayyamperumal.online/\" target=\"_blank\" class=\"px-3 py-1 text-xs bg-indigo-100 text-indigo-600 rounded-md hover:bg-indigo-200\">Portfolio</a>\n</td>\n\n</tr>\n\n</tbody>\n\n</table>\n\n</div>\n\n</div>\n\n<div class=\"mt-6 flex justify-between items-center text-sm text-slate-500\">\n\n<span id=\"resultText\"></span>\n\n<div class=\"flex gap-2\">\n<button class=\"px-4 py-2 bg-white border rounded-lg hover:bg-slate-50\">Previous</button>\n<button class=\"px-4 py-2 bg-white border rounded-lg hover:bg-slate-50\">Next</button>\n</div>\n\n</div>\n\n</div>\n\n<script>\n\nconst searchInput=document.getElementById('searchInput')\nconst rows=document.querySelectorAll('#tableBody tr')\nconst resultText=document.getElementById('resultText')\nconst entryCount=document.getElementById('entryCount')\n\nentryCount.innerText=rows.length+\" assignments\"\n\nfunction updateCount(){\nlet visible=0\nrows.forEach(r=>{if(r.style.display!=='none'){visible++}})\nresultText.innerText=\"Showing \"+visible+\" of \"+rows.length+\" assignments\"\n}\n\nupdateCount()\n\nsearchInput.addEventListener('keyup',function(){\n\nconst term=this.value.toLowerCase()\n\nrows.forEach(row=>{\n\nconst text=row.innerText.toLowerCase()\n\nif(text.includes(term)){\nrow.style.display=''\n}else{\nrow.style.display='none'\n}\n\n})\n\nupdateCount()\n\n})\n\n</script>\n\n</body>\n</html>"
  }
}
