t No:</p>\\n          <p>FF346Y</p>\\n        </div>\\n      </div>\\n\\n      <!-- QR Code -->\\n      <div class=\\\"text-center mt-6\\\">\\n        <img src=\\\"https://via.placeholder.com/150x150.png?text=QR+Code\\\" alt=\\\"QR Code\\\" class=\\\"mx-auto mb-4\\\">\\n        <p class=\\\"text-xs text-gray-500\\\">Scan to enter</p>\\n      </div>\\n    </div>\\n\\n    <!-- Ticket Footer -->\\n    <div class=\\\"bg-blue-900 text-white text-center py-2\\\">\\n      <p class=\\\"text-sm\\\">Stadio Giuseppe Meazza</p>\\n    </div>\\n  </div>\\n\\n</body>\\n</html>\" }} />\n  );\n}\n",
