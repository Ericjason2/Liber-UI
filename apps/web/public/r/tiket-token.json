      "content": "import * as React from \"react\"\n\nfunction TiketToken({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"tiket-token\"\n      className={className}\n      {...props}\n    >\n      <div className=\"max-w-sm mx-auto bg-white shadow-lg rounded-lg overflow-hidden\">\n          \n          <div className=\"bg-blue-900 text-white text-center py-4\">\n            <h1 className=\"text-2xl font-semibold\">FC Internazionale</h1>\n            <p className=\"text-sm\">Serie A Match</p>\n          </div>\n      \n          \n          <div className=\"p-6\">\n            <div className=\"flex justify-between text-sm text-gray-600 mb-4\">\n              <div>\n                <p className=\"font-semibold\">Match:</p>\n                <p>Inter Milan vs Juventus</p>\n              </div>\n              <div>\n                <p className=\"font-semibold\">Date:</p>\n                <p>June 1, 2025</p>\n              </div>\n            </div>\n      \n            <div className=\"flex justify-between text-sm text-gray-600 mb-4\">\n              <div>\n                <p className=\"font-semibold\">Kickoff:</p>\n                <p>20:45 CEST</p>\n              </div>\n              <div>\n                <p className=\"font-semibold\">Gate:</p>\n                <p>Gate 7</p>\n              </div>\n            </div>\n      \n            <div className=\"flex justify-between text-sm text-gray-600 mb-4\">\n              <div>\n                <p className=\"font-semibold\">Seat:</p>\n                <p>Row 15, Seat 22</p>\n              </div>\n              <div>\n                <p className=\"font-semibold\">Ticket No:</p>\n                <p>FF346Y</p>\n              </div>\n            </div>\n      \n            \n            <div className=\"text-center mt-6\">\n              <img src=\"https://via.placeholder.com/150x150.png?text=QR+Code\" alt=\"QR Code\" className=\"mx-auto mb-4\" />\n              <p className=\"text-xs text-gray-500\">Scan to enter</p>\n            </div>\n          </div>\n      \n          \n          <div className=\"bg-blue-900 text-white text-center py-2\">\n            <p className=\"text-sm\">Stadio Giuseppe Meazza</p>\n          </div>\n        </div>\n    </div>\n  )\n}\n\nexport { TiketToken }\n",
      "type": "registry:ui"
    }
  ],
