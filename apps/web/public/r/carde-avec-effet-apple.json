 <span class=\"text-sm text-gray-400\">Billed one time</span>\n                    </div>\n                    <div class=\"bg-white/10 border border-white/20 text-[#EADBC8] px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1\">\n                        <svg class=\"w-3 h-3\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z\"></path></svg>\n                        Figma Project\n                    </div>\n                </div>\n            </div>\n\n            <!-- Bouton inférieur stylisé pour fusionner avec l'effet de verre sombre -->\n            <button class=\"relative w-full z-10 bg-[#EADBC8] text-[#1A1A1A] -mt-10 pt-14 pb-5 rounded-b-[32px] rounded-t-none text-center font-semibold shadow-xl hover:bg-white transition-colors cursor-pointer\">\n                Choose Design Only\n            </button>\n        </div>\n\n        <!-- Carte 2 : Style d'origine (Sombre Classique pour contraste) -->\n        <div class=\"group w-full max-w-[380px] mx-auto\">\n            <div class=\"relative z-20 bg-[#1A1A1A] rounded-[32px] p-8 shadow-2xl transition-transform duration-300 group-hover:-translate-y-1 border border-white/5\">\n                <div class=\"flex items-start gap-4 mb-6\">\n                    <div class=\"w-12 h-12 flex items-center justify-center flex-shrink-0\">\n                       <svg class=\"w-10 h-10 text-[#888]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z\"></path><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M15 12a3 3 0 11-6 0 3 3 0 016 0z\"></path></svg>\n                    </div>\n                    <div>\n                        <h3 class=\"text-2xl font-bold text-[#EADBC8]\">Full Stack</h3>\n                        <p class=\"text-gray-400 text-sm mt-1\">Production-ready code solution</p>\n                    </div>\n                </div>\n\n                <div class=\"h-px w-full bg-white/10 mb-6\"></div>\n\n                <ul class=\"space-y-4 mb-8 text-[#EADBC8]\">\n                    <li class=\"flex items-center gap-3 text-gray-300\">\n                        <svg class=\"w-5 h-5 text-[#EADBC8]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z\"></path></svg>\n                        <span class=\"text-sm font-medium\">Multi-page layout</span>\n                    </li>\n                    <li class=\"flex items-center gap-3 text-gray-300\">\n                        <svg class=\"w-5 h-5 text-[#EADBC8]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.343L14.657 8l-1.657 1.343L11 7.343z\"></path></svg>\n                        <span class=\"text-sm font-medium\">Production Code</span>\n                    </li>\n                    <li class=\"flex items-center gap-3 text-gray-300\">\n                        <svg class=\"w-5 h-5 text-[#EADBC8]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z\"></path></svg>\n                        <span class=\"text-sm font-medium\">Priority Slack & Meets</span>\n                    </li>\n                    <li class=\"flex items-center gap-3 text-gray-300\">\n                        <svg class=\"w-5 h-5 text-[#EADBC8]\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z\"></path></svg>\n                        <span class=\"text-sm font-medium\">Advanced Animations</span>\n                    </li>\n                </ul>\n\n                <div class=\"flex items-end justify-between\">\n                    <div>\n                        <span class=\"block text-3xl font-bold text-[#EADBC8]\">$2800</span>\n                        <span class=\"text-sm text-gray-500\">Billed one time</span>\n                    </div>\n                    <div class=\"border border-[#EADBC8] text-[#EADBC8] px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1 bg-[#EADBC8]/5\">\n                        <svg class=\"w-3 h-3\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z\"></path></svg>\n                        Tailwind + JS\n                    </div>\n                </div>\n            </div>\n\n            <button class=\"relative w-full z-10 bg-[#EADBC8] text-[#1A1A1A] -mt-10 pt-14 pb-5 rounded-b-[32px] rounded-t-none text-center font-medium shadow-lg hover:bg-[#decab0] transition-colors cursor-pointer\">\n                Choose Full Stack\n            </button>\n        </div>\n\n    </div>\n\n    <!-- Script de gestion de l'arrière-plan interactif (Conservé identique) -->\n    <script>\n        const canvas = document.getElementById('scrollCanvas');\n        const ctx = canvas.getContext('2d');\n\n        let width = canvas.width = window.innerWidth;\n        let height = canvas.height = window.innerHeight;\n\n        window.addEventListener('resize', () => {\n            width = canvas.width = window.innerWidth;\n            height = canvas.height = window.innerHeight;\n        });\n\n        let currentScroll = window.scrollY;\n        let targetScroll = window.scrollY;\n        const ease = 0.08;\n\n        window.addEventListener('scroll', () => {\n            targetScroll = window.scrollY;\n        });\n\n        const points = [];\n        const totalPoints = 45;\n\n        for (let i = 0; i < totalPoints; i++) {\n            points.push({\n                x: Math.random() * width,\n                y: Math.random() * height * 2,\n                radius: Math.random() * 3 + 1,\n                baseY: Math.random() * height * 2,\n                speedFactor: Math.random() * 0.4 + 0.2\n            });\n        }\n\n        function animate() {\n            currentScroll += (targetScroll - currentScroll) * ease;\n            const scrollDelta = targetScroll - currentScroll;\n\n            ctx.clearRect(0, 0, width, height);\n\n            ctx.strokeStyle = 'rgba(26, 26, 26, 0.04)';\n            ctx.fillStyle = 'rgba(26, 26, 26, 0.07)';\n\n            for (let i = 0; i < points.length; i++) {\n                const p = points[i];\n                const renderY = p.baseY - (currentScroll * p.speedFactor) + (scrollDelta * 0.05);\n\n                if (renderY < -50) p.baseY += height + 100;\n                if (renderY > height + 50) p.baseY -= height + 100;\n\n                ctx.beginPath();\n                ctx.arc(p.x, renderY, p.radius, 0, Math.PI * 2);\n                ctx.fill();\n\n                for (let j = i + 1; j < points.length; j++) {\n                    const p2 = points[j];\n                    const renderY2 = p2.baseY - (currentScroll * p2.speedFactor) + (scrollDelta * 0.05);\n\n                    const dist = Math.hypot(p.x - p2.x, renderY - renderY2);\n                    if (dist < 180) {\n                        ctx.beginPath();\n                        ctx.moveTo(p.x, renderY);\n                        ctx.lineTo(p2.x, renderY2);\n                        ctx.lineWidth = (1 - dist / 180) * 0.8;\n                        ctx.stroke();\n                    }\n                }\n            }\n\n            requestAnimationFrame(animate);\n        }\n\n        animate();\n    </script>\n</body>\n</html>"
  }
