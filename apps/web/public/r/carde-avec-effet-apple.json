    "rawHtml": "<!DOCTYPE html>\n<html lang=\"es\" class=\"scroll-smooth\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Stacked Pricing Cards - Liquid Glass Edition</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght=400;500;600;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        body { font-family: 'Inter', sans-serif; }\n        ::-webkit-scrollbar { width: 6px; }\n        ::-webkit-scrollbar-track { background: #F6F1EB; }\n        ::-webkit-scrollbar-thumb { background: #1A1A1A/20; border-radius: 10px; }\n\n        /* Animation de rotation pour le halo lumineux en arrière-plan */\n        @keyframes rotateGlow {\n            0% { transform: rotate(0deg); }\n            100% { transform: rotate(360deg); }\n        }\n        .animate-glow {\n            animation: rotateGlow 8s linear infinite;\n        }\n    </style>\n</head>\n<body class=\"bg-[#F6F1EB] relative min-h-[150vh] flex items-center justify-center p-6 md:p-12 overflow-x-hidden\">\n\n    <!-- Canvas pour l'effet de fond fluide animé au scroll -->\n    <canvas id=\"scrollCanvas\" class=\"fixed inset-0 pointer-events-none z-0 w-full h-full\"></canvas>\n\n    <!-- Conteneur principal -->\n    <div class=\"grid grid-cols-1 md:grid-cols-2 gap-12 max-w-5xl w-full relative z-10 my-24\">\n\n        <!-- Carte 1 : Effet Liquid Glass & Halo Lumineux -->\n        <div class=\"group w-full max-w-[380px] mx-auto relative\">\n            \n            <!-- Conteneur du Halo Lumineux (Glow) caché derrière le verre -->\n            <div class=\"absolute inset-0 z-0 opacity-80 blur-[40px] group-hover:opacity-100 transition-opacity duration-500 pointer-events-none rounded-[32px] overflow-hidden\">\n                <div class=\"absolute -inset-[50%] bg-[conic-gradient(from_0deg,transparent_20%,#EADBC8_40%,transparent_60%,#EADBC8_80%,transparent_100%)] animate-glow\"></div>\n            </div>\n\n            <!-- Corps de la carte en Verre Liquide Sombre (Liquid Glass) -->\n            <div class=\"relative z-20 bg-[linear-gradient(135deg,rgba(20,20,20,0.75)_0%,rgba(10,10,10,0.85)_100%)] backdrop-blur-xl rounded-[32px] p-8 shadow-[20px_20px_50px_rgba(0,0,0,0.3)] border border-white/10 transition-transform duration-300 group-hover:-translate-y-1\">\n                \n                <!-- Reflet de surface typique du verre liquide -->\n                <div class=\"absolute inset-0 rounded-[32px] bg-[linear-gradient(120deg,rgba(255,255,255,0.05)_0%,transparent_50%)] pointer-events-none\"></div>\n\n                <div class=\"relative z-10 flex items-start gap-4 mb-6\">\n                    <!-- Icône avec verre opaque inversé -->\n                    <div class=\"w-12 h-12 bg-[#EADBC8] rounded-xl flex items-center justify-center shadow-lg flex-shrink-0\">\n                        <svg class=\"w-6 h-6 text-[#1A1A1A]\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z\"/></svg>\n                    </div>\n                    <div>\n                        <h3 class=\"text-2xl font-bold text-white tracking-wide\">One-Off</h3>\n                        <p class=\"text-gray-400 text-sm mt-1\">Launch your dream site in 7 days</p>\n                    </div>\n                </div>\n\n                <div class=\"h-px w-full bg-white/10 mb-6\"></div>\n\n                <ul class=\"relative z-10 space-y-4 mb-8 text-gray-200\">\n                    <li class=\"flex items-center gap-3\">\n                        <svg class=\"w-5 h-5 text-[#EADBC8] opacity-90\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z\