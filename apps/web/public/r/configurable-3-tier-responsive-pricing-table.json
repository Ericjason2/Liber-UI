t-center font-medium border-none outline-none focus:ring-0 p-0\\\">\\n                    <span class=\\\"text-sm text-gray-700 ml-2\\\">People</span>\\n                </div>\\n            </div>\\n\\n            <!-- Billing Cycle Toggle -->\\n            <div class=\\\"w-full sm:w-auto\\\">\\n                 <span class=\\\"block text-sm font-medium text-green-600 mb-1 text-left sm:text-right\\\">Save from 16% with yearly</span>\\n                 <div class=\\\"flex rounded-lg border border-gray-300 overflow-hidden w-full sm:w-auto\\\">\\n                    <button class=\\\"flex-1 sm:flex-none px-5 py-2 text-sm font-medium bg-white text-gray-700 hover:bg-gray-100 focus:outline-none\\\">Monthly</button>\\n                    <button class=\\\"flex-1 sm:flex-none px-5 py-2 text-sm font-medium bg-custom-purple text-white focus:outline-none\\\">Yearly</button>\\n                </div>\\n            </div>\\n        </div>\\n    </div>\\n\\n    <!-- Pricing Cards Section -->\\n    <div class=\\\"grid grid-cols-1 lg:grid-cols-3 gap-6\\\">\\n\\n        <!-- Card 1: Basic/Free -->\\n        <div class=\\\"bg-custom-gray-light rounded-lg p-6 flex flex-col\\\">\\n            <div class=\\\"flex justify-between items-center mb-3\\\">\\n                <span class=\\\"text-xs bg-gray-200 text-gray-700 px-2 py-0.5 rounded-full font-medium\\\">For one person</span>\\n                <!-- Optional Icon -->\\n            </div>\\n            <h3 class=\\\"text-xl font-semibold text-gray-900 mb-1\\\">Basic Plan</h3>\\n            <p class=\\\"text-sm text-gray-600 mb-4 flex-grow min-h-[40px]\\\">Design anything and bring your ideas to life. No cost, just creativity.</p>\\n\\n            <div class=\\\"mb-6\\\">\\n                <p class=\\\"text-3xl font-bold text-gray-900\\\">US$0</p>\\n                <p class=\\\"text-xs text-gray-500\\\">/year for one person</p>\\n            </div>\\n\\n            <a href=\\\"#\\\" class=\\\"w-full block text-center bg-custom-gray hover:bg-custom-gray-dark text-white py-3 rounded-lg font-semibold transition duration-200 mb-6\\\">\\n                Get started\\n            </a>\\n\\n            <div class=\\\"border-t border-gray-200 pt-6\\\">\\n                 <h4 class=\\\"text-sm font-medium text-gray-800 mb-3\\\">Features you'll love:</h4>\\n                 <ul class=\\\"space-y-2 text-sm flex-grow\\\">\\n                    <li class=\\\"flex items-start\\\"><i class=\\\"fas fa-check text-purple-500 mr-2 mt-1 flex-shrink-0\\\"></i><span class=\\\"text-gray-700\\\">Feature A for basic tasks</span></li>\\n                    <li class=\\\"flex items-start\\\"><i class=\\\"fas fa-check text-purple-500 mr-2 mt-1 flex-shrink-0\\\"></i><span class=\\\"text-gray-700\\\">Standard Template Library (2M+)</span></li>\\n                    <li class=\\\"flex items-start\\\"><i class=\\\"fas fa-check text-purple-500 mr-2 mt-1 flex-shrink-0\\\"></i><span class=\\\"text-gray-700\\\">Common Design Types Included</span></li>\\n                    <li class=\\\"flex items-start\\\"><i class=\\\"fas fa-check text-purple-500 mr-2 mt-1 flex-shrink-0\\\"></i><span class=\\\"text-gray-700\\\">Access to Stock Photos (4M+)</span></li>\\n                    <li class=\\\"flex items-start\\\"><i class=\\\"fas fa-info-circle text-gray-400 mr-2 mt-1 flex-shrink-0\\\"></i><span class=\\\"text-gray-700\\\">Limited AI Creative Partner*</span></li>\\n                    <li class=\\\"flex items-start\\\"><i class=\\\"fas fa-info-circle text-gray-400 mr-2 mt-1 flex-shrink-0\\\"></i><span class=\\\"text-gray-700\\\">Basic Interactive Designs**</span></li>\\n                    <li class=\\\"flex items-start\\\"><i class=\\\"fas fa-info-circle text-gray-400 mr-2 mt-1 flex-shrink-0\\\"></i><span class=\\\"text-gray-700\\\">Standard Export Formats*</span></li>\\n                    <li class=\\\"flex items-start\\\"><i class=\\\"fas fa-check text-purple-500 mr-2 mt-1 flex-shrink-0\\\"></i><span class=\\\"text-gray-700\\\">Standard Print Options</span></li>\\n                    <li class=\\\"flex items-start\\\"><i class=\\\"fas fa-check text-purple-500 mr-2 mt-1 flex-shrink-0\\\"></i><span class=\\\"text-gray-700\\\">5GB of Cloud Storage</span></li>\\n                 </ul>\\n            </div>\\n        </div>\\n\\n        <!-- Card 2: Pro/Standard -->\\n        <div class=\\\"bg-custom-purple-light rounded-lg p-6 flex flex-col\\\">\\n             <div class=\\\"flex justify-between items-center mb-3\\\">\\n                <span class=\\\"text-xs bg-purple-200 text-purple-800 px-2 py-0.5 rounded-full font-medium\\\">For one person</span>\\n                <i class=\\\"fas fa-crown text-yellow-500\\\"></i> <!-- Crown Icon -->\\n            </div>\\n            <h3 class=\\\"text-xl font-semibold text-gray-900 mb-1\\\">Pro Plan</h3>\\n            <p class=\\\"text-sm text-gray-600 mb-4 flex-grow min-h-[40px]\\\">Unlock premium content, more powerful design tools, and AI features.</p>\\n\\n             <div class=\\\"mb-6\\\">\\n                <p class=\\\"text-3xl font-bold text-gray-900\\\">US$55</p>\\n                <p class=\\\"text-xs text-gray-500\\\">/year for one person</p>\\n            </div>\\n\\n            <a href=\\\"#\\\" class=\\\"w-full block text-center bg-custom-purple hover:bg-custom-purple-dark text-white py-3 rounded-lg font-semibold transition duration-200 mb-6\\\">\\n                Start a free trial\\n            </a>\\n\\n            <div class=\\\"border-t border-purple-200 pt-6\\\">\\n                 <h4 class=\\\"text-sm font-medium text-gray-800 mb-3\\\">Everything in Basic, plus:</h4>\\n                 <ul class=\\\"space-y-2 text-sm flex-grow\\\">\\n                    <li class=\\\"flex items-start\\\"><i class=\\\"fas fa-check text-purple-500 mr-2 mt-1 flex-shrink-0\\\"></i><span class=\\\"text-gray-700\\\">Unlimited access to premium templates</span></li>\\n                    <li class=\\\"flex items-start\\\"><i class=\\\"fas fa-check text-purple-500 mr-2 mt-1 flex-shrink-0\\\"></i><span class=\\\"text-gray-700\\\">Extensive Media Library (140M+)</span></li>\\n                    <li class=\\\"flex items-start\\\"><i class=\\\"fas fa-check text-purple-500 mr-2 mt-1 flex-shrink-0\\\"></i><span class=\\\"text-gray-700\\\">Brand Kit Management (1000 Kits)</span></li>\\n                    <li class=\\\"flex items-start\\\"><i class=\\\"fas fa-check text-purple-500 mr-2 mt-1 flex-shrink-0\\\"></i><span class=\\\"text-gray-700\\\">Quick Resize & Translate</span></li>\\n                    <li class=\\\"flex items-start\\\"><i class=\\\"fas fa-check text-purple-500 mr-2 mt-1 flex-shrink-0\\\"></i><span class=\\\"text-gray-700\\\">Remove Backgrounds Easily</span></li>\\n                    <li class=\\\"flex items-start\\\"><i class=\\\"fas fa-info-circle text-gray-400 mr-2 mt-1 flex-shrink-0\\\"></i><span class=\\\"text-gray-700\\\">Advanced Creation/Resize Tools*</span></li>\\n                    <li class=\\\"flex items-start\\\"><i class=\\\"fas fa-check text-purple-500 mr-2 mt-1 flex-shrink-0\\\"></i><span class=\\\"text-gray-700\\\">Boost creativity with 20+ AI tools^</span></li>\\n                    <li class=\\\"flex items-start\\\"><i class=\\\"fas fa-check text-purple-500 mr-2 mt-1 flex-shrink-0\\\"></i><span class=\\\"text-gray-700\\\">Plan and schedule social content</span></li>\\n                    <li class=\\\"flex items-start\\\"><i class=\\\"fas fa-check text-purple-500 mr-2 mt-1 flex-shrink-0\\\"></i><span class=\\\"text-gray-700\\\">1TB of cloud storage</span></li>\\n                    <li class=\\\"flex items-start\\\"><i class=\\\"fas fa-check text-purple-500 mr-2 mt-1 flex-shrink-0\\\"></i><span class=\\\"text-gray-700\\\">Online customer support</span></li>\\n                 </ul>\\n            </div>\\n        </div>\\n\\n        <!-- Card 3: Teams/Premium -->\\n        <div class=\\\"bg-custom-purple-light rounded-lg p-6 flex flex-col\\\">\\n            <div class=\\\"flex justify-between items-center mb-3\\\">\\n                <span class=\\\"text-xs bg-purple-200 text-purple-800 px-2 py-0.5 rounded-full font-medium\\\">For your team</span>\\n                 <i class=\\\"fas fa-crown text-yellow-500\\\"></i> <!-- Crown Icon -->\\n            </div>\\n            <h3 class=\\\"text-xl font-semibold text-gray-900 mb-1\\\">Teams Plan</h3>\\n            <p class=\\\"text-sm text-gray-600 mb-4 flex-grow min-h-[40px]\\\">Transform teamwork, grow your brand, and simplify workflows.</p>\\n\\n             <div class=\\\"mb-6\\\">\\n                <p class=\\\"text-3xl font-bold text-gray-900\\\">US$50</p>\\n                <p class=\\\"text-xs text-gray-500\\\">/year per person<br>Minimum 3 people (US$150/year)</p>\\n            </div>\\n\\n            <a href=\\\"#\\\" class=\\\"w-full block text-center bg-custom-purple hover:bg-custom-purple-dark text-white py-3 rounded-lg font-semibold transition duration-200 mb-2\\\">\\n                Start a free trial\\n            </a>\\n            <a href=\\\"#\\\" class=\\\"w-full block text-center text-sm text-custom-purple hover:underline py-2 mb-4\\\">\\n                Contact Sales\\n            </a>\\n\\n            <div class=\\\"border-t border-purple-200 pt-6\\\">\\n                 <h4 class=\\\"text-sm font-medium text-gray-800 mb-3\\\">Everything in Pro, plus:</h4>\\n                 <ul class=\\\"space-y-2 text-sm flex-grow\\\">\\n                    <li class=\\\"flex items-start\\\"><i class=\\\"fas fa-check text-purple-500 mr-2 mt-1 flex-shrink-0\\\"></i><span class=\\\"text-gray-700\\\">Scale your brand and centralize assets</span></li>\\n                    <li class=\\\"flex items-start\\\"><i class=\\\"fas fa-check text-purple-500 mr-2 mt-1 flex-shrink-0\\\"></i><span class=\\\"text-gray-700\\\">Ensure brand consistency with approvals</span></li>\\n                    <li class=\\\"flex items-start\\\"><i class=\\\"fas fa-check text-purple-500 mr-2 mt-1 flex-shrink-0\\\"></i><span class=\\\"text-gray-700\\\">Edit, comment, and collaborate in real time</span></li>\\n                    <li class=\\\"flex items-start\\\"><i class=\\\"fas fa-info-circle text-gray-400 mr-2 mt-1 flex-shrink-0\\\"></i><span class=\\\"text-gray-700\\\">Generate on-brand text and visual assets with AI^</span></li>\\n                    <li class=\\\"flex items-start\\\"><i class=\\\"fas fa-check text-purple-500 mr-2 mt-1 flex-shrink-0\\\"></i><span class=\\\"text-gray-700\\\">Team reports and insights</span></li>\\n                    <li class=\\\"flex items-start\\\"><i class=\\\"fas fa-info-circle text-gray-400 mr-2 mt-1 flex-shrink-0\\\"></i><span class=\\\"text-gray-700\\\">Import and sync data from external sources*</span></li>\\n                    <li class=\\\"flex items-start\\\"><i class=\\\"fas fa-check text-purple-500 mr-2 mt-1 flex-shrink-0\\\"></i><span class=\\\"text-gray-700\\\">AI admin controls</span></li>\\n                    <li class=\\\"flex items-start\\\"><i class=\\\"fas fa-check text-purple-500 mr-2 mt-1 flex-shrink-0\\\"></i><span class=\\\"text-gray-700\\\">ISO 27001 certification and SOC 2 Type II</span></li>\\n                    <li class=\\\"flex items-start\\\"><i class=\\\"fas fa-check text-purple-500 mr-2 mt-1 flex-shrink-0\\\"></i><span class=\\\"text-gray-700\\\">1TB of cloud storage per person</span></li>\\n                    <li class=\\\"flex items-start\\\"><i class=\\\"fas fa-check text-purple-500 mr-2 mt-1 flex-shrink-0\\\"></i><span class=\\\"text-gray-700\\\">Pay as you grow options</span></li>\\n                    <li class=\\\"flex items-start\\\"><i class=\\\"fas fa-check text-purple-500 mr-2 mt-1 flex-shrink-0\\\"></i><span class=\\\"text-gray-700\\\">Online customer support</span></li>\\n                 </ul>\\n            </div>\\n        </div>\\n\\n    </div> <!-- End Pricing Cards Grid -->\\n\\n    <!-- Bottom Disclaimer -->\\n    <div class=\\\"text-center mt-8\\\">\\n        <p class=\\\"text-xs text-gray-500\\\">