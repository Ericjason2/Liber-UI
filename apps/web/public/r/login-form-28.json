    "rawHtml": "<div\n    class=\"min-h-screen flex items-center justify-center bg-gradient-to-br from-[#EFF6FF] via-white to-[#DBEAFE] p-6\">\n\n    <!-- Login Card Here -->\n\n<div\n    class=\"w-full max-w-md overflow-hidden rounded-3xl bg-white shadow-[0_20px_60px_rgba(15,23,42,0.12)] border border-slate-200\">\n\n    <!-- Top Header -->\n    <div\n        class=\"bg-gradient-to-r from-[#1D4ED8] via-[#2563EB] to-[#3B82F6] px-10 py-8 text-white\">\n\n        <div class=\"flex items-center gap-4\">\n\n            <div\n                class=\"h-14 w-14 rounded-2xl bg-white/15 backdrop-blur flex items-center justify-center border border-white/20\">\n\n                <span class=\"text-2xl font-bold font-['Sora']\">\n                    A\n                </span>\n\n            </div>\n\n            <div>\n\n                <h2 class=\"text-2xl font-bold font-['Sora']\">\n                  \n                </h2>\n\n                <p class=\"text-blue-100 text-sm mt-1\">\n                    Management Dashboard\n                </p>\n\n            </div>\n\n        </div>\n\n    </div>\n\n    <!-- Login Section -->\n    <div class=\"p-10\">\n\n        <div class=\"mb-8\">\n\n            <h1 class=\"text-3xl font-bold text-slate-800 font-['Sora']\">\n                Welcome Back\n            </h1>\n\n            <p class=\"text-slate-500 mt-2\">\n                Login to continue managing your library.\n            </p>\n\n        </div>\n\n        <form\n            [formGroup]=\"loginForm\"\n            (ngSubmit)=\"login()\"\n            class=\"space-y-6\">\n\n            <!-- EMAIL -->\n\n            <div>\n\n                <label\n                    class=\"block mb-2 text-sm font-medium text-slate-700\">\n\n                    Email Address\n\n                </label>\n\n                <input\n                    type=\"email\"\n                    formControlName=\"username\"\n                    placeholder=\"you@example.com\"\n                    autocomplete=\"off\"\n                    (blur)=\"loginForm.controls.username.markAsTouched()\"\n                    class=\"h-12 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 outline-none transition focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100\" />\n\n            </div>\n\n            <!-- PASSWORD -->\n\n            <div>\n\n                <label\n                    class=\"block mb-2 text-sm font-medium text-slate-700\">\n\n                    Password\n\n                </label>\n\n                <div class=\"relative\">\n\n                    <input\n                        [type]=\"showPassword() ? 'text' : 'password'\"\n                        formControlName=\"password\"\n                        placeholder=\"••••••••\"\n                        autocomplete=\"off\"\n                        (blur)=\"loginForm.controls.password.markAsTouched()\"\n                        class=\"h-12 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 pr-12 outline-none transition focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100\" />\n\n                    <button\n                        type=\"button\"\n                        (click)=\"showPassword.set(!showPassword())\"\n                      \n\n                    </button>\n\n                </div>\n\n      \n            </div>\n\n            <!-- LOGIN -->\n\n            <button\n                type=\"submit\"\n                [disabled]=\"isLoading()\"\n                class=\"h-12 w-full rounded-xl bg-gradient-to-r from-[#2563EB] to-[#3B82F6] text-white font-semibold transition duration-300 hover:scale-[1.01] hover:shadow-xl disabled:opacity-60 flex items-center justify-center gap-2\">\n\n         \n\n                <svg\n                    class=\"w-5 h-5 animate-spin\"\n                    viewBox=\"0 0 24 24\">\n\n                    <circle\n                        class=\"opacity-25\"\n                        cx=\"12\"\n                        cy=\"12\"\n                        r=\"10\"\n                        stroke=\"currentColor\"\n                        stroke-width=\"4\"></circle>\n\n                    <path\n                        class=\"opacity-75\"\n                        fill=\"currentColor\"\n                        d=\"M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z\"></path>\n\n                </svg>\n\n\n            </button>\n\n        </form>\n\n\n\n        <div class=\"my-8 flex items-center\">\n\n            <div class=\"flex-1 border-t border-slate-200\"></div>\n\n            <span class=\"px-4 text-sm text-slate-400\">\n                OR\n            </span>\n\n            <div class=\"flex-1 border-t border-slate-200\"></div>\n\n        </div>\n\n\n        <p class=\"text-center text-sm text-slate-500\">\n\n            Don't have an account?\n\n            <a\n                routerLink=\"/auth/register\"\n                class=\"font-semibold text-blue-600 hover:text-blue-700\">\n\n                Create Account\n\n            </a>\n\n        </p>\n\n    </div>\n\n</div></div>"
