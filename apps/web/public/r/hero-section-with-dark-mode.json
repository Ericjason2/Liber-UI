      "content": "/**\n * Component: Hero Section with Dark Mode\n * Author: @rathanak-phan (https://tailwindflex.com/@rathanak-phan)\n * Source: https://tailwindflex.com/@rathanak-phan/hero-section-with-dark-mode\n * Attribution: Créé par @rathanak-phan sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function HeroSectionWithDarkMode() {\n  return (\n    <div>\n    \n    <section className=\"pt-24 md32 lg40 bg-white dark900 text-gray-900 dark transition-colors duration-300\">\n      <div className=\"max-w-7xl mx-auto px-5 sm10 lg20 flex flex-col-reverse md items-center gap-10\">\n        \n        \n        <div className=\"w-full md1/2 space-y-6\">\n          <h1 className=\"text-4xl md5xl lg6xl font-bold leading-tight\">\n            Welcome to <span className=\"text-green-700 dark400\">LoGo</span> Store\n          </h1>\n          <p className=\"text-lg md text-gray-700 dark300\">\n            Discover top-quality products and enjoy a smooth, secure shopping experience.\n          </p>\n          <div className=\"flex flex-wrap gap-4\">\n            <a href=\"/shop\" className=\"bg-blue-600 hover700 text-white px-6 py-3 rounded-md text-lg font-medium shadow-md transition\">\n              Shop Now\n            </a>\n            <a href=\"/about\" className=\"border border-blue-600 dark400 text-blue-600 dark400 hover100 dark800 px-6 py-3 rounded-md text-lg font-medium transition\">\n              Learn More\n            </a>\n          </div>\n        </div>\n    \n        \n        <div className=\"w-full md1/2\">\n          <img \n            src=\"https://images.unsplash.com/photo-1585386959984-a4155228c2ce?auto=format&fit=crop&w=800&q=80\" \n            alt=\"Happy woman shopping online\" \n            className=\"w-full rounded-lg shadow-lg object-cover\"\n          />\n        </div>\n      </div>\n    </section>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
