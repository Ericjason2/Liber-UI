    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Ethereal | Premium Experience</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <script>\n        tailwind.config = {\n            theme: {\n                extend: {\n                    colors: {\n                        'pearl': '#F5F3F0',\n                        'taupe': '#D8CFC6',\n                        'clay': '#B8A99A',\n                        'umber': '#6E5C4D',\n                        'slate': '#3A3630',\n                        'accent': '#C4A287',\n                        'accent-dark': '#9B7D66',\n                    },\n                    fontFamily: {\n                        'sans': ['\"Helvetica Now\"', 'sans-serif'],\n                        'display': ['\"GT Super\"', 'serif'],\n                    },\n                    animation: {\n                        'fade-in': 'fadeIn 1.5s ease-out',\n                    },\n                    keyframes: {\n                        fadeIn: {\n                            '0%': { opacity: '0', transform: 'translateY(20px)' },\n                            '100%': { opacity: '1', transform: 'translateY(0)' },\n                        }\n                    }\n                }\n            }\n        }\n    </script>\n    <style>\n        @import url('https://fonts.cdnfonts.com/css/helvetica-now');\n        @import url('https://fonts.cdnfonts.com/css/gt-super');\n        \n        body {\n            color: #3A3630;\n        }\n        \n        .hero-section {\n            background-image: url('https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2832&q=80');\n            background-position: center;\n            background-size: cover;\n            background-repeat: no-repeat;\n        }\n        \n        .hero-overlay {\n            background: linear-gradient(to right, rgba(245, 243, 240, 0.9) 0%, rgba(245, 243, 240, 0.4) 100%);\n        }\n        \n        .nav-blur {\n            backdrop-filter: blur(8px);\n            -webkit-backdrop-filter: blur(8px);\n        }\n        \n        .divider {\n            height: 1px;\n            background: linear-gradient(to right, transparent, rgba(58, 54, 48, 0.2), transparent);\n        }\n        \n        .product-image {\n            box-shadow: 0 25px 50px -12px rgba(58, 54, 48, 0.25);\n        }\n    </style>\n</head>\n<body class=\"font-sans\">\n    <!-- Navigation -->\n    <nav class=\"nav-blur fixed w-full z-50 border-b border-taupe/20\">\n        <div class=\"max-w-7xl mx-auto px-6\">\n            <div class=\"flex justify-between items-center h-20\">\n                <a href=\"#\" class=\"font-display text-xl text-slate\">ETHE<span class=\"text-accent\">REAL</span></a>\n                \n                <div class=\"hidden md:flex space-x-8\">\n                    <a href=\"#\" class=\"text-sm uppercase tracking-wider text-slate hover:text-accent transition-colors\">Collections</a>\n                    <a href=\"#\" class=\"text-sm uppercase tracking-wider text-slate hover:text-accent transition-colors\">Craftsmanship</a>\n                    <a href=\"#\" class=\"text-sm uppercase tracking-wider text-slate hover:text-accent transition-colors\">Journal</a>\n                    <a href=\"#\" class=\"text-sm uppercase tracking-wider text-slate hover:text-accent transition-colors\">Contact</a>\n                </div>\n                \n                <div class=\"flex items-center space-x-4\">\n                    <button class=\"p-2 text-slate hover:text-accent transition-colors\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" fill=\"currentColor\" viewBox=\"0 0 16 16\">\n                            <path d=\"M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z\"/>\n                        </svg>\n                    </button>\n                    <button class=\"p-2 text-slate hover:text-accent transition-colors\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" fill=\"currentColor\" viewBox=\"0 0 16 16\">\n                            <path d=\"M8 1a2.5 2.5 0 0 1 2.5 2.5V4h-5v-.5A2.5 2.5 0 0 1 8 1zm3.5 3v-.5a3.5 3.5 0 1 0-7 0V4H1v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V4h-3.5z\"/>\n                        </svg>\n                    </button>\n                    <button class=\"md:hidden p-2 text-slate hover:text-accent transition-colors\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" fill=\"currentColor\" viewBox=\"0 0 16 16\">\n                            <path fill-rule=\"evenodd\" d=\"M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z\"/>\n                        </svg>\n                    </button>\n                </div>\n            </div>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <section class=\"hero-section min-h-screen pt-20\">\n        <div class=\"hero-overlay min-h-screen flex items-center\">\n            <div class=\"max-w-7xl mx-auto px-6 py-24 w-full\">\n                <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-16 items-center\">\n                    <!-- Text content -->\n                    <div class=\"space-y-8 animate-fade-in\">\n                        <div class=\"space-y-4\">\n                            <p class=\"font-sans uppercase tracking-widest text-sm text-umber\">Premium Experience</p>\n                            <h1 class=\"font-display text-5xl md:text-6xl lg:text-7xl leading-tight text-slate\">\n                                <span class=\"block\">Timeless</span>\n                                <span class=\"block font-light\">Elegance</span>\n                            </h1>\n                            <div class=\"divider w-24 my-6\"></div>\n                            <p class=\"font-sans text-lg text-slate/80 max-w-md\">\n                                Where heritage craftsmanship meets contemporary design. Each piece tells a story of meticulous attention to detail.\n                            </p>\n                        </div>\n                        \n                        <div class=\"flex flex-col sm:flex-row gap-4 pt-4\">\n                            <a href=\"#\" class=\"px-8 py-3 bg-slate text-pearl font-sans text-sm tracking-wider uppercase hover:bg-umber transition-colors duration-300 text-center\">\n                                View Collection\n                            </a>\n                            <a href=\"#\" class=\"px-8 py-3 border border-slate text-slate font-sans text-sm tracking-wider uppercase hover:bg-slate/5 transition-colors duration-300 text-center\">\n                                Our Process\n                            </a>\n                        </div>\n                    </div>\n                    \n                    <!-- Image/content block -->\n                    <div class=\"hidden lg:block relative\">\n                        <div class=\"product-image overflow-hidden aspect-[4/5] bg-pearl/50 border border-taupe/20\">\n                            <img src=\"https://images.unsplash.com/photo-1539109136881-3be0616acf4b?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=687&q=80\" \n                                 alt=\"Premium product showcase\"\n                                 class=\"object-cover object-center w-full h-full\">\n                        </div>\n                        <div class=\"absolute -bottom-6 -right-6 bg-pearl p-6 text-slate shadow-lg w-48 border border-taupe/20\">\n                            <p class=\"font-display text-xl\">Handcrafted</p>\n                            <p class=\"font-sans text-sm mt-1 text-slate/70\">Since 1987</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Quality indicators -->\n    <div class=\"bg-pearl py-12 border-t border-taupe/30\">\n        <div class=\"max-w-7xl mx-auto px-6\">\n            <div class=\"grid grid-cols-2 md:grid-cols-4 gap-8 text-center\">\n                <div class=\"space-y-2\">\n                    <p class=\"font-display text-3xl text-accent-dark\">100%</p>\n                    <p class=\"font-sans uppercase text-xs tracking-widest text-slate/70\">Natural Materials</p>\n                </div>\n                <div class=\"space-y-2\">\n                    <p class=\"font-display text-3xl text-accent-dark\">24</p>\n                    <p class=\"font-sans uppercase text-xs tracking-widest text-slate/70\">Production Steps</p>\n                </div>\n                <div class=\"space-y-2\">\n                    <p class=\"font-display text-3xl text-accent-dark\">5Y</p>\n                    <p class=\"font-sans uppercase text-xs tracking-widest text-slate/70\">Warranty</p>\n                </div>\n                <div class=\"space-y-2\">\n                    <p class=\"font-display text-3xl text-accent-dark\">∞</p>\n                    <p class=\"font-sans uppercase text-xs tracking-widest text-slate/70\">Dedication</p>\n                </div>\n            </div>\n        </div>\n    </div>\n</body>\n</html>"
  }
}
