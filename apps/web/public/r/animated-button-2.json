      "content": "/**\n * Component: Animated Button\n * Author: @lautaro (https://tailwindflex.com/@lautaro)\n * Source: https://tailwindflex.com/@lautaro/animated-button-2\n * Attribution: Créé par @lautaro sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function AnimatedButton2() {\n  return (\n    <div>\n    <div className=\"p-4 flex flex-col items-center justify-center\">\n        <div className=\"cursor-pointer\">\n            <button className=\"relative inline-flex items-center justify-center px-6 py-3 overflow-hidden font-medium text-teal-600 transition duration-300 ease-out border-2 border-teal-500 rounded-full shadow-md group\">\n          <span className=\"absolute inset-0 flex items-center justify-center w-full h-full text-white duration-300 -translate- bg-teal-500 group-hover0 ease\">\n            <svg className=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"></path></svg>\n          </span>\n          <span className=\"absolute flex items-center justify-center w-full h-full text-teal-500 transition-all duration-300 transform group-hover ease\">Continue</span>\n          <span className=\"relative invisible\">Continue</span>\n        </button>\n        </div>\n    </div>\n    </div>\n  );\n}\n",
