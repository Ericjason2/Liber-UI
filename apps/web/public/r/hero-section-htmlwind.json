gap-1\">\n                  <span className=\"absolute inset-0\" aria-hidden=\"true\"></span>\n                  Explore our latest features\n                  <svg className=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\">\n                    <path d=\"M5 12H19M19 12L13 6M19 12L13 18\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\"></path>\n                  </svg>\n                </a>\n              </div>\n            </div>\n            <div className=\"sm\">\n              <h1 className=\"text-pretty text-4xl font-semibold tracking-tight text-gray-900 sm6xl\">Achieve more with less effort</h1>\n              <p className=\"mt-6 text-lg leading-8 text-gray-600\">Simplify your workflows and automate daily tasks with ease, saving time to focus on what matters most for your business.</p>\n            </div>\n            <div className=\"mt-10 flex items-center justify-start gap-6 sm\">\n              <a href=\"#\" className=\"inline-flex items-center justify-center gap-2 rounded-md bg-pink-500 px-3.5 py-2.5 text-center text-sm font-semibold text-white shadow-sm hover400 focus-visible focus-visible2 focus-visible2 focus-visible500\">\n                <svg className=\"h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                  <path d=\"M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12Z\" stroke=\"currentColor\" strokeWidth=\"2\" />\n                  <path d=\"M10.9 8.8L10.6577 8.66152C10.1418 8.36676 9.5 8.73922 9.5 9.33333L9.5 14.6667C9.5 15.2608 10.1418 15.6332 10.6577 15.3385L10.9 15.2L15.1 12.8C15.719 12.4463 15.719 11.5537 15.1 11.2L10.9 8.8Z\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" />\n                </svg>\n                Demo\n              </a>\n              <a href=\"#\" className=\"text-sm font-semibold leading-6 text-gray-900\">Learn more</a>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n    </div>\n  );\n}\n",
