    "rawHtml": "<div class=\"p-4 lg:mx-2\">\n  <div\n    class=\"bg-gradient-to-r from-green-900 to-green-600 text-white p-8 flex flex-col lg:flex-row rounded-2xl items-center lg:items-start lg:justify-between\">\n    <div class=\"lg:w-1/2 space-y-6 flex flex-col justify-start\">\n      <h2 class=\"text-sm uppercase font-semibold tracking-widest text-start\">\n        Premium Services\n      </h2>\n      <h1 class=\"text-4xl lg:text-5xl font-bold leading-tight text-start\">\n        Revolutionize your business with <span class=\"text-green-300\">innovative solutions</span>\n      </h1>\n      <p class=\"text-lg text-gray-300 text-start\">\n        Unlock cutting-edge tools and connect with the best professionals to drive success and growth. Achieve new heights in business operations.\n      </p>\n      <ul class=\"space-y-2\">\n        <li class=\"flex items-center space-x-2 text-start\">\n          <span class=\"text-green-300\">✓</span>\n          <span>Access top-tier experts to strengthen your team</span>\n        </li>\n        <li class=\"flex items-center space-x-2 text-start\">\n          <span class=\"text-green-300\">✓</span>\n          <span>Seamlessly manage projects and optimize workflows</span>\n        </li>\n        <li class=\"flex items-center space-x-2 text-start\">\n          <span class=\"text-green-300\">✓</span>\n          <span>Benefit from continuous support and end-to-end solutions</span>\n        </li>\n      </ul>\n      <button\n        class=\"bg-white text-green-900 font-bold py-2 px-4 rounded hover:bg-gray-200 transition\">\n        Discover More\n      </button>\n    </div>\n    <div class=\"hidden lg:flex lg:w-1/2 mt-8 lg:mt-0 justify-center\">\n      <img\n        src=\"https://images.unsplash.com/photo-1621060344848-262c81b806a2?w=400&auto=format&fit=crop&q=60&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxzZWFyY2h8Mnx8cGVwbGV8ZW58MHx8MHx8fDA%3D\"\n        alt=\"Business Solutions\"\n        class=\"rounded-lg shadow-lg h-full\" />\n    </div>\n  </div>\n</div>"
  }
