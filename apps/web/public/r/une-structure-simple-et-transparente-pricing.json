    "rawHtml": "<script src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js\"></script>\n\n<style>\n    .clean-row {\n        transition: background-color 0.4s ease, color 0.4s ease;\n    }\n    .pricing-card {\n        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.6s ease;\n    }\n    /* Effet au survol : élévation très légère et ombre diffuse */\n    .pricing-card:hover {\n        transform: translateY(-5px);\n        box-shadow: 0 30px 60px -12px rgba(0,0,0,0.05);\n    }\n    /* Indicateur de ligne active (discret) */\n    .active-row-bg {\n        background-color: #f9fafb !important;\n        color: #6366f1 !important;\n    }\n</style>\n\n<section class=\"bg-white text-gray-600 body-font py-24\">\n  <div class=\"container px-5 mx-auto\">\n    \n    <div class=\"text-center mb-20\">\n      <h2 class=\"text-xs text-indigo-500 tracking-widest font-medium title-font mb-1 uppercase\">Tarification</h2>\n      <h1 class=\"sm:text-3xl text-2xl font-light title-font text-gray-900\">Une structure simple et transparente.</h1>\n    </div>\n\n    <div class=\"flex flex-wrap lg:w-full mx-auto overflow-hidden\">\n      \n      <div class=\"lg:w-1/4 hidden lg:block mt-32 border-r border-gray-100\">\n        <div class=\"flex flex-col text-left\">\n          <p class=\"h-12 px-4 flex items-center text-xs font-bold uppercase text-gray-400\">Stratégie</p>\n          <p class=\"label-item h-12 px-4 flex items-center text-sm border-b border-gray-50\">Social Media Strategy</p>\n          <p class=\"label-item h-12 px-4 flex items-center text-sm border-b border-gray-50\">Analyse Vidéo</p>\n          <p class=\"label-item h-12 px-4 flex items-center text-sm border-b border-gray-50\">Veille Concurrentielle</p>\n          \n          <p class=\"h-12 px-4 flex items-center text-xs font-bold uppercase text-gray-400 mt-4\">Canaux</p>\n          <p class=\"label-item h-12 px-4 flex items-center text-sm border-b border-gray-50\">LinkedIn & Instagram</p>\n          <p class=\"label-item h-12 px-4 flex items-center text-sm border-b border-gray-50\">Facebook & TikTok</p>\n          \n          <p class=\"h-12 px-4 flex items-center text-xs font-bold uppercase text-gray-400 mt-4\">Investissement</p>\n          <p class=\"label-item h-12 px-4 flex items-center text-sm font-semibold\">Abonnement Mensuel</p>\n        </div>\n      </div>\n\n      <div class=\"lg:w-3/4 w-full flex flex-wrap\">\n        \n        <div class=\"pricing-card lg:w-1/3 w-full border-b lg:border-b-0 lg:border-r border-gray-100\">\n          <div class=\"p-8 text-center h-32 flex flex-col justify-center\">\n            <span class=\"text-xs text-gray-400 uppercase tracking-widest mb-1\">Essentiel</span>\n            <p class=\"text-2xl text-gray-900 font-light italic\">Small</p>\n          </div>\n          <div class=\"feature-rows\">\n            <p class=\"h-12 flex items-center justify-center border-t border-gray-50 text-green-400\">✓</p>\n            <p class=\"h-12 flex items-center justify-center border-t border-gray-50 text-gray-200\">—</p>\n            <p class=\"h-12 flex items-center justify-center border-t border-gray-50 text-gray-200\">—</p>\n            <p class=\"h-12 mt-4 flex items-center justify-center border-t border-gray-50 text-green-400\">✓</p>\n            <p class=\"h-12 flex items-center justify-center border-t border-gray-50 text-gray-200\">—</p>\n            <p class=\"h-24 flex items-center justify-center border-t border-gray-50 text-gray-900 font-semibold text-xl\">10k <span class=\"text-xs text-gray-400 ml-1\">SEK</span></p>\n          </div>\n        </div>\n\n        <div class=\"pricing-card lg:w-1/3 w-full bg-gray-50/50 lg:border-r border-gray-100\">\n          <div class=\"p-8 text-center h-32 flex flex-col justify-center relative\">\n            <span class=\"text-xs text-indigo-500 font-bold uppercase tracking-widest mb-1\">Populaire</span>\n            <p class=\"text-2xl text-gray-900 font-light italic\">Medium</p>\n          </div>\n          <div class=\"feature-rows\">\n            <p class=\"h-12 flex items-center justify-center border-t border-white text-green-400\">✓</p>\n            <p class=\"h-12 flex items-center justify-center border-t border-white text-green-400\">✓</p>\n            <p class=\"h-12 flex items-center justify-center border-t border-white text-gray-200\">—</p>\n            <p class=\"h-12 mt-4 flex items-center justify-center border-t border-white text-green-400\">✓</p>\n            <p class=\"h-12 flex items-center justify-center border-t border-white text-green-400\">✓</p>\n            <p class=\"h-24 flex items-center justify-center border-t border-white text-indigo-600 font-semibold text-2xl\">35k <span class=\"text-xs text-gray-400 ml-1\">SEK</span></p>\n          </div>\n        </div>\n\n        <div class=\"pricing-card lg:w-1/3 w-full\">\n          <div class=\"p-8 text-center h-32 flex flex-col justify-center\">\n            <span class=\"text-xs text-gray-400 uppercase tracking-widest mb-1\">Complet</span>\n            <p class=\"text-2xl text-gray-900 font-light italic\">Large</p>\n          </div>\n          <div class=\"feature-rows\">\n            <p class=\"h-12 flex items-center justify-center border-t border-gray-50 text-green-400\">✓</p>\n            <p class=\"h-12 flex items-center justify-center border-t border-gray-50 text-green-400\">✓</p>\n            <p class=\"h-12 flex items-center justify-center border-t border-gray-50 text-green-400\">✓</p>\n            <p class=\"h-12 mt-4 flex items-center justify-center border-t border-gray-50 text-green-400\">✓</p>\n            <p class=\"h-12 flex items-center justify-center border-t border-gray-50 text-green-400\">✓</p>\n            <p class=\"h-24 flex items-center justify-center border-t border-gray-50 text-gray-900 font-semibold text-xl\">49k <span class=\"text-xs text-gray-400 ml-1\">SEK</span></p>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  </div>\n</section>\n\n<script>\n  // Animation d'apparition en fondu (Fade-in)\n  gsap.from(\".pricing-card\", {\n    opacity: 0,\n    y: 20,\n    duration: 1,\n    stagger: 0.15,\n    ease: \"power2.out\"\n  });\n\n  // Interaction pour mettre en évidence la ligne sans alourdir le design\n  const featureRows = document.querySelectorAll('.feature-rows p');\n  const labels = document.querySelectorAll('.label-item');\n\n  featureRows.forEach((row, index) => {\n    row.addEventListener('mouseenter', () => {\n        // On récupère l'index de la ligne au sein de son conteneur\n        const rowIndex = Array.from(row.parentNode.children).indexOf(row);\n        if(labels[rowIndex]) labels[rowIndex].classList.add('active-row-bg');\n        row.classList.add('active-row-bg');\n    });\n    row.addEventListener('mouseleave', () => {\n        labels.forEach(l => l.classList.remove('active-row-bg'));\n        row.classList.remove('active-row-bg');\n    });\n  });\n</script>"
  }
