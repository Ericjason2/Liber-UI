adio\\\">\\n\\t\\t\\t<label class=\\\"flex flex-col p-4 border-2 border-gray-400 cursor-pointer\\\" for=\\\"radio_3\\\">\\n\\t\\t\\t\\t<span class=\\\"text-xs font-semibold uppercase\\\">Big</span>\\n\\t\\t\\t\\t<span class=\\\"text-xl font-bold mt-2\\\">$100/mo</span>\\n\\t\\t\\t\\t<ul class=\\\"text-sm mt-2\\\">\\n\\t\\t\\t\\t\\t<li>Thing 1</li>\\n\\t\\t\\t\\t\\t<li>Thing 2</li>\\n\\t\\t\\t\\t</ul>\\n\\t\\t\\t</label>\\n\\t\\t</div>\\n\\t</form>\\n\\t<!-- Component End  -->\\n\\n</div>\" }} />\n  );\n}\n",
