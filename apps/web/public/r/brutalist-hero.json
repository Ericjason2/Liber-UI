      "content": "/**\n * Component: Brutalist Hero\n * Author: @threehymns (https://tailwindflex.com/@threehymns)\n * Source: https://tailwindflex.com/@threehymns/brutalist-hero\n * Attribution: Créé par @threehymns sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function BrutalistHero() {\n  return (\n    <div>\n    <div className=\"p-10 sm10 m-5 rounded-3xl bg-gray-900 dark900 dark bg-white text-black flex items-center justify-center overflow-hidden shadow-2xl\">\n      <div className=\"w-full max-w-6xl px-4 sm6\">\n        <div className=\"grid grid-cols-1 gap-8 md2\">\n          \n          <div className=\"flex flex-col justify-center text-center md z-10\">\n            <h1 className=\"text-4xl sm4xl md5xl lg8xl font-extrabold uppercase leading-tight tracking-tight\">\n              Design with <span className=\"text-yellow-500\">Impact</span>\n            </h1>\n            <p className=\"mt-4 text-base sm md font-medium text-gray-400 dark400 text-gray-700 text-balance\">\n              Brutal aesthetics for a bold web presence. Build without compromise.\n            </p>\n            <div className=\"mt-6 sm8 flex flex-wrap gap-4\">\n              <a href=\"#get-started\" className=\"rounded-sm p-3 grow text-center bg-yellow-500 text-black font-bold uppercase text-sm tracking-widest hover600 transition\">\n                Get Started\n              </a>\n              <a href=\"#learn-more\" className=\"rounded-sm p-3 grow border text-center border-yellow-500 text-yellow-500 font-bold uppercase text-sm tracking-widest hover500 hover transition\">\n                Learn More\n              </a>\n            </div>\n          </div>\n    \n          \n          <div className=\"relative flex items-center sm10\">\n            <div\n              className=\"absolute -top-10 md20 -left-10 sm32 sm32 lg64 lg64 bg-yellow-500 rotate-12 rounded-lg border-yellow-700 border-b-4 border-r-8 max-sm\">\n            </div>\n            <div className=\"relative z-10 bg-gray-800 dark800 p-4 sm6 -right-1/2 -translate-x-1/2 grow text-center shadow-2xl -rotate-2 rounded-xl text-nowrap border-slate-950 border-b-4 border-r-8\">\n              <h2 className=\"text-2xl sm3xl font-bold uppercase text-gray-50 dark50\">\n                Bold. Strong. Raw.\n              </h2>\n              <p className=\"mt-1 text-sm sm font-light text-gray-400 dark400\">\n                Embrace minimalism with maximal impact.\n              </p>\n            </div>\n            <div className=\"absolute -bottom-10 md20 -right-16 sm32 sm32 lg64 lg64 bg-yellow-500 -rotate-12 rounded-lg border-yellow-700 border-r-4 border-b-8 max-sm\"></div>\n          </div>\n        </div>\n      </div>\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
