      "content": "/**\n * Component: Modern SAAS Hero Section\n * Author: @mdadul (https://tailwindflex.com/@mdadul)\n * Source: https://tailwindflex.com/@mdadul/modern-saas-hero-section\n * Attribution: Créé par @mdadul sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function ModernSaasHeroSection() {\n  return (\n    <div>\n    <section className=\"pt-8 lg32 bg-[url('https://pagedone.io/asset/uploads/1691055810.png')] bg-center bg-cover\">\n        <div className=\"mx-auto max-w-7xl px-4 sm6 lg8 relative text-center\">\n            <div className=\"border border-indigo-600 p-1 w-60 mx-auto rounded-full flex items-center justify-between mb-4\">\n                <span className=\"font-inter text-xs font-medium text-gray-900 ml-3\"\n                >Explore how to use for brands.</span>\n                <a href=\"#\" className=\"w-8 h-8 rounded-full flex justify-center items-center bg-indigo-600\">\n                    <svg width=\"17\" height=\"16\" viewBox=\"0 0 17 16\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                        <path\n                            d=\"M2.83398 8.00019L12.9081 8.00019M9.75991 11.778L13.0925 8.44541C13.3023 8.23553 13.4073 8.13059 13.4073 8.00019C13.4073 7.86979 13.3023 7.76485 13.0925 7.55497L9.75991 4.22241\"\n                            stroke=\"white\" strokeWidth=\"1.6\" strokeLinecap=\"round\" strokeLinejoin=\"round\" />\n                    </svg>\n                </a>\n            </div>\n            <h1\n                className=\"max-w-2xl mx-auto text-center font-manrope font-bold text-4xl text-gray-900 mb-5 md5xl leading-[50px]\">\n                Control your Finances with our\n                <span className=\"text-indigo-600\">Smart Tool </span>\n            </h1>\n            <p className=\"max-w-sm mx-auto text-center text-base font-normal leading-7 text-gray-500 mb-9\">\n                Invest intelligently and discover a better way to manage your entire\n                wealth easily.\n            </p>\n            <a href=\"#\"\n                className=\"w-full md mb-14 inline-flex items-center justify-center py-3 px-7 text-base font-semibold text-center text-white rounded-full bg-indigo-600 shadow-xs hover700 transition-all duration-500\">\n                Create an account\n                <svg className=\"ml-2\" width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                    <path\n                        d=\"M7.5 15L11.0858 11.4142C11.7525 10.7475 12.0858 10.4142 12.0858 10C12.0858 9.58579 11.7525 9.25245 11.0858 8.58579L7.5 5\"\n                        stroke=\"white\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" />\n                </svg>\n            </a>\n            <div className=\"flex justify-center\">\n                <img\n                src=\"https://pagedone.io/asset/uploads/1691054543.png\"\n                alt=\"Dashboard image\"\n              />\n            </div>\n        </div>\n    </section>\n    </div>\n  );\n}\n",
