      "content": "import * as React from \"react\"\n\nfunction NextjsProfileCardTailwind({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"nextjs-profile-card-tailwind\"\n      className={className}\n      {...props}\n    >\n      \n      <div className=\"flex bg-[#f0feff] justify-center items-center h-screen\">\n          <div className=\"max-w-[490px] rounded-lg w-[100%] overflow-hidden bg-white shadow-[0_0_1rem_rgba(0,0,0,0.2)] \">\n              <div className=\"card\">\n                  <div className=\"grid grid-cols-5\">\n                      <div className=\"col-span-2 p-3\">\n                          <img src=\"https://svgshare.com/i/16D0.svg\" alt=\"demo\" />\n                      </div>\n                      <div className=\"col-span-3 p-3\">\n                          <div className=\"font-bold\">Darlene Robertson</div>\n                          <div className=\"mb-3\">Senior Journalist</div>\n                          <div\n                              className=\"card flex justify-between items-center text-gray-500 bg-gray-200 focus rounded-lg p-2\">\n                              <div className=\"text-center\">\n                                  <p className=\"text-sm\">Articles</p>\n                                  <p className=\"font-bold text-gray-800\">37</p>\n                              </div>\n                              <div className=\"text-center\">\n                                  <p className=\"text-sm\">Followers</p>\n                                  <p className=\"font-bold text-gray-800\">850</p>\n                              </div>\n                              <div className=\"text-center\">\n                                  <p className=\"text-sm\">Rating</p>\n                                  <p className=\"font-bold text-gray-800 flex gap-1\">\n                                      <img src=\"https://svgshare.com/i/16Fg.svg\" />\n                                          9.5\n                                  </p>\n                              </div>\n                          </div>\n                          <div className=\"flex mt-3 gap-2\">\n                              <button className=\"bg-white text-gray-500 py-2 px-4 rounded-lg border-2 hover400 flex-1\">\n                                    Chat\n                                  </button>\n                              <button className=\"bg-blue-500 text-white py-2 px-4 rounded-lg hover700 flex-1\">\n                                    Follow\n                                  </button>\n                          </div>\n                      </div>\n                  </div>\n              </div>\n          </div>\n      </div>\n    </div>\n  )\n}\n\nexport { NextjsProfileCardTailwind }\n",
      "type": "registry:ui"
    }
