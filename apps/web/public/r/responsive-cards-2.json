      "content": "import * as React from \"react\"\n\nfunction ResponsiveCards2({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"responsive-cards-2\"\n      className={className}\n      {...props}\n    >\n      <div className=\"responsive-grid\">\n          \n          <div className=\"grid-item\">\n              <div className=\"card-image-wrapper\">\n                  <div className=\"card-image\"></div>\n              </div>\n              <div className=\"card-content\">\n                  <h3>Modern 3D Card</h3>\n                  <p>Hover over this card to see the 3D elevation and glow effect.</p>\n                  <div className=\"tags\">\n                      <span>UI Design</span>\n                      <span>3D</span>\n                  </div>\n              </div>\n          </div>\n      \n          <div className=\"grid-item\">\n              <div className=\"card-image-wrapper\">\n                  <div className=\"card-image gradient-2\"></div>\n              </div>\n              <div className=\"card-content\">\n                  <h3>Glassmorphism</h3>\n                  <p>Combines 3D depth with modern frosted glass aesthetics.</p>\n                  <div className=\"tags\">\n                      <span>CSS</span>\n                      <span>Modern</span>\n                  </div>\n              </div>\n          </div>\n      \n          <div className=\"grid-item\">\n              <div className=\"card-image-wrapper\">\n                  <div className=\"card-image gradient-3\"></div>\n              </div>\n              <div className=\"card-content\">\n                  <h3>Interactive Elements</h3>\n                  <p>Elements that react to user interaction creates immersion.</p>\n                  <div className=\"tags\">\n                      <span>UX</span>\n                  </div>\n              </div>\n          </div>\n          \n          </div>\n    </div>\n  )\n}\n\nexport { ResponsiveCards2 }\n",
      "type": "registry:ui"
    }
  ],
  "meta": {
    "kind": "component",
