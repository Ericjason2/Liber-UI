    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Sign in - Acme Cloud</title>\n  <script src=\"https://cdn.tailwindcss.com/3.4.17\"></script>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap\"\n    rel=\"stylesheet\">\n</head>\n\n<body class=\"min-h-screen antialiased bg-slate-100 text-slate-900\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n  <main class=\"min-h-screen flex items-center justify-center p-4 sm:p-6\">\n\n    <section\n      class=\"w-full max-w-md bg-white rounded-3xl p-8 sm:p-10 border border-slate-200 shadow-[0_20px_50px_-20px_rgba(15,23,42,0.15)]\">\n      <div class=\"flex items-center gap-2.5 mb-8\">\n        <div class=\"h-9 w-9 rounded-xl bg-slate-900 text-white grid place-items-center font-black\">A</div>\n        <span class=\"font-bold text-lg tracking-tight\">Acme Cloud</span>\n      </div>\n      <h1 class=\"text-2xl font-extrabold tracking-tight\">Welcome back</h1>\n      <p class=\"text-sm text-slate-500 mt-1\">Sign in to pick up where you left off.</p>\n      <div class=\"grid grid-cols-2 gap-3 mt-7\">\n        <button type=\"button\"\n          class=\"flex items-center justify-center gap-2.5 bg-white hover:bg-slate-50 border border-slate-200 rounded-xl py-3 text-sm font-semibold text-slate-700 transition focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-slate-900/10\"><svg\n            class=\"w-5 h-5\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path fill=\"#4285F4\"\n              d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z\" />\n            <path fill=\"#34A853\"\n              d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\" />\n            <path fill=\"#FBBC05\"\n              d=\"M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z\" />\n            <path fill=\"#EA4335\"\n              d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z\" />\n          </svg> Google</button>\n        <button type=\"button\"\n          class=\"flex items-center justify-center gap-2.5 bg-white hover:bg-slate-50 border border-slate-200 rounded-xl py-3 text-sm font-semibold text-slate-700 transition focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-slate-900/10\"><svg\n            class=\"w-5 h-5 fill-slate-900\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path\n              d=\"M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z\" />\n          </svg> GitHub</button>\n      </div>\n      <div class=\"flex items-center gap-3 my-6 text-xs text-slate-400\"><span class=\"h-px flex-1 bg-slate-200\"></span>or\n        use email<span class=\"h-px flex-1 bg-slate-200\"></span></div>\n      <form data-form class=\"space-y-4\" novalidate>\n        <div>\n          <label for=\"email\" class=\"text-sm font-semibold text-slate-700 block mb-1.5\">Work email</label>\n          <input id=\"email\" type=\"email\" required autocomplete=\"email\" placeholder=\"you@company.com\"\n            class=\"w-full px-4 py-3 text-sm rounded-xl bg-slate-50 border border-slate-200 text-slate-900 placeholder-slate-400 transition focus:bg-white focus:border-slate-900 focus:outline-none focus:ring-4 focus:ring-slate-900/10\">\n        </div>\n        <div>\n          <div class=\"flex items-center justify-between mb-1.5\">\n            <label for=\"pw\" class=\"text-sm font-semibold text-slate-700\">Password</label><a href=\"#\"\n              class=\"text-sm font-semibold text-indigo-600 hover:text-indigo-700\">Forgot password?</a>\n          </div>\n          <div class=\"relative\">\n            <input id=\"pw\" type=\"password\" required minlength=\"6\" autocomplete=\"current-password\"\n              placeholder=\"Enter your password\"\n              class=\"w-full px-4 py-3 text-sm rounded-xl bg-slate-50 border border-slate-200 text-slate-900 placeholder-slate-400 transition focus:bg-white focus:border-slate-900 focus:outline-none focus:ring-4 focus:ring-slate-900/10 pr-16\">\n            <button type=\"button\" data-toggle=\"pw\" aria-pressed=\"false\"\n              class=\"absolute right-3 top-1/2 -translate-y-1/2 text-xs font-semibold text-slate-500 hover:text-slate-900 focus-visible:outline-none focus-visible:underline\">Show</button>\n          </div>\n        </div>\n        <button type=\"submit\" data-loading=\"Signing in...\"\n          class=\"w-full bg-slate-900 hover:bg-slate-800 text-white font-bold text-sm py-3.5 rounded-xl transition active:scale-[0.99] focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-slate-900/30\">Sign\n          in</button>\n      </form>\n      <p class=\"text-center text-sm text-slate-500 mt-7\">New to Acme? <a href=\"#\"\n          class=\"font-bold text-slate-900 hover:underline\">Create an account</a></p>\n    </section>\n  </main>\n  <script>\n    const SPIN = '<svg class=\"animate-spin h-4 w-4 inline-block mr-2 -mt-0.5\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><circle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\"/><path class=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z\"/></svg>';\n    document.querySelectorAll('[data-toggle]').forEach(b => b.addEventListener('click', () => {\n      const i = document.getElementById(b.dataset.toggle), show = i.type === 'password';\n      i.type = show ? 'text' : 'password'; b.textContent = show ? 'Hide' : 'Show'; b.setAttribute('aria-pressed', show);\n    }));\n    document.querySelectorAll('form[data-form]').forEach(f => f.addEventListener('submit', e => {\n      e.preventDefault();\n      if (!f.checkValidity()) {f.reportValidity(); return;}\n      const b = f.querySelector('[type=submit]'), old = b.innerHTML;\n      b.disabled = true; b.classList.add('opacity-80', 'cursor-wait'); b.innerHTML = SPIN + (b.dataset.loading || 'Please wait...');\n      setTimeout(() => {b.disabled = false; b.classList.remove('opacity-80', 'cursor-wait'); b.innerHTML = old;}, 1600);\n    }));\n  </script>\n</body>\n\n</html>"
