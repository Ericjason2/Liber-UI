o group cursor-pointer\\\">\\n            <!-- Imagen Wrapper -->\\n            <div class=\\\"h-72 w-full bg-black rounded-[2rem] overflow-hidden relative\\\">\\n                <!-- Imagen con efecto ZOOM al hacer hover en la tarjeta (group-hover:scale-110) -->\\n                <img src=\\\"https://images.unsplash.com/photo-1541873676-a18131494184?q=80&w=1000&auto=format&fit=crop\\\" \\n                     alt=\\\"Astronauta\\\" \\n                     class=\\\"w-full h-full object-cover grayscale contrast-125 object-top transition-transform duration-700 ease-in-out group-hover:scale-110\\\">\\n            </div>\\n\\n            <!-- Contenido -->\\n            <div class=\\\"px-5 pb-5 pt-6\\\">\\n                <h2 class=\\\"text-2xl font-bold text-gray-900 leading-tight mb-3 group-hover:text-black transition-colors\\\">\\n                    Crafting a Timeless Brand Identity\\n                </h2>\\n                <p class=\\\"text-gray-500 text-sm leading-relaxed mb-8\\\">\\n                    We're a small team in Berlin doing design work for brands that want to stand out.\\n                </p>\\n\\n                <!-- Footer -->\\n                <div class=\\\"flex justify-between items-center text-xs font-semibold text-gray-900\\\">\\n                    <span class=\\\"opacity-80\\\">5 min read</span>\\n                    \\n                    <div class=\\\"flex items-center gap-1\\\">\\n                        <svg xmlns=\\\"http://www.w3.org/2000/svg\\\" class=\\\"h-4 w-4 text-green-500 fill-current\\\" viewBox=\\\"0 0 24 24\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\">\\n                            <path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" d=\\\"M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z\\\" />\\n                        </svg>\\n                        <span>320</span>\\n                    </div>\\n                </div>\\n            </div>\\n        </div>\\n\\n        <!-- TARJETA OSCURA (Dark Card) -->\\n        <div class=\\\"relative bg-black rounded-[2rem] overflow-hidden shadow-2xl transition-transform hover:scale-[1.01] duration-300 w-full max-w-sm mx-auto group cursor-pointer\\\">\\n            \\n            <!-- Contenedor de Imagen -->\\n            <div class=\\\"absolute inset-0 h-full w-full overflow-hidden\\\">\\n                <!-- Imagen de fondo con ZOOM más dramático -->\\n                <img src=\\\"https://images.unsplash.com/photo-1446776811953-b23d57bd21aa?q=80&w=1000&auto=format&fit=crop\\\" \\n                     alt=\\\"Astronauta en la luna\\\" \\n                     class=\\\"w-full h-[85%] object-cover grayscale contrast-125 object-center opacity-80 transition-transform duration-700 ease-in-out group-hover:scale-110\\\">\\n                \\n                <div class=\\\"noise-overlay\\\"></div>\\n\\n                <!-- Degradados -->\\n                <div class=\\\"absolute inset-0 bg-gradient-to-b from-black/10 via-transparent to-transparent\\\"></div>\\n                <div class=\\\"absolute inset-0 bg-gradient-to-t from-black via-black/90 to-transparent top-1/3\\\"></div>\\n            </div>\\n\\n            <!-- Contenido -->\\n            <div class=\\\"relative z-10 flex flex-col justify-end h-full p-8 pt-72\\\">\\n                <h2 class=\\\"text-2xl font-bold text-white leading-tight mb-3 drop-shadow-md group-hover:text-gray-100 transition-colors\\\">\\n                    Crafting a Timeless Brand Identity\\n                </h2>\\n                <p class=\\\"text-gray-400 text-sm leading-relaxed mb-8\\\">\\n                    We're a small team in Berlin doing design work for brands that want to stand out.\\n                </p>\\n\\n                <!-- Footer -->\\n                <div class=\\\"flex justify-between items-center text-xs font-semibold text-gray-300\\\">\\n                    <span class=\\\"opacity-80\\\">5 min read</span>\\n                    \\n                    <div class=\\\"flex items-center gap-1\\\">\\n                        <svg xmlns=\\\"http://www.w3.org/2000/svg\\\" class=\\\"h-4 w-4 text-green-500 fill-current\\\" viewBox=\\\"0 0 24 24\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\">\\n                            <path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" d=\\\"M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z\\\" />\\n                        </svg>\\n                        <span class=\\\"text-white\\\">320</span>\\n                    </div>\\n                </div>\\n            </div>\\n        </div>\\n\\n    </div>\\n\\n</body>\\n</html>\" }} />\n  );\n}\n",
