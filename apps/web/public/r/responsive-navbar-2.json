      "path": "ui/responsive-navbar-2.tsx",
      "content": "/**\n * Component: Responsive Navbar\n * Author: @tofayel-islam (https://tailwindflex.com/@tofayel-islam)\n * Source: https://tailwindflex.com/@tofayel-islam/responsive-navbar-2\n * Attribution: Créé par @tofayel-islam sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function ResponsiveNavbar2() {\n  return (\n    <div>\n    <nav className=\"bg-white border-gray-200 dark900\">\n      <div className=\"max-w-screen-xl flex flex-wrap items-center justify-between mx-auto p-4\">\n        <a href=\"#\" className=\"flex items-center space-x-3 rtl\">\n            <img src=\"#\" className=\"h-8\" alt=\"Logo\" />\n            <span className=\"self-center text-2xl font-semibold whitespace-nowrap dark\">logo</span>\n        </a>\n        <button data-collapse-toggle=\"navbar-default\" type=\"button\" className=\"inline-flex items-center p-2 w-10 h-10 justify-center text-sm text-gray-500 rounded-lg md hover100 focus focus2 focus200 dark400 dark700 dark600\" aria-controls=\"navbar-default\" aria-expanded=\"false\">\n            <span className=\"sr-only\">Open main menu</span>\n            <svg className=\"w-5 h-5\" aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 17 14\">\n                <path stroke=\"currentColor\" strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"M1 1h15M1 7h15M1 13h15\"/>\n            </svg>\n        </button>\n        <div className=\"hidden w-full md md\" id=\"navbar-default\">\n          <ul className=\"font-medium flex flex-col p-4 md0 mt-4 border border-gray-100 rounded-lg bg-gray-50 md md8 rtl md0 md0 md dark800 md900 dark700\">\n            <li>\n              <a href=\"#\" className=\"block py-2 px-3 text-white bg-blue-700 rounded md md700 md0 dark md500\" aria-current=\"page\">Home</a>\n            </li>\n            <li>\n              <a href=\"#\" className=\"block py-2 px-3 text-gray-900 rounded hover100 md md0 md700 md0 dark md500 dark700 dark md\">About</a>\n            </li>\n            <li>\n              <a href=\"#\" className=\"block py-2 px-3 text-gray-900 rounded hover100 md md0 md700 md0 dark md500 dark700 dark md\">Services</a>\n            </li>\n            <li>\n              <a href=\"#\" className=\"block py-2 px-3 text-gray-900 rounded hover100 md md0 md700 md0 dark md500 dark700 dark md\">Pricing</a>\n            </li>\n            <li>\n              <a href=\"#\" className=\"block py-2 px-3 text-gray-900 rounded hover100 md md0 md700 md0 dark md500 dark700 dark md\">Contact</a>\n            </li>\n          </ul>\n        </div>\n      </div>\n    </nav>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
