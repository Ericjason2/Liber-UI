      "content": "/**\n * Component: Portfolio by omerlinks the mouse\n * Author: @omer-fils-elenga (https://tailwindflex.com/@omer-fils-elenga)\n * Source: https://tailwindflex.com/@omer-fils-elenga/portfolio-by-omerlinks-the-mouse\n * Attribution: Créé par @omer-fils-elenga sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function PortfolioByOmerlinksTheMouse() {\n  return (\n    <div dangerouslySetInnerHTML={{ __html: \"<!DOCTYPE html>\\n<html lang=\\\"fr\\\">\\n<head>\\n    <meta charset=\\\"UTF-8\\\">\\n    <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\">\\n    <title>Portfolio Créatif | Mode & Design</title>\\n    \\n    \\n    \\n    \\n    <link href=\\\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;600&display=swap\\\" rel=\\\"stylesheet\\\">\\n    \\n    <style>\\n        body {\\n            font-family: 'Inter', sans-serif;\\n            background-color: #fdfdfd;\\n            color: #1a1a1a;\\n            overflow-x: hidden;\\n        }\\n        h1, h2, .font-serif {\\n            font-family: 'Playfair Display', serif;\\n        }\\n        .parallax-bg {\\n            will-change: transform;\\n        }\\n        .reveal {\\n            opacity: 0;\\n            transform: translateY(30px);\\n        }\\n        .custom-cursor {\\n            width: 20px;\\n            height: 20px;\\n            background: #1a1a1a;\\n            border-radius: 50%;\\n            position: fixed;\\n            pointer-events: none;\\n            z-index: 9999;\\n            mix-blend-mode: difference;\\n            transition: transform 0.1s ease;\\n        }\\n        .nav-link::after {\\n            content: '';\\n            display: block;\\n            width: 0;\\n            height: 1px;\\n            background: #000;\\n            transition: width .3s;\\n        }\\n        .nav-link:hover::after {\\n            width: 100%;\\n        }\\n    </style>\\n</head>\\n<body x-data=\\\"{ menuOpen: false }\\\">\\n\\n    <!-- Curseur Personnalisé -->\\n    <div id=\\\"cursor\\\" class=\\\"custom-cursor hidden md:block\\\"></div>\\n\\n    <!-- Navigation -->\\n    <nav class=\\\"fixed w-full z-50 px-8 py-6 flex justify-between items-center mix-blend-difference text-white\\\">\\n        <div class=\\\"text-xl font-serif font-bold tracking-widest uppercase\\\">Portfolio <br> by omerlinks the mouse</div>\\n        \\n        <div class=\\\"hidden md:flex space-x-12 text-sm uppercase tracking-widest\\\">\\n            <a href=\\\"#hero\\\" class=\\\"nav-link\\\">Accueil</a>\\n            <a href=\\\"#about\\\" class=\\\"nav-link\\\">À Propos</a>\\n            <a href=\\\"#work\\\" class=\\\"nav-link\\\">Projets</a>\\n            <a href=\\\"#contact\\\" class=\\\"nav-link\\\">Contact</a>\\n        </div>\\n\\n        <button @click=\\\"menuOpen = !menuOpen\\\" class=\\\"md:hidden text-sm uppercase tracking-widest\\\">Menu</button>\\n    </nav>\\n\\n    <!-- Menu Mobile -->\\n    <div x-show=\\\"menuOpen\\\" x-transition.opacity class=\\\"fixed inset-0 bg-white z-[60] flex flex-col items-center justify-center space-y-8\\\">\\n        <button @click=\\\"menuOpen = false\\\" class=\\\"absolute top-8 right-8 text-2xl\\\">&times;</button>\\n        <a @click=\\\"menuOpen = false\\\" href=\\\"#hero\\\" class=\\\"text-4xl font-serif\\\">Accueil</a>\\n        <a @click=\\\"menuOpen = false\\\" href=\\\"#about\\\" class=\\\"text-4xl font-serif\\\">À Propos</a>\\n        <a @click=\\\"menuOpen = false\\\" href=\\\"#work\\\" class=\\\"text-4xl font-serif\\\">Projets</a>\\n        <a @click=\\\"menuOpen = false\\\" href=\\\"#contact\\\" class=\\\"text-4xl font-serif\\\">Contact</a>\\n    </div>\\n\\n    <!-- Section Hero -->\\n    <section id=\\\"hero\\\" class=\\\"relative h-screen flex items-center justify-center overflow-hidden px-6\\\">\\n        <div class=\\\"absolute inset-0 z-0\\\">\\n            <div class=\\\"parallax-bg w-full h-[120%] bg-cover bg-center opacity-20\\\" style=\\\"background-image: url('https://images.unsplash.com/photo-1490481651871-ab68de25d43d?q=80&w=2070&auto=format&fit=crop');\\\"></div>\\n        </div>\\n        \\n        <div class=\\\"relative z-10 text-center\\\">\\n            <span class=\\\"block mb-4 text-xs tracking-[0.5em] uppercase reveal\\\">Web Designer & Créateur</span>\\n            <h1 class=\\\"text-7xl md:text-9xl font-serif leading-tight reveal\\\">\\n                Esthétique<br>\\n                <span class=\\\"italic\\\">& Moderne</span>\\n            </h1>\\n            <p class=\\\"mt-8 max-w-lg mx-auto text-gray-500 font-light reveal\\\">\\n                Fusion entre le luxe, la technologie et l'élégance visuelle.\\n            </p>\\n        </div>\\n\\n        <div class=\\\"absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce scroll-hint opacity-50\\\">\\n            <svg class=\\\"w-6 h-6\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\"><path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" stroke-width=\\\"1\\\" d=\\\"M19 14l-7 7m0 0l-7-7m7 7V3\\\"></path></svg>\\n        </div>\\n    </section>\\n\\n    <!-- Section À Propos -->\\n    <section id=\\\"about\\\" class=\\\"py-32 px-6 md:px-20 bg-white\\\">\\n        <div class=\\\"grid md:grid-cols-2 gap-20 items-center\\\">\\n            <div class=\\\"relative reveal h-[500px]\\\">\\n                <div class=\\\"absolute inset-0 bg-gray-100 parallax-img\\\" data-speed=\\\"0.05\\\">\\n                    <img src=\\\"https://images.unsplash.com/photo-1539109132345-bc49a26d8a88?q=80&w=1974&auto=format&fit=crop\\\" alt=\\\"Portrait\\\" class=\\\"w-full h-full object-cover grayscale hover:grayscale-0 transition duration-700\\\">\\n                </div>\\n            </div>\\n            <div class=\\\"reveal\\\">\\n                <h2 class=\\\"text-4xl md:text-5xl mb-8\\\">L'Art de l'Équilibre</h2>\\n                <p class=\\\"text-lg text-gray-600 mb-6 leading-relaxed\\\">\\n                    Basé sur les informations de votre profil, je conçois des interfaces qui respirent. Mon approche est centrée sur l'utilisateur avec une attention méticuleuse portée à la typographie et au blanc tournant.\\n                </p>\\n                <div class=\\\"space-y-4\\\">\\n                    <div class=\\\"flex justify-between border-b pb-2\\\">\\n                        <span class=\\\"uppercase tracking-widest text-xs\\\">UX/UI Design</span>\\n                        <span class=\\\"text-xs\\\">95%</span>\\n                    </div>\\n                    <div class=\\\"flex justify-between border-b pb-2\\\">\\n                        <span class=\\\"uppercase tracking-widest text-xs\\\">Direction Artistique</span>\\n                        <span class=\\\"text-xs\\\">90%</span>\\n                    </div>\\n                    <div class=\\\"flex justify-between border-b pb-2\\\">\\n                        <span class=\\\"uppercase tracking-widest text-xs\\\">Développement Web</span>\\n                        <span class=\\\"text-xs\\\">85%</span>\\n                    </div>\\n                </div>\\n            </div>\\n        </div>\\n    </section>\\n\\n    <!-- Section Projets (Parallaxe Vertical) -->\\n    <section id=\\\"work\\\" class=\\\"py-32 bg-gray-50\\\">\\n        <div class=\\\"px-6 md:px-20 mb-20\\\">\\n            <h2 class=\\\"text-5xl font-serif reveal\\\">Sélection de Projets</h2>\\n        </div>\\n\\n        <div class=\\\"space-y-40\\\">\\n            <!-- Projet 1 -->\\n            <div class=\\\"grid md:grid-cols-12 gap-10 items-center px-6 md:px-20\\\">\\n                <div class=\\\"md:col-span-7 reveal\\\">\\n                    <div class=\\\"overflow-hidden bg-black h-[600px] group\\\">\\n                        <img src=\\\"https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?q=80&w=2040&auto=format&fit=crop\\\" class=\\\"w-full h-full object-cover transform group-hover:scale-105 transition duration-700 opacity-80\\\" alt=\\\"Fashion 1\\\">\\n                    </div>\\n                </div>\\n                <div class=\\\"md:col-span-4 md:col-start-9 reveal\\\" data-speed=\\\"0.1\\\">\\n                    <span class=\\\"text-xs text-gray-400 uppercase tracking-widest\\\">E-Commerce • 2024</span>\\n                    <h3 class=\\\"text-3xl mt-4 mb-6\\\">Maison de Couture</h3>\\n                    <p class=\\\"text-gray-500 mb-8\\\">Refonte complète de l'identité numérique pour une marque de luxe parisienne.</p>\\n                    <a href=\\\"#\\\" class=\\\"inline-block border-b border-black pb-1 uppercase text-xs tracking-widest hover:text-gray-400 transition\\\">Voir le cas</a>\\n                </div>\\n            </div>\\n\\n            <!-- Projet 2 -->\\n            <div class=\\\"grid md:grid-cols-12 gap-10 items-center px-6 md:px-20 flex-row-reverse\\\">\\n                <div class=\\\"md:col-span-4 reveal md:order-1\\\" data-speed=\\\"0.1\\\">\\n                    <span class=\\\"text-xs text-gray-400 uppercase tracking-widest\\\">Minimalism • 2023</span>\\n                    <h3 class=\\\"text-3xl mt-4 mb-6\\\">Abstract Studio</h3>\\n                    <p class=\\\"text-gray-500 mb-8\\\">Une approche brutale et minimale pour une galerie d'art contemporain.</p>\\n                    <a href=\\\"#\\\" class=\\\"inline-block border-b border-black pb-1 uppercase text-xs tracking-widest hover:text-gray-400 transition\\\">Voir le cas</a>\\n                </div>\\n                <div class=\\\"md:col-span-7 md:col-start-6 reveal md:order-2\\\">\\n                    <div class=\\\"overflow-hidden bg-black h-[600px] group\\\">\\n                        <img src=\\\"https://images.unsplash.com/photo-1441986300917-64674bd600d8?q=80&w=2070&auto=format&fit=crop\\\" class=\\\"w-full h-full object-cover transform group-hover:scale-105 transition duration-700 opacity-80\\\" alt=\\\"Fashion 2\\\">\\n                    </div>\\n                </div>\\n            </div>\\n        </div>\\n    </section>\\n\\n    <!-- Section Contact -->\\n    <section id=\\\"contact\\\" class=\\\"py-32 px-6 bg-white text-center\\\">\\n        <div class=\\\"reveal\\\">\\n            <h2 class=\\\"text-6xl md:text-8xl font-serif mb-12\\\">Travaillons <br><span class=\\\"italic\\\">ensemble</span></h2>\\n            <div class=\\\"flex flex-col items-center space-y-6\\\">\\n                <a href=\\\"mailto:hello@example.com\\\" class=\\\"text-2xl md:text-3xl hover:italic transition-all\\\">hello@designmode.com</a>\\n                <div class=\\\"flex space-x-8 mt-12 text-sm uppercase tracking-widest text-gray-400\\\">\\n                    <a href=\\\"#\\\" class=\\\"hover:text-black\\\">Instagram</a>\\n                    <a href=\\\"#\\\" class=\\\"hover:text-black\\\">LinkedIn</a>\\n                    <a href=\\\"#\\\" class=\\\"hover:text-black\\\">Behance</a>\\n                </div>\\n            </div>\\n        </div>\\n    </section>\\n\\n    <footer class=\\\"py-10 border-t text-center text-[10px] uppercase tracking-[0.3em] text-gray-400\\\">\\n        &copy; 2025 Portfolio Créatif. Conçu avec soin.\\n    </footer>\\n\\n    \\n</body>\\n</html>\" }} />\n  );\n}\n",
      "type": "registry:ui"
    }
