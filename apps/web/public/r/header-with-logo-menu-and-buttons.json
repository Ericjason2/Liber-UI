      "content": "/**\n * Component: Header with logo, menu and buttons\n * Author: @markvaren (https://tailwindflex.com/@markvaren)\n * Source: https://tailwindflex.com/@markvaren/header-with-logo-menu-and-buttons\n * Attribution: Créé par @markvaren sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function HeaderWithLogoMenuAndButtons() {\n  return (\n    <div>\n    \n    \n    <header className=\"bg-gray-500 sticky top-0 z-50 px-4\">\n        <div className=\"container mx-auto flex justify-between items-center py-4\">\n          \n          <div className=\"flex items-center\">\n            <img src=\"https://spacema-dev.com/blue-star/assets/images/blue-logo.png\" alt=\"Logo\" className=\"h-14 w-auto mr-4\" />\n          </div>\n    \n          \n          <div className=\"flex md\">\n            <button id=\"hamburger\" className=\"text-white focus\">\n              <svg className=\"w-6 h-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"M4 6h16M4 12h16m-7 6h7\"></path>\n              </svg>\n            </button>\n          </div>\n    \n          \n          <nav className=\"hidden md md justify-center\">\n            <ul className=\"flex justify-center space-x-4 text-white\">\n              <li><a href=\"#home\" className=\"hover font-bold\">Home</a></li>\n              <li><a href=\"#aboutus\" className=\"hover font-bold\">About us</a></li>\n              <li><a href=\"#results\" className=\"hover font-bold\">Results</a></li>\n              <li><a href=\"#reviews\" className=\"hover font-bold\">Reviews</a></li>\n              <li><a href=\"#portfolio\" className=\"hover font-bold\">Portfolio</a></li>\n              <li><a href=\"#team\" className=\"hover font-bold\">Team</a></li>\n              <li><a href=\"#contact\" className=\"hover font-bold\">Contact</a></li>\n            </ul>\n          </nav>\n    \n          \n          <div className=\"hidden lg items-center space-x-4\">\n            <a href=\"#\" className=\"bg-green-500 hover500 text-white font-semibold px-4 py-2 rounded inline-block\">Github</a>\n            <a href=\"#\" className=\"bg-blue-500 hover500 text-white font-semibold px-4 py-2 rounded inline-block\">Download</a>\n          </div>\n        </div>\n      </header>\n    \n     \n    <nav id=\"mobile-menu-placeholder\" className=\"mobile-menu hidden flex-col items-center space-y-8 md px-8\">\n      <ul className=\"w-full text-center\">\n        <li className=\"border-b border-gray-300 pb-4 pt-4\"><a href=\"#home\" className=\"hover font-bold\">Home</a></li>\n        <li className=\"border-b border-gray-300 pb-4 pt-4\"><a href=\"#aboutus\" className=\"hover font-bold\">About us</a></li>\n        <li className=\"border-b border-gray-300 pb-4 pt-4\"><a href=\"#results\" className=\"hover font-bold\">Results</a></li>\n        <li className=\"border-b border-gray-300 pb-4 pt-4\"><a href=\"#reviews\" className=\"hover font-bold\">Reviews</a></li>\n        <li className=\"border-b border-gray-300 pb-4 pt-4\"><a href=\"#portfolio\" className=\"hover font-bold\">Portfolio</a></li>\n        <li className=\"border-b border-gray-300 pb-4 pt-4\"><a href=\"#team\" className=\"hover font-bold\">Team</a></li>\n        <li className=\"pb-4 pt-4\"><a href=\"#contact\" className=\"hover font-bold\">Contact</a></li>\n      </ul>\n      <div className=\"flex flex-col mt-6 space-y-2 items-center\">\n        <a href=\"#\" className=\"bg-green-500 hover500 text-white font-semibold px-4 py-2 rounded inline-block flex items-center justify-center min-w-[110px]\">Github</a>\n        <a href=\"#\" className=\"bg-blue-500 hover500 text-white font-semibold px-4 py-2 rounded inline-block flex items-center justify-center min-w-[110px]\">Download</a>\n      </div>\n    </nav>\n    </div>\n  );\n}\n",
