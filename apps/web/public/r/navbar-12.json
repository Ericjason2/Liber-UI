      "content": "import * as React from \"react\"\n\nfunction Navbar12({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"navbar-12\"\n      className={className}\n      {...props}\n    >\n      <style>{\"/* Анимация выезжания сверху (только для контента меню) */\\n  .slide-down-enter-active .absolute,\\n  .slide-down-leave-active .absolute {\\n    transition: all 0.4s ease;\\n  }\\n\\n  .slide-down-enter .absolute,\\n  .slide-down-leave-to .absolute {\\n    opacity: 0;\\n    transform: translateY(-50px);\\n  }\\n\\n  .slide-down-enter-to .absolute,\\n  .slide-down-leave .absolute {\\n    opacity: 1;\\n    transform: translateY(0);\\n  }\\n\\n  /* Анимация затемнения фона */\\n  .slide-down-enter-active .bg-opacity-50,\\n  .slide-down-leave-active .bg-opacity-50 {\\n    transition: opacity 0.3s ease;\\n  }\\n\\n  .slide-down-enter .bg-opacity-50,\\n  .slide-down-leave-to .bg-opacity-50 {\\n    opacity: 0;\\n  }\\n\\n  /* Анимация перехода бургер-крестик */\\n  .fade-enter-active,\\n  .fade-leave-active {\\n    transition: opacity 0.2s ease;\\n  }\\n\\n  .fade-enter,\\n  .fade-leave-to {\\n    opacity: 0;\\n  }\\n\\n  /* Эффекты для ссылок */\\n  .hover-text::after {\\n    content: '';\\n    position: absolute;\\n    bottom: -2px;\\n    left: 0;\\n    width: 0;\\n    height: 2px;\\n    background-color: black;\\n    transition: width 0.3s ease;\\n  }\\n\\n  .hover-text:hover::after {\\n    width: 100%;\\n  }\\n\\n  /* Плавные переходы */\\n  .transition-colors {\\n    transition: color 0.2s ease, background-color 0.2s ease;\\n  }\\n\\n  /* Фикс для z-index */\\n  .z-50 {\\n    z-index: 50;\\n  }\\n\\n  .z-40 {\\n    z-index: 40;\\n  }\\n\\n\\n\\n\\n\\n  /* поддчеркивание в шапке */\\n  .underline-hover-container {\\n    display: inline-block;\\n    position: relative;\\n  }\\n\\n  .hover-text {\\n    color: black;\\n    cursor: pointer;\\n  }\\n\\n  /* Псевдоэлемент для подчёркивания */\\n  .hover-text::after {\\n    content: '';\\n    position: absolute;\\n    bottom: 0;\\n    left: 0;\\n    width: 0;\\n    height: 1px;\\n    background-color: black;\\n    transition: width 0.3s ease-in-out;\\n  }\\n\\n  /* Анимация при наведении */\\n  .hover-text:hover::after {\\n    width: 100%;\\n  }\"}</style>\n      <div>\n        <header className=\"block mb-4 fixed top-0 left-0 w-full z-50 bg-white\">\n          <nav>\n            <div className=\"w-full py-4 md:py-3 shadow-xl\">\n              <div className=\"flex justify-between px-4 md:px-8 lg:px-20 items-center font-semibold\">\n                \n                <NuxtLink to=\"/\" className=\"text-3xl md:text-4xl font-medium py-1 px-2 z-50\">DLC</NuxtLink>\n      \n                \n                <div className=\"hidden md:flex md:gap-4 lg:gap-8 xl:gap-10\">\n                  <NuxtLink to=\"#teachers\"\n                    className=\"hover-text underline-hover-container transition-colors text-sm lg:text-base\">\n                    Наши преподаватели\n                  </NuxtLink>\n                  <NuxtLink to=\"#about\" className=\"hover-text underline-hover-container transition-colors text-sm lg:text-base\">\n                    О нас\n                  </NuxtLink>\n                  <NuxtLink to=\"#services\"\n                    className=\"hover-text underline-hover-container transition-colors text-sm lg:text-base\">\n                    Курсы\n                  </NuxtLink>\n                </div>\n      \n                \n                <div className=\"hidden md:flex\">\n                  <NuxtLink to=\"https://wa.me/c/79143348185\" target=\"_blank\"\n                    className=\"transition duration-300 px-6 py-2 lg:px-8 lg:py-3 bg-white text-black select-none text-sm lg:text-xl border-2 border-black font-semibold hover:bg-black hover:text-white\">\n                    Связаться с нами\n                  </NuxtLink>\n                </div>\n      \n                \n                <button className=\"md:hidden w-8 h-8 focus:outline-none z-50\">\n                                  <transition name=\"fade\" mode=\"out-in\">\n                                      <span key=\"menu\" className=\"block text-3xl\">☰</span>\n                                      <span key=\"close\" className=\"block text-3xl\">✕</span>\n                                  </transition>\n                    </button>\n              </div>\n      \n              \n              <transition name=\"slide-down\">\n                <div className=\"md:hidden fixed inset-0 z-40\">\n                  \n                  <div className=\"absolute inset-0 bg-black bg-opacity-50 mt-16\"></div>\n      \n                  \n                  <div className=\"absolute top-16 left-0 right-0 bg-white shadow-xl rounded-b-2xl overflow-hidden z-40\">\n                    <div className=\"p-6\">\n                      \n                      <nav className=\"space-y-4\">\n                        <NuxtLink to=\"/\"\n                          className=\"block text-xl font-medium py-3 px-4 hover:bg-gray-100 rounded-lg transition-colors\"\n                         >\n                          Главная\n                        </NuxtLink>\n                        <hr className=\"border-b border-gray-800\" />\n                        <NuxtLink to=\"#teachers\"\n                          className=\"block text-xl font-medium py-3 px-4 hover:bg-gray-100 rounded-lg transition-colors\"\n                         >\n                          Наши преподаватели\n                        </NuxtLink>\n                        <hr className=\"border-b border-gray-800\" />\n                        <NuxtLink to=\"#about\"\n                          className=\"block text-xl font-medium py-3 px-4 hover:bg-gray-100 rounded-lg transition-colors\"\n                         >\n                          О нас\n                        </NuxtLink>\n                        <hr className=\"border-b border-gray-800\" />\n      \n                        <NuxtLink to=\"#services\"\n                          className=\"block text-xl font-medium py-3 px-4 hover:bg-gray-100 rounded-lg transition-colors\"\n                         >\n                          Курсы\n                        </NuxtLink>\n                        <hr className=\"border-b border-gray-800\" />\n                      </nav>\n      \n                      \n                      <NuxtLink to=\"https://wa.me/c/79143348185\" target=\"_blank\"\n                        className=\"mt-6 w-full px-6 py-4 bg-black text-white text-xl font-semibold text-center hover:bg-gray-800 transition-colors rounded-lg block\"\n                       >\n                        Связаться с нами\n                      </NuxtLink>\n                    </div>\n                  </div>\n                </div>\n              </transition>\n            </div>\n          </nav>\n        </header>\n      </div>\n      \n      \n      /* for working mobile mune */\n    </div>\n  )\n}\n\nexport { Navbar12 }\n",
      "type": "registry:ui"
    }
  ],
