    "rawHtml": "<header class=\"relative w-full overflow-hidden bg-dark\">\r\n    <div class=\"w-full overflow-hidden\" id=\"sliderViewport\">\r\n        <div class=\"flex will-change-transform\" id=\"track\"></div>\r\n    </div>\r\n\r\n    <div class=\"absolute left-[34px] top-0 z-30 hidden h-[60%] items-end gap-4 lg:flex\"\r\n        style=\"writing-mode: vertical-lr; transform: rotate(180deg);\">\r\n        <button\r\n          type=\"button\"\r\n          aria-label=\"Call for reservations\"\r\n          class=\"flex h-[46px] w-[46px] shrink-0 cursor-pointer items-center justify-center rounded-full border border-white/40 transition-colors duration-200 hover:border-gold animate-pulseGold\"\r\n        >\r\n          <span\r\n            class=\"relative h-[18px] w-[18px] rounded-[3px] border-[2.5px] border-white\"\r\n            style=\"transform: rotate(90deg);\"\r\n          >\r\n            <span\r\n              class=\"absolute -bottom-[7px] left-1/2 h-[6px] w-[6px] -translate-x-1/2 rounded-full border-2 border-white\"\r\n            ></span>\r\n          </span>\r\n        </button>\r\n\r\n        <p class=\"text-[11px] font-normal uppercase leading-[1.8] tracking-[5px] text-white\">\r\n            Reservations &nbsp;\r\n            <span class=\"text-[22px] tracking-[1px] text-gold\">+1 (234) 567-890</span>\r\n        </p>\r\n    </div>\r\n    </div>\r\n\r\n    <!-- Dots -->\r\n    <div id=\"dots\"\r\n        class=\"absolute right-2 top-1/2 z-30 flex -translate-y-1/2 flex-col items-center gap-[10px] md:right-[3.5%] md:gap-[14px]\">\r\n        <span class=\"h-9 w-px shrink-0 bg-white/20 md:h-14\"></span>\r\n        <div id=\"dotButtons\" class=\"flex flex-col items-center gap-[10px] md:gap-[14px]\"></div>\r\n        <span class=\"h-9 w-px shrink-0 bg-white/20 md:h-14\"></span>\r\n    </div>\r\n\r\n    <!-- Bounce Arrow -->\r\n    <div class=\"absolute bottom-8 z-30 hidden w-full text-center sm:block animate-bounceSoft\">\r\n        <button\r\n          type=\"button\"\r\n          aria-label=\"Scroll down\"\r\n          class=\"inline-flex h-[46px] w-[46px] cursor-pointer items-center justify-center rounded-full border border-white/30 text-xl text-white transition-colors duration-200 hover:border-gold\"\r\n        >\r\n          ↓\r\n        </button>\r\n    </div>\r\n\r\n    <!-- Progress -->\r\n    <div id=\"progressBar\" class=\"absolute bottom-0 left-0 z-30 h-[2px] w-0 bg-gold\"></div>\r\n</header>\r\n\r\n<script>\r\n    (function () {\r\n      \"use strict\";\r\n\r\n      var SLIDES = [\r\n        {\r\n          src: \"https://www.addelapalm.com/assets/images/banner/the-ultimate-luxury-experience-xgw.webp\",\r\n          alt: \"The Ultimate Luxury Experience\",\r\n        },\r\n        {\r\n          src: \"https://www.addelapalm.com/assets/images/banner/addela-nyn.webp\",\r\n          alt: \"Addela Palm – Scene 2\",\r\n        },\r\n        {\r\n          src: \"https://www.addelapalm.com/assets/images/banner/addela-okv.webp\",\r\n          alt: \"Addela Palm – Scene 3\",\r\n        },\r\n      ];\r\n\r\n      var AUTOPLAY_MS = 4500;\r\n      var ANIM_MS = 650;\r\n\r\n      var track = document.getElementById(\"track\");\r\n      var dotsWrapper = document.getElementById(\"dotButtons\");\r\n      var btnPrev = document.getElementById(\"btnPrev\");\r\n      var btnNext = document.getElementById(\"btnNext\");\r\n      var progressBar = document.getElementById(\"progressBar\");\r\n      var viewport = document.getElementById(\"sliderViewport\");\r\n\r\n      var total = SLIDES.length;\r\n      var current = 0;\r\n      var isAnim = false;\r\n      var autoTimer = null;\r\n\r\n      function makeSlide(data) {\r\n        var slide = document.createElement(\"div\");\r\n        slide.className =\r\n          \"relative flex w-full flex-[0_0_100%] items-center justify-center bg-dark overflow-hidden\";\r\n\r\n        var img = document.createElement(\"img\");\r\n        img.src = data.src;\r\n        img.alt = data.alt;\r\n        img.loading = \"lazy\";\r\n        img.draggable = false;\r\n        img.className =\r\n          \"block w-full max-h-[72vh] select-none object-contain object-center align-middle pointer-events-none sm:max-h-[90vh]\";\r\n\r\n        var vignette = document.createElement(\"div\");\r\n        vignette.className = \"pointer-events-none absolute inset-0 z-[1]\";\r\n        vignette.style.background =\r\n          \"radial-gradient(ellipse at center, transparent 50%, rgba(0,0,0,.52) 100%)\";\r\n\r\n        slide.appendChild(img);\r\n        slide.appendChild(vignette);\r\n\r\n        return slide;\r\n      }\r\n\r\n      track.appendChild(makeSlide(SLIDES[total - 1]));\r\n\r\n      for (var r = 0; r < total; r++) {\r\n        track.appendChild(makeSlide(SLIDES[r]));\r\n      }\r\n\r\n      track.appendChild(makeSlide(SLIDES[0]));\r\n\r\n      function setPos(domIdx, animate) {\r\n        track.style.transition = animate\r\n          ? \"transform \" + ANIM_MS + \"ms cubic-bezier(.77,0,.18,1)\"\r\n          : \"none\";\r\n\r\n        track.style.transform = \"translateX(-\" + domIdx * 100 + \"%)\";\r\n      }\r\n\r\n      setPos(1, false);\r\n\r\n      var dots = [];\r\n\r\n      for (var d = 0; d < total; d++) {\r\n        (function (idx) {\r\n          var btn = document.createElement(\"button\");\r\n\r\n          btn.type = \"button\";\r\n          btn.setAttribute(\"aria-label\", \"Go to slide \" + (idx + 1));\r\n          btn.className =\r\n            \"h-2 w-2 shrink-0 cursor-pointer rounded-full border border-white/45 bg-transparent p-0 transition duration-300 md:h-[10px] md:w-[10px]\";\r\n\r\n          if (idx === 0) {\r\n            btn.classList.add(\"!border-gold\", \"!bg-gold\", \"scale-[1.35]\");\r\n          }\r\n\r\n          btn.addEventListener(\"click\", function () {\r\n            goTo(idx);\r\n          });\r\n\r\n          dotsWrapper.appendChild(btn);\r\n          dots.push(btn);\r\n        })(d);\r\n      }\r\n\r\n      function updateDots() {\r\n        for (var i = 0; i < dots.length; i++) {\r\n          var active = i === current;\r\n\r\n          dots[i].classList.toggle(\"!border-gold\", active);\r\n          dots[i].classList.toggle(\"!bg-gold\", active);\r\n          dots[i].classList.toggle(\"scale-[1.35]\", active);\r\n        }\r\n      }\r\n\r\n      function restartProgress() {\r\n        progressBar.style.animation = \"none\";\r\n        void progressBar.offsetWidth;\r\n        progressBar.style.animation =\r\n          \"progressRun \" + AUTOPLAY_MS + \"ms linear forwards\";\r\n      }\r\n\r\n      function goTo(logicalIdx) {\r\n        if (isAnim) return;\r\n\r\n        isAnim = true;\r\n\r\n        var next = ((logicalIdx % total) + total) % total;\r\n        var domIdx = next + 1;\r\n\r\n        setPos(domIdx, true);\r\n        current = next;\r\n        updateDots();\r\n        restartProgress();\r\n        resetAutoplay();\r\n      }\r\n\r\n      track.addEventListener(\"transitionend\", function () {\r\n        isAnim = false;\r\n\r\n        var dom = current + 1;\r\n\r\n        if (dom > total) {\r\n          setPos(1, false);\r\n          current = 0;\r\n          updateDots();\r\n        } else if (dom < 1) {\r\n          setPos(total, false);\r\n          current = total - 1;\r\n          updateDots();\r\n        }\r\n      });\r\n\r\n      btnPrev.addEventListener(\"click\", function () {\r\n        goTo(current - 1);\r\n      });\r\n\r\n      btnNext.addEventListener(\"click\", function () {\r\n        goTo(current + 1);\r\n      });\r\n\r\n      document.addEventListener(\"keydown\", function (e) {\r\n        if (e.key === \"ArrowLeft\") goTo(current - 1);\r\n        if (e.key === \"ArrowRight\") goTo(current + 1);\r\n      });\r\n\r\n      var touchX = 0;\r\n      var touchY = 0;\r\n\r\n      track.addEventListener(\r\n        \"touchstart\",\r\n        function (e) {\r\n          touchX = e.touches[0].clientX;\r\n          touchY = e.touches[0].clientY;\r\n        },\r\n        { passive: true }\r\n      );\r\n\r\n      track.addEventListener(\r\n        \"touchend\",\r\n        function (e) {\r\n          var dx = touchX - e.changedTouches[0].clientX;\r\n          var dy = touchY - e.changedTouches[0].clientY;\r\n\r\n          if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) {\r\n            goTo(current + (dx > 0 ? 1 : -1));\r\n          }\r\n        },\r\n        { passive: true }\r\n      );\r\n\r\n      function startAutoplay() {\r\n        autoTimer = setInterval(function () {\r\n          goTo(current + 1);\r\n        }, AUTOPLAY_MS);\r\n      }\r\n\r\n      function resetAutoplay() {\r\n        clearInterval(autoTimer);\r\n        startAutoplay();\r\n      }\r\n\r\n      viewport.addEventListener(\"mouseenter\", function () {\r\n        clearInterval(autoTimer);\r\n        progressBar.style.animationPlayState = \"paused\";\r\n      });\r\n\r\n      viewport.addEventListener(\"mouseleave\", function () {\r\n        progressBar.style.animationPlayState = \"running\";\r\n        resetAutoplay();\r\n      });\r\n\r\n      restartProgress();\r\n      startAutoplay();\r\n    })();\r\n</script>"
  }
}
