    "rawHtml": "<!-- Navbar -->\n<nav class=\"bg-gray-500 fixed top-0 left-0 w-full z-50\">\n  <div class=\"flex justify-between items-center h-16 md:h-20 lg:h-24 px-5 sm:px-10 lg:px-20 text-white\">\n    <!-- Logo -->\n    <a href=\"#\" class=\"text-2xl lg:text-3xl flex items-center gap-2 font-serif\">\n      <i class=\"fa-solid fa-shop text-green-700\"></i>\n      <span>LoGo</span>\n    </a>\n\n    <!-- Navbar Links (Desktop) -->\n    <ul class=\"hidden md:flex gap-8 text-lg\">\n      <li><a href=\"/#\" class=\"hover:underline\">Home</a></li>\n      <li><a href=\"/shop\" class=\"hover:underline\">Shop</a></li>\n      <li><a href=\"/about\" class=\"hover:underline\">About</a></li>\n      <li><a href=\"/contact\" class=\"hover:underline\">Contact</a></li>\n    </ul>\n\n    <!-- Actions -->\n    <div class=\"flex items-center gap-5\">\n      <!-- User Icon -->\n\n      <i class=\"fa-solid fa-circle-user text-2xl lg:text-3xl hover:cursor-pointer\"></i>\n\n\n\n      <!-- Mobile Hamburger Menu -->\n      <button class=\"hidden md:flex border-2 rounded-md bg-blue-500 text-lg px-2\">\n        Get started\n      </button>\n      <button class=\"md:hidden text-2xl\" onclick=\"toggleMenu()\">\n        <i class=\"fa-solid fa-bars\">=</i>\n      </button>\n    </div>\n  </div>\n\n  <!-- Mobile Dropdown Menu -->\n  <div id=\"mobileMenu\" class=\"md:hidden bg-gray-800 text-white p-5 space-y-3\">\n    <a href=\"/\" class=\"block hover:bg-gray-700 py-2 px-4 rounded\">Home</a>\n    <a href=\"/shop\" class=\"block hover:bg-gray-700 py-2 px-4 rounded\">Shop</a>\n    <a href=\"/about\" class=\"block hover:bg-gray-700 py-2 px-4 rounded\">About</a>\n    <a href=\"/contact\" class=\"block hover:bg-gray-700 py-2 px-4 rounded\">Contact</a>\n  </div>\n</nav>\n\n<script>\n  // JavaScript for toggling the mobile menu\n  function toggleMenu() {\n    const mobileMenu = document.getElementById(\"mobileMenu\");\n    mobileMenu.classList.toggle(\"hidden\");\n  }\n</script>"
  }
