      "content": "/**\n * Component: Simple Responsive Navigation Bar\n * Author: @slycreations (https://tailwindflex.com/@slycreations)\n * Source: https://tailwindflex.com/@slycreations/simple-responsive-navigation-bar\n * Attribution: Créé par @slycreations sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function SimpleResponsiveNavigationBar() {\n  return (\n    <div>\n    <div className=\"bg-white font-sans font-light text-black w-screen\">\n      <div className=\"w-full mx-auto bg-indigo-950 text-white text-sm\">\n        <details id=\"nav1\" className=\"group relative bg-inherit w-full max-w-7xl xl open open open:100 open:0 xl xl0\">\n          <summary className=\"flex xl xl relative\">\n            <span className=\"block px-3 py-3 flex items-center gap-2 w-full\">Company Nav          \n              <span className=\"xl-hidden transition-transform duration-200 group-open[-180deg] top-50 w-0 h-0 border-solid border-b-0 border-x-[5px] border-t-[6px] border-l-transparent border-r-transparent border-b-transparent border-t-sky-400\">\n              </span>\n            </span>\n          </summary>\n          <div className=\"w-full xl2xl9\">\n            <ul className=\"bg-inherit divide-y divide-white/50 divide-solid xl xl xl-space-x-4 w-full xl xl4\">\n              <li className=\"\">\n                <a href=\"#\"  className=\"block px-5 py-3\">\n                  First Link\n                </a>\n              </li>\n              <li className=\"relative\">\n                <details className=\"group/subnav\">\n                  <summary className=\"flex px-5 py-3 flex items-center flex place-content-between w-full gap-2 relative\">\n                    Second Link              \n                      <span className=\"xl-hidden transition-transform duration-200 group-open/subnav[-180deg] top-50 w-0 h-0 border-solid border-b-0 border-x-[5px] border-t-[6px] border-l-transparent border-r-transparent border-b-transparent border-t-sky-400\">\n                      </span>\n                  </summary>\n                  <div className=\"xl xl100 xl[1rem] xl[18rem]\">\n                    <ul className=\" pl-1 divide-y divide-white/50 divide-solid bg-black/20 xl950 xl\">\n                      <li className=\"px-3\">\n                        <a href=\"#\" className=\"block px-5 py-3\">Sublink 1</a>\n                      </li>\n                      <li className=\"px-3\">\n                        <a href=\"#\" className=\"block px-5 py-3\">Sublink 2</a>\n                      </li>\n                      <li className=\"px-3\">\n                        <a href=\"#\" className=\"block px-5 py-3\">Sublink 3</a>\n                      </li>\n                    </ul>\n                  </div>\n                </details>\n              </li>\n              <li>\n                <a href=\"#\"  className=\"block px-5 py-3\">\n                  Third Link\n                </a>\n              </li>\n              <li className=\"relative\">\n                <details className=\"group/subnav\">\n                  <summary className=\" flex px-5 py-3 flex items-center flex place-content-between w-full gap-2 relative\">\n                    Fourth link              \n                    <span className=\"xl-hidden transition-transform duration-200 group-open/subnav[-180deg] top-50 w-0 h-0 border-solid border-b-0 border-x-[5px] border-t-[6px] border-l-transparent border-r-transparent border-b-transparent border-t-sky-400\">\n                    </span>\n                  </summary>\n                  <div className=\"xl xl100 xl[1rem] xl[18rem]\">\n                    <ul className=\" pl-1 divide-y divide-white/50 divide-solid bg-black/20 xl950 xl\">\n                      <li className=\"px-3\">\n                        <a href=\"#\" className=\"block px-5 py-3\">Sublink 1</a>\n                      </li>\n                      <li className=\"px-3\">\n                        <a href=\"#\" className=\"block px-5 py-3\">Sublink 2</a>\n                      </li>\n                      <li className=\"px-3\">\n                        <a href=\"#\" className=\"block px-5 py-3\">Sublink 3</a>\n                      </li>\n                    </ul>\n                  </div>\n                </details>\n              </li>\n            </ul>\n          </div>\n        </details>    \n      </div>\n      <div className=\"p-5\">\n        <h1 className=\"text-4xl lg5xl xl6xl font-light font-extralight\">Simple Responsive Nav</h1>\n    \n        <p>Minimal javascript used, mainly to toggle between desktop and mobile views on resize.</p>\n    \n      </div>\n    </div>\n    \n    </div>\n  );\n}\n",
