    "rawHtml": "<!DOCTYPE html>\n<html lang=\"es\" class=\"\"> <!-- La clase 'dark' se gestionará con JS -->\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>KPIs con Diseño Premium</title>\n\n    <!-- Incluimos Chart.js desde CDN -->\n    <script src=\"https://cdn.jsdelivr.net/npm/chart.js\"></script>\n\n    <!-- Fuente Inter -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n    \n    <style>\n        body {\n            font-family: 'Inter', sans-serif;\n            /* Fondo degradado sutil para el efecto de cristal */\n            background-color: #f3f4f6; /* Fallback modo claro */\n            background-image: linear-gradient(135deg, #f3f4f6 0%, #e5e7eb 100%);\n        }\n\n        .dark body {\n            background-color: #030712; /* Fallback modo oscuro (gray-950) */\n            background-image: linear-gradient(135deg, #030712 0%, #111827 100%);\n        }\n\n        /* Estilo de Tarjeta \"Glassmorphism\" */\n        .cool-kpi-card {\n            /* Fondo semi-transparente con desenfoque */\n            background-color: rgba(255, 255, 255, 0.6);\n            backdrop-filter: blur(10px);\n            -webkit-backdrop-filter: blur(10px); /* Soporte para Safari */\n            \n            /* Borde sutil para definir la tarjeta */\n            border: 1px solid rgba(255, 255, 255, 0.2);\n            \n            /* Transiciones y sombra */\n            transition: all 0.3s ease;\n            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);\n        }\n\n        /* Estilo de Tarjeta en Modo Oscuro */\n        .dark .cool-kpi-card {\n            background-color: rgba(31, 41, 55, 0.5); /* gray-800 con 50% opacidad */\n            border: 1px solid rgba(55, 65, 81, 0.5); /* gray-700 con 50% opacidad */\n            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);\n        }\n\n        /* Efecto Hover más pronunciado */\n        .cool-kpi-card:hover {\n            transform: translateY(-5px);\n            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);\n            background-color: rgba(255, 255, 255, 0.8);\n        }\n\n        .dark .cool-kpi-card:hover {\n            background-color: rgba(31, 41, 55, 0.7);\n            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);\n        }\n    </style>\n</head>\n<body class=\"bg-gray-100 dark:bg-gray-950 text-gray-900 dark:text-gray-100 min-h-screen p-8 transition-colors duration-300\">\n\n    <div class=\"max-w-7xl mx-auto\">\n \n\n        <!-- Rejilla responsiva para las 4 tarjetas -->\n        <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6\">\n\n            <!-- Tarjeta 1: Gráfico de ÁREA -->\n            <div class=\"cool-kpi-card p-6 rounded-2xl\">\n                <div class=\"flex justify-between items-center mb-2\">\n                    <span class=\"text-sm font-medium text-gray-700 dark:text-gray-300\">Tráfico Web</span>\n                    <div class=\"p-2 bg-blue-500/10 dark:bg-blue-500/20 rounded-lg\">\n                        <svg class=\"w-5 h-5 text-blue-600 dark:text-blue-300\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 7h8m0 0v8m0-8l-8 8-4-4-6 6\"></path></svg>\n                    </div>\n                </div>\n                <div class=\"text-4xl font-bold text-gray-900 dark:text-white mb-4\">78,2K</div>\n                <div class=\"h-24 w-full\">\n                    <canvas id=\"sparkAreaChart\"></canvas>\n                </div>\n            </div>\n\n            <!-- Tarjeta 2: Gráfico de BARRAS -->\n            <div class=\"cool-kpi-card p-6 rounded-2xl\">\n                <div class=\"flex justify-between items-center mb-2\">\n                    <span class=\"text-sm font-medium text-gray-700 dark:text-gray-300\">Registros Diarios</span>\n                    <div class=\"p-2 bg-indigo-500/10 dark:bg-indigo-500/20 rounded-lg\">\n                         <svg class=\"w-5 h-5 text-indigo-600 dark:text-indigo-300\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M16 8v8m-4-5v5m-4-2v2M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z\"></path></svg>\n                    </div>\n                </div>\n                <div class=\"text-4xl font-bold text-gray-900 dark:text-white mb-4\">451</div>\n                <div class=\"h-24 w-full\">\n                    <canvas id=\"sparkBarChart\"></canvas>\n                </div>\n            </div>\n\n            <!-- Tarjeta 3: Gráfico de DONA (Pie) -->\n            <div class=\"cool-kpi-card p-6 rounded-2xl\">\n                 <div class=\"flex justify-between items-center mb-2\">\n                    <span class=\"text-sm font-medium text-gray-700 dark:text-gray-300\">Meta de Tareas</span>\n                     <div class=\"p-2 bg-green-500/10 dark:bg-green-500/20 rounded-lg\">\n                        <svg class=\"w-5 h-5 text-green-600 dark:text-green-300\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z\"></path></svg>\n                    </div>\n                </div>\n                <div class=\"text-4xl font-bold text-gray-900 dark:text-white mb-4\">85%</div>\n                <div class=\"h-24 w-full flex items-center justify-center\">\n                    <div class=\"w-24 h-24\"> <!-- Contenedor para que la dona no se estire -->\n                        <canvas id=\"sparkDoughnutChart\"></canvas>\n                    </div>\n                </div>\n            </div>\n            \n            <!-- Tarjeta 4: Gráfico de LÍNEA -->\n            <div class=\"cool-kpi-card p-6 rounded-2xl\">\n                <div class=\"flex justify-between items-center mb-2\">\n                    <span class=\"text-sm font-medium text-gray-700 dark:text-gray-300\">Tasa de Rebote</span>\n                    <div class=\"p-2 bg-red-500/10 dark:bg-red-500/20 rounded-lg\">\n                        <svg class=\"w-5 h-5 text-red-600 dark:text-red-300\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 17h8m0 0v-8m0 8l-8-8-4 4-6-6\"></path></svg>\n                    </div>\n                </div>\n                <div class=\"text-4xl font-bold text-gray-900 dark:text-white mb-4\">21.4%</div>\n                <div class=\"h-24 w-full\">\n                    <canvas id=\"sparkLineChart\"></canvas>\n                </div>\n            </div>\n\n        </div> <!-- Fin de la rejilla -->\n    </div> <!-- Fin del contenedor principal -->\n\n    <script>\n        // Variables globales para los gráficos\n        let sparkAreaChart, sparkBarChart, sparkDoughnutChart, sparkLineChart;\n        \n        // --- Definición de Colores (Ajustados para el nuevo diseño) ---\n        const chartColors = {\n            light: {\n                line: '#3b82f6', // blue-500\n                areaBg: 'rgba(59, 130, 246, 0.1)',\n                bar: '#6366f1', // indigo-500\n                barHover: '#4f46e5', // indigo-600\n                doughnutPrimary: '#22c55e', // green-500\n                doughnutBg: 'rgba(0, 0, 0, 0.05)',\n                line2: '#ef4444', // red-500\n                tooltipBg: 'rgba(255, 255, 255, 0.9)',\n                tooltipTitle: '#4b5563', // gray-600\n                tooltipBody: '#111827', // gray-900\n                doughnutBorder: 'rgba(255, 255, 255, 0.6)' // Fondo de tarjeta clara\n            },\n            dark: {\n                line: '#60a5fa', // blue-400\n                areaBg: 'rgba(96, 165, 250, 0.1)',\n                bar: '#818cf8', // indigo-400\n                barHover: '#a5b4fc', // indigo-300\n                doughnutPrimary: '#4ade80', // green-400\n                doughnutBg: 'rgba(255, 255, 255, 0.1)',\n                line2: '#f87171', // red-400\n                tooltipBg: 'rgba(17, 24, 39, 0.9)',\n                tooltipTitle: '#9ca3af', // gray-400\n                tooltipBody: '#f9fafb', // gray-50\n                doughnutBorder: 'rgba(31, 41, 55, 0.5)' // Fondo de tarjeta oscura\n            }\n        };\n\n        // --- Helper para Configuración de Tooltip ---\n        function getTooltipConfig(colors) {\n            return {\n                enabled: true,\n                mode: 'index',\n                intersect: false,\n                displayColors: false,\n                backgroundColor: colors.tooltipBg,\n                titleColor: colors.tooltipTitle,\n                bodyColor: colors.tooltipBody,\n                padding: 10,\n                cornerRadius: 6,\n                titleFont: { family: 'Inter', size: 12, weight: '500' },\n                bodyFont: { family: 'Inter', size: 14, weight: 'bold' },\n                callbacks: {\n                    title: (tooltipItems) => tooltipItems[0].label,\n                    label: (tooltipItem) => ` ${tooltipItem.formattedValue}`\n                }\n            };\n        }\n\n        // --- Inicialización de TODOS los Gráficos ---\n        function initCharts() {\n            const isDark = document.documentElement.classList.contains('dark');\n            const colors = isDark ? chartColors.dark : chartColors.light;\n\n            // 1. Gráfico de ÁREA\n            const ctxArea = document.getElementById('sparkAreaChart')?.getContext('2d');\n            if (ctxArea) {\n                sparkAreaChart = new Chart(ctxArea, {\n                    type: 'line',\n                    data: {\n                        labels: ['Día 1', 'Día 2', 'Día 3', 'Día 4', 'Día 5', 'Día 6', 'Día 7'],\n                        datasets: [{\n                            label: 'Tráfico', data: [30, 40, 25, 50, 45, 60, 55],\n                            borderColor: colors.line,\n                            borderWidth: 2,\n                            fill: true,\n                            backgroundColor: colors.areaBg,\n                            tension: 0.4,\n                            pointRadius: 0, pointHoverRadius: 6,\n                            pointHoverBackgroundColor: colors.line, pointHoverBorderColor: '#ffffff'\n                        }]\n                    },\n                    options: {\n                        responsive: true, maintainAspectRatio: false,\n                        plugins: { legend: { display: false }, tooltip: getTooltipConfig(colors) },\n                        scales: { x: { display: false }, y: { display: false } }\n                    }\n                });\n            }\n\n            // 2. Gráfico de BARRAS\n            const ctxBar = document.getElementById('sparkBarChart')?.getContext('2d');\n            if (ctxBar) {\n                sparkBarChart = new Chart(ctxBar, {\n                    type: 'bar',\n                    data: {\n                        labels: ['Día 1', 'Día 2', 'Día 3', 'Día 4', 'Día 5', 'Día 6', 'Día 7'],\n                        datasets: [{\n                            label: 'Registros', data: [120, 150, 130, 180, 160, 200, 190],\n                            backgroundColor: colors.bar,\n                            hoverBackgroundColor: colors.barHover,\n                            borderRadius: 4\n                        }]\n                    },\n                    options: {\n                        responsive: true, maintainAspectRatio: false,\n                        plugins: { legend: { display: false }, tooltip: getTooltipConfig(colors) },\n                        scales: { x: { display: false }, y: { display: false } }\n                    }\n                });\n            }\n\n            // 3. Gráfico de DONA (Pie)\n            const ctxDoughnut = document.getElementById('sparkDoughnutChart')?.getContext('2d');\n            if (ctxDoughnut) {\n                sparkDoughnutChart = new Chart(ctxDoughnut, {\n                    type: 'doughnut',\n                    data: {\n                        labels: ['Completado', 'Pendiente'],\n                        datasets: [{\n                            data: [85, 15], // 85% completado\n                            backgroundColor: [colors.doughnutPrimary, colors.doughnutBg],\n                            borderColor: colors.doughnutBorder,\n                            borderWidth: 3\n                        }]\n                    },\n                    options: {\n                        responsive: true, maintainAspectRatio: true,\n                        cutout: '75%', // Grosor de la dona\n                        plugins: {\n                            legend: { display: false },\n                            tooltip: { // Tooltip personalizado para donas\n                                enabled: true, displayColors: false,\n                                backgroundColor: colors.tooltipBg, titleColor: colors.tooltipTitle, bodyColor: colors.tooltipBody,\n                                padding: 8, cornerRadius: 6,\n                                callbacks: {\n                                    label: (tooltipItem) => ` ${tooltipItem.label}: ${tooltipItem.formattedValue}%`\n                                }\n                            }\n                        }\n                    }\n                });\n            }\n\n            // 4. Gráfico de LÍNEA\n            const ctxLine = document.getElementById('sparkLineChart')?.getContext('2d');\n            if (ctxLine) {\n                sparkLineChart = new Chart(ctxLine, {\n                    type: 'line',\n                     data: {\n                        labels: ['Día 1', 'Día 2', 'Día 3', 'Día 4', 'Día 5', 'Día 6', 'Día 7'],\n                        datasets: [{\n                            label: 'Tasa', data: [25, 22, 24, 20, 21, 19, 21.4],\n                            borderColor: colors.line2,\n                            borderWidth: 2,\n                            fill: false, // Sin relleno\n                            tension: 0.4,\n                            pointRadius: 0, pointHoverRadius: 6,\n                            pointHoverBackgroundColor: colors.line2, pointHoverBorderColor: '#ffffff'\n                        }]\n                    },\n                    options: {\n                        responsive: true, maintainAspectRatio: false,\n                        plugins: { legend: { display: false }, tooltip: getTooltipConfig(colors) },\n                        scales: { x: { display: false }, y: { display: false } }\n                    }\n                });\n            }\n        }\n\n        // --- Actualización de Colores (al cambiar de tema) ---\n        function updateCharts() {\n            const isDark = document.documentElement.classList.contains('dark');\n            const colors = isDark ? chartColors.dark : chartColors.light;\n\n            // Actualizar Tooltip genérico\n            const newTooltipConfig = getTooltipConfig(colors);\n            \n            if (sparkAreaChart) {\n                const ds = sparkAreaChart.data.datasets[0];\n                ds.borderColor = colors.line;\n                ds.backgroundColor = colors.areaBg;\n                ds.pointHoverBackgroundColor = colors.line;\n                sparkAreaChart.options.plugins.tooltip = newTooltipConfig;\n                sparkAreaChart.update('none');\n            }\n            if (sparkBarChart) {\n                const ds = sparkBarChart.data.datasets[0];\n                ds.backgroundColor = colors.bar;\n                ds.hoverBackgroundColor = colors.barHover;\n                sparkBarChart.options.plugins.tooltip = newTooltipConfig;\n                sparkBarChart.update('none');\n            }\n            if (sparkDoughnutChart) {\n                const ds = sparkDoughnutChart.data.datasets[0];\n                ds.backgroundColor = [colors.doughnutPrimary, colors.doughnutBg];\n                ds.borderColor = colors.doughnutBorder;\n                sparkDoughnutChart.options.plugins.tooltip.backgroundColor = colors.tooltipBg;\n                sparkDoughnutChart.options.plugins.tooltip.titleColor = colors.tooltipTitle;\n                sparkDoughnutChart.options.plugins.tooltip.bodyColor = colors.tooltipBody;\n                sparkDoughnutChart.update('none');\n            }\n            if (sparkLineChart) {\n                const ds = sparkLineChart.data.datasets[0];\n                ds.borderColor = colors.line2;\n                ds.pointHoverBackgroundColor = colors.line2;\n                sparkLineChart.options.plugins.tooltip = newTooltipConfig;\n                sparkLineChart.update('none');\n            }\n        }\n        document.addEventListener('DOMContentLoaded', initCharts);\n    </script>\n\n</body>\n</html>"
  }
}
