      "content": "/**\n * Component: Card kpi Chart\n * Author: @raulanto (https://tailwindflex.com/@raulanto)\n * Source: https://tailwindflex.com/@raulanto/card-kpi-chart\n * Attribution: Créé par @raulanto sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function CardKpiChart() {\n  return (\n    <div dangerouslySetInnerHTML={{ __html: \"<!DOCTYPE html>\\n<html lang=\\\"es\\\" class=\\\"\\\"> <!-- La clase 'dark' se gestionará con JS -->\\n<head>\\n    <meta charset=\\\"UTF-8\\\">\\n    <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\">\\n    <title>KPIs con Diseño Premium</title>\\n\\n    <!-- Incluimos Chart.js desde CDN -->\\n    \\n\\n    <!-- Fuente Inter -->\\n    <link rel=\\\"preconnect\\\" href=\\\"https://fonts.googleapis.com\\\">\\n    <link rel=\\\"preconnect\\\" href=\\\"https://fonts.gstatic.com\\\" crossorigin>\\n    <link href=\\\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap\\\" rel=\\\"stylesheet\\\">\\n    \\n    <style>\\n        body {\\n            font-family: 'Inter', sans-serif;\\n            /* Fondo degradado sutil para el efecto de cristal */\\n            background-color: #f3f4f6; /* Fallback modo claro */\\n            background-image: linear-gradient(135deg, #f3f4f6 0%, #e5e7eb 100%);\\n        }\\n\\n        .dark body {\\n            background-color: #030712; /* Fallback modo oscuro (gray-950) */\\n            background-image: linear-gradient(135deg, #030712 0%, #111827 100%);\\n        }\\n\\n        /* Estilo de Tarjeta \\\"Glassmorphism\\\" */\\n        .cool-kpi-card {\\n            /* Fondo semi-transparente con desenfoque */\\n            background-color: rgba(255, 255, 255, 0.6);\\n            backdrop-filter: blur(10px);\\n            -webkit-backdrop-filter: blur(10px); /* Soporte para Safari */\\n            \\n            /* Borde sutil para definir la tarjeta */\\n            border: 1px solid rgba(255, 255, 255, 0.2);\\n            \\n            /* Transiciones y sombra */\\n            transition: all 0.3s ease;\\n            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);\\n        }\\n\\n        /* Estilo de Tarjeta en Modo Oscuro */\\n        .dark .cool-kpi-card {\\n            background-color: rgba(31, 41, 55, 0.5); /* gray-800 con 50% opacidad */\\n            border: 1px solid rgba(55, 65, 81, 0.5); /* gray-700 con 50% opacidad */\\n            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);\\n        }\\n\\n        /* Efecto Hover más pronunciado */\\n        .cool-kpi-card:hover {\\n            transform: translateY(-5px);\\n            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);\\n            background-color: rgba(255, 255, 255, 0.8);\\n        }\\n\\n        .dark .cool-kpi-card:hover {\\n            background-color: rgba(31, 41, 55, 0.7);\\n            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);\\n        }\\n    </style>\\n</head>\\n<body class=\\\"bg-gray-100 dark:bg-gray-950 text-gray-900 dark:text-gray-100 min-h-screen p-8 transition-colors duration-300\\\">\\n\\n    <div class=\\\"max-w-7xl mx-auto\\\">\\n \\n\\n        <!-- Rejilla responsiva para las 4 tarjetas -->\\n        <div class=\\\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6\\\">\\n\\n            <!-- Tarjeta 1: Gráfico de ÁREA -->\\n            <div class=\\\"cool-kpi-card p-6 rounded-2xl\\\">\\n                <div class=\\\"flex justify-between items-center mb-2\\\">\\n                    <span class=\\\"text-sm font-medium text-gray-700 dark:text-gray-300\\\">Tráfico Web</span>\\n                    <div class=\\\"p-2 bg-blue-500/10 dark:bg-blue-500/20 rounded-lg\\\">\\n                        <svg class=\\\"w-5 h-5 text-blue-600 dark:text-blue-300\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" stroke-width=\\\"2\\\" d=\\\"M13 7h8m0 0v8m0-8l-8 8-4-4-6 6\\\"></path></svg>\\n                    </div>\\n                </div>\\n                <div class=\\\"text-4xl font-bold text-gray-900 dark:text-white mb-4\\\">78,2K</div>\\n                <div class=\\\"h-24 w-full\\\">\\n                    <canvas id=\\\"sparkAreaChart\\\"></canvas>\\n                </div>\\n            </div>\\n\\n            <!-- Tarjeta 2: Gráfico de BARRAS -->\\n            <div class=\\\"cool-kpi-card p-6 rounded-2xl\\\">\\n                <div class=\\\"flex justify-between items-center mb-2\\\">\\n                    <span class=\\\"text-sm font-medium text-gray-700 dark:text-gray-300\\\">Registros Diarios</span>\\n                    <div class=\\\"p-2 bg-indigo-500/10 dark:bg-indigo-500/20 rounded-lg\\\">\\n                         <svg class=\\\"w-5 h-5 text-indigo-600 dark:text-indigo-300\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" stroke-width=\\\"2\\\" d=\\\"M16 8v8m-4-5v5m-4-2v2M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z\\\"></path></svg>\\n                    </div>\\n                </div>\\n                <div class=\\\"text-4xl font-bold text-gray-900 dark:text-white mb-4\\\">451</div>\\n                <div class=\\\"h-24 w-full\\\">\\n                    <canvas id=\\\"sparkBarChart\\\"></canvas>\\n                </div>\\n            </div>\\n\\n            <!-- Tarjeta 3: Gráfico de DONA (Pie) -->\\n            <div class=\\\"cool-kpi-card p-6 rounded-2xl\\\">\\n                 <div class=\\\"flex justify-between items-center mb-2\\\">\\n                    <span class=\\\"text-sm font-medium text-gray-700 dark:text-gray-300\\\">Meta de Tareas</span>\\n                     <div class=\\\"p-2 bg-green-500/10 dark:bg-green-500/20 rounded-lg\\\">\\n                        <svg class=\\\"w-5 h-5 text-green-600 dark:text-green-300\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" stroke-width=\\\"2\\\" d=\\\"M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z\\\"></path></svg>\\n                    </div>\\n                </div>\\n                <div class=\\\"text-4xl font-bold text-gray-900 dark:text-white mb-4\\\">85%</div>\\n                <div class=\\\"h-24 w-full flex items-center justify-center\\\">\\n                    <div class=\\\"w-24 h-24\\\"> <!-- Contenedor para que la dona no se estire -->\\n                        <canvas id=\\\"sparkDoughnutChart\\\"></canvas>\\n                    </div>\\n                </div>\\n            </div>\\n            \\n            <!-- Tarjeta 4: Gráfico de LÍNEA -->\\n            <div class=\\\"cool-kpi-card p-6 rounded-2xl\\\">\\n                <div class=\\\"flex justify-between items-center mb-2\\\">\\n                    <span class=\\\"text-sm font-medium text-gray-700 dark:text-gray-300\\\">Tasa de Rebote</span>\\n                    <div class=\\\"p-2 bg-red-500/10 dark:bg-red-500/20 rounded-lg\\\">\\n                        <svg class=\\\"w-5 h-5 text-red-600 dark:text-red-300\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" stroke-width=\\\"2\\\" d=\\\"M13 17h8m0 0v-8m0 8l-8-8-4 4-6-6\\\"></path></svg>\\n                    </div>\\n                </div>\\n                <div class=\\\"text-4xl font-bold text-gray-900 dark:text-white mb-4\\\">21.4%</div>\\n                <div class=\\\"h-24 w-full\\\">\\n                    <canvas id=\\\"sparkLineChart\\\"></canvas>\\n                </div>\\n            </div>\\n\\n        </div> <!-- Fin de la rejilla -->\\n    </div> <!-- Fin del contenedor principal -->\\n\\n    \\n\\n</body>\\n</html>\" }} />\n  );\n}\n",
      "type": "registry:ui"
    }
  ],
