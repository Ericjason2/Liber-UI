backdrop-blur-sm px-2 py-1 rounded-full flex space-x-1.5\">\n                    <div class=\"w-1.5 h-1.5 bg-white rounded-full shadow-sm\"></div>\n                    <div class=\"w-1.5 h-1.5 bg-white/40 rounded-full\"></div>\n                    <div class=\"w-1.5 h-1.5 bg-white/40 rounded-full\"></div>\n                    <div class=\"w-1.5 h-1.5 bg-white/40 rounded-full\"></div>\n                </div>\n            </div>\n\n            <div class=\"px-2 pt-4 pb-1\">\n                \n                <div class=\"mb-5\">\n                    <div class=\"flex items-baseline gap-2 mb-1\">\n                        <span class=\"text-2xl font-bold text-gray-900 tracking-tight\">$250,000</span>\n                        <span class=\"text-sm text-gray-400 font-normal\">List price</span>\n                    </div>\n                    <div class=\"text-xs text-gray-500 font-medium truncate\">\n                        <span class=\"text-gray-900\">Guillaume Briard</span> • Harry koningsbergstr, 1063 AG\n                    </div>\n                </div>\n\n                <div class=\"flex items-center gap-3 mb-6\">\n                    <div class=\"bg-gray-100 rounded-xl px-3 py-2 flex items-center gap-2\">\n                        <svg class=\"w-3.5 h-3.5 text-gray-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4\"></path></svg>\n                        <span class=\"text-xs text-gray-600 font-medium\"><strong class=\"text-gray-800\">29 m²</strong> Living</span>\n                    </div>\n                    <div class=\"bg-gray-100 rounded-xl px-3 py-2 flex items-center gap-2\">\n                         <svg class=\"w-3.5 h-3.5 text-gray-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"