roke-linejoin=\"round\" d=\"M3.98 8.53A10.967 10.967 0 0112 6c2.64 0 5.064.947 6.983 2.53M21 12.04a10.967 10.967 0 01-2.535 6.984M8.475 19.527A10.967 10.967 0 0112 18a10.967 10.967 0 013.525-.527M9 12l2.5 2.5L15 9\" />\r\n          </svg>\r\n        </button>\r\n      </div>\r\n\r\n      <div class=\"flex items-center justify-between mb-4\">\r\n        <a href=\"#\" class=\"text-sm text-blue-500 hover:underline\">Forgot Password</a>\r\n      </div>\r\n\r\n      <button \r\n        type=\"submit\" \r\n        class=\"w-full bg-gradient-to-r from-blue-500 to-blue-600 text-white py-2 rounded-lg hover:from-blue-600 hover:to-blue-700 focus:outline-none focus:ring focus:ring-blue-300\">\r\n        Log in\r\n      </button>\r\n\r\n      <div class=\"flex items-center mt-4\">\r\n        <input type=\"checkbox\" id=\"remember\" class=\"mr-2 border-gray-300 rounded text-blue-500 focus:ring-blue-200\" />\r\n        <label for=\"remember\" class=\"text-sm text-gray-600\">Remember me for 30 days</label>\r\n      </div>\r\n\r\n      <p class=\"text-center text-sm text-gray-600 mt-4\">\r\n        Don’t have your account? <a href=\"#\" class=\"text-blue-500 hover:underline\">Sign Up</a>\r\n      </p>\r\n    </form>\r\n  </div>\r\n</div>"
