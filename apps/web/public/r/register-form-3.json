      "content": "/**\n * Component: Register Form\n * Author: @sonam-sherpa (https://tailwindflex.com/@sonam-sherpa)\n * Source: https://tailwindflex.com/@sonam-sherpa/register-form-3\n * Attribution: Créé par @sonam-sherpa sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function RegisterForm3() {\n  return (\n    <div>\n    <div className=\"flex justify-center items-center min-h-screen bg-white\">\n          <div className=\"w-full flex items-center justify-center\">\n            <div className=\"w-3/4 max-w-md p-8 bg-white shadow-lg rounded-lg\">\n              <h2 className=\"text-2xl font-bold text-blue-600 mb-6\">Sign up</h2>\n              <form>\n                <div className=\"mb-4\">\n                  <label className=\"block text-gray-700 text-sm mb-2\">\n                    Username\n                  </label>\n                  <input\n                    type=\"text\"\n                    name=\"username\"\n                    placeholder=\"Enter your username\"\n                    className=\"w-full px-4 py-2 border rounded-lg focus focus2 focus500\"\n                  />\n                </div>\n    \n                <div className=\"mb-4\">\n                  <label className=\"block text-gray-700 text-sm mb-2\">Email</label>\n                  <input\n                    type=\"email\"\n                    name=\"email\"\n                    placeholder=\"Enter your email\"\n                    className=\"w-full px-4 py-2 border rounded-lg focus focus2 focus500\"\n                  />\n                </div>\n    \n                <div className=\"mb-4\">\n                  <label className=\"block text-gray-700 text-sm mb-2\">\n                    Password\n                  </label>\n                  <input\n                    type=\"password\"\n                    name=\"password\"\n                    placeholder=\"Enter your password\"\n                    className=\"w-full px-4 py-2 border rounded-lg focus focus2 focus500\"\n                  />\n                </div>\n    \n                <div className=\"mb-6\">\n                  <label className=\"block text-gray-700 text-sm mb-2\">\n                    Confirm Password\n                  </label>\n                  <input\n                    type=\"password\"\n                    name=\"confirmPassword\"\n                    placeholder=\"Confirm your password\"\n                    className=\"w-full px-4 py-2 border rounded-lg focus focus2 focus500\"\n                  />\n                </div>\n    \n                <button className=\"w-full bg-blue-600 text-white py-2 rounded-lg hover700 transition\">\n                  Sign up\n                </button>\n              </form>\n              <button className=\"w-full mt-4 border border-gray-300 py-2 rounded-lg flex items-center justify-center hover100 transition\">\n                <img\n                  src=\"https://www.svgrepo.com/show/355037/google.svg\"\n                  alt=\"Google\"\n                  className=\"w-5 h-5 mr-2\"\n                />\n                Sign-up with Google\n              </button>\n    \n              <p className=\"mt-6 text-sm text-center text-gray-600\">\n                Already have an account?\n                <a href=\"/signin\" className=\"text-blue-600 hover\">\n                  Sign in\n                </a>\n              </p>\n            </div>\n          </div>\n        </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
