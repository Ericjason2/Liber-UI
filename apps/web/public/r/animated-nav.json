    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>BONIMATOR | Portfolio</title>\n  <link href=\"https://cdn.jsdelivr.net/npm/tailwindcss@3.4.1/dist/tailwind.min.css\" rel=\"stylesheet\" />\n  <style>\n    @keyframes fadeInUp {\n      from {\n        opacity: 0;\n        transform: translateY(20px);\n      }\n      to {\n        opacity: 1;\n        transform: translateY(0);\n      }\n    }\n\n    .fade-in-up {\n      animation: fadeInUp 1s ease-out forwards;\n    }\n  </style>\n</head>\n<body class=\"bg-gradient-to-b from-black via-gray-900 to-black text-white font-sans scroll-smooth\">\n\n  <!-- Navbar -->\n  <header class=\"fixed top-0 left-0 w-full bg-black bg-opacity-60 backdrop-blur-md z-50 shadow-lg\">\n    <div class=\"max-w-7xl mx-auto flex justify-between items-center px-6 py-4 fade-in-up\">\n      <h1 class=\"text-2xl font-bold text-blue-500\">BONIMATOR</h1>\n      <nav>\n        <ul class=\"hidden md:flex space-x-6 text-sm\">\n          <li><a href=\"#home\" class=\"hover:text-blue-400 transition\">Home</a></li>\n          <li><a href=\"#projects\" class=\"hover:text-blue-400 transition\">Projects</a></li>\n          <li><a href=\"#about\" class=\"hover:text-blue-400 transition\">About</a></li>\n          <li><a href=\"#contact\" class=\"hover:text-blue-400 transition\">Contact</a></li>\n        </ul>\n      </nav>\n    </div>\n  </header>\n\n  <!-- Hero / Home -->\n  <section id=\"home\" class=\"min-h-screen flex flex-col justify-center items-center text-center px-4 pt-24\">\n    <h1 class=\"text-5xl md:text-7xl font-bold text-blue-500 mb-4 fade-in-up\">\n      BONIMATOR\n    </h1>\n    <p class=\"text-gray-300 text-lg md:text-xl max-w-2xl mb-8 fade-in-up\" style=\"animation-delay: 0.3s\">\n      Welcome to my digital space where creativity meets clean code. I build interactive, animated, and responsive web experiences.\n    </p>\n    <div class=\"flex gap-6 fade-in-up\" style=\"animation-delay: 0.6s\">\n      <a href=\"#projects\" class=\"bg-blue-600 hover:bg-blue-700 transition duration-300 px-6 py-3 rounded-lg shadow-lg\">\n        Explore Projects\n      </a>\n      <a href=\"#contact\" class=\"border border-blue-500 hover:bg-blue-800 px-6 py-3 rounded-lg transition duration-300\">\n        Contact Me\n      </a>\n    </div>\n  </section>\n\n  <!-- Projects Section -->\n  <section id=\"projects\" class=\"min-h-screen flex items-center justify-center text-center px-4 bg-gray-900\">\n    <h2 class=\"text-4xl font-bold text-blue-400 fade-in-up\">Projects Section</h2>\n  </section>\n\n  <!-- About Section -->\n  <section id=\"about\" class=\"min-h-screen flex items-center justify-center text-center px-4\">\n    <h2 class=\"text-4xl font-bold text-blue-400 fade-in-up\">About Me Section</h2>\n  </section>\n\n  <!-- Contact Section -->\n  <section id=\"contact\" class=\"min-h-screen flex items-center justify-center text-center px-4 bg-gray-900\">\n    <h2 class=\"text-4xl font-bold text-blue-400 fade-in-up\">Contact Section</h2>\n  </section>\n\n  <!-- Footer -->\n  <footer class=\"text-center py-6 text-sm text-gray-500 fade-in-up\" style=\"animation-delay: 0.9s\">\n    &copy; 2025 BONIMATOR. All rights reserved.\n  </footer>\n\n</body>\n</html>"
