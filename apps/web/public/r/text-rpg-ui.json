    "rawHtml": "<script>\n        tailwind.config = {\n            theme: {\n                extend: {\n                    animation: {\n                        'fade-in': 'fade-in 0.5s ease-out',\n                        'slide-up': 'slide-up 0.7s ease-out',\n                        'pixel-shift': 'pixel-shift 0.2s steps(2) infinite',\n                        'neon-pulse': 'neon-pulse 2s ease-in-out infinite',\n                        'hover-bounce': 'hover-bounce 2s ease-in-out infinite',\n                        'text-flicker': 'text-flicker 1.5s linear infinite',\n                        'terminal-blink': 'terminal-blink 1s steps(2) infinite',\n                    },\n                    keyframes: {\n                        'fade-in': {\n                            '0%': { opacity: '0' },\n                            '100%': { opacity: '1' }\n                        },\n                        'slide-up': {\n                            '0%': { transform: 'translateY(20px)', opacity: '0' },\n                            '100%': { transform: 'translateY(0)', opacity: '1' }\n                        },\n                        'pixel-shift': {\n                            '0%, 100%': { transform: 'translateX(0)' },\n                            '50%': { transform: 'translateX(2px)' }\n                        },\n                        'neon-pulse': {\n                            '0%, 100%': { \n                                textShadow: '0 0 7px #fff, 0 0 10px #fff, 0 0 21px #fff, 0 0 42px #5271ff, 0 0 82px #5271ff, 0 0 92px #5271ff, 0 0 102px #5271ff, 0 0 151px #5271ff'\n                            },\n                            '50%': { \n                                textShadow: '0 0 4px #fff, 0 0 7px #fff, 0 0 18px #fff, 0 0 38px #5271ff, 0 0 73px #5271ff, 0 0 80px #5271ff, 0 0 94px #5271ff, 0 0 140px #5271ff'\n                            }\n                        },\n                        'hover-bounce': {\n                            '0%, 100%': { transform: 'translateY(0)' },\n                            '50%': { transform: 'translateY(-5px)' }\n                        },\n                        'text-flicker': {\n                            '0%, 100%': { opacity: '1' },\n                            '50%': { opacity: '0.7' }\n                        },\n                        'terminal-blink': {\n                            '0%, 100%': { opacity: '1' },\n                            '50%': { opacity: '0' }\n                        }\n                    }\n                }\n            }\n        };\n    </script>\n</head>\n<body class=\"bg-neutral-950 min-h-[100dvh]\">\n    <!-- Text RPG Interface Component -->\n    <div class=\"relative p-3 sm:p-4 md:p-6 lg:p-8 min-h-[100dvh] flex flex-col\">\n        <!-- Pixel Art Background -->\n        <div class=\"fixed inset-0 bg-[radial-gradient(#1a1a1a_1px,transparent_1px)] [background-size:16px_16px] opacity-50\"></div>\n        \n        <!-- Game Interface -->\n        <div class=\"relative max-w-5xl mx-auto w-full flex-1 flex flex-col\">\n            <!-- Game Header -->\n            <header class=\"mb-4 sm:mb-6\">\n                <h1 class=\"text-xl sm:text-2xl md:text-3xl font-bold text-white animate-neon-pulse mb-2 text-center sm:text-left\">Cyber Chronicles</h1>\n                <div class=\"flex items-center gap-2 sm:gap-4 text-sm flex-wrap justify-center sm:justify-start\">\n                    <span class=\"text-[#5271ff] whitespace-nowrap\">Level 23</span>\n                    <div class=\"h-1.5 w-32 sm:w-48 bg-neutral-800 rounded-full overflow-hidden\">\n                        <div class=\"h-full w-3/4 bg-[#5271ff] rounded-full\"></div>\n                    </div>\n                    <span class=\"text-neutral-400\">75%</span>\n                </div>\n            </header>\n\n            <!-- Game Content -->\n            <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-4 sm:gap-6 flex-1\">\n                <!-- Main Game Area -->\n                <div class=\"lg:col-span-8 space-y-4 sm:space-y-6 order-2 lg:order-1\">\n                    <!-- Story Text Area -->\n                    <div class=\"bg-neutral-900/80 backdrop-blur border border-[#5271ff]/20 rounded-lg p-3 sm:p-4 md:p-6\">\n                        <div class=\"space-y-3 sm:space-y-4 text-neutral-300 text-sm sm:text-base\">\n                            <p class=\"animate-fade-in\">The neon-lit streets of Neo-Tokyo stretch before you, a maze of holographic advertisements and steam-filled alleyways.</p>\n                            <p class=\"animate-fade-in\" style=\"animation-delay: 0.2s\">A mysterious figure approaches from the shadows, their cybernetic enhancements glowing softly in the darkness.</p>\n                            <p class=\"animate-text-flicker text-[#5271ff]\">> What do you do?</p>\n                        </div>\n                    </div>\n\n                    <!-- Action Choices -->\n                    <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-2 sm:gap-3\">\n                        <button class=\"px-3 sm:px-4 py-2.5 sm:py-3 bg-neutral-900 border border-[#5271ff]/20 rounded-lg text-neutral-400 hover:text-white hover:border-[#5271ff] hover:shadow-[0_0_15px_rgba(82,113,255,0.3)] transition-all duration-300 text-left text-sm sm:text-base\">\n                            <span class=\"text-[#5271ff]\">1.</span> Approach cautiously\n                        </button>\n                        <button class=\"px-3 sm:px-4 py-2.5 sm:py-3 bg-neutral-900 border border-[#5271ff]/20 rounded-lg text-neutral-400 hover:text-white hover:border-[#5271ff] hover:shadow-[0_0_15px_rgba(82,113,255,0.3)] transition-all duration-300 text-left text-sm sm:text-base\">\n                            <span class=\"text-[#5271ff]\">2.</span> Hide in the shadows\n                        </button>\n                        <button class=\"px-3 sm:px-4 py-2.5 sm:py-3 bg-neutral-900 border border-[#5271ff]/20 rounded-lg text-neutral-400 hover:text-white hover:border-[#5271ff] hover:shadow-[0_0_15px_rgba(82,113,255,0.3)] transition-all duration-300 text-left text-sm sm:text-base\">\n                            <span class=\"text-[#5271ff]\">3.</span> Ready your weapon\n                        </button>\n                        <button class=\"px-3 sm:px-4 py-2.5 sm:py-3 bg-neutral-900 border border-[#5271ff]/20 rounded-lg text-neutral-400 hover:text-white hover:border-[#5271ff] hover:shadow-[0_0_15px_rgba(82,113,255,0.3)] transition-all duration-300 text-left text-sm sm:text-base\">\n                            <span class=\"text-[#5271ff]\">4.</span> Call for backup\n                        </button>\n                    </div>\n                </div>\n\n                <!-- Character Stats & Inventory -->\n                <aside class=\"lg:col-span-4 space-y-4 sm:space-y-6 order-1 lg:order-2\">\n                    <!-- Character Stats -->\n                    <div class=\"bg-neutral-900/80 backdrop-blur border border-[#5271ff]/20 rounded-lg p-3 sm:p-4\">\n                        <h2 class=\"text-white font-bold mb-3 sm:mb-4 relative inline-block text-sm sm:text-base\">\n                            Character Stats\n                            <span class=\"absolute -right-4 top-0 text-[#5271ff] animate-pixel-shift\">_</span>\n                        </h2>\n                        <div class=\"space-y-2 sm:space-y-3\">\n                            <div>\n                                <div class=\"flex justify-between text-xs sm:text-sm mb-1\">\n                                    <span class=\"text-neutral-400\">Health</span>\n                                    <span class=\"text-[#5271ff]\">85/100</span>\n                                </div>\n                                <div class=\"h-1.5 bg-neutral-800 rounded-full overflow-hidden\">\n                                    <div class=\"h-full w-[85%] bg-[#5271ff] rounded-full\"></div>\n                                </div>\n                            </div>\n                            <div>\n                                <div class=\"flex justify-between text-xs sm:text-sm mb-1\">\n                                    <span class=\"text-neutral-400\">Energy</span>\n                                    <span class=\"text-[#5271ff]\">60/100</span>\n                                </div>\n                                <div class=\"h-1.5 bg-neutral-800 rounded-full overflow-hidden\">\n                                    <div class=\"h-full w-[60%] bg-[#5271ff] rounded-full\"></div>\n                                </div>\n                            </div>\n                            <div>\n                                <div class=\"flex justify-between text-xs sm:text-sm mb-1\">\n                                    <span class=\"text-neutral-400\">Shield</span>\n                                    <span class=\"text-[#5271ff]\">40/100</span>\n                                </div>\n                                <div class=\"h-1.5 bg-neutral-800 rounded-full overflow-hidden\">\n                                    <div class=\"h-full w-[40%] bg-[#5271ff] rounded-full\"></div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- Inventory -->\n                    <div class=\"bg-neutral-900/80 backdrop-blur border border-[#5271ff]/20 rounded-lg p-3 sm:p-4\">\n                        <h2 class=\"text-white font-bold mb-3 sm:mb-4 relative inline-block text-sm sm:text-base\">\n                            Inventory\n                            <span class=\"absolute -right-4 top-0 text-[#5271ff] animate-pixel-shift\">_</span>\n                        </h2>\n                        <div class=\"grid grid-cols-2 gap-2\">\n                            <div class=\"p-2 bg-neutral-900 border border-[#5271ff]/20 rounded text-xs sm:text-sm text-neutral-400 hover:text-white hover:border-[#5271ff] transition-colors\">\n                                Plasma Pistol\n                            </div>\n                            <div class=\"p-2 bg-neutral-900 border border-[#5271ff]/20 rounded text-xs sm:text-sm text-neutral-400 hover:text-white hover:border-[#5271ff] transition-colors\">\n                                Med Kit\n                            </div>\n                            <div class=\"p-2 bg-neutral-900 border border-[#5271ff]/20 rounded text-xs sm:text-sm text-neutral-400 hover:text-white hover:border-[#5271ff] transition-colors\">\n                                Neural Hack\n                            </div>\n                            <div class=\"p-2 bg-neutral-900 border border-[#5271ff]/20 rounded text-xs sm:text-sm text-neutral-400 hover:text-white hover:border-[#5271ff] transition-colors\">\n                                Shield Cell\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- Quick Actions -->\n                    <div class=\"grid grid-cols-2 gap-2\">\n                        <button class=\"px-3 py-2 bg-neutral-900 border border-[#5271ff]/20 rounded-lg text-neutral-400 hover:text-white hover:border-[#5271ff] hover:shadow-[0_0_15px_rgba(82,113,255,0.3)] transition-all duration-300 text-xs sm:text-sm\">\n                            Save Game\n                        </button>\n                        <button class=\"px-3 py-2 bg-neutral-900 border border-[#5271ff]/20 rounded-lg text-neutral-400 hover:text-white hover:border-[#5271ff] hover:shadow-[0_0_15px_rgba(82,113,255,0.3)] transition-all duration-300 text-xs sm:text-sm\">\n                            Menu\n                        </button>\n                    </div>\n                </aside>\n            </div>\n\n            <!-- Command Input -->\n            <div class=\"sticky bottom-0 left-0 right-0 mt-4 sm:mt-6 bg-neutral-950/90 backdrop-blur-lg p-2 sm:p-3 border-t border-[#5271ff]/20\">\n                <div class=\"max-w-5xl mx-auto\">\n                    <div class=\"bg-neutral-900/90 backdrop-blur border-2 border-[#5271ff]/30 rounded-lg p-3 sm:p-4 shadow-[0_0_15px_rgba(82,113,255,0.15)]\">\n                        <div class=\"flex items-center gap-3\">\n                            <span class=\"text-[#5271ff] text-lg sm:text-xl animate-pulse\">&gt;</span>\n                            <input type=\"text\" \n                                class=\"flex-1 bg-transparent border-none text-white focus:outline-none text-base sm:text-lg placeholder-neutral-500 focus:placeholder-neutral-600\" \n                                placeholder=\"Type your command...\" \n                                aria-label=\"Command input\"\n                            >\n                            <span class=\"text-[#5271ff] text-lg sm:text-xl font-mono animate-terminal-blink\">|</span>\n                        </div>\n                        <div class=\"mt-2 flex gap-2 overflow-x-auto pb-1 scrollbar-thin scrollbar-thumb-[#5271ff]/20 scrollbar-track-transparent\">\n                            <button class=\"px-2 py-1 bg-neutral-800/50 rounded text-xs text-neutral-400 hover:text-white hover:bg-[#5271ff]/20 whitespace-nowrap transition-colors\">\n                                /help\n                            </button>\n                            <button class=\"px-2 py-1 bg-neutral-800/50 rounded text-xs text-neutral-400 hover:text-white hover:bg-[#5271ff]/20 whitespace-nowrap transition-colors\">\n                                /inventory\n                            </button>\n                            <button class=\"px-2 py-1 bg-neutral-800/50 rounded text-xs text-neutral-400 hover:text-white hover:bg-[#5271ff]/20 whitespace-nowrap transition-colors\">\n                                /stats\n                            </button>\n                            <button class=\"px-2 py-1 bg-neutral-800/50 rounded text-xs text-neutral-400 hover:text-white hover:bg-[#5271ff]/20 whitespace-nowrap transition-colors\">\n                                /map\n                            </button>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</body>\n</html>"
  }
