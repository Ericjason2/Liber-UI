nt\\\">\\n    <h2 class=\\\"text-3xl font-bold text-center text-gray-800 mb-12\\\">What Our Customers Say</h2>\\n    <div class=\\\"grid grid-cols-1 md:grid-cols-3 gap-8\\\">\\n      <div class=\\\"neumorphic p-8 rounded-2xl\\\">\\n        <div class=\\\"flex items-center mb-4\\\">\\n          <img src=\\\"https://images.unsplash.com/photo-1494790108377-be9c29b29330\\\" alt=\\\"Customer\\\" class=\\\"w-12 h-12 rounded-full object-cover mr-4\\\">\\n          <div>\\n            <h3 class=\\\"font-bold text-gray-800\\\">Sarah Johnson</h3>\\n            <p class=\\\"text-sm text-gray-600\\\">CEO, Design Studio</p>\\n          </div>\\n        </div>\\n        <p class=\\\"text-gray-600\\\">\\\"The neumorphic design is stunning. Our website has never looked better!\\\"</p>\\n      </div>\\n      <div class=\\\"neumorphic p-8 rounded-2xl\\\">\\n        <div class=\\\"flex items-center mb-4\\\">\\n          <img src=\\\"https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d\\\" alt=\\\"Customer\\\" class=\\\"w-12 h-12 rounded-full object-cover mr-4\\\">\\n          <div>\\n            <h3 class=\\\"font-bold text-gray-800\\\">Michael Chen</h3>\\n            <p class=\\\"text-sm text-gray-600\\\">Founder, Tech Startup</p>\\n          </div>\\n        </div>\\n        <p class=\\\"text-gray-600\\\">\\\"Responsive and fast. Our users love the new interface.\\\"</p>\\n      </div>\\n      <div class=\\\"neumorphic p-8 rounded-2xl\\\">\\n        <div class=\\\"flex items-center mb-4\\\">\\n          <img src=\\\"https://images.unsplash.com/photo-1500648767791-00d99899454d\\\" alt=\\\"Customer\\\" class=\\\"w-12 h-12 rounded-full object-cover mr-4\\\">\\n          <div>\\n            <h3 class=\\\"font-bold text-gray-800\\\">Emma Wilson</h3>\\n            <p class=\\\"text-sm text-gray-600\\\">Marketing Director</p>\\n          </div>\\n        </div>\\n        <p class=\\\"text-gray-600\\\">\\\"The design is modern and unique. Highly recommended!\\\"</p>\\n      </div>\\