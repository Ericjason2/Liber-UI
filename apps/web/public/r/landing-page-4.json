    "rawHtml": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Neumorphic Landing Page</title>\n  <!-- Tailwind CSS CDN -->\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <!-- Font Awesome for icons -->\n  <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n  <!-- Custom CSS for neumorphism effects -->\n  <style>\n    .neumorphic {\n      background: #f1f3f6;\n      border-radius: 20px;\n      box-shadow: 8px 8px 15px #d1d9e6, -8px -8px 15px #ffffff;\n      border: none;\n    }\n    .neumorphic-inset {\n      background: #f1f3f6;\n      border-radius: 20px;\n      box-shadow: inset 3px 3px 6px #d1d9e6, inset -3px -3px 6px #ffffff;\n      border: none;\n    }\n    .neumorphic-btn {\n      background: #f1f3f6;\n      border-radius: 12px;\n      box-shadow: 5px 5px 10px #d1d9e6, -5px -5px 10px #ffffff;\n      border: none;\n      transition: all 0.2s;\n    }\n    .neumorphic-btn:hover {\n      box-shadow: inset 2px 2px 5px #d1d9e6, inset -2px -2px 5px #ffffff;\n    }\n    .hero-image {\n      border-radius: 20px;\n      box-shadow: 8px 8px 15px #d1d9e6, -8px -8px 15px #ffffff;\n    }\n    @media (max-width: 768px) {\n      .hero-image {\n        max-width: 100%;\n        margin-top: 1rem;\n      }\n    }\n  </style>\n</head>\n<body class=\"bg-gray-100 min-h-screen font-sans flex flex-col\">\n  <!-- Navbar -->\n  <nav class=\"bg-transparent py-4 px-6 md:px-12 lg:px-24 fixed w-full z-50\">\n    <div class=\"neumorphic flex justify-between items-center py-2 px-6 rounded-full\">\n      <div class=\"flex items-center\">\n        <span class=\"text-2xl font-bold text-gray-800\">Neumorph</span>\n      </div>\n      <div class=\"hidden md:flex space-x-6\">\n        <a href=\"#\" class=\"text-gray-700 hover:text-blue-600 font-medium\">Home</a>\n        <a href=\"#features\" class=\"text-gray-700 hover:text-blue-600 font-medium\">Features</a>\n        <a href=\"#testimonials\" class=\"text-gray-700 hover:text-blue-600 font-medium\">Testimonials</a>\n        <a href=\"#\" class=\"text-gray-700 hover:text-blue-600 font-medium\">Contact</a>\n      </div>\n      <div class=\"md:hidden\">\n        <button class=\"neumorphic-btn p-2 rounded-full\">\n          <i class=\"fas fa-bars text-gray-700\"></i>\n        </button>\n      </div>\n      <div class=\"hidden md:block\">\n        <button class=\"neumorphic-btn px-4 py-2 font-medium\">Sign Up</button>\n      </div>\n    </div>\n  </nav>\n\n  <!-- Hero Section -->\n  <section class=\"pt-32 pb-16 px-6 md:px-12 lg:px-24 flex flex-col md:flex-row items-center justify-between gap-8\">\n    <div class=\"md:w-1/2\">\n      <h1 class=\"text-4xl md:text-5xl font-bold text-gray-800 mb-6\">Experience the Future of Design</h1>\n      <p class=\"text-lg text-gray-600 mb-8\">Discover a world of soft, minimalistic interfaces that make your website stand out with our neumorphic design.</p>\n      <div class=\"flex space-x-4\">\n        <button class=\"neumorphic-btn px-6 py-3 text-gray-800 font-medium\">Get Started</button>\n        <button class=\"neumorphic-btn px-6 py-3 text-gray-800 font-medium\">Learn More</button>\n      </div>\n    </div>\n    <div class=\"md:w-1/2 flex justify-center\">\n      <img src=\"https://images.unsplash.com/photo-1606744837616-56c9a5c6a6eb\" alt=\"Hero Image\" class=\"hero-image w-full max-w-md h-auto object-cover\">\n    </div>\n  </section>\n\n  <!-- Features Section -->\n  <section id=\"features\" class=\"py-16 px-6 md:px-12 lg:px-24 bg-transparent\">\n    <h2 class=\"text-3xl font-bold text-center text-gray-800 mb-12\">Our Features</h2>\n    <div class=\"grid grid-cols-1 md:grid-cols-3 gap-8\">\n      <div class=\"neumorphic p-8 rounded-2xl text-center\">\n        <div class=\"neumorphic-inset w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4\">\n          <i class=\"fas fa-rocket text-2xl text-blue-600\"></i>\n        </div>\n        <h3 class=\"text-xl font-bold text-gray-800 mb-2\">Fast Performance</h3>\n        <p class=\"text-gray-600\">Lightweight and optimized for speed. Your users will love the seamless experience.</p>\n      </div>\n      <div class=\"neumorphic p-8 rounded-2xl text-center\">\n        <div class=\"neumorphic-inset w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4\">\n          <i class=\"fas fa-mobile-alt text-2xl text-blue-600\"></i>\n        </div>\n        <h3 class=\"text-xl font-bold text-gray-800 mb-2\">Fully Responsive</h3>\n        <p class=\"text-gray-600\">Looks amazing on all devices, from smartphones to desktops.</p>\n      </div>\n      <div class=\"neumorphic p-8 rounded-2xl text-center\">\n        <div class=\"neumorphic-inset w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4\">\n          <i class=\"fas fa-paint-brush text-2xl text-blue-600\"></i>\n        </div>\n        <h3 class=\"text-xl font-bold text-gray-800 mb-2\">Modern Design</h3>\n        <p class=\"text-gray-600\">Clean, minimal, and stylish. Stand out with neumorphic aesthetics.</p>\n      </div>\n    </div>\n  </section>\n\n  <!-- Testimonials Section -->\n  <section id=\"testimonials\" class=\"py-16 px-6 md:px-12 lg:px-24 bg-transparent\">\n    <h2 class=\"text-3xl font-bold text-center text-gray-800 mb-12\">What Our Customers Say</h2>\n    <div class=\"grid grid-cols-1 md:grid-cols-3 gap-8\">\n      <div class=\"neumorphic p-8 rounded-2xl\">\n        <div class=\"flex items-center mb-4\">\n          <img src=\"https://images.unsplash.com/photo-1494790108377-be9c29b29330\" alt=\"Customer\" class=\"w-12 h-12 rounded-full object-cover mr-4\">\n          <div>\n            <h3 class=\"font-bold text-gray-800\">Sarah Johnson</h3>\n            <p class=\"text-sm text-gray-600\">CEO, Design Studio</p>\n          </div>\n        </div>\n        <p class=\"text-gray-600\">\"The neumorphic design is stunning. Our website has never looked better!\"</p>\n      </div>\n      <div class=\"neumorphic p-8 rounded-2xl\">\n        <div class=\"flex items-center mb-4\">\n          <img src=\"https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d\" alt=\"Customer\" class=\"w-12 h-12 rounded-full object-cover mr-4\">\n          <div>\n            <h3 class=\"font-bold text-gray-800\">Michael Chen</h3>\n            <p class=\"text-sm text-gray-600\">Founder, Tech Startup</p>\n          </div>\n        </div>\n        <p class=\"text-gray-600\">\"Responsive and fast. Our users love the new interface.\"</p>\n      </div>\n      <div class=\"neumorphic p-8 rounded-2xl\">\n        <div class=\"flex items-center mb-4\">\n          <img src=\"https://images.unsplash.com/photo-1500648767791-00d99899454d\" alt=\"Customer\" class=\"w-12 h-12 rounded-full object-cover mr-4\">\n          <div>\n            <h3 class=\"font-bold text-gray-800\">Emma Wilson</h3>\n            <p class=\"text-sm text-gray-600\">Marketing Director</p>\n          </div>\n        </div>\n        <p class=\"text-gray-600\">\"The design is modern and unique. Highly recommended!\"</p>\n      </div>\n    </div>\n  </section>\n\n  <!-- Footer -->\n  <footer class=\"mt-auto py-12 px-6 md:px-12 lg:px-24 bg-transparent\">\n    <div class=\"neumorphic p-8 rounded-2xl\">\n      <div class=\"grid grid-cols-1 md:grid-cols-4 gap-8\">\n        <div>\n          <h3 class=\"text-xl font-bold text-gray-800 mb-4\">Neumorph</h3>\n          <p class=\"text-gray-600\">Experience the future of design with our modern, minimalistic interfaces.</p>\n        </div>\n        <div>\n          <h3 class=\"text-lg font-bold text-gray-800 mb-4\">Quick Links</h3>\n          <ul class=\"space-y-2\">\n            <li><a href=\"#\" class=\"text-gray-600 hover:text-blue-600\">Home</a></li>\n            <li><a href=\"#features\" class=\"text-gray-600 hover:text-blue-600\">Features</a></li>\n            <li><a href=\"#testimonials\" class=\"text-gray-600 hover:text-blue-600\">Testimonials</a></li>\n            <li><a href=\"#\" class=\"text-gray-600 hover:text-blue-600\">Contact</a></li>\n          </ul>\n        </div>\n        <div>\n          <h3 class=\"text-lg font-bold text-gray-800 mb-4\">Support</h3>\n          <ul class=\"space-y-2\">\n            <li><a href=\"#\" class=\"text-gray-600 hover:text-blue-600\">Help Center</a></li>\n            <li><a href=\"#\" class=\"text-gray-600 hover:text-blue-600\">FAQ</a></li>\n            <li><a href=\"#\" class=\"text-gray-600 hover:text-blue-600\">Privacy Policy</a></li>\n            <li><a href=\"#\" class=\"text-gray-600 hover:text-blue-600\">Terms of Service</a></li>\n          </ul>\n        </div>\n        <div>\n          <h3 class=\"text-lg font-bold text-gray-800 mb-4\">Connect With Us</h3>\n          <div class=\"flex space-x-4\">\n            <a href=\"#\" class=\"neumorphic-btn w-10 h-10 flex items-center justify-center rounded-full\"><i class=\"fab fa-facebook-f text-blue-600\"></i></a>\n            <a href=\"#\" class=\"neumorphic-btn w-10 h-10 flex items-center justify-center rounded-full\"><i class=\"fab fa-twitter text-blue-600\"></i></a>\n            <a href=\"#\" class=\"neumorphic-btn w-10 h-10 flex items-center justify-center rounded-full\"><i class=\"fab fa-instagram text-blue-600\"></i></a>\n            <a href=\"#\" class=\"neumorphic-btn w-10 h-10 flex items-center justify-center rounded-full\"><i class=\"fab fa-linkedin-in text-blue-600\"></i></a>\n          </div>\n        </div>\n      </div>\n      <div class=\"mt-8 pt-6 border-t border-gray-200 text-center text-gray-600\">\n        <p>&copy; 2025 Neumorph. All rights reserved.</p>\n      </div>\n    </div>\n  </footer>\n</body>\n</html>"
