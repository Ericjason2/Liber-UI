4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z\" />\n                        </svg>\n                    </div>\n                </div>\n                <h3 class=\"text-sm font-semibold text-cyan-700\">Personal Information</h3>\n            </div>\n                         <div class=\"p-6 border-r border-cyan-200 text-center relative opacity-50\">\n                <div class=\"flex items-center justify-center mb-4\">\n                    <div class=\"w-12 h-12 rounded-full bg-cyan-300 text-white flex items-center justify-center font-bold text-lg relative z-10\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-6 w-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z\" />\n                        </svg>\n                    </div>\n                </div>\n                <h3 class=\"text-sm font-semibold text-cyan-700\">Contact Details</h3>\n            </div>\n            <div class=\"p-6 border-r border-cyan-200 text-center relative opacity-50\">\n                <div class=\"flex items-center justify-center mb-4\">\n                    <div class=\"w-12 h-12 rounded-full bg-cyan-300 text-white flex items-center justify-center font-bold text-lg relative z-10\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-6 w-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z\" />\n                            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M1