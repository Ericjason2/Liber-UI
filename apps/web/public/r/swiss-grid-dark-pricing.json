n className=\"text-lg text-neutral-600 font-normal\">/mo</span>\n              </div>\n    \n              <ul className=\"space-y-4 font-mono text-sm text-neutral-300\">\n                <li className=\"flex items-center gap-3\">\n                  <span className=\"w-1.5 h-1.5 bg-lime-400 rounded-full shadow-[0_0_8px_rgba(163,230,53,0.5)]\"></span>\n                  Up to 10 Users\n                </li>\n                <li className=\"flex items-center gap-3\">\n                  <span className=\"w-1.5 h-1.5 bg-lime-400 rounded-full shadow-[0_0_8px_rgba(163,230,53,0.5)]\"></span>\n                  Unlimited Projects\n                </li>\n                <li className=\"flex items-center gap-3\">\n                  <span className=\"w-1.5 h-1.5 bg-lime-400 rounded-full shadow-[0_0_8px_rgba(163,230,53,0.5)]\"></span>\n                  Analytics Dashboard\n                </li>\n                <li className=\"flex items-center gap-3\">\n                  <span className=\"w-1.5 h-1.5 bg-lime-400 rounded-full shadow-[0_0_8px_rgba(163,230,53,0.5)]\"></span>\n                  24h Support Response\n                </li>\n              </ul>\n            </div>\n    \n            <button className=\"w-full mt-12 py-4 bg-lime-400 text-black font-bold hover300 transition-colors duration-300 shadow-[0_0_20px_rgba(163,230,53,0.1)] hover[0_0_30px_rgba(163,230,53,0.3)]\">\n              Get Started\n            </button>\n          </div>\n    \n          <div className=\"group relative border-r border-b border-neutral-800 p-8 md12 transition-colors duration-500 hover900/50 flex flex-col justify-between min-h-[500px]\">\n            <div>\n              <div className=\"inline-block px-3 py-1 mb-6 text-xs font-mono border border-neutral-700 rounded-full text-neutral-400 group-hover500 transition-colors\">\n                03 / CORP\n              </div>\n              <h3 className=\"text-3xl font-medium text-white mb-2\">Agency</h3>\n              <p className=\"text-