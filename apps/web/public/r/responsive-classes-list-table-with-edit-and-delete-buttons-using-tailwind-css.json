d\">Edit</button>\n                  <button className=\"bg-red-500 text-white px-3 py-1 rounded-md text-xs md\">Delete</button>\n                </td>\n              </tr>\n              <tr className=\"border-b text-xs md text-center text-gray-800\">\n                <td className=\"p-2 md4\">02</td>\n                <td className=\"p-2 md4\">Class 2</td>\n                <td className=\"p-2 md4\">Intermediate</td>\n                <td className=\"relative p-2 md4 flex justify-center space-x-2\">\n                  <button className=\"bg-blue-500 text-white px-3 py-1 rounded-md text-xs md\">Edit</button>\n                  <button className=\"bg-red-500 text-white px-3 py-1 rounded-md text-xs md\">Delete</button>\n                </td>\n              </tr>\n              <tr className=\"border-b text-xs md text-center text-gray-800\">\n                <td className=\"p-2 md4\">03</td>\n                <td className=\"p-2 md4\">Class 3</td>\n                <td className=\"p-2 md4\">Advanced</td>\n                <td className=\"relative p-2 md4 flex justify-center space-x-2\">\n                  <button className=\"bg-blue-500 text-white px-3 py-1 rounded-md text-xs md\">Edit</button>\n                  <button className=\"bg-red-500 text-white px-3 py-1 rounded-md text-xs md\">Delete</button>\n                </td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n    </div>\n  );\n}\n",
