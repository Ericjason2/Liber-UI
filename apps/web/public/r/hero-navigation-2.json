      "content": "/**\n * Component: Hero $ Navigation\n * Author: @Shadad-01 (https://tailwindflex.com/@Shadad-01)\n * Source: https://tailwindflex.com/@Shadad-01/hero-navigation-2\n * Attribution: Créé par @Shadad-01 sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function HeroNavigation2() {\n  return (\n    <div dangerouslySetInnerHTML={{ __html: \"<!DOCTYPE html>\\n<html lang=\\\"en\\\">\\n<head>\\n    <meta charset=\\\"UTF-8\\\">\\n    <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\">\\n    <title>AI Solutions | Next-Gen Intelligence</title>\\n    \\n    \\n    <link href=\\\"https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;700&family=Inter:wght@300;400;600&display=swap\\\" rel=\\\"stylesheet\\\">\\n</head>\\n<body class=\\\"overflow-x-hidden bg-gray-900\\\">\\n    <!-- Navigation -->\\n    <nav class=\\\"fixed w-full z-50 backdrop-blur-md bg-gray-900/80 border-b border-cyan-500/20\\\">\\n        <div class=\\\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\\\">\\n            <div class=\\\"flex items-center justify-between h-16\\\">\\n                <div class=\\\"flex items-center\\\">\\n                    <div class=\\\"flex-shrink-0\\\">\\n                        <span class=\\\"text-2xl font-bold bg-gradient-to-r from-cyan-400 to-blue-600 bg-clip-text text-transparent font-orbitron\\\">NEURALCORE</span>\\n                    </div>\\n                </div>\\n                <div class=\\\"hidden md:block\\\">\\n                    <div class=\\\"ml-10 flex items-baseline space-x-8\\\">\\n                        <a href=\\\"#\\\" class=\\\"text-cyan-100 hover:text-cyan-400 px-3 py-2 rounded-md text-sm font-medium transition-all duration-300\\\">Platform</a>\\n                        <a href=\\\"#\\\" class=\\\"text-cyan-100 hover:text-cyan-400 px-3 py-2 rounded-md text-sm font-medium transition-all duration-300\\\">Solutions</a>\\n                        <a href=\\\"#\\\" class=\\\"text-cyan-100 hover:text-cyan-400 px-3 py-2 rounded-md text-sm font-medium transition-all duration-300\\\">Research</a>\\n                        <a href=\\\"#\\\" class=\\\"text-cyan-100 hover:text-cyan-400 px-3 py-2 rounded-md text-sm font-medium transition-all duration-300\\\">Company</a>\\n                        <a href=\\\"#\\\" class=\\\"text-cyan-100 hover:text-cyan-400 px-3 py-2 rounded-md text-sm font-medium transition-all duration-300\\\">Contact</a>\\n                    </div>\\n                </div>\\n                <div class=\\\"hidden md:block\\\">\\n                    <button class=\\\"ml-4 px-6 py-2 bg-gradient-to-r from-cyan-500 to-blue-600 text-white text-sm font-medium rounded-full hover:from-cyan-600 hover:to-blue-700 transition-all duration-300 shadow-lg hover:shadow-cyan-500/30\\\">\\n                        Get Started\\n                    </button>\\n                </div>\\n            </div>\\n        </div>\\n    </nav>\\n\\n    <!-- Hero Section -->\\n    <section class=\\\"relative h-screen w-full overflow-hidden flex items-center justify-center pt-16\\\">\\n        <!-- 3D Neural Network Background -->\\n        <div id=\\\"neural-background\\\" class=\\\"absolute inset-0 z-0\\\"></div>\\n        \\n        <!-- Gradient Overlay -->\\n        <div class=\\\"absolute inset-0 bg-gradient-to-b from-gray-900/90 via-gray-900/95 to-gray-900 z-1\\\"></div>\\n        \\n        <!-- Content Overlay -->\\n        <div class=\\\"relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center\\\">\\n            <div class=\\\"mb-8 animate-fade-in-up\\\">\\n                <span class=\\\"inline-block px-3 py-1 text-xs font-semibold text-cyan-300 bg-cyan-900/30 rounded-full border border-cyan-500/30\\\">\\n                    TRUSTED BY INDUSTRY LEADERS\\n                </span>\\n            </div>\\n            \\n            <!-- Company Logos -->\\n            <div class=\\\"flex flex-wrap justify-center items-center gap-6 md:gap-10 mb-12 px-4 animate-fade-in-up delay-75\\\">\\n                <img src=\\\"https://upload.wikimedia.org/wikipedia/commons/4/44/Microsoft_logo.svg\\\" alt=\\\"Microsoft\\\" class=\\\"h-8 opacity-80 hover:opacity-100 transition-opacity duration-300\\\">\\n                <img src=\\\"https://upload.wikimedia.org/wikipedia/commons/a/ab/Meta-Logo.png\\\" alt=\\\"Meta\\\" class=\\\"h-8 opacity-80 hover:opacity-100 transition-opacity duration-300\\\">\\n                <img src=\\\"https://upload.wikimedia.org/wikipedia/commons/a/a9/Amazon_logo.svg\\\" alt=\\\"Amazon\\\" class=\\\"h-8 opacity-80 hover:opacity-100 transition-opacity duration-300\\\">\\n                <img src=\\\"https://upload.wikimedia.org/wikipedia/commons/f/fa/Apple_logo_black.svg\\\" alt=\\\"Apple\\\" class=\\\"h-8 opacity-80 hover:opacity-100 transition-opacity duration-300\\\">\\n                <img src=\\\"https://upload.wikimedia.org/wikipedia/commons/5/51/IBM_logo.svg\\\" alt=\\\"IBM\\\" class=\\\"h-8 opacity-80 hover:opacity-100 transition-opacity duration-300\\\">\\n            </div>\\n            \\n            <h1 class=\\\"text-4xl md:text-6xl lg:text-7xl font-bold text-white mb-6 leading-tight animate-fade-in-up delay-150\\\">\\n                <span class=\\\"inline-block bg-gradient-to-r from-cyan-400 to-blue-500 bg-clip-text text-transparent\\\">Enterprise-Grade</span>\\n                <span class=\\\"inline-block bg-gradient-to-r from-cyan-400 to-blue-500 bg-clip-text text-transparent\\\">AI Solutions</span>\\n            </h1>\\n            \\n            <p class=\\\"text-lg md:text-xl text-cyan-100 mb-10 max-w-3xl mx-auto animate-fade-in-up delay-300\\\">\\n                Powering the next generation of intelligent applications with our proprietary neural architecture and deep learning frameworks.\\n            </p>\\n            \\n            <div class=\\\"flex flex-col sm:flex-row justify-center gap-4 animate-fade-in-up delay-450\\\">\\n                <button class=\\\"px-8 py-4 bg-gradient-to-r from-cyan-500 to-blue-600 text-white rounded-full font-bold text-lg hover:from-cyan-600 hover:to-blue-700 transition-all duration-300 transform hover:-translate-y-1 shadow-lg hover:shadow-cyan-500/30\\\">\\n                    Request Demo\\n                </button>\\n                <button class=\\\"px-8 py-4 border-2 border-cyan-400 text-cyan-100 rounded-full font-bold text-lg hover:bg-cyan-400/10 transition-all duration-300 transform hover:-translate-y-1 shadow-lg hover:shadow-cyan-500/20\\\">\\n                    Explore Technology\\n                </button>\\n            </div>\\n            \\n            <div class=\\\"mt-16 grid grid-cols-3 md:flex justify-center items-center gap-8 animate-fade-in-up delay-600\\\">\\n                <div class=\\\"text-center\\\">\\n                    <div class=\\\"text-3xl font-bold bg-gradient-to-r from-cyan-400 to-blue-500 bg-clip-text text-transparent\\\">250+</div>\\n                    <div class=\\\"text-sm text-cyan-200\\\">Patented Algorithms</div>\\n                </div>\\n                <div class=\\\"text-center\\\">\\n                    <div class=\\\"text-3xl font-bold bg-gradient-to-r from-cyan-400 to-blue-500 bg-clip-text text-transparent\\\">99.9%</div>\\n                    <div class=\\\"text-sm text-cyan-200\\\">Uptime SLA</div>\\n                </div>\\n                <div class=\\\"text-center\\\">\\n                    <div class=\\\"text-3xl font-bold bg-gradient-to-r from-cyan-400 to-blue-500 bg-clip-text text-transparent\\\">40ms</div>\\n                    <div class=\\\"text-sm text-cyan-200\\\">Response Time</div>\\n                </div>\\n                <div class=\\\"text-center\\\">\\n                    <div class=\\\"text-3xl font-bold bg-gradient-to-r from-cyan-400 to-blue-500 bg-clip-text text-transparent\\\">∞</div>\\n                    <div class=\\\"text-sm text-cyan-200\\\">Scalability</div>\\n                </div>\\n            </div>\\n        </div>\\n    </section>\\n\\n    <!-- Custom Animation Styles -->\\n    <style>\\n        .font-orbitron {\\n            font-family: 'Orbitron', sans-serif;\\n        }\\n        \\n        @keyframes fadeInUp {\\n            from {\\n                opacity: 0;\\n                transform: translateY(20px);\\n            }\\n            to {\\n                opacity: 1;\\n                transform: translateY(0);\\n            }\\n        }\\n        \\n        .animate-fade-in-up {\\n            animation: fadeInUp 1s ease-out forwards;\\n            opacity: 0;\\n        }\\n        \\n        .delay-75 {\\n            animation-delay: 0.075s;\\n        }\\n        \\n        .delay-150 {\\n            animation-delay: 0.15s;\\n        }\\n        \\n        .delay-300 {\\n            animation-delay: 0.3s;\\n        }\\n        \\n        .delay-450 {\\n            animation-delay: 0.45s;\\n        }\\n        \\n        .delay-600 {\\n            animation-delay: 0.6s;\\n        }\\n    </style>\\n\\n    <!-- Three.js Neural Network Background -->\\n    \\n</body>\\n</html>\" }} />\n  );\n}\n",
      "type": "registry:ui"
    }
  ],
