      "content": "import * as React from \"react\"\n\nfunction ProductReviewCard2({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"product-review-card-2\"\n      className={className}\n      {...props}\n    >\n      <section className=\"container mx-auto p-10 md:py-20 px-0 md:p-10 md:px-0\">\n          <section className=\"relative px-10 md:p-0 transform duration-500 hover:shadow-2xl cursor-pointer hover:-translate-y-1 \">\n              <img className=\"xl:max-w-6xl\" src=\"https://images.pexels.com/photos/5990153/pexels-photo-5990153.jpeg?auto=compress&amp;cs=tinysrgb&amp;dpr=3&amp;h=750&amp;w=1860\" alt=\"\" />\n              <div className=\"content bg-white p-2 pt-8 md:p-12 pb-12 lg:max-w-lg w-full lg:absolute top-48 right-5\">\n                  <div className=\"flex justify-between font-bold text-sm\">\n                      <p>Product Review</p>\n                      <p className=\"text-gray-400\">17th March, 2021</p>\n                  </div>\n                  <h2 className=\"text-3xl font-semibold mt-4 md:mt-10\">Coffee From Heaven</h2>\n                  <p className=\"my-3 text-justify font-medium text-gray-700 leading-relaxed\">Lorem ipsum dolor sit amet\n                      consectetur adipisicing elit. Autem aperiam nulla cupiditate saepe sed quis veritatis minus rem adipisci\n                      aliquid.</p>\n                  <button className=\"mt-2 md:mt-5 p-3 px-5 bg-blue text-white font-bold text-sm hover:bg-purple-800\">Read\n                More</button>\n              </div>\n          </section>\n      </section>\n    </div>\n  )\n}\n\nexport { ProductReviewCard2 }\n",
      "type": "registry:ui"
    }
  ],
