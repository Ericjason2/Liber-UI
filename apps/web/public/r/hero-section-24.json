    "rawHtml": "<body class=\"min-h-screen flex items-center justify-center bg-gray-900 font-sans px-4\">\n  <div class=\"relative w-full max-w-7xl mx-auto rounded-xl overflow-hidden shadow-2xl\">\n    <!-- Background Image with Overlay -->\n    <div class=\"absolute inset-0 bg-cover bg-center\" style=\"background-image: url('https://images.unsplash.com/photo-1506744038136-46273834b3fb?ixlib=rb-4.0.3&auto=format&fit=crop&w=1600&q=80');\"></div>\n    <div class=\"absolute inset-0 bg-black bg-opacity-40 backdrop-blur-sm\"></div>\n    \n    <!-- Content -->\n    <div class=\"relative z-10 flex flex-col items-center justify-center text-center px-6 py-24 md:py-32 bg-gradient-to-b from-transparent via-black/50 to-black/80\">\n      <h1 class=\"text-4xl md:text-6xl font-extrabold text-white drop-shadow-lg mb-4 tracking-wide leading-tight\">\n        Unlock Your Creative Potential\n      </h1>\n\n      <p class=\"text-lg md:text-xl text-gray-200 mb-8 max-w-2xl mx-auto\">\n        Dive into innovative designs, seamless user experiences, and cutting-edge technology. Your journey to greatness starts here.\n      </p>\n      <div class=\"flex flex-col md:flex-row gap-4\">\n        <a href=\"#\" class=\"px-8 py-4 bg-gradient-to-r from-pink-500 via-red-500 to-yellow-500 text-white font-semibold rounded-full shadow-lg transform hover:scale-105 transition duration-300 ease-in-out text-lg\">\n          Get Started\n        </a>\n        <a href=\"#\" class=\"px-8 py-4 border-2 border-white text-white font-semibold rounded-full hover:bg-white hover:text-gray-900 transition duration-300 ease-in-out text-lg\">\n          Explore More\n        </a>\n      </div>\n    </div>\n  </div>\n</body>"
