      "content": "import * as React from \"react\"\n\nfunction SimpleSignUpBox({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"simple-sign-up-box\"\n      className={className}\n      {...props}\n    >\n      <div className=\"w-96 backdrop-blur-lg bg-opacity-80 rounded-lg shadow-lg p-5 bg-gray-900 text-white\">\n        <h2 className=\"text-2xl font-bold pb-5\">SignUp</h2>\n        <form>\n          <div className=\"mb-4\">\n            <label htmlFor=\"name\" className=\"block mb-2 text-sm font-medium\">Your name</label>\n            <input\n              type=\"text\"\n              id=\"name\"\n              className=\"bg-gray-100 border border-gray-300 text-gray-900 text-sm rounded-lg focus2 focus500 focus500 w-full py-2.5 px-4\"\n              placeholder=\"Andrew Jackson\"\n              required\n              value=\"\"\n             />\n          </div>\n          <div className=\"mb-4\">\n            <label htmlFor=\"email\" className=\"block mb-2 text-sm font-medium\">Your email</label>\n            <input\n              type=\"email\"\n              id=\"email\"\n              className=\"bg-gray-100 border border-gray-300 text-gray-900 text-sm rounded-lg focus2 focus500 focus500 w-full py-2.5 px-4\"\n              placeholder=\"andrew.com\"\n              required\n              value=\"\"\n             />\n          </div>\n          <div className=\"mb-4\">\n            <label htmlFor=\"password\" className=\"block mb-2 text-sm font-medium\">Your password</label>\n            <input\n              type=\"password\"\n              id=\"password\"\n              className=\"bg-gray-100 border border-gray-300 text-gray-900 text-sm rounded-lg focus2 focus500 focus500 w-full py-2.5 px-4\"\n              placeholder=\"*********\"\n              required\n              value=\"\"\n             />\n          </div>\n          <div>\n            <p className=\"text-red-500 pb-5\"></p>\n          </div>\n          <div className=\"flex items-center justify-between mb-4\">\n            <button\n              type=\"submit\"\n              className=\"text-white bg-purple-600 hover700 focus2 focus300 font-medium rounded-lg text-sm py-2.5 px-5 w-full sm\"\n            >\n              Register\n            </button>\n            <div className=\"flex items-center text-sm\">\n              <p>Already have an account?</p>\n              <p className=\"underline cursor-pointer ml-1\">Sign in</p>\n            </div>\n          </div>\n        </form>\n      </div>\n    </div>\n  )\n}\n\nexport { SimpleSignUpBox }\n",
      "type": "registry:ui"
    }
  ],
  "meta": {
    "kind": "component",
