    "rawHtml": "<div class=\"min-h-screen bg-gray-100 flex items-center justify-center p-4\">\n  <div class=\"w-full max-w-md bg-white rounded-2xl shadow-xl p-8\">\n    <div class=\"text-center mb-8\">\n      <h1 class=\"text-3xl font-bold text-gray-900\">Welcome Back</h1>\n    </div>\n\n    <form [formGroup]=\"loginForm\" (ngSubmit)=\"onSubmit()\" class=\"space-y-6\">\n      <div>\n        <label class=\"block text-sm font-medium text-gray-700 mb-2\"> Email </label>\n\n        <input\n          type=\"email\"\n          formControlName=\"email\"\n          class=\"w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent\"\n          placeholder=\"Enter your email\"\n        />\n\n        <!-- @if (loginForm.get('email')?.touched && loginForm.get('email')?.invalid) {\n          <p class=\"text-red-500 text-sm mt-1\">Valid email is required</p>\n        } -->\n      </div>\n\n      <div>\n        <label class=\"block text-sm font-medium text-gray-700 mb-2\"> Password </label>\n\n        <input\n          type=\"password\"\n          formControlName=\"password\"\n          class=\"w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent\"\n          placeholder=\"Enter your password\"\n        />\n\n        <!-- @if (loginForm.get('password')?.touched && loginForm.get('password')?.invalid) {\n          <div class=\"mt-1\">\n            @if (loginForm.get('password')?.hasError('required')) {\n              <p class=\"text-red-500 text-sm\">Password is required.</p>\n            } @else if (loginForm.get('password')?.hasError('minlength')) {\n              <p class=\"text-red-500 text-sm\">Password must be at least 6 characters long.</p>\n            } @else if (loginForm.get('password')?.hasError('pattern')) {\n              <p class=\"text-red-500 text-sm\">\n                Password must include an uppercase letter, lowercase letter, number, and special\n                character.\n              </p>\n            }\n          </div>\n        } -->\n      </div>\n\n      <button\n        type=\"submit\"\n        class=\"cursor-pointer w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 rounded-xl transition-colors duration-200\"\n      >\n        Sign In\n      </button>\n      <div class=\"text-center pt-2\">\n        <p class=\"text-gray-600\">\n          Don’t have an account?\n          <a routerLink=\"/register\" class=\"text-blue-600 hover:text-blue-700 font-medium\">\n            Create one\n          </a>\n        </p>\n      </div>\n    </form>\n  </div>\n</div>"
