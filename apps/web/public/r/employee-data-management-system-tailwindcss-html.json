    "rawHtml": "<link href=\"https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css\" rel=\"stylesheet\">\n\n<nav class=\"fixed top-0 left-0 w-full bg-white shadow-md py-3 px-6 flex justify-between items-center z-50\">\n    \n    <a href=\"features\" class=\"text-xl font-bold text-gray-800 hover:text-red-500\">Employee Management</a>\n\n    \n    <div class=\"space-x-6 hidden md:flex\">\n        <a href=\"#\" class=\"text-gray-700 hover:text-blue-500\">Entire DB</a>\n        <a href=\"#\" class=\"text-gray-700 hover:text-blue-500\">Employee</a>\n        <a href=\"#\" class=\"text-gray-700 hover:text-blue-500\">Addition</a>\n        <a href=\"#\" class=\"text-gray-700 hover:text-blue-500\">Modification</a>\n        <a href=\"#\" class=\"text-gray-700 hover:text-blue-500\">Deletion</a>\n    </div>\n\n    <!-- Logout Button -->\n    <a class=\"bg-red-500 text-white px-4 py-2 rounded-md hover:bg-red-600\" href=\"#\" >Logout</a>\n</nav>\n\n<!-- Add margin to the top of your existing content to prevent overlap -->\n<div class=\"mt-16\"></div>\n\n\n<div class=\"h-screen dark:bg-gray-800\">\n\n\t<div\n\t\tclass=\"items-center max-w-screen-xl px-4 py-8 mx-auto lg:grid lg:grid-cols-4 lg:gap-16 xl:gap-24 lg:py-24 lg:px-6\">\n\t\t<div class=\"col-span-2 mb-8\">\n\t\t\t<p class=\"text-lg font-medium text-purple-500 dark:text-purple-500\">Trusted Worldwide</p>\n\t\t\t<h2 class=\"mt-3 mb-4 text-3xl font-extrabold tracking-tight text-gray-900 md:text-3xl dark:text-white\">\n\t\t\t\tTrusted\n\t\t\t\tby over 600 million users and 10,000 teams</h2>\n\t\t\t<p class=\"font-light text-gray-500 sm:text-xl dark:text-gray-400\">Our rigorous security and compliance\n\t\t\t\tstandards\n\t\t\t\tare at the heart of all we do. We work tirelessly to protect you and your customers.</p>\n\t\t\t<div class=\"pt-6 mt-6 space-y-4 border-t border-gray-200 dark:border-gray-700\">\n\t\t\t\t<div>\n\t\t\t\t\t<button (click)=\"fetchUsers()\" id=\"123\" class=\"inline-flex items-center text-base font-medium text-purple-500 hover:text-purple-800 dark:text-purple-500 dark:hover:text-purple-700\">\n\t\t\t\t\t\tView Entire Data of employees\n\t\t\t\t\t\t<svg class=\"w-5 h-5 ml-1\" fill=\"currentColor\" viewBox=\"0 0 20 20\"\n\t\t\t\t\t\t\txmlns=\"http://www.w3.org/2000/svg\">\n\t\t\t\t\t\t\t<path fill-rule=\"evenodd\"\n\t\t\t\t\t\t\t\td=\"M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z\"\n\t\t\t\t\t\t\t\tclip-rule=\"evenodd\"></path>\n\t\t\t\t\t\t</svg>\n\t\t\t\t\t</button>\n\t\t\t\t</div>\n\t\t\t\t<div>\n\t\t\t\t\t<button (click)=\"fetchUser()\" class=\"inline-flex items-center text-base font-medium text-purple-500 hover:text-purple-800 dark:text-purple-500 dark:hover:text-purple-700\">\n\t\t\t\t\t\tSearch for any Employee\n\t\t\t\t\t\t<svg class=\"w-5 h-5 ml-1\" fill=\"currentColor\" viewBox=\"0 0 20 20\"\n\t\t\t\t\t\t\txmlns=\"http://www.w3.org/2000/svg\">\n\t\t\t\t\t\t\t<path fill-rule=\"evenodd\"\n\t\t\t\t\t\t\t\td=\"M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z\"\n\t\t\t\t\t\t\t\tclip-rule=\"evenodd\"></path>\n\t\t\t\t\t\t</svg>\n\t\t\t\t\t</button>\n\t\t\t\t</div>\n                <div>\n\t\t\t\t\t<button (click)=\"addUser()\" class=\"inline-flex items-center text-base font-medium text-purple-500 hover:text-purple-800 dark:text-purple-500 dark:hover:text-purple-700\">\n\t\t\t\t\t\tAdd new users to the database\n\t\t\t\t\t\t<svg class=\"w-5 h-5 ml-1\" fill=\"currentColor\" viewBox=\"0 0 20 20\"\n\t\t\t\t\t\t\txmlns=\"http://www.w3.org/2000/svg\">\n\t\t\t\t\t\t\t<path fill-rule=\"evenodd\"\n\t\t\t\t\t\t\t\td=\"M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z\"\n\t\t\t\t\t\t\t\tclip-rule=\"evenodd\"></path>\n\t\t\t\t\t\t</svg>\n\t\t\t\t\t</button>\n\t\t\t\t</div>\n                <div>\n\t\t\t\t\t<button (click)=\"updateUser()\" class=\"inline-flex items-center text-base font-medium text-purple-500 hover:text-purple-800 dark:text-purple-500 dark:hover:text-purple-700\">\n\t\t\t\t\t\tEdit details of an Employee\n\t\t\t\t\t\t<svg class=\"w-5 h-5 ml-1\" fill=\"currentColor\" viewBox=\"0 0 20 20\"\n\t\t\t\t\t\t\txmlns=\"http://www.w3.org/2000/svg\">\n\t\t\t\t\t\t\t<path fill-rule=\"evenodd\"\n\t\t\t\t\t\t\t\td=\"M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z\"\n\t\t\t\t\t\t\t\tclip-rule=\"evenodd\"></path>\n\t\t\t\t\t\t</svg>\n\t\t\t\t\t</button>\n\t\t\t\t</div>\n                <div>\n\t\t\t\t\t<button (click)=\"deleteUser()\" class=\"inline-flex items-center text-base font-medium text-purple-500 hover:text-purple-800 dark:text-purple-500 dark:hover:text-purple-700\">\n\t\t\t\t\t\tDelete Employee details\n\t\t\t\t\t\t<svg class=\"w-5 h-5 ml-1\" fill=\"currentColor\" viewBox=\"0 0 20 20\"\n\t\t\t\t\t\t\txmlns=\"http://www.w3.org/2000/svg\">\n\t\t\t\t\t\t\t<path fill-rule=\"evenodd\"\n\t\t\t\t\t\t\t\td=\"M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z\"\n\t\t\t\t\t\t\t\tclip-rule=\"evenodd\"></path>\n\t\t\t\t\t\t</svg>\n\t\t\t\t\t</button>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class=\"col-span-2 space-y-8 md:grid md:grid-cols-2 md:gap-12 md:space-y-0\">\n\t\t\t<div>\n\t\t\t\t<svg class=\"w-10 h-10 mb-2 text-purple-500 md:w-12 md:h-12 dark:text-purple-500\" fill=\"currentColor\"\n\t\t\t\t\tviewBox=\"0 0 20 20\" xmlns=\"http://www.w3.org/2000/svg\">\n\t\t\t\t\t<path fill-rule=\"evenodd\"\n\t\t\t\t\t\td=\"M2 5a2 2 0 012-2h12a2 2 0 012 2v2a2 2 0 01-2 2H4a2 2 0 01-2-2V5zm14 1a1 1 0 11-2 0 1 1 0 012 0zM2 13a2 2 0 012-2h12a2 2 0 012 2v2a2 2 0 01-2 2H4a2 2 0 01-2-2v-2zm14 1a1 1 0 11-2 0 1 1 0 012 0z\"\n\t\t\t\t\t\tclip-rule=\"evenodd\"></path>\n\t\t\t\t</svg>\n\t\t\t\t<h3 class=\"mb-2 text-2xl font-bold dark:text-white\">99.99% uptime</h3>\n\t\t\t\t<p class=\"font-light text-gray-500 dark:text-gray-400\">For Landwind, with zero maintenance downtime</p>\n\t\t\t</div>\n\t\t\t<div>\n\t\t\t\t<svg class=\"w-10 h-10 mb-2 text-purple-500 md:w-12 md:h-12 dark:text-purple-500\" fill=\"currentColor\"\n\t\t\t\t\tviewBox=\"0 0 20 20\" xmlns=\"http://www.w3.org/2000/svg\">\n\t\t\t\t\t<path\n\t\t\t\t\t\td=\"M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z\">\n\t\t\t\t\t</path>\n\t\t\t\t</svg>\n\t\t\t\t<h3 class=\"mb-2 text-2xl font-bold dark:text-white\">600M+ Users</h3>\n\t\t\t\t<p class=\"font-light text-gray-500 dark:text-gray-400\">Trusted by over 600 milion users around the world\n\t\t\t\t</p>\n\t\t\t</div>\n\t\t\t<div>\n\t\t\t\t<svg class=\"w-10 h-10 mb-2 text-purple-500 md:w-12 md:h-12 dark:text-purple-500\" fill=\"currentColor\"\n\t\t\t\t\tviewBox=\"0 0 20 20\" xmlns=\"http://www.w3.org/2000/svg\">\n\t\t\t\t\t<path fill-rule=\"evenodd\"\n\t\t\t\t\t\td=\"M10 18a8 8 0 100-16 8 8 0 000 16zM4.332 8.027a6.012 6.012 0 011.912-2.706C6.512 5.73 6.974 6 7.5 6A1.5 1.5 0 019 7.5V8a2 2 0 004 0 2 2 0 011.523-1.943A5.977 5.977 0 0116 10c0 .34-.028.675-.083 1H15a2 2 0 00-2 2v2.197A5.973 5.973 0 0110 16v-2a2 2 0 00-2-2 2 2 0 01-2-2 2 2 0 00-1.668-1.973z\"\n\t\t\t\t\t\tclip-rule=\"evenodd\"></path>\n\t\t\t\t</svg>\n\t\t\t\t<h3 class=\"mb-2 text-2xl font-bold dark:text-white\">100+ countries</h3>\n\t\t\t\t<p class=\"font-light text-gray-500 dark:text-gray-400\">Have used Landwind to create functional websites\n\t\t\t\t</p>\n\t\t\t</div>\n\t\t\t<div>\n\t\t\t\t<svg class=\"w-10 h-10 mb-2 text-purple-500 md:w-12 md:h-12 dark:text-purple-500\" fill=\"currentColor\"\n\t\t\t\t\tviewBox=\"0 0 20 20\" xmlns=\"http://www.w3.org/2000/svg\">\n\t\t\t\t\t<path\n\t\t\t\t\t\td=\"M3 1a1 1 0 000 2h1.22l.305 1.222a.997.997 0 00.01.042l1.358 5.43-.893.892C3.74 11.846 4.632 14 6.414 14H15a1 1 0 000-2H6.414l1-1H14a1 1 0 00.894-.553l3-6A1 1 0 0017 3H6.28l-.31-1.243A1 1 0 005 1H3zM16 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM6.5 18a1.5 1.5 0 100-3 1.5 1.5 0 000 3z\">\n\t\t\t\t\t</path>\n\t\t\t\t</svg>\n\t\t\t\t<h3 class=\"mb-2 text-2xl font-bold dark:text-white\">5+ Million</h3>\n\t\t\t\t<p class=\"font-light text-gray-500 dark:text-gray-400\">Transactions per day</p>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>"
