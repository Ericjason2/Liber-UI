      "content": "/**\n * Component: Login-Register-Simple\n * Author: @david-chen (https://tailwindflex.com/@david-chen)\n * Source: https://tailwindflex.com/@david-chen/login-register-simple\n * Attribution: Créé par @david-chen sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function LoginRegisterSimple() {\n  return (\n    <div>\n    <div className=\"w-screen min-h-screen flex items-center justify-center bg-gray-50 dark800 px-4 sm6 lg8\">\n        <div className=\"relative py-3 sm sm\">\n            <div className=\"min-h-96 px-8 py-6 mt-4 text-left bg-white dark900  rounded-xl shadow-lg\">\n                <div className=\"flex flex-col justify-center items-center h-full select-none\">\n                    <div className=\"flex flex-col items-center justify-center gap-2 mb-8\">\n                        <a href=\"https://amethgalarcio.web.app/\" target=\"_blank\">\n                            <img src=\"https://amethgalarcio.web.app/assets/logo-42fde28c.svg\" className=\"w-8\" />\n                        </a>\n                        <p className=\"m-0 text-[16px] font-semibold dark\">Login to your Account</p>\n                        <span className=\"m-0 text-xs max-w-[90%] text-center text-[#8B8E98]\">Get started with our app, just start section and enjoy experience.\n                        </span>\n                    </div>\n                    <div className=\"w-full flex flex-col gap-2\">\n                        <label className=\"font-semibold text-xs text-gray-400 \">Username</label>\n                        <input className=\"border rounded-lg px-3 py-2 mb-5 text-sm w-full outline-none dark500 dark900\" placeholder=\"Username\" />\n    \n                    </div>\n                </div>\n                <div className=\"w-full flex flex-col gap-2\">\n                    <label className=\"font-semibold text-xs text-gray-400 \">Password</label>\n                    <input type=\"password\" className=\"border rounded-lg px-3 py-2 mb-5 text-sm w-full outline-none dark500 dark900\" placeholder=\"••••••••\" />\n    \n                </div>\n                <div className=\"flex gap-2\">\n                    <button className=\"py-1 px-8 bg-blue-500 hover800 focus200 text-white w-full transition ease-in duration-200 text-center text-base font-semibold shadow-md focus focus2 focus2 rounded-lg cursor-pointer select-none\">Login</button>\n                    <button className=\"py-1 px-8 bg-blue-500 hover800 focus200 text-white w-full transition ease-in duration-200 text-center text-base font-semibold shadow-md focus focus2 focus2 rounded-lg cursor-pointer select-none\">Register</button>\n                </div>\n            </div>\n        </div>\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
