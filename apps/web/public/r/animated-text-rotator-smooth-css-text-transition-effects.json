      "content": "import * as React from \"react\"\n\nfunction AnimatedTextRotatorSmoothCssTextTransitionEffects({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"animated-text-rotator-smooth-css-text-transition-effects\"\n      className={className}\n      {...props}\n    >\n      <style>{\"@keyframes textRotate {\\n  0%, 5% {\\n    opacity: 0;\\n    transform: translateY(20px);\\n  }\\n  10%, 25% {\\n    opacity: 1;\\n    transform: translateY(0);\\n  }\\n  30%, 100% {\\n    opacity: 0;\\n    transform: translateY(-20px);\\n  }\\n}\\n\\n.text-item {\\n  animation: textRotate 20s infinite linear;\\n  position: absolute;\\n  width: 100%;\\n  text-align: center;\\n  opacity: 0;\\n}\\n\\n.text-item:nth-child(1) { animation-delay: 0s; }\\n.text-item:nth-child(2) { animation-delay: 4s; }\\n.text-item:nth-child(3) { animation-delay: 8s; }\\n.text-item:nth-child(4) { animation-delay: 12s; }\\n.text-item:nth-child(5) { animation-delay: 16s; }\\n\\n.text-rotate-container:hover .text-item {\\n  animation-play-state: paused;\\n}\"}</style>\n      <div className=\"text-rotate-container relative h-32 flex items-center justify-center w-full max-w-4xl\">\n          <div className=\"text-item text-5xl font-bold text-black dark:text-white\">\n            Welcome to Our Platform\n          </div>\n          <div className=\"text-item text-5xl font-bold text-blue-400\">\n            Build Amazing Things\n          </div>\n          <div className=\"text-item text-5xl font-bold text-purple-400\">\n            Transform Your Ideas\n          </div>\n          <div className=\"text-item text-5xl font-bold text-green-400\">\n            Create Without Limits\n          </div>\n          <div className=\"text-item text-5xl font-bold text-orange-400\">\n            Innovate Every Day\n          </div>\n        </div>\n    </div>\n  )\n}\n\nexport { AnimatedTextRotatorSmoothCssTextTransitionEffects }\n",
      "type": "registry:ui"
    }
  ],
