      "content": "/**\n * Component: Apply Coupon Code form\n * Author: @lyra-ravensong (https://tailwindflex.com/@lyra-ravensong)\n * Source: https://tailwindflex.com/@lyra-ravensong/apply-coupon-code-form\n * Attribution: Créé par @lyra-ravensong sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function ApplyCouponCodeForm() {\n  return (\n    <div>\n    <div className=\"containermx-auto max-w-xl p-6\">\n        \n        <div className=\"bg-gray-100  p-6 rounded-lg shadow-lg\">\n    \n            <h1 className=\"text-2xl font-semibold mb-4\">Apply Coupon Code</h1>\n    \n            \n            <div className=\"mb-4\">\n                <label htmlFor=\"coupon\" className=\"block text-gray-700 font-semibold mb-2\">Coupon Code:</label>\n                <input type=\"text\" id=\"coupon\" name=\"coupon\" className=\"w-full px-4 py-2 border border-gray-300 rounded-lg focus focus500 focus500\" placeholder=\"Enter your coupon code\" />\n            </div>\n    \n            \n            <div className=\"text-center\">\n                <button className=\"bg-green-500 text-white px-4 py-2 rounded-lg hover600 focus focus focus500 focus500\">\n                        Apply Coupon\n                    </button>\n            </div>\n    \n            \n            <div className=\"mt-4 text-green-500\">\n                Coupon code applied successfully! You saved $10.\n            </div>\n        </div>\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
  ],
