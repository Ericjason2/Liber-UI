    "rawHtml": "<div class=\"containermx-auto max-w-xl p-6\">\n    <!-- Coupon Code Card Form -->\n    <div class=\"bg-gray-100  p-6 rounded-lg shadow-lg\">\n\n        <h1 class=\"text-2xl font-semibold mb-4\">Apply Coupon Code</h1>\n\n        <!-- Coupon Code Input -->\n        <div class=\"mb-4\">\n            <label for=\"coupon\" class=\"block text-gray-700 font-semibold mb-2\">Coupon Code:</label>\n            <input type=\"text\" id=\"coupon\" name=\"coupon\" class=\"w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring focus:ring-blue-500 focus:border-blue-500\" placeholder=\"Enter your coupon code\">\n        </div>\n\n        <!-- Apply Button -->\n        <div class=\"text-center\">\n            <button class=\"bg-green-500 text-white px-4 py-2 rounded-lg hover:bg-blue-600 focus:outline-none focus:ring focus:ring-blue-500 focus:border-blue-500\">\n                    Apply Coupon\n                </button>\n        </div>\n\n        <!-- Coupon Code Result -->\n        <div class=\"mt-4 text-green-500\">\n            Coupon code applied successfully! You saved $10.\n        </div>\n    </div>\n</div>"
  }
