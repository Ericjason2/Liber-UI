      "content": "/**\n * Component: beautiful tailwind contact form\n * Author: @geoffrey-callaghan (https://tailwindflex.com/@geoffrey-callaghan)\n * Source: https://tailwindflex.com/@geoffrey-callaghan/beautiful-tailwind-contact-form\n * Attribution: Créé par @geoffrey-callaghan sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function BeautifulTailwindContactForm() {\n  return (\n    <div>\n    \n    \n    <div className=\"relative flex items-top justify-center min-h-screen bg-white dark900 sm sm0\">\n        <div className=\"max-w-6xl mx-auto sm6 lg8\">\n            <div className=\"mt-8 overflow-hidden\">\n                <div className=\"grid grid-cols-1 md2\">\n                    <div className=\"p-6 mr-2 bg-gray-100 dark800 sm\">\n                        <h1 className=\"text-4xl sm5xl text-gray-800 dark font-extrabold tracking-tight\">\n                            Get in touch\n                        </h1>\n                        <p className=\"text-normal text-lg sm2xl font-medium text-gray-600 dark400 mt-2\">\n                            Fill in the form to start a conversation\n                        </p>\n    \n                        <div className=\"flex items-center mt-8 text-gray-600 dark400\">\n                            \n                        </div>\n    \n                        <div className=\"flex items-center mt-4 text-gray-600 dark400\">\n                            <svg fill=\"none\" stroke=\"currentColor\" strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"1.5\" viewBox=\"0 0 24 24\" className=\"w-8 h-8 text-gray-500\">\n                                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"1.5\" d=\"M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z\"/>\n                            </svg>\n                            <div className=\"ml-4 text-md tracking-wide font-semibold w-40\">\n                                +44 1234567890\n                            </div>\n                        </div>\n    \n                        <div className=\"flex items-center mt-2 text-gray-600 dark400\">\n                            <svg fill=\"none\" stroke=\"currentColor\" strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"1.5\" viewBox=\"0 0 24 24\" className=\"w-8 h-8 text-gray-500\">\n                                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"1.5\" d=\"M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z\"/>\n                            </svg>\n                            <div className=\"ml-4 text-md tracking-wide font-semibold w-40\">\n                                <a href=\"https://veilmail.io/irish-geoff\">https://veilmail.io/irish-geoff</a>\n                            </div>\n                        </div>\n                    </div>\n    \n                    <form action=\"https://fabform.io/f/xxxxx\" method=\"post\" className=\"p-6 flex flex-col justify-center\">\n                        <div className=\"flex flex-col\">\n                            <label htmlFor=\"name\" className=\"hidden\">Full Name</label>\n                            <input type=\"name\" name=\"name\" id=\"name\" placeholder=\"Full Name\" className=\"w-100 mt-2 py-3 px-3 rounded-lg bg-white dark800 border border-gray-400 dark700 text-gray-800 font-semibold focus500 focus\" />\n                        </div>\n    \n                        <div className=\"flex flex-col mt-2\">\n                            <label htmlFor=\"email\" className=\"hidden\">Email</label>\n                            <input type=\"email\" name=\"email\" id=\"email\" placeholder=\"Email\" className=\"w-100 mt-2 py-3 px-3 rounded-lg bg-white dark800 border border-gray-400 dark700 text-gray-800 font-semibold focus500 focus\" />\n                        </div>\n    \n                        <div className=\"flex flex-col mt-2\">\n                            <label htmlFor=\"message\" className=\"hidden\">Message</label>\n                            <textarea name=\"message\" id=\"message\" placeholder=\"Your Message\" className=\"w-100 mt-2 py-3 px-3 rounded-lg bg-white dark800 border border-gray-400 dark700 text-gray-800 font-semibold focus500 focus\"></textarea>\n                        </div>\n    \n                        <button type=\"submit\" className=\"md32 bg-black hover900 text-white font-bold py-3 px-6 rounded-lg mt-3 hover500 transition ease-in-out duration-300\">\n                            Submit\n                        </button>\n                          <p className=\"leading-relaxed text-xl text-gray-900 mt-8\">\n                    We use VeilMail.io to <a className=\"font-medium text-blue-600 dark500 hover\" href=\"https://veilmail.io\">hide email address from spammers</a>\n                </p>\n                    </form>\n                </div>\n            </div>\n        </div>\n    </div>\n    </div>\n  );\n}\n",
