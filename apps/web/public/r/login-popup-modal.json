      "content": "/**\n * Component: Login popup modal\n * Author: @r-thapa (https://tailwindflex.com/@r-thapa)\n * Source: https://tailwindflex.com/@r-thapa/login-popup-modal\n * Attribution: Créé par @r-thapa sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function LoginPopupModal() {\n  return (\n    <div>\n    <div id=\"login-popup\" tabIndex=\"-1\"\n        className=\"bg-black/50 overflow-y-auto overflow- fixed top-0 right-0 left-0 z-50 h-full items-center justify-center flex\">\n        <div className=\"relative p-4 w-full max-w-md h-full md\">\n    \n            <div className=\"relative bg-white rounded-lg shadow\">\n                <button type=\"button\"\n                    className=\"absolute top-3 right-2.5 text-gray-400 bg-transparent hover200 hover900 rounded-lg text-sm p-1.5 ml-auto inline-flex items-center popup-close\"><svg\n                        aria-hidden=\"true\" className=\"w-5 h-5\" fill=\"#c6c7c7\" viewBox=\"0 0 20 20\"\n                        xmlns=\"http://www.w3.org/2000/svg\">\n                        <path fillRule=\"evenodd\"\n                            d=\"M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z\"\n                            cliprule=\"evenodd\"></path>\n                    </svg>\n                    <span className=\"sr-only\">Close popup</span>\n                </button>\n    \n                <div className=\"p-5\">\n                    <h3 className=\"text-2xl mb-0.5 font-medium\"></h3>\n                    <p className=\"mb-4 text-sm font-normal text-gray-800\"></p>\n    \n                    <div className=\"text-center\">\n                        <p className=\"mb-3 text-2xl font-semibold leading-5 text-slate-900\">\n                            Login to your account\n                        </p>\n                        <p className=\"mt-2 text-sm leading-4 text-slate-600\">\n                            You must be logged in to perform this action.\n                        </p>\n                    </div>\n    \n                    <div className=\"mt-7 flex flex-col gap-2\">\n    \n                        <button\n                            className=\"inline-flex h-10 w-full items-center justify-center gap-2 rounded border border-slate-300 bg-white p-2 text-sm font-medium text-black outline-none focus2 focus[#333] focus1 disabled disabled60\"><img\n                                src=\"https://www.svgrepo.com/show/512317/github-142.svg\" alt=\"GitHub\"\n                                className=\"h-[18px] w-[18px] \" />\n                            Continue with GitHub\n                        </button>\n    \n                        <button\n                            className=\"inline-flex h-10 w-full items-center justify-center gap-2 rounded border border-slate-300 bg-white p-2 text-sm font-medium text-black outline-none focus2 focus[#333] focus1 disabled disabled60\"><img\n                                src=\"https://www.svgrepo.com/show/475656/google-color.svg\" alt=\"Google\"\n                                className=\"h-[18px] w-[18px] \" />Continue with\n                            Google\n                        </button>\n    \n    \n                        <button\n                            className=\"inline-flex h-10 w-full items-center justify-center gap-2 rounded border border-slate-300 bg-white p-2 text-sm font-medium text-black outline-none focus2 focus[#333] focus1 disabled disabled60\"><img\n                                src=\"https://www.svgrepo.com/show/448234/linkedin.svg\" alt=\"Google\"\n                                className=\"h-[18px] w-[18px] \" />Continue with\n                            LinkedIn\n                        </button>\n                    </div>\n    \n                    <div className=\"flex w-full items-center gap-2 py-6 text-sm text-slate-600\">\n                        <div className=\"h-px w-full bg-slate-200\"></div>\n                        OR\n                        <div className=\"h-px w-full bg-slate-200\"></div>\n                    </div>\n    \n    \n                    <form className=\"w-full\">\n                        <label htmlFor=\"email\" className=\"sr-only\">Email address</label>\n                        <input name=\"email\" type=\"email\" autoComplete=\"email\" required=\"\"\n                            className=\"block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm outline-none placeholder400 focus2 focus focus1\"\n                            placeholder=\"Email Address\" value=\"\" />\n                        <label htmlFor=\"password\" className=\"sr-only\">Password</label>\n                        <input name=\"password\" type=\"password\" autoComplete=\"current-password\" required=\"\"\n                            className=\"mt-2 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm outline-none placeholder400 focus2 focus focus1\"\n                            placeholder=\"Password\" value=\"\" />\n                        <p className=\"mb-3 mt-2 text-sm text-gray-500\">\n                            <a href=\"/forgot-password\" className=\"text-blue-800 hover600\">Reset your password?</a>\n                        </p>\n                        <button type=\"submit\"\n                            className=\"inline-flex w-full items-center justify-center rounded-lg bg-black p-2 py-3 text-sm font-medium text-white outline-none focus2 focus focus1 disabled400\">\n                            Continue\n                        </button>\n                    </form>\n    \n                    <div className=\"mt-6 text-center text-sm text-slate-600\">\n                        Don't have an account?\n                        <a href=\"/signup\" className=\"font-medium text-[#4285f4]\">Sign up</a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
  ],
