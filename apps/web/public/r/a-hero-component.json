      "content": "import * as React from \"react\"\n\nfunction AHeroComponent({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"a-hero-component\"\n      className={className}\n      {...props}\n    >\n      <div className=\"bg-gradient-to-b from-purple-50 to-pink-50\">\n          <div className=\"mx-auto max-w-5xl px-6 py-10 text-center md:px-12 md:py-16\">\n              <h1 className=\"text-3xl leading-[52px] font-semibold md:text-4xl lg:text-5xl\">Discover the power of\n                  <span className=\"bg-purple-600 text-white p-0.5 rounded-lg\">creative inspiration</span> online<br />\n                  <div className=\"sm:mt-2\">\n                      <span className=\"underline decoration-purple-600 underline-offset-4\">\n                          Explore a world of design\n                          possibilities\n                      </span>\n                  </div>\n              </h1>\n              <p className=\"mt-4 text-lg font-medium leading-2 text-gray-600 md:text-xl\">Unleash your creativity with access\n                  to a\n                  vast collection of website screenshots, code snippets, and more at UI Shots.</p>\n              <div className=\"mt-8 flex justify-center gap-2\">\n                  <a href=\"/pages\">\n                      <button\n                          className=\"text-md rounded-lg bg-gradient-to-br from-purple-500 to-purple-700 px-4 py-[10px] font-semibold text-white hover:bg-gradient-to-tl hover:from-purple-500 hover:to-purple-700 \">\n                          <div className=\"flex items-center justify-center\">\n                              <div className=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\"\n                                      fill=\"currentColor\" viewBox=\"0 0 256 256\">\n                                      <path\n                                          d=\"M232.49,215.51,185,168a92.12,92.12,0,1,0-17,17l47.53,47.54a12,12,0,0,0,17-17ZM44,112a68,68,0,1,1,68,68A68.07,68.07,0,0,1,44,112Z\">\n                                      </path>\n                                  </svg>\n                              </div>Browse Inspiration | 1000+\n                          </div>\n                      </button>\n                  </a>\n              </div>\n          </div>\n      </div>\n    </div>\n  )\n}\n\nexport { AHeroComponent }\n",
      "type": "registry:ui"
    }
  ],
