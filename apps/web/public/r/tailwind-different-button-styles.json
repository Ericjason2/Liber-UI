      "content": "/**\n * Component: Tailwind Different Button Styles\n * Author: @akash-gandhar (https://tailwindflex.com/@akash-gandhar)\n * Source: https://tailwindflex.com/@akash-gandhar/tailwind-different-button-styles\n * Attribution: Créé par @akash-gandhar sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function TailwindDifferentButtonStyles() {\n  return (\n    <div>\n    <div className=\"p-24 bg-purple-900 flex flex-col justify-center items-center\">\r\n       \r\n       <h2 className=\"pb-10 font-bold text-6xl text-purple-200 text-center\">Buttons with Tailwind CSS</h2>\r\n    </div>\r\n    \r\n    <div className=\"p-24 bg-purple-300 flex flex-col justify-center items-center\">\r\n       <h3 className=\"pb-10 font-bold text-4xl text-purple-700\">Button Tags</h3>\r\n    \r\n       \r\n       <div className=\"flex space-x-2 space-y-2 flex-wrap justify-center items-baseline\">\r\n          <button className=\"rounded-lg px-4 py-2 bg-blue-500 text-blue-100 hover600 duration-300\">Primary</button>\r\n          <button className=\"rounded-lg px-4 py-2 bg-gray-600 text-gray-100 hover700 duration-300\">Secondary</button>\r\n          <button className=\"rounded-lg px-4 py-2 bg-green-700 text-green-100 hover800 duration-300\">Success</button>\r\n          <button className=\"rounded-lg px-4 py-2 bg-red-600 text-red-100 hover700 duration-300\">Danger</button>\r\n          <button className=\"rounded-lg px-4 py-2 bg-yellow-500 hover600 duration-300\">Warning</button>\r\n          <button className=\"rounded-lg px-4 py-2 bg-green-300 hover400 duration-300\">Info</button>\r\n          <button className=\"rounded-lg px-4 py-2 bg-gray-200 hover300 duration-300\">Light</button>\r\n          <button className=\"rounded-lg px-4 py-2 bg-gray-900 text-gray-100\">Dark</button>\r\n          <button className=\"rounded-lg px-4 py-2 underline text-blue-500 hover600 duration-300\">Link</button>\r\n       </div>\r\n    </div>\r\n    \r\n    <div className=\"p-24 bg-purple-50 flex flex-col justify-center items-center\">\r\n       <h3 className=\"pb-10 font-bold text-4xl text-purple-700\">Outline Buttons</h3>\r\n    \r\n       \r\n       <div className=\"flex space-x-2 space-y-2 flex-wrap justify-center items-baseline\">\r\n          <button className=\"rounded-lg px-4 py-2 border-2 border-blue-500 text-blue-500 hover600 hover100 duration-300\">Primary</button>\r\n          <button className=\"rounded-lg px-4 py-2 border-2 border-gray-600 text-gray-600 hover600 hover100 duration-300\">Secondary</button>\r\n          <button className=\"rounded-lg px-4 py-2 border-2 border-green-700 text-green-700 hover700 hover100 duration-300\">Success</button>\r\n          <button className=\"rounded-lg px-4 py-2 border-2 border-red-600 text-red-600 hover600 hover100 duration-300\">Danger</button>\r\n          <button className=\"rounded-lg px-4 py-2 border-2 border-yellow-500 text-yellow-500 hover500 hover100 duration-300\">Warning</button>\r\n          <button className=\"rounded-lg px-4 py-2 border-2 border-green-300 text-green-300 hover300 hover100 duration-300\">Info</button>\r\n          <button className=\"rounded-lg px-4 py-2 border-2 border-gray-200 text-gray-200 hover200 hover900 duration-300\">Light</button>\r\n          <button className=\"rounded-lg px-4 py-2 border-2 border-gray-900 text-gray-900 hover900 hover100 duration-300\">Dark</button>\r\n          <button className=\"rounded-lg px-4 py-2 underline text-blue-500 \">Link</button>\r\n       </div>\r\n    </div>\r\n    \r\n    <div className=\"p-24 bg-purple-200 flex flex-col justify-center items-center\">\r\n       <h3 className=\"pb-10 font-bold text-4xl text-purple-700\">Button Sizes</h3>\r\n    \r\n       \r\n       <div className=\"flex flex-wrap justify-center items-baseline\">\r\n    \r\n          \r\n          <div className=\"px-5\">\r\n             <h3 className=\"font-bold pb-2 text-center\">Large Button</h3>\r\n             <button className=\"rounded-lg px-8 py-2 text-xl bg-blue-500 text-blue-100 hover600 duration-300\">Large</button>\r\n             <button className=\"rounded-lg px-8 py-2 text-xl border-2 border-blue-500 text-blue-500 hover500 hover100 duration-300\">Large</button>\r\n          </div>\r\n    \r\n          \r\n          <div className=\"px-5\">\r\n             <h3 className=\"font-bold pt-4 pb-2 text-center\">Small Button</h3>\r\n             <button className=\"rounded px-4 py-2 text-xs bg-blue-500 text-blue-100 hover600 duration-300\">Small</button>\r\n             <button className=\"rounded px-4 py-2 text-xs border-2 border-blue-500 text-blue-500 hover500 hover100 duration-300\">Small</button>\r\n          </div>\r\n    \r\n       </div>\r\n    </div>\r\n    \r\n    <div className=\"p-24 bg-purple-700 flex flex-col justify-center items-center\">\r\n       <h3 className=\"pb-10 font-bold text-4xl text-purple-100\">Block Buttons with Grids</h3>\r\n    \r\n       \r\n       <div className=\"w-full grid grid-col-12 gap-y-5 gap-x-2\">\r\n    \r\n          \r\n          <p className=\"col-span-12 font-bold text-purple-300\">Full width</p>\r\n          <button className=\"col-span-12 rounded-lg px-4 py-2 bg-green-700 text-green-100 hover800 duration-300\">Submit</button>\r\n    \r\n          \r\n          <p className=\"col-span-12 font-bold text-purple-300\">Half width</p>\r\n          <button className=\"col-span-6 rounded-lg px-4 py-2 bg-green-700 text-green-100 hover800 duration-300\">Submit</button>\r\n    \r\n          \r\n          <p className=\"col-span-12 font-bold text-purple-300\">Grid (Left Aligned)</p>\r\n          <button className=\"col-span-2 rounded-lg px-4 py-2 bg-green-700 text-green-100 hover800 duration-300\">Submit</button>\r\n          <button className=\"col-span-2 rounded-lg px-4 py-2 bg-green-700 text-green-100 hover800 duration-300\">Submit</button>\r\n    \r\n          \r\n          <p className=\"col-span-12 font-bold text-purple-300\">Grid (Right Aligned)</p>\r\n          <button className=\"col-start-9 col-end-11 rounded-lg px-4 py-2 bg-green-700 text-green-100 hover800 duration-300\">Submit</button>\r\n          <button className=\"col-start-11 col-end-13 rounded-lg px-4 py-2 bg-green-700 text-green-100 hover800 duration-300\">Submit</button>\r\n       </div>\r\n    </div>\r\n    \r\n    <div className=\"p-24 bg-purple-400 flex flex-col justify-center items-center\">\r\n       <h3 className=\"pb-10 font-bold text-4xl text-purple-700\">Disabled State</h3>\r\n    \r\n       \r\n       <div className=\"flex space-x-2 space-y-2 flex-wrap justify-center items-baseline\">\r\n          <button className=\"rounded-lg px-4 py-2 bg-green-700 text-green-100 hover800 duration-300\">Submit</button>\r\n          <button className=\"rounded-lg px-4 py-2 bg-green-700 text-green-100 opacity-50 cursor-not-allowed didsabled disabled50\" disabled>Submit</button>\r\n       </div>\r\n    \r\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
