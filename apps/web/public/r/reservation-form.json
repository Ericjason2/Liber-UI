      "content": "/**\n * Component: Reservation form\n * Author: @lukas-muller (https://tailwindflex.com/@lukas-muller)\n * Source: https://tailwindflex.com/@lukas-muller/reservation-form\n * Attribution: Créé par @lukas-muller sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function ReservationForm() {\n  return (\n    <div>\n    <div className=\"flex items-center justify-center p-12\">\n        \n        <div className=\"mx-auto w-full max-w-[550px] bg-white\">\n            <form>\n                <div className=\"-mx-3 flex flex-wrap\">\n                    <div className=\"w-full px-3 sm1/2\">\n                        <div className=\"mb-5\">\n                            <label htmlFor=\"fName\" className=\"mb-3 block text-base font-medium text-[#07074D]\">\n                                First Name\n                            </label>\n                            <input type=\"text\" name=\"fName\" id=\"fName\" placeholder=\"First Name\"\n                                className=\"w-full rounded-md border border-[#e0e0e0] bg-white py-3 px-6 text-base font-medium text-[#6B7280] outline-none focus[#6A64F1] focus\" />\n                        </div>\n                    </div>\n                    <div className=\"w-full px-3 sm1/2\">\n                        <div className=\"mb-5\">\n                            <label htmlFor=\"lName\" className=\"mb-3 block text-base font-medium text-[#07074D]\">\n                                Last Name\n                            </label>\n                            <input type=\"text\" name=\"lName\" id=\"lName\" placeholder=\"Last Name\"\n                                className=\"w-full rounded-md border border-[#e0e0e0] bg-white py-3 px-6 text-base font-medium text-[#6B7280] outline-none focus[#6A64F1] focus\" />\n                        </div>\n                    </div>\n                </div>\n                <div className=\"mb-5\">\n                    <label htmlFor=\"guest\" className=\"mb-3 block text-base font-medium text-[#07074D]\">\n                        How many guest are you bringing?\n                    </label>\n                    <input type=\"number\" name=\"guest\" id=\"guest\" placeholder=\"5\" min=\"0\"\n                        className=\"w-full appearance-none rounded-md border border-[#e0e0e0] bg-white py-3 px-6 text-base font-medium text-[#6B7280] outline-none focus[#6A64F1] focus\" />\n                </div>\n    \n                <div className=\"-mx-3 flex flex-wrap\">\n                    <div className=\"w-full px-3 sm1/2\">\n                        <div className=\"mb-5\">\n                            <label htmlFor=\"date\" className=\"mb-3 block text-base font-medium text-[#07074D]\">\n                                Date\n                            </label>\n                            <input type=\"date\" name=\"date\" id=\"date\"\n                                className=\"w-full rounded-md border border-[#e0e0e0] bg-white py-3 px-6 text-base font-medium text-[#6B7280] outline-none focus[#6A64F1] focus\" />\n                        </div>\n                    </div>\n                    <div className=\"w-full px-3 sm1/2\">\n                        <div className=\"mb-5\">\n                            <label htmlFor=\"time\" className=\"mb-3 block text-base font-medium text-[#07074D]\">\n                                Time\n                            </label>\n                            <input type=\"time\" name=\"time\" id=\"time\"\n                                className=\"w-full rounded-md border border-[#e0e0e0] bg-white py-3 px-6 text-base font-medium text-[#6B7280] outline-none focus[#6A64F1] focus\" />\n                        </div>\n                    </div>\n                </div>\n    \n                <div className=\"mb-5\">\n                    <label className=\"mb-3 block text-base font-medium text-[#07074D]\">\n                        Are you coming to the event?\n                    </label>\n                    <div className=\"flex items-center space-x-6\">\n                        <div className=\"flex items-center\">\n                            <input type=\"radio\" name=\"radio1\" id=\"radioButton1\" className=\"h-5 w-5\" />\n                            <label htmlFor=\"radioButton1\" className=\"pl-3 text-base font-medium text-[#07074D]\">\n                                Yes\n                            </label>\n                        </div>\n                        <div className=\"flex items-center\">\n                            <input type=\"radio\" name=\"radio1\" id=\"radioButton2\" className=\"h-5 w-5\" />\n                            <label htmlFor=\"radioButton2\" className=\"pl-3 text-base font-medium text-[#07074D]\">\n                                No\n                            </label>\n                        </div>\n                    </div>\n                </div>\n    \n                <div>\n                    <button\n                        className=\"hover rounded-md bg-[#6A64F1] py-3 px-8 text-center text-base font-semibold text-white outline-none\">\n                        Submit\n                    </button>\n                </div>\n            </form>\n        </div>\n    </div>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
