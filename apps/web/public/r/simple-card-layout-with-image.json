      "content": "/**\n * Component: Simple card layout with image\n * Author: @leon-bachmann (https://tailwindflex.com/@leon-bachmann)\n * Source: https://tailwindflex.com/@leon-bachmann/simple-card-layout-with-image\n * Attribution: Créé par @leon-bachmann sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function SimpleCardLayoutWithImage() {\n  return (\n    <div>\n    <div className=\"rounded-xl overflow-hidden flex shadow hover max-w-sm bg-white cursor-pointer h-28\">\r\n        <div className=\"w-7/12 pl-3 p-3 text-text1 flex flex-col justify-center\">\r\n            <p className=\"text-base mb-2 font-bold truncate\">Utilities for setting the width of an element</p>\r\n            <div className=\"text-xs text-primary mb-2\">\r\n                <a className=\"flex items-center\">\r\n                    <img src=\"https://images.unsplash.com/photo-1477118476589-bff2c5c4cfbb?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=crop&w=200&q=200\" className=\"rounded-full h-8 w-8 mr-2 object-cover\" />\r\n                    <span className=\"font-bold tracking-wide text-sm text-pink-400\">Jane Doe</span>\r\n                </a>\r\n            </div>\r\n            <div className=\"text-sm text-text2 tracking-wider\">Jan 6 | 4 min read</div>\r\n        </div>\r\n        <div className=\"lg flex w-5/12 p-2\">\r\n            <img src=\"https://source.unsplash.com/1600x900/?nature,water\" className=\"rounded-xl object-cover w-full h-full\"/>\r\n        </div>\r\n    </div>\n    </div>\n  );\n}\n",
