opacity-60 group-hover:scale-110 transition-transform duration-1000 project-img\\\">\\n        <div class=\\\"relative z-10 text-center transition-transform group-hover:-translate-y-4 duration-500\\\">\\n          <h4 class=\\\"font-serif text-3xl italic\\\">Nuances Terrestres</h4>\\n          <p class=\\\"text-[10px] uppercase tracking-widest mt-2 opacity-0 group-hover:opacity-100 transition-opacity\\\">\\n            Accessoires</p>\\n        </div>\\n      </div>\\n    </div>\\n  </section>\\n\\n  <!-- Footer / Contact -->\\n  <footer id=\\\"contact\\\" class=\\\"py-32 px-8\\\">\\n    <div class=\\\"max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-start\\\">\\n      <div class=\\\"mb-20 md:mb-0\\\">\\n        <h5 class=\\\"text-xs uppercase tracking-[0.3em] mb-10 opacity-50\\\">Prêt à collaborer ?</h5>\\n        <a href=\\\"mailto:hello@studio.com\\\" class=\\\"font-serif text-4xl md:text-7xl italic hover:opacity-50 transition\\\">\\n          contact@studio.com\\n        </a>\\n      </div>\\n\\n      <div class=\\\"grid grid-cols-2 gap-16 uppercase text-[10px] tracking-[0.2em]\\\">\\n        <div class=\\\"space-y-4\\\">\\n          <p class=\\\"opacity-50 mb-6\\\">Réseaux</p>\\n          <a href=\\\"#\\\" class=\\\"block hover:underline\\\">Instagram</a>\\n          <a href=\\\"#\\\" class=\\\"block hover:underline\\\">Behance</a>\\n          <a href=\\\"#\\\" class=\\\"block hover:underline\\\">LinkedIn</a>\\n        </div>\\n        <div class=\\\"space-y-4\\\">\\n          <p class=\\\"opacity-50 mb-6\\\">Localisation</p>\\n          <p>Paris, FR</p>\\n          <p>Marseille, FR</p>\\n        </div>\\n      </div>\\n    </div>\\n\\n    <div\\n      class=\\\"mt-32 pt-8 border-t border-black/10 flex justify-between items-center text-[10px] uppercase tracking-widest opacity-40\\\">\\n      <p>© 2025 Studio Mode — Tous droits réservés.</p>\\n      <p>Conçu avec Passion</p>\\n    </div>\\n  </footer>\\n\\n  \\n</body>\\n\\n</html>\" }} />\n  );