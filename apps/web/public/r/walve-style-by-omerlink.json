    "rawHtml": "<!DOCTYPE html>\n<html lang=\"fr\" class=\"scroll-smooth\">\n\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Portfolio | Mode & Design</title>\n  <!-- Tailwind CSS -->\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <!-- Google Fonts: Playfair Display & Inter -->\n  <link\n    href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;600&display=swap\"\n    rel=\"stylesheet\">\n  <!-- Alpine.js -->\n  <script src=\"https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js\"></script>\n  <!-- GSAP & ScrollTrigger -->\n  <script src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js\"></script>\n  <script src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js\"></script>\n\n  <style>\n    body {\n      font-family: 'Inter', sans-serif;\n      background-color: #fdfdfd;\n      color: #1a1a1a;\n      overflow-x: hidden;\n    }\n\n    .font-serif {\n      font-family: 'Playfair Display', serif;\n    }\n\n    /* Custom Cursor */\n    .custom-cursor {\n      width: 20px;\n      height: 20px;\n      border: 1px solid #1a1a1a;\n      border-radius: 50%;\n      position: fixed;\n      pointer-events: none;\n      z-index: 9999;\n      transition: transform 0.1s ease;\n    }\n\n    .parallax-bg {\n      will-change: transform;\n    }\n\n    /* Smooth reveal for text */\n    .reveal-text {\n      clip-path: polygon(0 0, 100% 0, 100% 100%, 0% 100%);\n    }\n  </style>\n</head>\n\n<body x-data=\"{ mobileMenu: false }\">\n\n  <!-- Custom Cursor -->\n  <div id=\"cursor\" class=\"custom-cursor hidden md:block\"></div>\n\n  <!-- Navigation -->\n  <nav class=\"fixed top-0 w-full z-50 mix-blend-difference px-8 py-6 flex justify-between items-center text-white\">\n    <div class=\"text-2xl font-serif tracking-tighter\">WALVE</div>\n\n    <!-- Desktop Menu -->\n    <div class=\"hidden md:flex space-x-12 uppercase text-xs tracking-[0.2em]\">\n      <a href=\"#work\" class=\"hover:opacity-50 transition\">Collections</a>\n      <a href=\"#about\" class=\"hover:opacity-50 transition\">L'Atelier</a>\n      <a href=\"#contact\" class=\"hover:opacity-50 transition\">Contact</a>\n    </div>\n\n    <!-- Burger Menu -->\n    <button @click=\"mobileMenu = !mobileMenu\" class=\"md:hidden space-y-1.5\">\n            <span class=\"block w-6 h-0.5 bg-current\"></span>\n            <span class=\"block w-4 h-0.5 bg-current ml-auto\"></span>\n        </button>\n  </nav>\n\n  <!-- Mobile Menu Overlay -->\n  <div x-show=\"mobileMenu\" x-transition:enter=\"transition ease-out duration-300\"\n    x-transition:enter-start=\"opacity-0 translate-y-full\" x-transition:enter-end=\"opacity-100 translate-y-0\"\n    class=\"fixed inset-0 bg-white z-[60] flex flex-col items-center justify-center space-y-8 text-3xl font-serif\">\n    <button @click=\"mobileMenu = false\" class=\"absolute top-8 right-8 text-xl\">✕</button>\n    <a href=\"#work\" @click=\"mobileMenu = false\">Collections</a>\n    <a href=\"#about\" @click=\"mobileMenu = false\">L'Atelier</a>\n    <a href=\"#contact\" @click=\"mobileMenu = false\">Contact</a>\n  </div>\n\n  <!-- Hero Section -->\n  <section class=\"relative h-screen flex flex-col justify-center items-center overflow-hidden bg-[#ebebeb]\">\n    <div class=\"parallax-bg absolute inset-0 opacity-40 scale-110\" id=\"hero-img-bg\">\n      <img src=\"https://images.unsplash.com/photo-1490481651871-ab68de25d43d?q=80&w=2070&auto=format&fit=crop\"\n                 alt=\"Background Fashion\" class=\"w-full h-full object-cover\">\n    </div>\n\n    <div class=\"relative z-10 text-center px-4\">\n      <p class=\"uppercase tracking-[0.4em] text-[10px] mb-6 opacity-60 reveal-text\" id=\"hero-sub\">Esthétique\n        Contemporaine</p>\n      <h1 class=\"font-serif text-6xl md:text-9xl italic leading-tight reveal-text\" id=\"hero-title\">\n        Saison<br>Éternelle\n      </h1>\n    </div>\n\n    <div class=\"absolute bottom-12 left-1/2 -translate-x-1/2 flex flex-col items-center opacity-40\">\n      <span class=\"text-[10px] uppercase tracking-widest mb-4\">Scroll</span>\n      <div class=\"w-px h-12 bg-black overflow-hidden\">\n        <div class=\"w-full h-full bg-black/20 origin-top\" id=\"scroll-line\"></div>\n      </div>\n    </div>\n  </section>\n\n  <!-- About Section -->\n  <section id=\"about\" class=\"py-32 px-8 max-w-7xl mx-auto\">\n    <div class=\"grid md:grid-cols-2 gap-20 items-center\">\n      <div class=\"relative\" id=\"about-image-container\">\n        <div class=\"aspect-[3/4] overflow-hidden\">\n          <img src=\"https://images.unsplash.com/photo-1608748010899-18f300247112?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w0NzEyNjZ8MHwxfHNlYXJjaHwxfHxzdHlsZXxlbnwwfDF8fHwxNzY5MTU3NzAwfDA&ixlib=rb-4.1.0&q=80&w=1080\"\n                         alt=\"Creative Director\" class=\"w-full h-full object-cover grayscale parallax-img\">\n        </div>\n        <div class=\"absolute -bottom-10 -right-10 bg-[#1a1a1a] text-white p-10 hidden md:block\">\n          <p class=\"text-sm font-light leading-relaxed\">\n            Inspiré par la structure architecturale et la fluidité organique.\n          </p>\n        </div>\n      </div>\n\n      <div class=\"space-y-8\" id=\"about-content\">\n        <h2 class=\"font-serif text-4xl md:text-5xl\">Une vision puriste de la mode.</h2>\n        <p class=\"text-gray-500 leading-relaxed max-w-md\">\n          Chaque pièce est une exploration de la forme et de la matière. Mon travail se concentre sur l'essentiel : la\n          coupe, le tombé, et l'émotion visuelle que dégage un vêtement dans son environnement.\n        </p>\n        <div class=\"pt-6\">\n          <a href=\"#\"\n            class=\"inline-block border-b border-black pb-2 text-xs uppercase tracking-widest hover:translate-x-2 transition-transform duration-300\">\n            En savoir plus\n          </a>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Projects Grid (Parallax Items) -->\n  <section id=\"work\" class=\"bg-black text-white py-32 overflow-hidden\">\n    <div class=\"px-8 mb-20\">\n      <h3 class=\"font-serif text-5xl md:text-7xl mb-4 italic\">Portfolio</h3>\n      <p class=\"uppercase text-[10px] tracking-widest opacity-40\">Sélections 2024 — 2025</p>\n    </div>\n\n    <div class=\"grid md:grid-cols-2 gap-px bg-white/10\">\n      <!-- Project 1 -->\n      <div\n        class=\"group relative overflow-hidden bg-black aspect-square md:aspect-video flex items-center justify-center\">\n        <img  src=\"https://images.unsplash.com/photo-1538329972958-465d6d2144ed?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w0NzEyNjZ8MHwxfHNlYXJjaHw1fHxzdHlsZXxlbnwwfDB8fHwxNzY5MTU3ODU1fDA&ixlib=rb-4.1.0&q=80&w=1080\" class=\"absolute inset-0 w-full h-full object-cover opacity-60 group-hover:scale-110 transition-transform duration-1000 project-img\">\n        <div class=\"relative z-10 text-center transition-transform group-hover:-translate-y-4 duration-500\">\n          <h4 class=\"font-serif text-3xl italic\">Minimal Silk</h4>\n          <p class=\"text-[10px] uppercase tracking-widest mt-2 opacity-0 group-hover:opacity-100 transition-opacity\">\n            Éditorial</p>\n        </div>\n      </div>\n\n      <!-- Project 2 -->\n      <div\n        class=\"group relative overflow-hidden bg-black aspect-square md:aspect-video flex items-center justify-center\">\n        <img src=\"https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?q=80&w=1920&auto=format&fit=crop\"\n                     class=\"absolute inset-0 w-full h-full object-cover opacity-60 group-hover:scale-110 transition-transform duration-1000 project-img\">\n        <div class=\"relative z-10 text-center transition-transform group-hover:-translate-y-4 duration-500\">\n          <h4 class=\"font-serif text-3xl italic\">Structure Urbaine</h4>\n          <p class=\"text-[10px] uppercase tracking-widest mt-2 opacity-0 group-hover:opacity-100 transition-opacity\">\n            Campagne</p>\n        </div>\n      </div>\n\n      <!-- Project 3 -->\n      <div\n        class=\"group relative overflow-hidden bg-black aspect-square md:aspect-video flex items-center justify-center\">\n        <img src=\"https://images.unsplash.com/photo-1469334031218-e382a71b716b?q=80&w=2070&auto=format&fit=crop\"\n                     class=\"absolute inset-0 w-full h-full object-cover opacity-60 group-hover:scale-110 transition-transform duration-1000 project-img\">\n        <div class=\"relative z-10 text-center transition-transform group-hover:-translate-y-4 duration-500\">\n          <h4 class=\"font-serif text-3xl italic\">Contrastes Obscurs</h4>\n          <p class=\"text-[10px] uppercase tracking-widest mt-2 opacity-0 group-hover:opacity-100 transition-opacity\">\n            Haute Couture</p>\n        </div>\n      </div>\n\n      <!-- Project 4 -->\n      <div\n        class=\"group relative overflow-hidden bg-black aspect-square md:aspect-video flex items-center justify-center\">\n        <img src=\"https://images.unsplash.com/photo-1496217590455-aa63a8350eea?q=80&w=1974&auto=format&fit=crop\"\n                     class=\"absolute inset-0 w-full h-full object-cover opacity-60 group-hover:scale-110 transition-transform duration-1000 project-img\">\n        <div class=\"relative z-10 text-center transition-transform group-hover:-translate-y-4 duration-500\">\n          <h4 class=\"font-serif text-3xl italic\">Nuances Terrestres</h4>\n          <p class=\"text-[10px] uppercase tracking-widest mt-2 opacity-0 group-hover:opacity-100 transition-opacity\">\n            Accessoires</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Footer / Contact -->\n  <footer id=\"contact\" class=\"py-32 px-8\">\n    <div class=\"max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-start\">\n      <div class=\"mb-20 md:mb-0\">\n        <h5 class=\"text-xs uppercase tracking-[0.3em] mb-10 opacity-50\">Prêt à collaborer ?</h5>\n        <a href=\"mailto:hello@studio.com\" class=\"font-serif text-4xl md:text-7xl italic hover:opacity-50 transition\">\n          contact@studio.com\n        </a>\n      </div>\n\n      <div class=\"grid grid-cols-2 gap-16 uppercase text-[10px] tracking-[0.2em]\">\n        <div class=\"space-y-4\">\n          <p class=\"opacity-50 mb-6\">Réseaux</p>\n          <a href=\"#\" class=\"block hover:underline\">Instagram</a>\n          <a href=\"#\" class=\"block hover:underline\">Behance</a>\n          <a href=\"#\" class=\"block hover:underline\">LinkedIn</a>\n        </div>\n        <div class=\"space-y-4\">\n          <p class=\"opacity-50 mb-6\">Localisation</p>\n          <p>Paris, FR</p>\n          <p>Marseille, FR</p>\n        </div>\n      </div>\n    </div>\n\n    <div\n      class=\"mt-32 pt-8 border-t border-black/10 flex justify-between items-center text-[10px] uppercase tracking-widest opacity-40\">\n      <p>© 2025 Studio Mode — Tous droits réservés.</p>\n      <p>Conçu avec Passion</p>\n    </div>\n  </footer>\n\n  <script>\n    // GSAP Implementation\n        gsap.registerPlugin(ScrollTrigger);\n\n        window.onload = () => {\n            // Custom Cursor Logic\n            const cursor = document.getElementById('cursor');\n            document.addEventListener('mousemove', (e) => {\n                gsap.to(cursor, {\n                    x: e.clientX,\n                    y: e.clientY,\n                    duration: 0.1,\n                    ease: \"power2.out\"\n                });\n            });\n\n            // Hero Animations\n            const tl = gsap.timeline();\n            tl.from(\"#hero-img-bg\", {\n                scale: 1.3,\n                duration: 2,\n                ease: \"power3.out\"\n            })\n            .from(\"#hero-title\", {\n                y: 100,\n                opacity: 0,\n                duration: 1.2,\n                ease: \"power4.out\"\n            }, \"-=1.5\")\n            .from(\"#hero-sub\", {\n                y: 20,\n                opacity: 0,\n                duration: 1,\n            }, \"-=1\");\n\n            // Hero Parallax on Scroll\n            gsap.to(\"#hero-img-bg\", {\n                y: \"30%\",\n                scrollTrigger: {\n                    trigger: \"section\",\n                    start: \"top top\",\n                    end: \"bottom top\",\n                    scrub: true\n                }\n            });\n\n            // Scroll Line Animation\n            gsap.to(\"#scroll-line\", {\n                scaleY: 0,\n                transformOrigin: \"bottom\",\n                scrollTrigger: {\n                    trigger: \"section\",\n                    start: \"top top\",\n                    end: \"50% top\",\n                    scrub: true\n                }\n            });\n\n            // About Reveal\n            gsap.from(\"#about-image-container\", {\n                x: -50,\n                opacity: 0,\n                scrollTrigger: {\n                    trigger: \"#about\",\n                    start: \"top 80%\",\n                    end: \"top 50%\",\n                    scrub: 1\n                }\n            });\n\n            gsap.from(\"#about-content\", {\n                x: 50,\n                opacity: 0,\n                scrollTrigger: {\n                    trigger: \"#about\",\n                    start: \"top 80%\",\n                    end: \"top 50%\",\n                    scrub: 1\n                }\n            });\n\n            // Project Items Parallax\n            document.querySelectorAll('.project-img').forEach(img => {\n                gsap.to(img, {\n                    y: -40,\n                    scrollTrigger: {\n                        trigger: img.parentElement,\n                        start: \"top bottom\",\n                        end: \"bottom top\",\n                        scrub: true\n                    }\n                });\n            });\n\n            // Global smooth reveals for sections\n            document.querySelectorAll('h2, h3').forEach(heading => {\n                gsap.from(heading, {\n                    y: 40,\n                    opacity: 0,\n                    duration: 1,\n                    scrollTrigger: {\n                        trigger: heading,\n                        start: \"top 90%\",\n                    }\n                });\n            });\n        };\n  </script>\n</body>\n\n</html>"
  }
