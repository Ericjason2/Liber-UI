      "content": "/**\n * Component: authentication form terminal\n * Author: @ardianhu (https://tailwindflex.com/@ardianhu)\n * Source: https://tailwindflex.com/@ardianhu/authentication-form-terminal-2\n * Attribution: Créé par @ardianhu sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function AuthenticationFormTerminal2() {\n  return (\n    <div>\n    <div className=\"terminal p-5 rounded-lg font-mono\">\n        <div className=\"terminal-header bg-zinc-700 text-white p-2 rounded-t-lg flex items-center\">\n            <span className=\"text-red-500 text-5xl leading-[0px] align-middle -mt-2\">•</span>\n            <span className=\"text-yellow-500 text-5xl leading-[0px] align-middle -mt-2 ml-1\">&bull;</span>\n            <span className=\"text-green-500 text-5xl leading-[0px] align-middle -mt-2 ml-1\">&bull;</span>\n            <span className=\"ml-4 align-baseline\">authentication --- bash - zsh </span>\n        </div>\n        <div id=\"output\" className=\"pl-4 pt-2 bg-gray-900 max-h-[500px] overflow-auto\">\n            <p className=\"text-gray-500\">You need to authenticate to continue!</p>\n            <p className=\"text-sky-300\">Enter 1 to login</p>\n            <p className=\"text-sky-300\">Enter 2 to register</p>\n        </div>\n        <div id=\"terminal-input-container\" className=\"input flex pl-4 bg-gray-900 pb-4 rounded-b-lg items-center\">\n            <span className=\"text-green-500\">➝</span>\n            <span className=\"text-sky-300 ml-2\">~</span>\n            <span id=\"placeholder\" className=\"ml-2 text-md text-gray-500\"></span>\n            <input type=\"text\" id=\"terminal-input\" className=\"bg-transparent border-none outline-none ring-0 focus0 text-amber-400 w-full\" />\n        </div>\n    </div>\n    \n    \n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
