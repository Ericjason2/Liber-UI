      "content": "import * as React from \"react\"\n\nfunction MinimalLoginFoom({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"minimal-login-foom\"\n      className={className}\n      {...props}\n    >\n      <main className=\"container mx-auto p-4 mt-12 bg-white flex flex-col items-center justify-center text-gray-700\">\n          <div className=\"w-10/12 sm:w-8/12 md:w-6/12 lg:w-5/12 xl:w-4/12 mb-4\">\n              <h1 className=\"text-4xl font-semibold\">Welcome back.</h1>\n          </div>\n          <div className=\"w-10/12 sm:w-8/12 md:w-6/12 lg:w-5/12 xl:w-4/12 mb-6\">\n              <input className=\"mb-4 p-2 appearance-none block w-full bg-gray-200 placeholder-gray-900 rounded border focus:border-teal-500\" type=\"text\" placeholder=\"Email\"/>\n              <input className=\"mb-4 p-2 appearance-none block w-full bg-gray-200 placeholder-gray-900 rounded border focus:border-teal-500\" type=\"text\" placeholder=\"Password\"/>\n              <div className=\"flex items-center\">\n                  <div className=\"w-1/2 flex items-center\">\n                      <input id=\"remember-me\" type=\"checkbox\" className=\"mt-1 mr-2\" />\n                      <label htmlFor=\"remember-me\">Remember me!</label>\n                  </div>\n                  <button className=\"ml-auto w-1/2 bg-gray-800 text-white p-2 rounded font-semibold hover:bg-gray-900\" type=\"submit\">Log In</button>\n              </div>\n          </div>\n      </main>\n    </div>\n  )\n}\n\nexport { MinimalLoginFoom }\n",
      "type": "registry:ui"
    }
  ],
  "meta": {
    "kind": "component",
