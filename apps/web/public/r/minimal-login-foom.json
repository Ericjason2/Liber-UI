      "content": "/**\n * Component: Login form\n * Author: @gopi (https://tailwindflex.com/@gopi)\n * Source: https://tailwindflex.com/@gopi/minimal-login-foom\n * Attribution: Créé par @gopi sur TailwindFlex\n * License: Open Source (TailwindFlex community)\n */\nimport React from \"react\";\n\nexport function MinimalLoginFoom() {\n  return (\n    <div>\n    <main className=\"container mx-auto p-4 mt-12 bg-white flex flex-col items-center justify-center text-gray-700\">\n        <div className=\"w-10/12 sm8/12 md6/12 lg5/12 xl4/12 mb-4\">\n            <h1 className=\"text-4xl font-semibold\">Welcome back.</h1>\n        </div>\n        <div className=\"w-10/12 sm8/12 md6/12 lg5/12 xl4/12 mb-6\">\n            <input className=\"mb-4 p-2 appearance-none block w-full bg-gray-200 placeholder-gray-900 rounded border focus500\" type=\"text\" placeholder=\"Email\"/>\n            <input className=\"mb-4 p-2 appearance-none block w-full bg-gray-200 placeholder-gray-900 rounded border focus500\" type=\"text\" placeholder=\"Password\"/>\n            <div className=\"flex items-center\">\n                <div className=\"w-1/2 flex items-center\">\n                    <input id=\"remember-me\" type=\"checkbox\" className=\"mt-1 mr-2\" />\n                    <label htmlFor=\"remember-me\">Remember me!</label>\n                </div>\n                <button className=\"ml-auto w-1/2 bg-gray-800 text-white p-2 rounded font-semibold hover900\" type=\"submit\">Log In</button>\n            </div>\n        </div>\n    </main>\n    </div>\n  );\n}\n",
      "type": "registry:ui"
    }
