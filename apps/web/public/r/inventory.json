    "rawHtml": "<!-- Hero -->\n<div class=\"bg-white dark:bg-gray-900 relative z-20 overflow-hidden\">\n  <div class=\"container mx-auto px-6 py-16\n              lg:grid lg:grid-cols-12 lg:items-center lg:gap-16\n              flex flex-col-reverse\">\n\n    <!-- Text -->\n    <div class=\"lg:col-span-5 sm:w-full max-w-2xl\">\n      <span class=\"w-20 h-2 bg-gray-900 dark:bg-white mb-8 block\"></span>\n\n      <h1 class=\"font-bebas-neue uppercase\n                 text-5xl sm:text-7xl xl:text-7xl\n                 font-black leading-[0.95] tracking-tight\n                 text-gray-900 dark:text-white\">\n        Inventory\n        <span class=\"block text-4xl sm:text-6xl text-emerald-600\">\n          Management\n        </span>\n      </h1>\n\n      <p class=\"mt-4 text-sm sm:text-base text-gray-700 dark:text-gray-300\">\n        Track stock in real-time, automate reorders, and see your true margins at a glance.\n        No spreadsheets. No chaos. Just <span class=\"font-semibold\">control</span>.\n      </p>\n\n      <div class=\"flex mt-8\">\n        <a href=\"#\" class=\"uppercase py-2 px-5 rounded-lg bg-emerald-600 border-2 border-transparent text-white text-md mr-4 hover:bg-emerald-500 transition\">\n          Open Dashboard\n        </a>\n        <a href=\"#\" class=\"uppercase py-2 px-5 rounded-lg bg-transparent border-2 border-emerald-600 text-emerald-600 dark:text-white hover:bg-emerald-600 hover:text-white text-md transition\">\n          Live Demo\n        </a>\n      </div>\n\n      <div class=\"mt-6 flex flex-wrap gap-3 text-xs\">\n        <span class=\"px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-200\">Low-stock alerts</span>\n        <span class=\"px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-200\">Barcode ready</span>\n        <span class=\"px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-200\">CSV import/export</span>\n      </div>\n    </div>\n\n    <!-- Visual -->\n    <div class=\"lg:col-span-7 w-full\">\n      <div class=\"max-w-lg md:max-w-2xl ml-auto\n                  rounded-3xl border border-gray-200 dark:border-white/10\n                  bg-white dark:bg-gray-800 shadow-xl p-5 animate-float\">\n        <div class=\"flex items-center justify-between mb-4\">\n          <div class=\"h-3 w-24 bg-gray-200 dark:bg-white/10 rounded\"></div>\n          <div class=\"flex gap-2\">\n            <span class=\"h-2.5 w-2.5 rounded-full bg-emerald-500\"></span>\n            <span class=\"h-2.5 w-2.5 rounded-full bg-amber-500\"></span>\n            <span class=\"h-2.5 w-2.5 rounded-full bg-rose-500\"></span>\n          </div>\n        </div>\n        <div class=\"grid grid-cols-3 gap-3 mb-5\">\n          <div class=\"p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-900/30\">\n            <div class=\"text-xs text-emerald-700 dark:text-emerald-200\">In Stock</div>\n            <div class=\"text-2xl font-bold text-emerald-700 dark:text-emerald-200\">1,284</div>\n          </div>\n          <div class=\"p-4 rounded-2xl bg-gray-50 dark:bg-white/5\">\n            <div class=\"text-xs text-gray-600 dark:text-gray-300\">Low Stock</div>\n            <div class=\"text-2xl font-bold text-gray-900 dark:text-white\">23</div>\n          </div>\n          <div class=\"p-4 rounded-2xl bg-gray-50 dark:bg-white/5\">\n            <div class=\"text-xs text-gray-600 dark:text-gray-300\">Value (Cost)</div>\n            <div class=\"text-2xl font-bold text-gray-900 dark:text-white\">₹ 4.6L</div>\n          </div>\n        </div>\n        <div class=\"h-36 rounded-2xl bg-gray-50 dark:bg-white/5 flex items-center justify-center text-gray-400 dark:text-gray-500 text-sm\">\n          Sales & Stock Chart\n        </div>\n      </div>\n    </div>\n\n  </div>\n</div>\n\n<style>\n  @keyframes float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-8px)} }\n  .animate-float { animation: float 5s ease-in-out infinite; }\n</style>"
