{
  "name": "liber",
  "private": true,
  "description": "Liber: free catalog of logos, blocks, components, color themes and fonts for developers.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "scripts"
  ],
  "packageManager": "npm@11.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "npm run --workspace=@liber/scripts validate",
    "generate": "npm run --workspace=@liber/scripts generate",
    "build": "npm run generate && turbo run build",
    "dev": "turbo run dev --filter @liber/web",
    "test": "turbo run test",
    "test:e2e": "npm run --workspace=@liber/web test:e2e",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "tsx": "^4.23.15",
    "@next/eslint-plugin-next": "^16.4.3",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.72.0"
  }
}
