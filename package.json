{
  "name": "liber",
  "private": true,
  "description": "Liber: free catalog of logos, blocks, components, color themes and fonts for developers.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "pnpm --filter @liber/scripts validate",
    "generate": "pnpm --filter @liber/scripts generate",
    "build": "pnpm generate && turbo run build",
    "dev": "turbo run dev --filter @liber/web",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @liber/web test:e2e",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.3",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0"
  }
}
